                  f( x^1, \cdots, x^n )
                  \\,.
          %p Then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi C
                        %mi k
                  %mi ω
                  %mo{:lspace => "verythinmathspace"} :
                  %munder
                    %mi lim
                    %mi N
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi N
                  %mi ω
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_{C^k} \omega \colon \lim_{N} \sum_N \omega
                  \\,.
          %h5#IntegrationOfDifferentialFormsOverASmoothManifold Integration of differential forms over a manifold
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be a
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
          #IntegrationOfDifferentialFormsInTermsOfSmoothModuli.num_defn
            %h6#definition Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n \geq k
              %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"} smooth spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Sigma} \colon [\Sigma, \Omega^n] \to \Omega^{n-k}
            %p
              by declaring that over a
              %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              it is the ordinary
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over smooth manifolds
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi U
                    %mo :
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Sigma, U} : \Omega^n(\Sigma\times U) \to \Omega^{n-k}(U)
                    \\,.
          %h5#integration_in_ordinary_differential_cohomology Integration in ordinary differential cohomology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+ordinary+differential+cohomology"} fiber integration in ordinary differential cohomology
          %h4#holonomy Holonomy
          %h5#parallel_transport Parallel transport
          %p
            given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(\Delta^1, \mathfrak{g})
          %p
            we say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in C^\infty(\Delta^1, G)
            is the
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            if
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f(0) = 1
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                satisfies the
                %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mi f
                      %mo =
                      %mi A
                      %mi f
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{d}f = A f
          %p where on the right we have the differential of the left action of the group on itself.
          %p In this case one writes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi exp
                  %mrow
                    %mo (
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mi A
                    %mo )
                  %mo ≔
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{P} \exp\left(\int_{\Delta^1} A \right)
                  \\coloneqq
                  f(1)
          %p
            and calls it the
            %em
              %span.newWikiWord
                path ordered integral
                %a{:href => "/nlab/new/path+ordered+integral"} ?
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            In the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = U(1)
            this reproduces the ordinary
            %a.existingWikiWord{:href => "/nlab/show/integral"} integral
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi G
                    %mo =
                    %mi ℝ
                    %mo )
                  %mo ⇒
                  %mi 𝒫
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\left(G = \mathbb{R}\right)
                  \\Rightarrow
                  \\mathcal{P} \exp(\int_{\Delta^1} A)
                  \=
                  \\exp(i \int_{\Delta^1} A)
                  \\in
                  U(1)
          %p
            There is another way to express this
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
          %p
            Define an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^1(\Delta^1, \mathfrak{g})
            as follows: two 1-forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi A
                  %mo ′
                %annotation{:encoding => "application/x-tex"} A,A'
            are taken to be equivalent if there is a flat 1-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ^
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi flat
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi D
                    %mn 2
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hat A \in \Omega^1_{flat}(D^2, \mathfrak{g})
            on the 2-
            %a.existingWikiWord{:href => "/nlab/show/disk"} disk
            such that its restriction to the upper semicircle is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and the restriction to the lower semicircle is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde A
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of this relation form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %mo ≃
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^1(\Delta^1,\mathfrak{g})_{/\sim} \simeq
                  G
          %p
            and the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            map coincides with the
            %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi exp
                  %mrow
                    %mo (
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mrow
                      %mo (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo )
                    %mo )
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %mo ≃
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{P} \exp\left(\int_{\Delta^1} \left(-\right)\right)
                  \\colon
                  \\Omega^1(\Delta^1, \mathfrak{g})
                  \\to
                  \\Omega^1(\Delta^1, \mathfrak{g})_{/\sim}
                  \\simeq
                  G
          %p
            Finally yet another perspective is this: consider the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^1(\Delta^1, \mathfrak{g})
            where two 1-forms are regarded as equivalent if there is a
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda \in C^\infty(\Delta^1, G)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi e
                %annotation{:encoding => "application/x-tex"} \lambda(0) = e
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi e
                  %annotation{:encoding => "application/x-tex"} \lambda(1) = e
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi exp
                  %mrow
                    %mo (
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mrow
                      %mo (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo )
                    %mo )
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mn 1
                  %mo ,
                  %mi 𝔤
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ∼
                  %mo ≃
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{P} \exp\left(\int_{\Delta^1} \left(-\right)\right)
                  \\colon
                  \\Omega^1(\Delta^1, \mathfrak{g})
                  \\to
                  \\Omega^1(\Delta^1, \mathfrak{g})_{/\sim}
                  \\simeq
                  G
          %p is the parallel transport
          %h5#holonomy_of_a_flat_principal_connection Holonomy of a flat principal connection
          %p
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is connected then forming the
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            of flat
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hol
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %msub
                    %mi Bund
                    %mrow
                      %mo ∇
                      %mo ,
                      %mi flat
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %msub
                    %mi Hom
                    %mi Grp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  hol
                  \\colon
                  G Bund_{\nabla, flat}(X)
                  \\stackrel{\simeq}{\to}
                  Hom_{Grp}(\pi_1(X), G)
          %p
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(X)
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is not connected then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hol
                  %mo{:lspace => "verythinmathspace"} :
                  %mi G
                  %msub
                    %mi Bund
                    %mrow
                      %mo ∇
                      %mo ,
                      %mi flat
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %msub
                    %mi Hom
                    %mi Grpd
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  hol
                  \\colon
                  G Bund_{\nabla, flat}(X)
                  \\stackrel{\simeq}{\to}
                  Hom_{Grpd}(\Pi_1(X), \mathbf{B}G)
          %p is an equivalence.
          %h4#Transgression Transgression
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            on some
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and given a
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi Σ
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \tau_\Sigma \omega
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo −
                  %mi k
                %annotation{:encoding => "application/x-tex"} n-k
            on the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
            of smooth functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi u
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Phi_u \colon \Sigma \to X
            is the result of first forming the
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi_{(-)}
            and then forming the
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            of the result over
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi Σ
                  %mi ω
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi Φ
                  %mo ≔
                  %msub
                    %mo ∫
                    %mi Σ
                  %msubsup
                    %mi Φ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %mo *
                  %mi ω
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tau_{\Sigma} \omega\vert_{\Phi}
                  \\coloneqq
                  \\int_\Sigma \Phi_{(-)}^\ast \omega
                  \\,.
          %p
            This differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi Σ
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \tau_\Sigma \omega
            on the mapping space is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            This construction has a variety of immediate generalizations, for instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            may have
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
            and
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+corners"} corners
            and the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            may be generalized to a
            %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
            of a given
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+formal+smooth+sets"} super formal smooth sets
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %p
            Important examples of
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression of differential forms
            appear in
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            (in the sense of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian form
            on the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange variational derivative
            is the 1-form whose vanishing is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            and the transgression of the induced
            %a.existingWikiWord{:href => "/nlab/show/pre-symplectic+current"} pre-symplectic current
            is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/pre-symplectic+form"} pre-symplectic form
              on the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            of the field theory.
          %h5#TransgressionOfDifferentialForms Transgression of differential forms
          %h6#defintion Defintion
          %p
            There are two definitions of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression of differential forms
            %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
            below, which transgresses by
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
            along the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
          %p
            Another definition is useful, which makes more use of the existence of smooth classifying spaces for differential forms in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
            %a.maruku-ref{:href => "#ParameterizedIntegrationOfDifferentialForms"}
            below.
          %p
            That these two definitions are indeed equivalent is the content of prop.
            %a.maruku-ref{:href => "#EquivalenceOfTransgressionOfDifferentialFormsToMappingSpaces"}
            below
          #ParameterizedIntegrationOfDifferentialForms.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (parameterized
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \geq k \in \mathbb{N}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Sigma_k
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p Then we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Σ
                      %mi k
                    %mo ,
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Sigma}
                    \\;\colon\;
                    [\Sigma_k, \mathbf{\Omega}^n]
                    \\longrightarrow
                    \\mathbf{\Omega}^{n-k}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              which takes a plot
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ω
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi Σ
                      %mo ,
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \omega_{(-)} \colon U \to [\Sigma, \mathbf{\Omega}^k]
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega_{(-)}(-)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} U \times \Sigma
              to the result of
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi Σ
                    %msub
                      %mi ω
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %msub
                      %mi ω
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Sigma} \omega_{(-)}(-) \coloneqq \int_\Sigma \omega_{(-)}
                    \\,.
          #TransgressionOfDifferentialFormsToMappingSpaces.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression of differential forms
                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \geq k \in \mathbb{N}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Sigma_k
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p
              Then the operation of
              %em
                transgression of differential
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma
                    \\coloneqq
                    \\int_\Sigma [\Sigma,-]
                    \\;\colon\;
                    \\Omega^n(X) \to \Omega^{n-k}([\Sigma,X])
            %p
              from differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n-k
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              which takes the differential form corresponding to the smooth function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo →
                      %mi ω
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X \stackrel{\omega}{\to} \Omega^n) \in \Omega^n(X)
            %p to the differential form corresponding to the following composite smooth funtion:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mi ω
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Σ
                        %mo ,
                        %mi ω
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ∫
                          %mi Σ
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma \omega
                    \\coloneqq
                    \\int_{\Sigma} [\Sigma,\omega]
                    \\;\colon\;
                    [\Sigma, X]
                    \\stackrel{[\Sigma, \omega]}{\to}
                    [\Sigma, \Omega^n]
                    \\stackrel{\int_{\Sigma}}{\to}
                    \\Omega^{n-k}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,\omega]
              is the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              on
