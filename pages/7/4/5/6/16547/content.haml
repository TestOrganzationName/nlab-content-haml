                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi k
                            %msub
                              %mo ∫
                              %mi Σ
                            %msub
                              %mi d
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ϕ
