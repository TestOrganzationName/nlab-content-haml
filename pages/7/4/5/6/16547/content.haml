            %a.existingWikiWord{:href => "/nlab/show/force"} force
            exerted by the
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            on the electron.
          %h6#TransgressionOfKillingFormToSymplecticFormOfChernSimons Transgression of Killing form to symplectic form of Chern-Simons theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            be a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            with binary
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo ⊗
                    %mi 𝔤
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \langle -,-\rangle \colon \mathfrak{g} \otimes \mathfrak{g} \to \mathbb{R}
          %p
            For instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            could be a
            %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo =
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{g} = \mathfrak{su}(n)
            is a
            %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+algebra"} matrix Lie algebra
            such as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+Lie+algebra"} special unitary Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            of the product of two matrices.
          %p
            This pairing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle
            defines a differential 4-form on the
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            of
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+1-forms"} Lie algebra valued 1-forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi F
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi 𝔤
                  %mo ⊗
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                  %msup
                    %mi Ω
                    %mn 4
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_{(-)} \wedge F_{(-)} \rangle
                  \\colon
                  \\Omega^1(-,\mathfrak{g})
                  \\stackrel{F_{(-)}}{\to}
                  \\Omega^2(-, \mathfrak{g})
                  \\stackrel{(-)\wedge (-)}{\to}
                  \\Omega^4(-, \mathfrak{g}\otimes \mathfrak{g})
                  \\stackrel{\langle-,-\rangle}{\to}
                  \\Omega^4
          %p
            Over a
            %a.existingWikiWord{:href => "/nlab/show/coordinate+patch"} coordinate patch
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} U \in
            %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            this sends a differential 1-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(U)
            to the differential 4-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_A \wedge F_A \rangle \in \Omega^4(U)
                  \\,.
          %p
            The fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, - \rangle
            is indeed an
            %em
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            means that this indeed extends to a 4-form on the smooth
            %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie+algebra+valued+forms"} groupoid of Lie algebra valued forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo ∧
                  %msub
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mi Ω
                    %mn 4
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\langle F_{(-)} \wedge F_{(-)}\rangle
                  \\colon
                  \\mathbf{B}G_{conn}
                  \\to
                  \\Omega^4
                  \\,.
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
            of the above 4-form to the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
