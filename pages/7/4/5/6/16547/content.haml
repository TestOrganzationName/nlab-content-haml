            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi γ
                              %mo{:stretchy => "false"} ˜
                            %mo ∈
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi H
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo ×
                                %mi Σ
                                %mo ,
                                %mi A
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ×
                            %mi Σ
                            %mo ,
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mrow
                                %mi n
                                %mo +
                                %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mo ∫
                                  %mi Σ
                                %mo{:stretchy => "false"} (
                                %mi U
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi Ω
                              %mi n
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
