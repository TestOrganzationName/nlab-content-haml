          #TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transgression+of+differential+forms"} transgression of differential forms
                to mapping space via evaluation map)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mi k
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \geq k \in \mathbb{N}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Σ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \Sigma_k
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  of
                  %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
            %p
              Then the operation of
              %em
                transgression of differential
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo ≔
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi ev
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi ev
                          %mo *
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ∫
                          %mi Σ
                    %msup
                      %mi Ω
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_\Sigma
                    \\coloneqq
                    \\int_\Sigma ev^\ast
                    \\;\colon\;
                    \\Omega^n(X)
                    \\overset{ev^\ast}{\longrightarrow}
                    \\Omega^n(\Sigma \times [\Sigma, X])
                    \\overset{\int_\Sigma}{\longrightarrow}
                    \\Omega^{n-k}([\Sigma,X])
            %p
              from differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to differential
              = succeed "-forms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n-k
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              which is the
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              of forming the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ev
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} ev \colon  [\Sigma, X] \times \Sigma \to X
              with
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          #EquivalenceOfTransgressionOfDifferentialFormsToMappingSpaces.num_prop
            %h6#proposition Proposition
            %p
              The two definitions of transgression of differential forms to mapping spaces from def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpaces"}
              and def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
              are equivalent.
          .proof
            %h6#proof Proof
            %p
              We need to check that for all plots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma \colon U \to [\Sigma, X]
              the pullbacks of the two forms to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              coincide.
            %p
              For def.
              %a.maruku-ref{:href => "#TransgressionOfDifferentialFormsToMappingSpacesViaEvaluationMap"}
              we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi γ
                      %mo *
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi{:mathvariant => "normal"} ev
                      %mo *
                    %mi A
                    %mo =
                    %msub
                      %mo ∫
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi Σ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msup
                      %mi{:mathvariant => "normal"} ev
                      %mo *
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma^\ast \int_\Sigma \mathrm{ev}^\ast A
                    \=
                    \\int_\Sigma (\gamma,\mathrm{id}_\Sigma)^\ast \mathrm{ev}^\ast A
                    \\;
                    \\in \Omega^n(U)
            %p
              Here we recognize in the integrand the pullback along the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi Σ
                      %mo ⊣
                      %mo{:stretchy => "false"} [
                      %mi Σ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ( (-)\times \Sigma \dashv [\Sigma,-])
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mi U
                    %mo ×
                    %mi Σ
                    %mo →
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \tilde \gamma : U \times \Sigma \to \Sigma
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} (-)\times \Sigma
              and then postcomposing with the adjunction counit
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} ev
                    %annotation{:encoding => "application/x-tex"} \mathrm{ev}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo ×
                            %mi Σ
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo ,
                                %msub
                                  %mi{:mathvariant => "normal"} id
                                  %mi Σ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi Σ
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} ]
                            %mo ×
                            %mi Σ
                          %mtd
                            %mover
                              %mo ⟶
                              %mi{:mathvariant => "normal"} ev
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U \times \Sigma
                    \&amp;
                    \\overset{(\gamma, \mathrm{id}_\Sigma)}{\longrightarrow}
                    \&amp;
                    [\Sigma,X] \times \Sigma
                    \&amp;
                    \\overset{\mathrm{ev}}{\longrightarrow}
                    \&amp;
                    X
                    }
                    \\,.
            %p Hence the integral is now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ˜
                      %mo *
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots = \int_{\Sigma} \tilde \gamma^\ast A
                    \\,.
            %p
              This is the operation of the top horizontal composite in the following
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality square
              for
              = succeed "," do
