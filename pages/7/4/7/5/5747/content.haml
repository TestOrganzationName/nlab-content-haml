                    %mi{:mathvariant => "normal"} Set
                  %annotation{:encoding => "application/x-tex"} \mathrm{Set}
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Set
                  %annotation{:encoding => "application/x-tex"} \mathrm{Set}
            = succeed "-semi-simplicial" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            %a.existingWikiWord{:href => "/nlab/show/Hugo+Herbelin"} Hugo Herbelin
            worked at the IAS on a formalization in
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            based on the presentation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \Delta_i
            with face maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                  %annotation{:encoding => "application/x-tex"} d_i
            %a{:href => "#Herbelin14"} Herbelin (2014)
            he describes the construction in
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            assuming that the types in every
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            satisfy
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            (UIP), which implies that every type is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} matching object
            representatives in a semi-simplicial set.
