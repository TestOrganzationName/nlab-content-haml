            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+semantics+of+dependent+types"} correspondence between fibrations and families
