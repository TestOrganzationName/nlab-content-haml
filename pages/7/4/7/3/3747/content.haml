            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mi i
                    %mo −
                    %msub
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} |
