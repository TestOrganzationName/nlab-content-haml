                    %mo →
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} u_F:F \to \mathbb{R}_C
          %p
            Since every
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
            between
            %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            where for every element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi F
                %annotation{:encoding => "application/x-tex"} x \in F
            there exists a locator of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            implies that every other such Archimedean ordered field is a
            %a.existingWikiWord{:href => "/nlab/show/subfield"} subfield
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
            via the unique ring homomorphism
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mi F
                    %mo :
                    %mi F
                    %mo →
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} u_F:F \to \mathbb{R}_C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi F
                  %mo .
                  %mrow
                    %mo (
                    %mi{:mathvariant => "normal"} isAOField
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo ∀
                    %mi x
                    %mo ∈
                    %mi F
                    %mo .
                    %mo ∃
                    %mi p
                    %mo ∈
                    %mi{:mathvariant => "normal"} locator
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊆
                  %msub
                    %mi ℝ
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall F.\left(\mathrm{isAOField}(F) \wedge \forall x \in F.\exists p \in \mathrm{locator}(x)\right) \Rightarrow (F \subseteq \mathbb{R}_C)
          %p
            In this sense, the Cauchy real numbers is the collection of
            %em all
            real numbers for which there exist a locator.
          %p
            Either way, this definition makes sense in any
            %a.existingWikiWord{:href => "/nlab/show/Heyting+category"} Heyting category
            with
            %a.existingWikiWord{:href => "/nlab/show/exponential+objects"} exponential objects
            and a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
            %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            and the Cauchy real numbers cannot be constructed as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+field"} discrete field
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is rendered as the
            %a.existingWikiWord{:href => "/nlab/show/bracket+type"} bracket type
            of the
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            of
            %a.existingWikiWord{:href => "/nlab/show/locators"} locators
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            In addition, the Cauchy real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
            is not to be confused with the set of (real number, locator) pairs
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi ℒ
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mi D
                  %mi{:mathvariant => "normal"} locator
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^\mathcal{L} = \bigcup_{x \in \mathbb{R}_D} \mathrm{locator}(x)
          %p
            The latter set is equivalent to the set of
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequences"} Cauchy sequences
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of the projection function from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi ℒ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^\mathcal{L}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            which takes a (real number, locator) pair to its constituent real number.
          %h2#algebraic_closure Algebraic closure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
            of the modulated Cauchy real numbers is the modulated Cauchy
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+algebra"} fundamental theorem of algebra
            is true for the modulated Cauchy real numbers.
          %h2#generalisations_2 Generalisations
          %p
            Although the notion of
            %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
            doesn't make sense until we know what real numbers are, once we have these, we can recognise that the rational numbers form a metric space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            and the real numbers were constructed from them in a way that makes reference only to the metric-space structure of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complete+metric+space"} completion
          %p
            We can also interpret
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            as a
            %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniform space
            or even as a
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+space"} Cauchy space
            and define analogous notions of completion for these. However, these require us (in general) to use generalised Cauchy sequences, that is Cauchy
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nets"} nets
          %h2#motivation Motivation
          %p
            Suppose that we wish to approximate a real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            by common fractions with arbitrarily large denominators. That is, given any natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"} a_i
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo ≔
                  %msub
                    %mi a
                    %mi i
                  %mo{:stretchy => "false"} /
                  %mi i
                %annotation{:encoding => "application/x-tex"} x_i \coloneqq a_i/i
            is within
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi i
                %annotation{:encoding => "application/x-tex"} 1/i
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ,
                  %msub
                    %mi x
                    %mn 3
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0,x_1,x_2,x_3,\ldots)
            is an
            = succeed "-regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi i
                %annotation{:encoding => "application/x-tex"} \alpha(1/i) \coloneqq i
            as modulus of convergence. (You can extend
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            to every positive rational number by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} ⌊
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi ϵ
                    %mo{:stretchy => "false"} ⌋
                  %annotation{:encoding => "application/x-tex"} \alpha(\epsilon) \coloneqq \lfloor{1/\epsilon}\rfloor
            = succeed "-regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x_0,x_1,x_2,\ldots)
            for this modulus
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} x_i
            (for
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i \gt 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            (which can be done using only rational arithmetic) to produce an equal
            = succeed "-regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          %p
            We might instead want to approximate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            by arbitrarily long decimal fractions. That is, given any natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"} a_i
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo ≔
                  %msub
                    %mi a
                    %mi i
                  %mo{:stretchy => "false"} /
                  %msup
                    %mn 10
                    %mi i
                %annotation{:encoding => "application/x-tex"} x_i \coloneqq a_i/10^i
            is within
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %msup
                    %mn 10
                    %mi i
                %annotation{:encoding => "application/x-tex"} 1/10^i
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x_0,x_1,x_2,\ldots)
            is an
            = succeed "-regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %msup
                    %mn 10
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi i
                %annotation{:encoding => "application/x-tex"} \alpha(1/10^i) \coloneqq i
            as modulus of convergence. Conversely, we can round off the values of any
            = succeed "-regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 10
                %annotation{:encoding => "application/x-tex"} 10
            here; for theoretical purposes, base
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is popular.
          %p
            Thus, to
            %em define
            a real number to be an
            = succeed "-regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          %p
            Note we may be rounding up or down, regardless of which is nearer. For example, in approximating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo =
                  %mi exp
                  %mspace{:width => "thinmathspace"}
                  %mn 1
                %annotation{:encoding => "application/x-tex"} e = \exp\,1
            by decimal fractions, we might get (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo ,
                  %mn 2.7
                  %mo ,
                  %mn 2.71
                  %mo ,
                  %mi …
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 2,2.7,2.71,\ldots)
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 2.7
                    %mo ,
                    %mn 2.72
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (3,2.7,2.72,\ldots)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 2.8
                    %mo ,
                    %mn 2.71
                    %mo ,
                    %mi …
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,2.8,2.71,\ldots)
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0.5
                  %annotation{:encoding => "application/x-tex"} 0.5
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            (or at least the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/lesser+limited+principle+of+omniscience"} lesser limited principle of omniscience
          %p
            Even for Dedekind reals in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/neutral+constructive+mathematics"} neutral constructive mathematics
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
