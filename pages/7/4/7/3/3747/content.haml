                    %mi ℝ
                    %mi D
                %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}_D
            where there exist a locator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
