                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_C = \{x \in \mathbb{R}_D \vert \exists p \in \mathrm{locator}(x)\}
          %p
            Alternatively, if one doesn’t have the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            %strong Cauchy real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
            is the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
            Archimedean ordered field where for every element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msub
                    %mi ℝ
                    %mi C
                %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}_C
            there exists a locator of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
