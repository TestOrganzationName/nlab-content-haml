              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %a.existingWikiWord{:href => "/nlab/show/strictly+monotonic"} strictly monotonic
            %a.existingWikiWord{:href => "/nlab/show/field+homomorphism"} field homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
