                    %mo :
                    %mi F
                    %mo →
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} u_F:F \to \mathbb{R}_C
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
            between
            %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            implies that every other Archimedean ordered field is a
            %a.existingWikiWord{:href => "/nlab/show/subfield"} subfield
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
