                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j \geq \alpha(\epsilon)
            = succeed "-regular" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %strong equal
            if
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mi i
                    %mo −
                    %msub
                      %mi y
                      %mi i
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mn 2
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} {|x_i - y_i|} \leq 2\epsilon
          %p
            holds whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \geq \alpha(\epsilon)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mi i
                    %mo −
                    %msub
                      %mi y
                      %mi j
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mi δ
                  %mo +
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} {|x_i - y_j|} \leq \delta + \epsilon
          %p
            holds whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≥
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi δ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i \geq \alpha(\delta)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≥
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j \geq \alpha(\epsilon)
          %h3#cauchy_approximations Cauchy approximations
          %p
            The modulated Cauchy real numbers could also be constructed through
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+approximations"} Cauchy approximations
            rather than sequences of rational numbers with a modulus of convergence. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            be the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℚ
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi ℚ
                  %mo{:stretchy => "false"} |
                  %mn 0
                  %mo &lt;
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{+} \coloneqq \{x \in \mathbb{Q} \vert 0 \lt x\}
          %p be the positive rational numbers.
          %h4#as_an_initial_algebra As an initial algebra
          %p
            Let us define a
            %em modulated Cauchy algebra
            to be a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo ∈
                    %msup
                      %mi A
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi ℚ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \iota \in A^{C(\mathbb{Q})}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\mathbb{Q})
            is the set of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+approximation"} Cauchy approximation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A^{C(\mathbb{Q})}
            is the set of functions with domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\mathbb{Q})
            and codomain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mrow
                    %mo (
                    %mo ∀
                    %mi ϵ
                    %mo ∈
                    %msub
                      %mi ℚ
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo .
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi a
                      %mi ϵ
                    %mo −
                    %msub
                      %mi b
                      %mi ϵ
                    %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mn 4
                    %mi ϵ
                    %mo )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in C(\mathbb{Q}). \forall b \in C(\mathbb{Q}). \left( \forall \epsilon \in \mathbb{Q}_{+}. \vert a_\epsilon - b_\epsilon \vert \lt 4 \epsilon \right) \implies (\iota(a) = \iota(b))
          %p
            A
            %em modulated Cauchy algebra homomorphism
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi B
                    %mi A
                %annotation{:encoding => "application/x-tex"} f:B^A
            between modulated Cauchy algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ι
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi ι
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in C(\mathbb{Q}). f(\iota_A(a)) = \iota_B(a)
          %p
            The
            %em category of modulated Cauchy algebras
            is the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MCAlg
                %annotation{:encoding => "application/x-tex"} MCAlg
            whose objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi MCAlg
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ob(MCAlg)
            are modulated Cauchy algebras and whose morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi MCAlg
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mor(MCAlg)
            are modulated Cauchy algebra homomorphisms. The set of
            = succeed "," do
              %strong modulated Cauchy real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
          %h4#as_a_quotient_inductive_type As a quotient inductive type
          %p
            The
            %strong modulated Cauchy real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
            are a
            %a.existingWikiWord{:href => "/nlab/show/quotient+inductive+type"} quotient inductive type
            inductively generated by the following:
          %ul
            %li
              %p
                a function
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ι
                        %mo :
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi ℚ
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi ℝ
                          %mi C
                      %annotation{:encoding => "application/x-tex"} \iota: C(\mathbb{Q}) \to \mathbb{R}_C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\mathbb{Q})
                is the type of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+approximation"} Cauchy approximation
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %li
              %p a dependent family of terms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi b
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %msub
                        %mi eq
                        %mrow
                          %msub
                            %mi ℝ
                            %mi C
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi ϵ
                            %mo :
                            %msub
                              %mi ℚ
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi a
                          %mi ϵ
                        %mo −
                        %msub
                          %mi b
                          %mi ϵ
                        %mo{:stretchy => "false"} |
                        %mo &lt;
                        %mn 4
                        %mi ϵ
                        %mo )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi ι
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %msub
                            %mi ℝ
                            %mi C
                      %mi ι
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a:C(\mathbb{Q}), b:C(\mathbb{Q}) \vdash eq_{\mathbb{R}_C}(a, b): \left( \prod_{\epsilon:\mathbb{Q}_{+}} \vert a_\epsilon - b_\epsilon \vert \lt 4 \epsilon \right) \to (\iota(a) =_{\mathbb{R}_C} \iota(b))
            %li
              %p a family of dependent terms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %msub
                        %mi ℝ
                        %mi C
                      %mo ,
                      %mi b
                      %mo :
                      %msub
                        %mi ℝ
                        %mi C
                      %mo ⊢
                      %mi τ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi isProp
                      %mo{:stretchy => "false"} (
                      %mi a
                      %msub
                        %mo =
                        %mrow
                          %msub
                            %mi ℝ
                            %mi C
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a:\mathbb{R}_C, b:\mathbb{R}_C \vdash \tau(a, b): isProp(a =_{\mathbb{R}_C} b)
          %p
            This is the approach of
            %a{:href => "#Booij20"} Booij20
          %h3#generalisations Generalisations
          %p While requiring a modulus of convergence, even fixing the modulus of convergence, may be more restrictive, it is also possible to use a potentially more lax definition.
          %p
            One way is to use
            %a.existingWikiWord{:href => "/nlab/show/multivalued+functions"} multivalued functions
            from the natural numbers. A
            %strong multivalued Cauchy real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is an
            %a.existingWikiWord{:href => "/nlab/show/entire+relation"} entire relation
            between natural numbers and rational numbers such that, for every positive rational number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            such that, whenever
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ≥
                    %mi α
                  %annotation{:encoding => "application/x-tex"} i, j \geq \alpha
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo −
                    %mi b
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} {|a - b|} \leq \epsilon
          %p
            holds for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a,b
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo ,
                      %mi a
                %annotation{:encoding => "application/x-tex"} x_{i,a}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi j
                      %mo ,
                      %mi b
                %annotation{:encoding => "application/x-tex"} x_{j,b}
            hold. Two multivalued Cauchy real numbers are considered
            %strong equal
            if, for every positive rational number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            such that, whenever
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mi α
                  %annotation{:encoding => "application/x-tex"} i \geq \alpha
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo −
                    %mi b
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} {|a - b|} \leq \epsilon
          %p
            holds for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a,b
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo ,
                      %mi a
                %annotation{:encoding => "application/x-tex"} x_{i,a}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi y
                    %mrow
                      %mi i
                      %mo ,
                      %mi b
                %annotation{:encoding => "application/x-tex"} y_{i,b}
            hold. The partial equivalence relation subsuming both conditions is that, for every positive rational number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            such that, whenever
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ≥
                    %mi α
                  %annotation{:encoding => "application/x-tex"} i,j \geq \alpha
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi a
                    %mo −
                    %mi b
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} {|a - b|} \leq \epsilon
          %p
            holds for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                %annotation{:encoding => "application/x-tex"} a,b
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo ,
                      %mi a
                %annotation{:encoding => "application/x-tex"} x_{i,a}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mrow
                        %mi j
                        %mo ,
                        %mi b
                  %annotation{:encoding => "application/x-tex"} y_{j,b}
          %p
            Another way is to use
            %a.existingWikiWord{:href => "/nlab/show/nets"} nets
            (also called ‘generalised sequences’). A
            %strong generalised Cauchy real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is a net
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi ν
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi ν
                      %mo{:lspace => "verythinmathspace"} :
                      %mi D
                %annotation{:encoding => "application/x-tex"} (x_\nu)_{\nu\colon D}
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is any
            %a.existingWikiWord{:href => "/nlab/show/directed+set"} directed set
            of indices) of rational numbers such that, for every positive rational number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mi i
                    %mo −
                    %msub
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} {|x_i - x_j|} \leq \epsilon
          %p
            holds whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ,
                  %mi j
                  %mo ≥
                  %mi α
                %annotation{:encoding => "application/x-tex"} i,j \geq \alpha
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                %annotation{:encoding => "application/x-tex"} x,y
            are considered
            %strong equal
            if, for every positive rational number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and an index
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi x
                      %mi i
                    %mo −
                    %msub
                      %mi y
                      %mi j
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} {|x_i - y_j|} \leq \epsilon
          %p
            holds whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≥
                  %mi α
                %annotation{:encoding => "application/x-tex"} i \geq \alpha
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≥
                    %mi β
                  %annotation{:encoding => "application/x-tex"} j \geq \beta
          %p Requiring a modulus of convergence would make no difference for either of these, since we would expect such a modulus to also to be either multivalued or given by a net, and these are easy to construct explicitly (even in constructive mathematics).
          %p
            (Since the term ‘Cauchy real number’ logically applies just as well to these generalisations, we may speak of
            %strong sequential real numbers
            for the classical or modulated version.)
          %h3#relations_between_these_definitions Relations between these definitions
          %p
            Classically, all of these definitions are equivalent. In fact, to prove their equivalence, we need only the following equivalent principles (cf.
            = succeed "):" do
              %a{:href => "#Booij20"} Booij 2020
          %ul#DedekindCauchyEquivalence
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
                is a
                %a.existingWikiWord{:href => "/nlab/show/modulated+Cauchy+real+number"} modulated Cauchy real number
            %li
              %p
                For every
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
                there exists a signed-digit
                %a.existingWikiWord{:href => "/nlab/show/radix+representation"} radix representation
                of the real number
            %li
              %p
                For every
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
                there exists a
                %a.existingWikiWord{:href => "/nlab/show/locator"} locator
            %li
              %p
                For every
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
                there exists
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+cut+structure"} Dedekind cut structure
            %li
              %p
                For every
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
                there exists a
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
                of
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                whose limit is the real number.
          %p If we don't accept any of the above, then we still have these results:
          .un_theorem
            %h6#theorems Theorems
            %p (constructive).
            %p
              Given any modulus of convergence
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              = succeed "-regular" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              = succeed "-regular" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              = succeed "-regular" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              = succeed "-regular" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
            %p Every modulated Cauchy real number is a classical Cauchy real number, and any two equal modulated Cauchy real numbers are equal as classical Cauchy real numbers.
            %p Every classical Cauchy real number is a multivalued Cauchy real number, and any two equal classical Cauchy real numbers are equal as multivalued Cauchy real numbers.
            %p
              Every multivalued Cauchy real number becomes a generalised Cauchy real number whose index set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              comes equipped with a surjection to the natural numbers. Furthermore, any two multivalued Cauchy real numbers are equal as multivalued Cauchy real numbers if and only if they are equal as generalised Cauchy real numbers. Conversely, any generalised Cauchy real number is equal (as a generalised Cauchy real number) to some multivalued Cauchy real number.
            %p
              Every generalised Cauchy real number becomes a
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
              in the usual way, defining lower and upper sets in terms of the order relation on generalised Cauchy real numbers. Furthermore, any two generalised Cauchy real numbers are equal as generalised Cauchy real numbers if and only if they are equal as Dedekind cuts. Conversely, any Dedekind cut is equal (as a Dedekind cut) to some generalised Cauchy real number.
          %p
            Hence even in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            from each of these to the next.
          %p Just to be explicit, here are the missing converses:
          .un_theorem
            %h6#axioms Axioms
            %p Every classical Cauchy real number is modulated, and any two equal Cauchy real numbers are equal as modulated Cauchy real numbers.
            %p Every multivalued Cauchy real number is equal (as a multivalued Cauchy real number) to some classical Cauchy real number, and two classical Cauchy real numbers are equal if they are equal as multivalued Cauchy real numbers.
          %p
            Most practitioners of both
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            and
            %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            want to use the Dedekind real numbers. Without
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/countable+choice"} countable choice
            %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+algebra"} fundamental theorem of algebra
            is simplest for them. They also make sense in
            %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative mathematics
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+sets"} function sets
            %a.existingWikiWord{:href => "/nlab/show/fullness"} fullness
            and the Dedekind reals require
            %a.existingWikiWord{:href => "/nlab/show/powersets"} powersets
            for their definitions.
          %p
            On the other hand, even the (modulated) Cauchy real numbers are not necessarily Cauchy complete, i.e. a Cauchy sequence (even a modulated one) of Cauchy real numbers need not converge to another Cauchy real number (though it always does converge to a Dedekind real number, since the Dedekind real numbers
            %em are
            always Cauchy complete). The problem is that without enough countable choice, we cannot lift a (modulated) Cauchy sequence of (modulated Cauchy) real numbers to a Cauchy sequence of Cauchy sequences in order to “diagonalize” it; a countermodel is constructed by
            = succeed "." do
              %a{:href => "#Lubarsky"} Lubarsky
          %p
            For non-modulated Cauchy sequences and reals, there are additional problems even if we assume representatives are already chosen. A modulated Cauchy sequence of modulated Cauchy sequences does converge to a modulated Cauchy sequence. Moreover, a
            %em modulated
            Cauchy sequence of
            %em classical
            Cauchy sequences, and a
            %em classical
            Cauchy sequence of
            %em modulated
            Cauchy sequences, both necessarily converge to a
            %em classical
            Cauchy sequence. But the results need not be modulated, and a classical Cauchy sequence of classical Cauchy sequences need not converge to a classical Cauchy sequence. In fact,
            %a{:href => "#Lubarsky"} Lubarsky
            shows that:
          %ul
            %li
              %p
                The generic classical Cauchy sequence, in the
                %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
                of classical Cauchy sequences, is not modulated. Thus, we cannot prove that every classical Cauchy sequence is modulated. Hence, we cannot prove that a classical Cauchy sequence of modulated Cauchy sequences has a modulated limit (since a classical Cauchy sequence of rationals can be regarded as a classical Cauchy sequence of (constant) modulated Cauchy sequences).
            %li
              %p The generic classical Cauchy sequence of classical Cauchy sequences, in the classifying topos of such, does not converge to a classical Cauchy sequence.
            %li
              %p The generic modulated Cauchy sequence of classical Cauchy sequences, in the classifying topos of such, does not converge to a modulated Cauchy sequence.
          %p
            (Actually, Lubarsky writes using
            %span.newWikiWord
              Heyting-valued sets
              %a{:href => "/nlab/new/Heyting-valued+sets"} ?
            on topological spaces rather than classifying toposes of propositional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometric+theories"} geometric theories
          %h3#using_locators Using locators
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            satisfies the axioms of a
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+cut"} Dedekind cut
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/strict+order"} strict order
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
          %p
            The Dedekind real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mi D
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_D
            are the
            %a.existingWikiWord{:href => "/nlab/show/terminal"} terminal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %a.existingWikiWord{:href => "/nlab/show/strictly+monotonic"} strictly monotonic
            %a.existingWikiWord{:href => "/nlab/show/field+homomorphism"} field homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
