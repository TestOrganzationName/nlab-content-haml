            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category"} symmetric monoidal
            = succeed "-groupoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
