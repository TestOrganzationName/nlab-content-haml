                    %mi Y
                    %mo ,
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_0 Desc(Y,\mathcal{A})
            = succeed "-nerve" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            yields a simplicial presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi O
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} N_O\mathcal{A}
            to which the above simplicial descent applies.
          %p The following theorem asserts that under certain conditions both notions coincide.
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong (Dominic Verity)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Str
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} : C^{op}, Str \infty Grpd
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} Y : C^{op} \to sSet
              are such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Δ
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} N_O \mathcal{A}(Y_\bullet) : \Delta \to sSet
              is fibrant in the
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Quillen
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi Reedy
                    %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]_{Reedy}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi O
                    %mi Desc
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Desc
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N_O Desc(Y,\mathcal{A}) \stackrel{\simeq}{\to} Desc(Y, N_O \mathcal{A})
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              of
              = succeed "es." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          %p
            This is proven in
            = succeed "." do
              %a{:href => "#Verity"} Verity09
          .num_corollary
            %h6#corollary Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Y \in [C^{op}, sSet]
              is such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                    %mo :
                    %mi Δ
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Y_\bullet : \Delta \to [C^{op}, Set] \hookrightarrow [C^{op}, sSet]
              is cofibrant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta, [C^{op}, sSet]_{proj}]_{Reedy}
              then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Str
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} : C^{op} \to Str \infty Grpd
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi O
                    %mi Desc
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi Desc
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_O Desc(Y,\mathcal{A}) \stackrel{\simeq}{\to} Desc(Y, N_O \mathcal{A})
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Y_\bullet
              is Reedy cofibrant, then by definition the canonical morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi Y
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\lim_{\to}( ([n] \stackrel{+}{\to} [k]) \mapsto Y_k ) \to Y_n
            %p
              are cofibrations in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} N_O \mathcal{A}
              is fibrant, it follows that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet](-, N_O \mathcal{A})
              sends cofibrations to fibrations, so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mi lim
                      %mo ←
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N_O\mathcal{A}(Y_n)
                    \\to
                    \\lim_{\leftarrow}( [n]\stackrel{+}{\to} [k] \mapsto N_O\mathcal{A}(Y_k))
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N_O \mathcal{A}(Y_\bullet)
              is Reedy fibrant, so that the assumption of Verity’s theorem is met.
          .num_corollary
            %h6#corollary_2 Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              the
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
              of a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              of a
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo :
                    %msup
                      %mi CartSp
                      %mi op
                    %mo →
                    %mi Str
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} : CartSp^{op} \to Str \infty Grpd
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi N
                      %mi O
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi N
                      %mi O
                    %mi Desc
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mo •
                    %mo ,
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op}, sSet](Y,N_O \mathcal{A})
                    \\simeq
                    N_O Desc(Y_\bullet, \mathcal{A})
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              By the above is sufices to note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Y_\bullet
              is cofibrant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, [C^{op}, sSet]_{proj}]_{Reedy}
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is the
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
              of a good open cover. By the assumption of good open cover we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is degreewise a coproduct of representables and that the inclusion of all degenerate
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-cells" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi j
                    %msub
                      %mi U
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\coprod_{i \in I} U_i \to \coprod_j U_{j \in J}
            %p
              induced from an inclusion of subsets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ↪
                      %mi J
                    %annotation{:encoding => "application/x-tex"} I \hookrightarrow J
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              such an inclusion is a cofibration.
          %p
            In conclusion we find that for determining the
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %em strict
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-groupid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h2#Properness Properness
          %p
            The global model structures on simplicial presheaves are all
            %a.existingWikiWord{:href => "/nlab/show/left+proper+model+categories"} left
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+proper+model+categories"} right proper model categories
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization of model categories
            preserves left properness (as discussed
            = succeed ")," do
              %a{:href => "Bousfield+localization+of+model+categories#ExistenceForLeftProperCombinatorialSimplicialModelCategories"} there
          %p
            But the local model structures are not in general right proper anymore. A sufficient condition for them to be right proper is given in the following Prop.
            = succeed "." do
              %a.maruku-ref{:href => "#StalkwiseWeakEquivalencesImpliesRightProperness"}
          %p
            The injective local model structures which are right proper are
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+model+categories"} locally cartesian closed model categories
            and
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} present
            %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+%28infinity%2C1%29-categories"} locally cartesian closed (infinity,1)-categories
            (by the discussion
            = succeed ")." do
              %a{:href => "locally+cartesian+closed+infinity,1-category#PresentationTheorem"} there
          #OverSiteWithEnoughPointsWeakEquivalencesDetectedOnStalks.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sPSh(C)
              are the
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              of simplicial sets.
          %p
            (p. 12
            = succeed ")" do
              %a{:href => "http://www.math.uiuc.edu/K-theory/0175/"} here
          #StalkwiseWeakEquivalencesImpliesRightProperness.num_prop
            %h6#proposition_7 Proposition
            %p
              A sufficient condition for an injective or projective local model structure of simplicial presheaves over a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to be right proper is that the weak equivalences are precisely the
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/stalk"} stalk
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+weak+equivalence"} weak equivalences of simplicial sets
          %p
            This is mentioned for instance in (
            %a{:href => "#Olsson"}> Olsson, remark 4.3
            ).
          %p
            By Prop.
            %a.maruku-ref{:href => "#OverSiteWithEnoughPointsWeakEquivalencesDetectedOnStalks"}
            this sufficient condition holds, for instance, for the injective Jardine model structure when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} enough points
          .proof
            %h6#proof_6 Proof
            %p
              The key is that forming
              %a.existingWikiWord{:href => "/nlab/show/stalks"} stalks
              is, being the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of a
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mo *
                    %mo ⊣
                    %msub
                      %mi x
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi Set
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi x
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi x
                            %mo *
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (x^* \dashv x_*)  :=
                    Set
                    \\stackrel{\overset{x^*}{\leftarrow}}{\underset{x_*}{\to}}
                    Sh(C)
            %p
              an operation that preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %p
              Let therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f : X \to A
              be a stalkwise weak equivalence of simplicial presheaves and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g : A \to B
              be a fibration. Notice that in all the model structures (injective, projective, global, local) the fibrations are always
              %em in particular
              objectwise fibrations.
            %p
              Then the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mi f
                  %annotation{:encoding => "application/x-tex"} g^* f
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi g
                              %mo *
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi g
                                    %mo *
                                  %mi f
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    g^* X &amp;\to&amp; X
                    \\\
                    \\big\downarrow
                    {}^{\mathrlap{g^* f}}
                    \&amp;&amp;
                    \\big\downarrow
                    {}^{\mathrlap{f}}
                    \\\
                    A &amp;\stackrel{g}{\to}&amp; B
                    }
            %p
              is a weak equivalence if for all topos points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              the stalk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mo *
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x^* (g^* f)
              is a weak equivalence of simplicial sets. But since stalks preserve
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi x
                              %mo *
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi g
                              %mo *
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi x
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi x
                                    %mo *
                                  %mo{:stretchy => "false"} (
                                  %msup
                                    %mi g
                                    %mo *
                                  %mi f
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi x
                                    %mo *
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mi x
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi x
                                  %mo *
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi x
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x^*(g^* X) &amp;\to&amp; x^*( X)
                    \\\
                    \\downarrow^{\mathrlap{x^*(g^* f)}} &amp;&amp; \downarrow^{\mathrlap{x^*(f)}}
                    \\\
                    x^*(A) &amp;\stackrel{x^*(g)}{\to}&amp; x^*(B)
                    }
                    \\,.
            %p
              It is now sufficient to observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mi g
                  %annotation{:encoding => "application/x-tex"} x^* g
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              is right proper.
            %p
              To see this, notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x^*(g)
              is a Kan fibration precisely if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 1 \leq k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 0 \leq i \leq k
              the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mo *
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Λ
                        %mo{:stretchy => "false"} [
                        %mi k
                        %msup
                          %mo{:stretchy => "false"} ]
                          %mi i
                    %msub
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mo *
                        %mi B
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mi i
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mo *
                    %mi B
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (x^* A)^{\Delta[k]}
                    \\to
                    (x^* A)^{\Lambda[k]^i}
                    \\times_{(x^* B)^{\Lambda[k]^i} }
                    (x^* B)^{\Delta[k]}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              of sets. Since stalks commute with finite limits, this is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                    %mrow
                      %mo (
                      %msup
                        %mi A
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                      %mo →
                      %msup
                        %mi A
                        %mrow
                          %mi Λ
                          %mo{:stretchy => "false"} [
                          %mi k
                          %msup
                            %mo{:stretchy => "false"} ]
                            %mi i
                      %msub
                        %mo ×
                        %mrow
                          %msup
                            %mi B
                            %mrow
                              %mi Λ
                              %mo{:stretchy => "false"} [
                              %mi k
                              %msup
                                %mo{:stretchy => "false"} ]
                                %mi i
                      %msup
                        %mi B
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    x^*
                    \\left(
                    A^{\Delta[k]}
                    \\to
                    A^{\Lambda[k]^i} \times_{ B^{\Lambda[k]^i}   }  B^{\Delta[k]}
                    \\right)
            %p
              being an epimorphism. Now the morphism in parenthesis is an epimorphism since the fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is in particular an objectwise Kan fibration, and
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functors such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mo *
                  %annotation{:encoding => "application/x-tex"} x^*
              preserve epimorphisms.
          %h2#MonoidalStructure Closed monoidal structure
          %p
            If the underlying site has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
            with respect to the standard
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
          %p
            See for instance
            = succeed "." do
              %a{:href => "http://www.math.univ-toulouse.fr/~toen/crm-2008.pdf#page=24"} here
          .num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a category with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
              makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
          .proof
            %h6#proof_7 Proof
            %p It is sufficient to check that the Cartesian product of presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo :
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %mo ×
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %mo →
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    \\otimes : sPSh(C)_{proj} \times sPSh(C)_{proj} \to sPSh(C)_{proj}
            %p
              is a left
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sPSh(C)
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              for that it is sufficient to check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              satisfies the
              %span.newWikiWord
                pushout-prodct axiom
                %a{:href => "/nlab/new/pushout-prodct+axiom"} ?
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} generating (acyclic) cofibrations
            %p
              As discussed at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo ×
                    %mi i
                    %mo :
                    %mi U
                    %mo ⋅
                    %mi S
                    %mo →
                    %mi U
                    %mo ⋅
                    %mi T
                  %annotation{:encoding => "application/x-tex"}
                    Id \times i : U \cdot S \to U \cdot T
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              representable and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi S
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} i : S \to T
              an (acylic) cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/product"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,cov}
              be the left
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization
              at the
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
              projections.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any cofibrant object, the
              = succeed "-adjunction" do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"}
                    (X \times (-) \dashv [X,-]) : [C^{op}, sSet]_{proj,cov}
                    \\to
                    [C^{op}, sSet]_{proj,cov}
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          .proof
            %h6#proof_8 Proof
            %p
              The above lemma implies that the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \times (-)
              preserves cofibrations. As discussed in the
              %a{:href => "http://ncatlab.org/nlab/show/Quillen+adjunction#sSet"} section on sSet-enriched adjunctions
              at
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              since the adjunction is
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,cov}
              is a
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left proper
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              it suffices to check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,-]
              preserves fibrant objects.
            %p
              For that let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              be a covering family and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} A \in [C^{op}, sSet]_{proj,cov}
              is fibrant, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op}, sSet](U, [X,A]) \to [C^{op},sSet](C(\{U_i\}), [X,A])
            %p
              is an equivalence of
              = succeed "es." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %p
              Writing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mi n
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) = \int^{[n]} \Delta[n] \cdot \coprod U_{i_0, \cdots, i_n}
              and using that the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              preserves
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/end"} end
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi U
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op},sSet]( X \times C(\{U_i\}) \to X \times U , A)
            %p
              being an equivalence. Now we observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X \times C(\{U_i\}) \to X\times U
              is a
              %a.existingWikiWord{:href => "/nlab/show/local+epimorphism"} local epimorphism
              in the above sense, namely a morphism such that for every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                    %mo ×
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V \to X \times U
              out of a representable, there is a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi σ
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                            %mo ×
                            %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X \times C(\{U_i\})
                    \\\
                    \&amp; {}^{\mathllap{\sigma}}\nearrow &amp; \downarrow
                    \\\
                    V &amp;\to&amp; X \times U
                    }
                    \\,.
            %p
              By the above discussion of the Čech-localization of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %h2#HomotopyLimits Homotopy (co)limits
          %p
            Properties of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
          %ul
            %li
              %a{:href => "http://ncatlab.org/nlab/show/homotopy+limit#SimpSheaves"} Homotopy (co)limits of simplicial (pre)sheaves
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/site"} site
          .num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi D
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F : D \to [C^{op}, sSet]
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite
              diagram.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi glob
                    %msub
                      %mi lim
                      %mo ←
                    %mi F
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{glob}\lim_{\leftarrow} F \in [C^{op}, sSet]
              for any representative of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              computed in the global model structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi glob
                    %msub
                      %mi lim
                      %mo ←
                    %mi F
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{glob}\lim_{\leftarrow} F \in [C^{op},sSet]
              presents also the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              computed in the local model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
          .proof
            %h6#proof_9 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %msub
                      %mi lim
                      %mo ←
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}\lim_{\leftarrow}
              computes the corresponding
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              and
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheafification"} (∞,1)-sheafification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is a left
              %a.existingWikiWord{:href => "/nlab/show/exact+%28%E2%88%9E%2C1%29-functor"} exact (∞,1)-functor
              and preserves these finite
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi D
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mi proj
                                %mo ,
                                %mi loc
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi inj
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ∘
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %msub
                                  %mi L
                                  %mo *
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi D
                            %mo ,
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi proj
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi inj
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ∘
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℝ
                                  %munder
                                    %mi lim
                                    %mo ←
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ℝ
                                  %munder
                                    %mi lim
                                    %mo ←
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %mi proj
                                %mo ,
                                %mi loc
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ∘
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mi L
                                %mo ≃
                                %mi 𝕃
                                %mi Id
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi proj
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    ([D, [C^{op}, sSet]_{proj, loc}]_{inj})^\circ
                    \&amp;\stackrel{L_*}{\leftarrow}&amp;
                    ([D, [C^{op}, sSet]_{proj}]_{inj})^\circ
                    \\\
                    \\downarrow^{\mathrlap{\mathbb{R} \lim_\leftarrow}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\mathbb{R} \lim_\leftarrow}}
                    \\\
                    ([C^{op}, sSet]_{proj,loc})^\circ
                    \&amp;\stackrel{L \simeq \mathbb{L} Id}{\leftarrow}&amp;
                    ([C^{op}, sSet]_{proj})^\circ
                    }
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≃
                    %mi 𝕃
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} L \simeq \mathbb{L} Id
              is the left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of the identity for the
              %a{:href => "#PresentationOfTheInfinTopos"} above
              left Bousfield localization. Since left Bousfield localization does not change the cofibrations and includes the global weak equivalences into the local weak equivalences, the postcomposition of the diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mi Id
                  %annotation{:encoding => "application/x-tex"} \mathbb{L} Id
              is given by cofibrant replacement in the local structure, too. But the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              of the diagram is invariant, up to equivalence, under cofibrant replacement, and hence a finite homotopy limit diagram in the global structure is also one in the local structure.
          %h2#InclusionOfChainComplexes Inclusion of chain complexes of sheaves
          %p
            We discuss how
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a{:href => "#PresentationOfInfiniToposes"} presented by
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{loc}
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and generalizes it to general base objects.
          %p
            Observe from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+abelian+groups"} model structure on simplicial abelian groups
            that the degreewise
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/free+functor"} free functor
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊣
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Ab
                  %mover
                    %munder
                      %mo →
                      %mi U
                    %mover
                      %mo ←
                      %mi F
                  %mi Set
                %annotation{:encoding => "application/x-tex"} (F \dashv U) : Ab \stackrel{\overset{F}{\leftarrow}}{\underset{U}{\to}} Set
            (see
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+Lawvere+theory"} algebra over a Lawvere theory
            for details) induces a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊣
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi sAb
                    %mi Quillen
                  %mover
                    %munder
                      %mo →
                      %mi U
                    %mover
                      %mo ←
                      %mi F
                  %msub
                    %mi sSet
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"}
