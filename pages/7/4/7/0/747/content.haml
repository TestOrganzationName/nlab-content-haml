                                %mo ≃
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
