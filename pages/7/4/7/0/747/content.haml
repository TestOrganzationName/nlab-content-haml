                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi proj
                            %msup
                              %mo{:stretchy => "false"} )
