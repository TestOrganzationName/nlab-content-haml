              (given by left
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
              in that it preserves
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
            %p
              Then the induced
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi SPSh
                    %mo{:stretchy => "false"} (
                    %mi D
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi inj
                      %mi loc
                    %mover
                      %mo →
                      %mo ←
                    %mi SPSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi inj
                      %mi loc
                    %mo :
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    f_* : SPSh(D)_{inj}^{loc} \stackrel{\leftarrow}{\to} SPSh(C)_{inj}^{loc} : f^*
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              for the local injective model structure on presheaves on both sides.
          .proof
            %h6#proof Proof
            %p
              This is “little fact 5)” on page 10, 11 of (
              %a{:href => "#JardineLecture"}> JardineLectures
              ).
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} f : D \hookrightarrow
              a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dense+sub-site"} dense sub-site
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f_* : [D^{op}, sSet] \to [C^{op}, sSet]
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              yields a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi f
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi f
                            %mo *
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"}
                    (f^* \dashv f_*)
                    \:
                    [D^{op}, sSet]_{inj,loc} \stackrel{\overset{f^*}{\leftarrow}}{\underset{f_*}{\to}}
                    [C^{op}, sSet]_{inj,loc}
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localizations
              of the projective model structures at the
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} S(\{U_i\}) \to U
              for each
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
          .proof
            %h6#proof_2 Proof
            %p
              It is immediate that we have a simplicial Quillen adjunction on the global injective model structure: by definition of right
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              we have an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              and the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              restriction functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              trivially preserves injective cofibrations and acyclic cofibrations.
            %p
              Since we have
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+categories"} left proper model categories
              it is sufficient (by the discussion at
              = succeed ")" do
                %a{:href => "http://nlab.mathforge.org/nlab/show/simplicial%20Quillen%20adjunction#Recognition"} recognition of simplicial Quillen adjunctions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
              preserves locally fibrant objects, which in turn by properties of
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              is equivalent to checking that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              sends covering sieve inclusions to weak equivalences in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi D
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [D^{op}, sSet]_{proj,loc}
            %p
              By the
              = succeed "," do
                %a{:href => "#GeneralizedCover"} result on generalized covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S(\{U_i\}) \to X
              and every representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} K \in D
              and morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo →
                      %msup
                        %mi f
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} K \to f^* X
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi K
                      %mi j
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{K_j \to K\}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              and local lifts
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi K
                              %mi j
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi K
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    K_j &amp;\to&amp; f^*(S(\{U_i\}))
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    K &amp;\to&amp; f^* X
                    }
                    \\,.
            %p
              This follows directly from the single defining condition on a
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %h2#PresentationOfInfiniToposes
            Presentation of
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .num_def
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              be the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} W = \{C(\{U_i\}) \to U\}
              be the set of
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
              projections in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C, sSet]
              for each
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Id
                    %mo ⊣
                    %mi Id
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mover
                      %munder
                        %mo →
                        %mi Id
                      %mover
                        %mo ←
                        %mi Id
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    (Id \dashv Id)
                    \:
                    [C^{op}, sSet]_{proj,loc}
                    \\stackrel{\overset{Id}{\leftarrow}}{\underset{Id}{\to}}
                    [C^{op}, sSet]_{proj}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} ([C^{op}, sSet]_{proj})^\circ
              for the full sub-
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
              on the fibrant-cofibrant objects, similarly for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} ([CartSp^{op}, sSet]_{proj,loc})^\circ
          #PresentationOfTheInfinTopos.num_prop
            %h6#proposition_3 Proposition
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Sh
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn ∞
                                %mo ,
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
