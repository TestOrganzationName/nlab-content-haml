                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Sh_{(\infty,1)}(C)
                    \&amp;\stackrel{\overset{L}{\leftarrow}}{\hookrightarrow}&amp;
