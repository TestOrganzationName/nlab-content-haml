                            %mi n
                        %annotation{:encoding => "application/x-tex"} \Sigma_n
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/action"} action
              %li
                %p
                  the following
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagrams commute
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
