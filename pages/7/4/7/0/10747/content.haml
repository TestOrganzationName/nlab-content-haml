                        %mo ∧
                        %msup
                          %mi S
                          %mi k
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi σ
                              %mi n
                            %mo ∧
                            %mi id
                        %msub
                          %mi X
