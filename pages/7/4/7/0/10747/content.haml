                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X_n \wedge S^1 &amp;\stackrel{f_n \wedge id}{\longrightarrow}&amp; Y_n \wedge S^1
                        \\\
                        \\downarrow^{\mathrlap{\sigma^X_n}} &amp;&amp; \downarrow^{\mathrlap{\sigma^Y_n}}
                        \\\
                        X_{n+1} &amp;\stackrel{f_{n+1}}{\longrightarrow}&amp; Y_{n+1}
                        }
                        \\,.
          %p
            (
            %a{:href => "#HoveyShipleySmith00"}> Hovey-Shipley-Smith 00, def. 1.2.1
            ,
            = succeed ")" do
              %a{:href => "#Schwede12"} Schwede 12, def. 1.1
          %h3#AsSModules
            As
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Sym
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
          %p A more concise equivalent formulation is the following:
          #SphereSpectrumAsDayConvolutionMonoidOverSym.num_defn
            %h6#definition_3 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                  %annotation{:encoding => "application/x-tex"} Sym
              for the standard
              %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeleton
              of the
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              labeled by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
              and the automorphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              forming the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Sigma_n
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              monoidal structure on
              %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
              gives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                  %annotation{:encoding => "application/x-tex"} Sym
              the structure of a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              with tensor product given by addition of natural numbers on objects.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [Sym,sSet^{\ast/}]
              for the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              equipped with the induced
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              product. Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Sym
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{S}_{Sym} \in [Sym,sSet^{\ast/}]
            %p
              for the functor which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              to the minimal simplicial
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mo ∧
                          %mi n
                  %annotation{:encoding => "application/x-tex"} S^n = (S^1)^{\wedge^n}
              and which sends elements of the symmetric group to the corresponding endomorphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              exchanging
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              factors.
            %p
              Regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Sym
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
              as a
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              with respect to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              %a{:href => "Day+convolution#Monoids"} discussion there
              by the system of canonical natural morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ∧
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ⟶
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{n_1}\wedge S^{n_2} \longrightarrow S^{n_1 + n_2}
                    \\,.
          #SymmetricSpectrumAsSModule.num_defn
            %h6#proposition Proposition
            %p
              Symmetric spectra in the sense of def.
              %a.maruku-ref{:href => "#SymmetricSpectrum"}
              are equivalently right
              %a.existingWikiWord{:href => "/nlab/show/module+objects"} module objects
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi Sym
                    %mo ,
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mo ⊗
                      %mi Day
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ([Sym,sSet^{\ast/}], \otimes_{Day})
              over the
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi Sym
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
              = succeed ":" do
                %a.maruku-ref{:href => "#SphereSpectrumAsDayConvolutionMonoidOverSym"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝕊
                      %mi Sym
                    %msub
                      %mi Mod
                      %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SymSpec(sSet)
                    \\simeq
                    \\mathbb{S}_{Sym}Mod_r
                    \\,.
          %p
            This point of view was highlighted and almost made explicit in (
            %a{:href => "#MandellMaySchwedeShipley01"}> Mandell-May-Schwede-Shipley 01
            ).
          .proof
            %h6#proof Proof
            %p
              By the discussion
              = succeed "," do
                %a{:href => "Day+convolution#Monoids"} there
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝕊
                        %mi Sym
                    %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
              are equivalently right
              %a.existingWikiWord{:href => "/nlab/show/modules+over+monoidal+functors"} modules over monoidal functors
              over the monoidal functor corresponding to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi Sym
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}_{Sym}
              as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#SphereSpectrumAsDayConvolutionMonoidOverSym"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Sym
                    %mo ⟶
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} X \colon Sym \longrightarrow sSet^{\ast/}
              equipped with
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi p
                    %mo ∧
                    %msup
                      %mi S
                      %mi q
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    X_p \wedge S^{q}  \longrightarrow X_{p+q}
            %p
              satisfying the evident
              %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              property. In the present case this action property says that these morphisms are determined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi p
                    %mo ∧
                    %msup
                      %mi S
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    X_p \wedge S^1 \longrightarrow X_{p+1}
            %p
              under the isomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi p
                      %mo ≃
                      %msup
                        %mi S
                        %mn 1
                      %mo ∧
                      %msup
                        %mi S
                        %mrow
                          %mi p
                          %mo −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^p \simeq S^1 \wedge S^{p-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                  %annotation{:encoding => "application/x-tex"} Sym
              is the equivariance under the symmetric group actions in def.
              = succeed "." do
                %a.maruku-ref{:href => "#SymmetricSpectrum"}
          %p
            For more on this see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
                –
                %a{:href => "Model%20categories%20of%20diagram%20spectra#PartI"} part I
          %h2#properties Properties
          %h3#SmashProduct Smash product
          %p
            %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            modeled on symmetric spectra
          %p
            e.g. (
            %a{:href => "#Schwede12"}> Schwede 12, I.3
            )
          %h3#HomotopyGroups Homotopy groups
          %p
            The main technical issue with symmetric spectra is that the evident definition of
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
            of symmetric spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %munder
                      %mi lim
                      %mo ⟶
                    %mi k
                  %msub
                    %mi π
                    %mrow
                      %mi k
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\pi_n(X) = \underset{\longrightarrow}{\lim}_k \pi_{k+n}(X_k)
          %p
            does
            %em not
            in general come out in the homotopy correct way; instead one needs to replace by a “
            %a.existingWikiWord{:href => "/nlab/show/semistable+symmetric+spectrum"}> semistable symmetric spectrum
            ” first, which however is hard to control (
            %a{:href => "#HoveyShipleySmith00"}> Hovey-Shipley-Smith 00, section 3.1
            ,
            = succeed ")," do
              %a{:href => "#Schwede12"} Schwede 12, chapter I, sections 2 and 6 and 8
            = succeed ")." do
              %a{:href => "#Malkiewich14"} Malkiewich 14, section 2.3
          %p
            Among the various (now) common models for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            = succeed ")." do
              %a{:href => "#MandellMaySchwedeShipley01"} Mandell-May-Schwede-Shipley 01, p. 3
          %p
            In particular, this problem goes away for the concept of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          %p
            Technically, the issue comes down to the fact that the
            %a.existingWikiWord{:href => "/nlab/show/quotients"} quotients
            of
            %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mi q
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi Σ
                    %mrow
                      %mi q
                      %mo −
                      %mi n
                %annotation{:encoding => "application/x-tex"} \Sigma_q/\Sigma_{q-n}
            do not become highly connected for large
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            the way the quotients
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(q)/O(n-q)
            of
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+groups"} orthogonal groups
            do (
            %a{:href => "#MandellMaySchwedeShipley01"}> Mandell-May-Schwede-Shipley 01, proof of lemma 8.6, top of p. 26
            ). See
            %a{:href => "Model+categories+of+diagram+spectra#AdjunctsOfFreeSpectrumInclusionsAreOrAreNotStableWeakHomotopyEquivalences"} this proposition
            at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symmetric+sequence"} symmetric sequence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+symmetric+spectrum"} free symmetric spectrum
