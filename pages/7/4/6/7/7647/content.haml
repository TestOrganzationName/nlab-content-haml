              as multiplication with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mrow
                          %mn 2
                          %mi π
                          %mi{:mathvariant => "normal"} i
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mi p
                              %mi k
                    %annotation{:encoding => "application/x-tex"} e^{2 \pi \mathrm{i} \tfrac{p}{k}}
            %p
              The irreps of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} Sym_3
              are the
              %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{1}
              %a.existingWikiWord{:href => "/nlab/show/sign+representation"} sign representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mi sgn
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}_{sgn}
              and the
              %a{:href => "representation+theory+of+the+symmetric+group#TheStandardRepresentation"} standard representation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{2}
            %p
              The irreps of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi p
                    %mo ≀
                    %msub
                      %mi Sym
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} C_p \wr Sym_3
              according to Thm.
              %a.maruku-ref{:href => "#IrrepsOfWreathProductOfFiniteGroup"}
              may be regarded as falling into 3 classes, according to the nature of the corresponding partition:
            %p
              %strong Case 1 – Partition involves a single irrep
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \mathbf{1}_p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Sym
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} Sym_{(3)} \simeq Sym_3
              and the formula
              %a.maruku-eqref{:href => "#eq:FormulaForIrrepsOfWreathProductWithFiniteGroup"} (3)
              produces the representations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mi p
                      %mrow
                        %msub
                          %mo ⊠
                          %mn 3
                    %mo ⊗
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi p
                    %mo ≀
                    %msub
                      %mi Sym
                      %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{1}_{p}^{\boxtimes_3}
                    \\otimes
                    \\sigma
                    \\;\;
                    \\in
                    \\;\;
                    Rep(C_p \wr Sym_3)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %msub
                      %mi C
                      %mi p
                  %annotation{:encoding => "application/x-tex"} p \in C_p
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mi sgn
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %annotation{:encoding => "application/x-tex"} \sigma \in \big\{\mathbf{1}, \mathbf{1}_{sgn}, \mathbf{2}\big\}
            %p
              %strong> Case 2 – Partition involves two distinct irreps
              ,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbf{1}_p
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mrow
                          %mi p
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathbf{1}_{p'}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo ×
                    %msub
                      %mi Sym
                      %mn 2
                    %mo ≃
                    %msub
                      %mi Sym
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Sym_{(3)} = 1 \times Sym_2 \simeq Sym_2
              and the formula
              %a.maruku-eqref{:href => "#eq:FormulaForIrrepsOfWreathProductWithFiniteGroup"} (3)
              produces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi C
                      %mi k
                    %mo ≀
                    %msub
                      %mi Sym
                      %mn 3
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %msub
                      %mo ⊗
                      %mrow
                        %mi ℂ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msub
                          %mi C
                          %mi k
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mi k
                        %mo ≀
                        %msub
                          %mi Sym
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mi p
                    %mo ⊠
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mrow
                        %mi p
                        %mo ′
                      %mrow
                        %msub
                          %mo ⊠
                          %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⊗
                    %mi σ
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}\big[
                    C_k \wr Sym_3
                    \\big]
                    \\otimes_{
                    \\mathbb{C}\big[
                    C_k \times (C_k \wr Sym_2)
                    \\big]
                    }
                    \\Big(
                    \\big(
                    \\mathbf{1}_{p}
                    \\boxtimes
                    \\mathbf{1}_{p'}^{\boxtimes_2}
                    \\big)
                    \\otimes
                    \\sigma
                    \\Big)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mi p
                    %mo ′
                    %mo ∈
                    %msub
                      %mi C
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p \neq p' \in C_k
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mi sgn
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                    %annotation{:encoding => "application/x-tex"} \sigma \in \big\{\mathbf{1}, \mathbf{1}_{sgn}\big\}
            %p
              %strong> Case 3 – Partition involves three distinct irreps
              ,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mrow
                          %msub
                            %mi p
                            %mn 2
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mrow
                          %msub
                            %mi p
                            %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbf{1}_{p_1}, \mathbf{1}_{p_2}, \mathbf{1}_{p_3}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 1
                    %mo ×
                    %mn 1
                    %mo ×
                    %mn 1
                    %mo ≃
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} Sym_{(3)} \simeq 1 \times 1 \times 1 \simeq 1
              and the formula
              %a.maruku-eqref{:href => "#eq:FormulaForIrrepsOfWreathProductWithFiniteGroup"} (3)
              produces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi C
                      %mi k
                    %mo ≀
                    %msub
                      %mi Sym
                      %mn 3
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %msub
                      %mo ⊗
                      %mrow
                        %mi ℂ
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                        %msubsup
                          %mi C
                          %mi k
                          %mn 3
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %mo ⊠
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                    %mo ⊠
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mn 1
                      %mrow
                        %msub
                          %mi p
                          %mn 3
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}\big[
                    C_k \wr Sym_3
                    \\big]
                    \\otimes_{
                    \\mathbb{C}\big[
                    C_k^3
                    \\big]
                    }
                    \\big(
                    \\mathbf{1}_{p_1}
                    \\boxtimes
                    \\mathbf{1}_{p_2}
                    \\boxtimes
                    \\mathbf{1}_{p_3}
                    \\big)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo ∈
                    %msub
                      %mi C
                      %mi k
                  %annotation{:encoding => "application/x-tex"} p_i \in C_k
              pairwise distinct.
            %p
          %p
            %br/
          %h2#references References
          %p Monographs:
          %ul
            %li#BMMN06
              Meenaxi Bhattacharjee, Dugald Macpherson, Rögnvaldur G. Möller, Peter M. Neumann:
              = succeed "," do
                %em Wreath products
              = succeed "," do
                %em Notes on Infinite Permutation Groups
              = succeed "," do
                %strong 1698
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/BFb0092558"} doi:10.1007/BFb0092558
          %p See also:
          %ul
            %li#Holland89
              W. Charles Holland:
              = succeed "," do
                %em The characterization of generalized wreath products
              %strong 13
              (1989) 152-172 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0021-8693(69)90069-6"}> doi:10.1016/0021-8693(69)90069-6
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://core.ac.uk/download/pdf/82380943.pdf"} pdf
          %p
            In the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/semigroups"} semigroups
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Charles+Wells"}> Charles Wells
              \:
              = succeed "," do
                %em Some applications of the wreath product construction
              %strong 83
              5 (1976) &amp;lbrack;
              %a{:href => "https://doi.org/10.1080/00029890.1976.11994114"}> doi:10.1080/00029890.1976.11994114
              \&amp;rbrack;
          %p Special cases and applications:
          %ul
            %li
              %p
                G. Baumslag:
                = succeed "," do
                  %em Wreath products and extensions
                %strong 81
                (1963) 286-299 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01111576"}> doi:10.1007/BF01111576
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/I.+G.+Macdonald"}> I. G. Macdonald
                \:
                = succeed "," do
                  %em Polynomial functors and wreath products
                %strong 18
                (1980) 173-204 [
                %a{:href => "https://doi.org/10.1016/0022-4049(80)90128-0"}> doi:10.1016/0022-4049(80)90128-0
                ,
                = succeed "]" do
                  %a{:href => "https://core.ac.uk/download/pdf/82423307.pdf"} pdf
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theory
            of wreath products with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
          %ul
            %li#JamesKerber84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gordon+D.+James"}> Gordon D. James
                , Adalbert Kerber:
                = succeed "," do
                  %em Representations of Wreath Products
                = succeed "," do
                  %em The Representation Theory of the Symmetric Group
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9781107340732"} doi:10.1017/CBO9781107340732
            %li
              %p
                I. A. Pushkarev:
                = succeed "," do
                  %em On the representation theory of wreath products of finite groups and symmetric groups
                %strong 96
                (1999) 3590–3599 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF02175835"}> doi:10.1007/BF02175835
                \&amp;rbrack;
              %p
                originally in:
                = succeed "," do
                  %em Representation theory, dynamical systems, combinatorial and algorithmic methods. Part II
                = succeed "," do
                  %strong 240
                = succeed "&rbrack;" do
                  %a{:href => "https://www.mathnet.ru/eng/znsl475"} mathnet:znsl475
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/wreath+product+of+groups"} wreath products
            of a
            %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic
            with a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            as analogs of (
            %a.existingWikiWord{:href => "/nlab/show/anyon"}> anyon
            )
            %a.existingWikiWord{:href => "/nlab/show/braid+groups"} braid groups
            in
            %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"} dimension
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &gt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \gt 2
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Freedman"}> Michael Freedman
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Matthew+B.+Hastings"} Matthew B. Hastings
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chetan+Nayak"} Chetan Nayak
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Xiao-Liang+Qi"} Xiao-Liang Qi
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kevin+Walker"} Kevin Walker
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Zhenghan+Wang"} Zhenghan Wang
              = succeed "," do
                %em Projective Ribbon Permutation Statistics: a Remnant of non-Abelian Braiding in Higher Dimensions
              %strong 83
              115132 (2011) &amp;lbrack;
              %a{:href => "https://doi.org/10.1103/PhysRevB.83.115132"}> doi:10.1103/PhysRevB.83.115132
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1005.0583"} arXiv:1005.0583
          %p
            On wreath products with
            %a.existingWikiWord{:href => "/nlab/show/braid+groups"} braid groups
            (cf. also
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/framed+braid+group"} framed braid group
          %ul
            %li
              %em
                Semidirect products with braid groups and type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} F_\infty
              \&amp;lbrack;
              %a{:href => "https://mathoverflow.net/q/179104/381"}> MO:q/179104
              \&amp;rbrack;
          .property
