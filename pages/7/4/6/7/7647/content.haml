                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi S
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {\vert S \vert}
                  copies of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
              %li
                %p
                  with
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/group+action"} acting
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mi S
                      %annotation{:encoding => "application/x-tex"} H^S
                  by
                  %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
                  of factors:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi h
                          %mi s
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi s
                            %mo ∈
                            %mi S
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mi h
                          %mrow
                            %msup
                              %mi g
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi s
                            %mo ∈
                            %mi S
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        g \big((h_s)_{s \in S}\big)
                        \\;\coloneqq\;
                        \\big(h_{g^{-1}(s)}\big)_{s \in S}
                        \\,.
            %p
          %p
            (cf.
            = succeed "," do
              %a{:href => "#BMMN06"} BMMN 2006, Def. 8.1
            = succeed ")" do
              %a{:href => "#JamesKerber84"} James &amp; Kerber 1984 §4.1
          %p
          #Notation.num_remark
            %h6 Remark
            %p
              %strong (Notation)
              Other notation for “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mo ≀
                      %mi S
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \wr_S G
              ” is “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi Wr
                      %mi S
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H Wr_S G
              ” or “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi wr
                      %mi S
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H wr_S G
              ”.
            %p
              Often the choice of
              = succeed "-set" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is notationally suppressed, writing instead “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi H
                    %mo ≀
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \wr G
              ”, etc.
            %p But beware that conventions differ:
            %p
              Some authors understand by default the
              %a.existingWikiWord{:href => "/nlab/show/regular+action"} regular action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/underlying+set"} underlying set
            %p
              But when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G = Sym(n)
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{1, \cdots, n\}
              is understood (cf. Ex.
              %a.maruku-ref{:href => "#FundamentalGroupOfHomotopyQuotientByPermutations"}
              below). In this case
              %a{:href => "#JamesKerber84"} James &amp; Kerber 1984 §4.2
              speak of
              = succeed "." do
                %em
                  complete monomial groups over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
          %h2#examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/dihedral+group"} dihedral group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Dih
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Dih(4)
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo ⋅
                    %mn 4
                    %mo =
                    %mn 8
                  %annotation{:encoding => "application/x-tex"} 2\cdot 4=8
              is the wreath product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 2
                    %mo ≀
                    %msub
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C_2 \wr C_2
              of
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} C_2
              with itself (in this sense of regular representations).
          %p More generally:
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/symmetry+group"} symmetry group
              of the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/hypercube"} hypercube
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 2
                      %mo ≀
                      %mi Sym
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_2 \wr Sym(n)
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Sylow+p-subgroup"}
                Sylow-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                \-subgroups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} P_n
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              can be
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursively
              described as the wreath product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi p
                    %mo ≀
                    %msub
                      %mi P
                      %mi a
                  %annotation{:encoding => "application/x-tex"} C_p \wr P_a
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi p
                  %annotation{:encoding => "application/x-tex"} C_p
              is the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi a
                    %mi p
                    %mo +
                    %mi r
                  %annotation{:encoding => "application/x-tex"} n = a p+r
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi r
                      %mo ⪇
                      %mi p
                    %annotation{:encoding => "application/x-tex"} 0\leq r \lneq p
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Sylow+p-subgroup"}
                Sylow-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℓ
                    %annotation{:encoding => "application/x-tex"} \ell
                \-subgroups
              of
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_n(q)
              for
              %a.existingWikiWord{:href => "/nlab/show/greatest+common+divisor"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi gcd
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo ,
                      %mi ℓ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} gcd(q,\ell)=1
              can
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursively
              be described as a wreath product of the Sylow-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              \-subgroup of a strictly smaller
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mi m
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_{m}(q)
              and a Sylow-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              \-subgroups of a suitable
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
          %p
          #FundamentalGroupOfHomotopyQuotientByPermutations.num_remark
            %h6 Example
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
              of its
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              by the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(n)
              %a.existingWikiWord{:href => "/nlab/show/group+action"} acting
              by
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of factors, hence the
              %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi n
                    %mo ⫽
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ×
                    %mi E
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X^n \sslash Sym(n)
                    \\;\;
                    \\simeq
                    \\;\;
                    \\big(
                    X^n \times E Sym(n)
                    \\big)
                    \/ Sym(n)
                    \\,,
            %p
              has as
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              the wreath product with the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ⫽
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≀
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1\big(
                    X^n \sslash Sym(n)
                    \\big)
                    \\;\simeq\;
                    \\pi_1(X) \wr Sym(n)
                    \\,.
            %p
          (cf.
          = succeed ")" do
            %a{:href => "https://math.stackexchange.com/a/867292/58526"} MO:a/867292
          %p
          .num_remark
            %h6 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/framed+braid+group"} framed braid group
              is the wreath product with the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              of a plain
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/braid+group"} braid group
          %h2#properties Properties
          %h3#general General
          %p
          #AsAPermutationGroup.num_remark
            %h6 Remark
            %p
              %strong (as a permutation group)
              %br/
              If both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \subset Sym(X)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⊂
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \subset Sym(Y)
              are presented as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/permutation+groups"} permutation groups
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              by letting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              act trivially on the first and naturally on the second factor and letting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} H^Y
              act on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\times Y
              such that the
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} H^Y
              permutes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} X\times\{y\}
              naturally and fixes everything else pointwise.
          (e.g.
          = succeed ")" do
            %a{:href => "#Holland89"} Holland 1989
          %h3#IrreducibleRepresentations Irreducible representations
          %blockquote
            %p
              (See also at
              = succeed ".)" do
                %em
