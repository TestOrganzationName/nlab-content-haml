              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/physics"}> physics
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
                    %math#mathml_63e4a3bd826a49ac3b8e2f5d66fe97285439ca4c_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi θ
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi z
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi τ
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi Tr
                          %mo{:stretchy => "false"} (
                          %mi exp
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:mathvariant => "bold"}
                            %mi τ
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
