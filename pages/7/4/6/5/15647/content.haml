                        %annotation{:encoding => "application/x-tex"} \zeta
                    (=
                    %a.existingWikiWord{:href => "/nlab/show/Mellin+transform"} Mellin transform
                    of
                    = succeed ")" do
                      %math#mathml_63e4a3bd826a49ac3b8e2f5d66fe97285439ca4c_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi θ
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
