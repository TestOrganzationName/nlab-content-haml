                  %th
                    %a.existingWikiWord{:href => "/nlab/show/eta+function"} eta function
                    %math#mathml_63e4a3bd826a49ac3b8e2f5d66fe97285439ca4c_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                        %annotation{:encoding => "application/x-tex"} \eta
                  %th
