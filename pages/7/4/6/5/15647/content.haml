                    of
                    %a.existingWikiWord{:href => "/nlab/show/worldsheet"} worldsheet
                    %math#mathml_63e4a3bd826a49ac3b8e2f5d66fe97285439ca4c_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
