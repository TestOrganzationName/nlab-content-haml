                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \theta(\mathbf{z},\mathbf{\tau}) = Tr(\exp(-\mathbf{\tau} \cdot (D_\mathbf{z})^2))
                    as function of
                    %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
                    %math#mathml_63e4a3bd826a49ac3b8e2f5d66fe97285439ca4c_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
