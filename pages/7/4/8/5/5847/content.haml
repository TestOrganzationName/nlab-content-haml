                        %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"}> Jones' theorem
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Deligne-Kontsevich conjecture
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality+for+geometric+stacks"} Tannaka duality for geometric stacks
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#GeneralAbstractNotion"} General abstract notion
              %ul
                %li
                  %a{:href => "#definition"} Definition
                %li
                  %a{:href => "#properties"} Properties
              %li
                %a{:href => "#ConcreteNotion"} Concrete notions
              %ul
                %li
                  %a{:href => "#in_differential_geometry"} In differential geometry
                %li
                  %a{:href => "#in_algebraic_geometry"} In algebraic geometry
                %li
                  %a{:href => "#in_noncommutative_geometry"} In noncommutative geometry
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#References"} References
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            of
            %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo ⟶
                    %mi p
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \overset{p}{\longrightarrow} Y
            is called
            %em formally étale
            if it has a
            %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
            as
            %a.existingWikiWord{:href => "/nlab/show/%C3%A9tal%C3%A9+spaces"} étalé spaces
            do locally, but for
            %em
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesmal
            extensions: If for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Z \overset{f}{\to} Y
            any morphism and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℜ
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Re(Z) \to X
            a lift of its restriction along its
            %a.existingWikiWord{:href => "/nlab/show/reduction"} reduction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℜ
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} \Re(Z) \to Z
          %p
            (If there exists at least one such infinitesimal extension, it is called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formally+smooth+morphism"} formally smooth morphism
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formally+unramified+morphism"} formally unramified morphism
          %p
            Traditionally this has been considered in the context of
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            over formal duals of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            = succeed ")." do
              %a{:href => "#ConcreteNotion"} Concrete notion
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos#InfinitesimalCohesion"} differential cohesion
            = succeed "." do
              %a{:href => "#GeneralAbstractNotion"} General abstract notion
          %h2#GeneralAbstractNotion General abstract notion
          %h3#definition Definition
          %p Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mover
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msup
                            %mi u
                            %mo !
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi u
                            %mo *
                    %mover
                      %mo ↪
                      %mrow
                        %msup
                          %mi u
                          %mo *
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi th
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}
                  \\stackrel{\overset{u^*}{\hookrightarrow}}{\stackrel{\overset{u_*}{\leftarrow}}{\underset{u^!}{\to}}}
                  \\mathbf{H}_{th}
          %p
            be an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            of
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                %annotation{:encoding => "application/x-tex"} u^*
            a
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            that preserves the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            We may think of this as exhibiting
            %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity%2C1%29-topos#InfinitesimalCohesion"} differential cohesion
            (see there for details, but notice that in the notation used there we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                    %mo =
                    %msub
                      %mi i
                      %mo !
                  %annotation{:encoding => "application/x-tex"} u^* = i_!
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mo *
                  %mo =
                  %msup
                    %mi i
                    %mo *
                %annotation{:encoding => "application/x-tex"} u_* = i^*
            and
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo !
                    %mo =
                    %msub
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u^! = i_*
          %p
            We think of the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            as
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi th
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{th}
            as such cohesive spaces possibly equipped with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal extension
          %p
            As a class of examples that is useful to keep in mind consider a
            %a.existingWikiWord{:href => "/nlab/show/Q-category"} Q-category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi cod
                  %mo ⊣
                  %mi ϵ
                  %mo ⊣
                  %mi dom
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  (cod \dashv \epsilon \dashv dom) : \bar A \to A
          %p
            of
            %a{:href => "http://ncatlab.org/nlab/show/Q-category#InfinitesimalThickening"} infinitesimal thickening of rings
            and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi u
                    %mo *
                  %mo ⊣
                  %msub
                    %mi u
                    %mo *
                  %mo ⊣
                  %msup
                    %mi u
                    %mo !
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi th
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi dom
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo ⊣
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo ⊣
                  %mo{:stretchy => "false"} [
                  %mi cod
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mover
                    %mi A
                    %mo{:stretchy => "false"} ¯
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  ((u^* \dashv u_* \dashv u^!) : \mathbf{H}_{th} \to \mathbf{H}) :=
                  ([dom,Set] \dashv [\epsilon, Set] \dashv [cod,Set] : [\bar A, Set] \to [A,Set])
          %p
            be the corresponding
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Q-category#PresheafQCategory"} Q-category of copresheaves
          %p
            For any such setup there is a canonical
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msup
                    %mi u
                    %mo *
                  %mo →
                  %msup
                    %mi u
                    %mo !
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi : u^* \to u^!
                  \\,.
          %p
            Details of this are in the section
            %a{:href => "http://ncatlab.org/nlab/show/cohesive%20topos#AdjointQuadruples"} Adjoint quadruples
            at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
          %p
            From this we get for every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            a canonical morphism
          #eq:MorphismIntoPullback.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi u
                    %mo *
                  %mi X
                  %mo →
                  %msup
                    %mi u
                    %mo *
                  %mi Y
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msup
                        %mi u
                        %mo !
                      %mi Y
                  %msup
                    %mi u
                    %mo !
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  u^* X \to u^* Y \prod_{u^! Y} u^! X
                  \\,.
          #AbstractFormallyEtaleMorphism.num_defn
            %h6#definition_2 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              is called
              %strong formally étale
              if
              %a.maruku-eqref{:href => "#eq:MorphismIntoPullback"} (1)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> KontsevichRosenberg, def. 5.1, prop. 5.3.1.1
            ).
          %p
            In other words,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is formally étale if the
            = succeed "-component" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi u
                            %mo *
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msup
                                %mi u
                                %mo *
                              %mi f
                        %mtd
                          %msup
                            %mi u
                            %mo *
                          %mi Y
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi X
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi Y
                      %mtr
                        %mtd
                          %msup
                            %mi u
                            %mo !
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msup
                                %mi u
                                %mo !
                              %mi f
                        %mtd
                          %msup
                            %mi u
                            %mo !
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  u^* X &amp;\stackrel{u^* f}{\to}&amp; u^* Y
                  \\\
                  {}^{\mathllap{\phi_X}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi_Y}}
                  \\\
                  u^! X &amp;\stackrel{u^! f}{\to}&amp; u^! Y
                  }
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is a
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          #FormallySmooth.num_remark
            %h6#remark Remark
            %p
              The partial notions of this condition are: if the above morphism is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/formally+unramified+morphism"} formally unramified morphism
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formally+smooth+morphism"} formally smooth morphism
          #AbstractFormallyEtaleObject.num_defn
            %h6#definition_3 Definition
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              is called
              %strong formally étale
              if the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X \to *
              to the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              is formally étale.
          #AbstractFormallyEtaleObjectDirect.num_prop
            %h6#proposition Proposition
            %p
              The object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is formally étale precisely if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                    %mi X
                    %mo →
                    %msup
                      %mi u
                      %mo !
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    u^* X \to u^! X
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> KontsevichRosenberg, def. 5.3.2
            ).
          %h3#properties Properties
          .num_prop
            %h6#proposition_2 Proposition
            %p Formally étale morphisms are closed under composition.
          %p
            This appears as (
            %a{:href => "#KontsevichRosenbergSpaces"}> KontsevichRosenberg, prop. 5.4
            ).
          .proof
            %h6#proof Proof
            %p
              This follows by the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              for pullbacks: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Y
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} g : Y \to Z
              be two formally étale morphisms. Then by definition both of the small squares in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi u
                                  %mo *
                                %mi f
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi u
                                  %mo *
                                %mi g
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi Z
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi u
                                  %mo !
                                %mi f
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi u
                                  %mo !
                                %mi g
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    u^* X &amp;\stackrel{u^* f }{\to}&amp; u^* Y &amp;\stackrel{u^* g}{\to}&amp; u^* Z
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    u^! X &amp;\stackrel{u^! f }{\to}&amp; u^! Y &amp;\stackrel{u^! g}{\to}&amp; u^! Z
                    }
            %p are pullback squares. Hence so is the total outer square.
          %p
            Using also the other case of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
          .num_prop
            %h6#proposition_3 Proposition
            %p If
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo ↗
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi h
                          %mtd
                          %mtd
                            %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; Y
                    \\\
                    \&amp; {}^{\mathllap{f}}\nearrow &amp;&amp; \searrow^{\mathrlap{g}}
                    \\\
                    X &amp;&amp;\stackrel{h}{\to}&amp;&amp; Z
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              are formally étale, then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is formally étale.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Formally étale morphisms are closed under
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
          %p
            This means that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            is formally étale and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi f
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mo →
                        %mtd
                          %mi Y
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp;\to &amp; X &amp;\to&amp; A
                  \\\
                  \\downarrow^{\mathrlap{p}} &amp;&amp; \downarrow^{\mathrlap{f}} &amp;&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  B &amp;\to&amp; Y &amp;\to&amp; B
                  }
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            such that the two horizontal composites are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identities"} identities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is formally étale.
          .proof
            %h6#proof_2 Proof
            %p
              By applying the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msup
                      %mi u
                      %mo *
                    %mo →
                    %msup
                      %mi u
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \phi : u^* \to u^!
              to this diagram we obtain a retract diagram in the category of squares, given by the naturality squares of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a{:href => "http://ncatlab.org/nlab/show/retract#RetractsOfLimits"} this proposition
              at
              %em
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              this implies that also the retracting square is a pullback, which means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is formally étale.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi u
                      %mo *
                  %annotation{:encoding => "application/x-tex"} u^*
              preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
          .proof
            %h6#proof_3 Proof
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %msub
                              %mo ×
                              %mi Y
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \times_Y X &amp;\to&amp; X
                    \\\
                    {}^{\mathllap{p}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    A &amp;\to&amp; Y
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is formally étale.
            %p
              Applying the
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msup
                      %mi u
                      %mo *
                    %mo →
                    %msup
                      %mi u
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \phi : u^* \to u^!
              to this yields a square of squares. Two sides of this are the
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi A
                            %msub
                              %mo ×
                              %mi Y
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi X
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi u
                                    %mo *
                                  %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi u
                                    %mo !
                                  %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi Y
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    u^* A \times_Y X &amp;\to&amp; u^* X &amp;\stackrel{\phi_X}{\to}&amp;  u^! X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{u^* f}}
                    \&amp;&amp; \downarrow^{\mathrlap{u^! f}}
                    \\\
                    u^* A &amp;\to&amp; u^* Y &amp;\stackrel{\phi_Y}{\to}&amp; u^! Y
                    }
            %p and the other two sides are the pasting composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi A
                            %msub
                              %mo ×
                              %mi Y
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mrow
                                    %mi A
                                    %msub
                                      %mo ×
                                      %mi Y
                                    %mi X
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi A
                            %msub
                              %mo ×
                              %mi Y
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi u
                                    %mo !
                                  %mi f
                        %mtr
                          %mtd
                            %msup
                              %mi u
                              %mo *
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi A
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi u
                              %mo !
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    u^* A \times_Y X &amp;\stackrel{\phi_{A \times_Y X}}{\to}&amp; u^! A \times_Y A
                    \&amp;\stackrel{}{\to}&amp; u^! X
                    \\\
                    \\downarrow^{} &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{u^! f}}
                    \\\
                    u^* A &amp;\stackrel{\phi_A}{\to}&amp; u^! A &amp;\to&amp; u^! Y
                    }
                    \\,.
            %p Counting left to right and top to bottom, we have that
            %ul
              %li
                %p
                  the first square is a pullback by assumption on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi u
                            %mo *
                        %annotation{:encoding => "application/x-tex"} u^*
              %li
                %p
                  the second square is a pullback, since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is formally étale.
              %li
                %p
                  the fourth square is a pullback since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi u
                          %mo !
                      %annotation{:encoding => "application/x-tex"} u^!
                  is
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  and so also preserves pullbacks;
              %li
                %p also the total bottom rectangle is a pullback, since it is equal to the bottom total rectangle;
              %li
                %p
                  therefore finally the third square is a pullback, by the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  is formally étale.
          %h2#ConcreteNotion Concrete notions
          %p We discuss realizations of the above general abstract definition in concrete models of the axioms.
          %p
            See also the concrete notions of
            %a.existingWikiWord{:href => "/nlab/show/formally+smooth+morphism"} formally smooth morphism
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formally+unramified+morphism"} formally unramified morphism
          %h3#in_differential_geometry In differential geometry
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} infinitesimal cohesion
            exhibited by its inclusion into
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SynthDiff%E2%88%9EGrpd"} SynthDiff∞Grpd
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale morphism
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_prop
            %h6#proposition_6 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              is a formally étale morphism in this sense precisely if it is a
              %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
              in the traditional sense.
          %p
            See
            %a{:href => "http://ncatlab.org/nlab/show/synthetic+differential+infinity-groupoid#StructureSheaves"} this section
            for more details.
          %h3#in_algebraic_geometry In algebraic geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism+of+schemes"} formally étale morphism of schemes
          %h3#in_noncommutative_geometry In noncommutative geometry
          %p
            See (
            %a{:href => "#RosenbergKontsevich"}> RosenbergKontsevich, section 5.8
            )
          %h2#related_concepts Related concepts
          %p
            %a.existingWikiWord{:href => "/nlab/show/formally+smooth+morphism"} formally smooth morphism
            and
            %a.existingWikiWord{:href => "/nlab/show/formally+unramified+morphism"} formally unramified morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇒
                %annotation{:encoding => "application/x-tex"} \Rightarrow
            %strong formally étale morphism
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesion
            %ul
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                  %a.existingWikiWord{:href => "/nlab/show/flat+modality"} flat modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                        %mo ⊣
                        %mo ♭
                        %mo ⊣
                        %mo ♯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\esh \dashv \flat \dashv \sharp )
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/discrete+object"}> discrete object
                      ,
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/codiscrete+object"} codiscrete object
                      %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete object
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/points-to-pieces+transform"} points-to-pieces transform
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos+--+structures"} structures in cohesion
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/dR-shape+modality"} dR-shape modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                  %a.existingWikiWord{:href => "/nlab/show/dR-flat+modality"} dR-flat modality
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} ʃ
                          %mi dR
                        %mo ⊣
                        %msub
                          %mo ♭
                          %mi dR
                      %annotation{:encoding => "application/x-tex"} \esh_{dR} \dashv \flat_{dR}
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/tangent+cohesive+%28%E2%88%9E%2C1%29-topos"} tangent cohesion
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/differential+cohomology+diagram"} differential cohomology diagram
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            %ul
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/reduction+modality"} reduction modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊣
                      %annotation{:encoding => "application/x-tex"} \dashv
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimal+flat+modality"} infinitesimal flat modality
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ℜ
                        %mo ⊣
                        %mi ℑ
                        %mo ⊣
                        %mi &amp;
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Re \dashv \Im \dashv \&amp;)
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/reduced+object"}> reduced object
                      ,
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/coreduced+object"} coreduced object
                      %a.existingWikiWord{:href => "/nlab/show/formally+smooth+object"} formally smooth object
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+map"} formally étale map
