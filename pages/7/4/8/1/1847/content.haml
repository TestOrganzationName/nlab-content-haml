                    \\underset{j \in J}{\forall}
                    \\left(
                    \\underset{k \in I \setminus J}{\forall}
                    \\left(
                    f_j(x) \gt f_k(x)
                    \\right)
                    \\right)
                    \\right\}
                    \\,.
            %p
              By local finiteness there are only a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_k(x)
              greater than zero, hence the condition on the right is a finite number of strict inequalities. Since the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              are continuous, this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi J
                  %annotation{:encoding => "application/x-tex"} V_J
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi J
                  %annotation{:encoding => "application/x-tex"} V_J
              is contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} supp(f_j)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j \in J
              and hence in one of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              take
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∪
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi J
                            %mo ⊂
                            %mi I
                        %mrow
                          %mrow
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi J
                              %mo{:stretchy => "false"} |
                            %mo =
                            %mi n
                    %msub
                      %mi V
                      %mi J
                  %annotation{:encoding => "application/x-tex"}
                    V_n
                    \\;\coloneqq\;
                    \\underset{ {J \subset I} \atop { {\vert J\vert} = n } }{\cup}
                    V_J
            %p
              to be the union of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi J
                  %annotation{:encoding => "application/x-tex"} V_J
              over all subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              with precisely
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              elements.
            %p
              The set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi n
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{V_n \subset X\}_{n \in \mathbb{N}}
              is a cover because for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi V
                      %mrow
                        %msub
                          %mi J
                          %mi x
                  %annotation{:encoding => "application/x-tex"} x \in V_{J_x}
              for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi x
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi i
                    %mo ∈
                    %mi I
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi f
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    J_x \coloneqq \{ i \in I \;\vert\; f_i(x) \gt 0  \}
            %p (which is finite by local finitness of the partition of unity).
          %h3#colimits Colimits
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/colimits+of+paracompact+Hausdorff+spaces"} colimits of paracompact Hausdorff spaces
          %h3#HomotopyAndCohomology Homotopy and Cohomology
          %ul
            %li
              %p
                On paracompact spaces, abelian
                %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
                does compute
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              %p
                i.e. the canonical morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˇ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \check{H}(X,A) \to H(X,A)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                any
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
                of
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
                is an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                when the
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                underlying
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is paracompact.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              On a paracompact space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
              of finite height is refined by the
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+nerve"} Čech nerve
              of an ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
          %p
            For a hypercover of height
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq k \leq n
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a paracompact topological space, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi α
                        %mo ∈
                        %mi A
                  %annotation{:encoding => "application/x-tex"} \{U_\alpha\}_{\alpha \in A}
              be an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi α
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi α
                          %mi k
                  %annotation{:encoding => "application/x-tex"} U_{\alpha_0, \cdots, \alpha_{k}}
              be equipped itself with an open cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msubsup
                        %mi V
                        %mi β
                        %mrow
                          %msub
                            %mi α
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi α
                            %mi k
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{V^{\alpha_0, \cdots, \alpha_k}_{\beta}\}
            %p
              Then there exists a refinement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi U
                    %msub
                      %mo ′
                      %mrow
                        %mi α
                        %mo ′
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U'_{\alpha'}\}
              of the original cover, such that each
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mo ′
                      %mrow
                        %mi α
                        %msub
                          %mo ′
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi α
                        %msub
                          %mo ′
                          %mi k
                  %annotation{:encoding => "application/x-tex"} U'_{\alpha'_0, \cdots, \alpha'_k}
              for all indices distinct is contained in one of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi β
                    %annotation{:encoding => "application/x-tex"} V_\beta
          %p
            This appears as (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, lemma 7.2.3.5
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/countably+paracompact+topological+space"} countably paracompact topological space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"}> compact topological space
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/countably+compact+topological+space"} countably compact topological space
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/strongly+compact+topological+space"} strongly compact topological space
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+topological+space"} sequentially compact topological space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/orthocompact+space"} orthocompact space
          %h2#references References
          %p The notion of paracompact space was introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean+Dieudonn%C3%A9"}> Jean Dieudonné
              ,
              = succeed "," do
                %em Une généralisation des espaces compacts
          %p
            That
            %a.existingWikiWord{:href => "/nlab/show/fully+normal+spaces+are+equivalently+paracompact"} fully normal spaces are equivalently paracompact
            is due to
          %ul
            %li#Stone48
              A. H. Stone,
              = succeed "," do
                %em Paracompactness and product spaces
              = succeed ")" do
                %a{:href => "http://projecteuclid.org/euclid.bams/1183512390"} Euclid
          %p General accounts include
          %ul
            %li
              %p
                R. Engelking,
                = succeed "," do
                  %em General topology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Conrad"}> Brian Conrad
                \:
                %em Paracompactness and local compactness
                \&amp;lbrack;
                %a{:href => "http://math.stanford.edu/~conrad/diffgeomPage/handouts/paracompact.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Conrad-ParaAndLocalCompactness.pdf", :title => "pdf"} pdf
            %li
              %p
                D. K. Burke,
                = succeed "," do
                  %em Covering properties
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/K.+Kunen"} K. Kunen
            %li#Hatcher
              %p
                %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
                , section 1.2 of
                %em Vector bundles &amp; K-theory
                (
                %a{:href => "https://www.math.cornell.edu/~hatcher/VBKT/VBpage.html"}> web
                )
            %li#Junnia07
              %p
                Heikki Junnila, pp. 73 in:
                %em A second course in general topology
                (2007) &amp;lbrack;
                %a.existingWikiWord{:href => "/nlab/files/Junnila-ParacompactSpaces.pdf", :title => "pdf"}> pdf
                \&amp;rbrack;
            %li
              %p
                English Wikipedia:
                %a{:href => "http://en.wikipedia.org/wiki/Paracompact_space"} paracompact space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Encyclopedia+of+Mathematics"}> Encyclopedia of Mathematics
                \:
                = succeed "," do
                  %em
                    %a{:href => "http://eom.springer.de/p/p071300.htm"} Paracompact space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Encyclopedia+of+Mathematics"}> Encyclopedia of Mathematics
                \:
                %em
                  %a{:href => "http://eom.springer.de/p/p071310.htm"} Paracompactness criteria
          %p
            A basic discussion with an eye towards
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            and abelian
            %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+cohomology"} Čech cohomology
            is around page 32 of
          %ul#Brylinski
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
              ,
              %em Loop spaces, characteristic classes geoemetric quantization
          %ul
            %li#FP
              %a.existingWikiWord{:href => "/nlab/show/Rudolf+Fritsch"}> Rudolf Fritsch
              , Renzo A. Piccinini,
              = succeed "," do
                %em Cellular structures in topology
              = succeed ")" do
                %a{:href => "https://epub.ub.uni-muenchen.de/4493/1/4493.pdf"} pdf
          %p
            Discussion of paracompactness of
            %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
            includes
          %ul
            %li#Miyazaki52
              Hiroshi Miyazaki,
              = succeed "," do
                %em The paracompactness of CW-complexes
              %a{:href => "https://projecteuclid.org/euclid.tmj/1178245380"} Euclid
        .revisedby
