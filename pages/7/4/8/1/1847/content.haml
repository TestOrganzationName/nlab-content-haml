          #LocallyFiniteCover.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/locally+finite+cover"}> locally finite cover
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \left\{U_i \subset X \right\}_{i \in I}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called
              %em locally finite
              if for each point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mrow
                      %mo {
                      %mi x
                      %mo }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \left\{x\right\}
              such that it
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersects
              only finitely many elements of the cover, hence such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ∩
                    %msub
                      %mi U
                      %mi i
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} U_x \cap U_i \neq \emptyset
              for only a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
          #RefinementOfOpenCovers.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            %p
              Then a
              %em
                %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of this open cover is a set of open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{V_j \subset X\}_{j \in J}
              which is still an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              in itself and such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j \in J
              there exists an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi j
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} V_j \subset U_i
          %p Now:
          #ParacompactSpace.num_defn
            %h6#definition_4 Definition
            %p
              %strong (paracompact topological space)
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              is called
              %strong paracompact
              if every
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#RefinementOfOpenCovers"}
              %a.existingWikiWord{:href => "/nlab/show/locally+finite+open+cover"} locally finite open cover
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocallyFiniteCover"}
          #DifferingTerminology.num_remark
            %h6#remark Remark
            %p
              %strong (differing terminology)
            %p
              As with the concept of
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
              (
              %a{:href => "compact#space#DifferingTerminology"}> this remark
              ), some authors demand a paracompact space to also be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/paracompact+Hausdorff+space"} paracompact Hausdorff space
          %h2#examples Examples
          .num_example
            %h6#example Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact space
              is paracompact.
          .num_example
            %h6#example_2 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+topological+space"} locally connected
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+group"} locally compact
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              is paracompact (
              %a{:href => "topological+group#ConnectedLocallyCompactTopologicalGroupsAreSigmaCompact"}> this prop.
              ).
          .num_prop
            %h6#proposition Proposition
            %p
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+space"} locally compact
              and
              %a.existingWikiWord{:href => "/nlab/show/second-countable+space"} second-countable
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              are paracompact.
          #ParacompactFromLocallyCompactAndSigmacompact.num_prop
            %h6#proposition_2 Proposition
            %p
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+and+sigma-compact+spaces+are+paracompact"}> locally compact and sigma-compact spaces are paracompact
              \.
          #ParacompactEuclideanSpace.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                is paracompact)
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              is paracompact.
          .proof
            %h6#proof Proof
            %p
              Euclidean space is evidently
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sigma-compact+topological+space"} sigma-compact
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+and+sigma-compact+spaces+are+paracompact"} locally compact and sigma-compact spaces are paracompact
              (prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#ParacompactFromLocallyCompactAndSigmacompact"}
          #ParacompactnessPreservedByDisjointUnion.num_prop
            %h6#proposition_3 Proposition
            %p
              Paracompactness is preserved by forming
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+spaces"} disjoint union spaces
              (
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              in
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          .proof
            %h6#proof_2 Proof
            %p
              Consider a disjoint union
