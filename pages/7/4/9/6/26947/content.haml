            ring
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pregroupoid"} pregroupoid
          %p “Ring setoid” and “Bishop ring” are placeholder names for a concept which may or may not have another name in the mathematics literature.
          %h2#definition Definition
          %p
            A
            %strong ring setoid
            or
            %strong Bishop ring
            is a
            %a.existingWikiWord{:href => "/nlab/show/setoid"} setoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mo ∼
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, \sim)
            with elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} 0 \in A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} 1 \in A
            and functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \alpha:A \times A \to A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \nu:A \to A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi A
                    %mo ×
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mu:A \times A \to A
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mo ∼
                      %mo ,
                      %mn 0
                      %mo ,
                      %mi α
                      %mo ,
                      %mi ν
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A, \sim, 0, \alpha, \nu)
                is a
                %a.existingWikiWord{:href => "/nlab/show/braided+groupal+setoid"} braided groupal setoid
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mo ∼
                      %mo ,
                      %mn 1
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A, \sim, 1, \mu)
                is a
                %a.existingWikiWord{:href => "/nlab/show/monoidal+setoid"} monoidal setoid
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                distributes over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                up to the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a \in A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} b \in A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} c \in A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∼
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "1em"}
                      %mi{:mathvariant => "normal"} and
                      %mspace{:width => "1em"}
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ∼
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mu(a, \alpha(b, c)) \sim \alpha(\mu(a, b), \mu(a, c)) \quad \mathrm{and} \quad \mu(\alpha(a, b), c) \sim \alpha(\mu(a, c), \mu(b, c))
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided
            if additionally for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a \in A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b \in A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu(a, b) \sim \mu(b, a)
          %h2#examples Examples
          %ul
            %li
              %p
                The set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℕ
                        %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}^\mathbb{2}
                of functions from the
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝟚
                    %annotation{:encoding => "application/x-tex"} \mathbb{2}
                to the
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} \mathbb{N}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∼
                        %mi g
                        %mo ≔
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \sim g \coloneqq f(0) + g(1) = f(1) + g(0)
            %li
              %p
                Given any
                %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequences"} Cauchy sequences
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/ring+setoid"} ring setoid
            %li
              %p
                Given any
                %a.existingWikiWord{:href => "/nlab/show/Archimedean+ordered+field"} Archimedean ordered field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                %a.existingWikiWord{:href => "/nlab/show/locators"} locators
                of all elements of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/ring+setoid"} ring setoid
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
                of any
                %a.existingWikiWord{:href => "/nlab/show/ring+setoid"} ring setoid
                by its
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                is a ring setoid where the equivalence relation is given by equality
            %li
              %p
                More generally, any
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
                is a ring setoid in which the equivalence relation is given by equality.
          %h2#ring_setoid_homomorphisms Ring setoid homomorphisms
