          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/setoid"} setoid
            or
            %a.existingWikiWord{:href => "/nlab/show/Bishop+set"} Bishop set
            whose
            %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
            %a.existingWikiWord{:href => "/nlab/show/ring+category"} ring
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            %a.existingWikiWord{:href => "/nlab/show/univalent+groupoid"} univalent
            by default, a
