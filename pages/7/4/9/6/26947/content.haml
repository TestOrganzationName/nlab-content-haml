          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be a ring setoid, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} A / \sim
              be its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mo ∼
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [-]:A \to (A / \sim)
              which takes an element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to its
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              is a ring setoid homomorphism.
