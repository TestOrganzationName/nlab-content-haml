                        %annotation{:encoding => "application/x-tex"} \phantom{-}
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∈
                        %annotation{:encoding => "application/x-tex"} \in
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
                    %a.existingWikiWord{:href => "/nlab/show/element"} element
                    %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
