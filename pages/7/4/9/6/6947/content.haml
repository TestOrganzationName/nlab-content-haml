            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            read in context
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo =
                  %mi Γ
                  %mo ,
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi T
                %annotation{:encoding => "application/x-tex"} \Delta = \Gamma, x \colon T
            is interpreted by pulling back along the projection, obtaining a subobject of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
