                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %annotation{:encoding => "application/x-tex"} \phantom{-}
                    symbol
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %annotation{:encoding => "application/x-tex"} \phantom{-}
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mphantom
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %annotation{:encoding => "application/x-tex"} \phantom{-}
                    in
                    %a.existingWikiWord{:href => "/nlab/show/logic"} logic
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
