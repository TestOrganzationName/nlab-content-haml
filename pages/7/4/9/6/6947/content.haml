            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/generalized+quantifier"} generalized quantifier
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/being"} being
          %div
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
