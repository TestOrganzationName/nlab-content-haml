            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ralph+Abraham"}> Ralph Abraham
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Jerrold+E.+Marsden"} Jerrold E. Marsden
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Foundations+of+Mechanics"} Foundations of Mechanics
                = succeed "&rbrack;" do
