                    \\to
                    \\underset{\longleftarrow}{\lim}^1_n Hom(A_n, B)
                    \\longrightarrow
                    Ext^1( \underset{\longrightarrow}{\lim}_n A_n, B )
                    \\longrightarrow
                    \\underset{\longleftarrow}{\lim}_n Ext^1( A_n, B)
                    \\to
                    0
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
