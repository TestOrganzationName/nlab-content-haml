                  %annotation{:encoding => "application/x-tex"} R
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#Commutative1DimFormalGroupLaw"}
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi L
                    %mo ⟶
                    %mi R
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; L \longrightarrow R
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LazardRing"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi ℓ
                    %mo =
                    %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_\ast \ell = \mu
                    \\,.
          .proof
            %h6#proof_36 Proof
            %p
              If the formal group law
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              has coefficients
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi c
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{c_{i,j}\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mi ℓ
                      %mo =
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} f_\ast \ell = \mu
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi c
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i,j}{\sum} f(a_{i,j}) x^i y^j
                    \=
                    \\underset{i,j}{\sum} c_{i,j} x^i y^j
            %p
              it must be that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi c
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"}
                    f(a_{i,j}) = c_{i,j}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} a_{i,j}
              are the generators of the Lazard ring. Hence it only remains to see that this indeed constitutes a ring homomorphism. But this is guaranteed by the vary choice of relations imposed in the definition of the Lazard ring.
          %p What is however highly nontrivial is this statement:
          #LazardTheorem.num_theorem
            %h6#theorem_5 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Lazard%27s+theorem"}> Lazard's theorem
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LazardRing"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    L
                    \\simeq
                    \\mathbb{Z}[ t_1, t_2, \cdots ]
            %p
              in countably many generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_i
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi i
                    %annotation{:encoding => "application/x-tex"} 2 i
          .num_remark
            %h6#remark_12 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lazard+theorem"} Lazard theorem
              %a.maruku-ref{:href => "#LazardTheorem"}
              first of all implies, via prop.
              = succeed "," do
                %a.maruku-ref{:href => "#LazardRingIsUniversal"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              then every choice of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mi i
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_i \in R\}
              defines a formal group law. (On the other hand, it is nontrivial to say which formal group law that is.)
            %p
              Deeper is the fact expressed by the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Milnor-Quillen+theorem+on+MU"} Milnor-Quillen theorem on MU
              %a.maruku-ref{:href => "#LazardTheorem"}
              is canonically identieif with the
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(M U)
              of
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              of the universal complex
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/MU"} MU
                  carries a
                  %a.existingWikiWord{:href => "/nlab/show/universal+complex+orientation+on+MU"} universal complex orientation
                  in that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  any
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
                  then homotopy classes of homotopy ring homomorphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mi U
                        %mo →
                        %mi E
                      %annotation{:encoding => "application/x-tex"} M U \to E
                  are in bijection to
                  %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex orientations
                  on
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
              %li
                %p
                  every
                  %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex orientation
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  induced a 1-dimensional commutative
                  %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
                  (
                  %a{:href => "complex+oriented+cohomology+theory#ComplexOrientedCohomologyTheoryFormalGroupLaw"}> prop.
                  )
              %li
                %p
                  under forming stable homtopy groups every ring spectrum homomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mi U
                        %mo →
                        %mi E
                      %annotation{:encoding => "application/x-tex"} M U \to E
                  induces a ring homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo ≃
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        L \simeq \pi_\bullet(M U) \longrightarrow \pi_\bullet(E)
                %p
                  and hence, by the universality of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            %p This is the formal group law given by the above complex orientation.
            %p
              Hence the universal group law over the Lazard ring is a kind of
              %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universal+complex+orientation+on+MU"} universal complex orientation on MU
          %h3#ComplexCobordismCohomology Complex cobordism
          %p
            %strong Idea.
            There is a
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mo ≃
                  %mi M
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi \colon B U(1)\stackrel{\simeq}{\longrightarrow} M U(1)
            between the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            for
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
            and the
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal complex line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi M
                  %msup
                    %mi U
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_\ast(c_1) \in M U^2(B U(1))
            in the
            %a.existingWikiWord{:href => "/nlab/show/complex+cobordism+cohomology"} complex cobordism cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B U(1)
            which makes the universal complex
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            become a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
          %p
            This turns out to be a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/universal+complex+orientation+on+MU"} universal complex orientation on MU
            %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
            ) there is an equivalence between complex orientations on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            and homotopy classes of homotopy ring spectrum homomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi M
                  %mi U
                  %mo ⟶
                  %mi E
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} {
                  %mi complex
                  %mspace{:width => "thickmathspace"}
                  %mi orientations
                  %mspace{:width => "thickmathspace"}
                  %mi on
                  %mspace{:width => "thickmathspace"}
                  %mi E
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{M U \longrightarrow E\}_{/\simeq}
                  \\;\simeq\;
                  \\{complex\;orientations\;on\;E\}
                  \\,.
          %p
            Hence
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            is
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            over
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
          %p
            %strong Literature.
            (
            %a{:href => "#Schwede12"}> Schwede 12, example 1.18
            ,
            = succeed "," do
              %a{:href => "#Kochman96"} Kochman 96, section 1.4, 1.5, 4.4
            = succeed ")" do
              %a{:href => "#Lurie10"} Lurie 10, lectures 5 and 6
          %h4#connerfloydchern_classes_are_thom_classes Conner-Floyd-Chern classes are Thom classes
          %p
            We discuss that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd-Chern+class"} Conner-Floyd-Chern class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi c
                    %mi n
                    %mi E
                %annotation{:encoding => "application/x-tex"} c^E_n
            is in fact a universal
            %a.existingWikiWord{:href => "/nlab/show/Thom+class"} Thom class
            for rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex orientation
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            indeed universally
            %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orients
            all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
            %a{:href => "#ComplexOrientationAsRingSpectrumMaps"} below
            as the
            %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
            condition on a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectra"} homotopy commutative ring spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi U
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} M U \to E
            which represent that universal orienation.
          #SphereBundleBunminus1.num_lemma
            %h6#lemma_9 Lemma
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#SphereFibrationOverInclusionOfClassifyingSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mn 2
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{2n-1} &amp;\longrightarrow&amp; B U(n-1)
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; B U(n)
                    }
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(n-1)
              as the
              %a.existingWikiWord{:href => "/nlab/show/sphere+bundle"} sphere bundle
              of the
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal complex vector bundle
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B U(n)
          .proof
            %h6#proof_37 Proof
            %p When exhibited by a fibration, here the vertical morphism is equivalently the quotient map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E U(n))/U(n-1) \longrightarrow (E U(n))/U(n)
            %p
              (by the proof of prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#SphereFibrationOverInclusionOfClassifyingSpaces"}
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E U(n)
              is (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EOn)"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E U(n) \simeq \underset{\longrightarrow}{\lim}_k  U(k)/U(k-n)
                    \\,.
            %p
              Here each
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Stiefel+manifold"} Stiefel manifold
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(k)/U(k-n)
              is equivalently the space of (complex)
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^k
              that are equipped with an orthonormal (hermitian)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℂ
                      %mi n
                    %mo ≃
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    E U(n) \underset{U(n)}{\times} \mathbb{C}^n
                    \\simeq
                    \\underset{\longrightarrow}{\lim}_k  U(k)/U(k-n) \underset{U(n)}{\times} \mathbb{C}^n
            %p has as fiber precisely the linear span of any such choice of basis.
            %p
              While the quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(k)/(U(n-k)\times U(n))
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(k)/(U(n-k) \times U(n-1))
              leaves the choice of precisly one unit vector. This is parameterized by the sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{2n-1}
              which is thereby identified as the unit sphere in the respective fiber of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo ×
                        %mrow
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %msup
                        %mi ℂ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} E U(n) \underset{U(n)}{\times} \mathbb{C}^n
          %p In particular:
          #UniversalComplexLineBundleThomSpace.num_lemma
            %h6#lemma_10 Lemma
            %p
              The canonical map from the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} B U(1) \simeq \mathbb{C}P^\infty
              (the inifnity
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of the
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                    %mi M
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B U(1)
                    \\overset{\in W_{cl}}{\longrightarrow}
                    M U(1)
                    \\coloneqq
                    Th( E U(1) \underset{U(1)}{\times} \mathbb{C})
                    \\,.
          .proof
            %h6#proof_38 Proof
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              is naturally identified with the unit sphere in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi 𝕊
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U (1) \simeq S(\mathbb{S})
              %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi ℂ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E U(1) \underset{U(1)}{\times} S(\mathbb{C})
                    \&amp; \simeq
                    E U(1) \underset{U(1)}{\times} U(1)
                    \\\
                    \&amp; \simeq E U(1)
                    \\end{aligned}
                    \\,.
            %p
              But the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
              is
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi cl
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E U(1) \overset{\in W_{cl}}{\longrightarrow} \ast
                    \\,.
            %p
              (Alternatively this is the special case of lemma
              %a.maruku-ref{:href => "#SphereBundleBunminus1"}
              for
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi 𝔹
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi 𝔹
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi 𝔹
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mi 𝔹
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %msub
                                  %mi W
                                  %mi cl
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Th( E U(1) \underset{U(1)}{\times} \mathbb{B} )
                    \&amp; \coloneqq
                    D( E U(1) \underset{U(1)}{\times} \mathbb{B} )
                    \/
                    S( E U(1) \underset{U(1)}{\times} \mathbb{B} )
                    \\\
                    \&amp; \overset{\in W_{cl}}{\longrightarrow}
                    D( E U(1) \underset{U(1)}{\times} \mathbb{B} )
                    \\\
                    \&amp; \overset{\in W_{cl}}{\longrightarrow}
                    B U(1)
                    \\end{aligned}
                    \\,.
          #UniversalComplexVectorBundleThomSpace.num_lemma
            %h6#lemma_11 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              a
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
              theory, then the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of the complex
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
              of
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(n)
              relative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(n-1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℂ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
