            %p such that
            %ol
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/associativity"}> associativity
                  )
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
