                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet(X \cup Cone(A))
                    \=
                    E^\bullet(X \cup Cone(A), \{\ast\})
                    \\overset{\simeq}{\longrightarrow}
                    E^\bullet(X,A)
                    \\,.
            %p
              Unwinding the constructions shows that this makes the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
