            %p
              This is equivalently the condition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ξ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ⋅
                      %msub
                        %mi ξ
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ≃
                      %msub
                        %mi ξ
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \xi_{n_1} \cdot \xi_{n_2} \simeq \xi_{n_1  + n_2}
            %p
              Finally, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} M\mathcal{B}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mi e
                    %mi M
                    %mi ℬ
                    %mspace{:width => "thinmathspace"}
                    %mo .
