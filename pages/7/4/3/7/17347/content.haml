              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
            %ol
              %li
                %p
                  (external multiplication) a pairing (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#PairingOfUnreducedCohomologyTheories"}
                  = succeed ";" do
