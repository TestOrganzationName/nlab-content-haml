                    \\tilde E^\bullet
                    \&amp; \mapsto
                    (E^\bullet \colon (X,A) \mapsto \tilde E^\bullet(X_+ \cup Cone(A_+)))
                    \\\
                    \&amp; \mapsto
                    ((\tilde E')^\bullet \colon X \mapsto \tilde E^\bullet(X_+ \cup Cone(*_+)))
                    \\end{aligned}
            %p
              where on the right we have the reduced mapping cone of the point inclusion with a point adoined. As before, this is isomorphic to the unreduced mapping cone of the point inclusion. That finally is clearly homotopy equivalent to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p Finally we record the following basic relation between reduced and unreduced cohomology:
          #UnreducedCohomologyIsReducedPlusPointValue.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              be an unreduced cohomology theory, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde E^\bullet
              its reduced cohomology theory from def.
              = succeed "." do
                %a.maruku-ref{:href => "#FromUnreducedToReducedCohomology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\ast)
              a pointed topological space, then there is an identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(X) \simeq \tilde E^\bullet(X) \oplus E^\bullet(\ast)
            %p
              of the unreduced cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of the reduced cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the unreduced cohomology of the base point.
          .proof
            %h6#proof_9 Proof
            %p
              The pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \ast \hookrightarrow X
              induces the sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi δ
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi δ
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    E^{\bullet-1}(\ast)
                    \\stackrel{\delta}{\longrightarrow}
                    \\tilde E^\bullet(X)
                    \\stackrel{}{\longrightarrow}
                    E^\bullet(X)
                    \\stackrel{}{\longrightarrow}
                    E^\bullet(\ast)
                    \\stackrel{\delta}{\longrightarrow}
                    \\tilde E^{\bullet+1}(X)
                    \\to
                    \\cdots
            %p
              which by the exactness clause in def.
              %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
            %p
              Now since the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast \to X \to \ast
              is the identity, the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(X) \to E^\bullet(\ast)
              has a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              and so is in particular an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              vanishes,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta = 0
              and we have a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\tilde E^\bullet(X)
                    \\stackrel{}{\longrightarrow}
                    E^\bullet(X)
                    \\stackrel{}{\longrightarrow}
                    E^\bullet(\ast)
                    \\to
                    0
            %p
              with the right map an epimorphism. Hence this is a
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact sequence
              and the statement follows.
          %h4#generalized_homology_functors Generalized homology functors
          %p
            All of the above has a dual version with
            %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
            replaced by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
          #ReducedGeneralizedHomology.num_defn
            %h6#definition_10 Definition
            %p
              A
              %strong reduced homology theory
              is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi CW
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E_\bullet
                    \\;\colon\;
                    (Top^{\ast/}_{CW}) \longrightarrow Ab^{\mathbb{Z}}
            %p
              from the category of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              (
              %a.existingWikiWord{:href => "/nlab/show/CW-complexes"}> CW-complexes
              ) to
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              (“
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"}> homology groups
              ”), in components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mo *
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E _\bullet
                    \\;\colon\;
                    (X \stackrel{f}{\longrightarrow} Y)
                    \\mapsto
                    (\tilde E_\bullet(X)
                    \\stackrel{f_\ast}{\longrightarrow}
                    \\tilde E_\bullet(Y))
                    \\,,
            %p
              and equipped with a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              of degree +1, to be called the
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma
                    \\;\colon\;
                    \\tilde E_\bullet(-)
                    \\overset{\simeq}{\longrightarrow}
                    \\tilde E_{\bullet +1}(\Sigma -)
            %p such that:
            %ol
              %li
                %p
                  %strong
                    (
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+invariance"}> homotopy invariance
                    )
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                        %mo ,
                        %msub
                          %mi f
                          %mn 2
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⟶
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} f_1,f_2 \colon X \longrightarrow Y
                  are two morphisms of pointed topological spaces such that there is a (base point preserving)
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                        %mo ≃
                        %msub
                          %mi f
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} f_1 \simeq f_2
                  between them, then the induced
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                  of abelian groups are
                  %a.existingWikiWord{:href => "/nlab/show/equality"} equal
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                        %msub
                          %mo
                          %mo *
                        %mo =
                        %msub
                          %mi f
                          %mn 2
                        %msub
                          %mo
                          %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        f_1_\ast = f_2_\ast
                        \\,.
              %li#ReducedExactnessAxiom
                %p
                  %strong (exactness)
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} i \colon A \hookrightarrow X
                  an inclusion of pointed topological spaces, with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⟶
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} j \colon X \longrightarrow Cone(i)
                  the induced
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
                  %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
                  of graded abelian groups
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi i
                              %mo *
                        %msub
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi j
                              %mo *
                        %msub
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde E_\bullet(A)
                        \\overset{i_\ast}{\longrightarrow}
                        \\tilde E_\bullet(X)
                        \\overset{j_\ast}{\longrightarrow}
                        \\tilde E_\bullet(Cone(i))
                        \\,.
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde E_\bullet
              is
              %strong additive
              if in addition
            %ul
              %li
                %p
                  %strong
                    (
                    %a.existingWikiWord{:href => "/nlab/show/wedge+axiom"}> wedge axiom
                    )
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi X
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
                  any set of pointed CW-complexes, then the canonical morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ⊕
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∨
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi X
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\oplus_{i \in I} \tilde E_\bullet(X_i)
                        \\longrightarrow
                        \\tilde E^\bullet(\vee_{i \in I} X_i)
                %p
                  from the
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                  of the value on the summands to the value on the
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  (prop.- P#WedgeSumAsCoproduct)), is an
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde E_\bullet
              is
              %strong ordinary
              if its value on the
              %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S^0
              is concentrated in degree 0:
            %ul
              %li
                %strong (Dimension)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mrow
                            %mo •
                            %mo ≠
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝕊
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \tilde E_{\bullet\neq 0}(\mathbb{S}^0) \simeq 0
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of reduced cohomology theories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo ⟶
                    %msub
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; \tilde E_\bullet \longrightarrow \tilde F_\bullet
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
