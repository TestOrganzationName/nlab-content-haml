                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(S_i,f)
                    \\;\colon\;
                    \\mathcal{C}(S_i,X)
                    \\longrightarrow
                    \\mathcal{C}(S_i,Y)
            %p
              are weak equivalences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              if they are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              on all
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
