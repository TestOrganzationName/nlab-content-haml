                    %msubsup
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo ≃
                    %mo{:stretchy => "false"} [
