            %p
              from the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
