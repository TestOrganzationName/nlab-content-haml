                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
