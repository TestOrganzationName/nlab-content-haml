                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(-,-) = Ext^0(-,-)
          .proof
            %h6#proof_22 Proof
            %p Consider the homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ∂
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊕
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo ⟶
                    %munder
                      %mo ⊕
                      %mi n
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde \partial
                    \\;\colon\;
                    \\underset{n}{\oplus} A_n
                    \\longrightarrow
