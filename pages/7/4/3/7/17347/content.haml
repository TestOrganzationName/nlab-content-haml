            %h6#definition_2 Definition
            %p
              A
              %strong
                reduced
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology theory
              is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet
                    \\;\colon\;
                    Ho(Top^{\ast/})^{op} \longrightarrow Ab^{\mathbb{Z}}
            %p
              from the
