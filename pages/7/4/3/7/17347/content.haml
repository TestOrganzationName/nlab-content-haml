              of a generator is itself among the set of generators, the claim follows.
          #BrownRepresentabilityOnPresentableInfinityCategories.num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong (Brown representability)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              compactly generated by cogroup objects closed under forming suspensions, according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#CompactGenerationByCogroupObjects"}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\; Ho(\mathcal{C})^{op} \longrightarrow Set
            %p
              (from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              precisely if it is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brown+functor"} Brown functor
              = succeed "." do
                %a.maruku-ref{:href => "#BrownFunctorOnInfinityCategory"}
          %p
            (
            %a{:href => "#LurieHigherAlgebra"}> Lurie 10, theorem 1.4.1.2
            )
          #ProofFollowingLurie.proof
            %h6#proof_15 Proof
            %p
              Due to the version of the Whitehead theorem of prop.
              %a.maruku-ref{:href => "#WhiteheadTheoremForCompactGenerationByCogroupObjects"}
              we are essentially reduced to showing that
              %a.existingWikiWord{:href => "/nlab/show/Brown+functors"} Brown functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              are representable on the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} S_i
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represent
            %p
              Lemma (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
              ):
              %em
                Given
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo ∈
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta \in F(X)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \eta \colon X \to F
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi X
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f \colon X \to X'
                and an
                %a.existingWikiWord{:href => "/nlab/show/extension"} extension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo ′
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ′
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \eta' \colon X' \to F
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                which induces for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} S_i
                a
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo ′
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi S
                          %mi i
                        %mo ,
                        %mi X
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mo ≃
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi S
                          %mi i
                        %mo ,
                        %mi F
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi F
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi S
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta'\circ (-) \colon PSh(Ho(\mathcal{C}))(S_i,X') \stackrel{\simeq}{\longrightarrow} Ho(\mathcal{C})(S_i,F) \simeq F(S_i)
            %p
              To see this, first notice that we may directly find an extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \eta_0
