                    }
                    \\,.
            %p
              With this, injectivity follows because by construction we quotiented out the kernel at each stage. Because suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              is taken to zero in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(S_i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{n+1}
              above there is a factorization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              through the point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi S
                              %mi i
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi γ
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi η
                                  %mi n
                          %mtd
                            %mi F
                        %mtr
