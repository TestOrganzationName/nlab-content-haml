                        \\tilde \sigma_n
                        \\;\colon\;
                        X_n \underoverset{\in W_{cl}}{\tilde \sigma_n}{\longrightarrow} \Omega X_{n+1}
                %p
                  for each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
                  of the following space.
          #AdditiveReducedCohomologyTheoryRepresentedByOmegaSpectrum.num_prop
            %h6#proposition_10 Proposition
            %p
              Every
              %a{:href => "#WedgeAxiom"} additive
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology+theory"} reduced cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi CW
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \tilde E^\bullet(-) \colon (Top_{CW}^\ast)^{op} \longrightarrow Ab^{\mathbb{Z}}
              according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#ReducedGeneralizedCohomologyHomotopyTheoretically"}
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represented
              by an
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi E
