                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %mo =
                  %msub
                    %mi a
                    %mrow
                      %mi j
                      %mo ,
                      %mi i
                %annotation{:encoding => "application/x-tex"}
                  a_{i,j} = a_{j,i}
          %p and the unitality constraint means that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
