                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mover
                          %mo ⟶
                          %mi f
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi f
                              %mo *
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde E
                        \\;\colon\;
                        (X \stackrel{f}{\longrightarrow} Y)
                        \\mapsto
                        (\tilde E^\bullet(Y)
                        \\stackrel{f^\ast}{\longrightarrow}
                        \\tilde E^\bullet(X))
                        \\,,
              %li#SuspensionIsomorphismForReducedGeneralizedCohomology
                %p
                  equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  of degree +1, to be called the
                  = succeed "," do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi E
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
