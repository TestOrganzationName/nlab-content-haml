          #ReducedToUnreducedGeneralizedCohomology.num_defn
            %h6#definition_9 Definition
            %p
              %strong (reduced to unreduced cohomology)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
