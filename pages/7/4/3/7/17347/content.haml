              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#OmegaSpectrum"}> def.
              ) is
            %ol
              %li
                %p
                  a sequence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
