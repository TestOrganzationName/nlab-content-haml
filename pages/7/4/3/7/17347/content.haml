          #GeneralizedHomologyTheory.num_defn
            %h6#definition_11 Definition
            %p
              A
              %strong homology theory
              (unreduced,
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mi CW
                      %mo ↪
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    E_\bullet : (Top_{CW}^{\hookrightarrow}) \longrightarrow Ab^{\mathbb{Z}}
            %p
              to the category of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              of degree +1, to be called the
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
