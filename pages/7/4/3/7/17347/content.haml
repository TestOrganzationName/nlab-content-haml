            %p
              that are induced by including the fiber of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi V
                        %mi n
                        %mi ℬ
                    %annotation{:encoding => "application/x-tex"} V_{n}^{\mathcal{B}}
            %p Accordingly the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
