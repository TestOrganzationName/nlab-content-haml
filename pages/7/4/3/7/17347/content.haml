                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n_1, n_2\in \mathbb{N}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi V
                              %mrow
                                %msub
                                  %mi n
                                  %mn 1
                              %mi ℬ
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mi Th
                            %mo{:stretchy => "false"} (
