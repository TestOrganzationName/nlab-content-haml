                  %mspace{:width => "thinmathspace"}
                  %mi higher
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi order
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi terms
                %annotation{:encoding => "application/x-tex"}
                  F_i(x,y) = x_i+y_i+\,\,higher\,\,order\,\,terms
          #Commutative1DimFormalGroupLaw.num_example
            %h6#example_7 Example
            %p
              A 1-dimensional commutative formal group law according to def.
              %a.maruku-ref{:href => "#GroupObjectFormalGroupLaw"}
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ≥
                        %mn 0
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(x,y)
                    \=
                    \\underset{i,j \geq 0}{\sum} a_{i,j} x^i y^j
            %p
              (the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[ [ x,y ] ]
              of the element
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi t
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} t \in R [ [ t ] ]
            %ol
              %li
                %p (unitality)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi μ
                        %mo{:stretchy => "false"} (
                        %mi x
