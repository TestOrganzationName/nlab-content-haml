                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A\hookrightarrow X
              %a.maruku-ref{:href => "#EvaluationOfCohomologyTheoryOnGoodPairIsEvaluationOnQuotient"}
              we have an isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
