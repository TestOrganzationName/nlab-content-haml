                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mu(x,y) = \mu(y,x)
                        \\,.
            %p The first condition means equivalently that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mn 0
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mi if
                              %mi i
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi a
                      %mrow
                        %mn 0
                        %mo ,
                        %mi i
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mi if
                              %mi i
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    a_{i,0}
                    \=
                    \\left\{
                    \\array{
                    1 &amp; if i = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\;\;\;\;\,,
                    \\;\;\;\;\;
                    a_{0,i}
                    \=
                    \\left\{
                    \\array{
                    1 &amp; if i = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is necessarily of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo +
                    %mi y
                    %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ≥
                        %mn 1
                    %msub
                      %mi a
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msup
                      %mi x
                      %mi i
                    %msup
                      %mi y
                      %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(x,y)
                    \\;=\;
                    x + y + \underset{i,j \geq 1}{\sum} a_{i,j} x^i y^j
                    \\,.
            %p
              The existence of inverses is no extra condition: by
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on the index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              one finds that there exists a unique
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ≥
                        %mn 1
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %msup
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\iota(x) = \underset{i \geq 1}{\sum} \iota(x)_i x^i
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi iota
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi ι
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(x,iota(x)) = x
                    \\;\;\;\,,
                    \\;\;\;
                    \\mu(\iota(x),x) = x
                    \\,.
            %p
              Hence 1-dimensional formal group laws over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              are equivalently
              %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Adic
                    %mi R
