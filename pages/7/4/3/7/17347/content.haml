              ,
              = succeed ")," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassicalPointedHomotopyCategory"} def.
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
              %strong
                %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma
                    \\;\colon\;
                    \\tilde E^{\bullet +1}(\Sigma -)
                    \\overset{\simeq}{\longrightarrow}
                    \\tilde E^\bullet(-)
            %p such that:
            %ul
              %li
                %strong (exactness)
                it takes
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
                sequences in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Top^{\ast/})
                (
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyFiber"}> def.
                ) to
