          %p Conversely:
          #SpectrumRepresentsCohomologyTheoryDegreewise.num_prop
            %h6#proposition_11 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
              %a{:href => "#WedgeAxiom"} additive
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology+theory"} reduced cohomology theory
              def.
              %a.maruku-ref{:href => "#ReducedGeneralizedCohomology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \tilde E^\bullet
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^n(X)
                    \\coloneqq
                    [X,E_n]_\ast
            %p
              with
              %a{:href => "#SuspensionIsomorphismForReducedGeneralizedCohomology"} suspension isomorphism
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %msub
                          %mover
                            %mi σ
                            %mo{:stretchy => "false"} ˜
                          %mi n
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Ω
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mover
                      %mo →
                      %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mi X
                    %mo ,
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_n
                    \\;\colon\;
                    \\tilde E^n(X)
                    \=
                    [X,E_n]_\ast
                    \\overset{[X,\tilde \sigma_n]}{\longrightarrow}
                    [X, \Omega E_{n+1}]_\ast
                    \\overset{\simeq}{\to}
                    [\Sigma X, E_{n+1}]
                    \=
                    \\tilde E^{n+1}(\Sigma X)
                    \\,.
          .proof
            %h6#proof_13 Proof
            %p
              The
              %a{:href => "#WedgeAxiom"} additivity
              is immediate from the construction. The
              %a{:href => "#ReducedExactnessAxiom"} exactnes
              follows from the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences"} long exact sequences
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequences"} homotopy cofiber sequences
              given by
              = succeed "." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#LongFiberSequence"} this prop.
          .num_remark
            %h6#remark_3 Remark
            %p
              If we consider the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              of
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TheStableHomotopyCategory"}> def.
              ) and consider any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in terms of its
              %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty X \in Ho(Spectra)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#SuspensionSpectrum"}> exmpl.
              ), then the statement of prop.
              %a.maruku-ref{:href => "#SpectrumRepresentsCohomologyTheoryDegreewise"}
              is more succinctly summarized by saying that the
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"} graded
              reduced cohomology groups of a topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              represented by an
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              are the hom-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo ,
                    %msup
                      %mi Σ
                      %mo •
                    %mi E
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet(X)
                    \\;\simeq\;
                    [\Sigma^\infty X, \Sigma^\bullet E]
            %p
              in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %a.existingWikiWord{:href => "/nlab/show/suspensions"} suspensions
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableModelStructureOnSequentiaSpectraIsStableModelCategory"}> thm.
              ) of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              This means that more generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Ho(Spectra)
              any spectrum, it makes sense to consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msup
                      %mi Σ
                      %mo •
                    %mi E
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet(X)
                    \\;\coloneqq\;
                    [X,\Sigma^\bullet E]
            %p
              to be the graded reduced generalized
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              See also in
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1"} part 1
              = succeed "." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#ForASpectrumXGeneralizedECohomology"} this example
          %h4#BrownRepresentabilityAppliedToOrdinaryCohomology Application to ordinary cohomology
          #EilenbergMacLaneSpectrum.num_example
            %h6#example_3 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^n(-,A)
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced cohomology
              evaluated on
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              satisfies
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi q
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi q
                              %mo =
                              %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H^n(S^q,A)
                    \\simeq
                    \\left\{
                    \\array{
                    A &amp; if \; q = n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
            %p
              Hence singular cohomology is a
              %a{:href => "#S1GeneralizedCohomology"} generalized cohomology theory
              which is “
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"}> ordinary cohomology
              ” in the sense of def.
              = succeed "." do
                %a.maruku-ref{:href => "#AdditiveOrdinary"}
            %p
              Applying the
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              as in prop.
              %a.maruku-ref{:href => "#AdditiveReducedCohomologyTheoryRepresentedByOmegaSpectrum"}
              hence produces an
              %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              concentrated in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %em
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(A,n)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi q
                              %mo =
                              %mi n
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_q(K(A,n))
                    \\simeq
                    \\left\{
                    \\array{
                    A &amp; if \; q = n
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
            %p
              Here for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(A,n)
              is connected, therefore with an essentially unique basepoint, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(A,0)
              is (homotopy equivalent to) the underlying set of the group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              Such spectra are called
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectra"} Eilenberg-MacLane spectra
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mi A
                    %annotation{:encoding => "application/x-tex"} H A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (H A)_n \simeq K(A,n)
                    \\,.
          %p
            As a consequence of example
            %a.maruku-ref{:href => "#EilenbergMacLaneSpectrum"}
            one obtains the uniqueness result of Eilenberg-Steenrod:
          .num_prop
            %h6#proposition_12 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \tilde E_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \tilde E_2
              be ordinary (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdditiveOrdinary"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology+theories"} generalized (Eilenberg-Steenrod) cohomology theories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E_1(S^0) \simeq \tilde E_2(S^0)
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of cohomology theories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 1
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E_1 \overset{\simeq}{\longrightarrow} \tilde E_2
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#AguilarGitlerPrieto02"} Aguilar-Gitler-Prieto 02, theorem 12.3.6
          %h4#homotopytheoretic_discussion Homotopy-theoretic discussion
          %p
            Using abstract
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            in the guise of
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            theory (see the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+P"}> lecture notes on classical homotopy theory
              ), the traditional proof and further discussion of the
              %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
              %a{:href => "#BrownRepresentabilityTraditional"} above
              becomes more transparent (
              %a{:href => "#LurieHigherAlgebra"}> Lurie 10, section 1.4.1
              , for exposition see also
              = succeed ")." do
                %a{:href => "Brown+representability+theorem#Mathew11"} Mathew 11
          %p
            This abstract homotopy-theoretic proof uses the general concept of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
            in
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            as well as the concept of
            %a.existingWikiWord{:href => "/nlab/show/derived+hom-spaces"} derived hom-spaces
            (“
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"}> ∞-categories
            ”). Even though in the accompanying
            %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+P"} Lecture notes on classical homotopy theory
            these concepts are only briefly indicated, the following is included for the interested reader.
          #BrownFunctorOnInfinityCategory.num_defn
            %h6#definition_16 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    F \;\colon\; Ho(\mathcal{C})^{op} \longrightarrow Set
            %p
              (from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %p
              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Brown+functor"} Brown functor
              if
            %ol
              %li
                %p
                  it sends small
                  %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
                  to
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/products"} products
              %li
                %p
                  it sends
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pushouts"} homotopy pushouts
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo →
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}\to Ho(\mathcal{C})
                  to
                  %a.existingWikiWord{:href => "/nlab/show/weak+pullbacks"} weak pullbacks
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                  (see remark
                  = succeed ")." do
                    %a.maruku-ref{:href => "#WeakPullbacks"}
          #WeakPullbacks.num_remark
            %h6#remark_4 Remark
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/weak+pullback"} weak pullback
              is a diagram that satisfies the existence clause of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %a.maruku-ref{:href => "#BrownFunctorOnInfinityCategory"}
              says that for a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
              square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Z
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %munder
                              %mo ⊔
                              %mi Z
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Z &amp;\longrightarrow&amp; X
                    \\\
                    \\downarrow &amp;\swArrow&amp; \downarrow
                    \\\
                    Y &amp;\longrightarrow&amp; X \underset{Z}{\sqcup}Y
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mrow
                      %mo (
                      %mi X
                      %munder
                        %mo ⊔
                        %mi Z
                      %mi Y
                      %mo )
                    %mover
                      %mo ⟶
                      %mi epi
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi Z
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F\left(X \underset{Z}{\sqcup}Y\right)
                    \\stackrel{epi}{\longrightarrow}
                    F(X) \underset{F(Z)}{\times} F(Y)
            %p
              into the actual
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
          #CompactGenerationByCogroupObjects.num_defn
            %h6#definition_17 Definition
            %p
              Say that a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
              %strong compactly generated by cogroup objects closed under suspensions
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+%28%E2%88%9E%2C1%29-category"} generated
                  by a set
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi S
                          %mi i
                        %mo ∈
                        %mi 𝒞
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"}
                        \\{S_i \in \mathcal{C}\}_{i \in I}
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/compact+object+in+an+%28infinity%2C1%29-category"} compact objects
                  (i.e. every object of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
                  of the objects
                  = succeed ".)" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi S
                            %mi i
                        %annotation{:encoding => "application/x-tex"} S_i
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi i
                      %annotation{:encoding => "application/x-tex"} S_i
                  admits the structure of a
                  %a.existingWikiWord{:href => "/nlab/show/cogroup"} cogroup
                  object in the
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              %li
                %p
                  the set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi S
                          %mi i
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{S_i\}
                  is closed under forming
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/reduced+suspensions"} reduced suspensions
          #SuspensionsAreHCogroupObjects.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/suspensions+are+H-cogroup+objects"}> suspensions are H-cogroup objects
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
              its pointed model category (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ModelStructureOnSliceCategory"}> prop.
              ) with
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#PointedObjectsHaveZeroObject"}> rmk.
              ). Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ↦
                    %mn 0
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi X
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Sigma \colon X \mapsto 0 \underset{X}{\coprod} 0
              for the
              %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
              functor.
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/fold+map"} fold map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mi X
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi Σ
                    %mi X
                    %mo ≃
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                    %mo ⟶
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mi X
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                    %mo ≃
                    %mn 0
                    %munder
                      %mo ⊔
                      %mi X
                    %mn 0
                    %mo ≃
                    %mi Σ
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\Sigma X \coprod \Sigma X
                    \\simeq
                    0 \underset{X}{\sqcup} 0 \underset{X}{\sqcup} 0
                    \\longrightarrow
                    0 \underset{X}{\sqcup} X \underset{X}{\sqcup} 0
                    \\simeq
                    0 \underset{X}{\sqcup} 0
                    \\simeq
                    \\Sigma X
            %p
              exhibits
              %a.existingWikiWord{:href => "/nlab/show/cogroup"} cogroup
              structure on the image of any
              %a.existingWikiWord{:href => "/nlab/show/suspension+object"} suspension object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma X
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category
            %p
              This is equivalently the
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of the values of
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} functor co-represented
              by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mo ↦
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Ω
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 1
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ho(\mathcal{C})(\Sigma X, -)
                    \\;\colon\;
                    Y
                    \\mapsto
                    Ho(\mathcal{C})(\Sigma X, Y)
                    \\simeq
                    Ho(\mathcal{C})(X, \Omega Y)
                    \\simeq
                    \\pi_1 Ho(\mathcal{C})(X, Y)
                    \\,.
          #TheClassicalPointedConnectedHomotopyCategoryAsDomainForTheAbstractBrownRepresentabilityTheorem.num_example
            %h6#example_5 Example
            %p
              In bare
              %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+types"} pointed homotopy types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo =
                      %msubsup
                        %mi Top
                        %mi Quillen
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} = Top^{\ast/}_{Quillen}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
              of)
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              are
              %a.existingWikiWord{:href => "/nlab/show/cogroup"} cogroup
              objects for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
              = succeed "." do
                %a.maruku-ref{:href => "#SuspensionsAreHCogroupObjects"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+object+in+an+%28%E2%88%9E%2C1%29-category"} compact objects
            %p
              So while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \{S^n\}_{n \in \mathbb{N}}
              generates all of the homotopy theory of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              %em not
              an example of def.
              %a.maruku-ref{:href => "#CompactGenerationByCogroupObjects"}
              due to the failure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} S^0
              to have
              %a.existingWikiWord{:href => "/nlab/show/cogroup"} cogroup
              structure.
            %p
              Removing that generator, the homotopy theory generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi S
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                        %mrow
                          %mrow
                            %mi n
                            %mo ≥
                            %mn 1
                  %annotation{:encoding => "application/x-tex"} \{S^n\}_{{n \in \mathbb{N}} \atop {n \geq 1}}
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mrow
                          %mo ≥
                          %mn 1
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{\geq 1}
              %em
                %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+types"} pointed homotopy types
              %a.maruku-ref{:href => "#ConnectivityInTraditionalBrownRepresentability"}
              above.
          %p
            See also (
            %a{:href => "#LurieHigherAlgebra"}> Lurie 10, example 1.4.1.4
            )
          %p
            In homotopy theories compactly generated by cogroup objects closed under forming suspensions, the following strenghtening of the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+theorem"} Whitehead theorem
            holds.
          #WhiteheadTheoremForCompactGenerationByCogroupObjects.num_prop
            %h6#proposition_13 Proposition
            %p
              In a homotopy theory compactly generated by cogroup objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi S
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{S_i\}_{i \in I}
              closed under forming suspensions, according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#CompactGenerationByCogroupObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalence
              precisely if for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              the induced function of maps in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho(\mathcal{C})(S_i,f)
                    \\;\colon\;
                    Ho(\mathcal{C})(S_i,X)
                    \\longrightarrow
                    Ho(\mathcal{C})(S_i,Y)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (a
              = succeed ")." do
