                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    F\;\colon \; Ho(Top_{\geq 1}^{\ast/})^{op} \longrightarrow Set^{\ast/}
            %p
              (from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              of the
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassicalHomotopyCategory"}> def.
              ,
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ClassicalPointedHomotopyCategory"} def.
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %ol
              %li
                %p
                  %strong (additivity)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  takes small coproducts (
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sums"}> wedge sums
                  ) to
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/products"} products
              %li
                %p
                  %strong (Mayer-Vietoris)
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mi Int
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ∪
                        %mi Int
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X = Int(A) \cup Int(B)
                  then for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi A
                        %mo ∈
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x_A \in F(A)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi B
                        %mo ∈
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x_B \in F(B)
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi A
                            %mo ∩
                            %mi B
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi B
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi A
                            %mo ∩
                            %mi B
                      %annotation{:encoding => "application/x-tex"} (x_A)|_{A \cap B} = (x_B)|_{A \cap B}
                  then there exists
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi X
                        %mo ∈
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x_X \in F(X)
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mi A
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mi X
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi A
                      %annotation{:encoding => "application/x-tex"} x_A = (x_X)|_A
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mi B
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mi X
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} |
                            %mi B
                        %annotation{:encoding => "application/x-tex"} x_B = (x_X)|_B
          #EveryComponentOfAdditiveReducedCohomologyIsBrownFunctor.num_prop
            %h6#proposition_9 Proposition
            %p
              For every
              %a{:href => "#WedgeAxiom"} additive
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology+theory"} reduced cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %msup
                      %mi Set
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} \tilde E^\bullet(-) \colon Ho(Top^{\ast/})^{op}\to Set^{\ast/}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReducedGeneralizedCohomologyHomotopyTheoretically"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde E^n(-)
              to connected spaces is a
              %a.existingWikiWord{:href => "/nlab/show/Brown+functor"} Brown functor
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#BrownFunctorTraditional"}
          .proof
            %h6#proof_11 Proof
            %p
              Under the relation between reduced and unreduced cohomology
              = succeed "," do
                %a{:href => "#RelationBetweenUnreducedAndReducedCohomology"} above
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exactness
              of the
              %a.existingWikiWord{:href => "/nlab/show/Mayer-Vietoris+sequence"} Mayer-Vietoris sequence
              of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#MayerVietorisSequenceInGeneralizedCohomology"}
          #BrownRepresentabilityForTraditionalBrownFunctors.num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong (Brown representability)
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/Brown+functor"} Brown functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BrownFunctorTraditional"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msubsup
                      %mi Top
                      %mrow
                        %mo ≥
                        %mn 1
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} X \in Top_{\geq 1}^{\ast/}
              and a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [-,X]_{\ast} \overset{\simeq}{\longrightarrow} F(-)
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [-,-]_\ast
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
                      %mrow
                        %mo ≥
                        %mn 1
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Top_{\geq 1}^{\ast/})
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyCategoryOfPointedModelStructureIsEnrichedInPointedSets"}> exmpl.
              )).
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#AguilarGitlerPrieto02"} AGP 02, theorem 12.2.22
          #ConnectivityInTraditionalBrownRepresentability.num_remark
            %h6#remark_2 Remark
            %p
              A key subtlety in theorem
              %a.maruku-ref{:href => "#BrownRepresentabilityForTraditionalBrownFunctors"}
              is the restriction to
              %em connected
              pointed topological spaces in def.
              = succeed "." do
                %a.maruku-ref{:href => "#BrownFunctorTraditional"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              that induce isomorphisms on pointed homotopy classes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    [S^n,X]_\ast \longrightarrow [S^n,Y]_\ast
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              are
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              (For instance in
              %a{:href => "#AguilarGitlerPrieto02"} AGP 02
              this is used in the proof of theorem 12.2.19 there). But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo =
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [S^n,X]_\ast = \pi_n(X,x)
              gives the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %em only
              for the canonical basepoint, while for a weak homotopy equivalence in general one needs to consider the homotopy groups at all possible basepoints, at least one for each connected component. But so if one does assume that all spaces involved are connected, hence only have one connected component, then indeed weak homotopy equivalences are equivalently those maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              making all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [S^n,X]_\ast \longrightarrow [S^n,Y]_\ast
              into isomorphisms.
            %p
              See also example
              %a.maruku-ref{:href => "#TheClassicalPointedConnectedHomotopyCategoryAsDomainForTheAbstractBrownRepresentabilityTheorem"}
              below.
          %p
            The representability result applied degreewise to an additive reduced cohomology theory will yield (prop.
            %a.maruku-ref{:href => "#AdditiveReducedCohomologyTheoryRepresentedByOmegaSpectrum"}
            below) the following concept.
          #OmegaSpectrum.num_defn
