                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Gr
                              %mrow
                                %mi k
                                %mo −
                                %mi n
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mrow
                                %mi k
                                %mo −
                                %mi n
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi k
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi O
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo −
                                %mi n
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi ℝ
                              %mrow
                                %mi k
                                %mo −
                                %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\longrightarrow&amp; S^{n + (k-n)}
                    \\\
                    {}^{\mathllap{g_i}}\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    Gr_{k-n}(\mathbb{R}^k)
                    \&amp;\overset{i}{\longrightarrow}&amp;
                    Th( V_{k-n}(\mathbb{R}^k) \underset{O(k-n)}{\times} \mathbb{R}^{k-n})
                    }
                    \\,.
            %p
              (Recall that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi V
                      %mrow
                        %mi k
                        %mo −
                        %mi n
                      %mi ℬ
                  %annotation{:encoding => "application/x-tex"} V^{\mathcal{B}}_{k-n}
              is our notation for the
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
              with
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi k
                        %mo −
                        %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_{k-n}(\mathbb{R}^k)
              denotes a
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Stiefel+manifold"} Stiefel manifold
            %p
              The idea of the proof now is to use this property as the blueprint of the construction of an
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                  %annotation{:encoding => "application/x-tex"} \zeta
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} \xi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_{n}(M \mathcal{B})
              represented by a map as on the right of the above diagram, try to define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the structure map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi i
                  %annotation{:encoding => "application/x-tex"} g_i
              of its normal bundle as the pullback on the left.
            %p The technical problem to be overcome is that for a general continuous function as on the right, the pullback has no reason to be a smooth manifold, and for two reasons:
            %ol
              %li
                %p
                  the map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo −
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mo →
                        %mi Th
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mrow
                            %mi k
                            %mo −
                            %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^{n+(k-n)} \to Th(V_{k-n})
                  may not be smooth around the image of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
              %li
                %p
                  even if it is smooth around the image of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                  %a.existingWikiWord{:href => "/nlab/show/transversal+map"} transversal
                  to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
            %p
              The heart of the proof is in showing that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              there are small homotopies relating it to an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \alpha'
              that is both smooth around the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and transversal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
            %p
              The first condition is guaranteed by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Sard%27s+theorem"} Sard's theorem
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Thom%27s+transversality+theorem"} Thom's transversality theorem
            %p (…)
          %h3#ThomIsomorphism Thom isomorphism
          %p
            %strong Idea.
            If a
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mover
                    %mo ⟶
                    %mi p
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \stackrel{p}{\longrightarrow} X
            of
            %a.existingWikiWord{:href => "/nlab/show/rank"} rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            carries a cohomology class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo ∈
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega \in H^n(Th(E),R)
            that looks fiberwise like a
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            – a
            %a.existingWikiWord{:href => "/nlab/show/Thom+class"} Thom class
            – then the operation of pulling back from base space and then forming the
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            with this
            %a.existingWikiWord{:href => "/nlab/show/Thom+class"} Thom class
            is an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            on (reduced) cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msup
                    %mi p
                    %mo *
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mo ≃
                  %msup
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ˜
                    %mrow
                      %mo •
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ( (-) \cup \omega) \circ p^\ast
                  \\;\colon\;
                  H^\bullet(X,R)
                  \\stackrel{\simeq}{\longrightarrow}
                  \\tilde H^{\bullet+n}(Th(E),R)
                  \\,.
          %p
            This is the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
            %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
            (or else from the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Leray-Hirsch+theorem"} Leray-Hirsch theorem
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Thom-Gysin+sequence"} Thom-Gysin sequence
          %p
            In the special case that the vector bundle is trivial of rank
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            coincides with the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            of the base space (example
            = succeed ")" do
              %a.maruku-ref{:href => "#ThomSpaceConstructionReducingToSuspension"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/suspension+isomorphism"} suspension isomorphism
            = succeed "." do
              %em twisted suspension isomorphism
          %p
            We need this below to compute (co)homology of universal Thom spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi U
                %annotation{:encoding => "application/x-tex"} M U
            in terms of that of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                  %annotation{:encoding => "application/x-tex"} B U
          %p
            Composed with pullback along the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin-Thom+collapse+map"} Pontryagin-Thom collapse map
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/Umkehr+maps"} Umkehr maps
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            against the Thom class.
          %p
            %strong Literature.
            (
            %a{:href => "#Kochman96"}> Kochman 96, 2.6
            )
          %h4#thomgysin_sequence Thom-Gysin sequence
          %p
            The
            %em
              %a.existingWikiWord{:href => "/nlab/show/Thom-Gysin+sequence"} Thom-Gysin sequence
            is a type of
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+cohomology"} long exact sequence in cohomology
            induced by a
            %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
            and expressing the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            of the total space in terms of those of the base plus correction. The sequence may be obtained as a corollary of the
            %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
            for the given fibration. It induces, and is induced by, the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
          #ThomGysinSequence.num_prop
            %h6#proposition_20 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi π
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^n &amp;\longrightarrow&amp; E
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\pi}}
                    \\\
                    \&amp;&amp; B
                    }
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              over a
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              with typical
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#FibersOfSerreFibrations"}> exmpl.
              ) the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %p
              Then there exists an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in H^{n+1}(E; R)
              (in the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of the total space with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %strong Euler class
              of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∪
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \cup (-)
              sits in a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi π
                          %mo *
                    %msup
                      %mi H
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi H
                      %mrow
                        %mi k
                        %mo −
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi c
                        %mo ∪
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi H
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    H^k(B; R)
                    \\stackrel{\pi^\ast}{\longrightarrow}
                    H^k(E; R)
                    \\stackrel{}{\longrightarrow}
                    H^{k-n}(B;R)
                    \\stackrel{c \cup (-)}{\longrightarrow}
                    H^{k+1}(B; R)
                    \\to
                    \\cdots
                    \\,.
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Switzer75"} Switzer 75, section 15.30
            = succeed ")" do
              %a{:href => "#Kochmann96"} Kochman 96, corollary 2.2.6
          #ProofOfThomGysinSequence.proof
            %h6#proof_24 Proof
            %p
              Under the given assumptions there is the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ;
                    %msup
                      %mi H
                      %mi t
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mi s
                        %mo +
                        %mi t
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_2^{s,t}
                    \\;=\;
                    H^s(B; H^t(S^n;R))
                    \\;\Rightarrow\;
                    H^{s+t}(E; R)
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              is concentrated in just two degees
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi t
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
