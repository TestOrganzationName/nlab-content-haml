                          %mo =
                          %mn 0
                        %mi t
                      %msub
                        %mi c
                        %mi r
                      %mo ⊗
                      %msub
                        %mi c
                        %mrow
                          %mi t
                          %mo −
                          %mi r
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mu_k^\ast \otimes \mu_{n-k}^\ast) \mu_{k,n-k}^\ast(c_t)
                    \=
                    (\mu_k^\ast \otimes \mu_{n-k}^\ast)
                    \\left(
                    \\underoverset{r=0}{t}{\sum} c_r \otimes c_{t-r}
                    \\right)
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi μ
                      %mi k
                      %mo *
                    %mo ⊗
