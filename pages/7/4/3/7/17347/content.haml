              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
          #BrownFunctorTraditional.num_defn
            %h6#definition_14 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Brown+functor"} Brown functor
              is a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Top
