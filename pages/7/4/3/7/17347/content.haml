                    %semantics
                      %mrow
                        %mi μ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi μ
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi μ
                        %mo{:stretchy => "false"} (
                        %mi μ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\mu(x,\mu(y,z)) = \mu(\mu(x,y),z)
                        \\,;
              %li
                %p (commutativity)
