                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\tilde E^\bullet, \sigma)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology+theory"} reduced cohomology theory
              = succeed "." do
                %a.maruku-ref{:href => "#ReducedGeneralizedCohomology"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                    %annotation{:encoding => "application/x-tex"} E^\bullet
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralizedCohomologyTheory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo +
                    %mo ∪
                    %mi Cone
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
