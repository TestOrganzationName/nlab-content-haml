                      %mn 0
                    %mo ≃
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} (M \mathcal{B})_0 \simeq S^0
              (by def.
              = succeed ")" do
                %a.maruku-ref{:href => "#UniversalThomSpectrumForBfStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi(\ast) \colon (S^0 \overset{\simeq}{\to} S^0)
              indeed represents the unit element in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
