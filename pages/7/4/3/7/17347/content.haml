              = succeed "," do
                %a.maruku-ref{:href => "#AdditiveReducedCohomologyTheoryRepresentedByOmegaSpectrum"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
