                        %mo +
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_t((c_1)_1, \cdots, (c_1)_n)
                    \\;=\;
                    \\underoverset{r = 0}{t}{\sum}
                    \\sigma_r((c_1)_1, \cdots, (c_1)_{n-k})
                    \\cdot
                    \\sigma_{t-r}( (c_1)_{n-k+1}, \cdots, (c_1)_n )
                    \\,,
            %p
              where we agree with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma_q((c_1)_1, \cdots, (c_1)_p) = 0
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo &gt;
                      %mi p
                    %annotation{:encoding => "application/x-tex"} q \gt p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi μ
                      %mi k
                      %mo *
                    %mo ⊗
                    %msubsup
                      %mi μ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %mo *
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mi μ
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                        %mo −
                        %mi k
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
