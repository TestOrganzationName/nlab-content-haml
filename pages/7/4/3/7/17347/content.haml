                    [X, \mathbb{C}P^\infty \times \mathbb{C}P^\infty]
                    \&amp;\simeq&amp;
                    \\mathbb{C}LineBund(X)_{/\sim} \times \mathbb{C}LineBund(X)_{/\sim}
