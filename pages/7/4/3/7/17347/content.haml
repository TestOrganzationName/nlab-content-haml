              sends
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
              in the first argument to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limits"} homotopy limits
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi S
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
