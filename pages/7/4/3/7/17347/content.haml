                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mu_k^\ast \otimes \mu_{n-k}^\ast)
              is a monomorphism by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FromBUnTOBU1nPullbackInCohomologyIsInjective"}
          %h3#ConnerFloydChernClasses Conner-Floyd Chern classes
          %p
            %strong Idea.
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                %annotation{:encoding => "application/x-tex"} B U
            are called the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd+Chern+classes"} Conner-Floyd Chern classes
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(B U)
          %p
            Using basic properties of the classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B U(1)
            via its incarnation as the infinite
            %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequences"} Atiyah-Hirzebruch spectral sequences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mi n
                  %mo ,
                  %msub
                    %mi π
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %msup
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H^p(\mathbb{C}P^n, \pi_q(E)) \Rightarrow H^\bullet(\mathbb{C}P^n)
          %p
            collapse right away, and that the
            %a.existingWikiWord{:href => "/nlab/show/inverse+system"} inverse system
            which they form satisfies the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Mittag-Leffler+condition"} Mittag-Leffler condition
            %a.existingWikiWord{:href => "/nlab/show/Milnor+exact+sequence"} Milnor exact sequence
            gives that the ordinary
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                %annotation{:encoding => "application/x-tex"} c_1
            generates, over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^\bullet(B U(1)) \simeq \pi_\bullet(E) [ [ c_1 ] ]
                  \\,.
          %p
            This is the key input for the discussion of
            %a.existingWikiWord{:href => "/nlab/show/formal+group+laws"} formal group laws
            = succeed "." do
              %a{:href => "#FormalGroupLaws"} below
          %p
            Combining the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
            with the
            %a.existingWikiWord{:href => "/nlab/show/splitting+principle"} splitting principle
            as for ordinary Chern classes
            %a{:href => "#ChernClasses"} above
            yields, similarly, that in general Conner-Floyd classes are generated, over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
          %p
            Finally one checks that Conner-Floyd classes canonically serve as
            %a.existingWikiWord{:href => "/nlab/show/Thom+classes"} Thom classes
            for
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+complex+vector+bundle"} universal complex vector bundle
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theories"} complex oriented cohomology theories
            are indeed canonically
            %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} oriented
            on (
            %a.existingWikiWord{:href => "/nlab/show/spherical+fibrations"} spherical fibrations
            of)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundles"} complex vector bundles
          %p
            %strong Literature.
            (
            %a{:href => "#Kochman96"} Kochman 96, section 4.3
            = succeed "," do
              %a{:href => "#Adams74"} Adams 74, part I.4, part II.2 II.4, part III.10
            = succeed ")" do
              %a{:href => "#Lurie10"} Lurie 10, lecture 5
          #ConnerFloyedClasses.num_prop
            %h6#proposition_30 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with complex orientation
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi c
                        %mn 1
                        %mi E
                    %annotation{:encoding => "application/x-tex"} c_1^E
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} generalized cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %a.existingWikiWord{:href => "/nlab/show/BU%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B U(n)
              is freely generated over the
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}> prop.
              ) by classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mi k
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_k^E
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \leq \leq n
              of degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi k
                    %annotation{:encoding => "application/x-tex"} 2k
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd-Chern+classes"} Conner-Floyd-Chern classes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo ,
                    %msubsup
                      %mi c
                      %mn 2
                      %mi E
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msubsup
                      %mi c
                      %mi n
                      %mi E
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(B U(n))
                    \\;\simeq\;
                    \\pi_\bullet(E)[ [ c_1^E, c_2^E, \cdots, c_n^E ] ]
                    \\,.
            %p
              Moreover, pullback along the canonical inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(n) \to B U(n+1)
              is the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mi k
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_k^E
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \leq n
              and sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_{n+1}^E
              to zero.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              being
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
              of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
          %p
            For details see (
            %a{:href => "#Pedrotti16"}> Pedrotti 16, prop. 3.1.14
            ).
          %h3#FormalGroupLaws Formal group laws of first CF-Chern classes
          %p
            %strong Idea.
            The
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B U(1)
            for
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            canonically equipped with commutative group structure (
            %a.existingWikiWord{:href => "/nlab/show/infinity-group"}> infinity-group
            \-structure), corresponding to the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
            the first
            %a.existingWikiWord{:href => "/nlab/show/Conner-Floyd+Chern+class"} Conner-Floyd Chern class
            of these complex line bundles generates the
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
            %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} E^\bullet(B U(1)) \simeq \pi_\bullet(E)[ [ c_1 ] ]
            behaves like the ring of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            equipped with a canonical
            %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
            %em
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            over the
            %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}> prop.
            ).
          %p
            On abstract grounds it follows that there exists a commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            and a universal (1-dimensional commutative) formal group law
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                %annotation{:encoding => "application/x-tex"} \ell
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lazard+ring"} Lazard ring
            %a.existingWikiWord{:href => "/nlab/show/Lazard%27s+theorem"} Lazard's theorem
            identifies this ring concretely: it turns out to simply be the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            on generators in every even degree.
          %p
            Further below this has profound implications on the structure theory for complex oriented cohomology. The
            %a.existingWikiWord{:href => "/nlab/show/Milnor-Quillen+theorem+on+MU"} Milnor-Quillen theorem on MU
            identifies the Lazard ring as the cohomology ring of the
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Landweber+exact+functor+theorem"} Landweber exact functor theorem
          %p
            %strong Literature.
            (
            %a{:href => "#Kochman96"}> Kochman 96, section 4.4
            ,
            = succeed ")" do
              %a{:href => "#Lurie10"} Lurie 10, lectures 1 and 2
          %h4#formal_group_laws Formal group laws
          #AdicRing.num_defn
            %h6#definition_26 Definition
            %p
              An (commutative)
              %a.existingWikiWord{:href => "/nlab/show/adic+ring"} adic ring
