              in that under the defining equivalence, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi ℂ
                            %msup
                              %mi P
                              %mn ∞
                            %mo ×
                            %mi ℂ
                            %msup
                              %mi P
