                            %mo ≃
                            %mi R
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi c
                              %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    H^\bullet(\mathbb{C}P^\infty, R)
                    \&amp;
                    \\simeq
                    H^\bullet( \underset{\longleftarrow}{\lim}_n \mathbb{C}P^n , R)
                    \\\
                    \&amp;\simeq \underset{\longrightarrow}{\lim}_n H^\bullet(\mathbb{C}P^n, R)
                    \\\
                    \&amp;\simeq \underset{\longrightarrow}{\lim}_n ( R [c_1^E] / ((c_1)^{n+1})  )
                    \\\
                    \&amp; \simeq R[ [ c_1 ] ]
                    \\,,
                    \\end{aligned}
            %p
              where the last step is
              = succeed "." do
                %a{:href => "formal+scheme#FormalPowerSeries"} this prop.
          #ChoiceOfRingStructureOnGradedCohomologyGroupOfMultiplicativeCohomologyTheory.num_remark
            %h6#remark_7 Remark
            %p
              There is in general a choice to be made in interpreting the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MultiplicativeCohomologyTheory"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %p
              a priori
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^\bullet(X)
              is a sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\{E^n(X)\}_{n \in \mathbb{Z}}
            %p
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^{n_1}(X) \otimes E^{n_2}(X)
                    \\longrightarrow
                    E^{n_1 + n_2}(X)
                    \\,,
            %p
              one for each pair
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo ,
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} (n_1,n_2) \in \mathbb{Z}\times\mathbb{Z}
            %p
              In turning this into a single
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              by forming
              %a.existingWikiWord{:href => "/nlab/show/formal+sums"} formal sums
              of elements in the groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^n(X)
            %p
              In the former case the ring obtained is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{n \in \mathbb{N}} E^n(X)
            %p
              while in the latter case it is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{n \in \mathbb{N}} E^n (X)
                    \\,.
            %p
              These differ in general. For instance if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is infinite
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              = succeed "))" do
                %a.maruku-ref{:href => "#OrdinaryCohomologyOfComplexProjectiveSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi n
                              %mspace{:width => "thickmathspace"}
                              %mi even
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                  %annotation{:encoding => "application/x-tex"}
                    E^n(X)
                    \=
                    \\left\{
                    \\array{
                    \\mathbb{Z} &amp; n \; even
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
            %p and the product operation is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi E
                      %mrow
                        %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^{2{n_1}}(X)\otimes E^{2 n_2}(X)
                    \\longrightarrow
                    E^{2(n_1 + n_2)}(X)
            %p
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                    %mo ,
                    %msub
                      %mi n
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} n_1, n_2
              (and zero in odd degrees, necessarily). Now taking the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of these, this is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on one generator (in degree 2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊕
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\oplus_{n \in \mathbb{N}} E^n(X) \;\simeq\; \mathbb{Z}[c_1]
                    \\,.
            %p
              But taking the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+ring"} formal power series ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{n \in \mathbb{N}} E^n(X) \;\simeq\; \mathbb{Z} [ [ c_1 ] ]
                    \\,.
            %p
              A priori both of these are sensible choices. The former is the usual choice in traditional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebraic+topology"} algebraic topology
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              theory as a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              right away, then the second perspective tends to be more natural:
            %p
              The cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              is naturally computed as the
              %a.existingWikiWord{:href => "/nlab/show/inverse+limit"} inverse limit
              of the cohomolgies of the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[c_1]/((c_1)^{n+1})
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
              right away, instead of first taking it in
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+ring"} formal power series ring
              (see
              = succeed ")." do
                %a{:href => "formal+scheme#FormalPowerSeries"} here
            %p
              See also for instance remark 1.1. in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology"} A Survey of Elliptic Cohomology
          %h4#ComplexOrientatioon Complex orientation
          #ComplexOrientedCohomologyTheories.num_defn
            %h6#definition_25 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MultiplicativeCohomologyTheory"}
              %strong complex orientable
              if the the following equivalent conditions hold
            %ol
              %li
                %p The morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mi E
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        i^\ast \;\colon\; E^2(B U(1)) \longrightarrow E^2(S^2)
                %p
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              %li
                %p The morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi i
                            %mo{:stretchy => "false"} ˜
                          %mo *
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde i^\ast \;\colon\; \tilde E^2(B U(1)) \longrightarrow \tilde E^2(S^2)
                        \\simeq \pi_0(E)
                %p
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
              %li
                %p
                  The element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 1 \in \pi_0(E)
                  is in the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of the morphism
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mover
                              %mi i
                              %mo{:stretchy => "false"} ˜
                            %mo *
                        %annotation{:encoding => "application/x-tex"} \tilde i^\ast
            %p
              A
              %strong complex orientation
              on a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              is an element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo ∈
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    c_1^E \in \tilde E^2(B U(1))
            %p
              (the “first
              = succeed "\u201D)" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+Chern+class"} generalized Chern class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo =
                    %mn 1
                    %mo ∈
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i^\ast c^E_1 = 1 \in \pi_0(E)
                    \\,.
          .num_remark
            %h6#remark_8 Remark
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1) \simeq K(\mathbb{Z},2)
              is the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+line+bundles"} complex line bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                  %annotation{:encoding => "application/x-tex"} E^\bullet
              induces an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/generalized+Chern+class"} generalization
              of the
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              which to a
              %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              classified by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi \colon X \to B U(1)
              assigns the class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi ℒ
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msup
                        %mi ϕ
                        %mo *
                      %msubsup
                        %mi c
                        %mn 1
                        %mi E
                    %annotation{:encoding => "application/x-tex"} c_1(\mathcal{L}) \coloneqq \phi^\ast c_1^E
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Chern+classes"} Chern classes
          #CohomologyRingOfBU1ForComplexOrientedCohomologyTheory.num_prop
            %h6#proposition_26 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi E
                      %mo •
                    %mo ,
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E^\bullet, c^E_1)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ComplexOrientedCohomologyTheories"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/graded+rings"} graded rings
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    E^\bullet(\mathbb{C}P^\infty) \simeq E^\bullet(\ast)[ [ c_1^E ] ]
            %p
              between the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of infinite-dimensional complex projective space (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComplexProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              (see remark
              = succeed ")" do
                %a.maruku-ref{:href => "#ChoiceOfRingStructureOnGradedCohomologyGroupOfMultiplicativeCohomologyTheory"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the point.
          .proof
            %h6#proof_30 Proof
            %p
              Using the
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CellComplexStructureOnComplexProjectiveSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^{n+1}
              with the result of attaching a single
              = succeed "-cell" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 2
                    %mo ↪
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} i \;\colon\; S^2 \hookrightarrow \mathbb{C}P^\infty
              is identified with the canonical map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 2
                      %mo →
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^2 \to B U(1)
            %p
              Then consider the
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#AHSSExistence"}
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, E^\bullet(\ast))
                    \\;\Rightarrow\;
                    E^\bullet(\mathbb{C}P^n)
                    \\,.
            %p
              Since, by prop.
              = succeed "," do
                %a.maruku-ref{:href => "#OrdinaryCohomologyOfComplexProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              of complex projective space is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, \mathbb{Z}) \simeq \mathbb{Z}[c_1]/((c_1)^{n+1})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              represents a unit in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} H^2(S^2, \mathbb{Z})\simeq \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              in abelian groups (
              %a{:href => "projective+object#ProjectiveObjectsInAbAreFreeGroups"}> prop.
              ), the
              = succeed "-group" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Ext^1(H_n(\mathbb{C}P^n), E^\bullet(\ast)) = 0
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              (
              %a{:href => "universal+coefficient+theorem#OrdinaryStatementInCohomology"}> prop.
              ) gives that the second page of the spectral sequence is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo ,
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi c
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(\mathbb{C}P^n, E^\bullet(\ast))
                    \\simeq
                    E^\bullet(\ast)[ c_1 ] / (c_1^{n+1})
                    \\,.
            %p
              By the standard construction of the
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              (
              %a{:href => "Atiyah&#8211;Hirzebruch+spectral+sequence#ConstructionByFilteringTheBaseSpace"}> here
              ) in this identification the element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              is identified with a generator of the
              %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mover
                        %mi E
                        %mo{:stretchy => "false"} ˜
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E^2((\mathbb{C}P^n)_2, (\mathbb{C}P^n)_1)
                    \\simeq
                    \\tilde E^2(S^2)
            %p
              (using, by the above, that this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              is the unique 2-cell of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^n
              in the standard cell model).
            %p
              This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              is a permanent cocycle of the spectral sequence (in the kernel of all differentials) precisely if it arises via restriction from an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^2(\mathbb{C}P^n)
              and hence precisely if there exists a complex orientation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                  %annotation{:encoding => "application/x-tex"} c_1^E
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              is a permanent cocycle. (For the fully detailed argument see (
              %a{:href => "#Pedrotti16"}> Pedrotti 16
              )).
            %p
              The same argument applied to all elements in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi c
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast)[c]
              = succeed "-linearity" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast)
              = succeed ")," do
                %a.maruku-ref{:href => "#LinearityOfDifferentialsInSerreAHSSForMultiplicativeCohomologyTheory"}
            %p
              Since the AHSS of a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              is a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+spectral+sequence"} multiplicative spectral sequence
              (
              %a{:href => "multiplicative+cohomology+theory#AHSSForMultiplicativeCohomologyTheoryIsMultiplicative"}> prop.
              ) this implies that the differentials in fact vanish on all elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi c
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^\bullet(\ast) [c_1] / (c_1^{n+1})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo ≃
                    %msup
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi c
                      %mn 1
                      %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}_\infty^{\bullet,\bullet}
                    \\simeq
                    E^\bullet(\ast)[ c_1^{E} ] / ((c_1^E)^{n+1})
            %p or in more detail:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℰ
                      %mn ∞
                      %mrow
                        %mi p
