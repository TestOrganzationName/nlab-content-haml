                        %mi ℕ
                        %mo ,
                        %mo ≥
                        %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}^1 \colon Ab^{(\mathbb{N}, \geq)} \longrightarrow Ab
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Lim1ViaCokernel"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              = succeed "." do
                %a.maruku-ref{:href => "#AbstractCharacterizationOfLim1"}
          .proof
            %h6#proof_21 Proof
            %p
              The proof of prop.
              %a.maruku-ref{:href => "#Lim1IsDerivedLimit"}
              only used the conditions from prop.
              = succeed "," do
                %a.maruku-ref{:href => "#PropertiesOfLim1"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %mo ⟵
                    %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}
          %p
            The following is a kind of double dual version of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi lim
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \lim^1
            construction which is sometimes useful:
          #lim1AndExt1.num_lemma
            %h6#lemma_4 Lemma
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/cotower"} cotower
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 0
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mn 0
                    %msub
                      %mi A
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                    %msub
                      %mi A
                      %mn 2
                    %mo →
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A_\bullet = (A_0 \overset{f_0}{\to} A _1 \overset{f_1}{\to} A_2 \to \cdots)
            %p
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} B \in Ab
              there is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                      %mn 1
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
