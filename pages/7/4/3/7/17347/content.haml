          %h4#SectionThomTheorem Thom’s theorem
          %p
            Recall that the
            %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+construction"} Pontrjagin-Thom construction
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#PontrjaginThomConstruction"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi i
                  %mo ,
                  %mover
                    %mi g
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,i,\hat g)
            with normal
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
            = succeed ")" do
              %a.maruku-ref{:href => "#ManifoldWithBfStructure"}
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+group"} stable homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mi ℬ
                  %mo{:stretchy => "false"} )
