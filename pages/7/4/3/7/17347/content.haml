          .proof
            %h6#proof_34 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (the
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithfulness
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo ×
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                    %mo ⟶
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty \times \mathbb{C}P^\infty \longrightarrow \mathbb{C}P^\infty
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              admits the structure of a
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              (prop.
              = succeed "))" do
                %a.maruku-ref{:href => "#CellComplexStructureOnComplexProjectiveSpace"}
              %a.existingWikiWord{:href => "/nlab/show/standard+model+structure+on+topological+spaces"} standard model structure on topological spaces
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#TopQuillenModelStructure"}> thm.
              ), as is its
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              with itself (
              %a{:href => "CW+complex#ClosureOfCWComplexesUnderCartesianProduct"}> prop.
              ). Since moreover all spaces are fibrant in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"} this lemma
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
