            of the universal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            in degree the dimension of that manifold.
          #PontrjaginThomIsRingHomomorphims.num_lemma
            %h6#lemma_5 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              be a multiplicative
              %a.existingWikiWord{:href => "/nlab/show/%28B%2Cf%29-structure"} (B,f)-structure
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#BfStructure"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+construction"} Pontrjagin-Thom construction
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PontrjaginThomConstruction"}
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
