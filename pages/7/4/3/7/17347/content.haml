                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tilde E^{n+1}(Th(\mathbb{R}\oplus V_n^{\mathcal{B}}))
            %p
              Next,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
