                  %annotation{:encoding => "application/x-tex"} E_1, E_2, E_3
              be three unreduced
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized cohomology theories
              (
              %a{:href => "generalized+cohomology+theory#GeneralizedCohomologyTheory"}> def.
              ). A
              %strong pairing of cohomology theories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
