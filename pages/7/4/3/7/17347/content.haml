                          %mo *
                        %mo =
                        %msubsup
                          %mi f
                          %mn 2
                          %mo *
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        f_1^\ast = f_2^\ast
                        \\,.
              %li#ReducedExactnessAxiom
                %p
                  %strong (exactness)
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} i \colon A \hookrightarrow X
                  an inclusion of pointed topological spaces, with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⟶
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} j \colon X \longrightarrow Cone(i)
                  the induced
                  %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#ConeAndMappingCylinder"}> def.
                  ), then this gives an
                  %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
                  of graded abelian groups
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Cone
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi j
                              %mo *
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %msup
                              %mi i
                              %mo *
                        %msup
                          %mover
                            %mi E
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde E^\bullet(Cone(i))
                        \\overset{j^\ast}{\longrightarrow}
                        \\tilde E^\bullet(X)
                        \\overset{i^\ast}{\longrightarrow}
                        \\tilde E^\bullet(A)
                        \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#AguilarGitlerPrieto02"} AGP 02, def. 12.1.4
          %p
            This is equivalent (prop.
            %a.maruku-ref{:href => "#HomotopyTheoreticVersionOfCohomologyFunctorDefIsEquivalent"}
            below) to the following more succinct homotopy-theoretic definition:
