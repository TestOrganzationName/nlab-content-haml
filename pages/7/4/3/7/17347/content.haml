              = succeed ")" do
                %a.maruku-ref{:href => "#EOn"}
              %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on a single generator
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} c_1
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#OrdinaryCohomologyOfComplexProjectiveSpace"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B U(1))
                    \\simeq
                    \\mathbb{Z}[ c_1 ]
                    \\,.
            %p
              Moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi i
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} B i_1
              is the identity and the statement follows.
            %p
              Now by the
              %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
              for ordinary cohomology (
              %a{:href => "K%C3%BCnneth+theorem#KunnethInOrdinaryCohomology"}> prop.
              ) the cohomology of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              copies of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B U(1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              generators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B U(1)^n)
                    \\simeq
                    \\mathbb{Z}[(c_1)_1, \cdots, (c_1)_n]
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
              the domain of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (B i_n)^\ast
              is the
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              in the Chern classes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{c_i\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              copies of the first Chern class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi c
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (B i_n)^\ast
                    \\;\colon\;
                    \\mathbb{Z}[ c_1, \cdots, c_n ]
                    \\longrightarrow
                    \\mathbb{Z}[ (c_1)_1, \cdots, (c_1)_n ]
                    \\,.
            %p
              This allows to compute
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B i_n)^\ast(c_k)
              by
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            %p
              Consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              and assume that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi σ
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B i_{n-1})^\ast_{n-1}(c_k) = \sigma_k((c_1)_1, \cdots, (c_1)_{(n-1)})
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mi n
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi σ
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B i_n)^\ast(c_k) = \sigma_k((c_1)_1,\cdots, (c_1)_n)
            %p
              Consider then the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi B
                                %msub
                                  %mi i
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi B
                                  %msub
                                    %mi j
                                    %mover
                                      %mi t
                                      %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi B
                                  %msub
                                    %mi i
                                    %mover
                                      %mi t
                                      %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi n
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi B
                                %msub
                                  %mi i
                                  %mi n
                          %mtd
                            %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    B U(1)^{n-1}
                    \&amp;\overset{ B i_{n-1} }{\longrightarrow}&amp;
                    B U(n-1)
                    \\\
                    {}^{\mathllap{B j_{\hat t}}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{B i_{\hat t}}}
                    \\\
                    B U(1)^n
                    \&amp;\underset{B i_n}{\longrightarrow}&amp;
                    B U(n)
                    }
            %p where both vertical morphisms are induced from the inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msup
                      %mi ℂ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{C}^{n-1} \hookrightarrow \mathbb{C}^n
            %p
              which omits the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
            %p
              Since two embeddings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mover
                            %mi t
                            %mo{:stretchy => "false"} ^
                          %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mover
                            %mi t
                            %mo{:stretchy => "false"} ^
                          %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_{\hat t_1}, i_{\hat t_2} \colon U(n-1) \hookrightarrow U(n)
              differ by
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              with an element in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inner+automorphism"} inner automorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mover
                            %mi t
                            %mo{:stretchy => "false"} ^
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} B i_{\hat t_1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mrow
                        %msub
                          %mover
                            %mi i
                            %mo{:stretchy => "false"} ^
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                  %annotation{:encoding => "application/x-tex"} B_{\hat i_{t_2}}
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mover
                          %mi t
                          %mo{:stretchy => "false"} ^
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi B
                      %msub
                        %mi i
                        %mover
                          %mi n
                          %mo{:stretchy => "false"} ^
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (B i_{\hat t})^\ast = (B i_{\hat n})^\ast
              = succeed "." do
                %a.maruku-ref{:href => "#GeneratorsOfCohomologyOfBunChernClasses"}
            %p
              By that proposition,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mover
                        %mi t
                        %mo{:stretchy => "false"} ^
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (B i_{\hat t})^\ast
              is the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                  %annotation{:encoding => "application/x-tex"} c_{k \lt n}
              and hence by induction assumption
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mi i
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mi i
                              %mover
                                %mi t
                                %mo{:stretchy => "false"} ^
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %msub
                              %mi c
                              %mrow
                                %mi k
                                %mo &lt;
                                %mi n
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi B
                            %msub
                              %mi i
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %msub
                              %mi c
                              %mrow
                                %mi k
                                %mo &lt;
                                %mi n
                        %mtr
                          %mtd
                            %mo =
                            %msub
                              %mi σ
                              %mi k
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mover
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 1
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi t
                              %mo ^
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (B i_{n-1})^\ast (B i_{\hat t})^\ast c_{k \lt n}
                    \&amp;=
                    (B i_{n-1})^\ast c_{k \lt n}
                    \\\
                    \=
                    \\sigma_k( (c_1)_1, \cdots, \widehat{(c_1)_t}, \cdots, (c_1)_n )
                    \\end{aligned}
                    \\,.
            %p
              Since pullback along the left vertical morphism sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi t
                  %annotation{:encoding => "application/x-tex"} (c_1)_t
              to zero and is the identity on the other generators, this shows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi i
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi σ
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
