                    %a.existingWikiWord{:href => "/nlab/show/adic+topology"} adic topology
              %li
                %p the canonical morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
