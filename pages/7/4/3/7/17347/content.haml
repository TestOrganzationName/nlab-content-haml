                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde E^\bullet
                    \\;\colon\;
                    (Top^{\ast/})^{op} \longrightarrow Ab^{\mathbb{Z}}
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
