                      %mi op
                    %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F : (C/c)^{op} \to C^{op} \to Set
                    \\,.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⊔
                      %mrow
                        %mi f
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
