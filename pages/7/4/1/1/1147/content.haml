                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi α
                                  %mi c
                        %mtr
                          %mtd
                            %mi pt
                          %mtd
                            %mover
                              %mo →
                              %mi x
                          %mtd
                            %mi Pc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\bar{\varphi}(\alpha)(x,Pc) &amp;\to&amp; Qc
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\alpha_c}
                    \\\
                    pt &amp;\stackrel{x}{\to}&amp; Pc
                    }
                    \\,.
            %p
              The action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi φ
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar{\varphi}(\alpha)
              on arrows of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi el
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} el(P)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi el
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} el(P)
          %h3#relationship_with_the_overcategories_statement Relationship with the over-categories statement
          %p
            Putting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi P
                  %mo =
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D = C^{op}, P = Y(c)
            in the above yields:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mrow
                      %mi el
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mi D
                  %mo{:stretchy => "false"} /
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Set}^{el(Y(c))} \simeq \mathbf{Set}^D / Y(c)
          %p
            Now it is easy to see that
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi el
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} el(Y(c)) \simeq (C / c)^{op}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi c
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                  %mo ≃
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mo{:stretchy => "false"} /
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Set}^{(C / c)^{op}} \simeq \mathbf{Set}^{C^{op}} / Y(c)
          %h2#in_higher_category_theory In higher category theory
          %p
            For the analogous result in the context of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            theory see
            %a{:href => "http://ncatlab.org/nlab/show/(infinity%2C1)-category+of+(infinity%2C1)-presheaves#WithOvercategories"} (∞,1)-Category of (∞,1)-presheaves – Interaction with overcategories
          %h2#related_concepts Related concepts
          %ul
