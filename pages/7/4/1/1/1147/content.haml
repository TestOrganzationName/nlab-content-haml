                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,Pc) = (\ast \stackrel{x}{\to} Pc)
              is an object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi el
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} el(P)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:lspace => "verythinmathspace"} :
                      %mi φ
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi P
                    %annotation{:encoding => "application/x-tex"} \alpha \colon \varphi(F) \to P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi α
                              %mi c
                            %mo{:lspace => "verythinmathspace"} :
                            %mi φ
