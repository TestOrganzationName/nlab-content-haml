          .un_lemma
            %h6#example Example
            %p
              Suppose the presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in PSh(C/c)
              does not actually depend on the morphsims to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mo{:stretchy => "false"} (
