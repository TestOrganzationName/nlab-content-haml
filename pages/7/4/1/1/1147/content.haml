                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \bar{\varphi}(\alpha)(x,Pc) = \alpha_c^{-1}(x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi φ
                              %mo{:stretchy => "false"} ¯
