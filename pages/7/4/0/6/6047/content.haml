          %h2#definition Definition
          %p
            The
            %em Nambu-Goto action
            is an
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            for
            %a.existingWikiWord{:href => "/nlab/show/sigma-models"} sigma-models
            with
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            a (
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"}> pseudo
            )
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi NG
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mover
                    %mo →
                    %mi γ
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi T
                  %msub
                    %mo ∫
                    %mi Σ
                  %mi dvol
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi γ
                    %mo *
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  S_{NG}
                  \\;\colon\;
                  (\Sigma \stackrel{\gamma}{\to} X)
                  \\mapsto
                  T \int_\Sigma dvol(\gamma^* g)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dvol
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi γ
                    %mo *
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} dvol(\gamma^* g)
            is the
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            of the pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi γ
                    %mo *
                  %mi g
                %annotation{:encoding => "application/x-tex"} \gamma^* g
            of the metric tensor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            (the
            = succeed "-\u201Ctension\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/brane"} brane
            %a.existingWikiWord{:href => "/nlab/show/string+tension"} string tension
            for
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} dim(\Sigma) = 2
            %a.existingWikiWord{:href => "/nlab/show/unit"} unit
            of
            %a.existingWikiWord{:href => "/nlab/show/length"} length
            to the power the
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} dim(\Sigma)
          %h2#definition_2 Definition
          %p Let
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
                (for
                %a.existingWikiWord{:href => "/nlab/show/p-brane"} p-brane
                dynamics);
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,g)
                a
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
                (
                %a.existingWikiWord{:href => "/nlab/show/target+spacetime"}> target spacetime
                );
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                a
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                of dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+1)
                (
                %a.existingWikiWord{:href => "/nlab/show/worldvolume"}> worldvolume
                ).
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Σ
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Sigma,X]
                the
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \Sigma \to X
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Σ
                  %mo ⟶
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi \colon \Sigma \longrightarrow X
            the induced “proper volume” or
            %em Nambu-Goto action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is the
            %a.existingWikiWord{:href => "/nlab/show/integral"} integral
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            of the
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            of the pullback of the target space metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi NG
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mo ∫
                    %mi Σ
                  %mi dvol
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ϕ
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S_{NG}(\phi) \coloneqq \int_{\Sigma} dvol(\phi^\ast(g))
                  \\,.
          %p
            Notice that the rank-2
            %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mo *
                  %mi g
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo *
                  %mi Σ
                  %mo ⊕
                  %mi T
                  %mo *
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi^\ast g\in \Gamma(T* \Sigma \oplus T* \Sigma)
            is in general not non-degenerate (unless
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is an
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+metric"} pseudo-Riemannian metric
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            by the standard formula, only that this allowed to vanish pointwise (and even globally, for instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is constant on a single point). In the literature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dvol
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ϕ
                    %mo *
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} dvol(\phi^\ast g)
            is usually written as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi g
                    %msup
                      %mi d
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sqrt{-g}d^{p+1}\sigma
          %h2#properties Properties
          %h3#relation_to_the_polyakov_action Relation to the Polyakov action
          %p
            The NG is classically equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/Polyakov+action"} Polyakov action
            with “
            %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
            = succeed "." do
              %em
                %a{:href => "Polyakov+action#RelationToNambuGotoAction"} Polyakov action – Relation to Nambu-Goto action
          %h2#applications Applications
          %p
            The NG-action serves as the kinetic
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of the
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            that described a fundamental
            %a.existingWikiWord{:href => "/nlab/show/brane"} brane
            propagating on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mi Σ
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} dim \Sigma = 1
            this is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/relativistic+particle"} relativistic particle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mi Σ
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} dim \Sigma = 2
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string"} string
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dim
                  %mi Σ
                  %mo =
                  %mn 3
                %annotation{:encoding => "application/x-tex"} dim \Sigma = 3
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/membrane"} membrane
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/minimal+surface"} minimal surface
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Polyakov+action"} Polyakov action
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac-Born-Infeld+action"} Dirac-Born-Infeld action
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Veneziano+amplitude"} Veneziano amplitude
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/particle"}> particle
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/string"} string
                %a.existingWikiWord{:href => "/nlab/show/membrane"} membrane
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/membrane+instanton"} membrane instanton
            %li
              %p
                for more on brane tension see also
                %em
                  %a{:href => "non-perturbative+effect#WorldsheetAndBraneInstantons"} Worldsheet and brane instantons
          %h2#references References
          %p
            The Nambu-Goto action functional originates as a proposal for the dynamics of
            %a.existingWikiWord{:href => "/nlab/show/strings"} strings
            meant to explain the “dual resonance model” for
            %a.existingWikiWord{:href => "/nlab/show/hadron"} hadron
            %a.existingWikiWord{:href => "/nlab/show/bound+states"} bound states
            (
            %a.existingWikiWord{:href => "/nlab/show/quantum+hadrodynamics"}> quantum hadrodynamics
            , cf.
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Polyakov+gauge-string+duality"} Polyakov gauge-string duality
          %ul
            %li#Nambu70
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yoichiro+Nambu"}> Yoichiro Nambu
                ,
                = succeed "," do
                  %em Duality and Hadrodynamics
                = succeed "," do
                  %a{:href => "https://doi.org/10.1142/9789812795823_0026"} doi:10.1142/9789812795823_0026
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Nambu-DualityAndHadrodynamics.pdf", :title => "pdf"} pdf
            %li{:id => "Gotō71"}
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tetsuo+Got%C5%8D"}> Tetsuo Gotō
                ,
                = succeed "," do
                  %em Relativistic Quantum Mechanics of One-Dimensional Mechanical Continuum and Subsidiary Condition of Dual Resonance Model
                %strong 46
                5 (1971) 1560–1569 &amp;lbrack;
                %a{:href => "https://doi.org/10.1143/PTP.46.1560"}> doi:10.1143/PTP.46.1560
                \&amp;rbrack;
          %p Historical review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jo%C3%ABl+Scherk"}> Joël Scherk
                ,
                = succeed "," do
                  %em An introduction to the theory of dual models and strings
                %strong 47
                123 (1975) &amp;lbrack;
                %a{:href => "https://doi.org/10.1103/RevModPhys.47.123"}> doi:10.1103/RevModPhys.47.123
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hiroshi+Itoyama"}> Hiroshi Itoyama
                ,
                = succeed "," do
                  %em Birth of String Theory
                %strong 2016
                6 (2016) 06A103 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1604.03701"}> arXiv:1604.03701
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1093/ptep/ptw063"} doi:10.1093/ptep/ptw063
          %p
            Detailed discussion of the relation to the
            %a.existingWikiWord{:href => "/nlab/show/Polyakov+action"} Polyakov action
            and the
            %a.existingWikiWord{:href => "/nlab/show/Dirac-Born-Infeld+action"} Dirac-Born-Infeld action
            is in
          %ul
            %li#Nieto01
              J. A. Nieto,
              %em Remarks on Weyl invariant p-branes and Dp-branes
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0110227"}> arXiv:hep-th/0110227
              )
          %p
            One
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            textbook that deals with the Nambu-Goto action in a bit more detail than usual is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Barton+Zwiebach"}> Barton Zwiebach
              ,
              %em A first course in string theory
              , Cambridge (2009)
          %p
            Discussion of the Nambu-Goto action and
            %a.existingWikiWord{:href => "/nlab/show/Polyakov+action"} Polyakov action
            on
            %a.existingWikiWord{:href => "/nlab/show/worldsheets"} worldsheets
            with
            %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
            (i.e. in the generality of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/open+strings"} open strings
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
          %ul
            %li#MartinoliSchiavina22
              S. Martinoli,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michele+Schiavina"} Michele Schiavina
              = succeed "," do
                %em BV analysis of Polyakov and Nambu–Goto theories with boundary
              %strong 112
              35 (2022) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s11005-022-01526-1"}> doi:10.1007/s11005-022-01526-1
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2106.02983"} arXiv:2106.02983
          %p
            Relation of the Nambu-Goto string to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Liouville+theory"} Liouville theory
