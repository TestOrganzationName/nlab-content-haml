            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \mathrm{Bool}
            which is a
            %a.existingWikiWord{:href => "/nlab/show/univalent+Tarski+universe"} univalent Tarski universe
            with
            %a.existingWikiWord{:href => "/nlab/show/type+family"} type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} El
                    %mi{:mathvariant => "normal"} Bool
                %annotation{:encoding => "application/x-tex"} \mathrm{El}_\mathrm{Bool}
            and thus satisfies the extensionality principle, truncated excluded middle could be stated as given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
