            or a
            %a.existingWikiWord{:href => "/nlab/show/Tarski+type+of+all+propositions"} Tarski type of all propositions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} El
                      %mi Ω
                    %mo{:stretchy => "false"} )
