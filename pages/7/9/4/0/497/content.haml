                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} lem
                      %mo :
                      %mi Π
                      %mi P
                      %mo .
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo +
                      %mo ¬
                      %mi P
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{lem}:\Pi P.\mathrm{isProp}(P) \to (P + \neg P)}
          %p
            Similarly, if the dependent type theory additionally has a
            %a.existingWikiWord{:href => "/nlab/show/Russell+type+of+all+propositions"} Russell type of all propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
