              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} lem
                        %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi{:mathvariant => "normal"} isContr
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi Q
                            %mo :
                            %mi{:mathvariant => "normal"} Bool
                        %mi P
                        %mo ≃
                        %msub
                          %mi{:mathvariant => "normal"} El
                          %mi{:mathvariant => "normal"} Bool
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} )
                        %mo )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash P \; \mathrm{type}}{\Gamma \vdash \mathrm{lem}_P:\mathrm{isProp}(P) \to \mathrm{isContr}\left(\sum_{Q:\mathrm{Bool}} P \simeq \mathrm{El}_\mathrm{Bool}(Q)\right)}
          %p
            or equivalently, using the
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            and the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} uniqueness quantifier
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} lem
                        %mi P
                      %mo :
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo ∃
                      %mo !
                      %mi Q
                      %mo :
                      %mi{:mathvariant => "normal"} Bool
                      %mo .
                      %mi P
                      %mo ≃
                      %msub
                        %mi{:mathvariant => "normal"} El
                        %mi{:mathvariant => "normal"} Bool
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash P \; \mathrm{type}}{\Gamma \vdash \mathrm{lem}_P:\mathrm{isProp}(P) \to \exists!Q:\mathrm{Bool}.P \simeq \mathrm{El}_\mathrm{Bool}(Q)}
          %p
            By definition, the only two booleans are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            representing false and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            representing true.
          %h3#relations_between_the_notions_of_excluded_middle Relations between the notions of excluded middle
          %p
          .num_theorem
            %h6 Theorem
            %p The untruncated version of excluded middle implies the truncated version of excluded middle.
          %p
          .proof
            %h6 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/introduction+rule"} introduction rule
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/propositional+truncations"} propositional truncations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} isInhab
                        %mrow
                          %mi P
                          %mo +
                          %mo ¬
                          %mi P
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo +
                      %mo ¬
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi P
                      %mo +
                      %mo ¬
                      %mi P
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathrm{isInhab}_{P + \neg P}:(P + \neg P) \to [P + \neg P]
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              of functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} isInhab
                      %mrow
                        %mi P
                        %mo +
                        %mo ¬
                        %mi P
                    %mo ∘
                    %msub
                      %mi{:mathvariant => "normal"} lem
                      %mi P
                    %mo :
                    %mi{:mathvariant => "normal"} isProp
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ∨
                    %mo ¬
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{isInhab}_{P + \neg P} \circ \mathrm{lem}_P:\mathrm{isProp}(P) \to (P \vee \neg P)
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p The contractible version of excluded middle implies the untruncated version of excluded middle
          %p
          .proof
            %h6 Proof
            %p
              The type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} isContr
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo +
                    %mo ¬
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{isContr}(P + \neg P)
              is really the type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi a
                        %mo :
                        %mi P
                        %mo +
                        %mo ¬
                        %mi P
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi b
                        %mo :
                        %mi P
                        %mo +
                        %mo ¬
                        %mi P
                    %mi a
                    %msub
                      %mo =
                      %mrow
                        %mi P
                        %mo +
                        %mo ¬
                        %mi P
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \sum_{a:P + \neg P} \prod_{b:P + \neg P} a =_{P + \neg P} b
            %p
              Thus, by the
              %a.existingWikiWord{:href => "/nlab/show/introduction+rules"} introduction rules
              of
              %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
              and the elimination rules of
              %a.existingWikiWord{:href => "/nlab/show/negative+type"} negative
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi x
                    %mo :
                    %mi{:mathvariant => "normal"} isProp
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo .
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} lem
                      %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi{:mathvariant => "normal"} isProp
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo +
                    %mo ¬
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda x:\mathrm{isProp}(P).\pi_1(\mathrm{lem}_P(x)):\mathrm{isProp}(P) \to (P + \neg P)
            %p which is precisely the untruncated version of excluded middle
          %h2#RelationToTheAxiomOfChoice Relation to the axiom of choice
          %p
            Excluded middle can be seen as a very weak form of the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            (a slightly more controversial principle, doubted or denied by a slightly larger minority, and true internally in even fewer categories). In fact, the following are equivalent. (this is the
            %a.existingWikiWord{:href => "/nlab/show/Diaconescu-Goodman-Myhill+theorem"} Diaconescu-Goodman-Myhill theorem
            due to
            = succeed "," do
              %a{:href => "#Diaconescu75"} Diaconescu 75
            = succeed "," do
              %a{:href => "#McLarty96"} McLarty 96, theorem 19.7
          %ol
            %li The principle of excluded middle.
            %li
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} Finitely indexed
              sets are
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective
              (in fact, it suffices 2-indexed sets to be projective).
            %li
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} Finite sets
              are
              %a.existingWikiWord{:href => "/nlab/show/choice+object"} choice
              (in fact, it suffices for 2 to be choice).
          %p
            (Here, a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong finite
            or
            %strong finitely-indexed
            (respectively) if, for some natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \{0, \ldots, n - 1\} \to A
          %p
            The proof is as follows. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a truth value, then divide
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{0,1\}
            by the equivalence relation where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≡
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \equiv 1
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            holds. Then we have a surjection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} 2\to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            (and in particular, finite), and whose codomain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is 2-indexed (and thus finitely-indexed). But this surjection splits iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is true or false, so if either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is choice or
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %p
            On the other hand, if PEM holds, then we can show by induction that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are choice, so is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊔
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\sqcup B
            (add details). Thus, all finite sets are choice. Now if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} n\to A
            is a surjection, exhibiting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as finitely indexed, it has a section
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi n
                  %annotation{:encoding => "application/x-tex"} A\to n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is projective.
          %p
            In particular, the axiom of choice implies PEM. This argument, due originally to Diaconescu, can be internalized in any
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/countable+choice"} countable choice
            (any surjection to a countable set (which for this purpose is any set isomorphic to the set of natural numbers) has a section),
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+choice"} dependent choice
            %a.existingWikiWord{:href => "/nlab/show/COSHEP"} COSHEP
            do not imply PEM.
          %p
            While is often claimed that axiom of choice is
            %em true
            in constructive mathematics (by the BHK or
            %a.existingWikiWord{:href => "/nlab/show/Brouwer-Heyting-Kolmogorov+interpretation"} Brouwer-Heyting-Kolmogorov interpretation
            of predicate logic), the BHK interpretation of the “axiom of choice” is simply the always true statement that indexed
            %a.existingWikiWord{:href => "/nlab/show/cartesian+products"} cartesian products
            distribute over indexed
            %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo ∈
                        %mi A
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨄
                      %mrow
                        %mi y
                        %mo ∈
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} {
                    %mo ⊤
                    %mo{:stretchy => "false"} |
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo )
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨄
                      %mrow
                        %mi g
                        %mo ∈
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi x
                            %mo ∈
                            %mi A
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} {
                    %mo ⊤
                    %mo{:stretchy => "false"} |
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mo )
                %annotation{:encoding => "application/x-tex"} \left(\prod_{x \in A} \biguplus_{y \in B(x)} \{\top \vert P(x, y)\}\right) \to \left(\biguplus_{g \in \prod_{x \in A} B(x)} \{\top \vert P(x, g(x))\}\right)
          %p
            or the always true statement that every
            %a.existingWikiWord{:href => "/nlab/show/split+surjection"} split surjection
            splits.
          %h2#other_equivalent_statements Other equivalent statements
          %ul
            %li
              %p
                Every set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                with a
                %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
                from the
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is either a
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                or in
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                with the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
            %li
              %p
                The set of
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relations"} equivalence relations
                on the
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
                is in
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
                with the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
            %li
              %p
                Morgan Rogers showed
                %a{:href => "https://golem.ph.utexas.edu/category/2023/01/freedom.html#c062002"} here
                that the fact that the
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                is a
                %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean topos
                is equivalent to the fact that every
                %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed set
                is a
                %a.existingWikiWord{:href => "/nlab/show/free+object"} free
                pointed set.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/compact+spaces+equivalently+have+converging+subnets"} compact spaces equivalently have converging subnets
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Hanson"} James Hanson
                showed
                %a{:href => "https://categorytheory.zulipchat.com/#narrow/stream/229136-theory.3A-category-theory/topic/One.20universe.20as.20a.20foundation.20.26.20friends/near/465219817"} here
                that every
                %a.existingWikiWord{:href => "/nlab/show/lower+real+number"} lower real number
                being a
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
                is equivalent to LEM. Similarly, every
                %a.existingWikiWord{:href => "/nlab/show/upper+real+number"} upper real number
                being a
                %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+number"} Dedekind real number
                is equivalent to LEM.
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/subcountable+set"} subcountable set
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable set
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/limited+principle+of+omniscience"} limited principle of omniscience
                holds for all
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/subsingletons"} subsingletons
            %li
              %p
                Sets with
                %a.existingWikiWord{:href => "/nlab/show/decidable+tight+apartness+relations"} decidable tight apartness relations
                form a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            %li
              %p
                Assuming
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/function+sets"} function sets
                %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
                on a
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/decidable+tight+apartness+relation"} decidable
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                is a
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
                iff the
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean topos
                %a.existingWikiWord{:href => "/nlab/show/topology"} topology
                (using
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/locales"} locales
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/formal+topologies"} formal topologies
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/poset+of+truth+values"} poset of truth values
                has a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/tight+apartness+relation"} tight apartness relation
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/partial+function+classifier"} partial function classifier
                of any
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
                of a
                %a.existingWikiWord{:href => "/nlab/show/discrete+integral+domain"} discrete
                %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+domain"} Bézout
                %a.existingWikiWord{:href => "/nlab/show/unique+factorization+domain"} unique factorization domain
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/principal+ideal"} principal ideal
          %h2#DoubleNegatedPEM Double-negated PEM
          %p While PEM is not valid in constructive mathematics, its double negation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg\neg(A\vee \neg A)
          %p
            is valid. One way to see this is to note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo ¬
                  %mi A
                  %mo ∧
                  %mo ¬
                  %mi B
                %annotation{:encoding => "application/x-tex"} \neg (A\vee B) = \neg A \wedge \neg B
            is one of
            %a.existingWikiWord{:href => "/nlab/show/de+Morgan%27s+laws"} de Morgan's laws
            that is constructively valid, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi A
                  %mo ∧
                  %mo ¬
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg (\neg A \wedge \neg\neg A)
            is easy to prove (it is an instance of the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/law+of+non-contradiction"} law of non-contradiction
          %p
            However, a more direct argument makes the structure of the proof more clear. When
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/beta-reduced"} beta-reduced
            %span.newWikiWord
              proof term
              %a{:href => "/nlab/new/proof+term"} ?
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi x
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mi inr
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi a
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} (
                    %mi inl
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda x. x(inr(\lambda a. x(inl(a))))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg (A\vee \neg A)
            for a contradiction, for which it suffices (by assumption) to prove
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∨
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A\vee \neg A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \neg A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            for a contradiction. But now we can reach a contradiction by invoking (again) our assumption of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg (A\vee \neg A)
            and proving
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} A\vee \neg A
            this time using our new assumption of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \neg A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and asking us to yield a contradiction, we retroactively change our minds and claim that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            instead, using the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            that we were just given as evidence.
          %p
          .num_theorem
            %h6 Theorem
            %p
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
          .proof
            %h6 Proof
            %p
              The type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                    %mi A
                    %mo →
                    %mo ¬
                    %mo ¬
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \neg \neg A \to \neg \neg A
              has an element, the
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mrow
                          %mo ¬
                          %mo ¬
                          %mi A
                    %annotation{:encoding => "application/x-tex"} \mathrm{id}_{\neg \neg A}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} uncurry
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ,
                        %mi C
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{uncurry}_{A, B, C}:(A \to (B \to C)) \simeq ((A \times B) \to C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} expconv
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                        %mo ,
                        %mi C
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{expconv}^{A, B, C}:((A \to C) \times (B \to C)) \simeq ((A + B) \to C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} comm
                      %mo +
                      %mrow
                        %mi A
                        %mo ,
                        %mi B
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo +
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{comm}_+^{A,B}:(A + B) \simeq (B + A)
            %p Thus, there is an element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi z
                    %mo :
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mo ¬
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi λ
                    %mi y
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi A
                    %mo +
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi z
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi{:mathvariant => "normal"} comm
                      %mo +
                      %mrow
                        %mo ¬
                        %mi A
                        %mo ,
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mo ¬
                    %mi A
                    %mo ×
                    %mo ¬
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo .
                    %msup
                      %mi{:mathvariant => "normal"} expconv
                      %mrow
                        %mo ¬
                        %mi A
                        %mo ,
                        %mi A
                        %mo ,
                        %mi ∅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} uncurry
                      %mrow
                        %mo ¬
                        %mo ¬
                        %mi A
                        %mo ,
                        %mo ¬
                        %mi A
                        %mo ,
                        %mi ∅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %mo ¬
                        %mo ¬
                        %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo ¬
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
                    %mo ¬
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda z:\neg (A + \neg A).\lambda y:(\neg A + A).z(\mathrm{comm}_+^{\neg A,A}(\lambda x:(\neg \neg A \times \neg A).\mathrm{expconv}^{\neg A, A, \emptyset}(\mathrm{uncurry}_{\neg \neg A, \neg A, \emptyset}(\mathrm{id}_{\neg \neg A})(x))(y)):\neg \neg (A + \neg A)
            %p
          %p
            In particular, this shows how the
            %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation
            %a.existingWikiWord{:href => "/nlab/show/modality"} modality
            can be regarded computationally as a sort of
            %a.existingWikiWord{:href => "/nlab/show/continuation-passing"} continuation-passing
            transform.
          %p However, there is another meaning of “double negated PEM” that is not valid. The above argument shows that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi A
                  %mo ,
                  %mo ¬
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \forall A, \neg\neg(A\vee \neg A).
          %p But a stronger statement is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mo ∀
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \neg\neg \forall A, (A \vee \neg A).
          %p
            This is related to the above valid statement by a
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/double-negation+shift"} double-negation shift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo ¬
                  %mo ∀
                  %mi A
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∨
                  %mo ¬
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg\neg \forall A, (A \vee \neg A)
            is equivalent to the principle of double-negation shift. In particular, it is
            %em not
            constructively provable.
          %h2#other_variants_of_excluded_middle Other variants of excluded middle
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
            to the
            %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            of said propositions, but which are weaker in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo ¬
                          %mo{:stretchy => "false"} (
                          %mo ¬
                          %mi P
                          %mo ∧
                          %mo ¬
                          %mrow
                            %mo ¬
                            %mi P
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mi ⇗
                        %mtd
                        %mtd
                          %mi ⇖
                      %mtr
                        %mtd
                          %mo ¬
                          %mi P
                          %mo →
                          %mo ¬
                          %mi P
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi P
                          %mo ←
                          %mo ¬
                          %mrow
                            %mo ¬
                            %mi P
                      %mtr
                        %mtd
                        %mtd
                          %mi ⇖
                        %mtd
                        %mtd
                          %mi ⇗
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo ¬
                          %mi P
                          %mo →
                          %mo ¬
                          %mi P
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo ←
                          %mo ¬
                          %mrow
                            %mo ¬
                            %mi P
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo ⇑
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi P
                          %mo ∨
                          %mo ¬
                          %mi P
                %annotation{:encoding => "application/x-tex"}
                  \\array {           &amp;          &amp; \neg(\neg{P} \wedge \neg{\neg{P}}) \\
                  \&amp; &amp;#x21d7; &amp;          &amp; &amp;#x21d6; \\
                  \\neg{P} \rightarrow \neg{P} &amp;          &amp;          &amp;          &amp; P \leftarrow \neg{\neg{P}} \\
                  \&amp; &amp;#x21d6; &amp;          &amp; &amp;#x21d7; \\
                  \&amp;          &amp; (\neg{P} \rightarrow \neg{P}) \wedge (P \leftarrow \neg{\neg{P}}) \\
                  \&amp;          &amp; \Uparrow \\
                  \&amp;          &amp; P \vee \neg{P} }
          %p
            (A single arrow is implication in the object language; a double arrow is entailment in the metalanguage.) Note that the false statement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi P
                  %mo ∧
                  %mo ¬
                  %mrow
                    %mo ¬
                    %mi P
                %annotation{:encoding => "application/x-tex"} \neg{P} \wedge \neg{\neg{P}}
            is the
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            of every item in this diagram.
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mo ¬
                      %mi P
                      %mo ∧
                      %mo ¬
                      %mrow
                        %mo ¬
                        %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \neg(\neg{P} \wedge \neg{\neg{P}})
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi P
                      %mo →
                      %mo ¬
                      %mi P
                    %annotation{:encoding => "application/x-tex"} \neg{P} \rightarrow \neg{P}
                are always true in
                %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi P
                      %mo ←
                      %mo ¬
                      %mrow
                        %mo ¬
                        %mi P
                    %annotation{:encoding => "application/x-tex"} P \leftarrow \neg{\neg{P}}
                ,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo ¬
                        %mi P
                        %mo →
                        %mo ¬
                        %mi P
                        %mo{:stretchy => "false"} )
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ←
                        %mo ¬
                        %mrow
                          %mo ¬
                          %mi P
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\neg{P} \rightarrow \neg{P}) \wedge (P \leftarrow \neg{\neg{P}})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ∨
                      %mo ¬
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P \vee \neg{P}
                are equivalent to excluded middle, since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ←
                      %mo ¬
                      %mrow
                        %mo ¬
                        %mi P
                    %annotation{:encoding => "application/x-tex"} P \leftarrow \neg{\neg{P}}
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/double+negation+law"} double negation law
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ¬
                      %mi P
                      %mo →
                      %mo ¬
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ←
                      %mo ¬
                      %mrow
                        %mo ¬
                        %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\neg{P} \rightarrow \neg{P}) \wedge (P \leftarrow \neg{\neg{P}})
                is the
                %a.existingWikiWord{:href => "/nlab/show/conjunction"} conjunction
                of the double negation law with an intuitionistically true statement.
          %h2#sharp_excluded_middle Sharp excluded middle
          %p
            One could add to
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
            a version of excluded middle called the
            = succeed "," do
              %strong sharp law of excluded middle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Ξ
                      %mo{:stretchy => "false"} |
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Ξ
                      %mo{:stretchy => "false"} |
                      %mi Γ
                      %mo ⊢
                      %mi p
                      %mo :
                      %mi{:mathvariant => "normal"} isProp
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi Ξ
                      %mo{:stretchy => "false"} |
                      %mi Γ
                      %mo ⊢
                      %msup
                        %mi{:mathvariant => "normal"} lem
                        %mo ♯
                      %mo :
                      %mo ♯
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ∨
                      %mo ¬
                      %mi P
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Xi \vert \Gamma \vdash P \; \mathrm{type} \quad \Xi \vert \Gamma \vdash p:\mathrm{isProp}(P)}{\Xi \vert \Gamma \vdash \mathrm{lem}^\sharp:\sharp(P \vee \neg P)}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∨
                  %mi B
                  %mo ≔
                  %mrow
                    %mo [
                    %mi A
                    %mo +
                    %mi B
                    %mo ]
                %annotation{:encoding => "application/x-tex"} A \vee B \coloneqq \left[A + B\right]
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi A
                    %mo ≔
                    %mi A
                    %mo →
                    %mi 𝟘
                  %annotation{:encoding => "application/x-tex"} \neg A \coloneqq A \to \mathbb{0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ♯
                  %mi A
                %annotation{:encoding => "application/x-tex"} \sharp A
            is the
            %a.existingWikiWord{:href => "/nlab/show/sharp+modality"} sharp modality
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %mi A
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \left[A\right]
            is the
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝟘
                %annotation{:encoding => "application/x-tex"} \mathbb{0}
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/empty+type"} empty type
