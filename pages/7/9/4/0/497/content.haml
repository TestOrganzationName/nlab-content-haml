                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{lem}:\Pi P.\mathrm{isProp}(P) \to \mathrm{isContr}(P + \neg P)}
