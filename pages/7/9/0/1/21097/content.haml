          %title Transveral Dp-D(p+2)-brane intersections in fuzzy funnels
          %h3#transveral_dpdp2brane_intersections_in_fuzzy_funnels Transveral Dp-D(p+2)-brane intersections in fuzzy funnels
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/boundary+condition"} boundary condition
            in the
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+DBI+model"} nonabelian DBI model
            of
            %a.existingWikiWord{:href => "/nlab/show/coincident+brane"} coincident
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} Dp-branes
            describing their transversal
            %a.existingWikiWord{:href => "/nlab/show/intersecting+branes"} intersection/ending
            %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B2%29-brane+bound+states"} with/on D(p+2)-branes
            is controled by
            %a.existingWikiWord{:href => "/nlab/show/Nahm%27s+equation"} Nahm's equation
            and thus exhibits the
            = succeed "-locus" do
              %a.existingWikiWord{:href => "/nlab/show/intersecting+branes"} brane intersection
          %ol
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnel"} fuzzy funnel
                %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
                interpolating between the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} D
                        %mi p
                      %annotation{:encoding => "application/x-tex"} \mathrm{D}p
                = succeed "-brane" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} D
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{D}(p+2)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+engineering+of+QFT"} geometric engineering
                of
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+monopoles"} Yang-Mills monopoles
                in the
                = succeed "-theory" do
                  %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
                = succeed "-branes." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D(p+2)
          %p
            (
            %a{:href => "Dp-Dpplus2-brane+bound_state#Diaconescu97"}> Diaconescu 97
            ,
            = succeed "," do
              %a{:href => "Dp-Dpplus2-brane+bound+state#ConstableMyers99"} Constable-Myers-Fafjord 99
            = succeed "," do
              %a{:href => "Dp-Dpplus2-brane+bound+state#HananyZaffaroni99"} Hanany-Zaffaroni 99
            = succeed "," do
              %a{:href => "Dp-Dpplus2-brane+bound+state#GaiottoWitten08"} Gaiotto-Witten 08, Section 2.4
            = succeed "," do
              %a{:href => "Dp-Dpplus2-brane+bound+state#HLPY08"} HLPY 08
            = succeed ")" do
              %a{:href => "Dp-Dpplus2-brane+bound+state#GZZ09"} GZZ 09
          %p
            More explicitly, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} y \in (0,\infty ]
            the transversal distance along the stack of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            = succeed "-branes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} D
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathrm{D}p
            = succeed "-brane," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} D
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{D}(p+2)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi i
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mphantom
                    %mi AAA
                  %mi i
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  X^i \in C^\infty\big( (0,\infty], \mathfrak{u}(N) \big)
                  \\phantom{AAA}
                  i \in \{1,2,3\}
          %p
            the three scalar fields on the worldvolume, the
            %a.existingWikiWord{:href => "/nlab/show/boundary+condition"} boundary condition
            is:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mi d
                    %mrow
                      %mi d
                      %mi y
                  %msup
                    %mi X
                    %mn 3
                  %mo +
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mn 1
                  %mo ,
                  %msup
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mi d
                    %mrow
                      %mi d
                      %mi y
                  %msup
                    %mi X
                    %mn 1
                  %mo +
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mn 2
                  %mo ,
                  %msup
                    %mi X
                    %mn 3
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mi d
                    %mrow
                      %mi d
                      %mi y
                  %msup
                    %mi X
                    %mn 2
                  %mo +
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi X
                    %mn 3
                  %mo ,
                  %msup
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\frac{d}{d y}
                  X^3
                  +
                  [X^1, X^2]
                  \\;=\;
                  0
                  \\,,
                  \\;\;\;
                  \\frac{d}{d y}
                  X^1
                  +
                  [X^2, X^3]
                  \\;=\;
                  0
                  \\,,
                  \\;\;\;
                  \\frac{d}{d y}
                  X^2
                  +
                  [X^3, X^1]
                  \\;=\;
                  0
          %p
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} y \to 0
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Nahm%27s+equations"} Nahm's equations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mi y
                  %msup
                    %mi ρ
                    %mi i
                  %mo +
                  %mtext non-singular
                %annotation{:encoding => "application/x-tex"}
                  X^i(y) = \frac{1}{y} \rho^i + \text{non-singular}
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔰𝔲
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\colon\; \mathfrak{su}(2) \longrightarrow \mathfrak{u}(N)
          %p
            is a Lie algebra homomorphism from
            %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unitary+Lie+algebra"} unitary Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ρ
                    %mi i
                  %mo ≔
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi σ
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\rho^i \coloneqq \rho(\sigma^i)
          %p
            is its complex-linear combination of values on the canonical
            %a.existingWikiWord{:href => "/nlab/show/Pauli+matrix"} Pauli matrix
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} basis
          %div{:style => "float:right;margin:0 10px 10px 0;"}
            %img{:src => "https://ncatlab.org/nlab/files/FuzzyFunnelFromChordDiagram.jpg", :width => "420"}/
          %p#FuzzyFunnelEmerges
            Equivalently.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            %a.existingWikiWord{:href => "/nlab/show/reducible+representation"} reducible
            as a
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of
            %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi N
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 5
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{N}^{(M5)}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi N
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mn 5
                        %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N^{(M5)} \in \mathbb{N}
          #eq:rhoAsADirectSumOfsu2Irreps.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                    %mi i
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msubsup
                    %mi N
                    %mi i
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo ⋅
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                    %mi i
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mn 5
                      %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\rho
                  \\;\simeq\;
                  \\underset{
                  i
                  }{\bigoplus}
                  \\big(
                  N_i^{(M2)}
                  \\cdot
                  \\mathbf{N}_i^{(M5)}
                  \\big)
                  \\,.
          %p
            (Here the notation follows the discussion at
            = succeed "," do
              %em
                %a{:href => "BMN+matrix+model#M2M5BraneBoundStatesInTheBMNMatrixModel"} M2/M5-brane bound states in the BMN model
            %a.existingWikiWord{:href => "/nlab/show/duality+between+M-theory+and+type+IIA+string+theory"} M-theory lift
            of the present situation).
          %p
            Now each
            %a.existingWikiWord{:href => "/nlab/show/irrep"} irrep
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi N
                    %mi i
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mn 5
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{N}_i^{(M5)}
            may be interpreted as a
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-sphere"} fuzzy 2-sphere
            of
            %a.existingWikiWord{:href => "/nlab/show/radius"} radius
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∝
                    %msqrt
                      %mrow
                        %msup
                          %mrow
                            %mo (
                            %msubsup
                              %mi N
                              %mi i
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi M
                                %mn 5
                                %mo{:stretchy => "false"} )
                            %mo )
                          %mn 2
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \propto \sqrt{ \left( N_i^{(M5)}\right)^2 - 1 }
            %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnel"} fuzzy funnel
            at given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} y = \epsilon
            %a.maruku-eqref{:href => "#eq:rhoAsADirectSumOfsu2Irreps"} (1)
            represents a system of concentric
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+2-spheres"} fuzzy 2-spheres
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fuzzy+funnels"} fuzzy funnels
          %blockquote
            %p
              graphics from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %p
            %br/
          %p
            Moreover, since the
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            of
            %a.existingWikiWord{:href => "/nlab/show/su%282%29"} su(2)
            is the
            %a.existingWikiWord{:href => "/nlab/show/sl%282%29"} complex special linear Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔩
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
            (
            %a{:href => "su2#Complexification"}> here
            ) the solutions to the boundary conditions are also identified with
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔩
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{sl}(2,\mathbb{C})
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representations"} Lie algebra representations
          #eq:RhoAsAnsl2Rep.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi 𝔰𝔩
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mi Rep
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\in\; \mathfrak{sl}(2,\mathbb{C}) Rep
                  \\,.
          %p
            %br/
          %p This is what many authors state, but it is not yet the full picture:
          %p#ParallelCPField
            Also the worldvolume
            %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
            component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            participates in the brane intersection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi 𝔲
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  A \in C^\infty\big( (0,\infty], \mathfrak{u}(N) \big)
          %p its boundary condition being that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %msup
                    %mi X
                    %mi i
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mphantom
                    %mi AAAA
                  %mtext for all
                  %mspace{:width => "thickmathspace"}
                  %mi i
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  [A, X^i] \;=\; 0
                  \\phantom{AAAA}
                  \\text{for all}\; i \in \{1,2,3\}
          %p
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} y \to 0
            (
            %a{:href => "Dp-Dpplus2-brane+bound+state#ConstableMyers99"}> Constable-Myers 99, Section 3.3
            ,
            = succeed "," do
              %a{:href => "Dp-Dpplus2-brane+bound+state#ThomasWard06"} Thomas-Ward 06, p. 16
            = succeed ")" do
              %a{:href => "Dp-Dpplus2-brane+bound+state#GaiottoWitten08"} Gaiotto-Witten 08, Section 3.1.1
          %p
            Together with
            %a.maruku-eqref{:href => "#eq:RhoAsAnsl2Rep"} (2)
            this means that the quadruple of fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mn 1
                  %mo ,
                  %msup
                    %mi X
                    %mn 2
                  %mo ,
                  %msup
                    %mi X
                    %mn 3
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X^1,X^2,X^3,A)
            constitutes a
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
            of the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+Lie+algebra"} general linear Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤𝔩
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %munder
                      %mrow
                        %mi 𝔰𝔩
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                      %mo ⏟
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msup
                        %mi X
                        %mn 1
                      %mo ,
                      %msup
                        %mi X
                        %mn 2
                      %mo ,
                      %msup
                        %mi X
                        %mn 3
                      %mo{:stretchy => "false"} ⟩
                  %mo ⊕
                  %munder
                    %munder
                      %mi ℂ
                      %mo ⏟
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi A
                      %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{gl}(2,\mathbb{C})
                  \\;\simeq\;
                  \\underset{
                  \\langle
                  X^1, X^2, X^3
                  \\rangle
                  }{
                  \\underbrace{
                  \\mathfrak{sl}(2,\mathbb{C})
                  }
                  }
                  \\oplus
                  \\underset{
                  \\langle A \rangle
                  }{
                  \\underbrace{
                  \\mathbb{C}
                  }
                  }
          %p
            This makes little difference as far as bare
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representations"} Lie algebra representations
            are concerned, but it does make a crucial difference when these are regarded as
            %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representations"} metric Lie representations
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/metric+Lie+algebras"} metric Lie algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤𝔩
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{gl}(2,\mathbb{C})
            admits further invariant metrics…
          %p
            %br/
