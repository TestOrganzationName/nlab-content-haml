                      %mo ,
                      %mi 𝔅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} EF_\omega(\mathfrak{A},\mathfrak{B})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
