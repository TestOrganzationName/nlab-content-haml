                    %annotation{:encoding => "application/x-tex"} i\lt\omega
          #CantorThm.num_example
            %h6#corollary Corollary
            %p
              %strong (Cantor’s Theorem)
              Any two countable
              %a.existingWikiWord{:href => "/nlab/show/DLO"} dense linear orders without endpoints
              are isomorphic. A back-and-forth system is given by the pairs of finite sequences of isomorphic finite suborders.
          %h2#unnested_ehrenfeuchtfrass_games Unnested Ehrenfeucht-Fraïssé games
          %p One major application of Ehrenfeucht-Fraïssé games is to study elementary equivalence. For languages without (non-constant) function symbols, however, we need a slight modification to the above definitions.
          %p
            The
            = succeed "," do
              %strong
                unnested Ehrenfeucht-Fraïssé game of length
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔄
                    %annotation{:encoding => "application/x-tex"} \mathfrak{A}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"} \mathfrak{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi EF
                    %mi γ
                  %mo{:stretchy => "false"} [
                  %mi 𝔄
                  %mo ,
                  %mi 𝔅
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} EF_\gamma[\mathfrak{A},\mathfrak{B}]
            is played exactly like
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi EF
                      %mi γ
                    %mo{:stretchy => "false"} (
                    %mi 𝔄
                    %mo ,
                    %mi 𝔅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} EF_\gamma(\mathfrak{A},\mathfrak{B})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} ¯
                  %mo ,
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\bar a,\bar b)
            counts as a
            %strong win for the duplicator
            if and only
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔄
                  %mo ,
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\mathfrak{A},\bar
                  a)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝔅
                  %mo ,
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathfrak{B},\bar b)
            satisfy the same
            %strong unnested
            atomic formulas.
          %p
            Recall that an
            %strong unnested atomic formula
            for a first-order language of one of the following forms:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x = y
                for variables
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi c
                    %annotation{:encoding => "application/x-tex"} x = c
                for variable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and constant symbol
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x = f(\bar y)
                for variables
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar y
                and function symbol
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R(\bar x)
                for variables
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar x
                and relation symbol
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
          %p
            Any atomic formula is equivalent to a
            = succeed "-formula" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
          #DefEFunnested.num_example
            %h6#definition_3 Definition
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msub
                      %mo ≈
                      %mi γ
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A} \approx_\gamma \mathfrak{B}
              to mean that the duplicator has a winning strategy in the game
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi EF
                        %mi γ
                      %mo{:stretchy => "false"} [
                      %mi 𝔄
                      %mo ,
                      %mi 𝔅
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} EF_\gamma[\mathfrak{A},\mathfrak{B}]
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔄
                  %msub
                    %mo ∼
                    %mi γ
                  %mi 𝔅
                %annotation{:encoding => "application/x-tex"} \mathfrak{A} \sim_\gamma \mathfrak{B}
            implies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔄
                  %msub
                    %mo ≈
                    %mi γ
                  %mi 𝔅
                %annotation{:encoding => "application/x-tex"} \mathfrak{A} \approx_\gamma \mathfrak{B}
            and the converse holds whenever the language has no constant and function symbols (as in that case every atomic formula is automatically unnested).
          %p The key reason to introduce the unnested formulas and games is the following theorem:
          #FraisseHintikka.num_example
            %h6#theorem_2 Theorem
            %p
              %strong (Fraïssé-Hintikka theorem)
              Suppose the language
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              has finitely many symbols. Then we can effectively find for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ,
                    %mi n
                    %mo &lt;
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} k,n\lt\omega
              a finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                  %annotation{:encoding => "application/x-tex"} \Theta_{n,k}
              of unnested formulas in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              free variables of quantifier rank at most
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %ul
              %li
                %p
                  for every
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔄
                        %annotation{:encoding => "application/x-tex"} \mathfrak{A}
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ,
                          %mi n
                          %mo &lt;
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} k,n\lt\omega
                  = succeed "-tuples" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} \bar a
                  from
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔄
                        %annotation{:encoding => "application/x-tex"} \mathfrak{A}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} \theta
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Θ
                          %mrow
                            %mi n
                            %mo ,
                            %mi k
                      %annotation{:encoding => "application/x-tex"} \Theta_{n,k}
                  with
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi 𝔄
                          %mo ,
                          %mover
                            %mi a
                            %mo{:stretchy => "false"} ¯
                          %mo{:stretchy => "false"} )
                          %mo ⊨
                          %mi θ
                        %annotation{:encoding => "application/x-tex"}
                          (\mathfrak{A},\bar a)
                          \\vDash \theta
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                        %mo &lt;
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} k,n\lt\omega
                  and all
                  = succeed "-structures" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔄
                      %annotation{:encoding => "application/x-tex"} \mathfrak{A}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔅
                      %annotation{:encoding => "application/x-tex"} \mathfrak{B}
                  and corresponding
                  = succeed "-tuples" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} \bar a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi b
                          %mo{:stretchy => "false"} ¯
                      %annotation{:encoding => "application/x-tex"} \bar b
                  we have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝔄
                        %mo ,
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ≈
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi 𝔅
                        %mo ,
                        %mover
                          %mi b
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathfrak{A},\bar a) \approx_k (\mathfrak{B},\bar b)
                  if and only if there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mo ∈
                        %msub
                          %mi Θ
                          %mrow
                            %mi n
                            %mo ,
                            %mi k
                      %annotation{:encoding => "application/x-tex"} \theta\in\Theta_{n,k}
                  satisfied by both
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝔄
                        %mo ,
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathfrak{A},\bar a)
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi 𝔅
                          %mo ,
                          %mover
                            %mi b
                            %mo{:stretchy => "false"} ¯
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\mathfrak{B},\bar b)
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                        %mo &lt;
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} k,n\lt\omega
                  it holds that every unnested formula in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  free variables of quantifier rank at most
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  is equivalent to a disjunction of formulas in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Θ
                            %mrow
                              %mi n
                              %mo ,
                              %mi k
                        %annotation{:encoding => "application/x-tex"} \Theta_{n,k}
          %p
            This appears as Theorem 3.3.2 in
            = succeed "." do
              %a{:href => "#Hodges93"} Hodges 93
          #FraisseTheorem.num_example
            %h6#corollary_2 Corollary
            %p
              %strong (Fraïssé‘s theorem)
              Two structures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{B}
              in a finite language are elementarily equivalent,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔄
                      %mo ≡
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"} \mathfrak{A} \equiv \mathfrak{B}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &lt;
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} k\lt\omega
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔄
                      %msub
                        %mo ≈
                        %mi k
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"} \mathfrak{A} \approx_k \mathfrak{B}
          %h2#dynamic_ehrenfeuchtfrass_games Dynamic Ehrenfeucht-Fraïssé games
          %p
            The condition occurring in Fraïssé‘s theorem, that for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &lt;
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} k\lt\omega
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msub
                      %mo ≈
                      %mi k
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A} \approx_k \mathfrak{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            to be the length of the game, we can let an ordinal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            be part of the playing field, so to speak, indicating in a sense how many times the spoiler can change his mind about the length of the game, yet keeping the game finite.
          %p
            More precisely, we define the
            = succeed "," do
              %strong
                dynamic Ehrenfeucht-Fraïssé game measured by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔄
                    %annotation{:encoding => "application/x-tex"} \mathfrak{A}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"} \mathfrak{B}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi EFD
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mi 𝔄
                    %mo ,
                    %mi 𝔅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} EFD_\alpha(\mathfrak{A},\mathfrak{B})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            as follows:
          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \alpha=0
                there is a unique play (i.e., the players do nothing) that is a win for the duplicator if and only if
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔄
                        %msub
                          %mo ≡
                          %mn 0
                        %mi 𝔅
                      %annotation{:encoding => "application/x-tex"}
                        \\mathfrak{A}
                        \\equiv_0 \mathfrak{B}
            %li
              %p
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo =
                        %mi β
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \alpha=\beta+1
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi EFD
                          %mi β
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi 𝔄
                        %mo ,
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi 𝔅
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} EFD_\beta((\mathfrak{A},a),(\mathfrak{B},b))
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a\in A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b\in B
                are the two elements picked, and this play in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi EFD
                        %mi α
                      %mo{:stretchy => "false"} (
                      %mi 𝔄
                      %mo ,
                      %mi 𝔅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} EFD_\alpha(\mathfrak{A},\mathfrak{B})
                is a win for duplicator if and only if the play in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi EFD
                        %mi β
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi 𝔄
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi 𝔅
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} EFD_\beta((\mathfrak{A},a),(\mathfrak{B},b))
                is a win for duplicator,
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                a limit ordinal, a play consists of the spoiler picking an ordinal
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo &lt;
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \beta\lt\alpha
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi EFD
                          %mi β
                        %mo{:stretchy => "false"} (
                        %mi 𝔄
                        %mo ,
                        %mi 𝔅
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} EFD_\beta(\mathfrak{A},\mathfrak{B})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi EFD
                        %mi α
                      %mo{:stretchy => "false"} (
                      %mi 𝔄
                      %mo ,
                      %mi 𝔅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} EFD_\alpha(\mathfrak{A},\mathfrak{B})
                is a win for duplicator if and only if the play in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi EFD
                        %mi β
                      %mo{:stretchy => "false"} (
                      %mi 𝔄
                      %mo ,
                      %mi 𝔅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} EFD_\beta(\mathfrak{A},\mathfrak{B})
                is a win for duplicator.
          %p
            The game
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi EFD
                    %mi α
                  %mo{:stretchy => "false"} [
                  %mi 𝔄
                  %mo ,
                  %mi 𝔅
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} EFD_\alpha[\mathfrak{A},\mathfrak{B}]
            is defined similarly, using unnested atomic formulas in the base case.
          #DefEFD.num_example
            %h6#definition_4 Definition
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msubsup
                      %mo ∼
                      %mi ω
                      %mi α
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A} \sim^\alpha_\omega \mathfrak{B}
              to mean that the duplicator has a winning strategy in the game
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi EFD
                      %mi α
                    %mo{:stretchy => "false"} (
                    %mi 𝔄
                    %mo ,
                    %mi 𝔅
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} EFD_\alpha(\mathfrak{A},\mathfrak{B})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msubsup
                      %mo ≈
                      %mi ω
                      %mi α
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{A}
                    \\approx^\alpha_\omega \mathfrak{B}
              to mean that the duplicator has a winning strategy in the game
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi EFD
                        %mi α
                      %mo{:stretchy => "false"} [
                      %mi 𝔄
                      %mo ,
                      %mi 𝔅
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} EFD_\alpha[\mathfrak{A},\mathfrak{B}]
          %p
            We use a subscript
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            to indicate that the relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msubsup
                      %mo ∼
                      %mi ω
                      %mi α
                %annotation{:encoding => "application/x-tex"} {\sim^\alpha_\omega}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msubsup
                      %mo ≈
                      %mi ω
                      %mi α
                %annotation{:encoding => "application/x-tex"} {\approx^\alpha_\omega}
            form approximations to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msub
                      %mo ∼
                      %mi ω
                %annotation{:encoding => "application/x-tex"} {\sim_\omega}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %msub
                        %mo ≈
                        %mi ω
                  %annotation{:encoding => "application/x-tex"} {\approx_\omega}
          %h2#backandforth_sequences Back-and-forth sequences
          %p
            There is an alternative characterization of the relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msubsup
                      %mo ∼
                      %mi ω
                      %mi α
                %annotation{:encoding => "application/x-tex"} {\sim^\alpha_\omega}
            in terms of
            = succeed "." do
              %strong back-and-forth sequences
          %p
            We define a
            %strong
              back-and-forth sequence of length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{B}
            to be a sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi I
                    %mi β
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi β
                      %mo &lt;
                      %mi α
                %annotation{:encoding => "application/x-tex"} (I_\beta)_{\beta\lt\alpha}
            of inhabited sets of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} ¯
                  %mo ,
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (\bar a,\bar
                  b)
            of equal length sequences from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔄
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔅
                %annotation{:encoding => "application/x-tex"} \mathfrak{B}
            such that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi β
                      %mo ⊆
                      %msub
                        %mi I
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} I_\beta \subseteq I_\gamma
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo &lt;
                        %mi β
                        %mo &lt;
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \gamma\lt\beta\lt\alpha
            %li
              %p
                for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo &lt;
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \beta\lt\alpha
                and every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi a
                        %mo{:stretchy => "false"} ¯
                      %mo ,
                      %mover
                        %mi b
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi I
                        %mi β
                    %annotation{:encoding => "application/x-tex"} (\bar a,\bar b)\in I_\beta
                we have
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝔄
                        %mo ,
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ≡
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝔅
                        %mo ,
                        %mover
                          %mi b
                          %mo{:stretchy => "false"} ¯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathfrak{A},\bar a) \equiv_0 (\mathfrak{B},\bar b)
            %li
              %p
                for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo +
                      %mn 1
                      %mo &lt;
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \beta+1\lt\alpha
                and every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi a
                        %mo{:stretchy => "false"} ¯
                      %mo ,
                      %mover
                        %mi b
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi I
                        %mrow
                          %mi β
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      (\bar a,\bar b)\in
                      I_{\beta+1}
                and every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} a\in A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b\in B
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ¯
                        %mi a
                        %mo ,
                        %mover
                          %mi b
                          %mo{:stretchy => "false"} ¯
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi I
                          %mi β
                      %annotation{:encoding => "application/x-tex"} (\bar a a, \bar b b)\in I_\beta
            %li
              %p
                for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo +
                      %mn 1
                      %mo &lt;
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \beta+1\lt\alpha
                and every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi a
                        %mo{:stretchy => "false"} ¯
                      %mo ,
                      %mover
                        %mi b
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi I
                        %mrow
                          %mi β
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      (\bar a,\bar b)\in
                      I_{\beta+1}
                and every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi B
                      %annotation{:encoding => "application/x-tex"} b\in B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi a
                          %mo{:stretchy => "false"} ¯
                        %mi a
                        %mo ,
                        %mover
                          %mi b
                          %mo{:stretchy => "false"} ¯
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi I
                          %mi β
                      %annotation{:encoding => "application/x-tex"} (\bar a a, \bar b b)\in I_\beta
          #PropBFD.num_example
            %h6#proposition_2 Proposition
            %p
              There is a back-and-forth sequence of length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{B}
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔄
                      %msubsup
                        %mo ∼
                        %mi ω
                        %mi α
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"}
                      \\mathfrak{A}
                      \\sim^\alpha_\omega \mathfrak{B}
          %p
            Clearly, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔄
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔅
                %annotation{:encoding => "application/x-tex"} \mathfrak{B}
            are back-and-forth equivalent, then we can make a back-and-forth sequences of any length by taking the constant sequence at a back-and-forth system.
          %h2#use_in_infinitary_logic Use in infinitary logic
          %p
            Recall that the formulas in the logic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mn ∞
                      %mi ω
                %annotation{:encoding => "application/x-tex"} L_{\infty\omega}
            can be built using infinitary disjunctions and conjunctions. We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔄
                  %msub
                    %mo ≡
                    %mrow
                      %mn ∞
                      %mi ω
                  %mi 𝔅
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{A}
                  \\equiv_{\infty\omega} \mathfrak{B}
            (resp.
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msubsup
                      %mo ≡
                      %mrow
                        %mn ∞
                        %mi ω
                      %mi α
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{A}
                    \\equiv_{\infty\omega}^\alpha \mathfrak{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔄
                %annotation{:encoding => "application/x-tex"} \mathfrak{A}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔅
                %annotation{:encoding => "application/x-tex"} \mathfrak{B}
            satisfy the same sentences of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mn ∞
                      %mi ω
                %annotation{:encoding => "application/x-tex"} L_{\infty\omega}
            (resp. of quantifier rank at most
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
          %p
            There is a close relationship between the expressivity of this infinitary logic and the relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msub
                      %mo ∼
                      %mi ω
                %annotation{:encoding => "application/x-tex"} {\sim_\omega}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %msubsup
                        %mo ∼
                        %mi ω
                        %mi α
                  %annotation{:encoding => "application/x-tex"} {\sim_\omega^\alpha}
          #KarpTheorem.num_example
            %h6#theorem_3 Theorem
            %p
              We have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msubsup
                      %mo ≡
                      %mrow
                        %mn ∞
                        %mi ω
                      %mi α
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A} \equiv_{\infty\omega}^\alpha \mathfrak{B}
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msubsup
                      %mo ∼
                      %mi ω
                      %mi α
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A} \sim_\omega^\alpha \mathfrak{B}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔄
                    %msub
                      %mo ≡
                      %mrow
                        %mn ∞
                        %mi ω
                    %mi 𝔅
                  %annotation{:encoding => "application/x-tex"} \mathfrak{A} \equiv_{\infty\omega} \mathfrak{B}
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔄
                      %msub
                        %mo ∼
                        %mi ω
                      %mi 𝔅
                    %annotation{:encoding => "application/x-tex"} \mathfrak{A} \sim_\omega \mathfrak{B}
          %p
            This is Theorem 4.47 and Proposition 7.48 in
            = succeed "." do
              %a{:href => "#Vaananen2011"} Väänänen 2011
