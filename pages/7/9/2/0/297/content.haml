          %p
            %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
