                  }
          %p
            A particle tracing out a circle is equivalently the composition (via
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
