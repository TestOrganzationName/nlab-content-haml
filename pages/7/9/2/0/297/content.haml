                    \&amp;&amp; (\mathbf{B}G)^I_\bullet &amp;\underset{(ev_0)_\bullet}{\to}&amp; (\mathbf{B}G)_\bullet
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{(ev_1)_\bullet}}
                    \\\
                    X_\bullet &amp;\underset{}{\to}&amp; (\mathbf{B}G)_\bullet
                    }
                    \\,.
            %p
              (This is the first example of the more general phenomenon of
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/universal+principal+infinity-bundles"} universal principal infinity-bundles
          #LoopSpaceGroupoid.num_example
            %h6#example_11 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \ast \to X
              a point in it, we call
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mi X
                    %mo ≔
                    %mo *
                    %munder
                      %mo ×
                      %mi X
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega X
                    \\coloneqq
                    \\ast \underset{X}{\times} \ast
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a group and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              groupoid from example
              = succeed "," do
                %a.maruku-ref{:href => "#DeloopingGroupoid"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≃
                    %mi Ω
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo =
                    %mo *
                    %munder
