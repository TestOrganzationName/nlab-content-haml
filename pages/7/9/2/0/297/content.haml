          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
              %ul
                %li
                  %p
                    %strong FQFT
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/unitary+functorial+field+theory"} unitary functorial field theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/TQFT"}> TQFT
                        ,
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/extended+topological+quantum+field+theory"}> extended topological quantum field theory
                            ,
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/0-dimensional+TQFT"}> 0-dimensional TQFT
                            ,
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/2d+TQFT"}> 2d TQFT
                            ,
                            %a.existingWikiWord{:href => "/nlab/show/3d+TQFT"} 3d TQFT
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/4d+TQFT"} 4d TQFT
                        %li
                          %p
