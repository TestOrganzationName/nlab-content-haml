                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields} \underset{[\Pi(S^n)]}{\times} \mathbf{Fields}
                  \\simeq
                  [\Pi(S^{n+1}), \mathbf{Fields}]
          %p
            and in fact all
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            %a.existingWikiWord{:href => "/nlab/show/trinion"} trinion
            process is represented by this correspondence-of-correspondences:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
