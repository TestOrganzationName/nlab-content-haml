                        %mn 1
                      %mo ,
                      %msub
                        %mi t
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi t
                            %mn 1
                      %mo →
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi t
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} U(t_1,t_2) \colon V_{t_1} \to V_{t_2}
                to be thought of as encoding the
                %a.existingWikiWord{:href => "/nlab/show/time"} time
                evolution of quantum states
          %p such that
          %ul
            %li
              %p
                this assignment is
                %em local
                in
                %a.existingWikiWord{:href => "/nlab/show/time"} time
                in that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mn 1
                      %mo ≤
                      %msub
                        %mi t
                        %mn 2
                      %mo ≤
                      %msub
                        %mi t
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} t_1 \leq t_2 \leq t_3
                one has
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 1
                      %mo ,
                      %msub
                        %mi t
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 2
                      %mo ,
                      %msub
                        %mi t
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi U
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mn 1
                      %mo ,
                      %msub
                        %mi t
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      U(t_1, t_3) = U(t_2, t_3) \circ U(t_1, t_2)
                      \\,.
          %p In basic quantum mechanics one also demands that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi id
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U(t,t) = id
                  \\,.
          %p
            (While this looks like the most innocent condition, this has technical subtleties for genuine
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
          %p
            The locality condition intuitively says that “all global effects arise by integrating up local effects”. Indeed, when assuming in addition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(-,-)
            depends
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smoothly
            on the time arguments, then the locality condition is equivalent to (see at
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi t
                  %annotation{:encoding => "application/x-tex"} H_t
            %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"} self-adjoint operator
            depending smoothly on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %a.existingWikiWord{:href => "/nlab/show/Dyson+formula"} Dyson formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi P
                  %mi exp
                  %mrow
                    %mo (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mi ℏ
                    %msubsup
                      %mo ∫
                      %mrow
                        %msub
                          %mi t
                          %mn 1
                      %mrow
                        %msub
                          %mi t
                          %mn 2
                    %msub
                      %mi H
                      %mi t
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi t
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U(t_1,t_2)
                  \=
                  P \exp\left(
                  \\tfrac{i}{\hbar} \int_{t_1}^{t_2}  H_t \, d t
                  \\right)
                  \\,.
          %p
            (Here the notation on the right denotes the “path ordered exponential”, see at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %msub
                      %mi H
                      %mi t
                  %annotation{:encoding => "application/x-tex"} H = H_t
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %msub
                    %mi t
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mrow
                    %mo (
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mi i
                        %mi ℏ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo −
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi H
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  U(t_1,t_2)
                  \=
                  \\exp\left(
                  \\tfrac{i}{\hbar} (t_2 - t_1) H
                  \\right)
                  \\,.
          %p This is the way that quantum mechanical time evolution is traditionally introduced in the textbooks.
          %p
            But the equivalent formulation above in terms of locality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(-,-)
            is noteworthy. The condition of locality here is precisely what in
            %a.existingWikiWord{:href => "/nlab/show/mathematics"} mathematics
            is called
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            (here: linear/unitary operator) depends on another system of “directed data” (here: the time intervals
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [t_1,t_2]
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            is respected.
          %p
            More specifically, one says that the collection
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Hilb"} Hilb
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            (
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"}> Hilbert spaces
            ) forms a
            %em
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %em
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are vector spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and whose
            %em
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are linear maps
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi V
                      %mn 1
                    %mo →
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon V_1 \to V_2
            %a.existingWikiWord{:href => "/nlab/show/associativity"} associatively
            composed whenever their
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            matches:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi V
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mn 1
                          %mo ↗
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi f
                                  %mn 2
                      %mtr
                        %mtd
                          %msub
                            %mi V
                            %mn 1
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi f
                                %mn 2
                              %mo ∘
                              %msub
                                %mi f
                                %mn 1
                        %mtd
                        %mtd
                          %msub
                            %mi V
                            %mn 3
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; V_2
                  \\\
                  \&amp; {}^{\mathllap{f_1}}\nearrow &amp;&amp; \searrow^{\mathrlap{f_2}}
                  \\\
                  V_1 &amp;&amp; \stackrel{f_2 \circ f_1}{\longrightarrow} &amp;&amp; V_3
                  }
                  \\,.
          %p
            Similarly, there is a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mn 1
                    %mi Riem
                %annotation{:encoding => "application/x-tex"} Bord_1^{Riem}
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are instants of time
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} t \in \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are time intervals
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [t_1,t_2]
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            operation is concatenation of time intervals
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi t
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %msub
                            %mi t
                            %mn 1
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                        %mtd
                        %mtd
                          %msub
                            %mi t
                            %mn 3
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; t_2
                  \\\
                  \&amp; \nearrow &amp;&amp; \searrow
                  \\\
                  t_1 &amp;&amp; \stackrel{}{\longrightarrow} &amp;&amp; t_3
                  }
          %p
            Given two categories like this, then a function that takes morphisms of one to morphisms of the other such that
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            is respected is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          %p
            In this language, the above locality condition of
            %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
            says that quantum time evolution is a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi Bord
                    %mn 1
                    %mi Riem
                  %mo ⟶
                  %mi Vect
                %annotation{:encoding => "application/x-tex"}
                  U \;\colon\; Bord_1^{Riem} \longrightarrow Vect
          %p that takes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi t
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %msub
                            %mi t
                            %mn 1
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                        %mtd
                        %mtd
                          %msub
                            %mi t
                            %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi V
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi t
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi t
                                  %mn 2
                                %mo{:stretchy => "false"} )
                          %mo ↗
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mrow
                                %mi U
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi t
                                  %mn 2
                                %mo ,
                                %msub
                                  %mi t
                                  %mn 3
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msub
                            %mi V
                            %mn 1
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mi U
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi t
                                %mn 1
                              %mo ,
                              %msub
                                %mi t
                                %mn 3
                              %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                          %msub
                            %mi V
                            %mn 3
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; t_2
                  \\\
                  \&amp; \nearrow &amp;&amp; \searrow
                  \\\
                  t_1 &amp;&amp; \stackrel{}{\longrightarrow} &amp;&amp; t_3
                  }
                  \\;\;\;\;\;\;
                  \\mapsto
                  \\;\;\;\;\;\;
                  \\array{
                  \&amp;&amp; V_2
                  \\\
                  \&amp; {}^{\mathllap{U(t_1,t_2)}}\nearrow &amp;&amp; \searrow^{\mathrlap{U(t_2,t_3)}}
                  \\\
                  V_1 &amp;&amp; \stackrel{U(t_1,t_3)}{\longrightarrow} &amp;&amp; V_3
                  }
          %p
            If this looks like a trivial reformulation of textbook material, then this is because it is a trivial reformulation of textbook material. But introducing such category-theoretic language for making the locality principle in quantum mechanics fully manifest turns out to be rather useful for capturing the full locality of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+quantum+field+theory"} local quantum field theory
          %table
            %thead
              %tr
                %th
