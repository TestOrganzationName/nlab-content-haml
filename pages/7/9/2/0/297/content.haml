                    \\\
                    \\mathbf{B}\flat U(1)
                    }
                    \\right]
                    \\in Span_1(Grpd,\mathbf{B}\flat U(1))
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
