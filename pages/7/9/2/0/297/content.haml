                  \\\
                  \\ast &amp;&amp; \mathbf{Fields} &amp;&amp; \ast
                  \\\
                  \&amp; \nwarrow &amp;\downarrow&amp; \nearrow
                  \\\
                  \&amp;&amp; \ast
                  }
          %p and disappear
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
