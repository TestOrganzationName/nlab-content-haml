                  \\end{svg}}
                  \\right\}
                  }
          %p in particular
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} (∞,n)-category of cobordisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Bord
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Bord_n
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+correspondences"} (∞,n)-category of correspondences
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Corr
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Corr_n
            %li
              %p
                %span.newWikiWord
                  (∞,n)-category of (∞,n)-modules
                  %a{:href => "/nlab/new/%28%E2%88%9E%2Cn%29-category+of+%28%E2%88%9E%2Cn%29-modules"} ?
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Mod
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Mod_n
          %h4#spaces_of_states_and_the_cobordism_hypothesis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-Spaces of states and the Cobordism hypothesis
          %p
            These
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories"} (∞,n)-categories
            are
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-categories"} symmetric monoidal (∞,n)-categories
            in the same way that their 1-categorical shadows are, only that everything is lifted up to homotopy.
          %p hence one may consider
          %p
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2Cn%29-functors"} monoidal (∞,n)-functors
          %p
            %a.existingWikiWord{:href => "/schreiber/show/Local+prequantum+field+theory"} Local prequantum field theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mi n
                    %mo ⊔
                  %mo ⟶
                  %msub
                    %mi Corr
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Phases
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mo ⊗
                        %mi phased
                %annotation{:encoding => "application/x-tex"}
                  Bord_n^\sqcup
                  \\longrightarrow
                  Corr_n(\mathbf{H}_{/Phases})^{\otimes_{phased}}
          %p
            %a.existingWikiWord{:href => "/nlab/show/local+quantum+field+theory"} local quantum field theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mi n
                    %mo ⊔
                  %mo ⟶
                  %msubsup
                    %mi Mod
                    %mi n
                    %mo ⊗
                %annotation{:encoding => "application/x-tex"}
                  Bord_n^\sqcup \longrightarrow Mod_n^\otimes
          %p
            The classification theory of these, the
            %em
              %a.existingWikiWord{:href => "/nlab/show/cobordism+theorem"} cobordism theorem
            says roughly that such local topological field theories assign
            %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+objects"} fully dualizable objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            to the point and are entirely determined by this assignment in that every higher dimensional manifold is sent to the
            %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+trace"} higher dimensional trace
            on the identity on that object, i.e. the higher codimension analogs of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ↦
                  %msub
                    %mi tr
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi id
                    %mi V
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma \mapsto tr_\Sigma(id_V)
                  \\,.
          %p (…)
          %h3#Global3dTQFT 3d TQFT
          %h4#chernsimons_theory Chern-Simons theory
