                    }
                    \\right]
                    \\,.
          .num_remark
            %h6#remark_5 Remark
            %p
              There is an evident
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-functor"} (2,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Span
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Span_1(Grpd, \mathbf{B}\flat U(1))
                    \\to
                    Span_1(Grpd)
            %p
              which forgets the maps to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\flat U(1)
              and the homotopies between them. This is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+%28infinity%2C1%29-functor"} monoidal (2,1)-functor
          %p
            As generalization of prop.
            %a.maruku-ref{:href => "#GroupoidInSpanOneIsSelfDual"}
            we now have the following:
          .num_prop
            %h6#proposition_5 Proposition
            %p Every object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
