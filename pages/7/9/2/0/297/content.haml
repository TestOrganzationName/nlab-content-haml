                    \\right]
            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
