                          %msup
                            %mi S
                            %mn 1
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %msup
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi Fields
                          %mo{:stretchy => "false"} ]
                        %mtd
