                  in the evident way.
            %p
              The operation of
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              is as in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Span
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Grpd
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Span_1(Grpd)
              %a.maruku-ref{:href => "#OneSpansInOneGroupoids"}
              on the upper part of these diagrams, naturally extended to the whole diagrams by composition of the
              %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
              filling the squares that appear.
          .num_prop
            %h6#proposition_4 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span_1(Grpd, \mathbf{B}\flat U(1))
              carries the structure of a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2Cn%29-category"} symmetric monoidal (2,1)-category
              where the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi f
                                      %mn 1
                          %mtr
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mo ♭
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %mo ]
                    %mo ⊗
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 2
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi f
                                      %mn 2
                          %mtr
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mo ♭
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %mo ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                              %mo ×
                              %msub
                                %mi X
                                %mn 2
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi f
                                      %mn 1
                                    %mo ∘
                                    %msub
                                      %mi p
                                      %mn 1
                                    %mo +
                                    %msub
                                      %mi f
                                      %mn 2
                                    %mo ∘
                                    %msub
                                      %mi p
                                      %mn 2
                          %mtr
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mo ♭
                              %mi U
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left[
                    \\array{
                    X_1
                    \\\
                    \\downarrow^{\mathrlap{f_1}}
                    \\\
                    \\mathbf{B}\flat U(1)
                    }
                    \\right]
                    \\otimes
                    \\left[
                    \\array{
                    X_2
                    \\\
                    \\downarrow^{\mathrlap{f_2}}
                    \\\
                    \\mathbf{B}\flat U(1)
                    }
                    \\right]
                    \\;\;
                    \\coloneqq
                    \\;\;
                    \\left[
                    \\array{
                    X_1 \times X_2
                    \\\
                    \\downarrow^{\mathrlap{f_1 \circ p_1 + f_2 \circ p_2}}
                    \\\
