                      %msup
                        %mi S
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo ≃
                  %mo{:stretchy => "false"} [
