              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              of its own
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
          .proof
            %h6#proof Proof
            %p
              We are to compute the ordinary limiting cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %munder
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mo •
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi G
                      %mi I
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %munder
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mo •
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast \underset{\mathbf{B}G_\bullet}{\times}  (\mathbf{B}G^I)_\bullet \underset{\mathbf{B}G_\bullet}{\times} \ast
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %msubsup
                              %mo{:stretchy => "false"} )
                              %mo •
                              %mi I
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ev
                                  %mn 0
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mo •
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi G
                              %mo •
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ev
                                    %mn 1
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo •
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %munder
                              %mo →
                              %mrow
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi G
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;\to&amp; &amp;\to&amp; \ast
                    \\\
                    \\downarrow &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{}}
                    \\\
                    \&amp;&amp; (\mathbf{B}G)^I_\bullet &amp;\underset{(ev_0)_\bullet}{\to}&amp; \mathbf{B}G_\bullet
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{(ev_1)_\bullet}}
                    \\\
                    \\ast &amp;\underset{}{\to}&amp; \mathbf{B}G_\bullet
                    }
                    \\,,
            %p
              In the middle we have the groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mo •
                      %mi I
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)^I_\bullet
              whose objects are elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and whose morphisms starting at some element are labeled by pairs of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 1
                    %mo ,
                    %msub
                      %mi h
                      %mn 2
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} h_1, h_2 \in G
              and end at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mn 1
                      %mo ⋅
                      %mi g
                      %mo ⋅
                      %msub
                        %mi h
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} h_1 \cdot g \cdot h_2
              %a.maruku-ref{:href => "#FiberProductsOfGroupoidsComponentwise"}
              the limiting cone is seen to precisely pick those morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mo •
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mo •
                      %mi I
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G_\bullet)^I_\bullet
              such that these two elements are constant on the neutral element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mn 1
                      %mo =
                      %msub
                        %mi h
                        %mn 2
                      %mo =
                      %mi e
                      %mo =
                      %msub
                        %mi id
                        %mo *
                    %annotation{:encoding => "application/x-tex"} h_1 = h_2 = e = id_{\ast}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              regarded as a groupoid with only identity morphisms, as in example
              = succeed "." do
                %a.maruku-ref{:href => "#SetAsGroupoid"}
          #FreeLoopSpaceOfGroupoid.num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi X
                    %munder
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} ]
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), X]
                    \\simeq
                    X \underset{[\Pi(S^0), X]}{\times}X
          .proof
            %h6#proof_2 Proof
            %p
              Notice that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo *
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \Pi_1(S^0) \simeq \ast \coprod \ast
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mo •
                      %mi I
                  %annotation{:encoding => "application/x-tex"} [\Pi(S^0), X_\bullet]^I_\bullet
              has
            %ul
              %li
                %p
                  objects are pairs of morphisms in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo •
                        %annotation{:encoding => "application/x-tex"} X_\bullet
              %li
                %p morphisms are commuting squares of such.
            %p
              Now the fiber product in def.
              %a.maruku-ref{:href => "#HomotopyFiberProductOfGroupoids"}
              picks in there those pairs of morphisms for which both start at the same object, and both end at the same object. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %munder
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo •
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mo •
                      %mi I
                    %munder
                      %mo ×
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi Π
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mo •
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_\bullet \underset{[\Pi(S^0), X_\bullet]_\bullet}{\times} [\Pi(S^0), X_\bullet]^I_\bullet \underset{[\Pi(S^0), X_\bullet]_\bullet}{\times} X
              is the groupoid whose
            %ul
              %li
                %p
                  objects are diagrams in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_\bullet
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mo ↗
                                %mo ↘
                            %mtr
                              %mtd
                                %msub
                                  %mi x
                                  %mn 0
                              %mtd
                              %mtd
                                %msub
                                  %mi x
                                  %mn 1
                            %mtr
                              %mtd
                              %mtd
                                %mo ↘
                                %mo ↗
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp; \nearrow \searrow
                        \\\
                        x_0 &amp;&amp; x_1
                        \\\
                        \&amp; \searrow \nearrow
                        }
              %li
                %p morphism are cylinder-diagrams over these.
            %p
              One finds along the lines of example
              %a.maruku-ref{:href => "#BZIsPiSOne"}
              that this is equivalent to maps from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(S^1)
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              and homotopies between these.
          .num_remark
            %h6#remark_4 Remark
            %p
              Even though all these models of the circle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(S^1)
              are equivalent, below the special appearance of the circle in the proof of prop.
              %a.maruku-ref{:href => "#FreeLoopSpaceOfGroupoid"}
              as the combination of two semi-circles will be important for the following proofs. As we see in a moment, this is the natural way in which the circle appears as the composition of an
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              with a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coevaluation+map"} coevaluation map
          #AdjointActionGroupoidFromFreeLoopSpaceObject.num_example
            %h6#example_12 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              of its
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} /
                        %mi ad
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G//_{ad} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              = succeed "," do
                %a.maruku-ref{:href => "#ActionGroupoid"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}G] \simeq G//_{ad} G
                    \\,.
          .num_example
            %h6#example_13 Example
            %p
              For an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \flat U(1)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}\flat U(1)]
                    \\simeq
                    \\flat U(1)//_{ad} \flat U(1)
                    \\simeq
                    (\flat U(1)) \times (\mathbf{B}\flat U(1))
                    \\,.
          #GroupCharacterAsClassFunctionByFreeLoopSpace.num_example
            %h6#example_14 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \colon G \to \flat U(1)
              be a group homomorphism, hence a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+character"} group character
              %a.maruku-ref{:href => "#DeloopingGroupoid"}
              this has a
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              to a groupoid homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}c \;\colon\; \mathbf{B}G \to \mathbf{B}\flat U(1)
                    \\,.
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
              construction this becomes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}c]
                    \\;\colon\;
                    [\Pi(S^1), \mathbf{B}G]
                    \\to
                    [\Pi(S^1), \mathbf{B}\flat U(1)]
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mi G
                    %mo →
                    %mo ♭
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}c]
                    \\;\colon\;
                    G//_{ad}G
                    \\to
                    \\flat U(1) \times \mathbf{B}U(1)
                    \\,.
            %p
              So by postcomposing with the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              on the first factor we recover from the general
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of groupoids the statement that a group character is a
              %a.existingWikiWord{:href => "/nlab/show/class+function"} class function
              on
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi c
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi ad
                    %mi G
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(S^1), \mathbf{B}c]
                    \\;\colon\;
                    G//_{ad}G
                    \\to
                    U(1)
                    \\,.
          %h4#CorrespondencesOfGroupoids Trajectories of fields and Correspondences of groupoids
          %p
            With some basic
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            in hand, we can now talk about
            %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            in finite gauge theories, namely about
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            of groupoids and their composition. These correspondences of groupoids encode
            = succeed "/histories" do
              %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field configurations
          %p
            Namely consider a groupoid to be called
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields} \in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            in some field theory, or equivalently and specifically as the
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            of a
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            field theory. This just means that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            any
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            thought of as
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}(\Sigma)
            of the field theory on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is the
            %a.existingWikiWord{:href => "/nlab/show/mapping+stack"} mapping stack
            (
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"}> internal hom
            ) from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
            = succeed "," do
              %a.maruku-ref{:href => "#MappingGroupoid"}
            = succeed "," do
              %a.maruku-ref{:href => "#FundamentalGroupoid"}
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}(\Sigma) = [\Pi_1(\Sigma), \mathbf{Fields}]
                  \\,.
          %p
            We think of the
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of the groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Pi_1(\Sigma), \mathbf{Fields}]
            as being the fields themselves, and of the
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            as being the
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
            between them.
          %p
            The example to be of interest in a moment is that where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields} = \mathbf{B}G
            is a
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            groupoid as in def.
            = succeed "," do
              %a.maruku-ref{:href => "#DeloopingGroupoid"}
            %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            = succeed "," do
              %a.maruku-ref{:href => "#DiscreteGroupoidIsDijointUnioonOfDeloopings"}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                  %annotation{:encoding => "application/x-tex"} \mathbf{Fields}
          %p
            The simple but crucial observation that shows why
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            of groupoids show up in prequantum field theory is the following.
          .num_example
            %h6#example_15 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
              with incoming
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mi in
                    %mo ↪
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma_{in} \hookrightarrow \Sigma
              and outgoing boundary components
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi out
                      %mo ↪
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma_{out} \hookrightarrow \Sigma
              %a.existingWikiWord{:href => "/nlab/show/cospan"} cospan
              of manifolds
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↖
                        %mtr
                          %mtd
                            %msub
                              %mi Σ
                              %mi in
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi Σ
                              %mi out
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \Sigma
                    \\\
                    \&amp; \nearrow &amp;&amp; \nwarrow
                    \\\
                    \\Sigma_{in}
                    \&amp;&amp; &amp;&amp;
                    \\Sigma_{out}
                    }
            %p is sent under the operation of mapping into the moduli space of fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Mfds
                      %mi op
                    %mo →
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi_1(-), \mathbf{Fields}]
                    \\;\colon\;
                    Mfds^{op} \to Grpd
            %p
              to a
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Σ
                              %mi in
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi Π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Σ
                              %mi out
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi Fields
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; [\Pi_1(\Sigma), \mathbf{Fields}]
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    [\Pi_1(\Sigma_{in}), \mathbf{Fields}]
                    \&amp;&amp; &amp;&amp;
                    [\Pi_1(\Sigma_{out}), \mathbf{Fields}]
                    }
                    \\,.
            %p
              Here the left and right homomorphisms are those which take a field configuration on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              and restrict it to the incoming and to the outgoing field configuration, respectively. (And this being a homomorphism of groupoids means that everything respects the
              %a.existingWikiWord{:href => "/nlab/show/gauge+symmetry"} gauge symmetry
              on the fields.) Hence if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Σ
                      %mrow
                        %mi in
                        %mo ,
                        %mi out
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Pi_1(\Sigma_{in,out}),\mathbf{Fields}]
              is thought of as the spaces of incoming and outgoing field configurations, respectively, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Fields
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Pi_1(\Sigma), \mathbf{Fields}]
              is to be interpreted as the space of
              %a.existingWikiWord{:href => "/nlab/show/trajectories"} trajectories
              (sometimes:
              = succeed ")" do
                %em histories
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/spacetimes"} spacetimes
              %a.existingWikiWord{:href => "/nlab/show/worldvolumes"} worldvolumes
              of shape
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          %p This should make it plausible that specifying the field content of a 1-dimensional discrete gauge field theory is a functorial assignment
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Bord
                    %mn 1
                  %mo →
                  %mi Span
                  %mo{:stretchy => "false"} (
                  %mi Grpd
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{Fields}
                  \\;\colon\;
                  Bord_1
                  \\to Span(Grpd)
          %p
            from a
            %a.existingWikiWord{:href => "/nlab/show/category+of+cobordisms"} category of cobordisms
            of dimension one into a category of such
            %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            of groupoids. It sends points to spaces of field configurations on the point and 1-dimensional manifolds such as the circle to spaces of trajectories of field configurations on them.
          %p
            Moreover, for a
            %em local
            field theory it should be true that the field configurations on the circle, say, are determined from gluing the field configurations on any decomposition of the circle, notably a decomposition into two semi-circles. But since we are dealing with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+field+theory"} topological field theory
          %p
            The way that the fields on higher spheres in a topological field theory are induced from the fields on the point is by an analog of
            %em
              %a.existingWikiWord{:href => "/nlab/show/traces"} traces
            for spaces of fields, and higher traces of such correspondences (the “
            %a.existingWikiWord{:href => "/nlab/show/span+trace"}> span trace
            ”). This is because by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cobordism+theorem"} cobordism theorem
            %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            are given by the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/span+trace"} span trace
            of the field configurations on the point, the trace of the traces of the … of the 1-trace. This is because for instance the 1-sphere, hence the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            is, regarded as a 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/cobordism"} cobordism
            itself pretty much manifestly a
            %a.existingWikiWord{:href => "/nlab/show/trace"} trace
            on the point in the
            %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
            formulation of traces.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo *
                            %mo −
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↖
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↗
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo *
                            %mo +
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp;  \ast^-
                  \\\
                  \&amp; \swarrow &amp; &amp; \nwarrow
                  \\\
                  \\downarrow &amp;&amp; &amp;&amp; \uparrow
                  \\\
                  \&amp; \searrow &amp;&amp; \nearrow
                  \\\
                  \&amp;&amp; \ast^+
                  }
                  \\,.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo *
                    %mo +
                %annotation{:encoding => "application/x-tex"} \ast^+
            is the point with its positive orientation, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo *
                    %mo −
                %annotation{:encoding => "application/x-tex"} \ast^-
            is its
            %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+cobordisms"} category of cobordisms
            %a.existingWikiWord{:href => "/nlab/show/coevaluation+map"} coevaluation map
            and
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            map on the point regarded as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
            %a.existingWikiWord{:href => "/nlab/show/topological+field+theory"} topological field theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Bord
                      %mi n
                    %mo →
                    %msub
                      %mi Span
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z \colon Bord_n \to Span_n(\mathbf{H})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} Span_n(\mathbf{H})^\otimes
            %a.existingWikiWord{:href => "/nlab/show/span+trace"} span trace
            on the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Fields
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{Fields}(\ast)
            over the point. This we discuss now.
          %p Before talking about correspondences of groupoids, we need to organize the groupoids themselves a bit more.
          #TwoOneCategory.num_defn
            %h6#definition_5 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ol
              %li
                %p
                  a collection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_0
                  – the “collection of
                  = succeed "\u201D;" do
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi 𝒞
                          %mn 0
                        %mo ×
                        %msub
                          %mi 𝒞
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} (X,Y) \in \mathcal{C}_0 \times \mathcal{C}_0
                  a
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y)
                  – the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  to
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/triple"} triple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %msub
                          %mi 𝒞
                          %mn 0
                        %mo ×
                        %msub
                          %mi 𝒞
                          %mn 0
                        %mo ×
                        %msub
                          %mi 𝒞
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} (X,Y,Z) \in \mathcal{C}_0 \times \mathcal{C}_0 \times \mathcal{C}_0
                  a groupoid homomorphism (
                  %a.existingWikiWord{:href => "/nlab/show/functor"}> functor
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∘
                          %mrow
                            %mi X
                            %mo ,
                            %mi Y
                            %mo ,
                            %mi Z
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\circ_{X,Y,Z} \colon \mathcal{C}(X,Y) \times \mathcal{C}(Y,Z) \to \mathcal{C}(X,Z)
                %p
                  called
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  or
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
                  for emphasis;
              %li
                %p
                  for each
                  %a.existingWikiWord{:href => "/nlab/show/quadruple"} quadruple
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mo ,
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ,
                        %mi Z
                        %mo ,
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (W,X,Y,Z,)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                  – the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                  –
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi Y
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi Y
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ⇙
                                  %mrow
                                    %msub
                                      %mi α
                                      %mrow
                                        %mi W
                                        %mo ,
                                        %mi X
                                        %mo ,
                                        %mi Y
                                        %mo ,
                                        %mi Z
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi X
                                %mo{:stretchy => "false"} )
                                %mo ×
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                              %mtd
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi W
                                %mo ,
                                %mi Z
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathcal{C}(W,X) \times \mathcal{C}(X,Y) \times \mathcal{C}(Y,Z)
                        \&amp;\stackrel{}{\to}&amp;
                        \\mathcal{C}(W,Y) \times \mathcal{C}(Y,Z)
                        \\\
                        \\downarrow &amp;\swArrow_{\alpha_{W,X,Y,Z}}&amp; \downarrow
                        \\\
                        \\mathcal{C}(W,X) \times \mathcal{C}(X,Z)
                        \&amp;\stackrel{}{\to}&amp;
                        \\mathcal{C}(W,Z)
                        }
                %p
                  (…) and similarly a
                  %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
                  homotopy (…)
            %p
              such that for each
              %a.existingWikiWord{:href => "/nlab/show/quintuple"} quintuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi W
                    %mo ,
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi Z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V,W,X,Y,Z)
              the associators satisfy the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pentagon+identity"} pentagon identity
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y)
              we call the
              %em
                %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\to} Y
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(X,Y)
              we call the
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⇓
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\\
                    \&amp; \nearrow \searrow^{\mathrlap{f}}
                    \\\
                    X &amp;\Downarrow&amp;  Y
                    \\\
                    \&amp; \searrow \nearrow_{\mathrlap{g}}
                    }
                    \\,.
            %p
              If all associators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              can and are chosen to be the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              then this is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict (2,1)-category
          .num_defn
            %h6#definitionexample Definition/Example
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              for the
              %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              = succeed "," do
                %a.maruku-ref{:href => "#TwoOneCategory"}
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:lspace => "verythinmathspace"} :
                          %mi 𝒢
                          %mo →
                          %mi 𝒦
                        %annotation{:encoding => "application/x-tex"} f \colon \mathcal{G} \to \mathcal{K}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
                  between these.
          #OneSpansInOneGroupoids.num_defn
            %h6#definitionexample_2 Definition/Example
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span_1(Grpd)
              for the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                  are
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/spans"} spans
                  %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mo ←
                              %mtd
                                %mi X
                              %mtd
                                %mo →
                              %mtd
                                %mi B
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        A
                        \&amp;\leftarrow&amp;
                        X
                        \&amp;\rightarrow&amp;
                        B
                        }
                        \\,;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi X
                                  %mn 1
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                                %mo ⇘
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mo ≃
                              %mtd
                                %mo ⇙
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                              %mtd
                                %mo ↖
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↗
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi X
                                  %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; X_1
                        \\\
                        \&amp; \swarrow &amp;\downarrow&amp; \searrow
                        \\\
                        A &amp;\seArrow&amp; \downarrow^{\mathrlap{\simeq}} &amp;\swArrow&amp; B
                        \\\
                        \&amp; \nwarrow &amp;\downarrow&amp; \nearrow
                        \\\
                        \&amp;&amp; X_2
                        }
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  is given by forming the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
                  = succeed "," do
                    %a.maruku-ref{:href => "#HomotopyFiberProductOfGroupoids"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo ←
                          %mrow
                        %mi K
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"}
                        X \stackrel{}{\leftarrow} K \rightarrow Y
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mover
                          %mo ←
                          %mrow
                        %mi L
                        %mo →
                        %mi Z
                      %annotation{:encoding => "application/x-tex"}
                        Y \stackrel{}{\leftarrow} L \rightarrow Z
                %p their composite is the span which is the outer part of the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mi K
                                %munder
                                  %mo ×
                                  %mi Y
                                %mi L
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi p
                                        %mn 1
                                %mo ↙
                              %mtd
                              %mtd
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi p
                                        %mn 2
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi K
                              %mtd
                              %mtd
                                %mo ⇙
                              %mtd
                              %mtd
                                %mi L
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mo ↘
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mi Y
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mi Z
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; &amp;&amp; K \underset{Y}{\times}L
                        \\\
                        \&amp;&amp; &amp; {}^{\mathllap{p_1}}\swarrow
                        \&amp;&amp; \searrow^{\mathrlap{p_2}}
                        \\\
                        \&amp;&amp; K &amp;&amp; \swArrow &amp;&amp; L
                        \\\
                        \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                        \\\
                        X &amp;&amp; &amp;&amp; Y &amp;&amp; &amp;&amp; Z
                        }
                        \\,.
          .num_defn
            %h6#definition_6 Definition
            %p
              There is the structure of a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%282%2C1%29-category"} symmetric monoidal (2,1)-category
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Span
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Span_1(Grpd)
              by degreewise
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ←
                    %mi K
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo ←
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mover
                      %mi Y
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo ←
                    %mi K
                    %mo ×
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi Y
                    %mo ×
                    %mover
                      %mi Y
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (X \leftarrow K \rightarrow Y)
                    \\otimes
                    (\tilde X \leftarrow \tilde K \rightarrow \tilde Y)
                    \\;\coloneqq\;
                    X \times \tilde X
                    \\leftarrow K \times \tilde K
                    \\rightarrow Y \times \tilde Y
                    \\,.
          .num_defn
            %h6#definition_7 Definition
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%282%2C1%29-category"} symmetric monoidal (2,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes
              is
              %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"} fully dualizable
              if there exists
            %ol
              %li
                %p
                  another object
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mo *
                        %annotation{:encoding => "application/x-tex"} X^\ast
                  = succeed ";" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              %li
                %p
