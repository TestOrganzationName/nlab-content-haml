          %h2#definition Definition
          %p
            Up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
            %strong anti de Sitter spacetime
            of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi AdS
                      %mi d
                  %annotation{:encoding => "application/x-tex"} AdS_d
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            whose underlying
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            is the
            %a.existingWikiWord{:href => "/nlab/show/submanifold"} submanifold
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo −
                      %mn 1
                      %mo ,
                      %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,2}
            that solves the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi d
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %msup
                      %mi R
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\sum_{i = 1}^{d-1}}
                  (x_i)^2 - (x_d)^ 2 - (x_0)^2
                  \\;=\;
                  \- R^2
                  \\,,
          %p
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} R \neq 0
            (the “radius” of the spacetime) and equipped with the
            %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
            induced from the ambient metric, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi x
                    %mn 0
                  %mo ,
                  %msup
                    %mi x
                    %mn 1
                  %mo ,
                  %msup
                    %mi x
                    %mn 2
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msup
                    %mi x
                    %mi d
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x^0, x^1, x^2, \cdots, x^d\}
            denote the canonical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi AdS
                    %mi d
                %annotation{:encoding => "application/x-tex"} AdS_d
            is
            %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1} \times S^1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d-1, 2)
          %p
            More generally, one may define the anti de Sitter space of signature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p,q)
            as isometrically embedded in the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{p,q+1}
            with coordinates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi x
                    %mi p
                  %mo ,
                  %msub
                    %mi t
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi t
                    %mrow
                      %mi q
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x_1, ..., x_p, t_1, \ldots, t_{q+1})
            as the sphere
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi p
                    %msubsup
                      %mi x
                      %mi i
                      %mn 2
                    %mo −
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi j
                        %mo =
                        %mn 1
                      %mrow
                        %mi q
                        %mo +
                        %mn 1
                    %msubsup
                      %mi t
                      %mi j
                      %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mi R
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \sum_{i=1}^p x_i^2 - \sum_{j=1}^{q+1} t_j^2 = -R^2
          %blockquote
            %p
              graphics grabbed from
              %a{:href => "holographic+entanglement+entropy#Yan19"} Yan 19
          %h2#properties Properties
          %h3#CoordinateCharts Coordinate charts
          %p
            A comprehesive account of the AdS
            %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
            in various
            %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
            is given in
            = succeed "." do
              %a{:href => "#Blau"} Blau §39.3
          %p
            %br/
          %p
            %strong Poincaré and horospheric coordinates
            (e.g.
            = succeed ")." do
              %a{:href => "#Blau"} Blau §39.3.7
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 1
                      %mo +
                      %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1+p}
            with its canonical
            %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi a
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 1
                      %mo +
                      %mi p
                  %mover
                    %mo →
                    %mphantom
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi a
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  X^a
                  \\;\colon\;
                  \\mathbb{R}^{1+p}
                  \\xrightarrow{\phantom{-}}
                  \\mathbb{R}
                  \\,,
                  \\;\;\;
                  a \in \{0,1,\cdots, p\}
          %p
            and denote its standard
            %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski
            %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msubsup
                    %mi s
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 1
                          %mo ,
                          %mi p
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi a
                          %mo =
                          %mn 0
                        %mi p
                    %mi{:mathvariant => "normal"} d
                    %msup
                      %mi X
                      %mi a
                    %mo ⊗
                    %mi{:mathvariant => "normal"} d
                    %msup
                      %mi X
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  d s^2_{\mathbb{R}^{1,p}}
                  \\;\coloneqq\;
                  \\textstyle{\sum_{a = 0}^p}
                  \\mathrm{d}X^a \otimes \mathrm{d}X^a
                  \\,.
          %p
            Moreover consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 1
                      %mo +
                      %mi p
                  %mo ×
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{1+p} \times \mathbb{R}_{\gt 0}
            equipped with the pullback of the above coordinate function as well as with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 1
                      %mo +
                      %mi p
                  %mo ×
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                  %mo ↠
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                  %mo ↪
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  r
                  \\;\colon\;
                  \\mathbb{R}^{1+p} \times \mathbb{R}_{\gt 0}
                  \\twoheadrightarrow
                  \\mathbb{R}_{\gt 0}
                  \\hookrightarrow
                  \\mathbb{R}
                  \\,.
          %p
            Then there is a chart of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi AdS
                    %mrow
                      %mi p
                      %mo +
                      %mn 2
                %annotation{:encoding => "application/x-tex"} AdS_{p+2}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 1
                      %mo +
                      %mi p
                  %mo ×
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                  %mover
                    %mo ↪
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                  %msub
                    %mi AdS
                    %mrow
                      %mi p
                      %mo +
                      %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\iota
                  \\;\colon\;
                  \\mathbb{R}^{1+p} \times \mathbb{R}_{\gt 0}
                  \\xhookrightarrow{\phantom{--}}
                  AdS_{p+2}
          %p such that the pullback of the AdS metric tensor is
          #eq:MetricInPoincareCoordinatesI.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ι
                    %mo *
                  %mi{:mathvariant => "normal"} d
                  %msubsup
                    %mi s
                    %mi AdS
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %msup
                          %mi r
                          %mn 2
                      %mrow
                        %msup
                          %mi R
                          %mn 2
                  %mi{:mathvariant => "normal"} d
                  %msubsup
                    %mi s
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 1
                          %mo ,
                          %mi d
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %msup
                          %mi R
                          %mn 2
                      %mrow
                        %msup
                          %mi r
                          %mn 2
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi r
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota^\ast \mathrm{d}s^2_{AdS}
                  \\;=\;
                  \\tfrac{r^2}{R^2}
                  \\mathrm{d}s^2_{\mathbb{R}^{1,d}}
                  \\,+\,
                  \\tfrac{R^2}{r^2}
                  \\mathrm{d}r^2
                  \\,.
          %p
            This is the form of the AdS-metric which arises naturally as the
            %a.existingWikiWord{:href => "/nlab/show/near+horizon+geometry"} near horizon geometry
            of
            %a.existingWikiWord{:href => "/nlab/show/black+branes"} black
            %a.existingWikiWord{:href => "/nlab/show/p-branes"} p-branes
            in
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            (e.g.
            = succeed ")." do
              %a{:href => "near-horizon+geometry#AFFHS98"} AFFHS98 (5)
            %a.existingWikiWord{:href => "/nlab/show/singularity"} singularity
            itself would be at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = 0
          %p In slight variation, in terms of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi r
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext hence
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi r
                  %mo =
                  %msup
                    %mi z
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi r
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi z
                          %mn 2
                  %mi{:mathvariant => "normal"} dz
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"}
                  z \,\coloneqq\, 1/r
                  \\,,
                  \\;\;\;
                  \\text{hence}
                  \\;\;\;
                  r = z^{-1}
                  \\,,
                  \\;\;
                  \\mathrm{d}r
                  \\;=\;
                  \-\tfrac{1}{z^2}
                  \\mathrm{dz} \;\;
          %p
            the metric
            %a.maruku-eqref{:href => "#eq:MetricInPoincareCoordinatesI"} (1)
            becomes
          #eq:MetricInPoincareCoordinatesII.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ι
                    %mo *
                  %mi{:mathvariant => "normal"} d
                  %msubsup
                    %mi s
                    %mi AdS
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %msup
                        %mi R
                        %mn 2
                    %mrow
                      %msup
                        %mi z
                        %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi R
                          %mn 4
                  %mi{:mathvariant => "normal"} d
                  %msubsup
                    %mi s
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 1
                          %mo ,
                          %mi d
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi z
                    %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota^\ast \mathrm{d}s^2_{AdS}
                  \\;=\;
                  \\frac{R^2}{z^2}
                  \\big(
                  \\tfrac{1}{R^4}
                  \\mathrm{d}s^2_{\mathbb{R}^{1,d}}
                  \\,+\,
                  \\mathrm{d}z^2
                  \\big)
                  \\,.
          %p
            cf. e.g.
            = succeed "." do
              %a{:href => "conformal+boudnary#BayonaBraga07"} Bayona &amp; Braga 2007 (11)
            %em horospheric coordinates
            by
            = succeed ".)" do
              %a{:href => "#Gibbons00"} Gibbons 2000 (12)
          %p On the other hand, in terms of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi ln
                  %mi r
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext hence
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi r
                  %mo =
                  %msup
                    %mi e
                    %mi ρ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi r
                  %mo =
                  %mi r
                  %mspace{:width => "thinmathspace"}
                  %mi{:mathvariant => "normal"} d
                  %mi ρ
                %annotation{:encoding => "application/x-tex"}
                  \\rho \;\coloneqq\; ln r
                  \\,,
                  \\;\; \text{hence} \;\;
                  r = e^\rho
                  \\,,
                  \\;\;
                  \\mathrm{d}r = r \, \mathrm{d}\rho
          %p
            the metric
            %a.maruku-eqref{:href => "#eq:MetricInPoincareCoordinatesI"} (1)
            becomes
          #eq:MetricInPoincareCoordinatesIII.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ι
                    %mo *
                  %mi{:mathvariant => "normal"} d
                  %msubsup
                    %mi s
                    %mi AdS
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mrow
                        %msup
                          %mi e
                          %mrow
                            %mn 2
                            %mi ρ
                      %mrow
                        %msup
                          %mi R
                          %mn 2
                  %mi{:mathvariant => "normal"} d
                  %msubsup
                    %mi s
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 1
                          %mo ,
                          %mi d
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo +
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi R
                    %mn 2
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi ρ
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota^\ast \mathrm{d}s^2_{AdS}
                  \\;=\;
                  \\tfrac{e^{2\rho}}{R^2}
                  \\mathrm{d}s^2_{\mathbb{R}^{1,d}}
                  \\,+\,
                  R^2
                  \\mathrm{d}\rho^2
                  \\,.
          %p
            This is called
            %em horospheric coordinates
            in
            = succeed "." do
              %a{:href => "https://arxiv.org/abs/1412.2054"} arXiv:1412.2054 (37)
          %p
            %br/
          %h3#CartanGeometry Cartan geometry
          %p
            We spell out the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            tensors of anti de Sitter spacetime, using a
            %a.existingWikiWord{:href => "/nlab/show/Cartan+connection"} Cartan connection
            (i.e.
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/first+order+formulation+of+gravity"} first order formulation
          %p
            An evident choice of an orthonormal
            %a.existingWikiWord{:href => "/nlab/show/coframe+field"} coframe field
            for the AdS metric in Poincaré coordinates
            %a.maruku-eqref{:href => "#eq:MetricInPoincareCoordinatesI"} (1)
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msup
                          %mi E
                          %mi a
                      %mtd
                        %mo ≔
                      %mtd
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi r
                            %mi R
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi X
                          %mi a
                      %mtd
                        %mi a
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} }
                    %mtr
                      %mtd
                        %msup
                          %mi E
                          %mrow
                            %mi p
                            %mo ′
                      %mtd
                        %mo ≔
                      %mtd
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mi R
                            %mi r
                        %mi{:mathvariant => "normal"} d
                        %mi r
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccll}
                  E^a &amp;\coloneqq&amp; \tfrac{r}{R} \mathrm{d}X^a
                  \&amp; a \in \{0,1, \cdots, d\}
                  \\\
                  E^{p'} &amp;\coloneqq&amp; \tfrac{R}{r} \mathrm{d}r
                  \\end{array}
          %p in that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ι
                    %mo *
                  %mi{:mathvariant => "normal"} d
                  %msubsup
                    %mi s
                    %mrow
                      %msub
                        %mi AdS
                        %mrow
                          %mi p
                          %mo +
                          %mn 2
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi η
                    %mrow
                      %mi a
                      %mi b
                  %msup
                    %mi E
                    %mi a
                  %mo ⊗
                  %msup
                    %mi E
                    %mi b
                  %mo +
                  %msup
                    %mi E
                    %mrow
                      %mi p
                      %mo ′
                  %mo ⊗
                  %msup
                    %mi E
                    %mrow
                      %mi p
                      %mo ′
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota^\ast \mathrm{d}s^2_{AdS_{p+2}}
                  \\;=\;
                  \\eta_{a b} E^a \otimes E^b
                  +
                  E^{p'} \otimes E^{p'}
                  \\,.
          %blockquote
            %p
              (no sum over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} p'
              – this is meant to be the index
              %em value
              corresponding to the radial direction)
          %p
            The
            = succeed "-free" do
              %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+Cartan+connection"} torsion
            %a.existingWikiWord{:href => "/nlab/show/spin+connection"} spin connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            for this
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coframe+field"} coframe field
          #eq:SpinConnection.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi E
                          %mi a
                      %mtd
                        %mo =
                      %mtd
                        %msup
                          %mi Ω
                          %mi a
                        %msub
                          %mrow
                          %mi b
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi E
                          %mi b
                    %mtr
                      %mtd
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi E
                          %mrow
                            %mi p
                            %mo ′
                      %mtd
                        %mo =
                      %mtd
                        %msup
                          %mi Ω
                          %mrow
                            %mi p
                            %mo ′
                        %msub
                          %mrow
                          %mi b
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi E
                          %mi b
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccl}
                  \\mathrm{d}E^a &amp;=&amp; \Omega^a{}_b \, E^b
                  \\\
                  \\mathrm{d}E^{p'} &amp;=&amp; \Omega^{p'}{}_b \, E^b
                  \\mathrlap{\,,}
                  \\end{array}
          %p has non-vanishing components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mi a
                      %mi p
                      %mo ′
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mo −
                  %msup
                    %mi Ω
                    %mrow
                      %mi p
                      %mo ′
                      %mi a
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mi r
                      %mrow
                        %msup
                          %mi R
                          %mn 2
                  %mi{:mathvariant => "normal"} d
                  %msup
                    %mi X
                    %mi a
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Omega^{a p'} \,=\, - \Omega^{p' a}
                  \\;=\;
                  \- \tfrac{r}{R^2} \mathrm{d}X^a
                  \\,.
          %p
            The corresponding
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} 2-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msup
                          %mi R
                          %mrow
                            %msub
                              %mi a
                              %mn 1
                            %msub
                              %mi a
                              %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %msup
                          %mi Ω
                          %mrow
                            %msub
                              %mi a
                              %mn 1
                        %msub
                          %mrow
                          %mrow
                            %mi p
                            %mo ′
                        %msup
                          %mi Ω
                          %mrow
                            %mi p
                            %mo ′
                            %msub
                              %mi a
                              %mn 2
                    %mtr
                      %mtd
                        %msup
                          %mi R
                          %mrow
                            %mi a
                            %mi d
                            %mo ′
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi Ω
                          %mrow
                            %mi a
                            %mi p
                            %mo ′
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  R^{a_1 a_2}
                  \\;=\;
                  \-
                  \\Omega^{a_1}{}_{p'} \Omega^{p' a_2}
                  \\\
                  R^{a d'}
                  \\;\coloneqq\;
                  \\mathrm{d}\Omega^{a p'}
                  \\end{array}
          %p has non-vanishing components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msup
                          %mi R
                          %mrow
                            %msub
                              %mi a
                              %mn 1
                            %msub
                              %mi a
                              %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %msup
                                %mi r
                                %mn 2
                            %mrow
                              %msup
                                %mi R
                                %mn 4
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi X
                          %mrow
                            %msub
                              %mi a
                              %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi X
                          %mrow
                            %msub
                              %mi a
                              %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %msup
                                %mi R
                                %mn 2
                        %msup
                          %mi E
                          %mrow
                            %msub
