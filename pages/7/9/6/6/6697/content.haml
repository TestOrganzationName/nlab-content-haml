            %a.existingWikiWord{:href => "/nlab/show/Bruhat-Tits+tree"} Bruhat-Tits tree
            for the
            %a.existingWikiWord{:href => "/nlab/show/projective+general+linear+group"} projective general linear group
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PGL
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %msub
                      %mi ℚ
                      %mi p
                    %mo{:stretchy => "false"} )
