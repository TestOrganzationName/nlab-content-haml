                              %mn 1
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi E
                          %mrow
                            %msub
                              %mi a
                              %mn 2
                    %mtr
                      %mtd
                        %msup
                          %mi R
                          %mrow
                            %mi a
                            %mi p
                            %mo ′
                        %mspace{:width => "thinmathspace"}
                        %mo =
                        %mspace{:width => "thinmathspace"}
                        %mo −
                        %msup
                          %mi R
                          %mrow
                            %mi p
                            %mo ′
                            %mi a
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %msup
                                %mi R
                                %mn 2
                        %mi{:mathvariant => "normal"} d
                        %msup
                          %mi X
                          %mi a
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %msup
                                %mi R
                                %mn 2
                        %msup
                          %mi E
                          %mi a
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi E
                          %mrow
                            %mi p
                            %mo ′
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  R^{a_1 a_2}
                  \\;=\;
                  \- \tfrac{r^2}{R^4} \mathrm{d}X^{a_1}\, \mathrm{d}X^{a_2}
                  \\;=\;
                  \- \tfrac{1}{R^2} E^{a_1} \, E^{a_2}
                  \\\
                  R^{a p'} \,=\, - R^{p' a}
                  \\;=\;
                  \- \tfrac{1}{R^2} \mathrm{d}X^a
                  \\;=\;
                  \- \tfrac{1}{R^2} E^a \, E^{p'}
                  \\,.
                  \\end{array}
          %p
            Hence the
            %a.existingWikiWord{:href => "/nlab/show/Riemann+tensor"} Riemann tensor
            has non-vanishing components
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msup
                          %mi R
                          %mrow
                            %msub
