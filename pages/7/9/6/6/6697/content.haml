                            %mi b
                            %mi p
                            %mo ′
                      %mtd
                        %mo =
                      %mtd
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mrow
                              %msup
                                %mi R
                                %mn 2
                        %msup
                          %mi δ
                          %mi a
                        %msub
                          %mrow
                          %mi b
                        %mpadded{:width => "0"}
                          %mrow
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccl}
                  R^{a_1 a_2}{}_{b_1 b_2}
                  \&amp;=&amp;
