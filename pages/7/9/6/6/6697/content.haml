          %p
            so that the
            %a.existingWikiWord{:href => "/nlab/show/Ricci+tensor"} Ricci tensor
            is proportional to the metric, as befits an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Einstein+manifold"} Einstein manifold
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %msub
                          %mi Ric
                          %mrow
                            %msub
                              %mi a
                              %mn 1
                            %msub
                              %mi a
                              %mn 2
                      %mtd
                        %mo ≔
                      %mtd
