                            %mi b
                    %mtr
                      %mtd
                      %mtd
                        %mo =
                      %mtd
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                            %mrow
                              %msup
                                %mi R
                                %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccl}
                  Ric_{a_1 a_2}
                  \&amp;\coloneqq&amp;
                  R_{a_1}{}^{b}{}_{a_2 b}
                  \\,+\,
                  R_{a_1}{}^{p'}{}_{a_2 p'}
                  \\;=\;
                  \\tfrac{p}{R^2} \, \eta_{a_1 a_2}
                  +
                  \\tfrac{1}{R^2} \, \eta_{a_1 a_2}
                  \\\
                  \&amp;=&amp; \tfrac{p+1}{R^2} \, \eta_{a_1 a_2}
                  \\\
                  Ric_{p' p'}
                  \&amp;\coloneqq&amp;
                  R_{p'}{}^b{}_{p' b}
                  \\\
                  \&amp;=&amp;
                  \\tfrac{p+1}{R^2}
                  \\,.
                  \\end{array}
          %blockquote
            %p
              The above convention
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %msup
                      %mi E
                      %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msup
                      %mi Ω
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi E
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}E^a = + \Omega^a{}_b \, E^b
              %a.maruku-eqref{:href => "#eq:SpinConnection"} (4)
              makes this come out positive, following the old convention by
              = succeed "," do
                %a{:href => "Freund-Rubin+compactification#FreundRubin80"} Freund &amp; Rubin 1980
              = succeed "." do
                %a{:href => "Freund-Rubin+compactification#TheGeneralFreundRubinSolution"} there
          %p
            %br/
          %h3#conformal_boundary Conformal boundary
          %p
            (…)
            %em
