          %title
          %p
            Amihay Hanany is professor for theoretical
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            at Imperial College London.
          %ul
            %li
              %a{:href => "http://www.imperial.ac.uk/people/a.hanany"} webpage
          %h2#selected_writings Selected writings
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/small+instantons"} small instantons
            as
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            %a.existingWikiWord{:href => "/nlab/show/M5-branes"} M5-branes
            in
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/E8"} E8
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+M-theory"} heterotic M-theory
          %ul
            %li#GanorHanany96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ori+Ganor"}> Ori Ganor
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"} Amihay Hanany
                = succeed "," do
                  %em
                    Small
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 8
                        %annotation{:encoding => "application/x-tex"} E_8
                    Instantons and Tensionless Non-critical Strings
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9602120"} arXiv:hep-th/9602120
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"}> Amihay Hanany
                , Noppadol Mekareeya,
                = succeed "," do
                  %em
                    The Small
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn 8
                        %annotation{:encoding => "application/x-tex"} E_8
                    Instanton and the Kraft Procesi Transition
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1801.01129"} arXiv:1801.01129
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/geometric+engineering+of+quantum+field+theories"} geometric engineering of quantum field theories
            involving
            %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            and introducing the
            %a.existingWikiWord{:href => "/nlab/show/Hanany-Witten+effect"} Hanany-Witten effect
            and other effects of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/NS5-brane"} NS5-brane
            %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/brane+intersection"} intersections
          %ul
            %li#HanayWitten97
              %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"}> Amihay Hanany
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em Type IIB Superstrings, BPS Monopoles, And Three-Dimensional Gauge Dynamics
              %strong 492
              (1997) 152-190 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/hep-th/9611230"}> arXiv:hep-th/9611230
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0550-3213(97)80030-2"} doi:10.1016/S0550-3213(97)80030-2
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/D-branes"} D-branes
            %a.existingWikiWord{:href => "/nlab/show/brane+intersection"} intersecting
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
          %ul
            %li#BrodieHanany97
              %a.existingWikiWord{:href => "/nlab/show/John+Brodie"}> John Brodie
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"} Amihay Hanany
              = succeed "," do
                %em Type IIA Superstrings, Chiral Symmetry, and N=1 4D Gauge Theory Dualities
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9704043"} arXiv:hep-th/9704043
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28p%2Cq%295-brane+webs"} (p,q)5-brane webs
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ofer+Aharony"}> Ofer Aharony
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"} Amihay Hanany
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Barak+Kol"} Barak Kol
                = succeed "," do
                  %em
                    Webs of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p,q)
                    5-branes, Five Dimensional Field Theories and Grid Diagrams
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9710116"} arXiv:hep-th/9710116
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ofer+Aharony"}> Ofer Aharony
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"} Amihay Hanany
                = succeed "," do
                  %em Branes, Superpotentials and Superconformal Fixed Points
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9704170"} arXiv:hep-th/9704170
          %p
            and their intersection with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/orientifolds"} orientifolds
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"}> Amihay Hanany
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Zaffaroni"} Alberto Zaffaroni
              = succeed "," do
                %em
                  Issues on Orientifolds: On the brane construction of gauge theories with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(2n)
                  global symmetry
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9903242"} arXiv:hep-th/9903242
          %p
            Discussion of a
            %a.existingWikiWord{:href => "/nlab/show/BFSS+matrix+model"} BFSS-like
            %a.existingWikiWord{:href => "/nlab/show/matrix+model"} matrix model
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/MK6-branes"} MK6-branes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"}> Amihay Hanany
              , Gilad Lifschytz,
              = succeed "," do
                %em
                  M(atrix) Theory on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi T
                          %mn 6
                      %annotation{:encoding => "application/x-tex"} T^6
                  and a m(atrix) Theory Description of KK Monopoles
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9708037"} arXiv:hep-th/9708037
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/toric+duality"} toric duality
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bo+Feng"}> Bo Feng
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"} Amihay Hanany
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                %em
                  D-brane gauge theories from toric singularities and toric duality, Nucl. Phys. B 595 (2001) 165 (
                  %a{:href => "https://arxiv.org/abs/hep-th/0003085"}> arXiv:hep-th/0003085
                  )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bo+Feng"}> Bo Feng
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"} Amihay Hanany
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                %em Phase structure of D-brane gauge theories and toric duality
                , J. High Energy Phys. 08 (2001) 040 (
                %a{:href => "https://arxiv.org/abs/hep-th/0104259"}> hep-th/0104259
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bo+Feng"}> Bo Feng
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Amihay+Hanany"} Amihay Hanany
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Angel+Uranga"} Angel Uranga
                %em
                  Toric duality as Seiberg duality and brane diamonds, J. High Energy Phys. 12 (2001) 035 (
                  %a{:href => "https://arxiv.org/abs/hep-th/0109063"}> hep-th/0109063
                  )
