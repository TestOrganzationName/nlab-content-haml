            of curvature characteristic forms.
          %p
            Assume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                  %mo ,
                  %mo ∇
                  %mo ′
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
