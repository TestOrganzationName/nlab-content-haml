            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra 3-cocycle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
