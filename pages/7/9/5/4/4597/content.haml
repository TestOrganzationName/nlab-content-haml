                        %mi n
                        %mi i
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}(-,\mathbf{B}G)
                  \\to
                  \\prod_i \tau_1\mathbf{\flat}_{dR}\mathbf{B}^{n_i} \mathbb{R}
          %p
            is an approximation to the intrinsic Chern-character. We may consider its
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Q
                    %mi i
