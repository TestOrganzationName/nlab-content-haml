            = succeed "," do
              %a{:href => "http://nlab.mathforge.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#WaldorfStringConn#FreedCharge"} Freed
            = succeed ")" do
