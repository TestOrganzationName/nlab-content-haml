                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  [CartSp^{op},sSet](-, \mathbf{B}G_{diff})
                  \&amp;\to&amp;
                  [CartSp^{op},sSet](-, \mathbf{cosk}_2 \mathbf{\flat}_{dR}\mathbf{B}^{p+1} \mathbb{R})
                  \\\
