            coming from a
            %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
