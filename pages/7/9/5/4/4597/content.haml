            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CS
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %mo ∇
                  %mo ′
