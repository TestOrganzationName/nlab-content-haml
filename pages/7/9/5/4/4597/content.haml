                  \\langle F_{(-)}\rangle :  \mathbf{H}(-, \mathbf{B}G)
                  \\to
                  \\mathbf{H}(-,
                  \\tau_{1} \mathbf{\flat}_{dR}\mathbf{B}^{p+1} \mathbb{R}
                  )
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                  %mn ∞
                  %mi LieGrpd
                %annotation{:encoding => "application/x-tex"} \mathbf{H} = \infty LieGrpd
            represented by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi CartSp
