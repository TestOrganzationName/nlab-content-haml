                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,\mathbf{B}^3 U(1))
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/3-groupoid"} 3-groupoid
            whose objects are smooth
            = succeed "-" do
              %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#BnU1"} circle 2-group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal 3-bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{diff}(X,\mathbf{B}^3 U(1))
            is accordingly the
            %a.existingWikiWord{:href => "/nlab/show/3-groupoid"} 3-groupoid
            whose objects are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundles with connection
            %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            of this, the restriction to connected components:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}p_1 = \pi_0(\frac{1}{2}\mathbf{p}_1)
                  \\,.
          %p
            This refinement to cocylce
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %em
              %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            ) that the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the bare fractional Pontryagin class, which is the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi p
                                %mn 1
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}(X,\mathbf{B}String) &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;\swArrow_\simeq&amp; \downarrow
                  \\\
                  \\mathbf{H}(X,\mathbf{B}G)
                  \&amp;\stackrel{\frac{1}{2} \mathbf{p}_1}{\to}&amp;
                  \\mathbf{H}(X, \mathbf{B}^3 U(1))
                  }
                  \\,,
          %p
            defines the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X, \mathbf{B}String)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/string+structure"} string structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (
            %em smooth
            , but not
            %em differential
            ).
          %p
            We can now replace the class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\mathbf{p}_1
            by its differential refinement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1
            and obtain an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi String
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} String_{diff}(X)
            that differentially refines the 2-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,\mathbf{B}String)
            of String-structures as the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi String
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi conn
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 2
                              %msub
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi p
                                  %mo{:stretchy => "false"} ^
                                %mn 1
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 3
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  String_{diff}(X) &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;\swArrow_\simeq&amp; \downarrow
                  \\\
                  \\mathbf{H}_{conn}(X,\mathbf{B}G)
                  \&amp;\stackrel{\frac{1}{2}\hat \mathbf{p}_1}{\to}&amp;
                  \\mathbf{H}_{diff}(X, \mathbf{B}^3 U(1))
                  }
                  \\,.
          %p
            This
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi String
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} String_{diff}(X)
            we may call the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %em
              %a.existingWikiWord{:href => "/nlab/show/differential+string-structures"} differential string-structures
            \. A cocycle in there is naturally identified with a tuple consisting of
          %ul
            %li
              %p
                a smooth
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                      %annotation{:encoding => "application/x-tex"} Spin
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} P \to X
                with
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                      %annotation{:encoding => "application/x-tex"} \nabla
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+2-gerbe"} Chern-Simons 2-gerbe
                with connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CS
                      %mo{:stretchy => "false"} (
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CS(\nabla)
                induced by this;
            %li
              %p
                a choice of trivialization of this Chern-Simons 2-gerbe – this is the
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
                in the middle of the above pullback diagram.
          %p
            We may think of this as a refinement of
            = succeed "es:" do
              %a.existingWikiWord{:href => "/nlab/show/secondary+characteristic+class"} secondary characteristic class
            %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle F_\nabla \wedge F_\nabla \rangle
            itself is constrained to vanish, and so the
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons form
            3-connection itself constitutes cohomological data.
          %p
            So far this uses mostly just a little bit of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            or at least some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            appearing is the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,\mathbf{B}String)
            which may be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            of
            %em smooth
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
          %p
            But suppose we fix an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(X, \mathbf{B}String)
            is nontrivial. Then we can continue the proceed to higher degrees:
          %p
            the next topological characteristic class is the second fractional
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 6
                    %msub
                      %mi p
                      %mn 2
                    %mo :
                    %mi ℬ
                    %mi String
                    %mo →
                    %msup
                      %mi ℬ
                      %mn 7
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \frac{1}{6}p_2 : \mathcal{B}String \to \mathcal{B}^7 U(1)
            %a.existingWikiWord{:href => "/nlab/show/string+group"} string group
            does not have the structure of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            using ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p we may obtain a differential refinement
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 6
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 2
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi String
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 7
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{6}\hat \mathbf{p}_2 :
                  \\mathbf{B}String_{conn}
                  \\to
                  \\mathbf{B}^7 U(1)_{conn}
          %p
            that maps smooth
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
            = succeed "." do
              %a{:href => "#FivebraneStructure"} Chern-Simons circle 7-bundle with connection
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
          %p
            And naturally we are then entitled to form its
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} 7-groupoid
            of
            %em
              %a{:href => "#DiffFivebraneStrucs"} differential fivebrane structures
            –
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fivebrane
                      %mi diff
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fivebrane_{diff}(X)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/fivebrane+structure"} fivebrane structure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi Fivebrane
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 6
                              %msub
                                %mstyle{:mathvariant => "bold"}
                                  %mi p
                                %mn 2
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 7
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{H}(X, \mathbf{B}Fivebrane) &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                  \\\
                  \\mathbf{H}(X, \mathbf{B}String)
                  \&amp;\stackrel{\frac{1}{6}\mathbf{p}_2}{\to}&amp;
                  \\mathbf{H}(X, \mathbf{B}^7 U(1))
                  }
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} 7-groupoid
            of smooth
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/fivebrane+structure"} fivebrane structure
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Fivebrane
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi conn
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi String
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mfrac
                                %mn 1
                                %mn 6
                              %msub
                                %mover
                                  %mstyle{:mathvariant => "bold"}
                                    %mi p
                                  %mo{:stretchy => "false"} ^
                                %mn 2
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi H
                            %mi diff
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 7
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Fivebrane_{diff}(X) &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;\swArrow_{\simeq}&amp; \downarrow
                  \\\
                  \\mathbf{H}_{conn}(X, \mathbf{B}String)
                  \&amp;\stackrel{\frac{1}{6}\hat \mathbf{p}_2}{\to}&amp;
                  \\mathbf{H}_{diff}(X, \mathbf{B}^7 U(1))
                  }
          %p
            we may therefore call the 7-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Fivebrane
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fivebrane_{diff}(X)
            of
            %em differential fivebrane structures
            \. Cocycles in here are naturally identified with tuples of
          %ul
            %li
              %p
                a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi String
                      %annotation{:encoding => "application/x-tex"} String
                %a.existingWikiWord{:href => "/nlab/show/principal+2-bundle"} principal 2-bundle
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} P \to X
                %a{:href => "#InfinityLieAlgebraConnection"} 2-connection
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                      %annotation{:encoding => "application/x-tex"} \nabla
            %li
              %p
                the Chern-Simons
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 7-bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CS
                        %mn 7
                      %mo{:stretchy => "false"} (
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CS_7(\nabla)
                with connection induced by it;
            %li
              %p
                a choice of trivialization of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi CS
                          %mn 7
                        %mo{:stretchy => "false"} (
                        %mo ∇
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CS_7(\nabla)
          %p
            These are the kind of structures that
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h2#idea Idea
          %p
            Ordinary
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory"} Chern-Weil theory
            is about refinements of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            (equivalently of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathcal{B}G
            of that Lie group) from ordinary
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %p
            Under
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-Chern-Weil theory
            we want to understand the generalization of this to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} ∞-Lie group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %p
            So
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-refinements" do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} ∞-Lie group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}G
          %p
            Ordinary Chern-Weil theory is formulated in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9ELieGrpd"} ∞LieGrpd
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoids"} ∞-Lie groupoids
          %p
            In every
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            to
            %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+forms"} curvature characteristic classes
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            The main construction in ∞-Chern-Weil theory is a concrete
            %em model
            or
            %em presentation
            of this abstract operation. This model is constructed in terms of
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of objects in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cohomology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            %em
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} ∞-connections
            on
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %p
            This model itself is after all built on concrete familiar constructions in
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            and can be studied and appreciated in itself without recourse to the higher topos theory that we claim it provides a model for. The so inclined reader can ignore all the general abstract discussion in the following and concentrate on the concrete differential geometry.
          %p ere is how this entry here proceeds.
          %p A warmup for the full theory that connects to classical constructions is given at
          %ul
            %li
              %a{:href => "#PreparatoryConcepts"} Introduction
          %p Then in
          %ul
            %li
              %a{:href => "#ChernWeil"} ∞-Chern-Weil theory
          %p
            we discuss the general definition of
            = succeed "-connections" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a{:href => "#Examples"} Examples
          %h2#PreparatoryConcepts Preparatory concepts
          %p
            General
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-theory" do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-topos"} (infinity,1)-topos
          %p
            However, unwinding the abstract higher topos theoretic concepts in terms of 1-categoriecal models yields concrete structures in familiar contexts of
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            that connect to various classical and familiar concepts. Since a full appreciation of the abstract formulation benefits from having a feeling for how these concrete models work out, the reader may at this point wish to look into some such basic aspects. These may be found behind the following link
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/infinity-Chern-Weil+theory+--+preparatory+concepts"}> infinity-Chern-Weil theory – preparatory concepts
              \.
          %h2#ChernWeil
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Chern-Weil theory
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ,
                  %mi A
                %annotation{:encoding => "application/x-tex"} G,A
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            with
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}A
            %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} c : \mathbf{B}G \to A
            serves to pull back the
            %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos#GroupalCurvature"} canonical intrinsic curvature form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi curv
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} curv_A : A \to \mathbf{\flat}_{dR} \mathbf{B}A
            to an
            %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos#deRham"} intrinsic differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi curv
                    %mi A
                  %mo ∘
                  %mi c
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mo ♭
                    %mi dR
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} curv_A\circ c  : \mathbf{B}G \to \mathbf{\flat}_{dR} \mathbf{B}A
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            regarded naturally as an object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9ELieGrpd"} ∞LieGrpd
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            for
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %em model
            for this simple abstract situation, which applies to those characteristic classes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            that happen to be in the image of the
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#IntegrationOfCocycles"} Lie intgeration of Lie algebra cocycles
          %p
            More generally, this construction applies for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+group"} ∞-Lie group
            with
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            a characteristic class on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            that arises from Lie integration of a cocycle in the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          %p
            The ordinary
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            uses a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            as an intermediate tool for interpolating from a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            to its curvature characteristic, represented by the
            %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle F_\nabla \rangle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo ∇
                %annotation{:encoding => "application/x-tex"} F_\nabla
            is the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle - \rangle
            is an
