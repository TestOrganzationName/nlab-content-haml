                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi diff
                  %mo{:stretchy => "false"} (
                  %mi X
