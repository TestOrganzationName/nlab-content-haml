            completion yields
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"} differential K-theory
          %h3#principal_2bundles_with_connection Principal 2-bundles with connection
          %p (…)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
