          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a smooth manifold with good cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            we have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi CartSp
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
