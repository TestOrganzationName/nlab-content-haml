          .proof
            %h6#proof_2 Proof
            %p
              The statements about morphisms out of the path groupoid are discussed in detail in
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/0705.0452"} SchrWalI
          .un_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
