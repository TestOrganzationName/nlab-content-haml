                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi G
                    %msub
                      %mi Bund
                      %mo ∇
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
