          %p
            Since these two steps are controled by the
            = succeed "-group" do
              %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
