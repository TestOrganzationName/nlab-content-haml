          %ul
            %li#PenkavaVanhaecke00
              %a.existingWikiWord{:href => "/nlab/show/Michael+Penkava"}> Michael Penkava
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pol+Vanhaecke"} Pol Vanhaecke
              = succeed "," do
                %em Deformation quantization of Polynomial Poisson algebras
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/math/9804022"} arXiv:math/9804022
