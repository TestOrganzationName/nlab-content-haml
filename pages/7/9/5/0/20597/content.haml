                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                is a finiteness monoid with the minimal finiteness structure, and when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is a ring the resulting ring structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} ⟨
                      %mi M
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} R\langle M\rangle
                is induced on the basis elements by the multiplication of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
                is a group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
