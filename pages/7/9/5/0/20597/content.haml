          %title Finiteness spaces
          %h1#finiteness_spaces Finiteness spaces
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#categories_of_finiteness_spaces"} Categories of finiteness spaces
              %ul
                %li
                  %a{:href => "#monoidal_structures"} Monoidal structures
                %li
                  %a{:href => "#initial_and_terminal_structures"} Initial and terminal structures
              %li
                %a{:href => "#Matrices"} Matrices
              %li
                %a{:href => "#linearization"} Linearization
              %ul
                %li
                  %a{:href => "#examples_2"} Examples
              %li
                %a{:href => "#related_pages"} Related pages
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %strong finiteness space
            is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            together with a collection of its subsets that behave, in certain ways, like the collection of finite subsets.
          %h2#definition Definition
          %p
            Given a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                  %mo ⊆
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{U} \subseteq P(X)
            of its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒰
                    %mo ⊥
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi v
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi u
                  %mo ∩
                  %mi v
                  %mspace{:width => "thickmathspace"}
                  %mtext is finite for all
                  %mspace{:width => "thickmathspace"}
                  %mi u
                  %mo ∈
                  %mi 𝒰
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathcal{U}^\perp = \{ v \in P(X) \mid u \cap v \;\text{ is finite for all }\; u\in \mathcal{U} \}.
          %p
            This defines a
            %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(X)
          .un_defn
            %h6#definition_2 Definition
            %p
              A
              %strong finiteness space
              is a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                    %mo ⊆
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{U} \subseteq P(X)
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                      %mo =
                      %msup
                        %mi 𝒰
                        %mrow
                          %mo ⊥
                          %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{U} = \mathcal{U}^{\perp\perp}
          %p
            We refer to the elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            as
            = succeed "," do
              %strong finitary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒰
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \mathcal{U}^\perp
            as
            = succeed "." do
              %strong cofinitary
          %h2#properties Properties
          %ul
            %li
              %p
                All finite subsets of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                belong to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒰
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}^\perp
                for any
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒰
                      %annotation{:encoding => "application/x-tex"} \mathcal{U}
            %li
              %p
                Any set of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒰
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}^\perp
                is down-closed, i.e. contains all subsets of its elements. Thus, any subset of a finitary subset is finitary, and any subset of a cofinitary subset is cofinitary.
            %li
              %p
                Any set of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒰
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}^\perp
                is closed under finite unions. Thus, any finite union of finitary subsets is finitary, and any finite union of cofinitary subsets is cofinitary.
          %h2#examples Examples
          %ul
            %li
              %p
                Taking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                      %mo =
                    %annotation{:encoding => "application/x-tex"} \mathcal{U} =
                all finite subsets of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                gives a
                %strong minimal
                finiteness structure on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                Dually, taking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                      %mo =
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}=
                all subsets of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                gives a
                %strong maximal
                finiteness structure.
            %li
              %p
                In fact, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi 𝒰
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\mathcal{U})
                is a finiteness space, so is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msup
                          %mi 𝒰
                          %mo ⊥
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\mathcal{U}^\perp)
                = succeed "." do
                  %strong dual
            %li
              %p
                We cannot obtain any other finiteness spaces purely by cardinality restriction. For instance, if all countable subsets of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                are finitary, then all cofinitary subsets must be finite, hence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is maximal. Thus, to obtain finiteness spaces other than the minimal or maximal ones, we must invoke some other structure on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
                the set of all subsets of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                that are
                = succeed "," do
                  %em noetherian
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
                %em artinian
                (contain no infinite strictly decreasing chains) and
                %em narrow
                (contain no infinite
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/antichains"} antichains
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/linearly+ordered+set"} linearly ordered set
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
                the set of all
                %em left-finite
                subsets, i.e. those
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∩
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi x
                      %mo ≤
                      %mi y
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} u\cap \{ x \mid x \le y\}
                is finite for all
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒱
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}^\perp
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
                the set of subsets
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mi x
                        %mo ≤
                        %mi y
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{x \mid x\le y\}
          %h2#categories_of_finiteness_spaces Categories of finiteness spaces
          %p
            A
            %strong relation
            or
            %strong morphism
            of finiteness spaces is a
            %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            such that
          %ol
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} u\subseteq X
              is finitary, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi u
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ∈
                    %mi Y
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo ∃
                    %mi x
                    %mo ∈
                    %mi u
                    %mo ,
                    %mi x
                    %mi R
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} R[u] = \{ y\in Y \mid \exists x\in u, x R y \}
              is finitary.
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ⊆
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} v\subseteq Y
              is cofinitary, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} [
                    %mi v
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi X
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mo ∃
                    %mi y
                    %mo ∈
                    %mi v
                    %mo ,
                    %mi x
                    %mi R
                    %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} R^{-1}[v] = \{ x\in X \mid \exists y\in v, x R y \}
              is cofinitary.
          %p An equivalent way to say this is that
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} u\subseteq X
              is finitary and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ⊆
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} v\subseteq Y
              is cofinitary, then the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi x
                    %mo ∈
                    %mi u
                    %mo ∧
                    %mi y
                    %mo ∈
                    %mi v
                    %mo ∧
                    %mi x
                    %mi R
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo ⊆
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \{ (x,y) \mid x\in u \wedge y\in v \wedge x R y \} \subseteq X \times Y
              has finite images under both projections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\times Y\to X
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\times Y\to Y
          %p
            Additionally, in the presence of condition (1), condition (2) is equivalent to its special case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi rel
                %annotation{:encoding => "application/x-tex"} FinSp_{rel}
            denote the category of finiteness spaces and relations, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi par
                %annotation{:encoding => "application/x-tex"} FinSp_{par}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi fun
                %annotation{:encoding => "application/x-tex"} FinSp_{fun}
            its
            %a.existingWikiWord{:href => "/nlab/show/wide+subcategories"} wide subcategories
            in which the morphisms are restricted to be
            %a.existingWikiWord{:href => "/nlab/show/partial+functions"} partial functions
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
          %p
            Note that a partial function lies in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi par
                %annotation{:encoding => "application/x-tex"} FinSp_{par}
            if and only if the preimage of any cofinitary subset is cofinitary. For this is precisely the second condition above specialized to a partial function, while conversely if this holds then for any finitary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} u\subseteq X
            and cofinitary
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ⊆
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} v\subseteq Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ∩
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mo ∩
                  %mi v
                %annotation{:encoding => "application/x-tex"} u\cap f^{-1}(v) \to f(u) \cap v
            so that finiteness of the former implies finiteness of the latter.
          %h3#monoidal_structures Monoidal structures
          %ul
            %li
              All three categories are
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
              and the inclusions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi fun
                    %mo ↪
                    %msub
                      %mi FinSp
                      %mi par
                    %mo ↪
                    %msub
                      %mi FinSp
                      %mi rel
                  %annotation{:encoding => "application/x-tex"} FinSp_{fun} \hookrightarrow FinSp_{par} \hookrightarrow FinSp_{rel}
              are strict symmetric monoidal.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi rel
                  %annotation{:encoding => "application/x-tex"} FinSp_{rel}
              is
              %a.existingWikiWord{:href => "/nlab/show/star-autonomous"} star-autonomous
              (see
              = succeed ")." do
                %a{:href => "#Ehrhard05"} Ehrhard
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi par
                  %annotation{:encoding => "application/x-tex"} FinSp_{par}
              is
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              (see
              = succeed ")." do
                %a{:href => "#BCJS18"} BCJS
          %h3#initial_and_terminal_structures Initial and terminal structures
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Set
                    %mi par
                %annotation{:encoding => "application/x-tex"} Set_{par}
            denote the category of sets and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/partial+functions"} partial functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Set
                    %mi par
                %annotation{:encoding => "application/x-tex"} Set_{par}
            is equivalent to the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Set
                    %mo *
                %annotation{:encoding => "application/x-tex"} Set_*
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
          %p
            The following theorem says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi par
                %annotation{:encoding => "application/x-tex"} FinSp_{par}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi fun
                %annotation{:encoding => "application/x-tex"} FinSp_{fun}
            are
            %em almost
            %a.existingWikiWord{:href => "/nlab/show/topological+concrete+categories"} topological concrete categories
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Set
                    %mi par
                %annotation{:encoding => "application/x-tex"} Set_{par}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            respectively.
          .un_theorem
            %h6#theorem Theorem
            %p
              The (
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"}> faithful
              ) forgetful functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi par
                    %mo :
                    %msub
                      %mi FinSp
                      %mi par
                    %mo →
                    %msub
                      %mi Set
                      %mi par
                  %annotation{:encoding => "application/x-tex"} U_{par}:FinSp_{par} \to Set_{par}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi fun
                    %mo :
                    %msub
                      %mi FinSp
                      %mi fun
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U_{fun}:FinSp_{fun} \to Set
              have
              %a.existingWikiWord{:href => "/nlab/show/initial+lifts"} initial lifts
              for all (possibly large)
              %a.existingWikiWord{:href => "/nlab/show/sink"} sources
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi i
                    %mo :
                    %mi X
                    %mo ⇀
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ f_i : X \rightharpoonup U(S_i) \}
              having the property that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
              there exists an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in dom(f_i)
          .proof
            %h6#proof Proof
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi fun
                  %annotation{:encoding => "application/x-tex"} U_{fun}
              is simply the pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi par
                  %annotation{:encoding => "application/x-tex"} U_{par}
              along the inclusion
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo ↪
                      %msub
                        %mi Set
                        %mi par
                    %annotation{:encoding => "application/x-tex"} Set \hookrightarrow Set_{par}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a set and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi f
                      %mi i
                    %mo :
                    %mi X
                    %mo ⇀
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ f_i : X \rightharpoonup U(S_i) \}
              a
              = succeed "-structured" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %a.existingWikiWord{:href => "/nlab/show/sink"} source
              satisfying the given condition, where each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %msub
                      %mi 𝒱
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_i,\mathcal{V}_i)
              is a finiteness space. Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                      %mo =
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                        %mi i
                      %msubsup
                        %mi f
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi 𝒱
                        %mi i
                        %mo ⊥
                      %mo{:stretchy => "false"} )
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathcal{V} = \big(\bigcup_i f_i^{-1}(\mathcal{V}_i^\perp)\big)^\perp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a finiteness space for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} u\subseteq X
              is finitary if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∩
                    %msubsup
                      %mi f
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \cap f_i^{-1}(v)
              is finite for all cofinitary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ⊆
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} v\subseteq S_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
              becomes a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi FinSp
                        %mi par
                    %annotation{:encoding => "application/x-tex"} FinSp_{par}
            %p
              For universality, suppose given a finiteness space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              and a partial function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ⇀
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g:U(T)\rightharpoonup X
              such that each composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f_i\circ g
              is a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi FinSp
                        %mi par
                    %annotation{:encoding => "application/x-tex"} FinSp_{par}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %mo ∘
                    %mi g
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_i\circ g)^{-1}(v)
              is cofinitary for all cofinitary
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ⊆
                      %msub
                        %mi S
                        %mi i
                    %annotation{:encoding => "application/x-tex"} v\subseteq S_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∩
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi f
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \cap g^{-1}(f_i^{-1}(v))
              is finite for all finitary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ⊆
                      %mi T
                    %annotation{:encoding => "application/x-tex"} u\subseteq T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %msubsup
                      %mi f
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(u) \cap f_i^{-1}(v)
              is finite (being a surjective image of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∩
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi f
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u \cap g^{-1}(f_i^{-1}(v))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(u)
              is finitary, i.e. condition (1) in the definition of morphism holds.
            %p
              Thus it remains to show that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
              the preimage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g^{-1}(x)
              is cofinitary in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in dom(f_i)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msubsup
                        %mi f
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x\in f_i^{-1}(f_i(x))
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi f
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g^{-1}(x) \subseteq g^{-1}(f_i^{-1}(f_i(x)))
          %p
            In the case of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi fun
                  %annotation{:encoding => "application/x-tex"} U_{fun}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is inhabited then so is the set of indices
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "-structured" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi fun
                  %annotation{:encoding => "application/x-tex"} U_{fun}
          %p
            In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi fun
                %annotation{:encoding => "application/x-tex"} FinSp_{fun}
            does not have a terminal object, though it does have all inhabited limits, and the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi fun
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} FinSp_{fun} \to Set
            is a Grothendieck fibration.
          %p
            A similar argument shows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi par
                %annotation{:encoding => "application/x-tex"} FinSp_{par}
            has all inhabited limits. (The above is essentially the argument given for this in
            = succeed "," do
              %a{:href => "#BCJS18"} BCJS
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Set
                    %mi par
                %annotation{:encoding => "application/x-tex"} Set_{par}
            in terms of the equivalence to
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Set_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi par
                %annotation{:encoding => "application/x-tex"} FinSp_{par}
            also has a terminal object, namely the empty set with its unique finiteness structure, so it is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete category
          %p
            In fact,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi par
                %annotation{:encoding => "application/x-tex"} FinSp_{par}
            is also a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
            = succeed "." do
              %a{:href => "#BCJS18"} BCJS
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi par
                  %annotation{:encoding => "application/x-tex"} U_{par}
            = succeed "-structured" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi par
                  %annotation{:encoding => "application/x-tex"} U_{par}
          %h2#Matrices Matrices
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be any
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/semiring"} semiring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FMat
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} FMat(R)
            as follows:
          %ul
            %li Its objects are finiteness spaces.
            %li
              Its morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              are functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} M:X\times Y \to R
              whose support
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ (x,y) \mid M(x,y) \neq 0 \}
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi FinSp
                        %mi rel
                    %annotation{:encoding => "application/x-tex"} FinSp_{rel}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi rel
                  %annotation{:encoding => "application/x-tex"} FinSp_{rel}
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} supp(M):X\to Y
          %p
            The composite of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} M:X\to Y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo :
                  %mi Y
                  %mo →
                  %mi Z
                %annotation{:encoding => "application/x-tex"} N:Y\to Z
            is defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                      %mo ≠
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (N M)(x,z) = \sum_{M(x,y)\neq 0 \neq N(y,z)} N(y,z) \cdot M(x,y).
          %p
            To see that this is well-defined, first note that by assumption, for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ y \mid M(x,y)\neq 0 \}
            is finitary, and for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ y \mid N(y,z)\neq 0 \}
            is cofinitary. Thus their intersection is finite, so the above sum is finite and thus makes sense. Now to check that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mi M
                %annotation{:encoding => "application/x-tex"} N M
            is indeed a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X\to Y
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FMat
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} FMat(R)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} (N M)(x,z)\neq 0
            it must be that there exists a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            such thath
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                    %mo ≠
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(x,y)\neq 0 \neq N(y,z)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (supp(N) \circ supp(M))(x,z)
            holds. In other words,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} supp(N M) \subseteq supp(N) \circ supp(M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} supp(N M)
            is also a morphism in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi rel
                  %annotation{:encoding => "application/x-tex"} FinSp_{rel}
          %p
            It is straightforward to check associativity and unitality, so we have a category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FMat
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} FMat(R)
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FMat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} FMat(R)
                is enriched over abelian monoids (abelian groups if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is a ring), and indeed over
                = succeed "-modules." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FMat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} FMat(R)
                has a
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
                (the empty finiteness space) and finite
                %a.existingWikiWord{:href => "/nlab/show/biproducts"} biproducts
                (disjoint unions of finiteness spaces).
            %li
              %p
                Any
                %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distributive lattice
                is a semiring with
                %a.existingWikiWord{:href => "/nlab/show/join"} join
                as addition and
                %a.existingWikiWord{:href => "/nlab/show/meet"} meet
                as multiplication. In the case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo ⊥
                      %mo ,
                      %mo ⊤
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} R= \{\bot,\top\}
                the set of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FMat
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi FinSp
                          %mi rel
                      %annotation{:encoding => "application/x-tex"} FMat(R) = FinSp_{rel}
            %li
              %p
                The proof above that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mi M
                        %mo{:stretchy => "false"} )
                        %mo ⊆
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi supp
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} supp(N M) \subseteq supp(N) \circ supp(M)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                we have an identity-on-objects
                %a.existingWikiWord{:href => "/nlab/show/colax+functor"} colax functor
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                        %mo :
                        %mi FMat
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi FinSp
                          %mi rel
                      %annotation{:encoding => "application/x-tex"} supp: FMat(R) \to FinSp_{rel}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FMat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} FMat(R)
                is not a 2-category, but it is when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is a distributive lattice, including the case of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi FinSp
                          %mi rel
                      %annotation{:encoding => "application/x-tex"} FinSp_{rel}
            %li
              %p
                For general
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FMat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} FMat(R)
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/star-autonomous"} star-autonomous
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo :
                      %mi FMat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi FinSp
                        %mi rel
                    %annotation{:encoding => "application/x-tex"} supp: FMat(R) \to FinSp_{rel}
                preserves this structure strictly.
            %li
              %p
                Any morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} H : X\to Y
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi FinSp
                        %mi rel
                    %annotation{:encoding => "application/x-tex"} FinSp_{rel}
                induces a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ^
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \hat{H}:X\to Y
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mat(R)
                by setting
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \hat{H}(x,y) = 1
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(x,y)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
                otherwise. However, this does not define a functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi FinSp
                        %mi rel
                      %mo →
                      %mi FMat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} FinSp_{rel} \to FMat(R)
                since morphisms of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat{H}
                need not be closed under composition, as the composite of two such might involve a finite sum of copies of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                is an additive idempotent in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                (such as when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is a distributive lattice), and when we restrict the domain to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi FinSp
                          %mi par
                      %annotation{:encoding => "application/x-tex"} FinSp_{par}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                      %mo :
                      %msub
                        %mi FinSp
                        %mi par
                      %mo →
                      %mi FMat
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \chi : FinSp_{par} \to FMat(R)
                for any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                that is a partial section of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi supp
                      %annotation{:encoding => "application/x-tex"} supp
          %h2#linearization Linearization
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒰
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{U})
            be a finiteness space and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            (or more generally an abelian
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi A
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi 𝒰
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} A \langle X\rangle = \{ f : X\to A \mid supp(f) \in \mathcal{U} \}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi X
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} supp(f) = \{ x\in X \mid f(x)\neq 0 \}
            is the
            %a.existingWikiWord{:href => "/nlab/show/support"} support
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} A\langle X\rangle
            is an abelian group called the
            %strong linearization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (with coefficients in
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Note that if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo ⊥
                    %mo ,
                    %mo ⊤
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} A=\{\bot,\top\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} A\langle X\rangle
            is just the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} \mathcal{U}
            of finitary subsets of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            It is shown in
            %a{:href => "#BCJS18"} BCJS
            that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a partial finiteness monoid (i.e. a monoid in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi par
                  %annotation{:encoding => "application/x-tex"} FinSp_{par}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} R\langle X\rangle
            is also a ring with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ⋅
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi m
                        %mn 1
                      %mo ,
                      %msub
                        %mi m
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi X
                        %mi m
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi m
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi g
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi m
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f\cdot g)(m) = \sum_{(m_1,m_2)\in X_m(f,g)} f(m_1)\cdot g(m_2)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi m
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_m(f,g)
            is the set of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi m
                    %mn 1
                  %mo ,
                  %msub
                    %mi m
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (m_1,m_2)\in supp(f) \times supp(g)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi m
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi m
                      %mn 2
                    %mo =
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m_1 \cdot m_2 = m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            need only be a semiring (in which case so is
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} ⟨
                    %mi X
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} R\langle X\rangle
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is merely a monoid in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi rel
                  %annotation{:encoding => "application/x-tex"} FinSp_{rel}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} ⟨
                    %mi X
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mi FMat
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R\langle X\rangle = FMat(R)(1,X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the one-element finiteness space (the monoidal unit, which is terminal in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi FinSp
                    %mi fun
                %annotation{:encoding => "application/x-tex"} FinSp_{fun}
            but not in any of the other categories of finitenes spaces). Thus,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} R\langle X\rangle
            inherits a multiplicative monoid structure as soon as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a monoid object in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FMat
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} FMat(R)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo :
                    %msub
                      %mi FinSp
                      %mi par
                    %mo →
                    %mi FMat
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi : FinSp_{par} \to FMat(R)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi FinSp
                      %mi rel
                  %annotation{:encoding => "application/x-tex"} FinSp_{rel}
          %h3#examples_2 Examples
          %ul
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
