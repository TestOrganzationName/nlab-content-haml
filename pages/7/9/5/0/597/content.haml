            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %em
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of a sink along a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ′
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} B' \to B
            is defined in the evident way.
          %p
            By a (many-object)
            %strong
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            we will mean a family of objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi A
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{A_i\}_{i\in I}
            together with, for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i,j\in I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi i
                  %mo ←
                  %msub
                    %mi R
                    %mrow
                      %mi i
                      %mi j
                  %mo →
                  %msub
                    %mi A
                    %mi j
                %annotation{:encoding => "application/x-tex"} A_i \leftarrow R_{i j} \to A_j
            (that is, a
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mrow
                      %mi i
                      %mi j
                %annotation{:encoding => "application/x-tex"} R_{i j}
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo ×
                    %msub
                      %mi A
                      %mi j
                  %annotation{:encoding => "application/x-tex"} A_i \times A_j
          %ul
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexive
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mrow
                          %mi i
                          %mi i
                    %annotation{:encoding => "application/x-tex"} R_{i i}
                contains the
                %a.existingWikiWord{:href => "/nlab/show/diagonal+morphism"} diagonal
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi i
                        %mo →
                        %msub
                          %mi A
                          %mi i
                        %mo ×
                        %msub
                          %mi A
                          %mi i
                      %annotation{:encoding => "application/x-tex"} A_i \to A_i \times A_i
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive
                if the pullback
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mrow
                          %mi i
                          %mi j
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi A
                            %mi j
                      %msub
                        %mi R
                        %mrow
                          %mi j
                          %mi k
                    %annotation{:encoding => "application/x-tex"} R_{i j} \times_{A_j} R_{j k}
                factors through
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi R
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} R_{i k}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ,
                        %mi k
                      %annotation{:encoding => "application/x-tex"} i,j,k
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mrow
                          %mi i
                          %mi j
                    %annotation{:encoding => "application/x-tex"} R_{i j}
                contains, hence is equal to, the transpose of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mrow
                          %mi j
                          %mi i
                    %annotation{:encoding => "application/x-tex"} R_{j i}
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                      %annotation{:encoding => "application/x-tex"} i,j
            %li
              %p
                a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
                if it is reflexive, transitive, and symmetric; this is an internal notion of (many-object)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          %p
            Abstractly, reflexive and transitive relations can be identified with categories
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            in a suitable
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            = succeed "." do
              %a{:href => "#Street"} Street 1984
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dagger-categories"} categories
          %p
            A
            %strong quotient
            for a relation is a
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            for the diagram consisting of all the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi i
                %annotation{:encoding => "application/x-tex"} A_i
            and all the spans
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo ←
                    %msub
                      %mi R
                      %mrow
                        %mi i
                        %mi j
                    %mo →
                    %msub
                      %mi A
                      %mi j
                  %annotation{:encoding => "application/x-tex"} A_i \leftarrow R_{i j} \to A_j
            %strong kernel
            of a sink
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi f
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi A
                    %mi i
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{f_i\colon A_i\to B\}
            is the relation on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi A
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{A_i\}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mrow
                        %mi i
                        %mi j
                    %mo =
                    %msub
                      %mi A
                      %mi i
                    %msub
                      %mo ×
                      %mi B
                    %msub
                      %mi A
                      %mi j
                  %annotation{:encoding => "application/x-tex"} R_{i j} = A_i \times_B A_j
          %p
            Finally, a sink is called
            %strong
              %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective-epic
            if it is the quotient of its kernel. It is called
            %strong universally effective-epic
            if any pullback of it is effective-epic.
          %h3#examples Examples
          %ul
            %li
              %p
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi I
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} {|I|} = 1
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
                %a.existingWikiWord{:href => "/nlab/show/quotient+object"} quotients
                and
                %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernels
                reduce to the usual notions.
            %li
              %p
                If
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi I
                          %mo{:stretchy => "false"} |
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} {|I|} = 0
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            %li
              %p
                Given a family of objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi A
                          %mi i
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{A_i\}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mrow
                          %mi i
                          %mi i
                      %mo =
                      %msub
                        %mi A
                        %mi i
                    %annotation{:encoding => "application/x-tex"} R_{i i}=A_i
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mrow
                          %mi i
                          %mi j
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} R_{i j}=0
                (an initial object) if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ≠
                        %mi j
                      %annotation{:encoding => "application/x-tex"} i \neq j
                %em trivial
                (empty congruences are always trivial). Then a quotient for a trivial congruence is a
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                of the objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mi i
                      %annotation{:encoding => "application/x-tex"} A_i
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi f
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi A
                        %mi i
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{f_i\colon A_i\to B\}
                is trivial iff the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi i
                    %annotation{:encoding => "application/x-tex"} f_i
                are disjoint monomorphisms.
          %h2#ary_regularity_and_exactness
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            \-ary regularity and exactness
          %h3#definition_2 Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/arity+class"} arity class
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              \-ary
            if the cardinality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi I
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} {|I|}
            is
            = succeed "-small." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
          %ul
            %li
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \kappa = \{1\}
              we say
              = succeed "." do
                %strong unary
            %li
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \kappa = \omega
              is the set of finite cardinals, we say
              = succeed "." do
                %strong finitary
            %li
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              is the class of all cardinal numbers, we say
              = succeed "." do
                %strong infinitary
          #KRegular.num_theorem
            %h6#theorem Theorem
            %p
              For a category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  factors as an extremal epic sink followed by a monomorphism, and the pullback of any extremal epic
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has finite limits, and the kernel of any
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is also the kernel of some universally effective-epic sink.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
                  and has
                  %a.existingWikiWord{:href => "/nlab/show/pullback-stable+colimit"} pullback-stable
                  %a.existingWikiWord{:href => "/nlab/show/joins"} joins
                  of
                  = succeed "-small" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
          %p
            When these conditions hold, we say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
                \-ary regular
            = succeed "." do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
                \-ary coherent
            = succeed "." do
              %a{:href => "#Shulman"} Shulman 2012
          #KExact.num_theorem
            %h6#theorem_2 Theorem
            %p
              For a category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of some universally effective-epic sink.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is both
                  %a.existingWikiWord{:href => "/nlab/show/exact+category"} exact
                  and
                  = succeed "-ary" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
