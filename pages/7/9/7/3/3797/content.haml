                \-parallel maximal chain property
          %p
            A double order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is said to have the
            %strong orthogonal maximal chain property
            if every maximal
            = succeed "-chain" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \le
            = succeed "-chain" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊑
                  %annotation{:encoding => "application/x-tex"} \sqsubseteq
          .un_theorem
            %h6#theorem Theorem
            %p A double order is a tileorder iff it has both parallel maximal chain properties and the orthogonal maximal chain property.
          %h3#using_local_configuration_structure Using local configuration structure
          %p
            A double order is
            %strong strongly antisymmetric
            if two unequal elements are never related (in either direction) by both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊏
                  %annotation{:encoding => "application/x-tex"} \sqsubset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≠
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\neq b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\lt b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo &lt;
                    %mi a
                  %annotation{:encoding => "application/x-tex"} b\lt a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊏
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\sqsubset b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ⊏
                  %mi a
                %annotation{:encoding => "application/x-tex"} b\sqsubset a
            holds.
          %p
            A double order is
            %strong rectangular
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi c
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊑
                  %mi c
                  %mo ≤
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exists c.(a\sqsubseteq c \le b)
            iff
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∃
                    %mi d
                    %mo .
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ≤
                    %mi d
                    %mo ⊑
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists d.(a\le d \sqsubseteq b)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi c
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊑
                  %mi c
                  %mo ≥
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exists c.(a\sqsubseteq c \ge b)
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∃
                    %mi d
                    %mo .
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ≥
                    %mi d
                    %mo ⊑
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists d.(a\ge d \sqsubseteq b)
          %p
            A double order is
            %strong total
            if for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a,b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            such that either
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊑
                    %mi c
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\sqsubseteq c \le b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊑
                    %mi c
                    %mo ≥
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\sqsubseteq c \ge b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≤
                    %mi c
                    %mo ⊑
                    %mi a
                  %annotation{:encoding => "application/x-tex"} b \le c \sqsubseteq a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≥
                    %mi c
                    %mo ⊑
                    %mi a
                  %annotation{:encoding => "application/x-tex"} b\ge c \sqsubseteq a
          %p
            A double order has the
            %strong
              first
              = succeed "-orthogonal" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊏
                    %annotation{:encoding => "application/x-tex"} \sqsubset
            if given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo ,
                  %mi d
                %annotation{:encoding => "application/x-tex"} a,b,c,d
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ⊑
                    %mi a
                  %annotation{:encoding => "application/x-tex"} c\sqsubseteq a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ⊑
                    %mi b
                  %annotation{:encoding => "application/x-tex"} c\sqsubseteq b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ⊑
                    %mi b
                  %annotation{:encoding => "application/x-tex"} d\sqsubseteq b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≤
                    %mi a
                  %annotation{:encoding => "application/x-tex"} d\le a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ⊑
                  %mi e
                  %mo ⊑
                  %mi b
                %annotation{:encoding => "application/x-tex"} c\sqsubseteq e \sqsubseteq b
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≤
                    %mi e
                    %mo ≤
                    %mi a
                  %annotation{:encoding => "application/x-tex"} d\le e \le a
            %strong second
            such property is defined by replacing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \le
            by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                  %annotation{:encoding => "application/x-tex"} \ge
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊑
                  %annotation{:encoding => "application/x-tex"} \sqsubseteq
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo &lt;
                  %annotation{:encoding => "application/x-tex"} \lt
              \-orthogonal
            such properties are defined by switching the roles of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊑
                %annotation{:encoding => "application/x-tex"} \sqsubseteq
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \le
          %p
            A double order has the
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⊏
                  %annotation{:encoding => "application/x-tex"} \sqsubset
              \-parallel butterfly factorization property
            if given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi c
                  %mo ,
                  %mi d
                %annotation{:encoding => "application/x-tex"} a,b,c,d
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ⊑
                    %mi a
                  %annotation{:encoding => "application/x-tex"} c\sqsubseteq a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≤
                    %mi c
                  %annotation{:encoding => "application/x-tex"} b\le c
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ⊑
                    %mi b
                  %annotation{:encoding => "application/x-tex"} d\sqsubseteq b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≤
                    %mi a
                  %annotation{:encoding => "application/x-tex"} d\le a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ≤
                  %mi e
                  %mo ≤
                  %mi c
                %annotation{:encoding => "application/x-tex"} b\le e \le c
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≤
                    %mi e
                    %mo ≤
                    %mi a
                  %annotation{:encoding => "application/x-tex"} d\le e \le a
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo &lt;
                  %annotation{:encoding => "application/x-tex"} \lt
              \-parallel
            such property is defined by switching the roles of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊑
                %annotation{:encoding => "application/x-tex"} \sqsubseteq
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \le
          .un_theorem
            %h6#theorem_2 Theorem
            %p A double order is a tileorder iff it is strongly antisymmetric, rectangular, total, and has all the orthogonal and parallel butterfly factorization properties.
