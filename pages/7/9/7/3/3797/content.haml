              %semantics
                %mrow
                  %mi e
                  %mo ∈
                  %mi K
                  %mo ∩
                  %mi L
                %annotation{:encoding => "application/x-tex"} e\in K\cap L
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo ⊏
                    %mi e
                  %annotation{:encoding => "application/x-tex"} k_1\sqsubset e
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mn 1
                    %mo ⊏
                    %mi e
                  %annotation{:encoding => "application/x-tex"} l_1\sqsubset e
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⊏
                    %msub
                      %mi k
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} e\sqsubset k_2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ⊏
                    %msub
                      %mi l
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} e\sqsubset l_2
            = succeed "-chains" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
