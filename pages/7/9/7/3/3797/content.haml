                    %msub
                      %mi k
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} k_1 \sqsubset k_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo ≤
                    %msub
                      %mi l
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} k_1 \le l_1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi l
                      %mn 2
                    %mo ≤
                    %msub
                      %mi k
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} l_2 \le k_2
