          %h2#idea Idea
          %p
            The sine function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                %annotation{:encoding => "application/x-tex"} \sin
            is one of the basic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/trigonometric+functions"} trigonometric functions
          %p
            It may be thought of as assigning to any
            %a.existingWikiWord{:href => "/nlab/show/angle"} angle
            the
            %a.existingWikiWord{:href => "/nlab/show/distance"} distance
            to a chosen axis of the point on the
            %a.existingWikiWord{:href => "/nlab/show/unit+circle"} unit circle
            with that angle to that axis.
          %h2#definitions Definitions
          %p
            The
            %em sine function
            is the
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \sin \;\colon\; \mathbb{R} \to \mathbb{R}
            from the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            to themselves which is characterized by the following equivalent conditions:
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sin
                    %annotation{:encoding => "application/x-tex"} \sin
                is the unique
                %a.existingWikiWord{:href => "/nlab/show/solution"} solution
                among
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                to the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
                %a.existingWikiWord{:href => "/nlab/show/initial+value+problem"} initial value problem
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sin
                      %mo ″
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi sin
                    %annotation{:encoding => "application/x-tex"}
                      sin'' = -sin
              %p
                (where a prime indicates the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi sin
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mi sin
                              %mo ′
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mn 1
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      sin(0) &amp;= 0
                      \\\
                      sin'(0) &amp; = 1
                      \\,.
                      \\end{aligned}
            %li
              %p
                (
                %a.existingWikiWord{:href => "/nlab/show/Euler%27s+formula"}> Euler's formula
                )
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sin
                    %annotation{:encoding => "application/x-tex"} \sin
                is the
                %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
                of the
                %a.existingWikiWord{:href => "/nlab/show/exponential+function"} exponential function
                with imaginary argument
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi sin
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mi Im
                              %mrow
                                %mo (
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 2
                                  %mi i
                              %mrow
                                %mo (
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mi i
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo −
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\sin(x) &amp; = Im\left( \exp(i x) \right)
                      \\\
                      \&amp; = \frac{1}{2 i}\left( \exp(i x) - \exp(- i x)\right)
                      \\end{aligned}
                      \\,.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sin
                    %annotation{:encoding => "application/x-tex"} \sin
                is the unique function which
              %ol
                %li
                  %p
                    is
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                    at
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} 0
                %li
                  %p
                    satisfies the
                    %a.existingWikiWord{:href => "/nlab/show/inequality"} inequality
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo −
                          %msup
                            %mi x
                            %mn 2
                          %mspace{:width => "thickmathspace"}
                          %mo ≤
                          %mspace{:width => "thickmathspace"}
                          %mfrac
                            %mrow
                              %mi sin
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mi x
                          %mspace{:width => "thickmathspace"}
                          %mo ≤
                          %mspace{:width => "thickmathspace"}
                          %mn 1
                        %annotation{:encoding => "application/x-tex"}
                          1 - x^2 \;\leq\; \frac{\sin(x)}{x} \;\leq\; 1
                  %p
                    and the
                    %a.existingWikiWord{:href => "/nlab/show/equation"} equation
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sin
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mn 3
                          %mi sin
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mn 4
                          %mo{:stretchy => "false"} (
                          %mi sin
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 3
                        %annotation{:encoding => "application/x-tex"}
                          \\sin(3 x) \;=\; 3 \sin(x) - 4 (\sin(x))^3
              %p
                (see
                = succeed ":" do
                  %a{:href => "#Trimble"} Trimble
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/toddtrimble/published/Characterization+of+sine"} Characterization of sine
                = succeed ".)" do
                  %a{:href => "https://nforum.ncatlab.org/discussion/5773/a-short-note-for-todd-trimble/"} nForum
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sin
                    %annotation{:encoding => "application/x-tex"} \sin
                is the unique function given by the infinite series
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sin
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mn ∞
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi i
                      %msup
                        %mi x
                        %mrow
                          %mn 2
                          %mi i
                          %mo +
                          %mn 1
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi i
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo !
                %annotation{:encoding => "application/x-tex"} \sin(x) \coloneqq \sum_{i = 0}^{\infty} \frac{(-1)^i x^{2 i + 1}}{(2 i + 1)!}
          %h3#in_arbitrary_archimedean_ordered_fields In arbitrary Archimedean ordered fields
          %p
            In general, Archimedean ordered fields which are not
            %a.existingWikiWord{:href => "/nlab/show/sequentially+Cauchy+complete"} sequentially Cauchy complete
            do not have an sine function. Nevertheless, the sine map is still guaranteed to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/partial+function"} partial function
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
            and thus a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sequentially+Hausdorff+space"} sequentially Hausdorff space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to ensure that the sine partial function is actually a total function:
          %p
            %strong Axiom of sine function:
            %em
              For all elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x \in F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \sin(x) \in F
              such that for all positive elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi F
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in F_+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              such that for all natural numbers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mi N
                    %annotation{:encoding => "application/x-tex"} n \geq N
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi ϵ
                      %mo &lt;
                      %mrow
                        %mo (
                        %msubsup
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi i
                            %mo =
                            %mn 0
                          %mi n
                        %mfrac
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi i
                            %msup
                              %mi x
                              %mrow
                                %mn 2
                                %mi i
                                %mo +
                                %mn 1
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi i
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo !
                        %mo )
                      %mo −
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} -\epsilon \lt \left(\sum_{i = 0}^{n} \frac{(-1)^i x^{2 i + 1}}{(2 i + 1)!}\right) - \sin(x) \lt \epsilon
          %p
            There is another axiom which uses the fact that derivatives of functions are well defined in the
            %a.existingWikiWord{:href => "/nlab/show/ordered+local+ring"} ordered local
            %a.existingWikiWord{:href => "/nlab/show/local+Artin+algebra"}
              Artin
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi ϵ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} F[\epsilon]/\epsilon^2
            by the equation
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} f(x + \epsilon) = f(x) + f'(x) \epsilon
          %p
            %strong Axiom of sine and cosine functions:
            %em
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ϵ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F[\epsilon]/\epsilon^2
              be the ordered local Artin
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %a.existingWikiWord{:href => "/nlab/show/nilpotent+element"} nilpotent element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ϵ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \epsilon \in F[\epsilon]/\epsilon^2
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϵ
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon^2 = 0
              and canonical
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mi F
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} h:F \to F[x]/x^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sin
                    %mo :
                    %mi F
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \sin:F \to F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cos
                    %mo :
                    %mi F
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \cos:F \to F
              and functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
