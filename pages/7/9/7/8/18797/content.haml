                      %mo =
                      %mn 0
                    %mi n
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi i
                      %msup
                        %mi x
                        %mrow
                          %mn 2
                          %mi i
                          %mo +
                          %mn 1
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi i
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo !
                %annotation{:encoding => "application/x-tex"} \sum_{i = 0}^{n} \frac{(-1)^i x^{2 i + 1}}{(2 i + 1)!}
          %p
            does not have a limit for all modulated Cantor real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}_C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_C
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            = succeed ";" do
