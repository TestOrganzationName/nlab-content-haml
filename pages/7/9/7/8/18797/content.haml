                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mi C
