                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+fundamental+super+p-branes"} geometry of physics – fundamental super p-branes
                %a.existingWikiWord{:href => "/schreiber/show/Super+Lie+n-algebra+of+Super+p-branes"} talk notes (2016/17)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
