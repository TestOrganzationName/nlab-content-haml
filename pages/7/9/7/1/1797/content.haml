                  %p
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/equation"} equation
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/fiber+product"}> fiber product
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                    %li
                      %p
                        %strong Examples.
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/linear+equation"}> linear equation
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/differential+equation"} differential equation
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+equation"} ordinary differential equation
                            %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equation"}> Euler-Lagrange equation
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/Einstein+equation"} Einstein equation
                            %a.existingWikiWord{:href => "/nlab/show/wave+equation"} wave equation
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+equation"}> Schrödinger equation
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/Knizhnik-Zamolodchikov+equation"} Knizhnik-Zamolodchikov equation
                            = succeed "," do
