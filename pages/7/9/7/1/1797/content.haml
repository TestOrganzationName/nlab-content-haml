                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
                        %a.existingWikiWord{:href => "/nlab/show/definitional+isomorphism"} definitional isomorphism
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/isomorphism"}> isomorphism
                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                        %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence in an (∞,1)-category
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"}> natural equivalence
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/gauge+equivalence"} gauge equivalence
                    %li
                      %p
                        %strong Examples.
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"}> equivalence of categories
                          ,
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/weak+equivalence+of+internal+categories"} weak equivalence of internal categories
                          = succeed "," do
