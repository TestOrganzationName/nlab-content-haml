                          %mo =
                        %annotation{:encoding => "application/x-tex"} =
                  %foreignobject#svg_26444_14{"font-size" => "16", :height => "20", :width => "21", :x => "475", :y => "82"}
                    %math{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
