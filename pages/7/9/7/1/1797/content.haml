          %p Furthermore, although an adjoint equivalence is a “stronger” or “more structured” notion than a mere equivalence, the property of “being adjoint equivalent” is no stronger a condition than “being equivalent,” since every equivalence may be refined to an adjoint equivalence by modifying one of the natural isomorphisms involved. More specifically:
          .num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f\colon X\to Y
              is a morphism which is an equivalence, then given any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g\colon Y\to X
              and any isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                      %mo ≅
                      %mi g
                      %mi f
                    %annotation{:encoding => "application/x-tex"} \eta\colon 1 \cong g f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mi g
                    %mo ≅
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \varepsilon\colon f g \cong 1
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo ,
                    %mi η
                    %mo ,
                    %mi ε
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g,\eta,\varepsilon)
              is an adjoint equivalence.
          .proof
            %h6#proof_2 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an equivalence, there exists a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g'
              and isomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi g
                    %mo ′
                    %mo ≅
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f g' \cong 1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≅
                      %mi g
                      %mo ′
                      %mi f
                    %annotation{:encoding => "application/x-tex"} 1\cong g' f
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ≅
                      %mi g
                      %mi f
                      %mi g
                      %mo ′
                      %mo ≅
                      %mi g
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} g \cong g f g' \cong g'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi g
                    %mo ′
                    %mo ≅
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f g' \cong 1
              also induces an isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mi g
                      %mo ≅
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f g\cong 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} \xi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              may not satisfy the zigzag identities, but if we define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                  %annotation{:encoding => "application/x-tex"} \varepsilon
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi g
                    %mover
                      %mo →
                      %mrow
                        %mi f
                        %mi g
                        %msup
                          %mi ξ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mi f
                    %mi g
                    %mi f
                    %mi g
                    %mover
                      %mo →
                      %mrow
                        %mi f
                        %msup
                          %mi η
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi g
                    %mi f
                    %mi g
                    %mover
                      %mo →
                      %mi ξ
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    f g
                    \\xrightarrow{f g \xi^{-1}} f g f g
                    \\xrightarrow{f \eta^{-1} g} f g
                    \\xrightarrow{\xi} 1
            %p
              then we can verify, using string diagram notation as above, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                  %annotation{:encoding => "application/x-tex"} \varepsilon
              satisfies one zigzag identity, and hence (by the previous lemma) also the other:
            %div
              %svg{:height => "200", "se:nonce" => "26444", :width => "600", :xmlns => "http://www.w3.org/2000/svg", "xmlns:se" => "http://svg-edit.googlecode.com"}
                %g
                  %title Layer 1
                  %path#svg_26444_2{:d => "m91,175l1,-86c2.666687,-27 -27.666672,-35 -28,0c0.333328,30 -29.333328,25 -29,0c1.333328,-64.333336 85.666687,-63.666664 86,0c-2,100.666656 37,71.333344 30,-1l-1,-60", :fill => "#ff0000", "fill-opacity" => "0", :stroke => "#000000", "stroke-width" => "2"}
                  %path#svg_26444_3{:d => "m287,169l1,-39c2.666992,-27 -27.666992,-38 -28,-3c0.333008,36 -26.333008,37 -25,-35c-0.666992,-68.333298 23.666992,-63.666702 25,-30c-1,41.667007 24,42.332993 25,-2l1,-37", :fill => "#ff0000", "fill-opacity" => "0", :stroke => "#000000", "stroke-width" => "2"}
                  %ellipse#svg_26444_4{:cx => "397", :cy => "82", :fill => "#ff0000", "fill-opacity" => "0", :rx => "14", :ry => "33", :stroke => "#000000", "stroke-width" => "2"}
                  %line#svg_26444_5{:fill => "none", "fill-opacity" => "0", :stroke => "#000000", "stroke-width" => "2", :x1 => "433", :x2 => "434", :y1 => "24", :y2 => "170"}
                  %line#svg_26444_6{:fill => "none", "fill-opacity" => "0", :stroke => "#000000", "stroke-width" => "2", :x1 => "538", :x2 => "539", :y1 => "27", :y2 => "173"}
                  %foreignobject#svg_26444_7{"font-size" => "16", :height => "20", :width => "21", :x => "184", :y => "85"}
                    %math{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo =
                        %annotation{:encoding => "application/x-tex"} =
                  %foreignobject#svg_26444_8{"font-size" => "16", :height => "20", :width => "21", :x => "330", :y => "84"}
                    %math{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
