          %p
            A
            %strong cogenerator
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            such that the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi S
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi C
                    %mi{:mathvariant => "normal"} op
                  %mo →
                  %mi{:mathvariant => "normal"} Set
                %annotation{:encoding => "application/x-tex"} h_S = C(-,S) : C^{\mathrm{op}} \to \mathrm{Set}
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 2
                    %mo ∈
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_1,g_2\in C(X,Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            in the sense that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo :
                  %mi Y
                  %mo →
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi θ
                  %mo ∘
                  %msub
                    %mi g
                    %mn 1
                  %mo =
                  %mi θ
                  %mo ∘
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \forall (\theta: Y \to S),\; \theta \circ g_1 = \theta \circ g_2 ,
          %p
            then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 1
                    %mo =
                    %msub
                      %mi g
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} g_1 = g_2
          %p
            One often extends this notion to a
            %strong cogenerating family
            of objects, which is a (usually
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo =
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi S
                    %mi a
                  %mo ,
                  %mi a
                  %mo ∈
                  %mi A
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathcal{S} = \lbrace S_a, a\in A\rbrace
            of objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that the family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msub
                    %mi S
                    %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(-,S_a)
            is jointly faithful. This means that for any pair
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
