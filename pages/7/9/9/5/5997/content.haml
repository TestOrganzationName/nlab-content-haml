          #nConnectedTruncatedIsStable.num_prop
            %h6 Proposition
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-connected/" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-truncated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/stable+factorization+system"} stable
              %a.existingWikiWord{:href => "/nlab/show/n-connected"} n-connected
              morphisms is preserved under
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            %p
          %p
            This appears as (
            %a{:href => "#Lurie"}> Lurie, prop. 6.5.1.16(6)
            ).
          %p
            It follows that:
          #HomotopyPullbackPreservesNImageFactorization.num_prop
            %h6 Proposition
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/n-images"} n-images
              are preserved by
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \xrightarrow{f} Y
              with
              = succeed "-image" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi im
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im_n(f)
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              its
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-pullback"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-pullback
              along any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo ′
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mi X
                  %annotation{:encoding => "application/x-tex"} g \,\colon\, X' \xrightarrow{\;} X
              may be decomposed as two consecutive
              = succeed "-pullbacks:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
