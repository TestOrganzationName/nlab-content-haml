          %h1#antisubalgebras Antisubalgebras
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#Examples"} Examples
              %li
                %a{:href => "#quotient_algebras"} Quotient algebras
              %li
                %a{:href => "#localic_point_of_view"} Localic point of view
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            by equipping an
            %a.existingWikiWord{:href => "/nlab/show/gebra"} algebra
            with a
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness"} tight apartness
            (and requiring the algebraic operations to be
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/strongly+extensional+function"} strongly extensional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring+with+tight+apartness"} ring with tight apartness
            %span.newWikiWord
              subalgebras
              %a{:href => "/nlab/new/subalgebras"} ?
            with
            = succeed "-subalgebras," do
              %em anti
            %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classically
            are simply the
            %a.existingWikiWord{:href => "/nlab/show/complements"} complements
            of subalgebras.
          %h2#definitions Definitions
          %p
            Let us work in the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+algebra"} universal algebra
            %strong algebra
            is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a family of
            %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f_i\colon X^{n_i} \to X
            (where each
            %a.existingWikiWord{:href => "/nlab/show/arity"} arity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi i
                %annotation{:encoding => "application/x-tex"} n_i
            is a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cardinal+number"} cardinal number
            %strong subalgebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi p
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi S
                %annotation{:encoding => "application/x-tex"} f_i(p_1,\ldots,p_{n_i}) \in S
            whenever each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi k
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p_k \in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi n
                    %mi i
                %annotation{:encoding => "application/x-tex"} n_i
            be finite or that there be finitely many
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi i
                  %annotation{:encoding => "application/x-tex"} f_i
            = succeed ":" do
              %strong well-behaved constants
          %ul
            %li
              each arity is either
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              or at least
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              (so each operation either is a constant or has at least one operand), and
            %li
              the number of constants is
              %a.existingWikiWord{:href => "/nlab/show/Kuratowski-finite"} Kuratowski-finite
              (so there is an exhaustive list
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo ,
                    %msub
                      %mi c
                      %mn 3
                    %mo ,
                    %mi …
                    %msub
                      %mi c
                      %mi n
                  %annotation{:encoding => "application/x-tex"} c_1, c_2, c_3, \ldots c_n
              of constants for some
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi i
                    %mo =
                    %msub
                      %mi c
                      %mi j
                  %annotation{:encoding => "application/x-tex"} c_i = c_j
              might be an equational law).
          %p
            The first item is true of all derived operations in the theory as long as it is true of the fundamental operations in the signature; but in this last item, we're counting all derived constants, not just the fundamental ones. For example, the theory of (unital)
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            does
            %em not
            have well-behaved constants, because there are infinitely many constants (one for each
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
          %p
            Now we require
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to have a
            %a.existingWikiWord{:href => "/nlab/show/tight+apartness"} tight apartness
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %msub
                        %mi n
                        %mi i
                %annotation{:encoding => "application/x-tex"} X^{n_i}
            (via
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/existential+quantification"} existential quantification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                %annotation{:encoding => "application/x-tex"} f_i
            to be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strongly+extensional+function"} strongly extensional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with these properties is called an
            = succeed "." do
              %strong inequality algebra
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %strong
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
            (or
            = succeed "-open)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} q \in A
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p \ne q
            %strong antisubalgebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an open subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi j
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} p_j \in A
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi p
                    %mrow
                      %msub
                        %mi n
                        %mi i
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} f_i(p_1,\ldots,p_{n_i}) \in A
            for any
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/contrapositive"} contrapositive
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a subalgebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and get an antisubalgebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-complement" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≠
                %annotation{:encoding => "application/x-tex"} \ne
            every element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %h2#Examples Examples
          %p
            Unless otherwise noted, all of the constructions in these examples should be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative
          %p
          .num_remark
            %h6 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/empty+subset"} empty subset
              of any algebra is an antisubalgebra, the
              %strong empty antisubalgebra
              or
              = succeed "," do
                %strong improper antisubalgebra
              %a.existingWikiWord{:href => "/nlab/show/improper+subset"} improper
              subalgebra (which is all of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %strong
                %a.existingWikiWord{:href => "/nlab/show/proper+subset"} proper
              if it is
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+subset"} inhabited
          %p
          .num_remark
            %h6 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is an antisubalgebra and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is a constant (given by an operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mn 0
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^0 \to X
              or a composite of same with other operations), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mi c
                  %annotation{:encoding => "application/x-tex"} p \ne c
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p \in A
              %strong trivial antisubalgebra
              to be the subset of those elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mi c
                  %annotation{:encoding => "application/x-tex"} p \ne c
              for each constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              (the
              = succeed "-complement" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≠
                    %annotation{:encoding => "application/x-tex"} \ne
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/trivial+subalgebra"} trivial subalgebra
              %strong trivial antisubalgebra
              to be the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of all antisubalgebras (but this is not predicative).
          %p
            The anti-analog of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
          .num_remark
            %h6 Example
            %p
              A subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of an inequality group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              %strong antisubgroup
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p \ne 1
              whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in A
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} q \in A
              whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi q
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p q \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in A
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p^{-1} \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is open; this can be proved from strong extensionality of the group operations on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the stronger form of the nullary anticlosure condition (“
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p \ne 1
              whenever
              = succeed "\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ∈
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg (1\in A)
              that would be the literal nullary case of the general definition.) An antisubgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %strong
                %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p q \in A
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mi p
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} q p \in A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/trivial+subgroup"} trivial
                antisubgroup
              is the
              = succeed "-complement" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≠
                    %annotation{:encoding => "application/x-tex"} \ne
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1\}
          %p
            The anti-analog of
            %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
            (of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/antiideals"} antiideals
            = succeed "-openness" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
          %p
          #AntiIdeals.num_remark
            %h6 Example
            %p
              A subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %strong two-sided antiideal
              (or simply an
              %strong
                %a.existingWikiWord{:href => "/nlab/show/antiideal"} antiideal
              in the commutative case) if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} p \ne 0
              whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in A
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} q \in A
              whenever
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p + q \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} q \in A
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi q
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p q \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %strong left antiideal
              if instead the last condition requires only that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              %strong right antiideal
              if instead the last condition requires only that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} q \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is proper iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} 1 \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %strong
                %a.existingWikiWord{:href => "/nlab/show/prime+ideal"} prime
              (or
              = succeed ")" do
                %em antiprime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi r
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p r q \in A
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in A
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} q \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p q \in A
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi a
                    %annotation{:encoding => "application/x-tex"} q \in a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              %strong
                %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} minimal
              (or
              = succeed ")" do
                %em antimaximal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p \in A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} r \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi q
                    %mo +
                    %mi r
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p q + r \ne 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mi p
                    %mo +
                    %mi r
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} q p + r \ne 1
              (which is constructively stronger than being prime and
              %a.existingWikiWord{:href => "/nlab/show/minimal+element"} minimal
              among proper ideals); of course, we only need one of these two inequalities in the commutative case. The
              %strong
                %a.existingWikiWord{:href => "/nlab/show/trivial+ideal"} trivial
                antiideal
              is the
              = succeed "-complement" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≠
                    %annotation{:encoding => "application/x-tex"} \ne
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0\}
          %p
          .num_remark
            %h6 Example
            %p
              Note that a
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of antisubalgebras is again an antisubalgebra.
            %p
              Given any subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %strong generated
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is the union of all antisubalgebras contained in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          %p
          .num_remark
            %h6 Example
            %p
              In some cases, we may prefer to anti-generate: given any subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %strong antigenerated
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is the union of all antisubalgebras whose elements are all distinct from (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
              ) each element of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "-complement" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≠
                    %annotation{:encoding => "application/x-tex"} \ne
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1\}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0\}
              %strong
                %span.newWikiWord
                  cyclic antisubgroup
                  %a{:href => "/nlab/new/cyclic+subgroup"} ?
              or
              %strong
                %a.existingWikiWord{:href => "/nlab/show/principal+ideal"} principal antiideal
              antigenerated by a given element of the group or ring.
          %h2#quotient_algebras Quotient algebras
          %p
            To form a
            %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            or a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quotient+ring"} quotient ring
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            or a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/two-sided+ideal"} two-sided ideal
          %p
            In general, instead of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/congruence+relations"} congruence relations
            %strong anticongruence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an
            %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that is also an antisubalgebra of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \times X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be the
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a congruence relation, giving a quotient algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi R
                  %annotation{:encoding => "application/x-tex"} X/R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            becomes a
            %a.existingWikiWord{:href => "/nlab/show/tight+relation"} tight
            apartness on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi R
                  %annotation{:encoding => "application/x-tex"} X/R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mi R
                %annotation{:encoding => "application/x-tex"} X/R
            are strongly extensional. We denote the resulting algebra-with-apartness by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X/K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is also an equivalence relation, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            must be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
            %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
            of the empty set is itself.) The quotient map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↠
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mi K
                %annotation{:encoding => "application/x-tex"} X \twoheadrightarrow X/K
            is also strongly extensional.
          %p
            Conversely, any strongly extensional map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f\colon X \to Y
            between algebras with apartness gives rise to an anticongruence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                  %mi f
                %annotation{:encoding => "application/x-tex"} \aker f
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (the
            %strong antikernel
            of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                  %mi f
                %annotation{:encoding => "application/x-tex"} (p, q) \in \aker f
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(p) \ne f(q)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is tight) the
            %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
            in the usual sense of universal algebra. Thus, the quotient algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X/(\aker f)
            is
            %a.existingWikiWord{:href => "/nlab/show/naturally+isomorphic"} naturally isomorphic
            to a
            %span.newWikiWord
              subalgebra
              %a{:href => "/nlab/new/subalgebra"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi im
                  %mi f
                %annotation{:encoding => "application/x-tex"} im f
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↠
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                  %mi f
                  %mo ↪
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \twoheadrightarrow X/(\aker f) \cong \im f \hookrightarrow Y
            are strongly extensional. Similarly, a sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                  %mover
                    %mo →
                    %mi g
                  %mi Z
                %annotation{:encoding => "application/x-tex"} X \overset{f}\to Y \overset{g} \to Z
            is
            %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                  %mi f
                %annotation{:encoding => "application/x-tex"} \im f
            is the complement of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \aker g
          %p
            (We would like to say that there is an antisubalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aim
                  %mi f
                %annotation{:encoding => "application/x-tex"} \aim f
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            whose complement is
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \im f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                  %mi g
                %annotation{:encoding => "application/x-tex"} \aker g
            equal the antiimage of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aim
                  %mi f
                %annotation{:encoding => "application/x-tex"} \aim f
            should be the
            = succeed "-complement" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \im f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is Kuratowski-finite, then this works, but in general, we can prove neither that this is open nor that its complement is all of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \im f
          %p
            Given a group-with-apartness and a normal antisubgroup
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi K
                %annotation{:encoding => "application/x-tex"} (p, q) \in K
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %msup
                      %mi q
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p q^{-1} \in A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi K
                %annotation{:encoding => "application/x-tex"} (p, q) \in K
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo −
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p - q \in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                  %mi f
                %annotation{:encoding => "application/x-tex"} p \in \aker f
            iff
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f(p) \ne 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∈
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} aker
                  %mi f
                %annotation{:encoding => "application/x-tex"} p \in \aker f
            iff
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(p) \ne 0
            %a.existingWikiWord{:href => "/nlab/show/Omega-group"} Omega-group
            structure.
          %h2#localic_point_of_view Localic point of view
          %p
            As noted at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equivalent to a (strongly) closed
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            on the corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/discrete+locale"} discrete locale
            = succeed "-open" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "-topology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            = succeed "-open" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≠
                  %annotation{:encoding => "application/x-tex"} \ne
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathsf{C}
            from open sublocales to closed ones takes arbitrary (not only finite) unions to intersections.
          %p In other words, antisubalgebras of an inequality algebra are equivalent to closed subalgebras of a localic algebra, in the case when the latter is the quotient of a discrete algebra by a closed localic congruence.
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/anti-ideal"} anti-ideal
          %h2#references References
          %p
            According to
            = succeed ":" do
              %a{:href => "#TroelstraVanDalen88"} Troelstra and van Dalen
          %blockquote
            %p
              The study of algebraic structures in an intuitionistic setting was undertaken by Heyting (
              %a{:href => "#Heyting1941"}> 1941
              )… in full generality, equipped with an apartness relation. The notion of an antisubstructure, implicit in Heyting’s treatment of ideals in polynomial rings, was formulated explicitly by D.S. Scott (
              %a{:href => "#Scott1979"}> 1979
              ) (N.B. the first draft of this paper contains a good deal more than the published version). Ruitenburg (
              %a{:href => "#Ruitenberg1982Thesis"}> 1982
              ,
              = succeed ")" do
                %a{:href => "#Ruitenberg1982"} 1982A
          %ul
            %li#Heyting1941
              %p
                %a.existingWikiWord{:href => "/nlab/show/Arend+Heyting"}> Arend Heyting
                ,
                = succeed "," do
                  %em Untersuchungen über intuitionistische Algebra
            %li#Scott1979
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dana+Scott"}> Dana Scott
                ,
                = succeed "," do
                  %em Identity and existence in intuitionistic logic
            %li#Ruitenberg1982Thesis
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wim+Ruitenberg"}> Wim Ruitenberg
                ,
                = succeed "," do
                  %em Intuitionistic Algebra
            %li#Ruitenberg1982
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wim+Ruitenberg"}> Wim Ruitenberg
                ,
                = succeed "," do
                  %em Primality and invertibility of polynomials
            %li#TroelstraVanDalen88
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anne+Sjerp+Troelstra"}> Anne Sjerp Troelstra
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Dirk+van+Dalen"} Dirk van Dalen
                = succeed "," do
                  %em Constructivism in Mathematics – An introduction
                = succeed ":" do
                  %strong 123
                = succeed "&rbrack;" do
                  %a{:href => "https://shop.elsevier.com/books/constructivism-in-mathematics-vol-2/troelstra/978-0-444-70358-3"} ISBN:9780444703583
          %p Surprisingly, antisubalgebras make hardly any appearence in
          %ul
            %li
              %span.newWikiWord>
                Ray Mines
                %a{:href => "/nlab/new/Ray+Mines"} ?
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Fred+Richman"} Fred Richman
              = succeed ":" do
                %span.newWikiWord
                  Wim Ruitenburg
                  %a{:href => "/nlab/new/Wim+Ruitenburg"} ?
              = succeed "," do
                %em A Course in Constructive Algebra
