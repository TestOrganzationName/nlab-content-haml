            %a.existingWikiWord{:href => "/nlab/show/11-dimensional+supergravity"} 11-dimensional supergravity
            with its
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi R
                    %mn 4
                %annotation{:encoding => "application/x-tex"} R^4
            %a.existingWikiWord{:href => "/nlab/show/higher+curvature+correction"} higher curvature correction
            (see
            = succeed ")" do
              %a{:href => "11-dimensional+supergravity#HigherCurvatureCorrection"} there
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
          %center
            %img{:src => "https://ncatlab.org/nlab/files/W4Inflation.jpg", :width => "600"}/
          %blockquote
            %p
              graphics from
              %a{:href => "#HiragaHyakutake18"} Hiraga-Hyakutake 18, p. 8
