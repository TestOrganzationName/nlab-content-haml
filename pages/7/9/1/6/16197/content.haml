                %a.existingWikiWord{:href => "/nlab/show/supersymmetry+breaking"} supersymmetry breaking
                (
                %a{:href => "#FerrarKehagias14"}> Ferrar-Kehagias 14
                ,
                = succeed ")" do
                  %a{:href => "#DFKRU14"} DFKRU 14
