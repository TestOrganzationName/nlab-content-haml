                (
                %a{:href => "#AlexandreHoustonMavromatos14"}> Alexandre-Houston-Mavromatos 14
                ).
          %center
            %img{:src => "https://ncatlab.org/nlab/files/DalianisDiagram.jpg", :width => "600"}/
          %blockquote
            %p
