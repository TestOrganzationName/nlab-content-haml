          %h3#in_simplicial_type_theory In simplicial type theory
          %h4#for_segal_types For Segal types
          %p
            In simplicial type theory, the Segal types are the types that represent (infinity,1)-precategories. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a
            %a.existingWikiWord{:href => "/nlab/show/Segal+type"} Segal type
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+type+theory"} simplicial type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} y:A
            be two elements in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-coproduct
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is an tuple consisting of
          %ul
            %li
              %p
                an element
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ⊔
                        %mi y
                        %mo :
                        %mi A
                      %annotation{:encoding => "application/x-tex"} x \sqcup y:A
            %li
              %p
                a morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi x
                        %mo :
                        %msub
                          %mi{:mathvariant => "normal"} hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi x
                        %mo ⊔
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i_x:\mathrm{hom}_A(x, x \sqcup y)
            %li
              %p
                a morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi y
                        %mo :
                        %msub
                          %mi{:mathvariant => "normal"} hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi x
                        %mo ⊔
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} i_y:\mathrm{hom}_A(y, x \sqcup y)
          %p
            such that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} z:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} hom
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f:\mathrm{hom}_A(x, z)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} hom
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g:\mathrm{hom}_A(y, z)
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} there exists a unique
            morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo ,
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} hom
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ⊔
                  %mi y
                  %mo ,
                  %mi z
