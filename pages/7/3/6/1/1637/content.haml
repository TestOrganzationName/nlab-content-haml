                        \-theorem
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition_via_cylinders"} Definition via cylinders
              %li
                %a{:href => "#combinatorial_definition"} Combinatorial definition
              %li
                %a{:href => "#remark__warning_on_conventions"} Remark / warning on conventions
              %li
                %a{:href => "#commentary"} Commentary
              %li
                %a{:href => "#properties"} Properties
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %strong simplicial homotopy
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            in the classical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#definition_via_cylinders Definition via cylinders
          %p
            %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            has a
            %a.existingWikiWord{:href => "/nlab/show/cylinder+functor"} cylinder functor
            given by
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
            product with the standard 1-
            %a.existingWikiWord{:href => "/nlab/show/simplex"}> simplex
            ,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo :
                    %mo =
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I := \Delta[1]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊙
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Delta[1]\odot X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            being a simplicial object in an
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
            = succeed ",(see" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Therefore for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f,g : X \to Y
            two morphisms of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi f
                  %mo ⇒
                  %mi g
                %annotation{:encoding => "application/x-tex"} \eta : f \Rightarrow g
            is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi X
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \eta : X \times \Delta[1] \to Y
            such that the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                          %mo ≃
                          %mi X
                          %mo ×
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi Id
                              %mo ×
                              %msup
                                %mi δ
                                %mn 1
                        %mtd
                          %mi X
                          %mo ×
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 1
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mover
                            %mo ←
                            %mrow
                              %mi Id
                              %mo ×
                              %msup
                                %mi δ
                                %mn 0
                        %mtd
                          %mi X
                          %mo ×
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo{:stretchy => "false"} ]
                          %mo ≃
                          %mi X
                      %mtr
                        %mtd
                        %mtd
                          %msub
                            %mrow
                            %mi f
                          %mo ↘
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi η
                        %mtd
                          %msub
                            %mo ↙
                            %mi g
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X \simeq X\times \Delta[0] &amp;\stackrel{Id \times \delta^1}{\to}&amp; X \times \Delta[1]
                  \&amp;
                  \\stackrel{Id \times \delta^0}{\leftarrow}&amp;
                  X \times \Delta[0]
                  \\simeq X
                  \\\
                  \&amp;
                  {}_f\searrow &amp;\downarrow^\eta&amp; \swarrow_{g}
                  \\\
                  \&amp;&amp;
                  Y
                  }
          %p commutes.
          %p
            Remark: Since in the standard
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            every simplicial set is cofibrant, this indeed defines left homotopies.
          %h2#combinatorial_definition Combinatorial definition
          %p
            Given morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo ,
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f,g,:X\to Y
            of simplicial objects in any category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong simplicial homotopy
            is a family of morphisms,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi i
                    %mo :
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi Y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} h_i:X_n\to Y_{n+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo =
                  %mn 0
                  %mo ,
                  %mi …
                  %mo ,
                  %mi n
                %annotation{:encoding => "application/x-tex"} i= 0,\ldots,n
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 0
                    %msub
                      %mi h
                      %mn 0
                    %mo =
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} d_0 h_0 = f_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %msub
                    %mi h
                    %mi n
                  %mo =
                  %msub
                    %mi g
                    %mi n
                %annotation{:encoding => "application/x-tex"} d_{n+1} h_n = g_n
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %msub
                    %mi h
                    %mi j
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi h
                              %mrow
                                %mi j
                                %mo −
                                %mn 1
                            %msub
                              %mi d
                              %mi i
                            %mo ,
                          %mtd
                            %mi i
                            %mo &lt;
                            %mi j
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo ,
                          %mtd
                            %mi i
                            %mo =
                            %mi j
                            %mo ≠
                            %mn 0
                        %mtr
                          %mtd
                            %msub
                              %mi h
                              %mi j
                            %msub
                              %mi d
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo ,
                          %mtd
                            %mi i
                            %mo &gt;
                            %mi j
                            %mo +
                            %mn 1
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_i h_j = \left\lbrace\array{
                  h_{j-1}d_i, &amp; i\lt j \\
                  d_i h_{i-1}, &amp;i=j\neq 0\\
                  h_j d_{i-1}, &amp; i\gt j+1.
                  }\right.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi i
                  %msub
                    %mi h
                    %mi j
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi h
                              %mrow
                                %mi j
                                %mo +
                                %mn 1
                            %msub
                              %mi s
                              %mi i
                            %mo ,
                          %mtd
                            %mi i
                            %mo ≤
                            %mi j
                        %mtr
                          %mtd
                            %msub
                              %mi h
                              %mi j
                            %msub
                              %mi s
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo ,
                          %mtd
                            %mi i
                            %mo &gt;
                            %mi j
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  s_i h_j = \left\lbrace\array{
                  h_{j+1} s_i, &amp; i\le j\\
                  h_j s_{i-1}, &amp; i\gt j.
                  }\right.
          %p
            Note that we did not explicitly say what
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %msub
                    %mi h
                    %mi j
                %annotation{:encoding => "application/x-tex"} d_i h_j
            should be when
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo =
                    %mi j
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i = j + 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %msub
                      %mi h
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} d_{j + 1} h_{j + 1}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %msub
                      %mi h
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %msub
                      %mi h
                      %mi j
                  %annotation{:encoding => "application/x-tex"} d_{j + 1} h_{j + 1} = d_{j + 1} h_j
          %p
            If we use the cylinder convention, this is equivalent to specifying a homotopy
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⇒
                    %mi f
                  %annotation{:encoding => "application/x-tex"} g \Rightarrow f
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 0
                    %mo =
                    %msub
                      %mi d
                      %mn 0
                    %msub
                      %mi h
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \eta_0 = d_0h_0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mi h
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \eta_{n+1}=d_{n+1}h_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi j
                  %mo =
                  %msub
                    %mi d
                    %mi j
                  %msub
                    %mi h
                    %mi j
                  %mo =
                  %msub
                    %mi d
                    %mi j
                  %msub
                    %mi h
                    %mrow
                      %mi j
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \eta_j = d_j h_j = d_j h_{j-1}
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1\leq j\leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi X
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \eta : X \times \Delta[1] \rightarrow Y
            as seen in the cylinder definition is then formed by the universal property of coproducts. In particular, the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta[1](n)
            has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n+2
            elements which can be presented as a string of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mi ⋯
                    %mn 01
                    %mi ⋯
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0\cdots01\cdots1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi j
                %annotation{:encoding => "application/x-tex"} \eta_j
            is the restriction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            to the string that contains exactly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            number of
            = succeed "\u2018s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %h2#remark__warning_on_conventions Remark / warning on conventions
          %p
            The above formulae give one of the, at least, two forms of the combinatorial specification of a homotopy between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi i
                  %annotation{:encoding => "application/x-tex"} h_i
          %h2#commentary Commentary
          %p
            It is fairly easy to prove that the combinatorial definition of homotopy agrees with the one via the cylinder both for simplicial sets and for simplicial objects in any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finitely+cocomplete+category"} finitely cocomplete category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/copower"} copowers
            with finite simplicial sets and hence in particular with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and a simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mo ≥
                      %mn 0
                %annotation{:encoding => "application/x-tex"} X_{\geq 0}
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ⊙
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo :
                    %mo =
                    %msub
                      %mi K
                      %mi n
                    %msub
                      %mo ⊙
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (K \odot X)_n := K_n \odot_{\mathbf{Set}}  X_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊙
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                %annotation{:encoding => "application/x-tex"} \odot_{\mathbf{Set}}
            denote the usual coproduct tensoring over sets for any category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim
              \: With only my own resources available, I was unable to find them so was hoping someone kind would come up with them. They derive from the coend formulae​/Kan extension formulae using some combinatorics to discuss the indexing sets. I think Quillen gave some form of them, but have not got a copy of HA. I needed them recently and could not find them in any of the usual sources, and did not manage to work them out using the Kan extension idea either (Help please anyone). We could do with those formulae or with a reference to them at least.
          %p
            In the case of the category of (not necessarily abelian) groups, the combinatorial definition equals the one via cylinder only if the role of “cylinder” for a group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is played by a simplicial object in the category of groups which in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            equals the free product of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n+2)
            copies of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Delta[1]_n
            (noted by Swan and quoted in exercise 8.3.5 of Weibel:
            = succeed ")." do
              %em Homological algebra
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim Porter
              \: Perhaps we need an explicit description of
              %a.existingWikiWord{:href => "/nlab/show/copower"} copowers
              in simplicial objects also. I pointed out in an edit above that the combinatorial description is much more general than just for simplicial objects in an abelian category.
            %p Can specific references to Swan be given, anyone?
            %p
              %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"}> Zoran Škoda
              \: I agree that one should talk about copowers etc.
            %p Anonymous Coward: With exercise 8.3.5 of Weibel in mind, what is the notion of “cylinder” meant in the assertion “the combinatorial definition of homotopy agrees with the one via the cylinder both for simplicial sets and for simplicial objects in any finitely cocomplete category” for a general finitely cocomplete category?
            %p
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim Porter
              \: I have transferred this question to the
              %a{:href => "https://nforum.ncatlab.org/discussion/5627/simplicial-homotopy/#Comment_69108"} nForum
              where it will be easier for others to reply. In the meantime some indication is given in Kamps and Porter as referenced below. I myself do not quite understand your question as it is presently stated, but this may be that I am too near to the subject matter to see the difficulty.
          %h2#properties Properties
          .un_lemma
            %h6#lemma Lemma
            %p
              Precisely when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∼
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo{:stretchy => "false"} (
                    %mo ∃
                    %mi simplicial
                    %mi homotopy
                    %mi f
                    %mo ⇒
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (f \sim g) \Leftrightarrow
                    (\exists simplicial homotopy f \Rightarrow g : X \to Y )
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          .proof
            %h6#proof Proof
            %p
              Since
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              this follows from general statements about
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              in model categories.
            %p The following is a direct proof.
            %p
              We first show that the homotopy between points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo :
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} x,y : \Delta[0] \to Y
              is an equivalence relation when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %p
              We identify in the following
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              with vertices in the image of these maps.
            %ul
              %li
                %p
                  \-
                  %strong> reflexivity
                  \- For every vertex
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %msub
                            %mi Y
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} x \in Y_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                        %mi x
                        %mo ∈
                        %msub
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} s_0 x \in S_1
                  has, by the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %msub
                          %mi s
                          %mn 0
                        %mi x
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} d_0 s_0 x = x
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mn 1
                          %msub
                            %mi s
                            %mn 0
                          %mi x
                          %mo =
                          %mi x
                        %annotation{:encoding => "application/x-tex"} d_1 s_0 x = x
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 1
                        %msub
                          %mi s
                          %mn 0
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi s
                              %mn 0
                            %mi x
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mn 0
                        %msub
                          %mi s
                          %mn 0
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (d_1 s_0 x) \stackrel{s_0 x}{\to} (d_0 s_0 x)
                %p
                  Therefore the morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo :
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} \eta : \Delta[0] \times \Delta[1] \to Y
                  that takes the unique non-degenerate 1-simplex in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[1]
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mn 0
                        %mi x
                      %annotation{:encoding => "application/x-tex"} s_0 x
                  constitutes a homotopy from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  to itself.
              %li
                %p
                  \-
                  %strong> transitivity
                  \- let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                        %mo :
                        %mi x
                        %mo →
                        %mi y
                      %annotation{:encoding => "application/x-tex"} v_2 : x \to y
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mn 0
                        %mo :
                        %mi y
                        %mo →
                        %mi z
                      %annotation{:encoding => "application/x-tex"} v_0 : y \to z
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} Y_1
                  be 1-cells. Together they determine a map from the
                  %a.existingWikiWord{:href => "/nlab/show/horn"} horn
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Λ
                          %mn 1
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \Lambda^2_1
                  to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msubsup
                          %mi Λ
                          %mn 1
                          %mn 2
                        %mo →
                        %mi Y
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (v_2, v_2) : \Lambda^2_1 \to Y
                        \\,.
                %p
                  By the
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                  property there is an extension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} \theta
                  of this morphism through the 2-
                  %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Delta
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} Delta^2
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msubsup
                                  %mi Λ
                                  %mn 1
                                  %mn 2
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi v
                                      %mn 0
                                    %mo ,
                                    %msub
                                      %mi v
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi Y
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ↗
                                  %mi θ
                            %mtr
                              %mtd
                                %mi Δ
                                %mo{:stretchy => "false"} [
                                %mn 2
                                %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\Lambda^2_1 &amp;\stackrel{(v_0,v_2)}{\to}&amp; Y
                        \\\
                        \\downarrow &amp; \nearrow_{\theta}
                        \\\
                        \\Delta[2]
                        }
                        \\,.
                %p
                  If we again identify
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} \theta
                  with its image (the image of its unique non-degenerate 2-cell) in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Y
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} Y_2
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
                  we find
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 0
                                %msub
                                  %mi d
                                  %mn 2
                                %mi θ
                                %mo{:stretchy => "false"} )
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 1
                                %msub
                                  %mi d
                                  %mn 0
                                %mi θ
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 2
                                    %mi θ
                                %mo ↗
                              %mtd
                                %mo ⇓
                                %mi θ
                              %mtd
                                %msup
                                  %mo ↘
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 0
                                    %mi θ
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 1
                                %msub
                                  %mi d
                                  %mn 2
                                %mi θ
                                %mo{:stretchy => "false"} )
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 1
                                %msub
                                  %mi d
                                  %mn 1
                                %mi θ
                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi d
                                      %mn 1
                                    %mi θ
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 0
                                %msub
                                  %mi d
                                  %mn 1
                                %mi θ
                                %mo{:stretchy => "false"} )
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi d
                                  %mn 0
                                %msub
                                  %mi d
                                  %mn 1
                                %mi θ
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; (d_0 d_2 \theta) = (d_1 d_0 \theta)
                        \\\
                        \&amp; {}^{d_2 \theta }\nearrow &amp;
                        \\Downarrow \theta &amp; \searrow^{d_0 \theta}
                        \\\
                        (d_1 d_2 \theta) = (d_1 d_1 \theta) &amp;&amp; \stackrel{d_1 \theta}{\to}  &amp;&amp;
                        (d_0 d_1 \theta)
                        \=
                        (d_0 d_1 \theta)
                        }
                %p
                  that the 1-cell boundary bit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} d_1 \theta
                  in turn has 0-cell boundaries
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %msub
                          %mi d
                          %mn 1
                        %mi θ
                        %mo =
                        %msub
                          %mi d
                          %mn 0
                        %msub
                          %mi d
                          %mn 0
                        %mi θ
                        %mo =
                        %mi z
                      %annotation{:encoding => "application/x-tex"}
                        d_0 d_1 \theta = d_0 d_0 \theta = z
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %msub
                          %mi d
                          %mn 1
                        %mi θ
                        %mo =
                        %msub
                          %mi d
                          %mn 1
                        %msub
                          %mi d
                          %mn 2
                        %mi θ
                        %mo =
                        %mi x
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        d_1 d_1 \theta = d_1 d_2 \theta = x
                        \\,.
                %p
                  This means that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %mi θ
                      %annotation{:encoding => "application/x-tex"} d_1 \theta
                  is a homotopy
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo →
                          %mi z
                        %annotation{:encoding => "application/x-tex"} x \to z
              %li
                %p
                  \-
                  %strong> symmetry
                  \- In a similar manner, suppose that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                        %mo :
                        %mi x
                        %mo →
                        %mi y
                      %annotation{:encoding => "application/x-tex"} v_2 : x \to y
                  is a 1-cell in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} Y_1
                  that constitutes a homotopy from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                        %annotation{:encoding => "application/x-tex"} y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                        %mo :
                        %mo =
                        %msub
                          %mi s
                          %mn 0
                        %mi x
                      %annotation{:encoding => "application/x-tex"} v_1 := s_0 x
                  be the degenerate 1-cell on
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %msub
                          %mi v
                          %mn 1
                        %mo =
                        %msub
                          %mi d
                          %mn 1
                        %msub
                          %mi v
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} d_1 v_1 = d_1 v_2
                  together they define a map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Λ
                          %mn 0
                          %mn 2
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi v
                              %mn 1
                            %mo ,
                            %msub
                              %mi v
                              %mn 2
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} \Lambda^2_0 \stackrel{v_1, v_2}{\to} Y
                  which by the Kan property of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  we may extend to a map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi θ
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \theta'
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msubsup
                                  %mi Λ
                                  %mn 0
                                  %mn 2
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi v
                                      %mn 1
                                    %mo ,
                                    %msub
                                      %mi v
                                      %mn 2
                              %mtd
                                %mi Y
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %msub
                                  %mo ↗
                                  %mrow
                                    %mi θ
                                    %mo ′
                            %mtr
                              %mtd
                                %mi Δ
                                %mo{:stretchy => "false"} [
                                %mn 2
                                %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\Lambda^2_0 &amp;\stackrel{v_1, v_2}{\to}&amp; Y
                        \\\
                        \\downarrow &amp; \nearrow_{\theta'}
                        \\\
                        \\Delta[2]
                        }
                %p on the full 2-simplex.
                %p
                  Now the 1-cell boundary
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %mi θ
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} d_0 \theta'
                  has, using the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 0
                        %msub
                          %mi d
                          %mn 0
                        %mi θ
                        %mo ′
                        %mo =
                        %msub
                          %mi d
                          %mn 0
                        %msub
                          %mi d
                          %mn 1
                        %mi θ
                        %mo ′
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"}
                        d_0 d_0 \theta' = d_0 d_1 \theta' = x
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %msub
                          %mi d
                          %mn 0
                        %mi θ
                        %mo ′
                        %mo =
                        %msub
                          %mi d
                          %mn 0
                        %msub
                          %mi d
                          %mn 2
                        %mi θ
                        %mo ′
                        %mo =
                        %mi y
                      %annotation{:encoding => "application/x-tex"}
                        d_1 d_0 \theta' = d_0 d_2 \theta' = y
                %p
                  and hence yields a homotopy
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo →
                          %mi x
                        %annotation{:encoding => "application/x-tex"} y \to x
            %p
              Finally we use the fact that
              %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
              is a
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
              to deduce from this statements about vertices the corresponding statement for all map:
            %p
              a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              is the Hom-
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of a morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ¯
                      %mo :
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \bar f : \Delta[0] \to [X,Y]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi X
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \eta : X \times \Delta[1] \to Y
              is the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of a morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ¯
                      %mo :
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \bar \eta : \Delta[1] \to [X,Y]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi f
                    %mo ⇒
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \eta : f \Rightarrow g
              are in bijection with homotopies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ¯
                      %mo :
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ¯
                      %mo →
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar \eta : \bar f \to \bar g
          .un_proposition
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an abelian category and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f,g : X\to Y
              homotopic morphisms of simplicial objects in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo ,
                    %msub
                      %mi g
                      %mo *
                    %mo :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_*, g_* : N(X)\to N(Y)
              of their normalized chain complexes are chain homotopic.
          .un_proposition
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an abelian category. The morphisms of simplicial objects (variant: of unbounded chain complexes) in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %ul
              %li
                %p being homotopic is an equivalence relation on the class of morphism,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                        %mo ∼
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f_1\sim 0
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                        %mo ∼
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f_2\sim 0
                  implies
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mn 1
                          %mo +
                          %msub
                            %mi f
                            %mn 2
                          %mo ∼
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} f_1+f_2 \sim 0
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∘
                        %mi h
                      %annotation{:encoding => "application/x-tex"} f\circ h
                  (resp.
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo ∘
                          %mi f
                        %annotation{:encoding => "application/x-tex"} h\circ f
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∼
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f\sim 0
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∘
                        %mi h
                        %mo ∼
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f\circ h\sim 0
                  (resp.
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo ∘
                          %mi f
                          %mo ∼
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} h\circ f\sim 0
          %h2#references References
          %ul
            %li
              Goerss, Jardine,
              %em Simplicial homotopy theory
              (
              %a{:href => "http://dodo.pdmi.ras.ru/~topology/books/goerss-jardine.pdf"}> pdf
              )
          %p Cylinder based homotopy is also discussed extensively in
          %ul
            %li
              K. H. Kamps and T. Porter,
              = succeed "," do
                %em Abstract Homotopy and Simple Homotopy Theory
