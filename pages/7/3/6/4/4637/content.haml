                              %mi c
                              %mi i
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{O}(X)(d)
                    \&amp;=
                    [C^{op}, \mathcal{V}](X, C(-,c))
                    \\\
                    \&amp; \simeq
                    [C^{op}, \mathcal{V}]({\lim_\to}_i C(-,c_i), C(-,c))
                    \\\
                    \&amp; \simeq
                    {\lim_\leftarrow}_i [C^{op}, \mathcal{V}](C(-,c_i), C(-,c))
                    \\\
                    \&amp; \simeq
                    {\lim_\leftarrow}_i C(c_i,c)
                    \\end{aligned}
                    \\,.
            %p Using all this we can finally obtain the adjunction in question by the following sequence of natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
