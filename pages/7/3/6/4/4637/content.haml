                    %mi c
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(G)(c) = [C, \mathcal{V}](G, C(c, -)) \hookrightarrow \int_{t: T} \mathcal{V}(G t, \hom(c, t))
          %h2#example Example
          %p
            In the simplest case, namely for an ordinary category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %p
            The category of
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, \mathrm{Set}]
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} f \colon \mathcal{C} \to \mathcal{D}
          %p
            to a
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            extends along the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} y \colon \mathcal{C} \to [\mathcal{C}^{op}, \mathrm{Set}]
            to a
            %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} F \colon [\mathcal{C}^{op}, \mathrm{Set}] \to \mathcal{D}
          %p in a manner unique up to natural isomorphism.
          %p
            Dually, the category of
            %a.existingWikiWord{:href => "/nlab/show/copresheaves"} copresheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                %annotation{:encoding => "application/x-tex"} [\mathcal{C}, \mathrm{Set}]^{op}
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+completion"} free completion
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} g \colon \mathcal{C} \to \mathcal{D}
          %p
            to a
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            extends along the
            %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝒞
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                %annotation{:encoding => "application/x-tex"} z \colon \mathcal{C} \to [\mathcal{C}, \mathrm{Set}]^{op}
            to a
            %a.existingWikiWord{:href => "/nlab/show/continuous+functor"} continuous functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} G \colon [\mathcal{C}, \mathrm{Set}]^{op} \to \mathcal{D}
          %p in a manner unique up to natural isomorphism.
          %p
            We can apply these ideas to get the functors involved in Isbell duality. The presheaf category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, \mathrm{Set}]
            has all limits, so we can extend the Yoneda embedding to a continuous functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y \colon [\mathcal{C}, \mathrm{Set}]^{op} \to [\mathcal{C}^{op}, \mathrm{Set}]
          %p
            from copresheaves to presheaves. Dually, the copresheaf category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                %annotation{:encoding => "application/x-tex"} [\mathcal{C}, \mathrm{Set}]^{op}
            has all colimits, so we can extend the co-Yoneda embedding to a cocontinuous functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi 𝒞
                    %mi op
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi{:mathvariant => "normal"} Set
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                %annotation{:encoding => "application/x-tex"} Z \colon [\mathcal{C}^{op}, \mathrm{Set}] \to [\mathcal{C}, \mathrm{Set}]^{op}
          %p from presheaves to copresheaves.
          %p
            Isbell duality says that these are adjoint functors:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is right adjoint to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
          %h2#properties Properties
