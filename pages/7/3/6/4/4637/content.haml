                            %mo ,
                            %mi Spec
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi 𝒱
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
