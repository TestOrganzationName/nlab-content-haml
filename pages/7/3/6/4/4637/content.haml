                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi i
                            %mo{:stretchy => "false"} [
                            %mi C
                            %mo ,
                            %mi 𝒱
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} (
