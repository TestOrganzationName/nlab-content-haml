                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mo ∫
                      %mrow
                        %mi t
                        %mo :
