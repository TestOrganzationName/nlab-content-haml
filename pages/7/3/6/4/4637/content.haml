            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %strong Isbell conjugation
            or
            %strong Isbell duality
            (after
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/John+Isbell"} John Isbell
          %p
            To the extent that this adjunction descends to presheaves that are (
            %a.existingWikiWord{:href => "/nlab/show/higher+topos+theory"}> higher
            )
            %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
