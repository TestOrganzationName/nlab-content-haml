                        %mtr
                          %mtd
                          %mtd
                            %mo :
                            %mo =
                            %mo{:stretchy => "false"} [
                            %mi C
                            %mo ,
                            %mi 𝒱
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} (
