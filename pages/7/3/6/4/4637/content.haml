            %p
              where the first is Lemma 1 and the second the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            %p
              Since (by what is sometimes called the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \in [C^{op}, \mathcal{V}]
              may be written as a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mi i
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
