                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo :
                            %mo =
                            %mo{:stretchy => "false"} [
                            %mi C
                            %mo ,
                            %mi 𝒱
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Spec(C(c,-))(d)
                    \&amp; :=
                    [C,\mathcal{V}](C(c,-), C(d,-))
                    \\\
                    \&amp; \simeq
                    C(d,c)
                    \\end{aligned}
            %p
              by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            %p From this we get
            %p
              %strong Lemma 2:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Spec
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
