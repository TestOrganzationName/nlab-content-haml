          %h2#idea Idea
          %p
            A general abstract
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒪
                  %mo ⊣
                  %mi Spec
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi CoPresheaves
                  %munderover
                    %mo ⇆
                    %mi Spec
                    %mi 𝒪
                  %mi Presheaves
                %annotation{:encoding => "application/x-tex"}
                  (\mathcal{O} \dashv Spec)
                  \:
                  CoPresheaves
                  \\underoverset{Spec}{\mathcal{O}}{\leftrightarrows}
                  Presheaves
          %p
            relates (higher)
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            with (higher)
            %a.existingWikiWord{:href => "/nlab/show/copresheaves"} copresheaves
            on a given (
