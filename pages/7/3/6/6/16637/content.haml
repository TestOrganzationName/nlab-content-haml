                    %mo{:stretchy => "false"} /
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^7 \simeq_{homeo} Sp(1)\backslash Sp(2)/Sp(1)
              (
              %a.existingWikiWord{:href => "/nlab/show/Gromoll-Meyer+sphere"}> Gromoll-Meyer sphere
              )
          %p
            %br/
          %h3#exotic_7spheres Exotic 7-spheres
          %p
            A celebrated result of Milnor is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"} S^7
            admits
            %a.existingWikiWord{:href => "/nlab/show/exotic+smooth+structures"} exotic smooth structures
            (see at
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/exotic+7-sphere"} exotic 7-sphere
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            structures on the
            %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"} S^7
            that are not
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
            to the standard smooth structure on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} S^7
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            diffeomorphism, the different smooth structures form a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            under a (suitable) operation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connected+sum"} connected sum
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mn 28
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(28)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 4
                %annotation{:encoding => "application/x-tex"} n = 4
            (where the question of existence of exotic 4-spheres is wide open), exotic spheres first occur in dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 7
                  %annotation{:encoding => "application/x-tex"} 7
            %a.existingWikiWord{:href => "/nlab/show/h-cobordism+theorem"} h-cobordism theorem
            (the monoid of smooth structures is identified with the monoid of h-cobordism classes of oriented
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+spheres"} homotopy spheres
          %p
            One explicit construction of the smooth structures is given as follows (see
            = succeed ")." do
              %a{:href => "#Mil2"} Milnor 1968
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi k
                %annotation{:encoding => "application/x-tex"} W_k
            be the algebraic variety in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mn 5
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^5
            defined by the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi z
                    %mn 1
                    %mrow
                      %mn 6
                      %mi k
                      %mo −
                      %mn 1
                  %mo +
                  %msubsup
                    %mi z
                    %mn 2
                    %mn 3
                  %mo +
                  %msubsup
                    %mi z
                    %mn 3
                    %mn 2
                  %mo +
                  %msubsup
                    %mi z
                    %mn 4
                    %mn 2
                  %mo +
                  %msubsup
                    %mi z
                    %mn 5
                    %mn 2
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} z_1^{6 k - 1} + z_2^3 + z_3^2 + z_4^2 + z_5^2 = 0
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi ϵ
                  %mo ⊂
                  %msup
                    %mi ℂ
                    %mn 5
                %annotation{:encoding => "application/x-tex"} S_\epsilon \subset \mathbb{C}^5
            a sphere of small radius
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            centered at the origin. Then each of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 28
                %annotation{:encoding => "application/x-tex"} 28
            smooth structures on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"} S^7
            is represented by an intersection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi k
                    %mo ∩
                    %msub
                      %mi S
                      %mi ϵ
                  %annotation{:encoding => "application/x-tex"} W_k \cap S_\epsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            ranges from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 28
                  %annotation{:encoding => "application/x-tex"} 28
            %em Brieskorn manifolds
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/Brieskorn+spheres"} Brieskorn spheres
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Milnor+spheres"} Milnor spheres
          %h3#G2Structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mn 2
                %annotation{:encoding => "application/x-tex"} G_2
            \-structure
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mn 0
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 7
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi_0 \in \Omega^3(\mathbb{R}^7)
            be the
            %a.existingWikiWord{:href => "/nlab/show/associative+3-form"} associative 3-form
            and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mn 0
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ⊕
                  %msup
                    %mi ℝ
                    %mn 7
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Phi_0 \in \Omega^4(\mathbb{R} \oplus \mathbb{R}^7)
          %p be given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mn 0
                  %mo =
                  %mi d
                  %msub
                    %mi x
                    %mn 0
                  %mo ∧
                  %msub
                    %mi ϕ
                    %mn 0
                  %mo +
                  %mo ⋆
                  %msub
                    %mi ϕ
                    %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\Phi_0 = d x_0 \wedge \phi_0 + \star \phi_0
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} x_0
            denotes the canonical coordinate on the first factor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \phi_0
            is pulled back along the projection to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^7
          %p
            By construction this is its own
            %a.existingWikiWord{:href => "/nlab/show/Hodge+dual"} Hodge dual
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo =
                  %mo ⋆
                  %mi Φ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Phi = \star \Phi
                  \\,.
          %p
            This implies that as we restrict
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Phi_0
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 8
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo ≃
                  %mi ℝ
                  %mo ×
                  %msup
                    %mi S
                    %mn 7
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}^8 - \{0\} \simeq \mathbb{R} \times S^7
          %p then there is a unique 3-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 7
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\phi \in \Omega^3(S^7)
          %p on the 7-sphere such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mn 0
                  %mo =
                  %msup
                    %mi r
                    %mn 3
                  %mo ∧
                  %mi ϕ
                  %mo +
                  %msup
                    %mi r
                    %mn 4
                  %msub
                    %mo ⋆
                    %mrow
                      %msup
                        %mi S
                        %mn 7
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi on
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mn 8
                  %mo −
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Phi_0 = r^3 \wedge \phi + r^4 \star_{S^7} \phi
                  \\;\;\;\; (on \; \mathbb{R}^8 - \{0\})
                  \\,.
          %p
            This 3-form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            defines a
            %a.existingWikiWord{:href => "/nlab/show/G%E2%82%82-structure"} G₂-structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} S^7
            %em nearly parallel
            in that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi ϕ
                  %mo =
                  %mn 4
                  %mo ⋆
                  %mi ϕ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \phi = 4 \star \phi
                  \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Lotay12"} Lotay 12, def.2.4
