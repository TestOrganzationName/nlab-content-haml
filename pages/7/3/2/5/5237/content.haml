                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbf{n}
              (this is the poset of paths along the edges of an
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo :
                    %mi Sub
                    %mstyle{:mathvariant => "bold"}
                      %mi n
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    K : Sub \mathbf{n} \to C
            %p
              by setting on subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mstyle{:mathvariant => "bold"}
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbf{n}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi S
                    %mo :
                    %mo =
                    %mi X
                    %mo ⊗
                    %msub
                      %mi V
                      %mn 1
                    %mo ⊗
                    %mi X
                    %mo ⊗
                    %msub
                      %mi V
                      %mn 2
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %msub
                      %mi V
                      %mi n
                    %mo ⊗
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    K_S := X \otimes V_1 \otimes X \otimes V_2 \otimes  \cdots \otimes V_n \otimes X
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                    %mo :
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi K
                            %mtd
                              %mi if
                              %mspace{:width => "thinmathspace"}
                              %mi i
                              %mo ∉
                              %mi S
                          %mtr
                            %mtd
                              %mi L
