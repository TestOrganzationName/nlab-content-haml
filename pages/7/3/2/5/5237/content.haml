                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} g \colon A \to C
              two morphisms in the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CMon
                    %mo{:stretchy => "false"} (
