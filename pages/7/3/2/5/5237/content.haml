                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mo −
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K^-(S)
              of the colimit for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mstyle{:mathvariant => "bold"}
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S \subset \mathbf{n}
              a proper subset by the tensor product morphisms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mi X
                    %mo ⊗
                    %mi K
                    %mo ⊗
                    %mi ⋯
                    %mo ⊗
                    %mi L
                    %mo ⊗
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi ⋯
                        %mo ⊗
                        %msub
                          %mi μ
                          %mi X
                        %mo ∘
