                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \lim_\to K^- \to P_{n-1}
              is well defined and the monoid structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is well defined.
            %p (…)
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
