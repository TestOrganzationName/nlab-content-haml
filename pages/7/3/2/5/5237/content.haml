                          %mi ℕ
                    %annotation{:encoding => "application/x-tex"} (P_n)_{n \in \mathbb{N}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              inductively as follows.
            %p
              Assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} P_{n-1}
              has been defined. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sub
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sub(\mathbf{n})
              for the
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              of
              %a.existingWikiWord{:href => "/nlab/show/subset"} subsets
              of the
              = succeed "-element" do
