                  %use{:x => "284.494216", "xlink:href" => "#LiaYBZFsJ8J1dTcXR08Kdjgz6es=-glyph4-1", :y => "48.587117"}
                %path{:d => "M -91.587104 -33.014359 L -36.372611 -33.014359 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.999653,0,0,-0.999653,146.688102,46.719765)"}
                %path{:d => "M -2.486266 2.869825 C -2.032983 1.14657 -1.020913 0.333788 -0.00102743 0.00164099 C -1.020913 -0.334413 -2.032983 -1.147196 -2.486266 -2.87045 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.999653,0,0,-0.999653,110.567433,79.724297)"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "74.612147", "xlink:href" => "#LiaYBZFsJ8J1dTcXR08Kdjgz6es=-glyph2-1", :y => "90.04471"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "83.430333", "xlink:href" => "#LiaYBZFsJ8J1dTcXR08Kdjgz6es=-glyph3-2", :y => "91.717879"}
            %p
              Similarly for the
              %strong
                category of
                %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoids
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CMon
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CMon(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal
          .num_remark
            %h6#remark Remark
            %p
              If
              %a.existingWikiWord{:href => "/nlab/show/Assoc"} Assoc
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/associative+operad"} associative operad
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Alg
                      %mi C
                    %mi Assoc
                  %annotation{:encoding => "application/x-tex"} Mon(C) = Alg_C Assoc
              is the category of
              %a.existingWikiWord{:href => "/nlab/show/algebras+over+an+operad"} algebras over an operad
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Assoc
                    %annotation{:encoding => "application/x-tex"} Assoc
          .num_remark
            %h6#remark_2 Remark
            %p
              Every category of monoids comes with a
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \colon Mon(C) \to C
              which is
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
              (in fact, as soon as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              admits a left adjoint).
          %h2#properties Properties
          %p
            The properties of the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of monoids
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mon (C)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimits
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            preserves colimits in each variable. (This is automatically the case if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
          %p
            Most “algebraic” situations have this property, but others do not. For instance, the category of
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            on a fixed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mon (C)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} C= [A,A]
            is the category of
            %a.existingWikiWord{:href => "/nlab/show/endofunctors"} endofunctors
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with composition as its monoidal structure. This monoidal product preserves colimits in one variable (since colimits in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A,A]
            are computed pointwise), but not in the other (since most endofunctors do not preserve colimits). So far, the material on this page focuses on the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            does preserve colimits in both variables, although some of the references at the end discuss the more general case.
          %h3#local_presentability Local presentability
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              with countable
              %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
              which is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
            %p Then
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo :
                        %mi Mon
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} U : Mon(C) \to C
                  is a finitary
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic functor
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi λ
                        %annotation{:encoding => "application/x-tex"} \lambda
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
                  then so is
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Mon
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Mon(C)
          %p
            This appears in (
            %a{:href => "#Porst"}> Porst, page 7
            ).
          %h3#FreeMonoids Free and relative free monoids
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              with countable
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproducts
              that are preserved by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi C
                  %annotation{:encoding => "application/x-tex"} U_C
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi C
                      %mo :
                      %mi C
                      %mo →
                      %mi Mon
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_C : C \to Mon(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \in C
              the underlying object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi C
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F_C X
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi C
                    %msub
                      %mi F
                      %mi C
                    %mi X
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %msup
                      %mi X
                      %mrow
                        %mo ⊗
                        %mi n
                    %mo =
                    %msub
                      %mi I
                      %mi C
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi X
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ⊗
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    U_C F_C X
                    \=
                    \\coprod_{n \in \mathbb{N}} X^{\otimes n}
                    \=
                    I_C \coprod X \coprod (X \otimes X) \coprod \cdots
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .proof
            %h6#proof Proof
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi F
                      %mi C
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f : F_C X \to A
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mon(C)
              with components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi k
                    %mo :
                    %msup
                      %mi X
                      %mrow
                        %mo ⊗
                        %mi k
                    %mo →
                    %msub
                      %mi U
                      %mi C
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f_k : X^{\otimes k} \to U_C A
              is entirely fixed by its component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %msub
                      %mi f
                      %mn 1
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mi U
                      %mi C
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \tilde f = f_1 : X \to U_C A
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi C
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F_C X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mo ⊗
                                %mi k
                            %mo ⊗
                            %msup
                              %mi X
                              %mrow
                                %mo ⊗
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo −
                                %mi k
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mi k
                                %mo ⊗
                                %msub
                                  %mi f
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mi k
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mi A
                        %mtr
                          %mtd
                            %msup
                              %mi X
                              %mrow
                                %mo ⊗
                                %mi n
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                            %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X^{\otimes k} \otimes X^{\otimes (n-k)} &amp;\stackrel{f_k \otimes f_{n-k}}{\to}&amp;
                    A \otimes A
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\mu_A}}
                    \\\
                    X^{\otimes n} &amp;\stackrel{f_{n}}{\to}&amp; A
                    }
            %p it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo :
                    %msup
                      %mi X
                      %mrow
                        %mo ⊗
                        %mi n
                    %mover
                      %mo →
                      %mrow
                        %msubsup
                          %mi f
                          %mn 1
                          %mrow
                            %mo ⊗
                            %mi n
                    %msup
                      %mi A
                      %mrow
                        %mo ⊗
                        %mi n
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi μ
                          %mi A
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_n :
                    X^{\otimes n} \stackrel{f_1^{\otimes n}}{\to} A^{\otimes n} \stackrel{\mu_A}{\to} A
                    \\,.
            %p
              Conversely, every choice for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f_1
              extends to a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mon
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mon(C)
              this way.
          .num_example
            %h6#examples Examples
            %p
              Free algebras of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(A)
              are called
              = succeed "s," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                  %annotation{:encoding => "application/x-tex"} C =
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              and similar.
            %p
              The elements of the free algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(A)
              are somtimes called
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/lists"} lists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                  %annotation{:encoding => "application/x-tex"} C =
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              and similar.
          %h3#pushouts Pushouts
          %p
            We discuss forming
            %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
            in a category of monoids. The case
          %ul
            %li
              %a{:href => "#PushoutOfCommutativeMonoids"} For commutative monoids
          %p has a simple description. The case
          %ul
            %li
              %a{:href => "#PushoutOfNoncommutativeMonoids"} For non-commutative monoids
          %p is more involved.
          %h4#PushoutOfCommutativeMonoids Of commutative monoids
          #PushoutsInCMonGivenByTensorProduct.num_prop
            %h6#proposition_2 Proposition
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ul
              %li
                %p
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %li
                %p
                  with
                  %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizers"} reflexive coequalizers
              %li
                %p
                  that are preserved by the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi 𝒞
                        %mo →
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} A \otimes (-) \colon \mathcal{C} \to \mathcal{C}
                  for all objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
