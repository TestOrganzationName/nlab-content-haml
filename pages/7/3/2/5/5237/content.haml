                    %mi X
                    %mo →
                    %msub
                      %mi P
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi S
                        %mo{:stretchy => "false"} |
                    %mo →
                    %msub
                      %mi P
                      %mrow
                        %mi n
