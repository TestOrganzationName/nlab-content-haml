                %tr
                  %td{:style => "text-align: left;"}
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
                    %br/
                    (
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/parametrized+homotopy+theory"} full
                    or
                    = succeed ")" do
                      %strong
                        %a.existingWikiWord{:href => "/nlab/show/rational+parameterized+stable+homotopy+theory"} rational
                  %td{:style => "text-align: left;"}
