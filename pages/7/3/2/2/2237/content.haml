          %h2#Idea Idea
          %p
            %em Equivariant cohomology
            is
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            in the presence of and taking into account
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %a.existingWikiWord{:href => "/nlab/show/actions"} actions
            (and generally
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
          %p
            Exactly what this comes down to depends on the choice of ambient
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            and of the way that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is regarded as an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            object of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %ul
            %li
              %p
                %strong “coarse” equivariance.
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo =
                    %annotation{:encoding => "application/x-tex"} \mathbf{H} =
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≃
                      %msub
                        %mi L
                        %mi whe
                    %annotation{:encoding => "application/x-tex"} \simeq L_{whe}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                groupoid/
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{B}G}
                is
                %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
                by the
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
                on the category of
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                equipped with
                = succeed "-action." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %em coarse
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
                %a.existingWikiWord{:href => "/nlab/show/homotopy+quotients"} homotopy quotients
                and
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fixed+points"} homotopy fixed points
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                (in particular cofibrant replacement in the
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
                is indeed given by the
                %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
                and so Borel equivariant cohomology theory appears here whenever the
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                have trivial
                = succeed "-action)." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "-action" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                %strong “fine” Bredon equivariance.
                In order to bring in more geometric information one may equip
                %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
                with information about the actual
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fixed+points"} homotopy fixed points
                %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
                this means to have all spaces be probe-able by fixed points, hence to have them be
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-presheaves
                on the
                %a.existingWikiWord{:href => "/nlab/show/global+equivariant+indexing+category"} global equivariant indexing category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Glob
                      %annotation{:encoding => "application/x-tex"} Glob
                %a.existingWikiWord{:href => "/nlab/show/global+orbit+category"} global orbit category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Orb
                      %annotation{:encoding => "application/x-tex"} Orb
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi PSh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi Glob
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi PSh
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi Orb
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathbf{H} \to \mathbf{B}) =  (PSh_\infty(Glob) \to PSh_\infty(Orb))
                %a.existingWikiWord{:href => "/nlab/show/base+%28%E2%88%9E%2C1%29-topos"} base (∞,1)-topos
                is that of
                %a.existingWikiWord{:href => "/nlab/show/orbispaces"} orbispaces
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                sitting
                %a.existingWikiWord{:href => "/nlab/show/cohesion"} cohesively
                over it is the “
                %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"}> global equivariant homotopy theory
                ” proper (see there).
              %p
                Now we have
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G \in \mathbf{H}
                naturally via the
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
                and the
                %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mo ≃
                      %msub
                        %mi L
                        %mi fpwe
                      %mi G
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}_{/\mathbf{B}G} \simeq L_{fpwe} G Top
                is the traditional
                %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
                presented by the “fine” model structure on
                %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
                whose weak equivalences are the
                = succeed "-fixed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
                for all suitable subgroups
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                        %mo ↪
                        %mi G
                      %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
                %a.existingWikiWord{:href => "/nlab/show/spectrum+objects"} spectrum objects
                here are what are called
                %a.existingWikiWord{:href => "/nlab/show/spectra+with+G-action"} spectra with G-action
                or “
                %a.existingWikiWord{:href => "/nlab/show/naive+G-spectra"}> naive G-spectra
                ”. See at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
                for details. By the discussion there every object in the fine model structure if fibrant and cofibrant replacement here is given by passage to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/G-CW+complexes"} G-CW complexes
                %a.existingWikiWord{:href => "/nlab/show/derived+hom+spaces"} derived hom spaces
                computing cohomology are the ordinary
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/fixed+points"} fixed points
                of the
                %a.existingWikiWord{:href => "/nlab/show/mapping+spectra"} mapping spectra
                from such as
                %a.existingWikiWord{:href => "/nlab/show/G-CW+complex"} G-CW complex
                into the coefficient spectrum (this is traditionally motivated via detour through
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/genuine+G-spectra"} genuine G-spectra
                = succeed ")." do
                  %a{:href => "#GreenleesMay"} Greenlees-May, equation (3.7)
              %p
                Cohomology with
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+object"} Eilenberg-MacLane object
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi PSh
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi Orb
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                    %annotation{:encoding => "application/x-tex"} PSh_\infty(Orb)_{/\mathbf{B}G}
                is what
                %a.existingWikiWord{:href => "/nlab/show/Glen+Bredon"} Glen Bredon
                originally considered as what is now called
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bredon+cohomology"} Bredon cohomology
          %h2#presentations Presentations
          %blockquote
            %p under construction
          %p
            (…)
            %a.existingWikiWord{:href => "/nlab/show/Elmendorf+theorem"} Elmendorf theorem
            (…)
            %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
            (…)
          %h2#Borel Borel equivariant cohomology
          %p
            We first state the
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} general abstract
            definition of
            %em
              %a.existingWikiWord{:href => "/nlab/show/Borel+equivariant+cohomology"} Borel equivariant cohomology
            and then derive from it the more concrete formulations that are traditionally given in the literature.
          .standout
            %p
              %a.existingWikiWord{:href => "/nlab/show/Borel+equivariant+cohomology"} Borel equivariant cohomology
              is the
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              of
              %a.existingWikiWord{:href => "/nlab/show/action+groupoids"} action groupoids
              (
              %a.existingWikiWord{:href => "/nlab/show/homotopy+quotients"}> homotopy quotients
              \/
              %a.existingWikiWord{:href => "/nlab/show/Borel+constructions"}> Borel constructions
              ).
          %p
            For standard
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            these
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            acting on a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are traditionally known as the
            %a.existingWikiWord{:href => "/nlab/show/Borel+construction"} Borel construction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mi G
                    %msub
                      %mo ×
                      %mi G
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}G \times_G X
          %p
            Recall from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            that in full generality we have a notion of cohomology of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are objects of some
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(X,A)
            is the set of connected components in the
            %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(X,A) = \pi_0 \mathbf{H}(X,A)
          %p
            Recall moreover from the discussion at
            %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} space and quantity
            that objects of an
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-sheaves"} (∞,1)-topos of (∞,1)-sheaves
            have the interpretation of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            = succeed "-sheaves" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            of smooth test spaces such as
            %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            these objects have the interpretation of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-groupoid"} Lie ∞-groupoid
          %p
            In this case, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            some such
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            with structure, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} X_0  \hookrightarrow X
            be its 0-truncation, which is the
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/discrete+groupoid"} categorically discrete groupoid
            underlying
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as determining which points of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            are related under some kind of action on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
            %strong Equivariance
            means, roughly: functorial transformation behaviour of objects on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            with respect to this “action” encoded in the morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            In the simple special case that one should keep in mind,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is for instance the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"} X = X_0//G
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo →
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \to g(x)
            connect those objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            that are related by the action by some group element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
          %p
            It is natural to consider the
            %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
            of the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow X
            = succeed "-)groupoid." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .un_defn
            %h6#definition_equivariant_cohomology Definition (equivariant cohomology)
            %p
              In some
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              the
              %strong equivariant cohomology
              with coefficient in an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              of a 0-truncated object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              with respect to an action encoded in an inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow X
              is simply the
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(X,A)
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              More specifically, an
              %strong equivariant structure
              on an
              = succeed "-cocycle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %msub
                      %mi X
                      %mn 0
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} c : X_0 \to A
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
              is a choice of extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mover
                                %mi c
                                %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_0 &amp;\to&amp; A
                    \\\
                    \\downarrow &amp; \nearrow_{\hat c}
                    \\\
                    X
                    }
                    \\,.
            %p
              i.e. a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              through the projection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 0
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}(X,A) \to \mathbf{H}(X_0,A)
          %h3#examples Examples
          %h4#group_cohomology Group cohomology
          %p
            By comparing the definition of equivariant cohomology with that of
            %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
            one sees that group cohomology can be equivalently thought of as being
            = succeed "." do
              %strong equivariant cohomology of the point
          %h4#equivariant_cohomotopy Equivariant cohomotopy
          %div
            %table
              %thead
                %tr
                  %th
                    flavours of
                    %br/
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
                    %br/
                    %a.existingWikiWord{:href => "/nlab/show/generalized+cohomology"} cohomology theory
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
                    %br/
                    (
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} full
                    or
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
                    %br/
                    (
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} full
                    or
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/rational+equivariant+homotopy+theory"} rational
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Cohomotopy"} Cohomotopy
                    %br/
                    (full or
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/rational+Cohomotopy"} rational
                  %td{:style => "text-align: left;"}
