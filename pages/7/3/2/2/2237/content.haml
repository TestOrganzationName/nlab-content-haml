                  %td{:style => "text-align: left;"} twisted equivariant Cohomotopy
                %tr
                  %td{:style => "text-align: left;"}
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} stable cohomology
                    %br/
                    (
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} full
                    or
                    = succeed ")" do
                      %strong
                        %a.existingWikiWord{:href => "/nlab/show/rational+stable+homotopy+theory"} rational
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/stable+Cohomotopy"} stable Cohomotopy
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+Cohomotopy"} equivariant stable Cohomotopy
                %tr
                  %td{:style => "text-align: left;"}
