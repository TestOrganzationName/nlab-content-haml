          %h2#references References
          %h3#general General
          %p
            Introduction to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Borel+equivariant+cohomology"} Borel equivariant cohomology
          %ul
            %li#Tu11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"}> Loring Tu
                ,
                = succeed "," do
                  %em What is… Equivariant Cohomology?
                = succeed "," do
                  %a{:href => "https://www.ams.org/notices/201103/rtx110300423p.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/TuEquivariantCohomology.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"}> Loring Tu
                ,
                = succeed "," do
                  %em Introductory Lectures on Equivariant Cohomology
                = succeed "," do
                  %strong 204
                = succeed ")" do
                  %a{:href => "https://press.princeton.edu/books/hardcover/9780691191744/introductory-lectures-on-equivariant-cohomology"} ISBN:9780691191744
          %p
            Introduction to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Bredon+equivariant+cohomology"} Bredon equivariant cohomology
          %ul
            %li#Blumberg17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"}> Andrew Blumberg
                , section 1.4 of
                = succeed "," do
