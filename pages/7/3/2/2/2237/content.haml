                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/differential+Cohomotopy"} differential Cohomotopy
                  %td{:style => "text-align: left;"} equivariant differential cohomotopy
                %tr
                  %td{:style => "text-align: left;"}
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/persistent+homotopy"} persistent cohomology
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/persistent+Cohomotopy"} persistent Cohomotopy
                  %td{:style => "text-align: left;"} persistent equivariant Cohomotopy
          %h4#equivariant_bundles Equivariant bundles
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            some
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Bund
                %annotation{:encoding => "application/x-tex"} G Bund
            be the
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            be some finite group (just for the sake of simplicity of the example) and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo →
                  %mi Aut
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K \to Aut(X_0)
            be an action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            on a space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi K
                %annotation{:encoding => "application/x-tex"} X = X_0 // K
            be the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
          %p
            Then a cocycle in the
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo ,
                  %mi G
                  %mi Bund
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(X_0//K, G Bund)
            is
          %ul
            %li
              %p
                a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} P \to X
                on
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} k \in K
                an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                of
                = succeed "-principal" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi λ
                        %mi k
                      %mo :
                      %mi P
                      %mo →
                      %msup
                        %mi k
                        %mo *
                      %mi P
                    %annotation{:encoding => "application/x-tex"} \lambda_k : P \to k^* P
            %li
              %p
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mn 1
                      %mo ,
                      %msub
                        %mi k
                        %mn 2
                      %mo ∈
                      %mi K
                    %annotation{:encoding => "application/x-tex"} k_1, k_2 \in K
                we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi λ
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                        %mo ∘
                        %msub
                          %mi λ
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                        %mo =
                        %msub
                          %mi λ
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                            %mo ⋅
                            %msub
                              %mi k
                              %mn 1
                      %annotation{:encoding => "application/x-tex"} \lambda_{k_2}\circ \lambda_{k_1} = \lambda_{k_2\cdot k_1}
          %h4#local_systems__flat_connections Local systems – flat connections
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mo =
                  %msub
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X := P_n(X_0)
            a version of its
            %a.existingWikiWord{:href => "/nlab/show/path+n-groupoid"} path n-groupoid
            we have a canonical inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                  %mo ↪
                  %msub
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow P_n(X_0)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            as the collection of constant paths in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
          %p
            Consider for definiteness
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Π
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X_0) := \Pi_\infty(X_0)
            %a.existingWikiWord{:href => "/nlab/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
          %p
            Then for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            some coefficient
            = succeed "-groupoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} g : X_0 \to A
            can be thought of as classifying a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            on the space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
          %p
            On the other hand, a morphism out of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_n(X_0)
            is something like a flat
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            (see there for more details) on this principal
            = succeed "-bundle," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %p
            Accordingly, an extension of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} g : X_0 \to A
            through the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                  %mo ↪
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow \Pi(X)
            is the process of equipping a principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Comparing with the above definition of eqivariant cohomology, we see that flat connections on bundles may be regarded as
            %strong path-equivariant structures
            on these bundles.
          %p
            This is therefore an example of equivariance which is not with respect to a global
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            action, but genuinely a
            = succeed "al" do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
          %h4#equivariant_de_rham_cohomology Equivariant de Rham cohomology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/equivariant+de+Rham+cohomology"} equivariant de Rham cohomology
          %h3#remarks Remarks
          %p
            When pairing equivariant cohomology with other variants of cohomology such as
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            or
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
            one has to exercise a bit of care as to what it really is that one wants to consider. A discussion of this is (beginning to appear) at
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/differential+equivariant+cohomology"} differential equivariant cohomology
          %h2#Bredon Bredon equivariant cohomology
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bredon+cohomology"} Bredon cohomology
          %h3#preliminary_remarks Preliminary remarks
          %p
            According to the
            %a.existingWikiWord{:href => "/nlab/show/nPOV"} nPOV
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are objects in an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^0(X;A)
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_0(Map(X,A))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} group object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi B
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^1(X;A)= \pi_0(Map(X,B A))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} deloopable
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi B
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^n(X;A) = \pi_0(Map(X, B^n A)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a (discrete) group, and in general,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^1(X;A)
            classifies
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %p
            Now consider the
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Top
                %annotation{:encoding => "application/x-tex"} G Top
            of
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaves
            on the
            %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            there is a notion of a principal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,\Pi)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is the group of equivariance, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            is the structure group of the bundle), and these are classified by maps into a classifying
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi G
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} B_G \Pi
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,\Pi)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            can be called
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %msub
                      %mi B
                      %mi G
                    %mi Π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^0(X;B_G \Pi)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi G
                  %mi Π
                %annotation{:encoding => "application/x-tex"} B_G \Pi
            was a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi Π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,\Pi)
            = succeed "\u201D," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %mo ?
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^1(X;?)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi G
                  %mi Π
                %annotation{:encoding => "application/x-tex"} B_G \Pi
            is not connected, in the sense that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %msub
                    %mi B
                    %mi G
                  %mi Π
                %annotation{:encoding => "application/x-tex"} {*}\to B_G \Pi
            is not an
            %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
            and thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi G
                  %mi Π
                %annotation{:encoding => "application/x-tex"} B_G \Pi
            is not the quotient of a
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} group object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} G Top
          %h3#equivariant_spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-equivariant spectra
          %p
            If we have an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of our
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n(X;A)
            for any integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            by looking at all the spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mi A
                    %mo =
                    %msup
                      %mi B
                      %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega^{-n} A = B^n A
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+square"} Steenrod square
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poincare+duality"} Poincare duality
            %em
              %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            \. We then are motivated to put together all of the objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi B
                    %mi n
                  %mi A
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{B^n A\}
            into a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectrum+object"} spectrum object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi E
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{E_n\}
            such that
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                    %mo ≃
                    %mi Ω
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} E_n \simeq \Omega E_{n+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo ≃
                  %mi B
                  %msub
                    %mi E
                    %mi n
                %annotation{:encoding => "application/x-tex"} E_{n+1} \simeq B E_n
            restricts us to “connective” spectra, those that can be produced by successively delooping a single object of the
            = succeed "-topos." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectra
            produced from the input of an ordinary abelian group.
          %p
            Now we can do all of this in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} G Top
            = succeed ":" do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/naive+G-spectrum"} naive G-spectrum
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi E
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{E_n\}
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                    %mo ≃
                    %mi Ω
                    %msub
                      %mi E
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} E_n \simeq \Omega E_{n+1}
            = succeed "-spectrum" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-spaces." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-spectra\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/coefficient+system"} coefficient systems
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            = succeed "-spectrum" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Bredon+cohomology"} Bredon cohomology
            theory.
          %p
            It turns out, though, that the cohomology theories arising in this way are kind of weird. For instance, when one calculates with them, one sees
            %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
            popping up in odd places where one wouldn’t expect it. It would also be nice to have a
            %a.existingWikiWord{:href => "/nlab/show/Poincare+duality"} Poincare duality
            theorem for
            = succeed "-manifolds," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} looping
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
          %p
            instead of just looking at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %mo =
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^n = Map(S^n, -)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi V
                    %mo =
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi V
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^V = Map(S^V,-)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi V
                %annotation{:encoding => "application/x-tex"} S^V
            is its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooped
            “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            times,” we can define
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi V
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ;
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi Ω
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi V
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^V(X;A) = \pi_0(Map(X,\Omega^{-V} A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            can be delooped
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            times for all representations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-grading"} RO(G)-graded
                cohomology theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi α
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ;
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\alpha(X;A)
            for all formal differences of representations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo =
                    %mi V
                    %mo −
                    %mi W
                  %annotation{:encoding => "application/x-tex"} \alpha = V - W
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/genuine+G-spectrum"} genuine G-spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi V
                %annotation{:encoding => "application/x-tex"} E_V
            for all representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi V
                    %mo ≃
                    %msup
                      %mi Ω
                      %mrow
                        %mi W
                        %mo −
                        %mi V
                    %msub
                      %mi E
                      %mi W
                  %annotation{:encoding => "application/x-tex"} E_V \simeq \Omega^{W-V} E_W
            = succeed "-spectrum" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Mackey+functor"} Mackey functor
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RO(G)
              \-graded Bredon cohomology theory
            \.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi RO
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} RO(G)
            \-graded Bredon cohomology has lots of formal advantages over the integer-graded theory. For instance, the torsion that popped up in odd places before can now be seen as arising by “shifting” of something in the cohomology of a point in an “off-integer dimension,” which was invisible to the integer-graded theory. Also there is a
            %a.existingWikiWord{:href => "/nlab/show/Poincare+duality"} Poincare duality
            for
            = succeed "-manifolds:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a
            = succeed "-manifold," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            (generally not a trivial one!) and by
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            arguments, obtain a Poincare duality theorem involving a dimension shift of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is generally not an integer (and, apparently, not even uniquely determined by
            = succeed "!)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RO(G)
          %p
            For more see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+homotopy+theory"} equivariant stable homotopy theory
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/global+equivariant+stable+homotopy+theory"} global equivariant stable homotopy theory
          %h3#examples_2 Examples
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
