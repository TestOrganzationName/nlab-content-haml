                  %tr
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo ↦
                            %mi X
                            %mo +
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X \mapsto X + X
                      or
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo ↦
                            %mn 2
