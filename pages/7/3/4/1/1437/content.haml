                            %mi A
                            %mo ×
                            %mi ℕ
                          %annotation{:encoding => "application/x-tex"} A \times \mathbb{N}
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi A
                            %mo ×
                            %mi ℕ
                            %mo +
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} A \times \mathbb{N} + 1
                      , ie
                      %a.existingWikiWord{:href => "/nlab/show/conatural+numbers"} conatural numbers
                      “terminated” (when they aren’t
                      = succeed ")" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mn ∞
                            %annotation{:encoding => "application/x-tex"} \infty
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                    %td{:style => "text-align: center;"}
