                %li
                  %a{:href => "#UnitInterval"} Unit interval in the real line
                %li
                  %a{:href => "#categorified_example_trees"} Categorified example: Trees
                %li
                  %a{:href => "#fractals"} Fractals
                %li
                  %a{:href => "#further_examples"} Further examples
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#introduction Introduction
          %p
            A
            = succeed "," do
              %strong terminal coalgebra
            = succeed "," do
              %strong final coalgebra
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            on a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            in the category of
            %a.existingWikiWord{:href => "/nlab/show/coalgebra+for+an+endofunctor"} coalgebras
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            has a terminal coalgebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha\colon X \to F(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(X)
            (see below); in this sense,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a fixed point of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the largest fixed point of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            in that there is a map to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            from any other fixed point (indeed, any other coalgebra), and this map is an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            The dual concept is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/initial+algebra"} initial algebra
            %a.existingWikiWord{:href => "/nlab/show/induction"} induction
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/recursion"} recursion
            %a.existingWikiWord{:href => "/nlab/show/coinduction"} coinduction
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/corecursion"} corecursion
          %h2#details Details
          %p
            Given two coalgebras
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi η
                    %mo :
                    %mi x
                    %mo →
                    %mi F
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, \eta: x \to F x)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi θ
                    %mo :
                    %mi y
                    %mo →
                    %mi F
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (y, \theta: y \to F y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi x
                  %mo →
                  %mi y
                %annotation{:encoding => "application/x-tex"} f: x \to y
            which respects the coalgebra structures:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo ∘
                  %mi f
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi η
                %annotation{:encoding => "application/x-tex"} \theta \circ f = F(f) \circ \eta
          %p
            A
            %strong terminal coalgebra
            (usually called a
            %em final coalgebra
            in the literature) is of course a terminal object in the category of coalgebras. Many data structures can be expressed as terminal coalgebras of suitable endofunctors; a simple but useful theorem says that terminal coalgebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            are “fixed points” of their endofunctors, in that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi x
                    %mo ≅
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F x \cong x
          .num_theorem
            %h6#theorem Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi θ
                    %mo :
                    %mi x
                    %mo →
                    %mi F
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, \theta: x \to F x)
              is a terminal object in the category of
              = succeed "-coalgebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is an isomorphism.
          .proof
            %h6#proof Proof
            %p
              Define a coalgebra structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi x
                  %annotation{:encoding => "application/x-tex"} F x
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi θ
                      %mo :
                      %mi F
                      %mi x
                      %mo →
                      %mi F
                      %mi F
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F\theta: F x \to F F x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi F
                      %mi x
                      %mo →
                      %mi x
                    %annotation{:encoding => "application/x-tex"} f: F x \to x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi x
                    %annotation{:encoding => "application/x-tex"} F x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is a coalgebra map. By terminality of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              again, this gives an equation of coalgebra maps:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi θ
                    %mo =
                    %msub
                      %mn 1
                      %mi x
                    %mo .
                  %annotation{:encoding => "application/x-tex"} f \circ \theta = 1_x.
            %p On the other hand,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ∘
                    %mi f
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi θ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi θ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mn 1
                      %mrow
                        %mi F
                        %mi x
                  %annotation{:encoding => "application/x-tex"} \theta \circ f = F(f) \circ F(\theta) = F(f \circ \theta) = F(1_x) = 1_{F x}
            %p
              where the first equation holds because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a coalgebra map. This completes the proof.
          %p
            To construct terminal coalgebras, the following result is useful and practical. See
            %span.newWikiWord
              Adámek's theorem on terminal coalgebras
              %a{:href => "/nlab/new/Ad%C3%A1mek%27s+theorem+on+terminal+coalgebras"} ?
            for an extension of this result.
          #Adam.num_theorem
            %h6#theorem_2 Theorem
            %p
              %strong (Adámek)
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has a terminal object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              and the limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              of the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi …
                    %msup
                      %mi F
                      %mn 3
                    %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi F
                          %mn 2
                        %mo !
                    %msup
                      %mi F
                      %mn 2
                    %mn 1
                    %mover
                      %mo →
                      %mrow
                        %mi F
                        %mo !
                    %mi F
                    %mn 1
                    %mover
                      %mo →
                      %mo !
                    %mn 1
                    %mspace{:width => "2em"}
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ldots F^3 1 \stackrel{F^2 !}{\to} F^2 1 \stackrel{F !}{\to} F 1 \stackrel{!}{\to} 1 \qquad (1)
            %p
              exists in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              preserves this limit, then the limit carries a structure of terminal coalgebra.
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo :
                    %mi L
                    %mo →
                    %msup
                      %mi F
                      %mi n
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_n: L \to F^n 1
              be the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              projection of the limiting cone. Then we have a cone from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi L
                  %annotation{:encoding => "application/x-tex"} F L
              to the diagram (1) whose components are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi L
                    %mover
                      %mo →
                      %mrow
                        %mi F
                        %msub
                          %mi π
                          %mi n
                    %msup
                      %mi F
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi F
                          %mi n
                        %mo !
                    %msup
                      %mi F
                      %mi n
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} F L \stackrel{F\pi_n}{\to} F^{n+1} 1 \stackrel{F^n !}{\to} F^n 1
            %p
              and the induced map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi L
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} F L \to L
              to the limit is invertible by hypothesis; let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %mi L
                    %mo →
                    %mi F
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \theta: L \to F L
              be the inverse. We claim the coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L, \theta)
              is terminal.
            %p
              Indeed, suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi η
                    %mo :
                    %mi x
                    %mo →
                    %mi F
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, \eta: x \to F x)
              is any coalgebra. We recursively define maps
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi n
                      %mo :
                      %mi x
                      %mo →
                      %msup
                        %mi F
                        %mi n
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f_n: x \to F^n 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 0
                    %mo :
                    %mi x
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f_0: x \to 1
              be the unique map, and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi η
                  %annotation{:encoding => "application/x-tex"} f_{n+1} = F(f_n) \circ \eta
            %p It is easily checked by induction that we have a commutative diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi F
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi F
                                  %mi n
                                %mo !
                          %mtd
                            %msup
                              %mi F
                              %mi n
                            %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %msub
                                    %mi f
                                    %mi n
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msup
                              %mo ↖
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mi n
                        %mtr
                          %mtd
                            %mi F
                            %mi x
                          %mtd
                            %munder
                              %mo ←
                              %mi η
                          %mtd
                            %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F^{n+1}1 &amp; \stackrel{F^n !}{\to} &amp; F^n 1 \\
                    ^\mathllap{F f_n} \uparrow &amp; \nwarrow  ^\mathrlap{f_{n+1}} &amp; \uparrow ^\mathrlap{f_n} \\
                    F x &amp; \underset{\eta}{\leftarrow} &amp; x
                    }
            %p
              defining a cone from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to the diagram (1), and inducing a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} f: x \to L
              such that the following diagram commutes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mi L
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi θ
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %mi L
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %mi f
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %mi F
                            %mi x
                          %mtd
                            %munder
                              %mo ←
                              %mi η
                          %mtd
                            %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F L &amp; \stackrel{\theta^{-1}}{\to} &amp; L \\
                    ^\mathllap{F f} \uparrow &amp; &amp; \uparrow  ^\mathrlap{f} \\
                    F x &amp; \underset{\eta}{\leftarrow} &amp; x
                    }
            %p
              This diagram gives the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a coalgebra map. Moreover, any coalgebra map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} f: x \to L
              leads to a sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                    %mo =
                    %msub
                      %mi π
                      %mi n
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f_n = \pi_n \circ f
              that satisfies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi η
                    %annotation{:encoding => "application/x-tex"} f_{n+1} = F(f_n) \circ \eta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi F
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi F
                                  %mi n
                                %mo !
                          %mtd
                            %msup
                              %mi F
                              %mi n
                            %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi F
                                  %msub
                                    %mi π
                                    %mi n
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msup
                              %mo ↖
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi π
                                    %mi n
                        %mtr
                          %mtd
                            %mi F
                            %mi L
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msup
                                  %mi θ
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %mi L
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F^{n+1}1 &amp; \stackrel{F^n!}{\to} &amp; F^n 1 \\
                    ^\mathllap{F \pi_n} \uparrow &amp; \nwarrow  ^\mathrlap{\pi_{n+1}} &amp; \uparrow  ^\mathrlap{\pi_n} \\
                    F L &amp; \underset{\theta^{-1}}{\to} &amp; L
                    }
            %p
              so that we were forced to define the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n
              by recursion as we did, and the coalgebra map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} f: x \to L
              is therefore uniquely determined.
          %h2#examples Examples
          %h3#UnitInterval Unit interval in the real line
          %p
            As first observed by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Peter+Freyd"} Peter Freyd
            %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ↪
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} [0, 1] \hookrightarrow \mathbb{R}
            inside the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            can be characterized as a suitable terminal coalgebra. There are various ways of realizing this; we give one (but see remarks below).
          %p
            Consider the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/intervals"} intervals
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Int
                  %annotation{:encoding => "application/x-tex"} Int
            %a.existingWikiWord{:href => "/nlab/show/top"} top
            and
            %a.existingWikiWord{:href => "/nlab/show/bottom"} bottom
            elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi Int
                  %mo →
                  %mi Int
                %annotation{:encoding => "application/x-tex"} F: Int \to Int
          %p
            be the endofunctor which takes an interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∨
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \vee X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and gluing the top element of the first copy to the bottom element of the second. The real interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 1]
            becomes a coalgebra if we identify
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ∨
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 1] \vee [0, 1]
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 2]
            and consider the multiplication-by-2 map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, 1] \to [0, 2]
            as giving a coalgebra structure.
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              The interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0, 1]
              is terminal in the category of coalgebras.
          .proof
            %h6#proof_sketch Proof (sketch)
            %p
              Given any coalgebra structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi X
                      %mo ∨
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f: X \to X \vee X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
              lands either in the “lower” half (the first
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∨
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \vee X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∨
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \vee X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                    %mo ∨
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \theta: X \to X \vee X
              as giving an automaton where on input
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              there is output of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi h
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_1, h_1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} h_1
              is either “upper”, “lower”, or “between”. By iteration, this generates a behavior stream
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo ,
                      %msub
                        %mi h
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_n, h_n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi n
                  %annotation{:encoding => "application/x-tex"} h_n
              form a binary expansion to give a number between 0 and 1, and therefore we have an interval map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \to [0, 1]
              which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x_0
              to that number. Of course, should we ever hit
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo ,
                      %mi between
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x_n, between)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi bottom
                      %mi X
                    %mo ,
                    %mi upper
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (bottom_X, upper)
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi top
                      %mi X
                    %mo ,
                    %mi lower
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (top_X, lower)
              and continue the stream, but these streams are identified, and this corresponds to the identification of binary expansions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo .
                    %msub
                      %mi h
                      %mn 1
                    %mo .
                    %mo .
                    %mo .
                    %msub
                      %mi h
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mn 100000
                    %mo .
                    %mo .
                    %mo .
                    %mo =
                    %mo .
                    %msub
                      %mi h
                      %mn 1
                    %mo .
                    %mo .
                    %mo .
                    %msub
                      %mi h
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mn 011111
                    %mo .
                    %mo .
                    %mo .
                  %annotation{:encoding => "application/x-tex"} .h_1... h_{n-1} 100000... = .h_1... h_{n-1}011111...
            %p
              as real numbers. In this way, we produce a unique well-defined interval map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} X \to [0, 1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0, 1]
              is the terminal coalgebra.
          .num_remark
            %h6#remarks Remarks
            %p
              (More material can be found at
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/coalgebra+of+the+real+interval"} coalgebra of the real interval
            %ol
              %li
                %p
                  The same proof shows that we could have considered instead the category of
                  %a.existingWikiWord{:href => "/nlab/show/poset"} posets
                  with separate top and bottom, or even the category of sets with separate top and bottom, with an analogous endofunctor. The reason we chose the category of intervals is (besides the availability of the succinct term ‘interval’) to indicate that choice of interval
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [0, 1]
                  %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                  functor, can be justified on the grounds of a universal property, as shown by this theorem.
              %li
                %p
                  Freyd, in his original
                  %a{:href => "#Freyd"} post
                  on this result, was inspired by a similar theorem due to
                  = succeed "," do
                    %a{:href => "#PP"} Pavlovic and Pratt
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [0, \infty)
                  can be described as the terminal coalgebra for the endofunctor that sends a linearly ordered set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo ×
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \omega \times X
                  with the dictionary order.
              %li
                %p
                  The theorem holds in an arbitrary topos (with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [0, 1]
                  being the interval of
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/real+number+object"} Dedekind reals
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∀
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
                        %mi P
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mo ¬
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo =
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo ∨
                        %mo ¬
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo =
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \forall p\colon P\; (\neg(0 = p) \vee \neg(1 = p))
                %p
                  and provided that the process of gluing endpoints is given correctly. See Johnstone’s
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Elephant"} Elephant
          %h3#categorified_example_trees Categorified example: Trees
          %p
            The notion of terminal coalgebra may be categorified. For example, given a 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and a (pseudo) functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F: C \to C
          %p
            A theoretically important example is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tree"} category of trees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            which takes a locally small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to its small-coproduct cocompletion. Further discussion of this point is given at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pure+set"} pure set
          %p
            The small-coproduct cocompletion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is given by a comma category construction: objects are pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi F
                  %mo :
                  %msub
                    %mi X
                    %mi d
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, F: X_d \to C)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a set and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a functor whose domain is the discrete category on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi d
                  %annotation{:encoding => "application/x-tex"} X_d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, F)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y, G)
            is a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi Φ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f, \Phi)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            is a function and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                  %mo ∘
                  %msub
                    %mi f
                    %mi d
                %annotation{:encoding => "application/x-tex"} \Phi: F \to G \circ f_d
            is a natural transformation. This category is denoted
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                    %mo ≀
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Set \wr C
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+wreath+product"} categorical wreath product
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/club"} club
          %p
            Adámek’s theorem may be adapted to this 2-categorical situation. The iterated
            %a.existingWikiWord{:href => "/nlab/show/categorical+wreath+product"} wreath product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ≀
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (Set \wr)^n 1
            may be identified with the category of
            = succeed "-stage" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ≀
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mn 1
                  %mo =
                  %msup
                    %mi Set
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi op
                %annotation{:encoding => "application/x-tex"} (Set \wr)^n 1 = Set^{[n]^{op}}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            is the linear order
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mn 2
                    %mo ≤
                    %mi …
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1 \leq 2 \leq \ldots \leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo +
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} T: [n+1]^{op} \to Set
            with the condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} T(0) = 1
            is terminal; the element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(0)
            is considered to be the root of the tree.
          %p Indeed, we realize an explicit equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo :
                  %mi Set
                  %mo ≀
                  %msup
                    %mi Set
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi op
                  %mo ≃
                  %msup
                    %mi Set
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi op
                %annotation{:encoding => "application/x-tex"} \Sigma: Set \wr Set^{[n]^{op}} \simeq Set^{[n+1]^{op}}
          %p
            by defining
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi F
                  %mo :
                  %mi X
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma(X, F: X \to Set^{[n]^{op}})
            to be the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo +
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} T: [n+1]^{op} \to Set
            that on the object level takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} i+1
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sum_{x \in X} F(x)(i).
          %p
            On the morphism level,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %mo →
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(i+1 \to i)
            is the coproduct of morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo →
                  %mi i
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{x \in X} F(x)(i \to i-1)
          %p
            (and this makes sense for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ≤
                  %mi i
                  %mo ≤
                  %mi n
                %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
            under the convention
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} F(x)(0) = 1
          %p The morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ≀
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo !
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ≀
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mi Set
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ≀
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (Set \wr)^n !: (Set \wr)^n Set \to (Set \wr)^n 1
          %p used in Adámek’s theorem is identified with the restriction functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi op
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{[n+1]^{op}} \to Set^{[n]^{op}}
          %p
            which restricts presheaves along the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n] \hookrightarrow [n+1]
          %p The 2-limit of the diagram in Adámek’s theorem is then
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi ω
                        %mi op
                  %mo ,
                %annotation{:encoding => "application/x-tex"} Set^{\omega^{op}},
          %p
            aka the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tree"} category of trees
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is the colimit of the finite ordinals
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
          %h3#fractals Fractals
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theoretic
            treatments of the self-similarity found in
            %a.existingWikiWord{:href => "/nlab/show/fractals"} fractals
            in terms of terminal coalgebras, see
            = succeed "," do
              %a{:href => "#Leinster10"} Leinster 10
            = succeed "." do
              %a{:href => "#BhattacharyaMossRatnayakeRose2014"} Bhattacharya, Moss, Ratnayake &amp; Rose 2014
          %h3#further_examples Further examples
          %div
            %p
            .num_remark
              %h6 Example
              %p
                A list of notable
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/endofunctors"} endofunctors
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/initial+algebras+of+an+endofunctor"} initial algebras
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/terminal+coalgebra+of+an+endofunctor"} terminal coalgebras
              %blockquote
                %p Nonexistent (co)algebras are labelled with ‘/’, and unknown ones with ‘?’.
              %table
                %thead
                  %tr
                    %th Base category
                    %th Endofunctor
                    %th Initial Algebra
                    %th Final Coalgebra
                    %th Note, reference
                %tbody
                  %tr
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/constant+functor"} Const
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                    %td{:style => "text-align: center;"}
                  %tr
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo ↦
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X \mapsto X
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ∅
                          %annotation{:encoding => "application/x-tex"} \varnothing
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} 1
                    %td{:style => "text-align: center;"}
                  %tr
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo ↦
                            %mn 1
                            %mo +
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X \mapsto 1 + X
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ℕ
                          %annotation{:encoding => "application/x-tex"} \mathbb{N}
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/conatural+number"} Conatural numbers
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ℕ
                              %mn ∞
                          %annotation{:encoding => "application/x-tex"} \mathbb{N}^\infty
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/extended+natural+number"} extended natural number
                  %tr
                    %td{:style => "text-align: center;"}
                      %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    %td{:style => "text-align: center;"}
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                            %mo ↦
                            %mi A
                            %mo +
                            %mi X
