                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                    %mo ∖
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} A^* \setminus \Lambda
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
