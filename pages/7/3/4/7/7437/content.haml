                          %mn 1
                          %mo{:stretchy => "false"} }
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:stretchy => "false"} {
                          %mi α
                          %mo ∈
                          %mi P
                          %mi X
                          %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                          %msub
                            %mi q
                            %mi s
                          %mo{:stretchy => "false"} (
                          %mi α
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                          %mspace{:width => "thickmathspace"}
                          %mtext for all
                          %mspace{:width => "thickmathspace"}
                          %mi s
                          %mo ∉
                          %mi b
                          %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  D_b &amp;\coloneqq \{\alpha \in P X \mid \sum_{s \in b} q_s(\alpha) = 1 \} \\
