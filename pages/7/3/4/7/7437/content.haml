          %h1#schedules Schedules
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#schedules"} Schedules
              %li
                %a{:href => "#paths"} Paths
              %li
                %a{:href => "#secschthm"} Schedule Theorem
              %li
