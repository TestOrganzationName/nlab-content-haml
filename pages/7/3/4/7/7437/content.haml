                      %mrow
                        %mi s
                        %mo ∈
                        %mi b
                    %msub
                      %mi q
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
