                  %mn 0
                %annotation{:encoding => "application/x-tex"} q_s \mid V = 0
            and so for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ∈
                    %mi V
