          %p
            One then finds that the
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            groupoid for this target
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} X = \mathbf{B}G_{conn}
            is the groupoid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothGrpd
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi G
                  %msub
                    %mi Bund
                    %mi conn
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  SmoothGrpd(\Sigma , \mathbf{B}G_{conn})
                  \\simeq
                  G Bund_{conn}(\Sigma)
                  \\,,
          %p
            whose objects are smooth
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            or of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothGrpd
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Conf
                    %mrow
                      %mi Yang
                      %mo −
                      %mi Mills
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Conf
                    %mrow
                      %mi Chern
                      %mo −
                      %mi Simons
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  SmoothGrpd(\Sigma, \mathbf{B}G_{conn})
                  \\simeq
                  Conf_{Yang-Mills}(\Sigma)
                  \\simeq
                  Conf_{Chern-Simons}(\Sigma)
                  \\,.
          %p
            Notice that this configuration space is now itself a groupoid: morphisms are
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            here as an
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} SmoothGrpd
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal
            approximation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi Conf
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi LieAld
                  %annotation{:encoding => "application/x-tex"} Lie(Conf(\Sigma)) \in LieAld
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"}> Lie algebroid
                s
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+algebras+on+%E2%88%9E-stacks"} function algebras
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"}> Chevalley-Eilenberg algebra
              s
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi Conf
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(Lie(Conf(\Sigma)))
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            is in physics called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
            %a.existingWikiWord{:href => "/nlab/show/cotangent+vector"} cotangents
            to the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conf
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Conf(\Sigma)
            %em ghost fields
            of gauge theory.
          %p
            Of course we already saw secretly groupoidal configuration spaces in the
            %a{:href => "ExpositionClassical"} above
            list of examples of
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\Sigma,X)//Diff(\Sigma)
            were
            = succeed "s;" do
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy quotients
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/2-colimit"} weak quotients
            \: they are the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Diff(\Sigma)
            acting on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(\Sigma,X)
          %p
            We will see in the examples below that there is, of course, no reason to stop after passing from target manifolds to smooth target groupoids. At least as the
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/3-groupoid"} 3-groupoid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoids"} smooth ∞-groupoids
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            to
            %em
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            \.
          %p
            Given that it does thus make sense to regard general
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            = succeed "-models," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
          %p
            for instance we have a
            %a{:href => "http://ncatlab.org/nlab/show/smooth%20infinity-groupoid#CohomologyOfLieGroups"} theorem
            that says that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a compact Lie group, there is, for every integral cohomology class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %msup
                    %mi H
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mi G
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c \in H^{n+1}(B G, \mathbb{Z})
            of the classifying space of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            – a
            %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            for
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{c} : \mathbf{B}G \to \mathbf{B}^n U(1)
            to a smooth
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle"} circle n-bundle
            on the smooth
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            %a.existingWikiWord{:href => "/nlab/show/infinity-Chern-Weil+theory"} theorem
            that for sufficiently highly connected Lie groups or smooth
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            on the differentially refined smooth moduli space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi n
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\hat \mathbf{c} : \mathbf{B}G_{conn} \to \mathbf{B}^n U(1)_{conn}
                  \\,.
          %p
            This assignment generalizes the classical
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            \. The first example
            %a{:href => "#SigmaCS"} below
            shows that ordinary
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            is a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            this way as
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theories"} ∞-Chern-Simons theories
          %p
            The second example
            %a{:href => "#SigmaDW"} below
            shows that ordinatry
            %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theory"} Dijkgraaf-Witten theory
            is a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
            and
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            this way as
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Dijkgraaf-Witten+theories"} ∞-Dijkgraaf-Witten theories
          %h3#SigmaCS
            Chern-Simons theory as a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            One of the earliest
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theories"} topological quantum field theories
            ever considered in detail is
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            \. We introduce this from the point of view of
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %a{:href => "#HigherGeometricTargetSpaces"} above
          %p
            An ordinary (as opposed to higher)
            %em
              %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            is a
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            whose field configurations on a manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            are
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connections
            on
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %em
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            is essentially the physics equivalent of the word
            %em
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            , referring to isomorphisms in a
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of a field theory and specifically to isomorphisms between such bundles with connection. The
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of a gauge theory is to be
            %em
              %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
            meaning that it assigns the same value to configurations that are related by a gauge transformaiton. This means precisely that the exponentiated action is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi G
                  %msub
                    %mi Bund
                    %mi conn
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(-)) :  G Bund_{conn}(\Sigma) \to U(1)
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            of gauge field configurations and gauge transformaitons, to the
            %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            (regarded as a
            %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
            groupoid).
          %p
            The first nonabelian gauge theory to receive attention was
            %em
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            \: in that model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is a 4-dimensional
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            modelling
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            is given by the integral of differential 4-forms naturally associated with a connection and a Riemannian structure:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi YM
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mi Σ
                  %mfrac
                    %mn 1
                    %mrow
                      %msup
                        %mi e
                        %mn 2
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %mo ⋆
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mi i
                  %mi θ
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S_{YM}(-)) : (P, \nabla) \mapsto \exp(i \int_\Sigma
                  \\frac{1}{e^2} \langle F_\nabla \wedge \star F_\nabla\rangle
                  +
                  i \theta \langle F_\nabla \wedge  F_\nabla
                  \\rangle)
                  \\,.
          %p Here
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                is any
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                    %annotation{:encoding => "application/x-tex"} \nabla
                a
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
                on it;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo ∇
                      %mo ∈
                      %msup
                        %mi Ω
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ,
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_\nabla \in \Omega^2(P, \mathfrak{g})
                is the
                = succeed "-valued" do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                2-form of this connection;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                      %mo :
                      %mi 𝔤
                      %mo ⊗
                      %mi 𝔤
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \langle -,-\rangle : \mathfrak{g} \otimes \mathfrak{g} \to \mathbb{R}
                is an
                %em
                  %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
                on the Lie algebra: a bilinear form that is gauge invariant when evaluated on curvature 2-forms – for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                a
                %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
                this would be the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
                and for a
                %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+algebra"} matrix Lie algebra
                this is simply the
                %a.existingWikiWord{:href => "/nlab/show/trace"} trace
                operation on products of matrices;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                is the
                %a.existingWikiWord{:href => "/nlab/show/Hodge+star"} Hodge star
                operator given by the pseudo-Riemannian metric structure on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Σ
                      %annotation{:encoding => "application/x-tex"} \Sigma
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} e \in \mathbb{R}
                is some constant, called the
                %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
                of the model;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
                is another parameter called the
                = succeed "." do
                  %span.newWikiWord
                    theta-angle
                    %a{:href => "/nlab/new/theta-angle"} ?
          %p
            The first summand in the exponent, that depending on the pseudo-Riemannian structure, is the crucial term for the direct application of this as a model of phenomenologically observed physics: it controls the dynamics of three of the four
            %a.existingWikiWord{:href => "/nlab/show/force"} force
            fields in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
          %p
            Instead of investigating this further, we shall here look at the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mrow
                      %msup
                        %mi e
                        %mn 2
                %annotation{:encoding => "application/x-tex"} \frac{1}{e^2}
            is set to 0. While not
            %em directly
            of phenomenological relevance, this is of quite some interest for the general theoretical understanding of the space of all possible field theories. Since the resulting action functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi tYM
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mi Σ
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mo ∇
                  %mo ∧
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} ⟩
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S_{tYM}) : (P, \nabla) \mapsto \exp(i \int_\Sigma \langle F_\nabla \wedge F_\nabla \rangle)
          %p
            no longer depends on any extra (pseudo-Riemannian) structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            this may be interpreted as defining a
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theory"} topological quantum field theory
            \: one speaks of
            %em
              %a.existingWikiWord{:href => "/nlab/show/topological+Yang-Mills+theory"} topological Yang-Mills theory
            \.
          %p
            This is not quite a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+Yang-Mills+theory"} topological Yang-Mills theory
            does consist of maps into the
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} X = \mathbf{B}G_{conn}
            (the smooth
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")," do
              %a{:href => "HigherGeometricTargetSpaces"} above
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher holonomy
            of a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            on this target space. This is because, at least for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+group"} semisimple Lie group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mi dim
                    %mi Σ
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} n = dim \Sigma = 4
          %p
            But something closely related is true:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi tYM
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(i S_{tYM})
            is the integrated
            %em
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            functional of a circle
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
            \.
          %p
            This means the following: in generalization of how an ordinary
            %a.existingWikiWord{:href => "/nlab/show/circle+bundle"} circle bundle
            with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            has a
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form, a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on a manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has a curvature
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_\nabla \in \Omega^{n+1}_{cl}(X)
            %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes theorem
            holds true for them: for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            of dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n+1
            and denoting by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \partial \Sigma
            the
            %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo :
                  %mi Σ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma : \Sigma \to X
            a
            = succeed "-shaped" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            equals the
            %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher holonomy
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            over
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \partial_\Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mi Σ
                  %msup
                    %mi ϕ
                    %mo *
                  %msub
                    %mi F
                    %mo ∇
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi hol
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %mi γ
                  %msub
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mo ∂
                      %mi Σ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i \int_\Sigma \phi^* F_\nabla)
                  \=
                  hol(\nabla, \gamma|_{\partial \Sigma})
                  \\,.
          %p
            This property in fact characterizes equivalence classes of circle
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %em
              %a.existingWikiWord{:href => "/nlab/show/Cheeger-Simons+differential+characters"} Cheeger-Simons differential characters
            \.
          %p
            Therefore, if we can find a circle 3-bundle with connection on the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            of
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            4-form at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ,
                  %mo ∇
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P,\nabla)
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle F_\nabla \wedge F_\nabla \rangle
            %a.existingWikiWord{:href => "/nlab/show/topological+Yang-Mills+theory"} topological Yang-Mills theory
            on a 4-dimensional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            with boundary as being given by a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \partial \Sigma
            with
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            that circle 3-bundle.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a connected and
            %a.existingWikiWord{:href => "/nlab/show/simply+connected"} simply connected
            Lie group, such a circle 3-bundle indeed exists. Its characteristic morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}\hat \mathbf{p}_1 :
                  \\mathbf{B}G_{conn}
                  \\to
                  \\mathbf{B}^3 U(1)_{conn}
          %p
            from the smooth moduli stack of
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 3-bundles with connection
            is constructed and discussed in (
            %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(?%2C1)-topos+--+references#FSS"}> Fiorenza-Schreiber-Stasheff
            ), see
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+circle+3-bundle"} Chern-Simons circle 3-bundle
            \. This is the differential refinement of the
            %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} smooth first fractional Pontryagin class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi p
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}\mathbf{p}_1 : \mathbf{B}G \to \mathbf{B}^3 U(1)
          %p
            which in turn is a smooth refinement of the fractional
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %mi B
                  %mi G
                  %mo →
                  %msup
                    %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 4
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2} p_1 : B G \to B^3 U(1) \simeq K(\mathbb{Z}, 4)
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
          %p
            To get a feeling for what this circle 3-bundle is like, we look at what its pull-back
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Σ
                  %mover
                    %mo →
                    %mi ϕ
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mover
                    %mo →
                    %mrow
                      %mfrac
                        %mn 1
                        %mn 2
                      %msub
                        %mover
                          %mstyle{:mathvariant => "bold"}
                            %mi p
                          %mo{:stretchy => "false"} ^
                        %mn 1
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1(\phi) : \Sigma \stackrel{\phi}{\to} \mathbf{B}G_{conn} \stackrel{\frac{1}{2} \hat \mathbf{p}_1}{\to} \mathbf{B}^3 U(1)_{conn}
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            along any field configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi Σ
                  %mo →
                  %mi X
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \phi : \Sigma \to X = \mathbf{B}G_{conn}
            is like.
          %p
            Notice that for simply conneced
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B G
            has vanishing
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≤
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} k \leq 3
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            on the 3-dimensional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \partial \Sigma
            is necessarily trivializable. In this case the
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configuration space
            of the
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie+algebra+valued+forms"} groupoid of Lie algebra valued forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothGrpd
                  %mo{:stretchy => "false"} (
                  %mo ∂
                  %mi Σ
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo ∂
                  %mi Σ
                  %mo ,
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mo ∂
                  %mi Σ
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  SmoothGrpd(\partial \Sigma, \mathbf{B}G_{conn})
                  \\simeq
                  \\Omega^1(\partial \Sigma, \mathfrak{g})//C^{\infty}(\partial \Sigma,G)
          %p
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \partial \Sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} mathrak
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in \Omega^1(\Sigma, \mathrak{g})
            a field configuration and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi A
                  %mo =
                  %mi d
                  %mi A
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ∧
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F_A = d A + \frac{1}{2}[A \wedge A]
            the corresponding curvature 2-form, the curvature 4-form of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1(\phi)
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi F
                      %mi A
                    %mo ∧
                    %msub
                      %mi F
                      %mi A
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle F_A \wedge F_A \rangle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            satisfying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %msub
                    %mi F
                    %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} d C = \langle F_A \wedge F_A \rangle
            is – up to a closed 3-form – the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+form"} Chern-Simons 3-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi cs
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mo ∧
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} ⟩
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 6
                  %mo{:stretchy => "false"} ⟨
                  %mi A
                  %mo ∧
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo ∧
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C = cs(A) = \langle A \wedge F_A \rangle + \frac{1}{6}\langle A \wedge [A \wedge A]\rangle
                  \\,.
          %p
            Therefore the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of the 3-dimensional
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mover
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo →
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 3
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}\hat \mathbf{p}_1 : \mathbf{B}G_{conn} \to  \mathbf{B}^3 U(1)_{conn}
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi Σ
                        %mn 3
                  %mo :
                  %mi A
                  %mo ↦
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mrow
                      %msub
                        %mi Σ
                        %mn 3
                  %mi cs
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S(-))_{\Sigma_3} : A \mapsto
                  \\exp(i \int_{\Sigma_3} cs(A))
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            defined by this action functional is known as
            %em
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            \.
          %h3#AKSZSigmaModel
            AKSZ theory as a higher Chern-Simons
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %h4#summary Summary
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔓
                %annotation{:encoding => "application/x-tex"} \mathfrak{P}
            serves as the
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            of a canonically defined topological
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
            %a.existingWikiWord{:href => "/nlab/show/AKSZ+theory"} AKSZ sigma-model
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
          %p This subsumes the following examples:
          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔓
                    %annotation{:encoding => "application/x-tex"} \mathfrak{P}
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
                = succeed "-model" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔓
                    %annotation{:encoding => "application/x-tex"} \mathfrak{P}
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
                = succeed "-model" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔓
                    %annotation{:encoding => "application/x-tex"} \mathfrak{P}
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Courant+Lie+2-algebroid"} Courant Lie 2-algebroid
                = succeed "-model" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                      %annotation{:encoding => "application/x-tex"} \sigma
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Courant+sigma-model"} Courant sigma-model
          %p
            Also the
            %a.existingWikiWord{:href => "/nlab/show/A-model"} A-model
            and the
            %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
            2-dimensional topological
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            The AKSZ
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            turns out to be very fundamental:
          %p
            by
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+theory"} ∞-Chern-Weil theory
            every
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            on an
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid"} L-∞ algebroid
            induces an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Weil+homomorphism"} ∞-Chern-Weil homomorphism
            and the corresponding
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
            action functional. Moreover, every
            %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
            canonically carries a binary invariant polynomial. The AKSZ
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "-Chern-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            This is shown at
            = succeed "." do
              %a{:href => "http://ncatlab.org/schreiber/show/infinity-Chern-Simons+theory+--+examples#ASKZTheory"} ∞-Chern-Simons theory – Examples – AKSZ theory
          %h4#definition Definition
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            is, roughly, one
          %ul
            %li
              %p
                whose fields are maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi Σ
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \phi : \Sigma \to X
                to some space
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                whose
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                is, apart from a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic term
                %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
                of some kind of
                %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Map
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{Map}(\Sigma,X)
          %p
            Here the terms “space”, “maps” and “cocycles” are to be made precise in a suitable context. One says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            and the cocycle is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
            \.
          %p
            For instance the ordinary charged
            %a.existingWikiWord{:href => "/nlab/show/particle"} particle
            (for instance an electron) is described by a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \Sigma = (0,t) \subset \mathbb{R}
            is the abstract
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/worldline"} worldline
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a smooth (
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"}> pseudo
            \-)
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
            (for instance our
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            %a.existingWikiWord{:href => "/nlab/show/circle+bundle"} circle bundle
            with
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (a degree-2 cocycle in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em
              %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
            \: up to a kinetic term the action functional is the
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            of the connection over a given
            %a.existingWikiWord{:href => "/nlab/show/curve"} curve
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi : \Sigma \to X
          %p
            The
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %em higher
            generalizations of this example, where the background gauge field is a cocycle of higher degree (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+infinity-bundle"} higher bundle with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is allowed to be not just a manifold but an approximation to a
            %em
              higher
              %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
              (a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
          %p
            More precisely, here we take the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/space"} space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dg-geometry"} smooth dg-manifolds
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Maps}(\Sigma,X)
            given by
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/dg-geometry"} dg-manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            their canonical degree-1 vector fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi Σ
                %annotation{:encoding => "application/x-tex"} v_\Sigma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi X
                %annotation{:encoding => "application/x-tex"} v_X
            acting on the mapping space from the left and right. In this sense their linear combination
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi Σ
                  %mo +
                  %mi k
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi v
                    %mi X
                %annotation{:encoding => "application/x-tex"} v_\Sigma + k \, v_X
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{R}
            equips also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Maps}(\Sigma,X)
            with the structure of a differential graded smooth manifold.
          %p
            Moreover, we take the “cocycle” on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to be a graded
            %a.existingWikiWord{:href => "/nlab/show/symplectic+structure"} symplectic structure
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            that allows to form the
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi Σ
                  %msup
                    %mi{:mathvariant => "normal"} ev
                    %mo *
                  %mi ω
                  %mo :
                  %mo =
                  %msub
                    %mi p
                    %mo !
                  %msup
                    %mi{:mathvariant => "normal"} ev
                    %mo *
                  %mi ω
                %annotation{:encoding => "application/x-tex"}
                  \\int_\Sigma \mathrm{ev}^* \omega
                  \:=
                  p_! \mathrm{ev}^* \omega
          %p
            by
            %a.existingWikiWord{:href => "/nlab/show/integral+transform"} pull-push
            through the canonical
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ←
                    %mi p
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Σ
                  %mover
                    %mo →
                    %mi ev
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Maps}(\Sigma,X)
                  \\stackrel{p}{\leftarrow}
                  \\mathrm{Maps}(\Sigma,X) \times \Sigma
                  \\stackrel{ev}{\to}
                  X
                  \\,,
          %p
            where on the right we have the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
          %p
            Assuming that one succeeds in making precise sense of all this one expects to find that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi Σ
                  %msup
                    %mi{:mathvariant => "normal"} ev
                    %mo *
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \int_\Sigma \mathrm{ev}^* \omega
            is in turn a symplectic structure on the mapping space. This implies that the vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi Σ
                  %mo +
                  %mi k
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi v
                    %mi X
                %annotation{:encoding => "application/x-tex"} v_\Sigma + k\, v_X
            on mapping space has a
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Maps
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{S} \in C^\infty(\mathrm{Maps}(\Sigma,X))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi{:mathvariant => "normal"} AKSZ
                %annotation{:encoding => "application/x-tex"} S_{\mathrm{AKSZ}}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi S
                %annotation{:encoding => "application/x-tex"} \mathbf{S}
            then constitute a functional on the space of maps of graded manifolds
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Sigma \to X
            %strong AKSZ action functional
            defining the AKSZ
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and background field/cocycle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
          %p
            In (
            %a{:href => "#AKSZ"}> AKSZ
            ) this procedure is indicated only somewhat vaguely. The focus of attention there is a discussion, from this perspective, of the action functionals of the 2-dimensional
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %em
              %a.existingWikiWord{:href => "/nlab/show/A-model"} A-model
            and the
            %em
              %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
            \.
          %p
            In (
            %a{:href => "#Roytenberg"}> Roytenberg
            ), a more detailed discussion of the general construction is given, including an explicit and general formula for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi S
                %annotation{:encoding => "application/x-tex"} \mathbf{S}
            and hence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi{:mathvariant => "normal"} AKSZ
                %annotation{:encoding => "application/x-tex"} S_{\mathrm{AKSZ}}
            \. For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi x
                    %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{x^a\}
            a coordinate chart on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            that formula is the following.
          #TheAKSZAction.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic dg-manifold
              of grade
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              a smooth compact manifold of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{R}
              %strong AKSZ action functional
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi{:mathvariant => "normal"} AKSZ
                        %mo ,
                        %mi k
                    %mo :
                    %mi{:mathvariant => "normal"} SmoothGrMfd
                    %mo{:stretchy => "false"} (
                    %mi 𝔗
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    S_{\mathrm{AKSZ},k} :
                    \\mathrm{SmoothGrMfd}(\mathfrak{T}\Sigma, X)
                    \\to
                    \\mathbb{R}
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔗
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathfrak{T}\Sigma
              is the shifted tangent bundle)
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi{:mathvariant => "normal"} AKSZ
                        %mo ,
                        %mi k
                    %mo :
                    %mi ϕ
                    %mo ↦
                    %msub
                      %mo ∫
                      %mi Σ
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mn 2
                      %msub
                        %mi ω
                        %mi ab
                      %msup
                        %mi ϕ
                        %mi a
                      %mo ∧
                      %msub
                        %mi d
                        %mi{:mathvariant => "normal"} dR
                      %msup
                        %mi ϕ
                        %mi b
                      %mo +
                      %mi k
                      %mspace{:width => "thinmathspace"}
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo ∧
                      %mi ⋯
                      %mo ∧
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    S_{\mathrm{AKSZ},k}
                    \:
                    \\phi
                    \\mapsto
                    \\int_\Sigma
                    \\left(
                    \\frac{1}{2}\omega_{ab} \phi^a \wedge d_{\mathrm{dR}}\phi^b
                    +
                    k
                    \\,
                    \\pi(\phi\wedge \cdots \wedge \phi)
                    \\right)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              is the
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi X
                  %annotation{:encoding => "application/x-tex"} v_X
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              and where on the right we are interpreting fields as forms on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            This formula hence defines an infinite class of
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \omega)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{R}
            = succeed ")" do
              %a{:href => "#AKSZ"} AKSZ
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            is a special case of this for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            of grade 2, as is the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            of grade 1 (and hence, as shown there, also the
            %a.existingWikiWord{:href => "/nlab/show/A-model"} A-model
            and the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/B-model"} B-model
            = succeed ")" do
              %a{:href => "#Roytenberg"} Roytenberg
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            of grade 2, which is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Courant+sigma-model"} Courant sigma-model
            there.
          %p
            One nice aspect of this construction is that it follows immediately that the full Hamiltonian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi S
                %annotation{:encoding => "application/x-tex"} \mathbf{S}
            on mapping space satisfies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi S
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \{\mathbf{S}, \mathbf{S}\} = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} Maps
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi v
                    %mi Σ
                  %mo +
                  %mi k
                  %msub
                    %mi v
                    %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathrm{Maps}(\Sigma,X), v_\Sigma + k v_X)
            in degree 0 is the space of functions on those fields that satisfy the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange equations
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi{:mathvariant => "normal"} AKSZ
                  %annotation{:encoding => "application/x-tex"} S_{\mathrm{AKSZ}}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi S
                %annotation{:encoding => "application/x-tex"} \mathbf{S}
            is a solution of the “master equation” of a
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            for the quantum field theory defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi{:mathvariant => "normal"} AKSZ
                  %annotation{:encoding => "application/x-tex"} S_{\mathrm{AKSZ}}
          %h3#SigmaDW
            Dijkgraaf-Witten theory as a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p
            THe 3-dimensional
            %a.existingWikiWord{:href => "/nlab/show/TQFT"} TQFT
            %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theory"} Dijkgraaf-Witten theory
            can be understood as being the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
          %p
            See
            %a{:href => "http://ncatlab.org/schreiber/show/infinity-Chern-Simons+theory+--+examples#DiscreteTargets"} ∞-Chern-Simons theory – Examples – Dijkgraaf-Witten theory
          %h3#the_yetter_model_as_a_model
            The Yetter model as a
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          %p (…)
          %h3#dijkgraafwitten_theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Dijkgraaf-Witten theory
          %p (…)
          %h3#chernsimons_theory_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Chern-Simons theory
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
          %h2#references References
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/AKSZ+sigma-model"} AKSZ sigma-model
            is discussed in
          %ul#AKSZ
            %li
              M. Alexandrov,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"} M. Kontsevich
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Albert+Schwarz"} A. Schwarz
              = succeed "," do
                %em The geometry of the master equation and topological quantum field theory
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9502010"} arXiv:hep-th/9502010
          %ul#Roytenberg
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitry+Roytenberg"}> Dmitry Roytenberg
              ,
              %em AKSZ-BV Formalism and Courant Algebroid-induced Topological Field Theories
              Lett.Math.Phys.79:143-159,2007 (
              %a{:href => "http://arxiv.org/abs/hep-th/0608150"}> arXiv
              ).
          %p
            General
            = succeed "-Chern-Simons" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chris+Rogers"} Chris Rogers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/infinity-Chern-Simons+theory"} infinity-Chern-Simons theory
