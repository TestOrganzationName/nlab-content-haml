                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            is the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %msub
                    %mi A
                    %mn 1
                  %mo →
                  %msub
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} g : A_1 \to A_2
            is a smooth
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi A
                    %mn 2
                  %mo =
                  %mi g
                  %mi A
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo +
                  %mi g
                  %mi d
                  %msup
                    %mi g
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} g \in C^\infty(U, G) : A_2 = g A g^{-1} + g d g^{-1}
            between two such form data. (This is “non-concrete” because the smooth
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} U \to \mathbf{B}G_{conn}
            are not
            = succeed "-families" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
