            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Exit
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi Strat
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Pos
                %annotation{:encoding => "application/x-tex"} \mathsf{Exit} : \mathbf{Strat} \to \mathbf{Pos}
            (
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> dually
            , using
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} op
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi Pos
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Pos
                %annotation{:encoding => "application/x-tex"} (-)^{\mathrm{op}} : \mathbf{Pos} \to \mathbf{Pos}
            one obtains the entrance path poset functor
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Entr
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi Strat
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Pos
                  %annotation{:encoding => "application/x-tex"} \mathsf{Entr} \colon \mathbf{Strat} \to \mathbf{Pos}
          %p
          #ClassifyingStratification.num_defn
            %h6 Definition
            %p
              Every poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              has a
              %strong classifying stratification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∥
                    %mi P
                    %mo ∥
                  %annotation{:encoding => "application/x-tex"} \parallel P \parallel
              (also called the
              %em stratified realization
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              is the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi P
                      %mo |
                  %annotation{:encoding => "application/x-tex"} \left|   P \right|
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              (i.e. the
              %a.existingWikiWord{:href => "/nlab/show/topological+realization"} topological realization
              of the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+nerve"} simplicial nerve
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              = succeed ")" do
                %a.maruku-ref{:href => "#CharacteristicMap"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi P
                      %mo |
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \left| P \right| \to P
              that maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %msup
                        %mi P
                        %mrow
                          %mo ≤
                          %mi x
                      %mo |
                    %mo ∖
                    %mrow
                      %mo |
                      %msup
                        %mi P
                        %mrow
                          %mo &lt;
                          %mi x
                      %mo |
                  %annotation{:encoding => "application/x-tex"} \left| P^{\leq x} \right| \setminus \left| P^{\lt x} \right|
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              (here, the full subposets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mrow
                        %mo ≤
                        %mi x
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ≤
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} P^{\leq x} = \{y \leq x\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mrow
                        %mo &lt;
                        %mi x
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo &lt;
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} P^{\lt x} = \{y \lt x\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              are the “lower” resp. “strict lower closures” of an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %mi P
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} F \colon P \to Q
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo ∥
                        %mi F
                        %mo ∥
                      %mo{:lspace => "verythinmathspace"} :
                      %mrow
                        %mo ∥
                        %mi P
                        %mo ∥
                      %mo →
                      %mrow
                        %mo ∥
                        %mi Q
                        %mo ∥
                    %annotation{:encoding => "application/x-tex"} {\parallel F \parallel} \colon {\parallel P \parallel} \to {\parallel Q \parallel}
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo ∥
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ∥
                      %mo{:lspace => "verythinmathspace"} :
                      %mstyle{:mathvariant => "bold"}
                        %mi Pos
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi Strat
                    %annotation{:encoding => "application/x-tex"} {\parallel - \parallel} \colon \mathbf{Pos} \to \mathbf{Strat}
          %p
            Every classifying stratification is frontier-constructible (Rmk.
            = succeed ")." do
              %a.maruku-ref{:href => "#FrontierCondition"}
          %p It makes sense to further terminologically distinguish maps of stratifications as follows.
          %p#stratified_map_types
          .num_defn
            %h6 Terminology
            %p
              %strong (Types of stratified maps)
              %br/
              A stratified map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \colon (X,f) \to (Y,g)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#StratifiedMap"}
            %ul
              %li
                %p
                  a
                  %strong substratification
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} F \colon X \to Y
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Exit
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathsf{Exit}(F)
                  is
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %msup
                          %mi g
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo ∘
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Exit
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X = g^{-1} \circ \mathsf{Exit}(F) \circ f (X)
                  then one says the substratification is
                  = succeed ";" do
                    %strong constructible
              %li
                %p
                  a
                  %strong coarsening
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} F \colon X \to Y
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  (to emphasize the opposite process, one also calls
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  a
                  = succeed ");" do
                    %strong refinement
              %li
                %p
                  a
                  %strong stratified homeomorphism
                  (or
                  = succeed ")" do
                    %strong stratified iso
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} F \colon X \to Y
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                  of
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Exit
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathsf{Exit}(F)
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/posets"} posets
              %li#stratified_bundle
                %p
                  a
                  %strong stratified bundle
                  if points
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi s
                      %annotation{:encoding => "application/x-tex"} x \in s
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
                  a stratum of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y,g)
                  admit
                  %a.existingWikiWord{:href => "/nlab/show/open+neighbourhoods"} open neighbourhoods
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi x
                        %mo ⊂
                        %mi s
                      %annotation{:encoding => "application/x-tex"} U_x \subset s
                  such that, up to stratified iso,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  restricts on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F^{-1}(U_x)
                  to a projection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi x
                        %mo ×
                        %msub
                          %mi f
                          %mi x
                        %mo →
                        %msub
                          %mi U
                          %mi x
                      %annotation{:encoding => "application/x-tex"} U_x \times f_x \to U_x
                  (see Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#defn_strat_product"}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi F
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mi f
                            %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (F^{-1}(x),f_x)
            %p
          %p#constructible_strat_bun
          .num_remark
            %h6 Remark
            %p
              (Constructible bundles). The preceding definition of stratified bundles is rather weak, and in practice one often finds bundles that satisfy stronger conditions, such as constructibility: a
              %em constructible
              stratified bundle is a bundle that, up to bundle isomorphism, can be classified by functorial information associated to the fundamental category (see Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#defn_exit_path_cat"}
              = succeed ")." do
                %a{:href => "#AyalaFrancisRozenblyum15"} Sec. 6.3, Ayala-Francis-Rozenblyum 2015
          %h2#fundamental_categories Fundamental categories
          %p
            Just as spaces have
            %a.existingWikiWord{:href => "/nlab/show/fundamental+infinity-groupoid"} fundamental
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+infinity-groupoid"} groupoids
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+category"} fundamental categories
            %em sets
            for spaces is now played by
            = succeed ":" do
              %em posets
          %table
            %thead
              %tr
                %th base concept
                %th
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-concept
                %th presentation
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/set"} sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≃
                      %annotation{:encoding => "application/x-tex"} \simeq
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (0,0)
                  %a.existingWikiWord{:href => "/nlab/show/0-category"} categories
                %td{:style => "text-align: left;"}
                  ∞-sets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≃
                      %annotation{:encoding => "application/x-tex"} \simeq
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} spaces
                %td{:style => "text-align: left;"} sets with w.e.
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/poset"} posets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≃
                      %annotation{:encoding => "application/x-tex"} \simeq
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (0,1)
                  %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-category"} categories
                %td{:style => "text-align: left;"}
                  ∞-posets
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≃
                      %annotation{:encoding => "application/x-tex"} \simeq
                  %strong stratified spaces
                %td{:style => "text-align: left;"} posets with w.e.
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/category"} categories
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo =
                      %annotation{:encoding => "application/x-tex"} =
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (1,1)
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} ∞-categories
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with w.e.
          %p
            In the table, an “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-X” is intuitively to be understood as an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C%E2%88%9E%29-category"} (∞,∞)-category
            which admits a
            %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative functor
            to an X, where X can e.g. stand for “set”, “poset”, or “category”. Yet more generally, X can be an
            %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (n,r)-category
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                    %mi r
                    %mo &lt;
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} n,r \lt \infty
            = succeed "-zation" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "-structures)," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences#InfCatPres"} ∞-localization functor
          %p
            In order to make the above precise, one must work with sufficiently convenient stratifications. We describe two simple ways of constructing/presenting
            %strong
              fundamental
              = succeed "-posets" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            below.
          %h3#conical_strat For conical stratificiations
          %p
          #defn_strat_product.num_defn
            %h6 Definition
            %p
              Given stratifications
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,f)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,g)
              their
              %strong product
              is the stratification of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              with characteristic map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ×
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \times g
          %p
          .num_defn
            %h6 Definition
            %p
              Given a stratification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,f)
              %strong stratified (open) cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} cone
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathrm{cone}(X), \mathrm{cone}(f))
              stratifies the topological open cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathrm{cone}(X) = X \times [0,1) / X \times \{0\}
              by the product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,f) \times (0,1)
              away from the cone point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0\}
              (here, the open interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,1)
              is trivially stratified), and by setting the cone point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0\}
              to be its own stratum.
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong conical
              stratification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,f)
              is a stratification in which each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              has a neighborhood (i.e. an open substratification) that is a stratified product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} cone
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} cone
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \times (\mathrm{cone}(Z),\mathrm{cone}(l))
              for some “link” stratification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Z
                    %mo ,
                    %mi l
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Z,l)
              and such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} x \in U \times \{0\}
          %p Every conical stratification is frontier-constructible.
          %p
          #defn_exit_path_cat.num_defn
            %h6 Definition
            %p
              Given a conical stratification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,f)
              %a{:href => "#LurieHA"} Lurie
              constructs
              %strong
                exit path
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mi{:mathvariant => "normal"} xit
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}\mathrm{xit}(f)
              as a quasicategory: the
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mi{:mathvariant => "normal"} xit
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}\mathrm{xit}(f)
              are precisely stratified maps
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∥
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ∥
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \parallel [k]\parallel \to (X,f)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo →
                      %mo .
                      %mo .
                      %mo .
                      %mo →
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [k] = (0 \to 1 \to ... \to k)
          %p
          .num_remark
            %h6 Remark
            %p
              One dually defines the
              %strong
                entrance path
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mi{:mathvariant => "normal"} ntr
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}\mathrm{ntr}(f)
              with
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∥
                      %mo{:stretchy => "false"} [
                      %mi k
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi{:mathvariant => "normal"} op
                      %mo ∥
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \parallel [k]^{\mathrm{op}} \parallel \to (X,f)
          %p#exit_entrance_conv
          .num_defn
            %h6 Terminology
            %p
              An
              %strong exit path
              in a stratified space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,f)
              is a stratified map
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo ∥
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ∥
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f : \parallel [1] \parallel \to (X,f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              %em starts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(0)
              and
              %em ends
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(1)
              (dually, we say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              %strong entrance path
              which starts at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(1)
              and ends at
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0)
          %p
            The construction translates from “stratified spaces” to “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-posets” in the above table: the conservative functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mi{:mathvariant => "normal"} xit
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Exit
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{E}\mathrm{xit}(f) \to \mathsf{Exit}(f)
            takes objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∥
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo ∥
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \parallel [0]\parallel \to X
            to the stratum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Exit
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s \in \mathsf{Exit}(f)
            that their image lies in.
          %h3#regular_strat For regular stratifications
          %p
          .num_defn
            %h6 Definition
            %p
              A stratification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,f)
              is
              %strong regular
              if it admits a refinement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∥
                    %mi P
                    %mo ∥
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \parallel P \parallel \to (X,f)
              by the stratified realization of some poset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
          %p
          .num_defn
            %h6 Definition
            %p
              Given a regular stratification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,f)
              and a refinement
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mo ∥
                      %mi P
                      %mo ∥
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F : \parallel P\parallel \to (X,f)
              %strong
                presented exit path
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫ℰ
                    %mi{:mathvariant => "normal"} xit
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{PE}\mathrm{xit}(f)
              as a poset with weak equivalences with underlying poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and weak equivalences
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Exit
                      %mo{:stretchy => "false"} (
                      %mi F
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} id
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathsf{Exit}(F)^{-1}(\mathrm{id})
          %p
            (Showing that this construction is, in an appropriate sense, independent of the choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            requires a bit more work…)
          %p
          #rmk_cellulable.num_remark
            %h6 Remark
            %p
              A special case of the definition asks for refinements by regular cell complexes (or simplicial complexes) in place of classifying stratifications of posets, in which case one speaks of
              %strong cellulable
              (resp.
              = succeed ")" do
                %strong triangulable
          %p The construction translates between “stratified spaces” and “posets with weak equivalences” in the above table. Since spaces are trivially stratified spaces, this specializes to a translation between “spaces” and “sets with weak equivalences”.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/stratification"} stratification
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/piecewise+flat+spacetime"} piecewise flat spacetime
          %h2#references References
          %p A notion of purely topologically stratified sets was introduced in
          %ul#Quinn
            %li
              %a.existingWikiWord{:href => "/nlab/show/Frank+Quinn"}> Frank Quinn
              ,
              = succeed "," do
                %em Homotopically stratified sets
          %p Notions of smoothly stratified spaces were considered by
          %ul
            %li
              %p
                H. Whitney,
                = succeed "," do
                  %em Local properties of analytic varieties
            %li
              %p
                R. Thom,
                = succeed "," do
                  %em Ensembles et morphismes stratifiés
            %li
              %p
                J. Mather,
                = succeed "," do
                  %em Notes on topological stability
          %p Locally conelike stratified spaces have been considered in
          %ul
            %li
              L. Siebenmann,
              = succeed "," do
                %em Deformations of homeomorphisms on stratified sets
          %p
            These are all special cases of (
            %a{:href => "#Quinn"}> Quinn’s definition
            ).
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/differential+operators"} differential operators
            on stratified spaces is in
          %ul
            %li
              %p
                R. B. Melrose,
                = succeed "," do
                  %em Pseudodifferential operators, corners and singular limits
            %li
              %p
                Pierre Albin, Eric Leichtnam, Rafe Mazzeo, Paolo Piazza,
                %em The signature package on Witt spaces, I. Index classes
                (
                %a{:href => "http://uk.arxiv.org/abs/0906.1568v2"}> arXiv:0906.1568v2
                )
          %p See also
          %ul
            %li
              Bruce Hughes,
              %em Geometric topology of stratified spaces
              (
              %a{:href => "http://aimsciences.org/journals/pdfsnews.jsp?paperID=2468&mode=full"}> pdf
              )
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+category"} fundamental category
            of a (Whitney‑)stratified space is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Woolf"}> Jonathan Woolf
                ,
                %em Transversal homotopy theory
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0910.3322"}> arXiv:0910.3322
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Markus+Banagl"}> Markus Banagl
                ,
                = succeed "," do
                  %em Topological invariants of stratified spaces
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/3-540-38587-8"} doi:10.1007/3-540-38587-8
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            for stratified spaces is discussed in
          %ul
            %li#AyalaFrancisRozenblyum15
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Ayala"}> David Ayala
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nick+Rozenblyum"} Nick Rozenblyum
                = succeed "," do
                  %em A stratified homotopy hypothesis
                %a{:href => "http://arxiv.org/abs/1502.01713"} arXiv
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+J.+Haine"}> Peter J. Haine
                ,
                %em On the homotopy theory of stratified spaces
                (
                %a{:href => "https://arxiv.org/abs/1811.01119"}> arXiv:1811.01119
                )
          %p The former is based on the notion of stratifications developed in
          %ul
            %li#AFT
              David Ayala, John Francis, and Hiro Lee Tanaka.
              = succeed "." do
                %em Local structures on stratified spaces
          %p An earlier paper on exit paths is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Treumann"}> David Treumann
              ,
              = succeed "," do
                %em
                  %a{:href => "https://www2.bc.edu/david-treumann/epacs.pdf"} Exit paths and constructible stacks
          %p
            Poset-stratified spaces and the conicality condition, as well as the construction of the fundamental
            = succeed "-poset" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li#LurieHA
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
              = succeed ")" do
                %a{:href => "https://www.math.ias.edu/~lurie/papers/HA.pdf"} pdf
          %p Stratified spaces are used to develop a graphical calculus for Gray categories in:
          %ul
            %li
              Benjamin Taylor Hummon,
              = succeed "," do
                %em
                  %a{:href => "https://escholarship.org/uc/item/5b24s9cc"} Surface Diagrams for Gray-Categories
          %p
            The homotopy theory of stratified spaces is explored in the thesis of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Sylvain+Douteau"} Sylvain Douteau
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Sylvain+Douteau"}> Sylvain Douteau
              ,
              = succeed "," do
                %em Étude homotopique des espaces stratifiés
              = succeed "." do
                %a{:href => "https://arxiv.org/pdf/1908.01366.pdf"} Arxiv version
