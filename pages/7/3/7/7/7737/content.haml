                    %annotation{:encoding => "application/x-tex"} s \subset \overline r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is frontier-constructible iff the characteristic map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Exit
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon X \to \mathsf{Exit}(f)
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CharacteristicMap"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
          %p It is generally very reasonable to assume stratifications to be locally finite and frontier-constructible.
          %h3#the_category_of_stratifications The category of stratifications
          %p
          #StratifiedMap.num_defn
            %h6 Definition
            %p
              A
              %strong stratified map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \colon (X,f) \to (Y,g)
              of stratified spaces (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Stratification"}
              %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} F \colon X \to Y
              which factors through the characteristic maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CharacteristicMap"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Exit
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Exit
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Exit
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathsf{Exit}(F) \colon \mathsf{Exit}(f) \to \mathsf{Exit}(g)
          %p
            Stratified spaces and their maps (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#StratifiedMap"}
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
