                  %use{:x => "107.764302", "xlink:href" => "#Rjl2dQPUs2q-TCjbozK8N5fB9xM=-glyph5-5", :y => "213.204131"}
                  %use{:x => "110.69991", "xlink:href" => "#Rjl2dQPUs2q-TCjbozK8N5fB9xM=-glyph5-8", :y => "213.204131"}
                  %use{:x => "115.985198", "xlink:href" => "#Rjl2dQPUs2q-TCjbozK8N5fB9xM=-glyph5-9", :y => "213.204131"}
            %p Here:
            %ul
              %li
                %p
                  all
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"}> Kan complexes
                  ), since
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+spaces"} simplicial classifying spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi W
                          %mo ¯
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} \overline{W}\mathcal{G}
                  are Kan complexes, by
                  = succeed "," do
                    %a{:href => "simplicial+classifying+space#SimplicialClassifyingSpaces"} this Prop.
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+groups"} simplicial groups
                      have underlying
                      %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
                      (
                      %a{:href => "simplicial+group#MooreTheorem"}> this Thm.
                      , which we use below to know that
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi 𝒢
                              %mi ad
                            %mo →
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \mathcal{G}_{ad} \to \ast
                      is a
                      = succeed ")," do
                        %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                      %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
                      in the
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+groups"} model structure on simplicial groups
                  %li
                    %p
                      the
                      = succeed "-functor" do
                        %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi W
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} W(-)/(-)
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
                      to the
                      %a.existingWikiWord{:href => "/nlab/show/model+structure+on+reduced+simplicial+sets"} model structure on reduced simplicial sets
                      (
                      %a{:href => "model+structure+on+reduced+simplicial+sets#QuillenAdjunctionWithSimplicialGroups"}> this Prop.
                      ), hence takes values in
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
                  %li
                    %p
                      fibrant reduced simplicial sets are Kan complexes (
                      %a{:href => "model+structure+on+reduced+simplicial+sets#FibrationsInTermsOfKanFibrations"}> this Prop.
                      );
              %li
                %p
                  the right vertical morphism is a
                  %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"}> Kan fibration
                  ), since it is the image of the Kan fibration
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒢
                          %mi ad
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \mathcal{G}_{ad} \to \ast
                  under the
                  %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi W
                        %mi 𝒢
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} (W \mathcal{G} \times (-)) /\mathcal{G}
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
                  (
                  %a{:href => "Borel+model+structure#QuillenAdjunctionWithSliceOverSimplicialClassifyingSpace"}> this Prop.
                  ), see
                  = succeed ";" do
                    %a{:href => "Borel+construction#ProjectionToSimplicialClassifyingSpaceIsKanFibration"} this Example
              %li
                %p
                  the top right morphism is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+weak+equivalence"} simplicial weak equivalence
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                  %a.existingWikiWord{:href => "/nlab/show/right+inverse"} right inverse
                  of the triangular morphisms, which are manifestly a simplicial weak eqivalence since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} W \mathcal{G}
                  is
                  %a.existingWikiWord{:href => "/nlab/show/contractible+homotopy+type"} contractible
                  (by
                  = succeed ")." do
                    %a{:href => "simplicial+classifying+space#UniversalPrincipalSimplicialComplexIsContractible"} this Prop.
            %p
              One verifies by inspection that the
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              shown is an ordinary
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
            %p
              Finally notice that the
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo ¯
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Groupoids
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{W}\mathcal{G}
                    \\;\;
                    \\simeq
                    \\;\;
                    \\mathbf{B}\mathcal{G}
                    \\;\;\;
                    \\in
                    \\;
                    Ho(\infty Groupoids)
            %p
              (essentially by its
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              to the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+loop+space"} simplicial loop space
              = succeed ")" do
                %a{:href => "model+structure+on+reduced+simplicial+sets#RelationToSimplicialGroups"} here
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/May+recognition+theorem"} May recognition theorem
              = succeed ")." do
                %a{:href => "free+loop+space+of+classifying+space#NSS12b"} NSS 12a, Cor. 3.33
            %p
              In summary this means (by
              = succeed ")" do
                %a{:href => "homotopy+pullback#HomotopyPullbackByOrdinaryPullback"} this Prop.
              = succeed "-square" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              %a.maruku-eqref{:href => "#eq:HomotopyPullbaclDefiningFreeLoopSpaceObject"} (1)
              that defines the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
            %p
          %h3#ForTopologicalSpaces For topological spaces
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set argument
            for
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
            is spelled out in
            = succeed "." do
              %a{:href => "#Gruher07"} Gruher 2007, App. A
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presentation
            of the phenomenon in the
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            in the abstract style
            %a{:href => "#ForSimplicialSets"} above
            is indicated in
            = succeed "." do
              %a{:href => "#KleinSchochetSmith09"} Klein, Schochet &amp; Smith 2009
          %h3#InHomotopyTypeTheory In homotopy type theory
          %p
            Recall that in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is represented by its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            type, a pointed connected type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G
          %p
            (The
            %a{:href => "relation+between+type+theory+and+category+theory#HomotopyWithUnivalence"} categorical semantics
            of this is a groupal
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/inertia+%E2%88%9E-stacks"} inertia ∞-stacks
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/free+loop+%E2%88%9E-stacks"} free loop ∞-stacks
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on a
            %a.existingWikiWord{:href => "/nlab/show/term"} term
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            of
            %a.existingWikiWord{:href => "/nlab/show/type"} type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is given by a
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %msub
                      %mi Aut
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \to Aut_A(a)
            %a.existingWikiWord{:href => "/nlab/show/pointed+homotopy+types"} pointed homotopy types
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msub
                      %mo →
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G \to_* (A,a)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B} G
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connected+homotopy+type"} connected
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            to the
            %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            at
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %p
            We thus see that the type of all
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G \to A
            = succeed "-small" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "-types," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G \to U
          %p
            By
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjointness
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy orbit
            type of a
            = succeed "-type" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} X \colon \mathbf{B} G \to U
            is given by the
            = succeed "-type," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mspace{:width => "negativethinmathspace"}
                  %mo ⫽
                  %mspace{:width => "negativethinmathspace"}
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi t
                      %mo :
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X \!\sslash\! G
                  \\;\coloneqq\;
                  \\sum_{t : \mathbf{B} G} X(t)
          %p
            (The
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fixed+points"} homotopy fixed points
            are given by the
            = succeed "-type," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
          %p
            Now, the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on itself is given by the morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi G
                            %mi ad
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                        %mtd
                          %mo →
                        %mtd
                          %mi U
                      %mtr
                        %mtd
                        %mtd
                          %mi t
                        %mtd
                          %mo ↦
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi t
                          %msub
                            %mo =
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                          %mi t
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G^{ad} \colon &amp; \mathbf{B} G &amp;\to&amp; U
                  \\\
                  \&amp; t &amp;\mapsto&amp; (t =_{\mathbf{B} G} t)
                  \\,.
                  }
          %p
            Indeed, given any path
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi t
                  %msub
                    %mo =
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                  %mi u
                %annotation{:encoding => "application/x-tex"} p : t =_{\mathbf{B} G} u
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B} G
            and any element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %msup
                      %mi G
                      %mi ad
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q : G^{ad}(t)
            %a.existingWikiWord{:href => "/nlab/show/homotopy+lifting+property"} transport
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            in the family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mi ad
                %annotation{:encoding => "application/x-tex"} G^{ad}
            is equal to the conjugate
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ⋅
                    %mi q
                    %mo ⋅
                    %mi p
                    %mo :
                    %msup
                      %mi G
                      %mi ad
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p^{-1} \cdot q \cdot p : G^{ad}(u)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+type"} path induction
          %p
            Putting this together, we get that the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy orbits
            of the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
            are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi G
                            %mi ad
                          %mspace{:width => "negativethinmathspace"}
                          %mo ⫽
                          %mspace{:width => "negativethinmathspace"}
                          %mi G
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mrow
                              %mi t
                              %mo :
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                          %mo{:stretchy => "false"} (
                          %mi t
                          %msub
                            %mo =
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                          %mi t
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi ʃ
                          %msup
                            %mi S
                            %mn 1
                          %mo →
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  G^{ad} \!\sslash\! G
                  \&amp;
                  \\;=\;
                  \\sum_{t: \mathbf{B} G}
                  (t =_{\mathbf{B} G} t)
                  \\\
                  \&amp; \;\simeq\;
                  (&amp;#643;S^1 \to \mathbf{B} G),
                  \\end{aligned}
          %p
            where in the last step we used the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            (
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"}> shape
            ) of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ʃ
                    %msup
                      %mi S
                      %mn 1
                    %mo ≃
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} &amp;#643;S^1 \simeq \mathbf{B}\mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            (
            %a{:href => "higher+inductive+type#ExamplesTheCircle"}> here
            ) with a point
            %a.existingWikiWord{:href => "/nlab/show/term+introduction+rule"} constructor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi base
                  %mo :
                  %mi ʃ
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} base : &amp;#643;S^1
            and a path constructor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi loop
                    %mo :
                    %mi base
                    %msub
                      %mo =
                      %mrow
                        %mi ʃ
                        %msup
                          %mi S
                          %mn 1
                    %mi base
                  %annotation{:encoding => "application/x-tex"} loop : base =_{&amp;#643;S^1} base
          %p
            The function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ʃ
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} &amp;#643;S^1 \to B G
            is the representation of the free loop type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{L}(\mathbf{B} G)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} G
          %h2#examples Examples
          %h3#ExampleDiscreteGroups For discrete (finite) groups
          %p
          #FreeLoopSpaceOfDeloopingOfDiscreteGroup.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
                of classifying space of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
              %br/
            %p
              The archetypical example has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo =
                    %mi G
                    %mo ∈
                    %mi Groups
                    %mo{:stretchy => "false"} (
                    %mi Sets
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} = G \in Groups(Sets)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi 𝒢
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B \mathcal{G} \simeq K(G,1)
              is an
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              whose
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              is represented in the
              %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
              simply by the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⇉
                    %mo *
                  %annotation{:encoding => "application/x-tex"} G \rightrightarrows \ast
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
              follows from elementary inspection:
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ×
                    %mi G
                    %munderover
                      %mo ⇉
                      %mrow
                        %msub
                          %mi pr
                          %mn 2
                      %mi Ad
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    \\mathbf{B}\mathbb{Z}
                    ,\,
                    \\mathbf{B}G
                    \\big]
                    \\;\simeq\;
                    \\big(
                    G \times G
                    \\underoverset
                    {pr_2}
                    { Ad }
                    {\rightrightarrows}
                    G
                    \\big)
            %p has
            %ul
              %li
                %p
                  as
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  the
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi ℤ
                          %mo ⟶
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                        %annotation{:encoding => "application/x-tex"} \mathbf{B}\mathbb{Z} \longrightarrow \mathbf{B}G
                  %a.existingWikiWord{:href => "/nlab/show/group+homomorphisms"} group homomorphisms
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo →
                          %mi G
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z} \to G
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi g
                          %mo ∈
                          %mi G
                        %annotation{:encoding => "application/x-tex"} g \in G
              %li
                %p
                  as
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  the
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                  between these, whose single component
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} h \in G
                  must make the naturality
                  %a.existingWikiWord{:href => "/nlab/show/commuting+square"} square commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi ℤ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                          %mtd
                            %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi h
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo •
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mn 1
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi g
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi g
                                  %mo ′
                        %mtr
                          %mtd
                            %mo •
                          %mtd
                          %mtd
                            %mo •
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi h
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}\mathbb{Z}
                    \&amp;\xrightarrow{\;\;\;}&amp;
                    \\mathbf{B}G
                    \\\
                    \\\
                    \\bullet
                    \&amp;&amp;
                    \\bullet
                    \&amp;\xrightarrow{\;\;\;h\;\;\;}&amp;
                    \\bullet
                    \\\
                    \\big\downarrow {}^{\mathrlap{1}}
                    \&amp;&amp;
                    \\big\downarrow {}^{\mathrlap{g}}
                    \&amp;&amp;
                    \\big\downarrow {}^{\mathrlap{g'}}
                    \\\
                    \\bullet
                    \&amp;&amp;
                    \\bullet
                    \&amp;\xrightarrow{\;\;\;h\;\;\;}&amp;
                    \\bullet
                    }
            %p
              The condition that this commutes means equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} g'
              is the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              under the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ⋅
                    %mi g
                    %mo ′
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ⋅
                    %mi h
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo ′
                    %mo =
                    %msup
                      %mi h
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ⋅
                    %mi g
                    %mo ⋅
                    %mi h
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ad
                      %mi h
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h \cdot g' \;=\; g \cdot h
                    \\;\;\;\;\;\;\;\;\;
                    \\Leftrightarrow
                    \\;\;\;\;\;\;\;\;\;
                    g' = h^{-1} \cdot g \cdot h \;=\; Ad_h(g)
                    \\,.
            %p
              This shows that the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              is the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              of the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %msub
                      %mo ⫽
                      %mi ad
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L} \mathbf{B}G
                    \\;\simeq\;
                    \\big[
                    \\mathbf{B}\mathbb{Z}
                    ,\,
                    \\mathbf{B}G
                    \\big]
                    \\;\simeq\;
                    G \sslash_{ad} G
                    \\,.
            %p
          %p
            This simple example essentially re-appears in the discussion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inertia+groupoids"} inertia groupoids
          %h3#ExampleForSimplicialAbelianGroups For simplicial abelian groups
          %p As a direct corollary of the general statement we have:
          %p
          #FreeLoopSpaceOfClassifyingSpaceOfSimplicialAbelianGroup.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                    %mo ∈
                    %mi AbGroup
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{A} \in AbGroup(sSet)
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
              of its
              %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+product"} homotopy product
              (
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"}> Cartesian product
              ) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              with its
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi ℤ
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒜
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒜
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi 𝒜
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big[
                    \\mathbf{B}\mathbb{Z},
                    \\,
                    \\mathbf{B}\mathcal{A}
                    \\big]
                    \\;\;
                    \\simeq
                    \\;\;
                    \\mathcal{A} \,\times\, \mathbf{B}\mathcal{A}
                    \\,.
            %p
          .proof
            %h6 Proof
            %p
              This is the composite of the following sequence of equivalences (
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              in the
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi ℤ
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi 𝒜
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %msub
                                  %mi 𝒜
                                  %mi{:mathvariant => "normal"} ad
                                %mo ×
                                %mi W
                                %mi 𝒜
                              %mi 𝒜
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %msub
                                  %mi 𝒜
                                  %mi{:mathvariant => "normal"} triv
                                %mo ×
                                %mi W
                                %mi 𝒜
                              %mi 𝒜
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒜
                            %mo ×
                            %mfrac
                              %mrow
                                %mi W
                                %mi 𝒜
                              %mi 𝒜
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒜
                            %mo ×
                            %mover
                              %mi W
                              %mo ¯
                            %mi 𝒜
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒜
                            %mo ×
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi 𝒜
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\big[
                    \\mathbf{B}\mathbb{Z},
                    \\,
                    \\mathbf{B}\mathcal{A}
                    \\big]
                    \&amp;
                    \\;\simeq\;
                    \\frac{
                    \\mathcal{A}_{\mathrm{ad}}
                    \\times
                    W\mathcal{A}
                    }{ \mathcal{A} }
                    \\\
                    \&amp; \;\simeq\;
                    \\frac{
                    \\mathcal{A}_{\mathrm{triv}}
                    \\times
                    W\mathcal{A}
                    }{ \mathcal{A} }
                    \\\
                    \&amp; \;\simeq\;
                    \\mathcal{A}
                    \\times
                    \\frac{
                    W\mathcal{A}
                    }{ \mathcal{A} }
                    \\\
                    \&amp; \;\simeq\;
                    \\mathcal{A}
                    \\times
                    \\overline{W}\mathcal{A}
                    \\\
                    \&amp; \;\simeq\;
                    \\mathcal{A} \times \mathbf{B}\mathcal{A}
                    \\end{aligned}
            %p Here:
            %ul
              %li
                %p
                  the first step is Prop.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#FreeLoopSpaceOfSimplicialClassifyingSpaceAsAdQuotient"}
              %li
                %p
                  the second step observes that for
                  %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                  the
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
                  %a.maruku-eqref{:href => "#eq:ConjugationAction"} (2)
                  is actually the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial action
              %li
                %p
                  the third step is the evident consequence for the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %li
                %p
                  the fourth step is the definition of the
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
              %li
                %p
                  the last step is the identification of the simplicial classifying space with the
                  %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                  as
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            %p
          %p
            As an immediate special cases of Prop.
            %a.maruku-ref{:href => "#FreeLoopSpaceOfClassifyingSpaceOfSimplicialAbelianGroup"}
            we have:
          %p
          #FreeLoopSpaceOfEilenbergMacLaneSpaces.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space"} free loop space
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
              %br/
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ʃ
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}^{n+1}
                    \\mathbb{Z}
                    \\;\simeq\;
                    \&amp;#643; \mathbf{B}^n S^1
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle (n+1)-group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L} \mathbf{B}^{n+1}\mathbb{Z}
                    \\;\simeq\;
                    \\mathbf{B}^n\mathbb{Z}
                    \\,\times\,
                    \\mathbf{B}^{n+1} \mathbb{Z}
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi AbGroups
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in AbGroups(Set)
              any
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L} \mathbf{B}^{n+1}A
                    \\;\simeq\;
                    \\mathbf{B}^n A
                    \\,\times\,
                    \\mathbf{B}^{n+1}A
                    \\,,
            %p
              where the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}^n A
                    \\;\simeq\;
                    K(n,A)
            %p
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (classifying
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %br/
          %p
          .num_remark
            %h6 Remark
            %p
              Example
              %a.maruku-ref{:href => "#FreeLoopSpaceOfEilenbergMacLaneSpaces"}
              pertains to the discussion of
              %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
              of brane charges in
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              by the discussion
              %a{:href => "geometry+of+physics+--+fundamental+super+p-branes#DoubleDimensionalReductionViaCyclification"} here
              at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+fundamental+super+p-branes"} geometry of physics – fundamental super p-branes
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space"}> free loop space
                ,
                %a.existingWikiWord{:href => "/nlab/show/free+loop+stack"} free loop stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/transchromatic+character"} transchromatic character
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"}> classifying space
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+classifying+space"} simplicial classifying space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+classifying+space"} Sullivan model of classifying space
          %h2#references References
          %p
            A point-set proof in
            %a.existingWikiWord{:href => "/nlab/show/TopologicalSpaces"} TopologicalSpaces
            is given in
          %ul
            %li#Gruher07
              %a.existingWikiWord{:href => "/nlab/show/Kate+Gruher"}> Kate Gruher
              ,
              = succeed "," do
                %em
                  A proof of
