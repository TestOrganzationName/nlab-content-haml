                    %a.existingWikiWord{:href => "/nlab/show/coboundary"} coboundary
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/minimal+coupling"} minimal coupling
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                    of
                    %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
                    of
                    %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/extended+Lagrangian"} extended Lagrangian
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/universal+Chern-Simons+n-bundle"} universal Chern-Simons n-bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+map"} universal characteristic map
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higher+U%281%29-gauge+theory"} higher U(1)-gauge theory
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/higher+electric+background+charge+coupling"} higher electric background charge coupling
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higher+spin+gauge+theory"} higher spin gauge theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quantum+anomaly"} quantum anomaly
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+mechanism"} Green-Schwarz mechanism
            %li
              %p
                %a.existingWikiWord{:href => "/schreiber/show/infinity-Chern-Simons+theory"} infinity-Chern-Simons theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
          %h2#references References
          %blockquote
            %p
              See also references at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
          %h3#general General
          %p On the historical origins:
          %ul
            %li
              %p
                A. C. T. Wu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"} Chen Ning Yang
                = succeed "," do
                  %em Evolution of the concept of vector potential in the description of the fundamental interactions
                %strong 21
                16 (2006) 3235-3277 &amp;lbrack;
                %a{:href => "https://doi.org/10.1142/S0217751X06033143"}> doi:10.1142/S0217751X06033143
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chen+Ning+Yang"}> Chen Ning Yang
                ,
                = succeed "," do
                  %em The conceptual origins of Maxwell’s equations and gauge theory
                %strong 67
                11 (2014) &amp;lbrack;
                %a{:href => "https://doi.org/10.1063/PT.3.2585"}> doi:10.1063/PT.3.2585
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://home.ustc.edu.cn/~lxsphys/2021-3-18/The%20conceptual%20origins%20of%20Maxwell%27s%20equations%20and%20gauge%20theory.pdf"} pdf
          %p Early lecture notes:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Iliopoulos"}> John Iliopoulos
              \:
              = succeed "," do
                %em An introduction to gauge theories
              = succeed "," do
                %a{:href => "https://cds.cern.ch/record/185945?ln=en"} cds:185945
              = succeed "&rbrack;" do
                %a{:href => "https://cds.cern.ch/record/185945/files/CERN-76-11.pdf"} pdf
              %blockquote
                %p
                  (in view of the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
          %p Monographs
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Makeenko"}> Yuri Makeenko
                ,
                = succeed "," do
                  %em Methods of contemporary gauge theory
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/CBO9780511535147"} doi:10.1017/CBO9780511535147
                = succeed "&rbrack;" do
                  %a{:href => "http://books.google.com/books?id=9W-W2w75ulAC"} gBooks
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikio+Nakahara"}> Mikio Nakahara
                , Section 10.5 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Geometry%2C+Topology+and+Physics"} Geometry, Topology and Physics
                = succeed "," do
                  %a{:href => "https://doi.org/10.1201/9781315275826"} doi:10.1201/9781315275826
                = succeed ")" do
                  %a{:href => "http://alpha.sinp.msu.ru/~panov/LibBooks/GRAV/(Graduate_Student_Series_in_Physics)Mikio_Nakahara-Geometry,_Topology_and_Physics,_Second_Edition_(Graduate_Student_Series_in_Physics)-Institute_of_Physics_Publishing(2003).pdf"} pdf
            %li
              %p
                Mike Guidry,
                = succeed "," do
                  %em Gauge Field Theories: An Introduction with Applications
                = succeed ")" do
                  %a{:href => "https://www.wiley.com/en-us/Gauge+Field+Theories%3A+An+Introduction+with+Applications-p-9783527617364"} ISBN:978-3-527-61736-4
          %p
            Basics on
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundles+in+physics"} fiber bundles in physics
            are recalled in
          %ul
            %li
              Adam Marsh,
              %em Gauge Theories and Fiber Bundles: Definitions, Pictures, and Results
              (
              %a{:href => "https://arxiv.org/abs/1607.03089"}> arXiv:1607.03089
              )
          %p
            An introduction to concepts in the
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of gauge theories is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nicolai+Reshitikhin"}> Nicolai Reshitikhin
              ,
              %em Lectures on quantization of gauge systems
              (
              %a{:href => "http://staff.science.uva.nl/~nresheti/Holb-Quant-Gauge.pdf"}> pdf
              )
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Garth+Warner"}> Garth Warner
                \:
                = succeed "," do
                  %em Quantum Gauge Theory
                = succeed "," do
                  %a{:href => "https://sites.math.washington.edu//~warner/QGTSeminar_Warner.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Warner-QuantumGaugeTheory.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Tong"}> David Tong
                \:
                %em Lectures on Gauge Theory
                \&amp;lbrack;
                %a{:href => "https://www.damtp.cam.ac.uk/user/tong/gaugetheory.html"}> webpage
                \&amp;rbrack;
          %p
            A standard textbook on the
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
            for the quantization of gauge systems is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"}> Marc Henneaux
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Claudio+Teitelboim"} Claudio Teitelboim
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quantization+of+Gauge+Systems"} Quantization of Gauge Systems
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.2307/j.ctv10crg0r"} doi:10.2307/j.ctv10crg0r
          %p Lecture notes on this:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              \:
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+perturbative+quantum+field+theory"} geometry of physics – perturbative quantum field theory
              (2017)
          %p
            Discussion of abelian higher gauge theory in terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"}> Dan Freed
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization+and+generalized+differential+cohomology"} Dirac charge quantization and generalized differential cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alessandro+Valentino"}> Alessandro Valentino
                ,
                %em Differential cohomology and quantum gauge fields
                (
                %a{:href => "http://www.uni-math.gwdg.de/sandro/seminarGoett.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"}> José Figueroa-O'Farrill
                ,
                %em Gauge theory
                (
                %a{:href => "http://empg.maths.ed.ac.uk/Activities/GT/index.html"}> web page
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tohru+Eguchi"}> Tohru Eguchi
                , Peter Gilkey, Andrew Hanson,
                = succeed "," do
                  %em Gravitation, gauge theories and differential geometry
                = succeed ":6" do
                  %strong 66
                = succeed ")" do
                  %a{:href => "http://empg.maths.ed.ac.uk/Activities/GT/EGH.pdf"} pdf
          %p
            For discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            see also
          %ul
            %li#Witten17
              %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"}> Edward Witten
              ,
              %em Symmetry and Emergence
              (
              %a{:href => "https://arxiv.org/abs/1710.01791"}> arXiv:1710.01791
              )
          %h3#ReferencesInAQFT In AQFT
          %p
            Standard discussion of gauge theory in the context of
            %a.existingWikiWord{:href => "/nlab/show/algebraic+quantum+field+theory"} algebraic quantum field theory
            (
            %a.existingWikiWord{:href => "/nlab/show/AQFT"}> AQFT
            ) includes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Franco+Strocchi"}> Franco Strocchi
              , section 4 of
              = succeed "," do
                %em Relativistic Quantum Mechanics and Field Theory
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/0401143"} arXiv:hep-th/0401143
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/AQFT+on+curved+spacetimes"} AQFT on curved spacetimes
            the axioms of AQFT need to be promoted to a context of
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            unless
            %a{:href => "field+%28physics%29#IdeaLocality"} locality
            is broken, see the expositions at
          %ul
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Higher+field+bundles+for+gauge+fields"} Higher field bundles for gauge fields
            %li#Schenkel14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"}> Alexander Schenkel
                ,
                %em On the problem of gauge theories
              %p
                in locally covariant QFT_, talk at
                %em
                  %a{:href => "http://www.science.unitn.it/~moretti/convegno/convegno.html"} Operator and Geometric Analysis on Quantum Theory
                Trento, 2014 (
                %a{:href => "field+bundle#Schenkel14"}> web
                )
          %p This was established in
          %ul
            %li#BDS
              Marco Benini,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Claudio+Dappiaggi"} Claudio Dappiaggi
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
              = succeed "," do
                %em Quantized Abelian principal connections on Lorentzian manifolds
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1303.2515"} arXiv:1303.2515
          %p
            and the program of improving the axioms of
            %a.existingWikiWord{:href => "/nlab/show/AQFT+on+curved+spacetimes"} AQFT on curved spacetimes
            to the
            %a.existingWikiWord{:href => "/nlab/show/stack"} stacky
            context in order to accomodate gauge theory includes the following articles:
          %ul
            %li#BeniniSchenkelSzabo15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Benini"}> Marco Benini
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
                %em Homotopy colimits and global observables in Abelian gauge theory
                (
                %a{:href => "http://arxiv.org/abs/1503.08839"}> arXiv:1503.08839
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Benini"}> Marco Benini
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
                %em Quantum field theories on categories fibered in groupoids
                (
                %a{:href => "https://arxiv.org/abs/1610.06071"}> arXiv:1610.06071
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marco+Benini"}> Marco Benini
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Schenkel"} Alexander Schenkel
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                %em The stack of Yang-Mills fields on Lorentzian manifolds
                (
                %a{:href => "https://arxiv.org/abs/1704.01378"}> arXiv:1704.01378
                )
          %h3#dualities Dualities
          %p
            An exposition of the relation to
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+duality"} geometric Langlands duality
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Edward+Frenkel"}> Edward Frenkel
              ,
              %em Gauge theory and Langlands duality
              (
              %a{:href => "http://math.berkeley.edu/~frenkel/bourbaki-gauge.pdf"}> pdf
              )
          %h3#History History
          %p
            A discussion of “
            %a.existingWikiWord{:href => "/nlab/show/gauge"}> gauge
            ” and
            %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            in
            %a.existingWikiWord{:href => "/nlab/show/metaphysics"} metaphysics
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Georg+Hegel"}> Georg Hegel
              ,
              %a{:href => "Science+of+Logic#714"} §714
              of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Science+of+Logic"} Science of Logic
          %p
            %a.existingWikiWord{:href => "/nlab/show/Hermann+Weyl"}> Hermann Weyl
            ‘s historical argument motivating gauge theory in
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            from rescaling of units of length was given in 1918 in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hermann+Weyl"}> Hermann Weyl
                ,
                = succeed "," do
                  %em Raum, Zeit, Materie: Vorlesungen über die Allgemeine Relativitätstheorie
              %blockquote
                %p
                  The manuscript of Weyl’s first book on mathematical physics, Space – Time – Matter (STM) (Raum – Zeit – Materie), delivered to the publishing house (Springer) Easter 1918, did not contain Weyl’s new geometry and proposal for a UFT. It was prepared from the lecture notes of a course given in the Summer semester of 1917 at the Polytechnical Institute (ETH) Zürich. Weyl included his recent findings only in the 3rd edition (1919) of the book. The English and French versions (Weyl 1922b, Weyl 1922a), translated from the fourth revised edition (1921), contained a short exposition of Weyl’s generalized metric and the idea for a scale gauge theory of electromagnetism. (
                  %a{:href => "#Scholz"}> Scholz
                  )
          %p See
          %ul
            %li#Scholz
              Erhard Scholz,
              %em H. Weyl’s and E. Cartan’s proposals for infinitesimal geometry in the early 1920s
              (
              %a{:href => "http://www2.math.uni-wuppertal.de/~scholz/preprints/weyl_cartan.pdf"}> pdf
              )
          %p Early surveys include
          %ul
            %li#Iliopoulos75
              %a.existingWikiWord{:href => "/nlab/show/John+Iliopoulos"}> John Iliopoulos
              ,
              = succeed "," do
                %em Progress in Gauge Theories
              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/3000"} spire:3000
          %p Quick reviews include
          %ul
            %li
              %p
                Quigley,
                %em On the origins of gauge theory
                (
                %a{:href => "http://www.math.toronto.edu/~colliand/426_03/Papers03/C_Quigley.pdf"}> pdf
                )
            %li
              %p
                Afriat,
                %em Weyl’s gauge argument
                (
                %a{:href => "http://hal.inria.fr/docs/00/76/96/90/PDF/WGA.pdf"}> pdf
                )
          %p More comprehensive historical accounts include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lochlainn+O%27Raifeartaigh"}> Lochlainn O'Raifeartaigh
                ,
                = succeed "," do
                  %em The Dawning of Gauge Theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lochlainn+O%27Raifeartaigh"}> Lochlainn O'Raifeartaigh
                , Norbert Straumann,
                %em Gauge Theory: Historical Origins and Some Modern Developments
                Rev. Mod. Phys. 72, 1-23 (2000).
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Norbert+Straumann"}> Norbert Straumann
                ,
                %em Early History of Gauge Theories and Weak Interactions
                (
                %a{:href => "http://arxiv.org/abs/hep-ph/9609230"}> arXiv:hep-ph/9609230
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Norbert+Straumann"}> Norbert Straumann
                ,
                = succeed "," do
                  %em Gauge principle and QED
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-ph/0509116"} arXiv:hep-ph/0509116
        .revisedby
