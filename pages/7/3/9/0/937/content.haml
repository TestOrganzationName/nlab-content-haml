                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka duality
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Gabriel-Ulmer+duality"} Gabriel-Ulmer duality
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Freyd-Mitchell+embedding+theorem"} Freyd-Mitchell embedding theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/relation+between+type+theory+and+category+theory"} relation between type theory and category theory
                  %h2#extensions Extensions
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/sheaf+and+topos+theory"} sheaf and topos theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
                  %h2#applications Applications
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/applications+of+%28higher%29+category+theory"} applications of (higher) category theory
                  %div
                    %p
                      %a{:href => "/nlab/edit/category+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#overview"} Overview
              %li
                %a{:href => "#literature_and_discussions"} Literature and discussions
          %h2#idea Idea
          %p
            The LP category is a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+objects"} Lie algebra objects
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Leibniz+algebras"} Leibniz algebras
          %h2#overview Overview
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Arr
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Arr(C)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and whose morphisms are commutative squares. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            with
            = succeed "s)" do
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            %em infinitesimal
            or
            %em Loday–Pirashvili
            (LP) tensor product on the category of arrows, as well as an inner hom, equipping the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Arr
                  %mi C
                %annotation{:encoding => "application/x-tex"} \mathrm{Arr} C
            with a structure of a
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p The LP-tensor product is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo :
                  %msub
                    %mi V
                    %mn 1
                  %mo →
                  %msub
                    %mi V
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo :
                  %msub
                    %mi W
                    %mn 1
                  %mo →
                  %msub
                    %mi W
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 0
                  %mo ⊗
                  %mi g
                  %mo +
                  %mi f
                  %mo ⊗
                  %msub
                    %mi W
                    %mn 0
                  %mo :
                  %msub
                    %mi V
                    %mn 0
                  %mo ⊗
                  %msub
                    %mi W
                    %mn 1
                  %mo ⊕
                  %msub
                    %mi V
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi W
                    %mn 0
                  %mo →
                  %msub
                    %mi V
                    %mn 0
                  %mo ⊗
                  %msub
                    %mi W
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} (f:V_1\to V_0)\otimes (g:W_1\to W_0):= (V_0\otimes g + f\otimes W_0: V_0\otimes W_1 \oplus V_1\otimes W_0\to V_0\otimes W_0).
          %p
            This is a truncation of the tensor product of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi W
                    %mn 1
                %annotation{:encoding => "application/x-tex"} V_1\otimes W_1
            is dropped.
          %p
            The inner hom is rather interesting:
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} Hom
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi{:mathvariant => "normal"} Hom
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Hom}(f,g) = (p:\mathrm{Hom}_1(f,g)\to\mathrm{Hom}_0(f,g))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_0(f,g)
            is the equalizer of two morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 0
                  %mo ,
                  %msub
                    %mi W
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %mi{:mathvariant => "normal"} hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 1
                  %mo ,
                  %msub
                    %mi W
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi{:mathvariant => "normal"} hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 1
                  %mo ,
                  %msub
                    %mi W
                    %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{hom}(V_0,W_0)\oplus\mathrm{hom}(V_1,W_1)\to\mathrm{hom}(V_1,W_0),
          %p
            namely precomposing the first summand with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and postcomposing the second summand with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} hom
                %annotation{:encoding => "application/x-tex"} \mathrm{hom}
            is the ordinary
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} inner hom
            in
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_1(f,g)
            is the equalizer of two morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ⊕
                  %mi{:mathvariant => "normal"} hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 0
                  %mo ,
                  %msub
                    %mi W
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_0(f,g)\oplus\mathrm{hom}(V_0,W_1)\to \mathrm{Hom}_0(f,g),
          %p
            namely the identity and the map which replaces the lower component with the postcomposition by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            applied on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} hom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi V
                    %mn 0
                  %mo ,
                  %msub
                    %mi W
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{hom}(V_0,W_1)
            and keeps the upper component. Finally,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is the natural projection.
          %p
            In the case of vector spaces this means that we have diagonal lifts in squares such that the lower square commutes but not necessarily the upper, i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom}(f,g)
            is the space consisting of all triples
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi u
                    %mn 1
                  %mo ,
                  %msub
                    %mi u
                    %mn 0
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (u_1,u_0,\phi)
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mn 1
                    %mo :
                    %msub
                      %mi V
                      %mn 1
                    %mo →
                    %msub
                      %mi W
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} u_1:V_1\to W_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mn 0
                  %mo :
                  %msub
                    %mi V
                    %mn 0
                  %mo →
                  %msub
                    %mi W
                    %mn 0
                %annotation{:encoding => "application/x-tex"} u_0:V_0\to W_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msub
                    %mi V
                    %mn 0
                  %mo →
                  %msub
                    %mi W
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \phi:V_0\to W_1
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %msub
                    %mi u
                    %mn 1
                  %mo =
                  %msub
                    %mi u
                    %mn 0
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} g\circ u_1= u_0\circ f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mn 0
                  %mo =
                  %mi g
                  %mo ∘
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} u_0=g\circ\phi
            while one does
            %em not
            require
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi u
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \phi\circ f=u_1
          %p
            There are a number of remarkable functors relating
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            algebras in LP,
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Leibniz+algebras"} Leibniz algebras
            and of right Leibniz algebras embed as full subcategories into the category of
            %a.existingWikiWord{:href => "/nlab/show/internal+Lie+algebras"} internal Lie algebras
            in LP. This embedding has an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %a.existingWikiWord{:href => "/nlab/show/n-Lie+algebra"} Lie algebra
            (a requirement in degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is dropped).
          %h2#literature_and_discussions Literature and discussions
          %ul
            %li#LodayPirashvili98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Loday"}> Jean-Louis Loday
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Teimuraz+Pirashvili"} Teimuraz Pirashvili
                = succeed "," do
                  %em The tensor category of linear maps and Leibniz algebras
                = succeed ")" do
                  %a{:href => "https://link.springer.com/article/10.1023/B:GEOR.0000008125.26487.f3"} doi:10.1023/B:GEOR.0000008125.26487.f3
            %li
              %p
                %a{:href => "http://golem.ph.utexas.edu/category/2007/10/loday_and_pirashvili_on_lie_2a.html"} nCafe
