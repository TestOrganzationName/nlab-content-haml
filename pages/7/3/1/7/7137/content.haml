              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mi N
                    %msub
                      %mi ρ
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mrow
                      %mo ‖
