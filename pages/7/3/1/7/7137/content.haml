                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\rho_{0},N)
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mn 0
                    %mo :
                    %msub
                      %mi W
                      %mi F
                    %mo →
                    %msub
                      %mi GL
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_{0}:W_{F}\to GL_{n}(\mathbb{C})
