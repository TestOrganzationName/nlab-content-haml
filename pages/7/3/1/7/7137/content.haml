            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \rho_{0}
            is the composition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi F
                    %mo →
                    %msubsup
                      %mi W
                      %mi F
                      %mi{:mathvariant => "normal"} ab
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi{:mathvariant => "normal"} rec
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %msup
                      %mi F
                      %mo ×
                    %mover
                      %mo →
                      %mi χ
                    %msup
                      %mi ℂ
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} W_{F}\to W_{F}^{\mathrm{ab}}\xrightarrow{\mathrm{rec}^{-1}}F^{\times}\xrightarrow{\chi}\mathbb{C}^{\times}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} rec
                  %mo :
                  %msup
                    %mi F
                    %mo ×
                  %mover
                    %mo →
                    %mo ∼
                  %msubsup
                    %mi W
                    %mi F
                    %mi{:mathvariant => "normal"} ab
                %annotation{:encoding => "application/x-tex"} \mathrm{rec}:F^{\times}\xrightarrow{\sim}W_{F}^{\mathrm{ab}}
            being the Artin reciprocity map of local
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/class+field+theory"} class field theory
          %h3#local_langlands_correspondence_for__2
            Local Langlands correspondence for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 2
                %annotation{:encoding => "application/x-tex"} GL_2
          %p
          .num_defn
            %h6 Definition
            %p
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be a
              = succeed "-adic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ≠
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} p\neq 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \chi_{1}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi χ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \chi_{2}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I(\chi_{1},\chi_{2})
              to be the vector space of function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %msub
                      %mi GL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \phi:GL_{2}(F)\to \mathbb{C}
              which are
              %a.existingWikiWord{:href => "/nlab/show/locally+constant+function"} locally constant
              with respect to the
              = succeed "-adic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_{2}(F)
              and satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mrow
                          %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mi d
                        %mo )
                      %mi g
                      %mo )
                    %mo =
                    %msub
                      %mi χ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ‖
                    %mi a
                    %mo{:stretchy => "false"} /
                    %mi d
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mn 2
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \phi\left(\begin{pmatrix}a &amp; b \\0 &amp; d\end{pmatrix}g\right)=\chi_{1}(a)\chi_{2}(d)\Vert a/d\Vert^{1/2}\phi(g).
            %p
              Letting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_2(F)
              act on this by translation gives us a representation of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_2(F)
              = succeed "." do
                %em principal series
            %p
          %p Whether a principal series is irreducible or not is governed by the following theorem:
          %p
          .num_theorem
            %h6 Theorem
            %p [Bernstein-Zelevinsky]
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi χ
                      %mn 2
                    %mo ≠
                    %mo{:stretchy => "false"} ‖
                    %mo ⋅
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mo ±
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \chi_{1}/\chi_{2}\neq\Vert\cdot\Vert^{\pm 1}
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I(\chi_{1},\chi_{2})
              is irreducible.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi χ
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} ‖
                    %mo ⋅
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \chi_{1}/\chi_{2}=\Vert\cdot\Vert^{1}
              then we have an exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ρ
                    %mo →
                    %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi S
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0\to\rho\to I(\chi_{1},\chi_{2})\to S(\chi_{1},\chi_{2})\to 0
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is the
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_2(F)
              given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi χ
                        %mn 1
                      %mo{:stretchy => "false"} ‖
                      %mo ⋅
                      %msup
                        %mo{:stretchy => "false"} ‖
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mi det
                    %annotation{:encoding => "application/x-tex"} \chi_{1}\Vert\cdot\Vert^{1/2}\det
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\chi_{1},\chi_{2})
              is an irreducible representation.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi χ
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} ‖
                    %mo ⋅
                    %msup
                      %mo{:stretchy => "false"} ‖
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \chi_{1}/\chi_{2}=\Vert\cdot\Vert^{-1}
              then we have an exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi S
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ρ
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0\to S(\chi_{1},\chi_{2})\to I(\chi_{1},\chi_{2})\to \rho\to 0
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mn 1
                    %mo ,
                    %msub
                      %mi χ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(\chi_{1},\chi_{2})
              as above.
            %p
          %p
            Therefore the irreducible admissible representations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_2(F)
            are the following:
          %ul
            %li
              %p
                Principal series representations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi χ
                        %mn 1
                      %mo ,
                      %msub
                        %mi χ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I(\chi_{1},\chi_{2})
                for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi χ
                          %mn 1
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi χ
                          %mn 2
                        %mo ≠
                        %mo{:stretchy => "false"} ‖
                        %mo ⋅
                        %msup
                          %mo{:stretchy => "false"} ‖
                          %mrow
                            %mo ±
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \chi_{1}/\chi_{2}\neq \Vert\cdot\Vert^{\pm 1}
            %li
              %p
                Special representations
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi χ
                          %mn 1
                        %mo ,
                        %msub
                          %mi χ
                          %mn 1
                        %mo ×
                        %mo{:stretchy => "false"} ‖
                        %mo ⋅
                        %mo{:stretchy => "false"} ‖
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S(\chi_{1},\chi_{1}\times\Vert\cdot\Vert)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                \-dimensional representations
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo ∘
                        %mi det
                      %annotation{:encoding => "application/x-tex"} \chi\circ\det
            %li
              %p
                “Base change” representations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi BC
                        %mi E
                        %mi F
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} BC_{E}^{F}(\psi)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                a quadratic extension of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                an admissible character
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo :
                        %mi E
                        %mo →
                        %msup
                          %mi ℂ
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} \psi:E\to\mathbb{C}^{\times}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mi i
                  %mo :
                  %msub
                    %mi W
                    %mi F
                  %mo →
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \rho_{i}:W_{F}\to \mathbb{C}^{\times}
            be the representation of the Weil group associated to the character
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi i
                  %mo :
                  %msup
                    %mi F
                    %mo ×
                  %mo →
                  %msup
                    %mi ℂ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \chi_{i}:F^{\times}\to \mathbb{C}^{\times}
            by the local Langlands correspondence for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} GL_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_2(F)
            a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %ul
            %li
              %p
                To the principal series representation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi χ
                        %mn 1
                      %mo ,
                      %msub
                        %mi χ
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I(\chi_{1},\chi_{2})
                we associate the Weil-Deligne representation
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mn 1
                        %mo ⊕
                        %msub
                          %mi ρ
                          %mn 2
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\rho_{1}\oplus\rho_{2},0)
            %li
              %p
                To the special representation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi χ
                          %mn 1
                        %mo ,
                        %msub
                          %mi χ
                          %mn 1
                        %mo ×
                        %mo{:stretchy => "false"} ‖
                        %mo ⋅
                        %mo{:stretchy => "false"} ‖
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S(\chi_{1},\chi_{1}\times\Vert\cdot\Vert)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mrow
                            %mo (
                            %mrow
                              %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                %mtr
                                  %mtd
                                    %mo{:stretchy => "false"} ‖
                                    %mo ⋅
                                    %mo{:stretchy => "false"} ‖
                                    %msub
                                      %mi ρ
                                      %mn 1
                                  %mtd
                                    %mn 0
                                %mtr
                                  %mtd
                                    %mn 0
                                  %mtd
                                    %msub
                                      %mi ρ
                                      %mn 1
                            %mo )
                          %mo ,
                          %mrow
                            %mo (
                            %mrow
                              %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                %mtr
                                  %mtd
                                    %mn 0
                                  %mtd
                                    %mn 1
                                %mtr
                                  %mtd
                                    %mn 0
                                  %mtd
                                    %mn 0
                            %mo )
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \left(\begin{pmatrix}\Vert\cdot\Vert\rho_{1} &amp; 0\\0 &amp; \rho_{1}\end{pmatrix},\begin{pmatrix} 0 &amp; 1\\0 &amp; 0\end{pmatrix}\right)
            %li
              %p
                To the
                = succeed "-dimensional" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi χ
                          %mn 1
                        %mo ∘
                        %mi det
                      %annotation{:encoding => "application/x-tex"} \chi_{1}\circ\det
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mrow
                            %mo (
                            %mrow
                              %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                                %mtr
                                  %mtd
                                    %msub
                                      %mi ρ
                                      %mn 1
                                    %mo ×
                                    %mo{:stretchy => "false"} ‖
                                    %mo ⋅
                                    %msup
                                      %mo{:stretchy => "false"} ‖
                                      %mrow
                                        %mn 1
                                        %mo{:stretchy => "false"} /
                                        %mn 2
                                  %mtd
                                    %mn 0
                                %mtr
                                  %mtd
                                    %mn 0
                                  %mtd
                                    %msub
                                      %mi ρ
                                      %mn 1
                                    %mo ×
                                    %mo{:stretchy => "false"} ‖
                                    %mo ⋅
                                    %msup
                                      %mo{:stretchy => "false"} ‖
                                      %mrow
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mn 1
                                        %mo{:stretchy => "false"} /
                                        %mn 2
                            %mo )
                          %mo ,
                          %mn 0
                          %mo )
                      %annotation{:encoding => "application/x-tex"} \left(\begin{pmatrix}\rho_{1}\times\Vert\cdot\Vert^{1/2} &amp; 0\\0 &amp; \rho_{1}\times\Vert\cdot\Vert^{-1/2}\end{pmatrix},0\right)
            %li
              %p
                To the “base change” representation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi BC
                        %mi E
                        %mi F
                      %mo{:stretchy => "false"} (
                      %mi ψ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} BC_{E}^{F}(\psi)
                we associate the Weil-Deligne representation (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ind
                        %mrow
                          %msub
                            %mi W
                            %mi E
                        %mrow
                          %msub
                            %mi W
                            %mi F
                      %mi σ
                      %mo ,
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Ind_{W_{E}}^{W_{F}}\sigma,0
                ), where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                is the unique nontrivial element of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} Gal
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} /
                        %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{Gal}(E/F)
          %h2#geometrization Geometrization
          %p
            %a.existingWikiWord{:href => "/nlab/show/Laurent+Fargues"} Laurent Fargues
            and
            %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"} Peter Scholze
            have developed a geometric approach to the local Langlands conjecture in
            = succeed "." do
              %a{:href => "#FarguesScholze21"} FarguesScholze21
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
            %span.newWikiWord
              solid abelian groups
              %a{:href => "/nlab/new/solid+abelian+groups"} ?
            from
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/condensed+mathematics"} condensed mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Bun
                    %mi G
                %annotation{:encoding => "application/x-tex"} \mathrm{Bun}_{G}
            of
            = succeed "-torsors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/Fargues-Fontaine+curve"} Fargues-Fontaine curve
            on one hand, and the derived category of certain coherent sheaves on the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+L-parameters"} moduli stack of L-parameters
            (denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Z
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mi F
                  %mo ,
                  %mover
                    %mi G
                    %mo ^
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi L
                  %mo{:stretchy => "false"} /
                  %mover
                    %mi G
                    %mo ^
                %annotation{:encoding => "application/x-tex"} Z^{1}(W_{F},\widehat{G})_{\mathcal{O}_{L}}/\widehat{G}
            in
            = succeed ")" do
              %a{:href => "#FarguesScholze21"} FarguesScholze21
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
          %p
          .num_prop
            %h6 Conjecture
            %p There is an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} Bun
                      %mi G
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi L
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ω
                    %mo ≅
                    %msubsup
                      %mi 𝒟
                      %mrow
                        %mi{:mathvariant => "normal"} coh
                        %mo ,
                        %mi{:mathvariant => "normal"} Nilp
                      %mrow
                        %mi b
                        %mo ,
                        %mi{:mathvariant => "normal"} qc
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Z
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mi F
                    %mo ,
                    %mover
                      %mi G
                      %mo ^
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi 𝒪
                          %mi L
                    %mo{:stretchy => "false"} /
                    %mover
                      %mi G
                      %mo ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}(\mathrm{Bun}_{G},\mathcal{O}_{L})^{\omega}\cong\mathcal{D}_{\mathrm{coh},\mathrm{Nilp}}^{b,\mathrm{qc}}(Z^{1}(W_{F},\widehat{G})_{\mathcal{O}_{L}}/\widehat{G})
            %p
              of stable
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Perf
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Z
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mi F
                      %mo ,
                      %mover
                        %mi G
                        %mo ^
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi 𝒪
                            %mi L
                      %mo{:stretchy => "false"} /
                      %mover
                        %mi G
                        %mo ^
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Perf(Z^{1}(W_{F},\widehat{G})_{\mathcal{O}_{L}}/\widehat{G})
          %p
            In their work Fargues and Scholze are able to associate an L-parameter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi φ
                    %mi A
                  %mo :
                  %msub
                    %mi W
                    %mi F
                  %mo →
                  %mover
                    %mi G
                    %mo ^
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℚ
                    %mi ℓ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varphi_{A}:W_{F}\to\widehat{G}(\mathbb{Q}_{\ell})
            to a Schur object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} Bun
                    %mi G
                  %mo ,
                  %msub
                    %mover
                      %mi ℚ
                      %mo ¯
                    %mi ℓ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(\mathrm{Bun}_{G},\overline{\mathbb{Q}}_{\ell})
            using the method of
            %a.existingWikiWord{:href => "/nlab/show/Vincent+Lafforgue"} Vincent Lafforgue
            (originally developed for the global Langlands correspondence for function fields over
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_{q}
          %p
            In the other direction (analogous to the “Galois to automorphic direction”) Fargues and Scholze approach this via the construction of the
            = succeed "," do
              %em spectral action
            %span.newWikiWord
              infinity groupoids
              %a{:href => "/nlab/new/infinity+groupoids"} ?
            (which they refer to as
            = succeed ")." do
              %em anima
            %a{:href => "#AnschutzLeBras21"} AnschutzLeBras21
            use this spectral action to show the existence of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hecke+eigensheaf"} Hecke eigensheaf
          %h2#adic_and_mod__local_langlands
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            \-adic and mod
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            local Langlands
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/p-adic+local+Langlands+correspondence"} p-adic local Langlands correspondence
            concerns
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %a.existingWikiWord{:href => "/nlab/show/absolute+Galois+group"} absolute Galois group
            of a
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+Hodge+theory"} p-adic Hodge theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mod+p+local+Langlands+correspondence"} mod p local Langlands correspondence
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            local Langlands correspondences is the case
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℚ
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_2(\mathbb{Q}_{p})
            = succeed "." do
              %a{:href => "#Breuil2010"} Breuil2010
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fargues-Fontaine+curve"} Fargues-Fontaine curve
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/global+analytic+geometry"} global analytic geometry
          %h2#references References
          %p See also:
          %ul
            %li
              %p
                Wikipedia,
                = succeed "." do
                  %em
                    %a{:href => "http://en.wikipedia.org/wiki/Local_Langlands_conjectures"} Local Langlands conjectures
            %li
              %p
                Colin Bushnell, Guy Henniart,
                %em
                  The local Langlands conjecture for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} GL(2)
            %li
              %p
                %a{:href => "http://www.math.columbia.edu/~chaoli/docs/AutomorphicForm.html"}> Topics on Automorphic Forms
                , course notes by Chao Li from a course taught by Jack Thorne
            %li
              %p
                %a{:href => "http://wwwf.imperial.ac.uk/~buzzard/MSRI/"} Kevin Buzzard’s MSRI Summer School on automorphic forms
          %p Basic definitions are discussed in:
          %ul
            %li#Tate77
              %a.existingWikiWord{:href => "/nlab/show/John+Tate"}> John Tate
              ,
              = succeed "," do
                %em Number theoretic background
              = succeed "," do
                %em Automorphic forms, representations and L-functions
              = succeed "," do
                %a{:href => "https://bookstore.ams.org/pspum-33-2"} ISBN:978-0-8218-3371-1
              = succeed "," do
                %a{:href => "http://www.math.ucsd.edu/~csorense/teaching/math205/Tate_Weil.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/TateNumberTheory.pdf", :title => "pdf"} pdf
          %p
            An approach via the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Fargues-Fontaine+curve"} Fargues-Fontaine curve
          %ul
            %li#FarguesScholze21
              %p
                %a.existingWikiWord{:href => "/nlab/show/Laurent+Fargues"}> Laurent Fargues
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"} Peter Scholze
                %em Geometrization of the local Langlands correspondence
                (
                %a{:href => "https://arxiv.org/abs/2102.13459"}> arXiv:2102.13459
                )
            %li#Scholze25
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"}> Peter Scholze
                ,
                %em Geometrization of the local Langlands correspondence, motivically
                (
                %a{:href => "https://arxiv.org/abs/2501.07944"}> arXiv:2501.07944
                )
          %p
            The above work is partially inspired by the following work on the
            %em global
            Langlands correspondence for function fields over
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_{q}
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Vincent+Lafforgue"}> Vincent Lafforgue
              ,
              %em Chtoucas pour les groupes réductifs et paramétrisation de Langlands
              %p
                globale_
                %a{:href => "http://arxiv.org/abs/1209.5352"} arXiv:1209.5352
          %p
            The spectral action of Fargues and Scholze is used to show the existence of the
            %a.existingWikiWord{:href => "/nlab/show/Hecke+eigensheaf"} Hecke eigensheaf
            in
          %ul
            %li#AnschutzLeBras21
              Johannes Anschütz and Arthur-Cesar Le Bras,
              = succeed "n_" do
                %em Averaging functors in Fargues’ program for GL
              %a{:href => "https://arxiv.org/abs/2104.04701"} arXiv:2104.04701
          %p
            The
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            local Langlands correspondence is discussed in:
          %ul
            %li#Breuil2010
              %a.existingWikiWord{:href => "/nlab/show/Christophe+Breuil"}> Christophe Breuil
              ,
              = succeed "," do
                %em The emerging p-adic Langlands program
              = succeed ")" do
                %a{:href => "https://www.imo.universite-paris-saclay.fr/~breuil/PUBLICATIONS/ICM2010.pdf"} pdf
