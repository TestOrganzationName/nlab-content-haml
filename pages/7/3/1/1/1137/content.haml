              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            part
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_*
            of any
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mo *
                  %mo ⊣
                  %msub
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %msub
                    %mi E
                    %mn 1
                  %mo ⇆
                  %msub
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  (f^* \dashv f_*) \;\; : E_1  \leftrightarrows E_2
          %p
            of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "." do
              %strong direct image
          %p
            More generally, pairs of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
            appear in various other setups apart from
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topoi"} topoi
            %a.existingWikiWord{:href => "/nlab/show/abelian+categories"} abelian categories
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
            %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
            of
            %a.existingWikiWord{:href => "/nlab/show/coherent+sheaves"} coherent sheaves
            and the term
            %em direct image
            is used for the right adjoint part of these, too.
          %p
            Specifically for
            = succeed "es:" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            %a.existingWikiWord{:href => "/nlab/show/morphism+of+sites"} morphism of sites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            induces a
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi p
                    %mo *
                  %mo ⊣
                  %msub
                    %mi p
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mover
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi p
                            %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mo *
                    %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (p^* \dashv p_*)
                  \\;\;\;
                  \:
                  \\;\;\;
                  Sh(X) \stackrel{}{\stackrel{\overset{p_*}{\to}}{\overset{p^*}{\leftarrow}}}
                  Sh(Y)
          %p
            between the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} categories of sheaves
            on the sites, with
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p_*
                the
                %strong direct image
            %li
              %p
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p^*
                its
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/site"} morphism of sites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            coming from a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mi t
                    %mo :
                    %msub
                      %mi S
                      %mi Y
                    %mo →
                    %msub
                      %mi S
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f^t : S_Y \to S_X
            %strong direct image
            operation on
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
            is the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo :
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f_* : PSh(X) \to PSh(Y)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mi F
                  %mo :
                  %msubsup
                    %mi S
                    %mi Y
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi f
                        %mi t
                  %msubsup
                    %mi S
                    %mi X
                    %mi op
                  %mover
                    %mo →
                    %mi F
                  %mi Set
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f_* F : S_Y^{op} \stackrel{f^t}{\to} S_X^{op} \stackrel{F}{\to} Set
                  \\,.
          %p
            The restriction of this operation to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
            %strong direct image of sheaves
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f_* : Sh(X) \to Sh(Y)
                  \\,.
          %h2#examples Examples
          %h3#global_sections Global sections
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            %a.existingWikiWord{:href => "/nlab/show/site"} site
            with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/site"} site
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} p : X \to {*}
          %ul
            %li
              %p
                The direct image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p_*
                is the
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
            %li
              %p
                the inverse image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p^*
                is the
                %a.existingWikiWord{:href => "/nlab/show/constant+sheaf"} constant sheaf
                functor;
            %li
              %p
                the left adjoint to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                    %annotation{:encoding => "application/x-tex"} p^*
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \Pi_0
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+group+of+an+%E2%88%9E-stack"} homotopy group of an ∞-stack
          %h3#restriction_and_extension_of_sheaves Restriction and extension of sheaves
          %p See
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/restriction+and+extension+of+sheaves"} restriction and extension of sheaves
          %p for the moment.
          %h3#DirectImageWithCompactSupport Direct image with compact supports
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to Y
            be a morphism of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+spaces"} locally compact topological spaces
            %a.existingWikiWord{:href => "/nlab/show/subfunctor"} subfunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %mo :
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_!: Sh(X)\to Sh(Y)
            of the direct image functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_*
            such that for any
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the sections of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_!(F)
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi U
                    %mi open
                  %mo ⊂
                  %mi X
                %annotation{:encoding => "application/x-tex"} U^{open}\subset X
            are those sections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %msub
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s\in f_*(U)= \Gamma(f^{-1}(U),F)
            for which the restriction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo :
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi U
                %annotation{:encoding => "application/x-tex"} supp(s)|f : supp(s)\hookrightarrow U
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper map
          %p
            This is called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/direct+image+with+compact+support"} direct image with compact support
          %p
            It follows that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo !
                %annotation{:encoding => "application/x-tex"} f_!
            is left exact.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi X
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} p:X\to {*}
            be the map into the one point space. Then for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ∈
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F\in Sh(X)
            the
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mo !
                  %mi F
                %annotation{:encoding => "application/x-tex"} p_!F
            is the
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            consisting of sections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s\in \Gamma(X,F)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi supp
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} supp(s)
            is compact. One writes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi c
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
