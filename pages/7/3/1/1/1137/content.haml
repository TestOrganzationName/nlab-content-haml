                  %msub
                    %mi f
                    %mo !
                  %mi F
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi y
                %annotation{:encoding => "application/x-tex"} (f_! F)_y
            is isomorphic to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
