          %h3#derived_direct_image Derived direct image
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f^{-1} \colon Y \to X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/morphism+of+sites"} morphism of sites
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mi q
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} R^q f_\ast
              of the induced
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              functor sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ∈
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi et
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \in Ab(Sh(X_{et}))
              to the
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              of the
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi Y
                    %mo ↦
                    %msup
                      %mi H
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    U_Y
                    \\mapsto
                    H^q(f^{-1}(U_Y), \mathcal{F})
                    \\,,
            %p
              where on the right we have the degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} group
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the given
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \mathcal{F}
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Tamme"} Tamme, I (3.7.1), II (1.3.4)
            = succeed ")." do
              %a{:href => "#Milne"} Milne, 12.1
          .proof
            %h6#proof Proof
            %p
              We have a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Ab
                            %mo{:stretchy => "false"} (
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                                %mo ∘
                                %msup
                                  %mi f
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %mi Ab
                            %mo{:stretchy => "false"} (
                            %mi PSh
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi inc
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi L
                        %mtr
                          %mtd
                            %mi Ab
                            %mo{:stretchy => "false"} (
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mo *
                          %mtd
                            %mi Ab
                            %mo{:stretchy => "false"} (
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Ab(PSh(X)) &amp;\stackrel{(-)\circ f^{-1}}{\longrightarrow}&amp; Ab(PSh(Y))
                    \\\
                    \\uparrow^{\mathrlap{inc}} &amp;&amp; \downarrow^{L}
                    \\\
                    Ab(Sh(X)) &amp;\stackrel{f_\ast}{\longrightarrow}&amp; Ab(Sh(Y))
                    }
                    \\,,
            %p
              where the right vertical morphism is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (-) \circ f^{-1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              are both
              %a.existingWikiWord{:href => "/nlab/show/exact+functors"} exact functors
              it follows that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi I
                      %mo •
                    %mo →
                    %mi ℱ
                  %annotation{:encoding => "application/x-tex"} I^\bullet \to \mathcal{F}
              an
              %a.existingWikiWord{:href => "/nlab/show/injective+resolution"} injective resolution
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi R
                              %mi p
                            %msub
                              %mi f
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi ℱ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo :
                            %mo ≃
                            %msup
                              %mi H
                              %mi p
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mo *
                            %mi I
                            %mo{:stretchy => "false"} )
                        %mtr
