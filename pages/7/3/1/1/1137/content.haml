                            %mi L
                            %msup
                              %mi I
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi L
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi H
                              %mi p
                            %mo{:stretchy => "false"} (
