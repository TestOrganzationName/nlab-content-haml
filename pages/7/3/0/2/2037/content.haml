          %h3#equivalence_of_the_definitions Equivalence of the definitions
          .num_prop
            %h6#proposition Proposition
            %p
              Definition
              %a.maruku-ref{:href => "#CayleyDicksonDoubleInComponents"}
              and Definition
              %a.maruku-ref{:href => "#CayleyDicksonDoubleByAdjoiningFurtherGenerator"}
              are equivalent, in that we have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/star-algebras"} star-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ϕ
                          %mtd
                            %mi CD
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mover
                              %mi CD
                              %mo ˜
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi a
                            %mo +
                            %mi ℓ
                            %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\phi
                    \&amp;
                    CD(A)
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    \\widetilde{CD}(A)
                    \\\
                    \&amp;
                    (a,b)
                    \&amp;\mapsto&amp;
                    a + \ell b
                    }
          .proof
            %h6#proof_2 Proof
            %p
              It is clear from Def.
              %a.maruku-ref{:href => "#CayleyDicksonDoubleByAdjoiningFurtherGenerator"}
              that for every element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mover
                      %mi CD
                      %mo ˜
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in \widetilde{CD}(A)
              there is a
              %em unique
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a,b \in A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi a
                    %mo +
                    %mi ℓ
                    %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x = a + \ell b \;=\; \phi(a,b)
                    \\,.
            %p
              This means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a
              %a.existingWikiWord{:href => "/nlab/show/linear+isomorphism"} linear isomorphism
              of the underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+vector+spaces"} real vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is indeed an
              %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
              and that it respects the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
              %a.maruku-eqref{:href => "#eq:lab"} (7)
              and
              %a.maruku-eqref{:href => "#eq:lalb"} (8)
              from Lemma
              = succeed ":" do
                %a.maruku-ref{:href => "#InducedRelations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo +
                            %mi ℓ
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo +
                            %mi ℓ
                            %mi d
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi a
                            %mi c
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi a
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mi ℓ
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mi c
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi a
                            %mi c
                            %mo −
                            %mi d
                            %mover
                              %mi b
                              %mo ¯
                            %mo +
                            %mi ℓ
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi a
                              %mo ¯
                            %mi d
                            %mo +
                            %mi c
                            %mi b
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mi c
                            %mo −
                            %mi d
                            %mover
                              %mi b
                              %mo ¯
                            %mo ,
                            %mover
                              %mi a
                              %mo ¯
                            %mi d
                            %mo +
                            %mi c
                            %mi b
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\phi(a,b) \phi(c,d)
                    \&amp; =
                    (a + \ell b)
                    (c + \ell d)
                    \\\
                    \&amp; =
                    a c + (\ell b)(\ell d)
                    +
                    a (\ell d) + (\ell b) c
                    \\\
                    \&amp; =
                    a c - d \overline{b}
                    +
                    \\ell (
                    \\overline{a} d
                    +
                    c b
                    )
                    \\\
                    \&amp;
                    \=
                    \\phi(a c - d \overline{b}, \overline{a} d + c b)
                    \\end{aligned}
            %p
              Here in the last line we indeed find the component formula
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ProductInComponents"} (1)
            %p
              To see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              respects the involution we use
              %a.maruku-eqref{:href => "#eq:TheNewGenerator"} (3)
              from Def.
              %a.maruku-ref{:href => "#CayleyDicksonDoubleByAdjoiningFurtherGenerator"}
              and
              %a.maruku-eqref{:href => "#eq:al"} (5)
              from Lemma
              = succeed ":" do
                %a.maruku-ref{:href => "#InducedRelations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mrow
                                %mi ϕ
                                %mo{:stretchy => "false"} (
                                %mi a
                                %mo ,
                                %mi b
                                %mo{:stretchy => "false"} )
                              %mo ¯
                          %mtd
                            %mo =
                            %mover
                              %mrow
                                %mi a
                                %mo +
                                %mi ℓ
                                %mi b
                              %mo ¯
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi a
                              %mo ¯
                            %mo +
                            %mover
                              %mrow
                                %mi ℓ
                                %mi b
                              %mo ¯
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi a
                              %mo ¯
                            %mo −
                            %mover
                              %mi b
                              %mo ¯
                            %mi ℓ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi a
                              %mo ¯
                            %mo −
                            %mi ℓ
                            %mi b
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ϕ
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi a
                              %mo ¯
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi b
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\overline{\phi(a,b)}
                    \&amp; =
                    \\overline{ a + \ell b }
                    \\\
                    \&amp; =
                    \\overline{a} + \overline{\ell b}
                    \\\
                    \&amp; =
                    \\overline{a} - \overline{b} \ell
                    \\\
                    \&amp; =
                    \\overline{a} - \ell b
                    \\\
                    \&amp; = \phi( \overline{a}, -b )
                    \\,.
                    \\end{aligned}
            %p
              Here in the last line we indeed find the component formula
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:InvolutionInComponents"} (2)
          %p
            %br/
          %h2#properties Properties
          %p
            The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a\mapsto (a,0)
            is a
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %msup
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A\to A^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %a.existingWikiWord{:href => "/nlab/show/unital+algebra"} unital
            with unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A^2
            is unital with unit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} i
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{i} \coloneqq (0,1)
            has the property
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi{:mathvariant => "normal"} i
                      %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{i}^2 = -1 \coloneqq (-1,0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b)
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo +
                  %mi b
                  %mi{:mathvariant => "normal"} i
                %annotation{:encoding => "application/x-tex"} a + b \mathrm{i}
            (while
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo +
                    %mi{:mathvariant => "normal"} i
                    %mi b
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mover
                      %mi b
                      %mo ¯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a + \mathrm{i} b = (a,\overline{b})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mi{:mathvariant => "normal"} i
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} A[\mathrm{i}]
            in place of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} A^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is unital.
          %p
            Generally speaking, the double
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A^2
            of an algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has a nice property iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is one level nicer. For simplicity, assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is unital (so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is a subalgebra). Since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi{:mathvariant => "normal"} i
                      %mo ¯
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi{:mathvariant => "normal"} i
                  %annotation{:encoding => "application/x-tex"} \overline{\mathrm{i}} = -\mathrm{i}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A^2
            is trivial iff the involution on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is trivial and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            further has
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 2 = 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} i
                    %mi a
                    %mo =
                    %mover
                      %mi a
                      %mo ¯
                    %mi{:mathvariant => "normal"} i
                  %annotation{:encoding => "application/x-tex"} \mathrm{i} a = \overline{a} \mathrm{i}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A^2
            is
            %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is commutative and the involution in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is trivial. Since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi{:mathvariant => "normal"} i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} i
                  %annotation{:encoding => "application/x-tex"} a (b \mathrm{i}) = (b a) \mathrm{i}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A^2
            is
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is associative and commutative. Finally,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mn 2
                %annotation{:encoding => "application/x-tex"} A^2
            is
            %a.existingWikiWord{:href => "/nlab/show/alternative+algebra"} alternative
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is associative (and hence also alternative).
          %h2#examples Examples
          .float_right_image{:style => "margin: -20px 0px 20px 10px"}
            %img{:src => "/nlab/files/QuaternionOctonionMultiplicationTable.jpg", :width => "400px"}/
          %p
            The standard example is the sequence of consecutive doubles starting with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            itself (with the
            %a.existingWikiWord{:href => "/nlab/show/identity+map"} identity map
            as involution); these are the
            = succeed ":" do
              %strong Cayley–Dickson algebras
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
            %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            (or Cayley numbers)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕆
                  %annotation{:encoding => "application/x-tex"} \mathbb{O}
          %p
            These are the
            %a.existingWikiWord{:href => "/nlab/show/real+normed+division+algebras"} real normed division algebras
          %p
            The diagram on the right shows a basis of
            %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} imaginary
            %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            obtained via Cayley-Dickson doubling from a standard basis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mo ,
                  %mi j
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{i,j,k\}
            of
            %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} imaginary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
          %p
            %br/
          %p
            %br/
          %p
            %br/
          %p
            Next, the CD-double of the
            %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            is the
            %a.existingWikiWord{:href => "/nlab/show/sedenions"} sedenions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            = succeed "All" do
              %br/
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power-associative+algebra"} power-associative
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/flexible+algebra"} flexible
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/inverse+elements"} inverse elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo ¯
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} \overline{x} = x
            is always just
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %h2#cayleydicksonalbert_construction Cayley-Dickson-Albert construction
          %p
            The Cayley-Dickson construction described above was slightly generalized in
            = succeed "," do
              %a{:href => "#Alb42CDA"} Section 5 of Albert (1942)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi γ
                %annotation{:encoding => "application/x-tex"} A^{\gamma}
            starting from a unital algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            over a field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            endowed with an
            %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} J:A\to A
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            such that for all
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x\in A
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mo +
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x+ J(x) \in F
                ,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi x
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi x
                      %mo ∈
                      %mi F
                    %annotation{:encoding => "application/x-tex"} x J(x) = J(x) x \in F
                \.
          %p
            To construct
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} A^{\gamma}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ∈
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \gamma\in F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊕
                  %mi A
                %annotation{:encoding => "application/x-tex"} A\oplus A
            one defines a product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mn 1
                  %mo ,
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %msub
                    %mi h
                    %mn 1
                  %mo +
                  %mi γ
                  %mi J
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi g
                    %mn 2
                  %mo ,
                  %msub
                    %mi h
                    %mn 2
                  %msub
                    %mi g
                    %mn 1
                  %mo +
                  %msub
                    %mi g
                    %mn 2
                  %mi J
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi h
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (g_1 ,g_2 )\cdot (h_1, h_2 ) = (g_1 h_1 + \gamma J(h_2) g_2 , h_2 g_1 +g_2 J(h_1 ))
          %p
            and an involution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mi γ
                %annotation{:encoding => "application/x-tex"} A^{\gamma}
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo ,
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mi g
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  K((g_1, g_2 ))= (J(g_1) , -g_2)
          %p
            In particular, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} F=\mathbb{R}
            this process allows to get the
            %a{:href => "composition+algebra#split_composition_algebras"}
              %em split-
            variants of the real division algebra, cf.:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/split-complex+numbers"} split-complex numbers
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/split+quaternions"} split quaternions
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/split+octonions"} split octonions
          %h2#higher_algebra Higher algebra
          %p
            %a{:href => "#AM99quasi"} Albuquerque &amp; Majid (1999)
            describe the Cayley-Dickson process from a different point of view. The quaternions, and octonions are realized as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℤ
                    %mn 2
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2^n
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebras
            over the reals
            %em twisted
            by a group
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ℤ
                      %mn 2
                      %mi n
                    %mo ,
                    %msup
                      %mi ℝ
                      %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega\in Z^n(\mathbb{Z}_2^n,\mathbb{R}^{\times})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mo ,
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n=2,3
          %p
            In more detail, the quaternions are described as the group algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo ×
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{R}[\mathbb{Z}_2\times\mathbb{Z}_2]
            where the group multiplication is twisted by a cocycle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega(g,h)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo ×
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo ×
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{R}[\mathbb{Z}_2\times\mathbb{Z}_2\times\mathbb{Z}_2 ]
            where the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \omega(g,h)
            twisting the multiplication is no longer a 2-cocycle. One of the effects of this is that the octonions are no longer associative or, rather, that they satisfy a nontrivial associativity condition, in the sense of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-Hopf+algebra"} quasi-Hopf algebra
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Z
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ,
                    %msup
                      %mi ℝ
                      %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z^3(\mathbb{Z}_2\times \mathbb{Z}_2\times \mathbb{Z}_2, \mathbb{R}^{\times})
            = succeed "-cocycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            = succeed "-coboundary," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
          %p
            This point of view also clarifies the common claim that algebras in the Cayley-Dickson process lose “nice” properties after more iterations. Rather, a more precise claim is that these nice properties are weakened. In the case of the octonions, these are better regarded as associative
            %em up to
            a nontrivial cocycle.
          %p
            This highlights that a more suitable point of view to study the algebras arising in the Cayley-Dickson process is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            = succeed ")," do
              %a{:href => "#Baez02"} p.8 of Baez (2002)
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to the
            %a.existingWikiWord{:href => "/nlab/show/tensor+category"} tensor category
            which is the
            %a.existingWikiWord{:href => "/nlab/show/fusion+category"} fusion category
            of
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℤ
                      %mn 2
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2^3
            %a.existingWikiWord{:href => "/nlab/show/associator"} associator
            defined by the twisting
            = succeed "-cocycle." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
          %p
            This seems to suggest a pattern regarding the rest of the
            = succeed "-gons," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mi n
                  %annotation{:encoding => "application/x-tex"} 2^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi ℤ
                    %mn 2
                    %mn 4
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{R}[\mathbb{Z}_2^4]
            by a 4-cocycle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Z
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ℤ
                      %mn 2
                      %mn 4
                    %mo ,
                    %msup
                      %mi ℝ
                      %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z^4(\mathbb{Z}_2^4,\mathbb{R}^{\times})
            = succeed "." do
              %em as a 1-algebra
            %a.existingWikiWord{:href => "/nlab/show/fusion+2-category"} fusion 2-category
            of
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
