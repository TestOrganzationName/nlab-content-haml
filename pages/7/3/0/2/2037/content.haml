                    \- \overline{a b}
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a, b \in A
          %p
            (
            %a{:href => "#Baez02"}> Baez 02, second half of 2.2
            )
          #InducedRelations.num_lemma
            %h6#lemma Lemma
            %p
              (
              %strong> induced relations
              )
            %p
              The relation in Def.
              %a.maruku-ref{:href => "#CayleyDicksonDoubleByAdjoiningFurtherGenerator"}
              imply the following further relations:
            #eq:al.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi ℓ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ℓ
                    %mover
                      %mi a
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
