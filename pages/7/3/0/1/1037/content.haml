              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
              %p
                %br/
              %p
                %strong Higher Topos Theory
              %p
                %br/
              %p
                Annals of Mathematics Studies
                %strong 170
              %p Princeton University Press (2009)
              %p
                %a{:href => "https://press.princeton.edu/titles/8957.html"}> pup:8957
                ,
              %p
                %a{:href => "https://www.math.ias.edu/~lurie/papers/HTT.pdf"} pdf
          %p
            which discusses the
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            in general and that of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-sheaves"} (∞,1)-categories of (∞,1)-sheaves
            (i.e. of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stacks
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-toposes
            – in particular;
          %p following an earlier sketch in
