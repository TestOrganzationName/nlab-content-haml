                    %mo ∫
                    %mi s
                    %mrow
                      %msub
                        %mi r
                        %mi ℓ
                  %mo .
                  %mo .
                  %mo .
                  %msubsup
                    %mo ∫
                    %mi s
                    %mrow
                      %msub
                        %mi r
                        %mn 2
                  %msub
                    %mi dX
                    %mrow
                      %msub
                        %mi r
                        %mn 1
                  %mo ⊗
                  %mo .
                  %mo .
                  %mo .
                  %mo ⊗
                  %msub
                    %mi dX
                    %mrow
                      %msub
                        %mi r
                        %mi ℓ
                %annotation{:encoding => "application/x-tex"} X^\ell_{su}\colon =\int_s^u \int_s^{r_\ell}...\int_s^{r_2} dX_{r_1}\otimes...\otimes dX_{r_\ell}
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo =
                  %mo{:stretchy => "false"} ⌊
                  %mi p
                  %mo{:stretchy => "false"} ⌋
                %annotation{:encoding => "application/x-tex"} \ell=\lfloor p \rfloor
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ,
                  %mi u
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} s,u\in[0,t]
            then the following “corrected Riemann sum” converges almost surely as is called the rough integral:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %mi n
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi t
                        %mi k
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mi X
                    %mrow
                      %msub
                        %mi t
                        %mi k
                      %msub
                        %mi t
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                    %mn 1
                  %mo +
                  %mi Df
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi t
                        %mi k
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mi X
                    %mrow
                      %msub
                        %mi t
                        %mi k
                      %msub
                        %mi t
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                    %mn 2
                  %mo +
                  %mo .
                  %mo .
                  %mo .
                  %mo +
                  %msup
                    %mi D
                    %mrow
                      %mi ℓ
                      %mo −
                      %mn 1
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi t
                        %mi k
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mi X
                    %mrow
                      %msub
                        %mi t
                        %mi k
                      %msub
                        %mi t
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                    %mi ℓ
                  %mo{:lspace => "verythinmathspace"} :
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mi t
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi d
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mi s
                %annotation{:encoding => "application/x-tex"} \lim_{n\to\infty}\sum_{k=0}^{n} f(X_{t_k} )X^1_{t_k t_{k+1}}+Df(X_{t_k})X^2_{t_k t_{k+1}}+...+D^{\ell-1}f(X_{t_k})X^{\ell}_{t_k t_{k+1}}\colon = \int_0^t f(X_S)\otimes d\mathbf{X}_s
          %p
            The collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi X
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msup
                    %mi X
                    %mi ℓ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{X}=(X^1,...,X^\ell)
            is called a rough path of order
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Df
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msup
                    %mi D
                    %mrow
                      %mi ℓ
                      %mo −
                      %mn 1
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f(X),Df(X),...,D^{\ell-1}f(X))
            is controlled by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
          %p
          %h2#section_Example Example
          %p
            Fractional Brownian motion (fBm),
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi t
                  %annotation{:encoding => "application/x-tex"} B_t
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi t
                  %msub
                    %mi B
                    %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %mrow
                    %mo (
                    %msup
                      %mi t
                      %mrow
                        %mn 2
                        %mi H
                    %mo +
                    %msup
                      %mi s
                      %mrow
                        %mn 2
                        %mi H
                    %mo −
                    %mo{:stretchy => "false"} |
                    %mi t
                    %mo −
                    %mi s
                    %msup
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mn 2
                        %mi H
                    %mo )
                %annotation{:encoding => "application/x-tex"} E(B_t B_s)=\frac{1}{2}\left(t^{2H}+s^{2H}-|t-s|^{2H}\right)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H\in(0,1)
            is called the Hurst parameter. When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} H=1/2
            we recover regular
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Brownian+motion"} Brownian motion
          %p
            We have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi t
                  %mo ∈
                  %msup
                    %mi C
                    %mi p
                %annotation{:encoding => "application/x-tex"} B_t\in C^p
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo &gt;
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} p\gt 1/H
            and that fBm is not a semimartingale unless
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} H=1/2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo &lt;
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} H\lt 1/2
            are not solvable by classical means and rough paths must be used.
          %p
          %h2#section_References References
          %ul
            %li#Young36
              %p
                LC Young,
                = succeed "," do
                  %em An inequality of the Hölder type, connected with Stieltjes integration
                %strong 67
                (1936), 251–282. doi:
                %a{:href => "https://doi.org/10.1007/BF02401743"}> 10.1007/BF02401743
                , (
                %a{:href => "https://projecteuclid.org/euclid.acta/1485888152"}> Project Euclid
                ).
            %li
              %p
                %span.newWikiWord>
                  Peter Friz
                  %a{:href => "/nlab/new/Peter+Friz"} ?
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Martin+Hairer"} Martin Hairer
                = succeed "," do
                  %em A Course on Rough Paths
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-3-319-08332-2"} doi:10.1007/978-3-319-08332-2
                = succeed "&rbrack;" do
                  %a{:href => "http://www.hairer.org/notes/RoughPaths.pdf"} pdf
            %li
              %p
                Peter Friz and Nicolas Victoir,
                %em Multidimensional Stochastic Processes as Rough Paths: Theory and Applications
                (2010) doi:
                %a{:href => "https://doi.org/10.1017/CBO9780511845079"} 10.1017/CBO9780511845079
                (
                %a{:href => "http://page.math.tu-berlin.de/~friz/master4_May6th.pdf"}> pdf
                ).
            %li
              %p
                Ilya Chevyrev,
                = succeed "," do
                  %em Rough path theory
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Encyclopedia+of+Mathematical+Physics+2nd+ed"} Encyclopedia of Mathematical Physics 2nd ed
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/2402.10331"} arXiv:2402.10331
