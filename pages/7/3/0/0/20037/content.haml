                          %mi r
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} X^2_{su}\colon =\int_s^u\int_s^{r_2} dX_{r_1}\otimes dX_{r_2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi X
                    %mi su
                    %mi ℓ
                  %mo{:lspace => "verythinmathspace"} :
                  %mo =
                  %msubsup
                    %mo ∫
                    %mi s
