                        %msub
                          %mi r
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} X^1_{su}\colon = \int_s^u dX_{r_1}
            = succeed ",\u2026," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi X
                      %mi su
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %mo =
                    %msubsup
                      %mo ∫
                      %mi s
                      %mi u
                    %msubsup
                      %mo ∫
                      %mi s
                      %mrow
                        %msub
