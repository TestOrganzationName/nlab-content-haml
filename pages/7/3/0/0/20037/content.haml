                        %mn 1
                    %mo &lt;
                    %mi t
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}_n=\{0=t_0\lt...\lt t_{n-1}\lt t\}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi X
                      %mi su
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mo =
                    %msubsup
