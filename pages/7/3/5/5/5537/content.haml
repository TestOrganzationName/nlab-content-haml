          %title Pro-sets
          %h1#prosets Pro-sets
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#prosets_versus_locales"} Pro-sets versus locales
              %ul
                %li
                  %a{:href => "#the_classifying_locale_of_a_proset"} The classifying locale of a pro-set
                %li
                  %a{:href => "#the_proset__of_a_locale"}
                    The pro-set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Π
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \Pi_0
                    of a locale
                %li
                  %a{:href => "#the_classifying_locale_functor_is_not_an_embedding"} The classifying locale functor is not an embedding
          %h2#definition Definition
          %p
            A
            %strong pro-set
            is a
            %a.existingWikiWord{:href => "/nlab/show/pro-object"} pro-object
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            This should not be confused with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proset"} proset
          %h2#prosets_versus_locales Pro-sets versus locales
          %h3#the_classifying_locale_of_a_proset The classifying locale of a pro-set
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pro(Set)
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+completion"} free completion
            of
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cofiltered+limits"} cofiltered limits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            into a category with cofiltered limits extends uniquely to a cofiltered-limit-preserving functor from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pro(Set)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mo →
                  %mi Loc
                %annotation{:encoding => "application/x-tex"} Set \to Loc
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            to the category of
            %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            which regards a set as a
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete
            locale.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi i
                %annotation{:encoding => "application/x-tex"} (S_i)_i
            is a pro-set, which we may WLOG assume to be indexed on a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/directed+poset"} directed poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %msub
                    %mi S
                    %mi i
                %annotation{:encoding => "application/x-tex"} \lim S_i
            is presented by the following
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/posite"} posite
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            is the
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            of the
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                  %annotation{:encoding => "application/x-tex"} (S_i)_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i,x)
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x\in S_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i,x)\le (j,y)
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≤
                  %mi j
                %annotation{:encoding => "application/x-tex"} i\le j
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} s_{i j}(x)=y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mrow
                      %mi i
                      %mi j
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi S
                    %mi i
                  %mo →
                  %msub
                    %mi S
                    %mi j
                %annotation{:encoding => "application/x-tex"} s_{i j} \colon S_i \to S_j
            is the transition map. The covers in the posite are generated by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ⊲
                  %msubsup
                    %mi s
                    %mrow
                      %mi i
                      %mi j
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i,x) \lhd s_{i j}^{-1}(x)
            for any
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ,
                    %mi x
                  %annotation{:encoding => "application/x-tex"} i,j,x
          %p
            Thus, the open sets in the locale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %msub
                    %mi S
                    %mi i
                %annotation{:encoding => "application/x-tex"} \lim S_i
            are the “ideals” for this coverage, i.e. sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (i,x)
            which are down-closed and such that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} (j,y)\in A
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            and all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %msubsup
                      %mi s
                      %mrow
                        %mi i
                        %mi j
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y\in s_{i j}^{-1}(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (i,x)\in A
          %h3#the_proset__of_a_locale
            The pro-set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Pi_0
            of a locale
          %p
            On the other hand, there is a naturally defined functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Loc
                  %mo →
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_0\colon Loc \to Pro(Set)
            which sends a locale to its pro-set of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_0(X)
            are decompositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} X = \coprod_{i\in I} U_i
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as a
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U_i) \to (V_j)
            = succeed "," do
              %em refinement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi I
                  %mo →
                  %mi J
                %annotation{:encoding => "application/x-tex"} f:I\to J
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            is contained in
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_{f(i)}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p
            This diagram is cofiltered: 1. It is nonempty, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the 1-ary coproduct of itself. 1. Given decompositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U_i)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V_j)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi V
                    %mi j
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} (U_i \cap V_j)_{i,j}
            refines both of them. 1. Given parallel refinements
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f,g:(U_i)\to (V_j)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            we have
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊆
                    %msub
                      %mi V
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                    %mo ∩
                    %msub
                      %mi V
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U_i \subseteq V_{f(i)} \cap V_{g(i)}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} K = \{ i | f(i) = g(i) \}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi i
                  %mo =
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} W_i = U_i
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi K
                  %annotation{:encoding => "application/x-tex"} i\in K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h\colon (W_k) \to (U_i)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi h
                    %mo =
                    %mi g
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f h = g h
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (W_k)
            is actually a cover of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                  %mo ∩
                  %msub
                    %mi V
                    %mrow
                      %msub
                        %mi j
                        %mn 2
                  %mo =
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi V
                    %mrow
                      %msub
                        %mi j
                        %mn 1
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi j
                    %mn 1
                  %mo =
                  %msub
                    %mi j
                    %mn 2
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} V_{j_1} \cap V_{j_2} = \bigcup \{ V_{j_1} | j_1 = j_2 \}
            (the latter being the
            %a.existingWikiWord{:href => "/nlab/show/join"} join
            of a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/subsingleton"} subsingleton
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                  %mo ⊆
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} U_i \subseteq \bigcup \{ U_i | f(i) = g(i) \}
            (another join of a subsingleton) and thus
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊆
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %mi k
                        %mo ∈
                        %mi K
                    %msub
                      %mi W
                      %mi k
                  %annotation{:encoding => "application/x-tex"} U_i \subseteq \bigcup_{k\in K} W_k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i
            cover
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi k
                  %annotation{:encoding => "application/x-tex"} W_k
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematician
            may be forgiven for thinking this last argument to be more confusing than necessary, since classically, either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(i)=g(i)
            (in which case
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi i
                    %mo =
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} W_i = U_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(i)\neq g(i)
            (in which case
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} U_i = \emptyset
          %p
            Note that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+connected+space"} locally connected
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi_0(X)
            is a mere set.
          %p
            This is the
            %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-topos"} (0,1)-topos
            version of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group+of+a+topos"} fundamental group of a topos
            or the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+of+an+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid of an (∞,1)-topos
          .un_theorem
            %h6#theorem Theorem
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Loc
                    %mo →
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_0\colon Loc \to Pro(Set)
              is left adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Pro
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Loc
                    %annotation{:encoding => "application/x-tex"} \lim\colon Pro(Set)\to Loc
          .proof
            %h6#proof Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                  %annotation{:encoding => "application/x-tex"} \lim
              is given by regarding a pro-set as a diagram of discrete locales and taking its limit, it suffices to show that morphisms of pro-sets
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \Pi_0(X) \to S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %msub
                        %mi S
                        %mi disc
                    %annotation{:encoding => "application/x-tex"} X \to S_{disc}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi S
                      %mi disc
                  %annotation{:encoding => "application/x-tex"} X \to S_{disc}
              is precisely a decomposition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into disjoint opens indexed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \Pi_0(X) \to S
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/overt+locale"} overt locale
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/positive+elements"} positive elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Π
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Pi_0
            becomes a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/codirected+poset"} codirected poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U_i)
            is covered by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
