            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mn 2
                %annotation{:encoding => "application/x-tex"} S\to 2
            is determined by a partition of some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi i
                  %mo =
                  %msubsup
                    %mi S
                    %mi i
                    %mo ⊥
                  %mo ⊔
                  %msubsup
                    %mi S
                    %mi i
                    %mo ⊤
                %annotation{:encoding => "application/x-tex"} S_i = S_i^\bot \sqcup S_i^\top
            (modulo a suitable equivalence relation as we change
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %msub
                    %mi S
                    %mi i
                  %mo →
                  %mn 2
                %annotation{:encoding => "application/x-tex"} \lim S_i \to 2
            consists of two ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} A^\bot
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi A
                    %mo ⊤
                %annotation{:encoding => "application/x-tex"} A^\top
            which are disjoint and whose union
            %em generates
            the improper ideal (which consists of all pairs
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
