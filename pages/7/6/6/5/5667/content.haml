                        %mi Mod
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{K} \;\colon\; KK \to Ho(\mathbb{K}(\mathbb{C}) Mod)
                        \\,.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕂
                      %annotation{:encoding => "application/x-tex"} \mathbb{K}
                  restricts to a
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/thick+subcategory"} thick subcategory
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi KK
                      %annotation{:encoding => "application/x-tex"} KK
                  generated by the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                  (the “
                  %a.existingWikiWord{:href => "/nlab/show/bootstrap+category"}> bootstrap category
                  ”).
          %p
            This is the main result of (
            %a{:href => "#DEKM11"}> DEKM 11, section 3
            ).
          .num_remark
            %h6#remark_4 Remark
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
              is a
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
              in particular it preserves
              %a.existingWikiWord{:href => "/nlab/show/dual+objects"} dual objects
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dual+morphisms"} dual morphisms
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebras"} Poincaré duality algebras
              and their
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Umkehr+maps"} Umkehr maps
          %h3#knneth_theorem Künneth theorem
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/thick+subcategory"} thick subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KK
                %annotation{:encoding => "application/x-tex"} KK
            generated from the
            %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/bootstrap+category"} bootstrap category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Boot
                    %mo ↪
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} Boot \hookrightarrow KK
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi Boot
                  %mo ↪
                  %mi KK
                %annotation{:encoding => "application/x-tex"} A \in Boot \hookrightarrow KK
            one has that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KK
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} KK(A,B)
            satisfies a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
            %em
              %a.existingWikiWord{:href => "/nlab/show/bootstrap+category"} bootstrap category
            for more.
          %h3#excision_and_relation_to_etheory Excision and relation to E-theory
          .num_defn
            %h6#definition_8 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
              one says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} KK
              satisfies
              %strong
                %a.existingWikiWord{:href => "/nlab/show/excision"} excision
              or that it is
              %strong excisive
              for this sequence if it preserves its
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exactness
              in the middle.
          .num_example
            %h6#example_7 Example
            %p
              By theorem
              = succeed "," do
                %a.maruku-ref{:href => "#KKIsAdditiveSplitExactLocalizationAtCompacts"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} KK
              is excisive over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequences"} split exact sequences
          .num_prop
            %h6#proposition_6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} KK
              is excisive for
              %a.existingWikiWord{:href => "/nlab/show/nuclear+C%2A-algebras"} nuclear C*-algebras
              in the first argument.
          %p
            This is discussed (
            %a{:href => "#Kasparov80"}> Kasparov 80, section 7
            ), (
            %a{:href => "#CuntzSkandalis86"}> Cuntz-Skandalis 86
            ).
          %p More generally:
          .num_prop
            %h6#proposition_7 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} KK
              is excisive for
              %a.existingWikiWord{:href => "/nlab/show/K-nuclear+C%2A-algebras"} K-nuclear C*-algebras
              in the first argument.
          %p
            (
            %a{:href => "#Skandalis88"}> Skandalis 88
            )
          .num_remark
            %h6#remark_5 Remark
            %p
              It is not expected that excision is satisfied fully generally by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KK
                    %annotation{:encoding => "application/x-tex"} KK
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
              improvement of
              = succeed "-theory" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KK
                    %annotation{:encoding => "application/x-tex"} KK
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/E-theory"} E-theory
          %h3#PoincareDualityAndThomIsomorphism Poincaré duality and Thom isomorphism
          #PoincareDualityAlgebra.num_defn
            %h6#definition_9 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
              is a
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebra"} Poincaré duality algebra
              if it is a
              %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
              in the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} KK
              with dual its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/opposite+algebra"} opposite algebra
          %p
            (
            %a{:href => "#BrodzkiMathaiRosenbergSzabo07"}> Brodzki-Mathai-Rosenberg-Szabo 07, def. 2.1
            )
          #PoincareDuality.num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              which is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(X) \otimes C_0(T^\ast X)
              (the tensor product of the algebra of functions of
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and on its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi KK
                    %annotation{:encoding => "application/x-tex"} KK
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \colon C(X) \otimes C_0(T^\ast X) \stackrel{\simeq}{\to}
                    \\mathbb{C}
                    \\,.
          %p
            (
            %a{:href => "#Kasparov80"}> Kasparov 80
            )
          .num_cor
            %h6#corollary_2 Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              (
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"}> Thom isomorphism
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi KK
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %mi KK
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    K_0( C_0(T^\ast X))
                    \\simeq
                    KK(\mathbb{C}, C_0(T^\ast X))
                    \\stackrel{KK(C,(-)\otimes C(X))}{\to}
                    KK(C(X), C(X) \otimes C_0(T^\ast X) )
                    \\underoverset{\simeq}{KK(C(X), d)}{\to}
                    KK(C(X), \mathbb{C} )
                    \\,.
          %p
            For more discussion see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebra"} Poincaré duality algebra
          %h3#UmkehrMap Push-forward in KK-theory
          %p
            %a.existingWikiWord{:href => "/nlab/show/Umkehr+map"} Umkehr map
            in KK-theory (
            %a{:href => "#BrodzkiMathaiRosenbergSzabo07"}> Brodzki-Mathai-Rosenberg-Szabo 07, section 3.3
            )
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebras"} Poincaré duality algebras
            = succeed "," do
              %a.maruku-ref{:href => "#PoincareDualityAlgebra"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f \colon A \to B
            a morphism, the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Umkehr+map"} Umkehr map
            is (postcomposition) with the
            %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
            of its
            %a.existingWikiWord{:href => "/nlab/show/opposite+algebra"} opposite algebra
            version:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo !
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mi op
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f! \coloneqq (f^op)^\ast
                  \\,.
          %p
            (
            %a{:href => "#BrodzkiMathaiRosenbergSzabo07"}> Brodzki-Mathai-Rosenberg-Szabo 07, p. 14
            )
          %p
            For more and a discussion of
            %a.existingWikiWord{:href => "/nlab/show/twisted+Umkehr+maps"} twisted Umkehr maps
            see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+algebra"} Poincaré duality algebra
            and at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly+cancellation"} Freed-Witten-Kapustin anomaly cancellation
          %h2#further_theorems Further Theorems
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Baum-Connes+conjecture"} Baum-Connes conjecture
                is naturally formulated within KK-theory.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Novikov+conjecture"} Novikov conjecture
                has been verified in many cases using KK-theory. (see for instance
                = succeed ")." do
                  %a{:href => "#Rosenberg80"} Rosenberg 80
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Atiyah-Singer+index+theorem"} Atiyah-Singer index theorem
                is naturally formutaled in KK-theory/
                %a.existingWikiWord{:href => "/nlab/show/E-theory"}> E-theory
                \. (See (
                %a{:href => "#HigsonRoe"}> Higson-Roe
                )).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/KK-bootstrap+category"} KK-bootstrap category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+KK-theory"} equivariant KK-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/index+theory"} index theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/bivariant+cohomology+theory"} bivariant cohomology theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/bivariant+algebraic+K-theory"}> bivariant algebraic K-theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/K-motive"} K-motive
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/operator+K-theory"} operator K-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/E-theory"} E-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopical+structure+on+C%2A-algebras"}> homotopical structure on C*-algebras
                ,
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operator+algebras"} model structure on operator algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/assembly+map"}> assembly map
                ,
                %a.existingWikiWord{:href => "/nlab/show/Baum-Connes+conjecture"} Baum-Connes conjecture
          %div
            %table
              %thead
                %tr
                  %th geometric context
                  %th
                    universal additive
                    %a.existingWikiWord{:href => "/nlab/show/bivariant+cohomology+theory"} bivariant
                    (preserves
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/split+exact+sequences"} split exact sequences
                  %th
                    universal localizing
                    %a.existingWikiWord{:href => "/nlab/show/bivariant+cohomology"} bivariant
                    (preserves all
                    %a.existingWikiWord{:href => "/nlab/show/exact+sequences"} exact sequences
                    in the middle)
                  %th universal additive invariant
                  %th universal localizing invariant
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebraic+geometry"} noncommutative algebraic geometry
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
                    %math#mathml_55f3094059c9fbdb4ade37c5d893a16a5acbd98f_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Mot
                            %mi add
                        %annotation{:encoding => "application/x-tex"} Mot_{add}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
                    %math#mathml_55f3094059c9fbdb4ade37c5d893a16a5acbd98f_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Mot
                            %mi loc
                        %annotation{:encoding => "application/x-tex"} Mot_{loc}
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
                  %td{:style => "text-align: left;"}
