                        %mi ℋ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (F - F^\ast) \pi(a)\in \mathcal{K}_B(\mathcal{H})
            %p
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
            %p
              hence such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              squares to the identity, commutes with multiplication operators and is self-adjoint
              %em up to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
          %p
            For instance (
            %a{:href => "#Blackadar99"}> Blackadar 99, p. 144
            ).
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} B = \mathbb{C}
              a Kasparov
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,B)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+module"} Fredholm module
              for an essentially self-adjoint
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operator"} Fredholm operator
          #HomotopyOfKasparovBimodules.num_defn
            %h6#definition_6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              between two Kasparov
              = succeed "-bimodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,B)
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A, C([0,1],B))
            %p (…)
          .num_defn
            %h6#definition_7 Definition
            %p
              Writes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} KK(A,B)
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of Kasparov
              = succeed "-bimodules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,B)
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyOfKasparovBimodules"}
          .num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} KK(A,B)
              is naturally an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              under
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of bimodules and operators.
          #KasparovProduct.num_prop
            %h6#proposition_2 Proposition
            %p There is a composition operation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    KK(A,B) \times KK(B,C) \to KK(A,C)
            %p
              such that (…). This is called the
              = succeed "." do
                %strong Kasparov product
          %p
            A streamlined version of the definition of the Kasparov product is in (
            %a{:href => "#Skandalis84"}> Skandalis 84
            ).
          .num_remark
            %h6#remark Remark
            %p
              From the point of view of
              %a.existingWikiWord{:href => "/nlab/show/E-theory"} E-theory
              the Kasparov product is equivalently just the composition of homotopy classes of completely positive
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/asymptotic+C%2A-homomorphisms"} asymptotic C*-homomorphisms
              %em
                %a.existingWikiWord{:href => "/nlab/show/E-theory"} E-theory
              for more on this.
          .num_remark
            %h6#remark_2 Remark
            %p
              On the other hand, at least between
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %a.existingWikiWord{:href => "/nlab/show/algebras+of+functions"} algebras of functions
              on
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                    %mo =
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_i = C(X_i)
              , KK-classes are presented by
              %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ←
                    %mi Z
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_1 \leftarrow Z \to X_2
              and the Kasparov product is given just by the
              = succeed "-composition" do
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              = succeed "," do
                %a{:href => "#ConnesSkandalis84"} Connes-Skandalis 84, theorem 3.2
              = succeed ")." do
                %a{:href => "#BlockWeinberger99"} Block-Weinberger 99, section 3
          %h3#UniversalCharacterization Universal category-theoretic characterization
          #KasparovProductIsAssociative.num_prop
            %h6#proposition_3 Proposition
            %p
              The Kasparov product, def.
              = succeed "," do
                %a.maruku-ref{:href => "#KasparovProduct"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                    %mo ×
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                    %mo →
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"}
                    KK(-,-) \;\colon\; C^\ast Alg \times C^\ast Alg \to C^\ast Alg
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              of an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
          %p
            (
            %a{:href => "#Higson"}> Higson 87, theorem 4.1
            )
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KK
                %annotation{:encoding => "application/x-tex"} KK
            is a kind of
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            of the category of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebras"} C-star-algebras
          #KKIsAdditiveSplitExactLocalizationAtCompacts.num_theorem
            %h6#theorem Theorem
            %p The canonical functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                    %mo →
                    %mi KK
                  %annotation{:encoding => "application/x-tex"}
                    Q \colon C^\ast Alg \to KK
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} KK
              as the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal category
              receiving a functor from
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi KK
                      %annotation{:encoding => "application/x-tex"} KK
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  is homotopy-invariant;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} inverts
                  the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  with the
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
                  of
                  %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
                %p
                  (for all
                  = succeed "-homomorphisms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi id
                        %mo ⊗
                        %mi e
                        %mo{:stretchy => "false"} ⟨
                        %mi e
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mspace{:width => "thickmathspace"}
                        %mo →
                        %mi A
                        %mo ⊗
                        %mi 𝒦
                      %annotation{:encoding => "application/x-tex"} id \otimes e \langle e,- \rangle \;\colon A\; \to A \otimes \mathcal{K}
                  the morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ⊗
                        %mi e
                        %mo{:stretchy => "false"} ⟨
                        %mi e
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Q(id \otimes e \langle e)
                  is an
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                  preserves
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/split+short+exact+sequences"} split short exact sequences
          %p
            This is due to (
            %a{:href => "#Higson"}> Higson 87, theorem 4.5
            ). The generalization to the equivariant case is due to (
            %a{:href => "#Thomsen98"}> Thomsen 98
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              The localization conditions here are analogous to those that define the localization of
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
              to
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
              See there for more and see the references
              = succeed "." do
                %a{:href => "#AsHomotopyOfStableInfinityCategoryReferences"} below
          .num_cor
            %h6#corollary Corollary
            %p
              The minimal
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+C-star-algebras"} tensor product of C-star-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                    %mo ×
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                    %mo →
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"}
                    \\otimes \colon C^\ast Alg \times C^\ast Alg \to C^\ast Alg
            %p
              extends uniquely to a
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi KK
                  %annotation{:encoding => "application/x-tex"} \otimes_{KK}
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi KK
                  %annotation{:encoding => "application/x-tex"} KK
              such that there is a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mo *
                            %mi Alg
                            %mo ×
                            %msup
                              %mi C
                              %mo *
                            %mi Alg
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi Q
                                %mo ×
                                %mi Q
                          %mtd
                            %mi KK
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ⊗
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ⊗
                                    %mi KK
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mo *
                            %mi Alg
                          %mtd
                            %mover
                              %mo →
                              %mi Q
                          %mtd
                            %mi KK
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C^\ast Alg \times C^\ast Alg &amp;\stackrel{Q \times Q}{\to}&amp; KK
                    \\\
                    \\downarrow^{\mathrlap{\otimes}} &amp;&amp; \downarrow^{\mathrlap{\otimes_{KK}}}
                    \\\
                    C^\ast Alg &amp;\stackrel{Q}{\to}&amp; KK
                    }
                    \\,.
          %p
            (
            %a{:href => "#Higson"}> Higson 87, theorem 4.8
            )
          %p
            For more discussion of more explicit presentations of this
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            process for obtaining KK-theory see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopical+structure+on+C%2A-algebras"} homotopical structure on C*-algebras
            and also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+operator+algebras"} model structure on operator algebras
          %h3#RelationToHomotopyClassesOfStarHomomorphisms
            In terms of homotopy-classes of
            = succeed "-homomorphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
          %p Theorem (Cuntz)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                %annotation{:encoding => "application/x-tex"} A,B
            are
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebras"} C-star-algebras
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            separable and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            = succeed "-unital," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KK
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi q
                  %mi A
                  %mo ,
                  %mi B
                  %mo ⊗
                  %mi 𝒦
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  KK(A,B) \simeq [q A, B \otimes \mathcal{K}]
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mi A
                    %annotation{:encoding => "application/x-tex"} q A
                is the
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                of the
                %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⋆
                        %mi A
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A \star A \to A
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒦
                    %annotation{:encoding => "application/x-tex"} \mathcal{K}
                is the
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
                is the set of
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
          %p
            (reviewed in (
            %a{:href => "#JoachimJohnson07"}> Joachim-Johnson07
            )).
          %h3#InTermsOfCorrespondences In terms of correspondences/spans of groupoids
          %p
            At least to some extent, KK-classes between
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            on manifolds/spaces, and maybe more generally between
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebras"} groupoid convolution algebras
            can be represented by certain
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/spans"} spans
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ←
                  %mo{:stretchy => "false"} (
                  %mi Z
                  %mo ,
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  X \leftarrow (Z,E) \to Y
          %p
            of such
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
          %p
            See the corresponding
            = succeed "." do
              %a{:href => "#ReferencesInTermsOfCorrespondences"} references below
          %p
            Such a description by abelianizations of
            %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
            is reminiscent of similar constructions of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/motivic+cohomology"} motivic cohomology
            = succeed "." do
              %a{:href => "#AsAnAnalogOfMotives"} below
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/motivic+quantization"} motivic quantization
          %p (…)
          %ul
            %li
              %p
                category of equivariant correspondences equipped with cocycle:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mover
                          %mi F
                          %mo{:stretchy => "false"} ^
                        %mi 𝒢
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \hat F_{\mathcal{G}}^\ast
                (theorem 2.26);
            %li
              %p
                specifically for K-theory cocycles:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mover
                          %mi KK
                          %mo ^
                        %mi 𝒢
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \widehat {KK}_{\mathcal{G}}^\ast
                (section 4, page 27)
            %li
              %p pull-push from correspondences to KK in proof of theorem 4.2, bottom of p. 27
          %p (…)
          %h3#AsAnAnalogOfMotives As an analog of motives in noncommutative topology
          %p
            To some extent
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            %a.existingWikiWord{:href => "/nlab/show/E-theory"} E-theory
            look like an analogue in
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+topology"} noncommutative topology
            of what in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            is the category of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/motives"} motives
            = succeed ")." do
              %a{:href => "#ConnesConsaniMarcolli05"} Connes-Consani-Marcolli 05
            = succeed ")." do
              %a{:href => "#Meyer06"} Meyer 06
          %p
            Specifically the characterization in terms of spans/correspondences
            %a{:href => "#InTermsOfCorrespondences"} above
            is reminiscent to the definition of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pure+motives"} pure motives
            %em
              %a{:href => "#ReferencesInTermsOfCorrespondences"}> In terms of correspondences
              \. A relation between bivariant
              %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
              and
              %a.existingWikiWord{:href => "/nlab/show/motivic+cohomology"} motivic cohomology
              is discussed in (
              %a{:href => "#GarkushaPanin11"}> Garkusha-Panin 11
              ).
          %p
            A universal
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            from KK-theory to
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KK
                  %mo ⟶
                  %msub
                    %mi NCC
                    %mi dg
                %annotation{:encoding => "application/x-tex"}
                  KK \longrightarrow NCC_{dg}
          %p
            was given in (
            %a{:href => "#Mahanta13"}> Mahanta 13
            ). This sends a
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
            to the
            %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
            of
            %a.existingWikiWord{:href => "/nlab/show/perfect+complexes"} perfect complexes
            over (the
            %a.existingWikiWord{:href => "/nlab/show/unitalization"} unitalization
            of) its underlying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          %h3#EquivariantKKTheory Equivariant KK-theory
          %p
            Pretty much all of KK-theory has a generalization to
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant cohomology
            where all algebras and modules are equipped with
            %a.existingWikiWord{:href => "/nlab/show/actions"} actions
            of a given
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            or more generally
            %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            %a.existingWikiWord{:href => "/nlab/show/equivariance"} equivariant
            under this action. See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivariant+KK-theory"} equivariant KK-theory
            for more.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Baum-Connes+conjecture"} Baum-Connes conjecture
            and the
            %a.existingWikiWord{:href => "/nlab/show/Green-Julg+theorem"} Green-Julg theorem
            assert that under some conditions
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebras"} groupoid convolution algebras
            of the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+groupoids"} action groupoids
            %em
              %a.existingWikiWord{:href => "/nlab/show/Green-Julg+theorem"} Green-Julg theorem
            for details.
          %h2#Examples Examples
          %h3#basic_examples Basic examples
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \colon A \to B
              a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+C%2A-algebras"} graded C*-algebras
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              as a right
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+module"} Hilbert module
              over itself and equip it with the left
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              induced by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+bimodule"} Hilbert bimodule
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Fredholm+operator"} Fredholm operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi f
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (B, f, 0) \in KK(A,B)
                    \\,.
          %p
            For instance (
            %a{:href => "#Blackadar99"}> Blackadar 99, example 17.1.2 a)
            ).
          .num_example
            %h6#example_4 Example
            %p For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi i
                    %mo ,
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (H_i, F_i) \in KK(A,B)
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+module"} Fredholm
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mi i
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A_i,B)
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+bimodule"} Hilbert bimodule
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} i \in \{1,2\}
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi H
                      %mn 2
                    %mo ,
                    %msub
                      %mi F
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi F
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi A
                      %mn 2
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (H_1 \oplus H_2, F_1 \oplus F_2) \in KK(A_1\oplus A_2, B)
                    \\,.
          %p
            For instance (
            %a{:href => "#Blackadar99"}> Blackadar 99, example 17.1.2 c)
            ).
          %h3#the_archetypical_examples The archetypical examples
          .num_example
            %h6#example_5 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
              be a
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 0
                    %mo ,
                    %msub
                      %mi V
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} V_0, V_1
              be two smooth
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with Hermitian strucure (
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              to a chosen
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %p
              Then given an
              %a.existingWikiWord{:href => "/nlab/show/elliptic+operator"} elliptic
              %a.existingWikiWord{:href => "/nlab/show/pseudodifferential+operator"} pseudodifferential operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    P \colon \Gamma(V_0) \to \Gamma(V_1)
            %p
              on smooth
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              it extends to an essentially
              %a.existingWikiWord{:href => "/nlab/show/unitary+operator"} unitary
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operator"} Fredholm operator
              on
              %a.existingWikiWord{:href => "/nlab/show/square+integrable+function"} square integrable
              sections
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi L
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L^2(V_i)
            %p
              Consider then the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ≔
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H \coloneqq L^2(V_0) \oplus L^2(V_1)
            %p
              equipped with the evident action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(X)
              (by “
              %span.newWikiWord>
                multiplication operators
                %a{:href => "/nlab/new/multiplication+operators"} ?
              ”). Then with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              a
              %a.existingWikiWord{:href => "/nlab/show/parametrix"} parametrix
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ≔
                    %mrow
                      %mo [
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi Q
                          %mtr
                            %mtd
                              %mi P
                            %mtd
                              %mn 0
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    F \coloneqq
                    \\left[
                    \\array{
                    0 &amp; Q
                    \\\
                    P &amp; 0
                    }
                    \\right]
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operator"} Fredholm operator
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msup
                        %mi L
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %msup
                        %mi L
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mrow
                        %mo [
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mi Q
                            %mtr
                              %mtd
                                %mi P
                              %mtd
                                %mn 0
                        %mo ]
                      %mo )
                    %mo ∈
                    %mi KK
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    L^2(V_1) \oplus L^2(V_2),
                    \\left[
                    \\array{
                    0 &amp; Q
                    \\\
                    P &amp; 0
                    }
                    \\right]
                    \\right)
                    \\in
                    KK(C(X),\mathbb{C})
                    \\,.
          .num_example
            %h6#example_6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,g)
              be an
              %a.existingWikiWord{:href => "/nlab/show/almost+complex+manifold"} almost complex manifold
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:lspace => "verythinmathspace"} :
                    %mover
                      %mo ∂
                      %mo ¯
                    %mo +
                    %msup
                      %mover
                        %mo ∂
                        %mo ¯
                      %mo *
                  %annotation{:encoding => "application/x-tex"} D \colon \overline{\partial} + \overline{\partial}^\ast
              be the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Dolbeault-Dirac+operator"} Dolbeault-Dirac operator
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ≔
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
