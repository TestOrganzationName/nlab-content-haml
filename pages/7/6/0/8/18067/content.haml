          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and
            %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/algebra+spectrum"} algebra spectrum
            induced by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %em symmetric algebra
            spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mi R
                    %mi E
                  %annotation{:encoding => "application/x-tex"} Sym_R E
            %a.existingWikiWord{:href => "/nlab/show/symmetric+algebras"} symmetric algebras
            on
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            (e.g.
            = succeed ")." do
              %a{:href => "#Khan16"} Khan 16
          %p
            The underlying spectrum of the symmetric algebra is simply the
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            (
            %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
            of spectra) of all the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/smash+products"} smash products
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotiented
            by the canonical
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            of the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma(n)
            (by
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            of factors):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sym
                    %mi R
                  %mi E
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo ∨
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi E
                    %mrow
                      %msup
                        %mo ∧
                        %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sym_R E
                  \\;\coloneqq\;
                  \\underset{n \in \mathbb{N}}{\vee}
                  (E^{\wedge^n})/\Sigma(n)
                  \\,.
          %p
            In contrast to ordinary
            %a.existingWikiWord{:href => "/nlab/show/symmetric+algebras"} symmetric algebras
            on ordinary
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            over ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            itself, regarded as a
            %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectrum
            itself has interesting structure:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi Sym
                            %mi R
                          %mi R
                        %mtd
                          %mo ≃
                          %munder
                            %mo ∨
                            %mrow
                              %mi n
                              %mo ∈
                              %mi ℕ
                          %mi R
                          %mo{:stretchy => "false"} /
                          %mi Σ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %munder
                            %mo ∨
                            %mrow
                              %mi n
                              %mo ∈
                              %mi ℕ
                          %mi R
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi Σ
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo +
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi R
                          %mo ∧
                          %msub
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %mi n
                                  %mo ∈
                                  %mi ℕ
                              %mi B
                              %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mo +
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Sym_R R
                  \&amp; \simeq
                  \\underset{n \in \mathbb{N}}{\vee}
                  R / \Sigma(n)
                  \\\
                  \&amp; \simeq
                  \\underset{n \in \mathbb{N}}{\vee} R \wedge (B \Sigma(n))_+
                  \\\
                  \&amp; \simeq
                  R \wedge
                  \\left(
                  \\underset{n \in \mathbb{N}}{\coprod}
                  B \Sigma(n)
                  \\right)_+
                  \\end{aligned}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %msub
                    %mi Σ
                    %mi n
                %annotation{:encoding => "application/x-tex"} B \Sigma_n
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            of the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            elements (given for instance by the
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Emb
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %msup
                      %mi ℝ
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Emb(\{1, \cdots, n\}, \mathbb{R}^{\infty})/\Sigma(n)
          %p
            In particular for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} R = \mathbb{S}
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %em
              absolute
              %a.existingWikiWord{:href => "/nlab/show/spectral+affine+line"} spectral affine line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sym
                    %mi 𝕊
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} Sym_{\mathbb{S}}\mathbb{S}
            is nontrivial. This, and its structure of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+ring+spectrum"} Hopf ring spectrum
            = succeed "." do
              %a{:href => "#StricklandTurner97"} Strickland-Turner 97
          %p More generally,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} }
                  %mo ≔
                  %msub
                    %mi Sym
                    %mi R
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi R
                    %mrow
                      %msup
                        %mo ∨
                        %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  R\{x_1, \cdots, x_n\} \coloneqq Sym_R (R^{\vee^n})
          %p
            is like a
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial
            %a.existingWikiWord{:href => "/nlab/show/algebra+spectrum"} algebra spectrum
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %mi R
                  %mo ∧
                  %msup
                    %mi Σ
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℕ
                    %mo +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  R[x_1, \cdots, x_n] \coloneqq R \wedge \Sigma^\infty(\mathbb{N}_+)
          %p
            where on the right we have the “monoid
            = succeed "-algebra\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+%E2%88%9E-ring"} ∞-group ∞-ring
            construction. There is a canonical comparison homomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} }
                  %mo ⟶
                  %mi R
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  R\{x_1, \cdots, x_n\} \longrightarrow R[x_1, \cdots, x_n]
                  \\,.
          %p
            This is an
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
            (
            %a{:href => "#Khan16"}> Khan 16, prop. 2.7.4
            ).
          %p#OnSuspensionOfGroundRingInIntroduction
            Similarly, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %msup
                    %mi Σ
                    %mi n
                  %mi R
                  %mo ≃
                  %mi R
                  %mo ∧
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} E = \Sigma^n R \simeq R \wedge S^n
            is the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/suspension"} suspension
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectrum
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi Sym
                            %mi R
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Σ
                            %mi n
                          %mi R
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≃
                          %mi R
                          %mo ∧
                          %msub
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %mi k
                                  %mo ∈
                                  %mi ℕ
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mi k
                              %mo{:stretchy => "false"} /
                              %mi Σ
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                              %mo )
                            %mo +
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi R
                          %mo ∧
                          %mrow
                            %mo (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi k
                                %mo ∈
                                %mi ℕ
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %msub
                                  %mi τ
                                  %mi k
                            %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Sym_R(\Sigma^n R)
                  \&amp; \simeq
                  R \wedge \left(
                  \\underset{k \in \mathbb{N}}{\coprod} S^{n k}/\Sigma(k)
                  \\right)_+
                  \\\
                  \&amp; \simeq
                  R \wedge \left(
                  \\underset{k \in \mathbb{N}}{\coprod}
                  (B \Sigma(k))^{n \tau_k}
                  \\right)
                  \\end{aligned}
                  \\,,
          %p
            where on the right we have the
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            of the
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \tau_n
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            to the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma(n)
            %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
            via the canonical
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma(n)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            (see also at
            = succeed ")." do
              %a{:href => "permutation#ClassifyingSpaceAndThomSpace"} symmetric group – Classifying space and Thom space
          %p
            The operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sym
                    %mi R
                %annotation{:encoding => "application/x-tex"} Sym_R
            is of course functorial, and hence any choice of
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi R
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} f_x \colon R \to E
            induces morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∧
                  %mi B
                  %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo +
                  %mo ≃
                  %msubsup
                    %mi Sym
                    %mi R
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msubsup
                    %mi Sym
                    %mi R
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  R \wedge B \Sigma(n)_+ \simeq Sym^n_R(R) \longrightarrow Sym_R^n(E)
                  \\,.
          %p
            These correspond to
            %a.existingWikiWord{:href => "/nlab/show/power+operation"} power operation
            in
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
            (
            %a{:href => "#Rezk10"}> Rezk 10, slide 4
            ).
          %h2#examples Examples
          %h3#spectral_affine_lines Spectral affine lines
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a (
            %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"}> connective
            )
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝔸
                    %mi R
                    %mn 1
                  %mo ≔
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sym
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{A}^1_R \coloneqq Spec( Sym_R(R) )
          %p
            is the
            %a.existingWikiWord{:href => "/nlab/show/spectral+affine+line"} spectral affine line
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#spectral_superpoints Spectral superpoints
          %p
            By the discussion at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectral+super+scheme"} spectral super scheme
            %a.existingWikiWord{:href => "/nlab/show/spectral+scheme"} spectral scheme
            over an
            %a.existingWikiWord{:href => "/nlab/show/even+cohomology+theory"} even
            %a.existingWikiWord{:href => "/nlab/show/periodic+ring+spectrum"} periodic ring spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            as the lift to
            %a.existingWikiWord{:href => "/nlab/show/spectral+geometry"} spectral geometry
            of the concept of ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+schemes"} super schemes
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
            %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+commutative+ring"} spectrum of a commutative ring
            of the graded symmetric algebra on a single odd generator (“
            %a.existingWikiWord{:href => "/nlab/show/ring+of+dual+numbers"}> ring of dual numbers
            ”)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝔸
                    %mi k
                    %mrow
                      %mn 0
                      %mo{:stretchy => "false"} |
                      %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Sym
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{A}_k^{0 \vert 1}
                  \\;\simeq\;
                  Spec( Sym_k (k[1]) )
          %p
            is given by the corresponding
            %a.existingWikiWord{:href => "/nlab/show/spectral+scheme"} spectral scheme
            given by the spectral symmetric algebra on the
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi R
                            %mrow
                              %mn 0
                              %mo{:stretchy => "false"} |
                              %mn 1
                        %mtd
                          %mo ≔
                          %mi Spec
                          %mrow
                            %mo (
                            %msub
                              %mi Sym
                              %mi R
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mi R
                            %mo{:stretchy => "false"} )
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi Spec
                          %mrow
                            %mo (
                            %mi R
                            %mo ∧
                            %msub
                              %mi Sym
                              %mi 𝕊
                            %mo{:stretchy => "false"} (
                            %mi Σ
                            %mi 𝕊
                            %mo{:stretchy => "false"} )
                            %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  R^{0 \vert 1}
                  \&amp;\coloneqq
                  Spec
                  \\left(
                  Sym_R (\Sigma R)
                  \\right)
                  \\\
                  \&amp; \simeq
                  Spec\left(
                  R \wedge Sym_{\mathbb{S}}(\Sigma \mathbb{S})
                  \\right)
                  \\end{aligned}
          %h3#free_algebras
            Free
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_\infty
          %p
            The free
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            generators is the spectrum
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sym
                      %mi R
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi R
                      %mrow
                        %mo ∨
                        %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym_R(R^{\vee n})
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} R\{x_1, \ldots, x_n\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is connective,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_0(R\{x_1, \ldots, x_n\})
            can be identified with the polynomial algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 0
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\pi_0 R)[x_1, \ldots, x_n]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} R\{x_1, \ldots, x_n\}
            satisfies the following universal property: for any other
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔼
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{E}_\infty
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Map
                    %mrow
                      %msubsup
                        %mi Alg
                        %mi R
                        %mrow
                          %msub
                            %mi 𝔼
                            %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ω
                    %mn ∞
                  %mi T
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo ×
                      %mi n
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Map_{Alg_R^{\mathbb{E}_\infty}}(R\{x_1, \ldots, x_n\}, T) \simeq (\Omega^\infty T)^{\times n}.
          %p
            See (
            %a{:href => "#Lurie18"}> Lurie 2018, Notation B.1.1.2
            )
          %h2#references References
          %p
            The symmetric algebra spectrum of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %a.existingWikiWord{:href => "/nlab/show/Hopf+ring+spectrum"} Hopf ring spectrum
            is discussed in
          %ul
            %li#StricklandTurner97
              %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"}> Neil Strickland
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Paul+Turner"} Paul Turner
              = succeed "," do
                %em
                  Rational Morava
                  = succeed "-theory" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %msup
                          %mi S
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} D S^0
              = succeed ")" do
                %a{:href => "http://hopf.math.purdue.edu/Strickland-PTurner/rme.pdf"} pdf
          %p
            Symmetric algebras in the context of
            %a.existingWikiWord{:href => "/nlab/show/power+operation"} power operation
            on
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
            are discussed in
          %ul
            %li#Rezk
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                ,
                %em Power operations in Morava E-theory – a survey
                (2009) (
                %a{:href => "http://www.math.uiuc.edu/~rezk/midwest-2009-power-ops.pdf"}> pdf
                )
            %li#Rezk10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
                %em
                  Power operations in Morava
                  = succeed "-Theory" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                (2010) (
                %a{:href => "http://www.math.uiuc.edu/~rezk/baltimore-2010-power-ops-handout.pdf"}> pdf
                )
            %li#Rezk14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
                ,
                = succeed "," do
                  %em Isogenies, power operations, and homotopy theory
                = succeed ")" do
                  %a{:href => "http://www.math.uiuc.edu/~rezk/rezk-icm-talk-posted.pdf"} pdf
                = succeed ")" do
                  %a{:href => "http://www.math.uiuc.edu/~rezk/rezk-icm-2014-slides.pdf"} pdf
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , examples 3.5.4 in
                %em Elliptic Cohomology I
                (
                %a{:href => "http://www.math.harvard.edu/~lurie/papers/Elliptic-I.pdf"}> pdf
                )
            %li#Lurie18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , notation B.1.1.2 in
                %em Spectral Algebraic Geometry
                (
                %a{:href => "http://www.math.harvard.edu/~lurie/papers/SAG-rootfile.pdf"}> pdf
                )
            %li#Khan16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Adeel+Khan"}> Adeel Khan
                , sections 2.6 and 2.7 of
                %em Brave new motivic homotopy theory I
                (
                %a{:href => "https://arxiv.org/abs/1610.06871"}> arXiv:1610.06871
                )
