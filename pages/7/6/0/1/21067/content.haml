              %path{:d => "M 45.319773 20.821383 L 45.319773 -20.344022 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.989719,0,0,-0.989719,62.982093,45.392477)"}
              %path{:d => "M -2.484643 2.870956 C -2.030758 1.146193 -1.02037 0.333146 0.00185817 0.00161297 C -1.02037 -0.333867 -2.030758 -1.146914 -2.484643 -2.86773 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0,0.989719,0.989719,0,107.834341,65.763786)"}
