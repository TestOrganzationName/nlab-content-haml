          %p
          .num_remark
            %h6 Remark
            %p
              The diagram
              %a.maruku-eqref{:href => "#eq:UnitProperty"} (1)
              is also sometimes called the
              = succeed "," do
                %em unit triangle
              %a.maruku-eqref{:href => "#eq:ActionProperty"} (2)
              is also called the
              %em multiplication square
              or
              = succeed "." do
                %em algebra square
          %h3#homomorphisms Homomorphisms
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,a)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B,b)
            be
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %strong
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            is a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f \colon A \to B
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            which makes the following
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
