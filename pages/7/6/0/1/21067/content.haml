              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "63.257579", "xlink:href" => "#zyMSE5CIhUc39q8mRBlgAX5bLOA=-glyph1-2", :y => "10.030803"}
              %path{:d => "M -45.769046 20.821383 L -45.769046 -20.344022 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.989719,0,0,-0.989719,62.982093,45.392477)"}
              %path{:d => "M -2.484643 2.868697 C -2.030758 1.147881 -1.02037 0.334835 0.00185817 -0.000645709 C -1.02037 -0.336126 -2.030758 -1.149172 -2.484643 -2.869989 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0,0.989719,0.989719,0,17.684233,65.763786)"}
