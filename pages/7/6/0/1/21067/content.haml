                %use{:x => "111.314035", "xlink:href" => "#zyMSE5CIhUc39q8mRBlgAX5bLOA=-glyph1-4", :y => "48.816905"}
              %path{:d => "M -33.600978 -33.017283 L 32.220254 -33.017283 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.989719,0,0,-0.989719,62.982093,45.392477)"}
              %path{:d => "M -2.4858 2.86806 C -2.031915 1.147244 -1.021527 0.334197 0.000700842 -0.00128299 C -1.021527 -0.332816 -2.031915 -1.145863 -2.4858 -2.870626 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.989719,0,0,-0.989719,95.108681,78.069043)"}
              %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                %use{:x => "59.476507", "xlink:href" => "#zyMSE5CIhUc39q8mRBlgAX5bLOA=-glyph1-2", :y => "72.672104"}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            formed by
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            and often denoted by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi T
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^T
          %h3#FreeAlgebras Free algebras
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo ,
                  %mi μ
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T,\mu,\eta)
            on a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            is canonically equipped with a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            of the monad. The relevant diagrams commute by the monad axioms.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            \-Algebras of this sort are called
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
                = succeed "-algebras" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \phi \colon X \to Y
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi T
                  %mi X
                  %mo ⟶
                  %mi T
                  %mi Y
                %annotation{:encoding => "application/x-tex"} T \phi \colon T X \longrightarrow T Y
            is evidently a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Y
                %annotation{:encoding => "application/x-tex"} T Y
            arises this way, in general.
          %p However, for any morphism of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ⟶
                  %mi T
                  %mi Y
                %annotation{:encoding => "application/x-tex"}
                  f \colon X \longrightarrow T Y
          %p
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            (called a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed ")," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kleisli+morphism"} Kleisli morphism
          #eq:AlgebraMapInducedByKleisliMorphism.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
                    %mi Y
                  %mo ∘
                  %mi T
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi T
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi T
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi T
                  %mi T
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi μ
                        %mi Y
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi TY
                %annotation{:encoding => "application/x-tex"}
                  \\mu_{Y} \circ T f
                  \\;\colon\;
                  T X
                  \\xrightarrow{\;\; T f  \;\;}
                  T T Y
                  \\xrightarrow{\;\; \mu_Y \;\;}
                  TY
          %p
            %em is
            a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi X
                %annotation{:encoding => "application/x-tex"} T X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Y
                %annotation{:encoding => "application/x-tex"} T Y
            %em do
            arise this way.
          %p
            Moreover, given in addition a morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            of the form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo ⟶
                    %mi T
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} g \colon Y \longrightarrow T Z
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            of the corresponding
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.maruku-eqref{:href => "#eq:AlgebraMapInducedByKleisliMorphism"} (3)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            equals the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kleisli+composition"} Kleisli composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %msub
                    %mo ∘
                    %mi T
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi T
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %mi T
                      %mi g
                  %mi T
                  %mi T
                  %mi Z
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi μ
                        %mi Z
                  %mi T
                  %mi Z
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  g \circ_T f
                  \\;\coloneqq\;
                  X
                  \\xrightarrow{ f }
                  T Y
                  \\xrightarrow{ T g }
                  T T Z
                  \\xrightarrow{ \mu_Z }
                  T Z
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+morphisms"} Kleisli morphisms
            equipped with this
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+composition"} Kleisli composition
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
            and is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a{:href => "Kleisli+category#InTermsOfKleisliMorphisms"} there
            for more).
          %h3#tensor_product Tensor product
          %p
            In the case of a
            %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} commutative monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            , one can define a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+algebras+over+a+commutative+monad"} tensor product of monad algebras
          %h2#examples Examples
          %p Many monads are named after their (free) algebras:
          %ul
            %li
              %p
                The algebras of the
                %em free monoid monad
                on
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/monoids"} monoids
            %li
              %p
                The algebras of the
                %em free commutative monoid monad
                on
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/commutative+monoids"} commutative monoids
            %li
              %p
                The algebras of the
                %em free group monad
                on
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                are groups, and their morphisms are the group homomorphisms.
            %li
              %p …and so on.
          %p
            In these cases, the notion of
            = succeed "," do
              %em free group
            = succeed "," do
              %em free monoid
          %ul
            %li
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
                or
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %a.existingWikiWord{:href => "/nlab/show/action+monad"} action monad
                on
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                are the
                = succeed "-sets," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivariant+maps"} equivariant maps
            %li
              %p
                The example above generalizes to
                %a.existingWikiWord{:href => "/nlab/show/action+monads"} action monads
                given by
                %a.existingWikiWord{:href => "/nlab/show/monoid+objects"} monoid objects
                in a general
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
                on
                %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
                and actions of
                %a.existingWikiWord{:href => "/nlab/show/rings"} rings
                on their
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %li
              %p
                The algebras of the
                %a.existingWikiWord{:href => "/nlab/show/maybe+monad"} maybe monad
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Set
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} (-)_*\colon Set \to Set
            %li
              %p
                The algebras of the
                %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
                monad are the sup-
                %a.existingWikiWord{:href => "/nlab/show/semilattices"}> semilattices
                \.
            %li
              %p
                The algebras of the
                %a.existingWikiWord{:href => "/nlab/show/distribution+monad"} distribution monad
                are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/convex+spaces"} convex spaces
                %a.existingWikiWord{:href => "/nlab/show/probability+monads"} probability monads
                correspond to generalized
                %a.existingWikiWord{:href => "/nlab/show/convex+spaces"} convex spaces
                or
                %a.existingWikiWord{:href => "/nlab/show/conical+spaces"} conical spaces
                (see
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/probability+monad#algebras_expectation_values"} probability monad - algebras
          %h2#generalizations Generalizations
          %p
            An algebra over a monad is a special case of a
            %a.existingWikiWord{:href => "/nlab/show/module+over+a+monad"} module over a monad
            in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
          %p
            The Eilenberg-Moore and Kleisli categories are also special cases of more general 2-dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+constructions"} universal constructions
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+object"} Eilenberg-Moore object
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+object"} Kleisli object
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %strong> algebra over a monad
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/module+over+a+monad"} module over a monad
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+endofunctor"} algebra over an endofunctor
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coalgebra+over+an+endofunctor"} coalgebra over an endofunctor
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+profunctor"} algebra over a profunctor
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-monad"} ∞-algebra over an (∞,1)-monad
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+a+monad"} model structure on algebras over a monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+algebraic+theory"} algebra over an algebraic theory
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-algebraic+theory"} ∞-algebra over an (∞,1)-algebraic theory
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+T-algebra"} homotopy T-algebra
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+T-algebras"} model structure on simplicial T-algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
              %p
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-operad"} ∞-algebra over an (∞,1)-operad
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+an+operad"} model structure on algebras over an operad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"}> Eilenberg-Moore category
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+object"} Eilenberg-Moore object
                %a.existingWikiWord{:href => "/nlab/show/Kleisli+object"} Kleisli object
          %h2#references References
          %h3#general General
          %blockquote
            %p
              See the
              %em
                %a{:href => "monad#References"} References
              at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/monad"} monad
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              , §VI.2 of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Categories+for+the+Working+Mathematician"} Categories for the Working Mathematician
              %strong 5
              Springer (1971) &amp;lbrack;
              %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-4721-8"}> doi:10.1007/978-1-4757-4721-8
              \&amp;rbrack;
          %p An introduction to the basic ideas, which gives some intuition for newcomers, can be found in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Paolo+Perrone"}> Paolo Perrone
              , Chapter 5 of:
              = succeed "," do
                %em Notes on Category Theory with examples from basic mathematics
              = succeed "&rbrack;" do
                %a{:href => "http://arxiv.org/abs/1912.10642"} arXiv:1912.10642
          %h3#ReferencesKleisliStyle Kleisli/extension system-style
          %p
            For monads presented in “
            %a.existingWikiWord{:href => "/nlab/show/extension+system"}> extension system
            ”/“
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+triple"}> Kleisli triple
            ”-form (the way traditionally used for
            %a.existingWikiWord{:href => "/nlab/show/monads+in+computer+science"} monads in computer science
            – i.e. in terms of a “bind”-operation taking
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+maps"} Kleisli maps
            to actual
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            = succeed "&rbrack;" do
              %a{:href => "#Uustalu21Lecture2"} Uustalu (2021), p. 4
          %ul
            %li#MarmolejoWood10
              %p
                %a.existingWikiWord{:href => "/nlab/show/F.+Marmolejo"}> F. Marmolejo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Richard+J.+Wood"} Richard J. Wood
                %em Monads as extension systems – no iteration is necessary
                %a.existingWikiWord{:href => "/nlab/show/TAC"} TAC
                %strong 24
                4 (2010) 84-113 &amp;lbrack;
                %a{:href => "http://www.tac.mta.ca/tac/volumes/24/4/24-04abs.html"}> tac:24-04
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thorsten+Altenkirch"}> Thorsten Altenkirch
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/James+Chapman"} James Chapman
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"} Tarmo Uustalu
                = succeed "," do
                  %em Monads need not be endofunctors
                %strong 11
                1:3 (2015) 1–40 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1412.7148"}> arXiv:1412.7148
                ,
                = succeed "," do
                  %a{:href => "http://www.cs.nott.ac.uk/~txa/publ/jrelmon.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2168/LMCS-11(1:3)2015"} doi:10.2168/LMCS-11(1:3)2015
              %blockquote
                %p
                  (stated in the generality of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/relative+monads"} relative monads
            %li#Uustalu21Lecture2
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tarmo+Uustalu"}> Tarmo Uustalu
                , p. 4 of:
                %em Monads and Interaction Lecture 2
                lecture notes for
                %a{:href => "https://staffwww.dcs.shef.ac.uk/people/G.Struth/mgs21.html"} MGS 2021
                (2021) &amp;lbrack;
                %a{:href => "https://cs.ioc.ee/~tarmo/mgs21/mgs2.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Uustalu-Monads2.pdf", :title => "pdf"} pdf
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/R.+F.+C.+Walters"}> R. F. C. Walters
              , Chapter I of:
              = succeed "," do
                %em A categorical approach to universal algebra
