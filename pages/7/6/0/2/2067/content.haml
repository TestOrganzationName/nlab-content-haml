                    %mo{:stretchy => "false"} (
                    %mi D
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N(C)_{/f} \to N(C)_{/y} \times_{N(D)_{/F(y)}} N(D)_{/F(f)}
            %p
              is an acyclic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are enriched in
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is hom-wise a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(F) : N(C) \to N(D)
                  is an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
              %li
                %p
                  a morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo :
                        %mi x
                        %mo →
                        %mi y
                      %annotation{:encoding => "application/x-tex"} f :x \to y
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} N(C)
                  is an
                  = succeed "-cartesian" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo{:stretchy => "false"} (
                          %mi F
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} N(F)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi a
                                %mo ,
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi C
                                    %mo{:stretchy => "false"} (
                                    %mi a
                                    %mo ,
                                    %mi f
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi C
                                %mo{:stretchy => "false"} (
                                %mi a
                                %mo ,
                                %mi y
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi D
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi a
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi C
                                    %mo{:stretchy => "false"} (
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mi a
                                    %mo{:stretchy => "false"} )
                                    %mo ,
                                    %mi F
                                    %mo{:stretchy => "false"} (
                                    %mi f
                                    %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi D
                                %mo{:stretchy => "false"} (
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi a
                                %mo{:stretchy => "false"} )
                                %mo ,
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        C(a,x) &amp;\stackrel{C(a,f)}{\to}&amp; C(a,y)
                        \\\
                        \\downarrow &amp;&amp; \downarrow
                        \\\
                        D(F(a), F(x)) &amp;\stackrel{C(F(a), F(f))}{\to}&amp;
                        D(F(a), F(y))
                        }
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                  square in
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  equipped with its
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} standard model structure
          .proof
            %h6#proof_4 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.4.1.10
          %h2#properties Properties
          %h3#pullback_along_cartesian_morphisms Pullback along Cartesian morphisms
          .num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi ℰ
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} p : \mathcal{E} \to \mathcal{C}
              a functor, if in a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi g
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi h
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mi k
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\stackrel{f}{\to}&amp; B
                    \\\
                    {}^{\mathllap{g}}\downarrow &amp;&amp; \downarrow^{\mathrlap{h}}
                    \\\
                    C &amp;\stackrel{k}{\to}&amp; D
                    }
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              the two vertical morphisms are vertical with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              (meaning that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Id
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(g) = Id_p(A)
              and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Id
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p(h) = Id(B)
              = succeed "-Cartesian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              square.
          .proof
            %h6#proof_5 Proof
            %p If
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi h
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mi k
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q &amp;\stackrel{}{\to}&amp; B
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{h}}
                    \\\
                    C &amp;\stackrel{k}{\to}&amp; D
                    }
            %p
              is another cone over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi D
                      %mo ←
                      %mi B
                    %annotation{:encoding => "application/x-tex"} C \to D \leftarrow B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi D
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    p(Q)
                    \\\
                    \\downarrow &amp; \searrow
                    \\\
                    p(C) &amp;\stackrel{p(k)}{\to}&amp; D
                    }
                    \\,.
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p(f) = p(k)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q
                    \\\
                    \&amp; \searrow
                    \\\
                    A &amp;\stackrel{f}{\to}&amp; B
                    }
            %p
              which gives a unique filler
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Q \to A
              by the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is Cartesian.
            %p
              But this produces now two fillers – namely the original
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Q \to C
              and the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Q \to A \to C
              just obtained – of the horn
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Q
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mi k
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Q &amp;\to&amp; B
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    C &amp;\stackrel{k}{\to}&amp; D
                    }
            %p over
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi D
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    p(Q)
                    \\\
                    \\downarrow &amp; \searrow
                    \\\
                    p(C) &amp;\stackrel{p(k)}{\to}&amp; D
                    }
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is Cartesian, these two fillers must be equal. This means that the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} Q \to A
              is a cone morphism and unique as such. Hence the original square is a pullback.
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Elephant"} Elephant, lemma 1.3.3
          %h3#cartesian_morphisms_and_equivalences Cartesian morphisms and equivalences
          .num_lemma
            %h6#observation Observation
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is cartesian with respect to the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} C \to *
              precisely if it is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              In particular all
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              morphisms are cartesian.
          %p
            This is trivial to see. The analog statement holds also for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is cartesian with respect to the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} C \to *
              precisely if it is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+quasi-category"} equivalence
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+quasi-category"} equivalence
              precisely if it is
              = succeed "-cartesian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(f)
              is an equivalence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          .proof
            %h6#proof_6 Proof
            %p
              The first statement is a proposition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop 1.2.4.3
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corollary 2.1.2.2
            %p
              The second statement is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.4.1.5
          %h2#related_pages Related pages
          %ul
            %li
              A Cartesian morphism is the special case of a
              %a.existingWikiWord{:href => "/nlab/show/strictly+final+lift"} strictly final lift
              of a structured
              %a.existingWikiWord{:href => "/nlab/show/sink"} sink
              when the sink is a singleton.
          %h2#references References
          %p Original reference:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              , §VI.5 of:
              %em Revêtements Étales et Groupe Fondamental - Séminaire de Géometrie Algébrique du Bois Marie 1960/61
              (
              %a.existingWikiWord{:href => "/nlab/show/SGA+1"}> SGA 1
              ) , LNM
              %strong 224
              Springer (1971) &amp;lbrack;updated version with comments by M. Raynaud:
              = succeed "&rbrack;" do
                %a{:href => "http://arxiv.org/abs/math/0206203"} arxiv.0206203
          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Angelo+Vistoli"}> Angelo Vistoli
              , Def. 3.1 in:
              = succeed "," do
                %em Grothendieck topologies, fibered categories and descent theory
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Fundamental+algebraic+geometry+--+Grothendieck%27s+FGA+explained"} Fundamental algebraic geometry – Grothendieck's FGA explained
              = succeed "," do
                %strong 123
              = succeed "," do
                %a{:href => "https://bookstore.ams.org/surv-123-s"} ISBN:978-0-8218-4245-4
              = succeed "&rbrack;" do
                %a{:href => "http://arxiv.org/abs/math/0412512"} math.AG/0412512
          %p For the 1-categorical case see for instance section B1.3 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
          %p
            The
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            See also the references at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
