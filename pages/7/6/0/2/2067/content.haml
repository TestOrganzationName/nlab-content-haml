                        %mo{:stretchy => "false"} /
                        %mi y
                    %msub
                      %mo ×
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi D
                        %msub
                          %mo{:stretchy => "false"} )
