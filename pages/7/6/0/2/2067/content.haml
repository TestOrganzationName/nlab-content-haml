            %p exists.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT remark 2.4.1.4
          .num_remark
            %h6#remark_2 Remark
            %p
              This means that an
              %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              with a collection of
              = succeed "-cartesian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              specified satisfies the same kind of condition as a
              %em
                %a.existingWikiWord{:href => "/nlab/show/right+fibration"} right fibration
              , the only difference being that not
              %em all
              right outer horns inclusion are required to have lifts, but only those where the last edge of the horn maps to a cartesian morphism.
            %p
              In this sense a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              is a generalization of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+fibration"} right fibration
          .num_prop
            %h6#proposition_4 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              is an
              %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
              of
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              then a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f : x \to y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "-Cartesian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi X
                            %mo{:stretchy => "false"} (
