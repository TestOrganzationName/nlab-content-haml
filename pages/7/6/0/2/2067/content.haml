                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f : x \to y
              as above, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inner+fibration"} inner fibration
              = succeed "-cartesian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \geq 2
              and all right outer
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mi n
                                %mo −
                                %mn 1
                                %mo ,
                                %mi n
                                %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mi f
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Delta^{\{n-1,n\}}
                    \\\
                    \\downarrow &amp; \searrow^f
                    \\\
                    \\Lambda[n]_n &amp;\to&amp; X
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \\Delta[n] &amp;\to&amp; Y
                    }
            %p
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Lambda[n]_n
              the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Δ
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mi n
                                %mo −
                                %mn 1
                                %mo ,
                                %mi n
                                %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mi f
                        %mtr
                          %mtd
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi n
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mi σ
                            %mo ↗
