                                  %mn 2
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      Obj(X/f) =
                      \\left\{
                      
                      \\array{
                      \&amp;&amp; a
                      \\\
                      \&amp;\swarrow &amp;&amp; \searrow
                      \\\
                      x_1 &amp;&amp;\stackrel{f}{\to}&amp;&amp; x_2
                      }
                      \\right\}
              %p
                are objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                equipped with morphisms to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x_1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x_2
                such that the obvious triangle commutes, and whose morphisms are morphisms between these tip objects such that all diagrams in sight commute.
            %li
              %p
                similarly for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} /
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Y/p(f)
          .num_prop
            %h6#proposition Proposition
            %p
              The condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi Mor
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f \in Mor X
              is a Cartesian morphism with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} p : X \to Y
              is equivalent to the condition that the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi f
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mrow
                      %msub
                        %mi x
                        %mn 2
                    %msub
                      %mo ×
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} /
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 2
                          %mo{:stretchy => "false"} )
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\phi : X/f \to X/{x_2} \times_{Y/{p(x_2)}} Y/p(f)
            %p
              into the (strict)
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the obvious projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mrow
                      %msub
                        %mi x
                        %mn 2
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X/{x_2} \to Y/p(x_2)
              along the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y/p(f) \to Y/p(x_2)
              induced by the commutativity of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi f
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mn 2
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mrow
                              %msub
                                %mi x
                                %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} /
                            %mrow
                              %mi p
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi x
                                %mn 2
                              %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X/f &amp;\stackrel{\phi_2}{\to}&amp; Y/p(f)
                    \\\
                    {}^{\mathllap{\phi_1}}\downarrow &amp;&amp; \downarrow
                    \\\
                    X/{x_2} &amp;\to&amp; Y/{p(x_2)}
                    }
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/k-surjective+functor"} surjective equivalence
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of categories.
          .proof
            %h6#proof Proof
            %p
              It is immediate to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              being an isomorphism of categories is equivalent to the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a Cartesian morphism. We discuss that just the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a surjective equivalence already implies that it is an isomorphism of categories.
            %p
              So assume now that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a surjective equivalence.
            %p Notice that objects in the pullback category are compatible pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi a
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %msub
                                  %mi x
                                  %mn 1
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mi f
                              %mtd
                              %mtd
                                %msub
                                  %mi x
                                  %mn 2
                        %mo )
                      %mo ∈
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} /
                        %mrow
                          %msub
                            %mi x
                            %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi b
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mi p
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi x
                                  %mn 1
                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi p
                                    %mo{:stretchy => "false"} (
                                    %mi f
                                    %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mi p
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi x
                                  %mn 2
                                %mo{:stretchy => "false"} )
                        %mo )
                      %mo ∈
                      %mi Y
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\left(
                    \\array{
                    \&amp;&amp; a
                    \\\
                    \&amp;&amp;&amp; \searrow
                    \\\
                    x_1 &amp;&amp;\stackrel{f}{\to}&amp;&amp; x_2
                    }
                    \\right) \in X/_{x_2}
                    \\;\;\;\;\;\;\,,\;\;\;\;\;\;
                    \\left(
                    \\array{
                    \&amp;&amp; b
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    p(x_1) &amp;&amp;\stackrel{p(f)}{\to}&amp;&amp; p(x_2)
                    }
                    \\right)
                    \\in Y/p(f)
                    \\right)
                    \\,.
            %p
              We have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
