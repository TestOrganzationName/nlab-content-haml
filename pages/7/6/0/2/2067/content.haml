            %p exists.
          %p
          #WeakCartesianMorphisms.num_remark
            %h6 Remark
            %p
              %strong (weak/local Cartesian morphisms)
              %br/
              There is a weaker universal property, originally devised by Grothendieck and Gabriel, where one requires the above lifting property only for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo =
                      %msub
                        %mi id
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi x
                            %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u = id_{p(x_1)}
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/locally+Cartesian+morphisms"} locally Cartesian morphisms
              = succeed "," do
                %em Cartesian
              = succeed "." do
                %em weak Cartesian
              %a.existingWikiWord{:href => "/nlab/show/fibered+categories"} fibered categories
              the notion of weak Cartesian morphisms already coincides with that of actual Cartesian morphisms.
            %p
              Equivalently, a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %msup
                      %mi x
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} f:x\to x^\prime
              is called
              %em
                locally
                = succeed "-Cartesian" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              (relative to a functor
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\to Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi pf
                    %mo :
                    %msub
                      %mi X
                      %mi pf
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_{pf}:X_{pf}\to \mathbf{2}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi pf
                  %annotation{:encoding => "application/x-tex"} X_{pf}
              is the (homotopy) pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              along the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi pf
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} c_{pf}:\mathbf{2}\to Y
              classifying the arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi pf
                    %mo :
                    %mi px
                    %mo →
                    %msup
                      %mi px
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} pf:px\to px^\prime
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          .num_defn
            %h6#definition_3 Definition
            %p
              %strong (Grothendieck fibration)
            %p
              If for every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and every lift of its target there is at least one lift which has as its target the chosen one and is a
              = succeed "-cartesian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a
              %strong fibered category
              (also called
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            %ul
              %li
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/prefibered+category"} prefibered category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                and every lift of its target there is at least one lift through
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                which has as its target the chosen one and is a
                = succeed "-cartesian" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %p
              %em and
            %ul
              %li
                the composition of every two composable
                = succeed "-cartesian" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "-cartesian" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
          %h4#CartInOrdCatReformulation Reformulations
          %p
            We discuss equivalent reformulations of the above definition of Cartesian morphism that lend themselves better to generalization to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
          %p For the following, we need this notation: let
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X/x_2
                by the
                %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                over the object
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} x_2
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Y/p(x_2)
                the corresponding
                %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                over
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p(x_2)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi f
                    %annotation{:encoding => "application/x-tex"} X/f
                the category whose objects
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi a
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mo ↘
