                                %mi p
                        %mtr
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi N
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Delta^{\{1,2\}}
                    \\\
                    \\downarrow &amp; \searrow^f
                    \\\
                    \\Lambda_2[2] &amp;\to&amp; N(X)
                    \\\
                    \\downarrow &amp;{}^\sigma\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \\Delta[2] &amp;\to&amp; N(Y)
