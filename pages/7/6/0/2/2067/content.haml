                %annotation{:encoding => "application/x-tex"} D
            be
            %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+categories"} simplicially enriched categories
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F : C \to D
            a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
          .num_defn
            %h6#definition_6 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f : x \to y \in C
              is
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                \-cartesian
              if it is so under the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo :
                    %mi sSet
                    %mi Cat
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} N : sSet Cat \to sSet
              in the sense of quasi-categories above, i.e. if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi f
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} )
