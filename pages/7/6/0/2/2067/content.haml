          .proof
            %h6#proof_2 Proof
            %p
              The definition of being
              = succeed "-cartesian" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(-, x)
              classifies the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+fibration"} right fibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi x
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_{/x} \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y(p-, p(x))
              classifies the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y_{/p(x)} \to Y
              along
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} ↓
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} (p \downarrow p(x)) \to Y
