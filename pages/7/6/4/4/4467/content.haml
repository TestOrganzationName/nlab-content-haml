              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊲
                    %mi U
                  %annotation{:encoding => "application/x-tex"} a \lhd U
              if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \Diamond a
          %p
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            We interpret the elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            as
            %strong basic opens
            in the formal space. We call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/improper+subset"} entire space
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∩
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \cap b
            the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is
            %strong covered
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            or that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊲
                    %mi U
                  %annotation{:encoding => "application/x-tex"} a \lhd U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is
            %strong positive
            or
            %strong
              %a.existingWikiWord{:href => "/nlab/show/inhabited+subset"} inhabited
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \Diamond a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            equipped with a strict
            %a.existingWikiWord{:href => "/nlab/show/topological+base"} topological base
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p Some immediate points to notice:
          %ul
            %li
              If we drop (1), then the hypothesis of (1) defines an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              which is a
              %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊤
                    %annotation{:encoding => "application/x-tex"} \top
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∩
                    %annotation{:encoding => "application/x-tex"} \cap
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊲
                    %annotation{:encoding => "application/x-tex"} \lhd
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \Diamond
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to be a
              %a.existingWikiWord{:href => "/nlab/show/preset"} preset
              originally, then use (1) as a definition of equality.
            %li
              We can prove that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mo ∩
                    %mo ,
                    %mo ⊤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\cap,\top)
              is a bounded
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
              = succeed "-semilattice," do
                %a.existingWikiWord{:href => "/nlab/show/meet"} meet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \leq b
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ⊲
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} a \lhd \{b\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mo ∩
                    %mo ,
                    %mo ⊤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\cap,\top)
              be a semilattice originally, then let (1) say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \leq b
              whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ⊲
                      %mo{:stretchy => "false"} {
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} a \lhd \{b\}
            %li
              We can prove that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \Diamond a
              holds iff every cover of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is inhabited and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \Diamond a
              fails iff
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ⊲
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} a \lhd \empty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/positivity+predicate"} positivity predicate
          %h2#examples Examples
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be the collection of
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            itself, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∩
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \cap b
            be the literal intersection of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} a, b \in S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⊲
                  %mi U
                %annotation{:encoding => "application/x-tex"} a \lhd U
            if and only
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is literally an
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋄
                  %mi a
                %annotation{:encoding => "application/x-tex"} \Diamond a
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is literally inhabited. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo ⊤
                  %mo ,
                  %mo ∩
                  %mo ,
                  %mo ⊲
                  %mo ,
                  %mo ⋄
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S,\top,\cap,\lhd,\Diamond)
            is a formal topology.
          %p
            The above example is impredicative (since the collection of open subsets is generally large), but now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a
            %a.existingWikiWord{:href => "/nlab/show/base+for+the+topology"} base for the topology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which is strict in the sense that it is closed under finitary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo ⊤
                  %mo ,
                  %mo ∩
                  %mo ,
                  %mo ⊲
                  %mo ,
                  %mo ⋄
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S,\top,\cap,\lhd,\Diamond)
            is a formal topology.
          %p
            More generally, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be a
            %a.existingWikiWord{:href => "/nlab/show/subbase"} subbase
            for the topology of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be the
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoid
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/finite+lists"} finite lists
            of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (so this example is not strictly finitist), modulo the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            by which two lists are identified if their
            %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
            are equal. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/empty+list"} empty list
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∩
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \cap b
            be the
            %a.existingWikiWord{:href => "/nlab/show/concatenation"} concatenation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⊲
                  %mi U
                %annotation{:encoding => "application/x-tex"} a \lhd U
            if the intersection of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is contained in the
            %a.existingWikiWord{:href => "/nlab/show/union"} union
            of the intersections of the elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋄
                  %mi a
                %annotation{:encoding => "application/x-tex"} \Diamond a
            if the intersection of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is inhabited. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %mo ⊤
                  %mo ,
                  %mo ∩
                  %mo ,
                  %mo ⊲
                  %mo ,
                  %mo ⋄
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S,\top,\cap,\lhd,\Diamond)
            is a formal topology.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be an
            %a.existingWikiWord{:href => "/nlab/show/accessible+locale"} accessible locale
            generated by a
            %a.existingWikiWord{:href => "/nlab/show/posite"} posite
            whose underlying
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a (meet)-
            %a.existingWikiWord{:href => "/nlab/show/semilattice"}> semilattice
            \. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊤
                %annotation{:encoding => "application/x-tex"} \top
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∩
                %annotation{:encoding => "application/x-tex"} \cap
            be as in the semilattice structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ⊲
                  %mi U
                %annotation{:encoding => "application/x-tex"} a \lhd U
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            contains a basic cover (in the posite structure on
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
