              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dg-algebra"} formal dg-algebra
