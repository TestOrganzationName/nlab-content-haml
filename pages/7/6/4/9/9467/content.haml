                  %mn 0
                %annotation{:encoding => "application/x-tex"} f_\infty(x) = 0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo &lt;
