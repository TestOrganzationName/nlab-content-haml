                  %mn 0
                %annotation{:encoding => "application/x-tex"} f_n(0) = 0
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo &lt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} x \lt 0
            and letting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
