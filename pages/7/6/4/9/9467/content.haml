            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} x \geq 1
          %p Another counterexample is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi n
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi x
                      %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} f_n(x) \coloneqq \exp ({-n {|x|}}) .
          %p
            (The
            %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
            is here only to handle negative values of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %a.existingWikiWord{:href => "/nlab/show/analytic+function"} analytic
            on
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} ]0,\infty[
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
