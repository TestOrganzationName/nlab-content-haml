                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|f_\infty(x + h) - f_n(x + h)|}
              is infinitesimal whenever
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mi N
                    %annotation{:encoding => "application/x-tex"} n \geq N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    {|f_\infty(x + h) - f_\infty(x)|}
                    \\leq {|f_\infty(x + h) - f_n(x + h)|} + {|f_n(x + h) - f_n(x)|} + {|f_n(x) - f_\infty(x)|}
            %p
              is also infinitesimal whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n \geq N
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is infinitesimal. Fixing any such
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} f_\infty
              is continuous.
          %p
            (To check that these are valid, one must know the nonstandard formulations of uniform convergence and equicontinuity that are used; but they are correct. Specifically, a sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            of functions converges uniformly to a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} f_\infty
            iff, for every hyperreal number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} f(x) = (f_n(x))_n
            of hyperreal numbers converges to the hyperreal number
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\infty(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is equicontinuous at a real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            iff, for every hyperinteger
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                %annotation{:encoding => "application/x-tex"} f_n
            is continuous at
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p On the other hand, in the light of nonstandard analysis, we can also reevaluate Cauchy's original claim. Cauchy himself, when confronted with counterexamples such as the Fourier series, denied that the sequence of functions converged everywhere. One interpretation of this is that it fails to converge at some nonstandard points. By this analysis, Cauchy's notion of convergence everywhere is our modern notion of uniform convergence, not pointwise convergence, and his theorem is true (and his proof correct, even if less detailed than one might like).
          %h2#lakatoss_view Lakatos's view
          %p
            In his experimental textbook
            = succeed "," do
              %em
                %span.newWikiWord
                  Proofs and Refutations
                  %a{:href => "/nlab/new/Proofs+and+Refutations"} ?
            %span.newWikiWord
              Imre Lakatos
              %a{:href => "/nlab/new/Imre+Lakatos"} ?
            used Cauchy's sum theorem to motivate the concept of uniform convergence. Two years later, he partially reevaluated his discussion in light of the question of what Cauchy's conception of the continuum was.
          %p
            According to Lakatos, it is ahistorical to interpret Cauchy's 1821 result using either Weierstrass's epsilontics or Robinson's nonstandard analysis. Cauchy did not mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_n(x)
            converges (in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %em variable
            real number. In particular, when discussing the Fourier series
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 1
                    %mn ∞
                  %mfrac
                    %mrow
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi k
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \sum_{k = 1}^\infty \frac{\sin(k x)}{k} ,
          %p Cauchy states (in 1853) that the sequence
          #eq:FourierPS.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 1
                    %mi n
                  %mfrac
                    %mrow
                      %mi sin
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi k
                %annotation{:encoding => "application/x-tex"} \sum_{k = 1}^n \frac{\sin(k x)}{k}
          %p
            of partial sums fails to converge when
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                  %annotation{:encoding => "application/x-tex"} x = 1/n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is a variable whose value depends on the position in the sequence! Such a claim is hard to interpret in an epsilontic framework; but in a nonstandard framework, it simply means that for some particular infinite values of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and infinitesimal values of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            (namely those for which
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                  %annotation{:encoding => "application/x-tex"} x = 1/n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            (which is the value of the partial sum at
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %msub
                      %mi lim
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x = \lim_n (1/n) = 0
          %p
            If we (still arguably ahistorically) interpret convergence to mean to that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_n(x_n)
            converges (in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi n
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} (x_n)_n
            of real numbers, then this is equivalent (given that each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                %annotation{:encoding => "application/x-tex"} f_n
            is continuous) to uniform convergence, and Cauchy's result would again be true and his argument would be (when formalised with either epsilontics or nonstandard analysis) valid.
          %p
            On the other hand (and this goes beyond what Lakatos wrote), one way to interpret Cauchy's claim that
            %a.maruku-eqref{:href => "#eq:FourierPS"} (1)
            fails to converge when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi n
                %annotation{:encoding => "application/x-tex"} x = 1/n
            is, using nonstandard analysis, simply that for any particular infinite value of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and using the infinitesimal value
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                  %annotation{:encoding => "application/x-tex"} x = 1/n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            (which is the value of the infinite sum at
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %msub
                      %mi lim
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x = \lim_n (1/n) = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo +
                  %mi h
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_n(c+h)
            is infinitely close to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_\infty(c)
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is infinite and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            is infinitesimal (for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            real), which again is equivalent (given continuity of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n
            %a.maruku-ref{:href => "#uniform"}
            anyway.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Cauchy%27s+theorems"} Cauchy's theorems
          %h2#references References
          %p The original sum theorem is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Augustin+Cauchy"} Augustin Cauchy
              (1821).
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cours+d%27Analyse"} Cours d'Analyse
          %p Cauchy's most thorough defence of the theorem against critics is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Augustin+Cauchy"} Augustin Cauchy
              (1853). Note sur les séries convergentes dont les divers termes sont des fonctions continues d'une variable réelle ou imaginaire, entre des limites données.
          %p The reconstruction in terms of nonstandard analysis is in the historical appendix to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Abraham+Robinson"} Abraham Robinson
              (1966).
              = succeed "." do
                %em Nonstandard Analysis
          %p Lakatos's discussion forms Chapter 3 of
          %ul
            %li
              %span.newWikiWord
                Imre Lakatos
                %a{:href => "/nlab/new/Imre+Lakatos"} ?
              (1978).
