            is continuous; the pointwise limit is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
