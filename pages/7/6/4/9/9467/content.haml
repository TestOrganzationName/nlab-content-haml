                    %mi x
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x \ne 0
          %h2#proofs Proofs
          %p Here is Cauchy's argument:
          .proof
            %h6#proof Proof?
            %p
              At any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo +
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo +
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi f
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi f
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {|f_\infty(x + h) - f_\infty(x)|}
                    \= {|f_\infty(x + h) - f_n(x + h) + f_n(x + h) - f_n(x) + f_n(x) - f_\infty(x)|}
                    \\leq {|f_\infty(x + h) - f_n(x + h)|} + {|f_n(x + h) - f_n(x)|} + {|f_n(x) - f_\infty(x)|}
                    \.
            %p
              As
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              becomes infinite and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              becomes infinitesimal, all of the terms on the right become infinitesimal (respectively, because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              converges to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} f_\infty
              at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo +
                      %mi h
                    %annotation{:encoding => "application/x-tex"} x + h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f_n
              is continuous at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              converges to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} f_\infty
              at
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} f_\infty
              is continuous at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            Nowadays, we'd say that a variable approaches zero rather than that it becomes infinitesimal. If we interpret this argument in modern analysis, then the proof is flawed, because (the lower bound for)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            depends on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            in the first term, while (the upper bound for the absolute value of)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            depends on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in the second term; they cannot be chosen simultaneously.
          %p
            Analysing this argument, Philipp von Seidel (first, and others afterwards) realised that it could be fixed if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            converges to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} f_\infty
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/uniform+convergence"} uniformly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is independent of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            independent of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
