            %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
            of an
            %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
