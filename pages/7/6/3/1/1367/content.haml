          #PresentationByModelStructuresOnFunctors.num_prop
            %h6 Proposition
            %p This canonical morphism
            #eq:TheNerveComparisonEquivalence.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo ∘
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo →
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi Func
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo ∘
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    N\big([C,A]^\circ\big)
                    \\xrightarrow{\phantom{---}}
                    Func\big(
                    N(C)
                    ,\,
                    N(A^\circ)
                    \\big)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28infinity%2C1%29-categories"}
                equivalence of
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              in that it is a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
          This is
          = succeed "." do
            %a{:href => "#Lurie"} Lurie (2009), Prop. 4.2.4.4
          %p
          .proof
            %h6 Proof
            %p
              The strategy is to show that the objects on both sides are both
              %a.existingWikiWord{:href => "/nlab/show/exponential+objects"} exponential objects
              in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Joyal+model+structure"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi sSet
                          %mi Joyal
                      %annotation{:encoding => "application/x-tex"} sSet_{Joyal}
              = succeed "," do
                %a{:href => "adjoint+functor#UniquenessOfAdjoints"} uniqueness of adjoints
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              in the homotopy category, which finally is equivalent to the statement to be proven.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo ∘
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ≃
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo ∘
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func\big(N(C), N(A^\circ)\big) \simeq \big(N(A^\circ)\big)^{N(C)}
              is an
              %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
              in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              is pretty immediate.
            %p
              That the left hand is an isomorphic exponential follows from
              = succeed "," do
                %a{:href => "#Lurie"} Lurie 09, corollary A.3.4.12
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              %a.existingWikiWord{:href => "/nlab/show/sSet-enriched+categories"} sSet-enriched categories
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as above, we have that
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              with the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              induces a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mi Cat
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi D
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo ∘
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mi Cat
                        %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi C
                    %mo ×
                    %mi D
                    %mo ,
                    %msup
                      %mi A
                      %mo ∘
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Ho(sSet Cat)}\big(D, [C,A]^\circ\big)
                    \\xrightarrow{\simeq}
                    Hom_{Ho(sSet Cat)}\big(C \times D, A^\circ\big)
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mi Cat
                      %mi Bergner
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sSet
                      %mi Joyal
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(sSet Cat_{Bergner}) \simeq Ho(sSet_{Joyal})
              this identifies also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo ∘
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} N\big([C,A]^\circ\big)
              with the exponential object in question.
          %blockquote
            %p The following proof is fresh, still needs double-checking.
