                      %mo □
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sigma \circ \big( \square^{n} \otimes y(p) \big) : \square^{n+1} \rightarrow \square^{n} \rightarrow X
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
