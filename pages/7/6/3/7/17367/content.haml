          %h2#a_relation_on_the_cubes_of_a_cubical_set_with_trivial_boundary
            A relation on the
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            We make use of the notation established at
            %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+cubes"} category of cubes
          %p
            Throughout this page, we shall let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %msup
                    %mo □
                    %mn 0
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x : \square^{0} \rightarrow X
            be a
            = succeed "-cube" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n \geq 0
            be an integer.
          .num_defn
            %h6#notation Notation
            %p
              We denote by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z_{n}(X,x)
              the set of
              = succeed "-cubes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %msup
                      %mo □
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \sigma : \square^{n} \rightarrow X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with the property that the following diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Set
                      %mrow
                        %msup
                          %mo □
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
              commutes for every integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
              and every integer
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi ϵ
                      %mo ≤
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \leq \epsilon \leq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mo □
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mi p
                          %mtd
                            %msup
                              %mo □
                              %mn 0
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi y
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi I
                                  %mrow
                                    %mi i
                                    %mo −
                                    %mn 1
                                %mo ⊗
                                %msub
                                  %mi i
                                  %mi ϵ
                                %mo ⊗
                                %msup
                                  %mi I
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mi i
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi x
                        %mtr
                          %mtd
                            %msup
                              %mo □
                              %mi n
                          %mtd
                            %munder
                              %mo →
                              %mi σ
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\square^{n-1} &amp; \overset{p}{\rightarrow}        &amp; \square^{0} \\
                    \\mathllap{y(I^{i-1} \otimes i_{\epsilon} \otimes I^{n-i})} \downarrow &amp;                                   &amp; \downarrow \mathrlap{x} \\
                    \\square^{n} &amp; \underset{\sigma}{\rightarrow} &amp; X
                    }
          #NotationEquivalenceRelation.num_defn
            %h6#notation_2 Notation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
              be the relation on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z_{n}(X,x)
              given by identifying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma_{0}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma_{1}
              if there is an
              = succeed "-cube" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msup
                      %mo □
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} h : \square^{n+1} \rightarrow X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that the following diagrams in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Set
                      %mrow
                        %msup
                          %mo □
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
              commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
