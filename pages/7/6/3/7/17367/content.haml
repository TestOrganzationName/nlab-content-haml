                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mi h
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\square^{n}  &amp; \overset{\square^{n} \otimes i_{1}}{\rightarrow}    &amp; \square^{n+1} \\
                    \&amp; \underset{\sigma_{1}}{\searrow} &amp; \downarrow h \\
                    \&amp;                         &amp; X
                    }
            %p
              and such that the following diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Set
                      %mrow
                        %msup
                          %mo □
                          %mi op
                  %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
              commutes for every integer
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi i
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
              and every integer
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi ϵ
                      %mo ≤
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 0 \leq \epsilon \leq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mo □
