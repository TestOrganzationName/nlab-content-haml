                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\square^{n} &amp; \overset{p}{\rightarrow}        &amp; \square^{0} \\
                    \\mathllap{y(I^{i-1} \otimes i_{\epsilon} \otimes I^{n+1-i})} \downarrow &amp;                                   &amp; \downarrow \mathrlap{x} \\
                    \\square^{n+1} &amp; \underset{\sigma}{\rightarrow} &amp; X
                    }
          .num_defn
            %h6#remark Remark
            %p
              The commutativity of the first two diagrams in Notation
              %a.maruku-ref{:href => "#NotationEquivalenceRelation"}
              asserts that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi n
                    %mo ⊗
                    %msup
                      %mo □
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \square^{n} \otimes \square^{1} \rightarrow X
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Set
                        %mrow
                          %msup
                            %mo □
                            %mi op
                    %annotation{:encoding => "application/x-tex"} \mathsf{Set}^{\square^{op}}
              %span.newWikiWord
                homotopy
                %a{:href => "/nlab/new/cubical+homotopy"} ?
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
