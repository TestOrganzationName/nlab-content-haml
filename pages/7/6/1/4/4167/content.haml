          %h2#algebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} L_\infty
            \-algebras
          %p
            The notion of
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
            is something that naturally arises in
            %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation theory
            and in
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            problems.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
            is a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msup
                    %mi V
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mover
                    %mo →
                    %mi d
                  %msup
                    %mi V
                    %mn 0
                  %mover
                    %mo →
                    %mi d
                  %msup
                    %mi V
                    %mn 1
                  %mover
                    %mo →
                    %mi d
                  %msup
                    %mi V
                    %mn 2
                  %mo →
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to
                  V^{-1}
                  \\stackrel{d}{\to}
                  V^0
                  \\stackrel{d}{\to}
                  V^1
                  \\stackrel{d}{\to}
                  V^2
                  \\to
                  \\cdots
          %p and is equipped with a bracket operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %msup
                    %mi V
                    %mi i
                  %mo ⊗
                  %msup
                    %mi V
                    %mi j
                  %mo →
                  %msup
                    %mi V
                    %mrow
                      %mi i
                      %mo +
                      %mi j
                %annotation{:encoding => "application/x-tex"}
                  [-,-] : V^i \otimes V^j \to V^{i + j}
          %p which is
          %ul
            %li
              %p bilinear
            %li
              %p
                graded antisymmetric:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi deg
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mi deg
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [x,y] = - (-1)^{deg(x) deg(y)} [y,x]
            %li
              %p
                satisfies the graded Jacobi identity
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [x,[y,z]] = [[x,y],z] + (-1)^{deg(x) deg(y)} [y,[x,z]]
            %li
              %p
                is graded Leibnitz:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi d
                        %mi y
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} d[x,y] = [d x,y] + (-1)^{deg(x)} [x, d y]
          %p
            %strong Note
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi deg
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} deg(x)
            is odd, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [x,x]
            need not vanish. (see also
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
          %p
            We can form its
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            (see there for details) of cochains
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %mi L
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CE(L) = (\wedge^\bullet L[1]^*, d)
          %p
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-free+dga"} quasi-free dga
          %p (N.B. In full generality, read this as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mo •
                  %mi L
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo ,
                  %mi δ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  CE(L) = ((\wedge^\bullet L[1])^*, \delta)
          %p and regard
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %mi L
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\wedge^\bullet L[1]
          %p as a graded commutative COalgebra.)
          %p
            The underlying graded algebra we may dually think of as functions on some space, a (so-called)
            = succeed "." do
              %strong formal graded manifold
          %p The total differential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo =
                  %msub
                    %mi δ
                    %mn 1
                  %mo +
                  %msub
                    %mi δ
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\delta = \delta_1 + \delta_2
          %p
            where the first is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            and the second is the dual of the bracket:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mo *
                %annotation{:encoding => "application/x-tex"} [-,-]^*
            extended as a graded derivation.
          %p
            Being a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            on our formal smooth manifold. This is sometimes called an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/NQ-supermanifold"} NQ-supermanifold
          %p
            %strong Definition
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
            (see there) of finite type is the evident generalization of this inroduced by
            %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
            and
            %a.existingWikiWord{:href => "/nlab/show/Tom+Lada"} Tom Lada
          %p what kind of link is needed here??
          %p in the early 1990s:
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
            is equivalent to ( in the degreewise finite dimensional case) a free graded-commutative algebra equipped with a differential of degree +1.
          %p
            Now the differential corresponds to a sequence of
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            this is the differential on the complex, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            this is the binary bracket from above, and then there are higher brackets.
          %h3#morphisms_of_algebras
            Morphisms of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p One can consider two notions of morphisms: strict ones and general ones.
          %p A strict one would be a linear map of the underlying vector spaces that strictly preserves all the brackets.
          %p
            A general definitin of morphisms is: in terms of the dual
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
          %p
            We may also think of this as a morphism of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/NQ-supermanifold"} NQ-supermanifold
          %p
            All this arose in this form probably most vivedly in the
            %span.newWikiWord
              BFV-BRST formalism
              %a{:href => "/nlab/new/BFV-BRST+formalism"} ?
            or in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
          %p
            So in components such a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi L
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} f : L \to K
            of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi k
                  %mo :
                  %msup
                    %mi L
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo ⊗
                  %mi ⋯
                  %msup
                    %mi L
                    %mrow
                      %msub
                        %mi i
                        %mi k
                  %mo →
                  %msup
                    %mi K
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                      %mo +
                      %mi ⋯
                      %mo +
                      %mn 1
                      %mo −
                      %mi k
                %annotation{:encoding => "application/x-tex"}
                  f_k : L^{i_1} \otimes \cdots L^{i_k} \to K^{i_1 + \cdots + 1 - k}
          %p (where the shift in the indices is due to the numbering convention here only).
          %h3#the_homotopical_category_of_algebra
            The homotopical category of
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            We will now describe on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
          %p
            The issue is that the category of
            = succeed "-alghebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            But we can turn it into a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
          %h4#GetzlerCatFibOb A notion of category of fibrant objects
          %p
            This is analogous to (in fact an example of the same general fact) how
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            but do not form among themselves a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            but a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            for more…
          %p
            We now look at the axioms for our category of fibrant objects. It is a slight variant of those in
            %a.existingWikiWord{:href => "/nlab/show/BrownAHT"} BrownAHT
            described at
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            and draws bit from work of Dwyer and Kan.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %ol
            %li
              %p
                There is a
                %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo ⊂
                      %mi C
                    %annotation{:encoding => "application/x-tex"} W \subset C
                whose morphisms are called
                = succeed "," do
                  %strong weak equivalences
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                into a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            %li
              %p
                There is another
                %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ⊂
                        %mi C
                      %annotation{:encoding => "application/x-tex"} F \subset C
                %strong fibrations
                (and those that are also in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
                are called
                = succeed ")" do
                  %strong acyclic fibrations
              %ul
                %li
                  %p
                    it contains all
                    = succeed "s;" do
                      %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                    of a fibration is again a fibration.
                %li
                  %p the pullback of an acyclic fibrations is an acyclic fibration.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                has all
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} *
          %h4#Filtered
            Filtered
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕃
                %annotation{:encoding => "application/x-tex"} \mathbb{L}
            for the category of
            %em filtered
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mo •
                %annotation{:encoding => "application/x-tex"} L^\bullet
            be a
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
          %p a decreasing filtrration on it is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %msup
                    %mi F
                    %mn 0
                  %mi L
                  %mo ⊃
                  %msup
                    %mi F
                    %mn 1
                  %mi L
                  %mo ⊃
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  L = F^0 L \supset F^1 L \supset \cdots
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is the
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            over this
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ≃
                  %munder
                    %mi lim
                    %mo ←
                  %mi L
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi F
                    %mn 1
                  %mi K
                %annotation{:encoding => "application/x-tex"}
                  L \simeq \lim_{\leftarrow} L/F^1 K
          %p
            i.e. if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mi i
                  %mo ∈
                  %msup
                    %mi F
                    %mi i
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x_i \in F^i L)
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} \sum_{i=0}^\infty x_i
            exists
          %p something missing here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi …
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi k
                %annotation{:encoding => "application/x-tex"}
                  [-,- , \dots ]_k
          %p
            has filtration degree 0 if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} k \gt 0
            or filtration degree 1 if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k = 0
          %p
            The differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi x
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 1
                %annotation{:encoding => "application/x-tex"} d x = [x]_1
            has the property
          %p namely?
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gr
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gr(d)
            is a true differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gr
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gr(L)
          %p Morphisms:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi k
                  %mo :
                  %msup
                    %mi L
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"}
                  f_k : L^{\otimes k} \to N
          %p
            where we take
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi k
                %annotation{:encoding => "application/x-tex"} f_k
            to have filtration degree 0 for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} k \gt 0
            and filtration degree 1 for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k = 0
          %p
            So
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gr(f_1)
            is a morphism of complexes from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gr
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gr(L)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gr
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gr(N)
          %p
            %strong Definition
            A morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a
            %strong weak equivalence
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gr
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gr(f)
            is a
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            of complexess.
          %p
            It is a
            %strong fibration
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gr
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} gr(f_1)
            is surjective.
          %p
            %strong Theorem
            This defines the structure of a (Getzler-version of a)
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            as defined above.
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a Getzler-
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"}> category of fibrant objects
            \.
          %p
            Define a new Getzler-category of fibrant objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mi C
                %annotation{:encoding => "application/x-tex"} s C
            as follows:
          %ul
            %li
              %p
                The
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mi C
                    %annotation{:encoding => "application/x-tex"} s C
                are
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                As in the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
                a simplicial objects let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi k
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} M_k X_\bullet
                be the corresponding
                %em matching object
                , defined by the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi M
                                %mi k
                              %msub
                                %mi X
                                %mo •
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi X
                                %mrow
                                  %mi k
                                  %mo −
                                  %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mi k
                                  %mo +
                                  %mn 1
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi X
                                %mrow
                                  %mi k
                                  %mo −
                                  %mn 2
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo (
                                  %mfrac{:linethickness => "0"}
                                    %mrow
                                      %mi k
                                      %mo +
                                      %mn 1
                                    %mrow
                                      %mn 2
                                  %mo )
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi M
                                %mrow
                                  %mi k
                                  %mo +
                                  %mn 1
                              %msub
                                %mi X
                                %mo •
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mi k
                                  %mo +
                                  %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      M_k X_\bullet &amp;\to&amp; (X_{k-1})^{k+1}
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      (X_{k-2})^{\left(k+1 \atop 2\right)}&amp;\to&amp; (M_{k+1} X_\bullet)^{k+1}
                      }
                      \\,.
              %p Here the right vertical morphism is assumed to be a fibration, hence so is the left vertical morphism.
              %p
                So
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi k
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} M_k X_\bullet
                comes with a map
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi k
                        %mo →
                        %msub
                          %mi M
                          %mi k
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_k \to M_k X_\bullet
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} M_{k+1} X_\bullet
                and to continue the induction.
              %p
                So this defines a
                %em Reedy fibrant object
                \.
          %p
            So the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mi C
                %annotation{:encoding => "application/x-tex"} s C
            are Reedy fibrant objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            and morphisms are morphisms of simplicial objects.
          %p
            The weak equivalences in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mi C
                %annotation{:encoding => "application/x-tex"} s C
            are taken to be the levelwise weak equivalences.
          %p
            The fibrations are taken to be the Reedy fibrations, as in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                  %mo →
                  %msub
                    %mi Y
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet \to Y_\bullet
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi k
                  %mo →
                  %msub
                    %mi Y
                    %mi k
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mi M
                        %mi k
                      %msub
                        %mi Y
                        %mo •
                  %msub
                    %mi M
                    %mi k
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_k \to Y_k \times_{M_k Y_\bullet} M_k X_\bullet
            is a fibration for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            So this is just the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mrow
                  %mi op
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi C
                %annotation{:encoding => "application/x-tex"} [\Delta^{}op], C
            on the fibrant objects.
          %p
            There is still a fourth axiom for Getzler-cats of fibrant objects to be stated, which is the existence of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
            %strong path space functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi C
                  %mo →
                  %mi s
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  P : C \to s C
          %p which is such that
          %ol
            %li
              %p
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                the face maps of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"} (P X)_\bullet
                are weak equivalences;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                preserves fibrations and acyclic fibrations;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} (P X)_0
                is
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          %p
            %strong Examples
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the category of
            = succeed "es," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi k
                    %mi X
                    %mo =
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P_k X = sSet(\Delta[k],X)
          %p
            %strong Proposition
          %p
            For our category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℒ
                %annotation{:encoding => "application/x-tex"} \mathcal{L}
            of filtered
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi k
                  %mi L
                  %mo =
                  %mi L
                  %msub
                    %mo ⊗
                    %mi compl
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mi lim
                    %mo ←
                  %mi L
                  %mo ⊗
                  %mi Ω
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi F
                    %mi i
                  %mi L
                  %mo ⊗
                  %mi Ω
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  P_k L = L \otimes_{compl} \Omega^\bullet(\Delta^k)
                  \=
                  \\lim_{\leftarrow} L \otimes \Omega / F^i L \otimes \Omega
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi compl
                %annotation{:encoding => "application/x-tex"} \otimes_{compl}
            denotes the completed tensor product, more commonly denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \otimes
          %p
            %strong Remark
          %p
            We may also speak of cofibrant objects in a (Getzler-)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
          %p
            those objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that for all acyclic fibrations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f : A \to B
            the induced map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(X,A) \to C(X,B)
            is surjective (i.e. those with
            %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
            again acyclic fibrations).
          %h4#maurercartan_elements Maurer-Cartan elements
          %p All the above is designed to make the following come out right.
          %p
            Generally,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(*,X)
            is the set of points (
            %a.existingWikiWord{:href => "/nlab/show/global+element"}> global element
            s) of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            A morphism from the terminal object into an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+element"} Maurer-Cartan element
            in the
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p Such a point is just an element of degree 1 and filtration degree 1 that satisfies the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %mn ∞
                  %mfrac
                    %mn 1
                    %mrow
                      %mi k
                      %mo !
                  %mo{:stretchy => "false"} [
                  %mi ω
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi ω
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi k
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{k= 0}^{\infty} \frac{1}{k!}
                  [\omega, \cdots, \omega]_k = 0
                  \\,.
          %p
            In the case of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi ω
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} [
                  %mi ω
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d \omega + \frac{1}{2}[\omega, \omega] = 0
                  \\,.
          %p
            We have that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %msub
                    %mi P
                    %mi k
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(*, P_k X)
            is a functor from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the category of
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          %p For the category of Kan complexes, it is the identity functor.
          %p
            For filtered
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ↦
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  L \mapsto MC_\bullet(L) = MC(L \otimes \Omega^\bullet(\Delta^\bullet))
          %p
            This functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MC
                    %mo •
                %annotation{:encoding => "application/x-tex"} MC_\bullet
            takes fibrations to fibrations and acyclic fibrations to acyclic fibrations and weak equivalences to weak equivalences.
          %p
            Other applications to sheaves of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            Evaluate on a
            %a.existingWikiWord{:href => "/nlab/show/Cech-nerve"} Cech-nerve
            to get a cosimplicial
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mo •
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mn 0
                  %mo ,
                  %msup
                    %mi L
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^\bullet = (L^0 , L^1, \cdots)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi k
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi i
                        %mi k
                  %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                  %mo ∩
                  %mi ⋯
                  %mo ∩
                  %msub
                    %mi U
                    %mrow
                      %msub
                        %mi i
                        %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^k = \prod_{i_0, \cdots, i_k} L(U_{i_0} \cap \cdots \cap U_{i_k})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tot
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mrow
                      %mi k
                      %mo ∈
                      %mi Δ
                  %msup
                    %mi L
                    %mi k
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Tot(L^\bullet) = \int_{k \in \Delta} L^k \otimes \Omega^\bullet(\Delta^k)
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MC
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %msub
                      %mi ω
                      %mn 0
                    %mo +
                    %msub
                      %mi ω
                      %mn 1
                    %mi d
                    %mi t
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "1em"}
                    %msub
                      %mi ω
                      %mn 1
                    %mo ∈
                    %msup
                      %mi F
                      %mn 1
                    %msup
                      %mi L
                      %mn 1
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "1em"}
                    %msub
                      %mi ω
                      %mn 1
                    %mo ∈
                    %msup
                      %mi F
                      %mn 1
                    %msup
                      %mi L
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %mi t
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "1em"}
                    %msub
                      %mi d
                      %mi L
                    %msub
                      %mi ω
                      %mn 0
                    %mo +
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ω
                      %mn 1
                    %mo ,
                    %msub
                      %mi ω
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mo ,
                    %mspace{:width => "1em"}
                    %msub
                      %mi d
                      %mi dR
                    %msub
                      %mi ω
                      %mn 0
                    %mo +
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ω
                      %mn 1
                    %mo ,
                    %msub
                      %mi ω
                      %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  MC_1(L)
                  \=
                  \\left\{
                  \\omega_0 + \omega_1 d t
                  |\quad
                  \\omega_1 \in F^1 L^1 [t],\quad \omega_1 \in F^1 L^0 [t]
                  , \quad
                  d_L \omega_0 + [\omega_1, \omega_1] = 0,
                  \\quad d_{dR} \omega_0 + [\omega_1, \omega_0] = 0
                  \\right\}
          %p
            Now define the
            %strong Deligne groupoid
            as in Getzler’ integration article.
          %p We find inside the large Kan complex of MC-elements a smaller one that is still equivalent.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi γ
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mrow
                    %mo {
                    %mi ω
                    %mo ∈
                    %msub
                      %mi MC
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi ω
                      %mn 1
                    %mi is
                    %mi constant
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\gamma_1(L)
                  \\left\{
                  \\omega \in MC_1(L) | \omega_1 is constant
                  \\right\}
          %p To get this impose a gauge condition known from homological perturbation theory.
          %p
            A
            %em context
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mover
                    %munder
                      %mo ←
                      %mi g
                    %mover
                      %mo →
                      %mi f
                  %mi M
                %annotation{:encoding => "application/x-tex"}
                  L \stackrel{\overset{f}{\to}}{\underset{g}{\leftarrow}} M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi f
                  %mo =
                  %msub
                    %mi Id
                    %mi L
                %annotation{:encoding => "application/x-tex"}
                  g \circ f = Id_L
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi g
                  %mo =
                  %mi Id
                  %mo −
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi M
                  %mi h
                  %mo +
                  %mi h
                  %msub
                    %mi d
                    %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f \circ g = Id - (d_M h + h d_M)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi h
                  %mo =
                  %mn 0
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi h
                  %mo ∘
                  %mi f
                  %mo =
                  %mn 0
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi h
                  %mo ∘
                  %mi h
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  g \circ h = 0, \; h \circ f = 0, \; h \circ h = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %mi ω
                  %mo ∈
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi h
                  %mi ω
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  MC(L) \simeq \{\omega \in MC(M) | h \omega = 0\}
          %p See Kuranishi’s article in Annals to see where the motivation for all this comes from.
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"}> Jim Stasheff
              \: citation please and how much does
              %strong all
              refer to??
          %p
            %strong Example
            Consider the space of Schouten Lie algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi k
                  %mo =
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mo ∧
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  L^k = \Gamma(X, \wedge^{k+1} T X)
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MC
                    %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} MC_(L)
            is the set of
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson brackets
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi ℏ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}(\hbar)
          %p
            For let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∈
                    %mi MC
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \in MC(L)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(MC_\bullet(L), P)
            is the locally Hamiltonian diffeomorphisms / Hamiltonian diffeos.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_2(MC_\bullet(L), P)
            is the set of Casimir operators of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo &gt;
                  %mn 2
                %annotation{:encoding => "application/x-tex"} k \gt 2
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi MC
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_k(MC_\bullet(L), P)
          %h2#Descent
            Descent for
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            Associated to an
            %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            whose set of
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+element"} Maurer-Cartan element
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MC
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  MC_k(L) = MC( L \otimes \Omega^\bullet(\Delta^k) )
                  \\,.
          %p
            Now assume that we have a
            %a.existingWikiWord{:href => "/nlab/show/sheaf+L-%E2%88%9E+algebras"} sheaf L-∞ algebras
            over a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi α
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_\alpha \to X\}
            be an
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            On
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi k
                  %mo =
                  %msub
                    %mo ⊕
                    %mrow
                      %msub
                        %mi α
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi α
                        %mi k
                  %mi L
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mrow
                      %msub
                        %mi α
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi α
                        %mi k
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L^k = \oplus_{\alpha_0,\cdots, \alpha_k}
                  L(U_{\alpha_0, \cdots, \alpha_k})
                  \\,.
          %p
            The problem of
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            is to glue all this to a single
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} L_\infty
            algebra given by the
            %a.existingWikiWord{:href => "/nlab/show/totalization"} totalization
            %a.existingWikiWord{:href => "/nlab/show/end"} end
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tot
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi k
                  %msup
                    %mi L
                    %mi k
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Tot(L^\bullet) = \int_k L^k \otimes \Omega^\bullet(\Delta^k)
          %p
            and check if that is equivalent to the one assigned to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            We now want to compare the
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Tot
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  MC_\bullet(Tot(L^\bullet))
          %p with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Tot
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi L
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Tot(MC_\bullet(L^\bullet))
          %p Notice that we have an evident map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∫
                    %mi l
                  %msup
                    %mi L
                    %mi l
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi l
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∫
                    %mi l
                  %msup
                    %mi L
                    %mi l
                  %mo ⊗
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi l
                  %mo ×
                  %msup
                    %mi Δ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  MC(\int_l L^l \otimes \Omega^\bullet(\Delta^l) \otimes \Omega^\bullet(\Delta^k) )
                  \\to
                  MC(\int_l L^l \otimes \Omega^\bullet(\Delta^l \times \Delta^k))
          %p
            Hinich shows in a special case that this is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %p
            It is easy to prove it for abelian
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %p
            %strong Theorem
            (Getzler)
          %p This is indeed a homotopy equivalence.
          %p
            %strong Proof
            By E.G.‘s own account he has “a terrible proof” but thinks a nicer one using induction should be possible.
          %h3#gauge_fixing Gauge fixing
          %p Recall the notion of “context” from above, which is a collection of maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mover
                    %munder
                      %mo ←
                      %mi g
                    %mover
                      %mo →
                      %mi f
                  %mi M
                  %mover
                    %mo →
                    %mi h
                  %mi M
                %annotation{:encoding => "application/x-tex"}
                  L \stackrel{\overset{f}{\to}}{\underset{g}{\leftarrow}}
                  M
                  \\stackrel{h}{\to} M
          %p between filtered complex-like things,
          .query
            %p meaning?? more general or complex with additional structure??
          %p satisfying some conditions.
          %p
            We can arrange this such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            imposes a certain gauge condition on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
          %blockquote
            %p I missed some details here…
          %p
            %strong Theorem
          %p With
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mrow
                    %mo {
                    %mi ω
                    %mo ∈
                    %mi MC
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mi h
                    %mi ω
                    %mo =
                    %mn 0
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  MC(M,h) :=
                  \\left\{
                  \\omega \in MC(M) |
                  h \omega = 0
                  \\right\}
          %p we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≃
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  g : MC(M,h) \stackrel{\simeq}{\to} MC(L)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi g
                      %mo ≃
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi MC
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≃
                  %msub
                    %mi MC
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  MC_\bullet(M,h) \stackrel{g \simeq}{\to} MC_\bullet(L)
                  \\stackrel{MC_\bullet(f) \simeq}{\to}
                  MC_\bullet(M)
          %p
            %strong Proof
            Along the lines of Kuranishi’s construction:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 0
                    %mo +
                    %msub
                      %mi d
                      %mi M
                    %mi ω
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mn ∞
                    %mfrac
                      %mn 1
                      %mrow
                        %mi k
                        %mo !
                    %mo{:stretchy => "false"} [
                    %mi ω
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi ω
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi h
                    %mo )
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  h
                  \\left(
                  [-]_0 + d_M \omega + \sum_{k = 1}^\infty
                  \\frac{1}{k!} [\omega, \cdots , \omega]^h
                  \\right)
                  \= 0
                  \\,.
          %p
            So the big
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            It would be nice if in the definition of the MC complex we could replace differential forms on the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/cochain+on+a+simplicial+set"} simplicial cochains
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[n]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊗
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  MC(L \otimes C^\bullet(\Delta^\bullet))
                  \\,.
          %p This would make the construction even smaller.
          .query
            %p What’s the problem?
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is abelian, then this is the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            which features in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
          %p This is true if one takes care of some things. This is part of the above “terrible proof”.
          %p
            Because one can prove that using explicit Eilenberg-MacLane’s homotopies that proove the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+theorem"} Eilenberg-Zilber theorem
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/cochain+on+a+simplicial+set"} simplicial cochains
            we have an equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊗
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi l
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi MC
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊗
                  %msup
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi l
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  MC(
                  L \otimes C^\bullet(\Delta[k] \otimes \Delta[l])
                  )
                  \\to
                  MC( L \otimes C^\bullet(\Delta[k] \times \Delta[l]))
          %h2#references References
          %p
            The discussion of the Deligne groupoid (the
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ezra+Getzler"}> Ezra Getzler
              ,
              %em Lie theory for nilpotent L-infinity algebras
              (
              %a{:href => "http://arxiv.org/abs/math/0404003"}> arXiv:0404003
              )
          %blockquote
            %p A reference for the theorem above seems not to be available yet, but I’ll check.
