                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
                  if
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dim
                          %mrow
                            %mo (
                            %msup
                              %mi X
                              %mi H
                            %mo )
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} dim\left(X^H\right) = 2
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mi dim
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi X
