                    %semantics
                      %mrow
                        %msup
                          %mi Y
                          %mi H
                      %annotation{:encoding => "application/x-tex"} Y^H
                  is
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi X
                            %mi H
                          %mo{:stretchy => "false"} )
