          %p
            (
            %a{:href => "#tomDieck79"}> tom Dieck 79, p. 212 and p. 213
            )
          #RepresentationSphereToRepresentationSphereIsMatchingPair.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V \in RO(G)
              a
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ≔
                    %msup
                      %mi S
                      %mi V
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mo ≔
                    %msup
                      %mi S
                      %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X \coloneqq S^V,\; Y \coloneqq S^V)
            %p
              consisting of two copies of the
              %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is a matching pair of
              = succeed "-spaces," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.maruku-ref{:href => "#MatchingGSpaces"}
          .proof
            %h6#proof Proof
            %p
              First notice that an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              of any
              = succeed "-representation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-representation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W_G(H)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mrow
                          %mo (
                          %msup
                            %mi S
                            %mi V
                          %mo )
                        %mi H
                      %mo ≃
                      %msup
                        %mi S
                        %mrow
                          %mo (
                          %msup
                            %mi V
                            %mi H
                          %mo )
                    %annotation{:encoding => "application/x-tex"} \left(S^V\right)^H \simeq S^{\left( V^H\right)}
              %a.existingWikiWord{:href => "/nlab/show/G-CW-complex"} WH-CW-complexes
              follows because generally
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/G-representation+spheres+are+G-CW-complexes"} G-representation spheres are G-CW-complexes
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              underlying all these fixed loci are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.maruku-ref{:href => "#MatchingGSpaces"}
              are evidently satisfied.
          #RepresentationTorusToRepresentationSphereIsMatchingPair.num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              which arises as the
              %a.existingWikiWord{:href => "/nlab/show/point+group"} point group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≃
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} G \simeq S/N
              of a
              %a.existingWikiWord{:href => "/nlab/show/crystallographic+group"} crystallographic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \subset Iso(E)
              of some
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
