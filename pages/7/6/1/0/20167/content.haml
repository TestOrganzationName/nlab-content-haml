                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi ℍ
                    %annotation{:encoding => "application/x-tex"} S^{\mathbb{H}}
                in
                %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-degree"} RO(G)-degree
                the
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℍ
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}
            %p
