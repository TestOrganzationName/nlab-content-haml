                            %mi ℤ
                            %mo +
                            %mn 1
                          %mtd
                            %mo ≃
                          %mtd
                            %mrow
                              %mo |
                              %mi G
                              %mo |
                            %mo ⋅
                            %mi ℤ
                          %mtd
                            %mo ≃
                          %mtd
                            %mi ℤ
                        %mtr
                          %mtd
                            %mrow
                              %mo [
                              %msup
                                %mi S
                                %mi ℍ
                              %mover
                                %mo ⟶
                                %mi c
                              %msup
                                %mi S
                                %mi ℍ
                              %mo ]
                          %mtd
                            %mo ↦
                          %mtd
