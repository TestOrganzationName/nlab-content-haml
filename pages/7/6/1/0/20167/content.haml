                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ≃
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \pi_{dim(X^H)}\big( Y^H\big) \simeq \mathbb{Z}
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
                  of
                  = succeed ")," do
