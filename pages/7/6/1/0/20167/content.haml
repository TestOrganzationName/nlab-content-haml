                  %a.existingWikiWord{:href => "/nlab/show/n-connected+topological+space"} connected
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi pi
