                    %msup
                      %mi S
                      %mi ℍ
                  %annotation{:encoding => "application/x-tex"} S^{\mathbb{H}}
              in
              %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-degree"} RO(G)-degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi π
                              %mi ℍ
                            %msup
                              %mrow
                                %mo (
                                %msup
                                  %mi S
                                  %mi ℍ
                                %mo )
                              %mrow
                                %mo{:stretchy => "false"} {
