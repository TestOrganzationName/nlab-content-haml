                %p
                  with the previous point this implies (by the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mrow
                            %mi dim
                            %mo{:stretchy => "false"} (
