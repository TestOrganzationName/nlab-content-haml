                    %mo ;
                    %mi Y
                    %mo ≔
                    %msup
                      %mi S
                      %mi E
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    X \coloneqq E/N
                    \\,;
                    Y \coloneqq S^E
                    \\big)
            %p consisting of
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/torus"} torus
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} /
                        %mi N
                      %annotation{:encoding => "application/x-tex"} E/N
                  which is the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  by the given crystallographic sub-lattice
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ⊂
                        %mi E
                      %annotation{:encoding => "application/x-tex"} N \subset E
                  and equipped with the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  descending from that on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  (
                  %a{:href => "crystallographic+group#InducedPointGroupActionOnTorus"}> this Prop.
                  );
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear action
                  of the point group
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %p
              is a matching pair of
              = succeed "-spaces," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.maruku-ref{:href => "#MatchingGSpaces"}
          .proof
            %h6#proof_2 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/torus"} torus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} E/N
              carries the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              for which the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth"} smooth
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi N
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi H
                  %annotation{:encoding => "application/x-tex"} (E/N)^H
              are smooth manifolds (
              %a{:href => "equivariant+differential+topology#FixedLociOfSmoothProperActionsAreSubmanifolds"}> this Prop.
              ). By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivariant+triangulation+theorem"} equivariant triangulation theorem
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/G-CW-complexes"} WH-CW-complexes
            %p
              Moreover, the orientability and connectivity assumptions in Def.
              %a.maruku-ref{:href => "#MatchingGSpaces"}
              are evidently satisfied, using the fact that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi N
                  %annotation{:encoding => "application/x-tex"} E/N
              as well as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi E
                  %annotation{:encoding => "application/x-tex"} S^E
              are modeled on the same linear
              = succeed "-representation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          #EquivariantHopfDegreeTheorem.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equivariant+Hopf+degree+theorem"}> equivariant Hopf degree theorem
                )
            %p
              Given a matching pair of
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X, Y
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MatchingGSpaces"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              to
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degrees
              labeled by
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/isotropy+groups"} isotropy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [f]
              of an equivariant continuou sfunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              to its
              = succeed "-degrees" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.maruku-eqref{:href => "#eq:IntegerDegreeOfEquivariantFunctionOnFixedStrata"} (5)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi deg
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %msub
                              %mi π
                              %mn 0
                            %mi{:mathvariant => "normal"} Maps
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi X
                            %mo ,
                            %mi Y
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mi G
                          %mtd
                            %mover
                              %mo ↪
                              %mphantom
                                %mi AAAA
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi H
                                %mo ∈
                                %msub
                                  %mi Isotr
                                  %mi X
                                %mo{:stretchy => "false"} (
                                %mi G
                                %mo{:stretchy => "false"} )
                            %mi ℤ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi f
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi H
                            %mo ↦
                            %mi{:mathvariant => "normal"} deg
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi f
                              %mi H
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    deg
                    \&amp;\colon&amp;
                    \\pi_0 \mathrm{Maps}\big( X,Y \big)^G
                    \&amp;
                    \\overset{
                    \\phantom{AAAA}
                    }{\hookrightarrow}
                    \&amp;
                    \\underset{
                    { H \in Isotr_X(G) }
                    }{\prod} \mathbb{Z}
                    \\\
                    \&amp;&amp;
                    [f]
                    \&amp;\mapsto &amp;
                    \\big(
                    H \mapsto \mathrm{deg}\big( f^H\big)
                    \\big)
                    }
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injective+function"} injection
            %p
              Moreover, for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi f
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi π
                      %mn 0
                    %mi{:mathvariant => "normal"} Maps
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi G
                  %annotation{:encoding => "application/x-tex"} [f] \in \pi_0 \mathrm{Maps}\big( X,Y \big)^G
              and for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %msub
                      %mi Isotropy
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \in Isotropy_X(G)
            %ol
              %li
                %p
                  the
                  = succeed "-degree" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                  %a.maruku-eqref{:href => "#eq:IntegerDegreeOfEquivariantFunctionOnFixedStrata"} (5)
                  modulo the
                  %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/Weyl+group"} Weyl group
                #eq:DegreeConstraintsInEquivariantHopfDegreeTheorem.maruku-equation
                  %span.maruku-eq-number (6)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mrow
                          %mo (
                          %msup
                            %mi f
                            %mi H
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mi mod
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi W
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mspace{:width => "thickmathspace"}
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mrow
                          %mo{:stretchy => "false"} |
                          %msub
                            %mi W
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mi H
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"}
                        deg\left( f^H\right)
                        \\;mod\;
                        {\vert W_G(H)\vert}
                        \\;\in\;
                        \\mathbb{Z}/{\vert W_G(H)\vert}
                %p
                  is fixed by the degrees
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi f
                          %mi K
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} deg\big( f^K\big)
                  for all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                          %mo &gt;
                          %mi H
                        %annotation{:encoding => "application/x-tex"} K \gt H
              %li
                %p
                  there exists
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} f'
                  with specified degrees
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi K
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo =
                        %mi deg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msup
                          %mi f
                          %mi K
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} deg\big( (f')^K\big) = deg\big( f^K\big)
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo &gt;
                        %mi H
                      %annotation{:encoding => "application/x-tex"} K \gt H
                  and realizing any of the degrees
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi deg
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ′
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi H
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo ∈
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} deg\big( (f')^H\big) \in \mathbb{Z}
                  allowed by the constraint
                  = succeed "." do
                    %a.maruku-eqref{:href => "#eq:DegreeConstraintsInEquivariantHopfDegreeTheorem"} (6)
          %p
            (
            %a{:href => "#tomDieck79"}> tom Dieck 79, 8.4
            )
          %p
            As a special case of the
            %a.existingWikiWord{:href => "/nlab/show/equivariant+Hopf+degree+theorem"} equivariant Hopf degree theorem
            (Theorem
            = succeed ")," do
              %a.maruku-ref{:href => "#EquivariantHopfDegreeTheorem"}
          #EquivariantHomotopyOfSVInRODegreeV.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomotopy"} equivariant cohomotopy
                of
                %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi V
                    %annotation{:encoding => "application/x-tex"} S^V
                in
                %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-degree"} RO(G)-degree
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %msub
                      %mi{:mathvariant => "normal"} Grp
                      %mi{:mathvariant => "normal"} fin
                  %annotation{:encoding => "application/x-tex"} G \in \mathrm{Grp}_{\mathrm{fin}}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi{:mathvariant => "normal"} RO
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} V \in \mathrm{RO}(G)
              %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomotopy"} equivariant cohomotopy
              of the
              %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi V
                  %annotation{:encoding => "application/x-tex"} S^V
              in
              %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-degree"} RO(G)-degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of one copy of the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              for each
              %em proper
              %a.existingWikiWord{:href => "/nlab/show/isotropy+group"} isotropy
              subgroup
              %a.maruku-eqref{:href => "#eq:IsotropySubgroups"} (2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %munder
                      %mo ⊂
                      %mo ≠
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \underset{\neq}{\subset} G
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi V
                    %annotation{:encoding => "application/x-tex"} S^V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              depending on whether
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mi G
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} V^G = 0
              or not:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi π
                              %mi V
                            %msup
                              %mrow
                                %mo (
                                %msup
                                  %mi S
                                  %mi V
                                %mo )
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mn ∞
                                %mo{:stretchy => "false"} }
                                %mo{:stretchy => "false"} /
