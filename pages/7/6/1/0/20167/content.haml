                            %mi V
                          %mo )
                        %mi G
                      %mo =
                      %msup
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \left( S^V\right)^G = S^0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              in the first step of the inductive argument in
              = succeed "," do
                %a{:href => "#tomDieck79"} tomDieck 79, 8.4
            %p
              Alternatively, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
