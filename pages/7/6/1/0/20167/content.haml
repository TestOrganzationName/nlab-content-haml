                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi ℍ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \subset SU(2) \simeq S(\mathbb{H})
              be a non-
              %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
              %a.existingWikiWord{:href => "/nlab/show/finite+subgroup+of+SU%282%29"} finite subgroup of SU(2)
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                    %mo ∈
                    %mi RO
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{H} \in RO(G)
              be the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              of
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by left multiplication with unit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            %p
              Then the bi-pointed
              %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomotopy"} equivariant cohomotopy
              of the
              %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
