                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi W
                          %mi G
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi ℤ
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} e_{H,Y} \;\colon\; W_G(H) \to \mathbb{Z}^\times
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi e
                          %mrow
                            %mi H
                            %mo ,
                            %mi X
                        %mo =
                        %msub
                          %mi e
                          %mrow
                            %mi H
                            %mo ,
                            %mi Y
                      %annotation{:encoding => "application/x-tex"} e_{H,X} = e_{H,Y}
                  , the orientation behaviour
                  %a.maruku-eqref{:href => "#eq:OrientationBehaviour"} (3)
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  agrees at all
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/isotropy+groups"} isotropy groups
            %p For simplicity we also demand that
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mi H
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} dim(X^H) \geq 1
                \.
            %p
              Given a matching pair of
              = succeed "-spaces," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              of all the fixed strata
            #eq:ChoiceOfStratumWiseOrientations.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi or
                              %mrow
                                %mi X
                                %mo ,
                                %mi H
                          %mtd
                            %mo =
                            %mo ±
                            %mn 1
                            %mo ∈
                            %mi ℤ
                            %mo ≃
                            %msup
                              %mi H
                              %mrow
                                %mi dim
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi X
                                  %mi H
                                %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi X
                              %mi H
                            %mo ,
                            %mi ℤ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                            %msub
                              %mi or
                              %mrow
                                %mi Y
                                %mo ,
                                %mi H
                          %mtd
                            %mo =
                            %mo ±
                            %mn 1
                            %mo ∈
                            %mi ℤ
                            %mo ≃
                            %msup
                              %mi H
                              %mrow
                                %mi dim
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi X
                                  %mi H
                                %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi Y
                              %mi H
                            %mo ,
                            %mi ℤ
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    or_{X,H}
                    \&amp; =
                    \\pm 1 \in
                    \\mathbb{Z}
                    \\simeq
                    H^{dim(X^H)}\big(X^H, \mathbb{Z} \big)
                    \\\
                    or_{Y,H}
                    \&amp; =
                    \\pm 1 \in
                    \\mathbb{Z}
                    \\simeq
                    H^{dim(X^H)}\big(Y^H, \mathbb{Z} \big)
                    \\end{aligned}
            %p
              is a
              = succeed "." do
                %em
                  choice of singularity-wise
                  %a.existingWikiWord{:href => "/nlab/show/orientations"} orientations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              %a.existingWikiWord{:href => "/nlab/show/isotropy+group"} isotropy group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
