                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi X
                      %mi H
                    %mo →
                    %msup
                      %mi Y
                      %mi H
                  %annotation{:encoding => "application/x-tex"} f^H \;\colon\; X^H \to Y^H
              has a well-defined
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
            #eq:IntegerDegreeOfEquivariantFunctionOnFixedStrata.maruku-equation
              %span.maruku-eq-number (5)
