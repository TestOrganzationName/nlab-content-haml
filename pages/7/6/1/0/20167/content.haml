                      %mi S
                      %mrow
                        %mn 1
                        %mo +
                        %mi V
                  %annotation{:encoding => "application/x-tex"} S^{1+V} \to S^{1+V}
              which restrict on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
