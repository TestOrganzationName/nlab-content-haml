                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi ℤ
                          %mo ×
                      %annotation{:encoding => "application/x-tex"}
                        e_{H,X}
