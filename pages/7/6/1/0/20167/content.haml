          %h2#statement Statement
          %h3#in_ordinary_homotopy_theory In ordinary homotopy theory
          .num_prop
            %h6#proposition Proposition
            %p
              %strong (Hopf degree theorem)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              be a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Mfd
                  %annotation{:encoding => "application/x-tex"} X \in Mfd
              be a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/orientation"} orientable
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
              classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo [
                      %mi X
                      %mover
                        %mo →
                        %mi c
                      %msup
                        %mi S
                        %mi n
                      %mo ]
                    %mo ∈
                    %msup
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \left[X \overset{c}{\to} S^n\right] \in \pi^n(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are in
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              with the
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} deg(c) \in \mathbb{Z}
              of the representing functions, hence the canonical function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msup
                          %mi S
                          %mi n
                        %mo →
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\pi^n(X)
                    \\underoverset{\simeq}{S^n \to K(\mathbb{Z},n)}{\longrightarrow}
                    H^n(X,\mathbb{Z})
                    \\;\simeq\;
                    \\mathbb{Z}
            %p
              from
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
              to
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          %p
            (
            %a{:href => "#Pontrjagin55"}> Pontrjagin 55, Sec. 9
            , review in
            = succeed "," do
              %a{:href => "#Kosinski93"} Kosinski 93, IX (5.8)
            = succeed ")" do
