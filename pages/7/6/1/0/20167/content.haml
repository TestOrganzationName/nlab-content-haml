          %h3#InEquivariantHomotopyTheory In equivariant homotopy theory
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/equivariant+Hopf+degree+theorem"} equivariant Hopf degree theorem
            – Theorem
            %a.maruku-ref{:href => "#EquivariantHopfDegreeTheorem"}
            below – is a generalization of the Hopf degree theorem to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            = succeed "." do
              %a{:href => "#tomDieck79"} tomDieck 79, 8.4
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomotopy"} equivariant cohomotopy
            of
            %a.existingWikiWord{:href => "/nlab/show/representation+spheres"} representation spheres
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi V
                %annotation{:encoding => "application/x-tex"} S^V
            in
            %a.existingWikiWord{:href => "/nlab/show/RO%28G%29-degree"} RO(G)-degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            (Prop.
            %a.maruku-ref{:href => "#EquivariantHomotopyOfSVInRODegreeV"}
            below).
          %p We need the following list of ingredients and assumptions:
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ⊂
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \subset G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
          #eq:WeylGroup.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi G
                  %mi H
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi N
                    %mi G
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"}
                  W_G H \coloneqq (N_G H) / H
          %p
            for its
            = succeed "." do
              %a{:href => "Weyl+group#in_equivariant_homotopy_theory"} Weyl group
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/G-space"} G-space
          #eq:IsotropySubgroups.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Isotr
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi Sub
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Isotr_X(G) \subset Sub(G)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of the
            %a.existingWikiWord{:href => "/nlab/show/subgroup+lattice"} subgroup lattice
            on the
            %a.existingWikiWord{:href => "/nlab/show/isotropy+groups"} isotropy groups
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            which appear as
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroups"} stabilizer subgroups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Stab
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab_G(x)
            of some point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 1
                  %mo ,
                  %msub
                    %mi H
                    %mn 2
                  %mo ∈
                  %msub
                    %mi Iso
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_1, H_2 \in Iso_X(G)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mn 1
                  %mo &lt;
                  %msub
                    %mi H
                    %mn 2
                %annotation{:encoding => "application/x-tex"} H_1 \lt H_2
            is a strict inclusion, then the
            %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
            differ
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mi H
                          %mn 1
                    %mo &gt;
                    %msup
                      %mi X
                      %mrow
                        %msub
                          %mi H
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} X^{H_1} \gt X^{H_2}
          #MatchingGSpaces.num_defn
            %h6#definition Definition
            %p
              %strong
                (matching pair of
                = succeed "-spaces)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
