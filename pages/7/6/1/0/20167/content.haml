              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/G-CW-complex"} G-CW-complex
              %em matching pair
              if the following conditions are satisfied for all
              %a.existingWikiWord{:href => "/nlab/show/isotropy+groups"} isotropy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ∈
                    %msub
                      %mi Isotr
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \in Isotr_X(G)
              %a.maruku-eqref{:href => "#eq:IsotropySubgroups"} (2)
              of the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/fixed+point+space"} fixed point space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X^H
                  is a
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi G
                        %mi H
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mi G
                        %mi H
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi H
                      %annotation{:encoding => "application/x-tex"} W_G H = (N_G H) / H
                  %a.existingWikiWord{:href => "/nlab/show/G-CW-complex"} -complex
                  of
                  %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
                  %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+cell+complex"} dimension
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
