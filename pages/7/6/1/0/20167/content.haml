                          %mi X
                          %mi H
                        %mo ,
                        %mi ℤ
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mo ≃
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} H^{dim(X^H)}\Big( X^H , \mathbb{Z}\Big) \simeq \mathbb{Z}
                  (
                  %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
                  of the
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/fixed+point+space"} fixed point space
                %p
                  this implies that the
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi G
                        %mo{:stretchy => "false"} (
                        %mi H
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W_G(H)
                  on cohomology induces a
                  %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
                #eq:OrientationBehaviour.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi e
                          %mrow
                            %mi H
