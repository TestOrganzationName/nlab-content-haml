                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mn 3
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi h
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mi r
                          %mtd
                            %msub
                              %mi Y
                              %mn 3
                          %mtd
                            %mo →
                          %mtd
                            %mi coker
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi coker
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi coker
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi coker
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;  ker(f) &amp;\to&amp; ker(g) &amp;\to&amp; ker(h) &amp;\to&amp; 0
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    ker(l) &amp;\to&amp; X_1 &amp;\stackrel{l}{\to}&amp; X_2 &amp;\to&amp; X_3 &amp;\to&amp; 0
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}} &amp;&amp; \downarrow^{\mathrlap{g}} &amp;&amp; \downarrow^{\mathrlap{h}} &amp;&amp; \downarrow
                    \\\
                    0 &amp;\to&amp; Y_1 &amp;\to&amp; Y_2 &amp;\stackrel{r}{\to}&amp; Y_3 &amp;\to&amp; coker(r)
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    0 &amp;\to&amp; coker(f) &amp;\to&amp; coker(g) &amp;\to&amp; coker(h) &amp;&amp;
                    }
                    \\,.
            %p
              By assumption and construction, here all columns are exact and the rows are exact at the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} X_i
              and at the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
