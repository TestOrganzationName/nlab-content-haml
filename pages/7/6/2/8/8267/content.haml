                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mo □
                        %mo ≔
                        %mfrac
                          %mrow
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∂
                              %mi out
                              %mi diag
                            %mo{:stretchy => "false"} )
                          %mrow
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∂
                              %mi in
                              %mi hor
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∂
                              %mi in
                              %mi vert
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A_{\Box}\coloneqq \frac{ker (\partial^{diag}_{out}) }{ im(\partial^{hor}_{in}) + im(\partial^{vert}_{in})}
                  – the “donor” at
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} ker(-)
                  denotes the
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  of a map,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} im(-)
                  the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of a map,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mfrac
                          %mrow
                            %msub
                              %mi N
                              %mn 1
                          %mrow
                            %msub
                              %mi N
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} \frac{N_1}{N_2}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+module"} quotient module
                  of the module
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} N_1
                  by a
                  %a.existingWikiWord{:href => "/nlab/show/submodule"} submodule
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi N
                            %mn 2
                          %mo ↪
                          %msub
                            %mi N
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} N_2 \hookrightarrow N_1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi N
                          %mn 1
                        %mo +
                        %msub
                          %mi N
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} N_1 + N_2
                  the sum of two submodules (i.e., their
                  %a.existingWikiWord{:href => "/nlab/show/join"} join
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
                  of submodules under inclusion).
          #Intramural.num_lemma
            %h6#lemma Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              on representatives in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              induces a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              from the donor of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the receptor of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#DonorReceptor"}
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
              at
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mo □
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msup
                              %mi A
                              %mi vert
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi A
                              %mi hor
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi A
                              %mo □
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; {}^\Box A
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    A^{vert} &amp;&amp;&amp;&amp; A^{hor}
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; A_\Box
                    \\,.
                    }
            %p
              These morphisms are to be called the
              %strong intramural maps
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          %p This is immediate, here is one way to make it fully explicit:
          .proof
            %h6#proof Proof
            %p
              The statement that the top two morphisms exist and are given by the identity on representatives is that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msup
                      %mrow
                      %mo □
                    %mi A
                  %annotation{:encoding => "application/x-tex"} [a] \in {}^\Box A
              is represented by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              also represents an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} A^{hor}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi vert
                    %annotation{:encoding => "application/x-tex"} A^{vert}
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mrow
                        %mo □
                      %mi A
                    %annotation{:encoding => "application/x-tex"} {}^\Box A
              %a.existingWikiWord{:href => "/nlab/show/quotient+module"} quotient module
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mi out
                      %mi vert
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mi out
                      %mi hor
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(\partial^{vert}_{out}) \cap ker(\partial^{hor}_{out})
              means that its elements are represented by elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              that are annihiliated by both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∂
                      %mi out
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} \partial^{vert}_{out}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mo ∂
                        %mi out
                        %mi hor
                    %annotation{:encoding => "application/x-tex"} \partial^{hor}_{out}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msup
                      %mrow
                      %mo □
                    %mi A
                  %annotation{:encoding => "application/x-tex"} [a] \in {}^\Box A
              is 0 then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              also represents the 0-element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} A^{hor}
              and in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mi vert
                    %annotation{:encoding => "application/x-tex"} A^{vert}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mo □
                    %mi A
                  %annotation{:encoding => "application/x-tex"} {}^\Box A
              it is then in the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi hor
                      %mo ∘
                      %msup
                        %mo ∂
                        %mi vert
                      %mo =
                      %msup
                        %mo ∂
                        %mi vert
                      %mo ∘
                      %msup
                        %mo ∂
                        %mi hor
                    %annotation{:encoding => "application/x-tex"} \partial^{hor} \circ \partial^{vert} = \partial^{vert} \circ \partial^{hor}
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by the ring
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            %p
              Similarily the bottom two morphisms exist and are given by the identity on representatives by the very definition of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mo □
                    %annotation{:encoding => "application/x-tex"} A_{\Box}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi vert
                    %msup
                      %mo ∂
                      %mi hor
                    %mo =
                    %msup
                      %mo ∂
                      %mi hor
                    %msup
                      %mo ∂
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} \partial^{vert} \partial^{hor} = \partial^{hor} \partial^{vert}
              it contains in particular the elements that are represented in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              by elements in the kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} \partial^{hor}
              and in the kernel of of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} \partial^{vert}
              separately. And if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a]
              is the 0-element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} A^{hor}
              or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} A^{vert}
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} \partial^{hor}
              or of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi vert
                    %annotation{:encoding => "application/x-tex"} \partial^{vert}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mo □
                    %annotation{:encoding => "application/x-tex"} A_{\Box}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              also represent the 0-element there.
          .num_remark
            %h6#remark_2 Remark
            %p
              In lemma
              %a.maruku-ref{:href => "#Intramural"}
              “intramural” is meant to allude to the fact that these morphisms go between objects that all come from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and hence remain “in the context of
              = succeed "\u201D." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.maruku-ref{:href => "#Extramural"}
              below instead go from objects associated to some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to objects associated to some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "\u201D." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          #Extramural.num_lemma
            %h6#lemma_2 Lemma
            %p
              Any vertical or horizontal morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \partial : A \to B
              in the double complex induces a homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo □
                    %mo →
                    %msup
                      %mrow
                      %mo □
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    A_\Box \to {}^\Box B
            %p
              from the donor of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the receptor of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "," do
                %a.maruku-ref{:href => "#DonorReceptor"}
              %strong extramural map
              associated with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                    %annotation{:encoding => "application/x-tex"} \partial
          %p Again this is immediate, here is one way to make it explicit:
          .proof
            %h6#proof_2 Proof
            %p
              We discuss the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo =
                    %msup
                      %mo ∂
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} \partial = \partial^{hor}
              is a horizontal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} \partial^{hor}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} \partial^{vert}
              interchanged.
            %p
              By definition
              = succeed "," do
                %a.maruku-ref{:href => "#DonorReceptor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi A
                      %mo □
                  %annotation{:encoding => "application/x-tex"} [a] \in A_{\Box}
              is represented by an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              for which
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi vert
                      %msup
                        %mo ∂
                        %mi hor
                      %mi a
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial^{vert}\partial^{hor} a = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \partial^{hor} a
              then represents an element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mo □
                    %mi B
                  %annotation{:encoding => "application/x-tex"} {}^{\Box}B
              such that this is a module homomorphism.
            %ul
              %li
                %p
                  We have
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi vert
                        %mo{:stretchy => "false"} (
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial^{vert} (\partial^{hor} a) = 0
                  by assumption on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %mo{:stretchy => "false"} (
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial^{hor} (\partial^{hor} a) = 0
                  by the chain complex property. Hence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                      %annotation{:encoding => "application/x-tex"} \partial^{hor} a
                  represents an element in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mrow
                            %mo □
                          %mi B
                        %annotation{:encoding => "application/x-tex"} {}^{\Box} B
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} [a] = 0
                  then there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo =
                        %msup
                          %mo ∂
                          %mi hor
                        %mi c
                      %annotation{:encoding => "application/x-tex"} a = \partial^{hor} c
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo =
                          %msup
                            %mo ∂
                            %mi vert
                          %mi d
                        %annotation{:encoding => "application/x-tex"} a = \partial^{vert} d
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo =
                        %msup
                          %mo ∂
                          %mi hor
                        %msup
                          %mo ∂
                          %mi hor
                        %mi c
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial^{hor}a = \partial^{hor}\partial^{hor}c = 0
                  and hence
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} [\partial^{hor} a] = 0
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mrow
                            %mo □
                          %mi B
                        %annotation{:encoding => "application/x-tex"} {}^\Box B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo =
                        %msup
                          %mo ∂
                          %mi hor
                        %msup
                          %mo ∂
                          %mi vert
                        %mi d
                      %annotation{:encoding => "application/x-tex"} \partial^{hor}a = \partial^{hor}\partial^{vert} d
                  which is also 0 in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mrow
                          %mo □
                        %mi B
                      %annotation{:encoding => "application/x-tex"} {}^\Box B
                  since this is the quotient by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi im
                          %mo{:stretchy => "false"} (
                          %msup
                            %mo ∂
                            %mi hor
                          %msup
                            %mo ∂
                            %mi vert
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} im(\partial^{hor} \partial^{vert})
          #ExtramuralMapsAsDiagonals.num_remark
            %h6#remark_3 Remark
            %p
              %strong (central idea on diagram chasing)
            %p
              It is useful in computations, such as those shown below in
              = succeed "," do
                %em
                  %a{:href => "#Implications"} Implications - The diagram chasing lemmas
              %a.maruku-ref{:href => "#Extramural"}
              as follows.
            %ol
              %li
                %p
                  For a horizontal
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \partial^{hor} \colon A \to B
                  we draw the induced extramural map as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                              %mtd
                                %mo □
                            %mtr
                              %mtd
                                %mi A
                              %mtd
                              %mtd
                                %mo ↗
                              %mtd
                              %mtd
                                %mi B
                            %mtr
                              %mtd
                              %mtd
                                %mo □
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp;&amp; \Box
                        \\\
                        A &amp;&amp; \nearrow &amp; &amp; B
                        \\\
                        \&amp; \Box
                        }
                        \\,.
              %li
                %p
                  For a vertical
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi vert
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} \partial^{vert} \colon A \to B
                  we draw the induced extramural map as
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mi A
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo □
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                            %mtr
                              %mtd
                                %mo □
                            %mtr
                              %mtd
                              %mtd
                                %mi B
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp; A
                        \\\
                        \&amp;&amp; \Box
                        \\\
                        \&amp; \swarrow
                        \\\
                        \\Box
                        \\\
                        \&amp; B
                        }
            %p
              This notation makes it manifest that in every
              %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                  %annotation{:encoding => "application/x-tex"} X_{\bullet, \bullet}
              the extramural maps form long diagonal
              %a.existingWikiWord{:href => "/nlab/show/zigzags"} zigzags
              between donors and receptors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
