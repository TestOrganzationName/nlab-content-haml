                    \\,,
            %p
              which are isos by cor
              = succeed "." do
                %a.maruku-ref{:href => "#ExtramuralIso"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                        %mi B
                        %mo ′
                      %mi hor
                    %mo ≃
                    %mrow
                      %mo (
                      %msub
                        %mrow
                          %mi B
                          %mo ′
                        %mo □
                      %mo ≃
                      %msup
