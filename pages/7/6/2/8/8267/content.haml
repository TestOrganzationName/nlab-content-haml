                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mi B
                            %mo ′
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                            %mo ′
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mn 0
                          %mtd
                          %mtd
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; 0 &amp;&amp; 0
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; ker(f) &amp;\stackrel{\xi|_{ker(f)}}{\to}&amp; ker(g) &amp;\to&amp; 0
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    A &amp;\to&amp; B &amp;\stackrel{\xi}{\to}&amp; C &amp;\to&amp; D
                    \\\
                    \\downarrow^{\mathrlap{\tau}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{f}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{g}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\nu}}
                    \\\
                    A' &amp;\to&amp; B' &amp;\stackrel{\eta}{\to}&amp; C' &amp;\to&amp; D'
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    0 &amp;\to&amp; B'/im(f) &amp;\to&amp; C'/im(g)
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; 0 &amp;&amp; 0
                    }
            %p such that
            %ol
              %li
                %p
                  all columns are
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              %li
                %p the middle two rows are exact.
            %p
              For the first statement it is now sufficient to show that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi hor
                      %mo ≃
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} ker(g)^{hor} \simeq 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo{:stretchy => "false"} (
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi(ker(f)) = ker(g)
            %p
              To see this we use the intramural isomorphism, cor.
              %a.maruku-ref{:href => "#IntramuralIsos"}
              item 2, to deduce that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi hor
                    %mo ≃
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo □
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ker(g)^{hor} \simeq ker(g)_{\Box}
                    \\,.
            %p
              Then the long
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
              of extramural isomorphisms, cor.
              = succeed "," do
                %a.maruku-ref{:href => "#ExtramuralIso"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mo □
                    %mn 0
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {}^\Box 0 \simeq 0
              in the bottom left corner of the diagram.
            %p
              The second statement follows dually: it is implied by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi hor
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (B'/im(f))^{hor} \simeq 0
              for that directly implies that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi η
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta^{-1}(im(g))\simeq im(f)
            %p Here the intramural ismorphism to use is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi hor
                    %mo ≃
                    %msup
                      %mrow
                      %mo □
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (B'/im(f))^{hor} \simeq {}^{\Box}(B'/im(f))
            %p
              and then the long sequence of zigzags of extramural isomorphisms identifies this with the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 0
                      %mo □
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0_\Box \simeq 0
              in the top right corner.
          .num_remark
            %h6#remark_6 Remark
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/four+lemma"} four lemma
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/five+lemma"} five lemma
          %h3#TheSnakeLemma The snake lemma
          %p
            We discuss a proof of the
            %a.existingWikiWord{:href => "/nlab/show/snake+lemma"} snake lemma
            from the salamander lemma.
          #Snake.num_prop
            %h6#proposition_6 Proposition
            %p If in a commuting diagram of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mn 3
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi h
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi Y
                              %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; X_1 &amp;\to&amp; X_2 &amp;\to&amp; X_3 &amp;\to&amp; 0
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{f}} &amp;&amp; \downarrow^{\mathrlap{g}} &amp;&amp; \downarrow^{\mathrlap{h}}
                    \\\
                    0 &amp;\to&amp; Y_1 &amp;\to&amp; Y_2 &amp;\to&amp; Y_3
                    }
            %p
              both rows are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mi δ
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ker(f) \to ker(g) \to ker(h)
                    \\stackrel{\delta}{\to}
                    coker(f) \to coker(g) \to coker(h)
            %p
              starting with the
              %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              of the three vertical maps and ending with their
              %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              (with the middle morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              called the “
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"}> connecting homomorphism
              ”).
          .proof
            %h6#proof_12 Proof
            %p
              Consider the completion of the given diagram to a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi l
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mi l
