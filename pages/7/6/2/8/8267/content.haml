                    \\\
                    A &amp;\stackrel{\partial^{hor}}{\to}&amp; B
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\partial^{vert}}}
                    \\\
                    \&amp;&amp; D
                    }
            %p
              the
              = succeed "-shaped" do
                %strong salamander
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
