                        %mi C
                        %mo ′
                      %mi hor
                    %mo ≃
                    %msub
                      %mi C
                      %mo □
                  %annotation{:encoding => "application/x-tex"} {C'}^{hor} \simeq C_{\Box}
              by the intramural iso, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi …
                    %mo ≃
                    %mi A
                    %msub
                      %mo ″
                      %mo □
                  %annotation{:encoding => "application/x-tex"} \dots \simeq A''_\Box
              by this zigzag of extramural isos (this is where we need vertical exactness at
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ″
                    %annotation{:encoding => "application/x-tex"} B''
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mrow
                        %mi A
                        %mo ″
                      %mi hor
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \cdots \simeq {A''}^{hor} \simeq 0
              by another intramural iso and by assumption.
          %h3#nxnLemma
            The
