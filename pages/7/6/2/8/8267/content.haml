                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mo □
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msup
                              %mi A
                              %mi hor
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mo □
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mrow
                              %mo □
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi B
                              %mi hor
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mo □
                            %mi D
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi B
                              %mo □
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;  {}^\Box A
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    C_\Box &amp;&amp;\to&amp;&amp; A^{hor} &amp;\to&amp; A_{\Box} &amp;\to&amp; {}^{\Box} B &amp;\to&amp; B^{hor}
                    \&amp;&amp;\to&amp;&amp; {}^{\Box}D
                    \\\
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp; \searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; B_{\Box}
                    }
                    \\,,
            %p
              where all the elementary morphisms are the unique intramural maps from lemma
              %a.maruku-ref{:href => "#Intramural"}
              and the extramural maps from lemma
              %a.maruku-ref{:href => "#Extramural"}
              – they are the morphisms of the
              %em salamander diagram
              of remark
              = succeed "." do
                %a.maruku-ref{:href => "#OmittingIntramuralMaps"}
            %p Similarly, if a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mo ∂
                                  %mi hor
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mo ∂
                                    %mi vert
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mo ∂
                                  %mi hor
                          %mtd
                            %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C &amp;\stackrel{\partial^{hor}}{\to}&amp; A
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\partial^{vert}}}
                    \\\
                    \&amp;&amp; B &amp;\stackrel{\partial^{hor}}{\to}&amp; D
                    }
            %p
              is part of a double complex, then there is a 6-term
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              running horizontally in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mo □
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %msub
                              %mi C
                              %mo □
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msup
                              %mi A
                              %mi vert
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi A
                              %mo □
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mrow
                              %mo □
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi B
                              %mi vert
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mo □
                            %mi D
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi B
                              %mo □
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; {}^\Box A
                    \\\
                    \&amp; \nearrow &amp; &amp; \searrow
                    \\\
                    C_\Box &amp;&amp;\to&amp;&amp; A^{vert} &amp;\to&amp; A_{\Box} &amp;\to&amp; {}^\Box B &amp;\to&amp;
                    B^{vert}
                    \&amp;&amp;\to&amp;&amp;
                    {}^\Box D
                    \\\
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp; \searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; &amp;&amp; B_\Box
                    }
                    \\,
          %p
            This is
            = succeed "." do
              %a{:href => "#Bergman"} Bergman, lemma 1.7
          .proof
            %h6#proof_4 Proof
            %p
              We spell out the proof of the first case. That of the second case is verbatim the same, only with the roles of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} \partial^{hor}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} \partial^{vert}
              interchanged.
            %p
              By lemmas
              %a.maruku-ref{:href => "#Intramural"}
              and
              = succeed "," do
                %a.maruku-ref{:href => "#Extramural"}
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              of the double complex themselves. Using this we may check exactness at each position explicitly:
            %ol
              %li
                %p
                  exactness at
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mo □
                          %mo →
                          %msup
                            %mi A
                            %mi hor
                          %mo →
                          %msub
                            %mi A
                            %mo □
                        %annotation{:encoding => "application/x-tex"} C_\Box \to A^{hor} \to A_\Box
                %p
                  An element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msup
                          %mi A
                          %mi hor
                      %annotation{:encoding => "application/x-tex"} [a] \in A^{hor}
                  is in the kernel of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi A
                          %mi hor
                        %mo →
                        %msub
                          %mi A
                          %mo □
                      %annotation{:encoding => "application/x-tex"} A^{hor} \to A_{\Box}
                  if there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                      %annotation{:encoding => "application/x-tex"} d
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo =
                          %msup
                            %mo ∂
                            %mi vert
                          %mi c
                          %mo +
                          %msup
                            %mo ∂
                            %mi hor
                          %mi d
                        %annotation{:encoding => "application/x-tex"} a = \partial^{vert}c + \partial^{hor} d
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  that satisfy this equation hence satisfy
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mo ∂
                            %mi hor
                          %msup
                            %mo ∂
                            %mi vert
                          %mi c
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \partial^{hor}\partial^{vert} c = 0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mo □
                      %annotation{:encoding => "application/x-tex"} C_\Box
                  and so the map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %mo :
                        %msub
                          %mi C
                          %mo □
                        %mo →
                        %msup
                          %mi A
                          %mi hor
                      %annotation{:encoding => "application/x-tex"} \partial^{hor} : C_\Box \to A^{hor}
                  hits all of the kernel of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi A
                            %mi hor
                          %mo →
                          %msub
                            %mi A
                            %mo □
                        %annotation{:encoding => "application/x-tex"} A^{hor}\to A_\Box
              %li
                %p
                  exactness at
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi A
                            %mi hor
                          %mo →
                          %msub
                            %mi A
                            %mo □
                          %mo →
                          %msup
                            %mrow
                            %mo □
                          %mi B
                        %annotation{:encoding => "application/x-tex"} A^{hor} \to A_\Box \to {}^\Box B
                %p
                  Suppose
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi A
                          %mo □
                      %annotation{:encoding => "application/x-tex"} [a] \in A_\Box
                  is in the kernel of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mo □
                          %mo →
                          %msup
                            %mrow
                            %mo □
                          %mi B
                        %annotation{:encoding => "application/x-tex"} A_\Box \to {}^\Box B
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
                  such that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mo ∂
                            %mi hor
                          %mi a
                          %mo =
                          %msup
                            %mo ∂
                            %mi hor
                          %msup
                            %mo ∂
                            %mi vert
                          %mi c
                        %annotation{:encoding => "application/x-tex"} \partial^{hor}a = \partial^{hor} \partial^{vert}c
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mo ∂
                            %mi hor
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo −
                          %msup
                            %mo ∂
                            %mi vert
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \partial^{hor} (a-\partial^{vert} c) = 0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo −
                        %msup
                          %mo ∂
                          %mi vert
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msub
                          %mi A
                          %mo □
                      %annotation{:encoding => "application/x-tex"} [a] = [a - \partial^{vert}c] \in A_{\Box}
                  and so this says that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [a]
                  is the image under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi A
                          %mi hor
                        %mo →
                        %msub
                          %mi A
                          %mo □
                      %annotation{:encoding => "application/x-tex"} A^{hor} \to A_{\Box}
                  of the element represented there by
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                          %mo −
                          %msup
                            %mo ∂
                            %mi vert
                          %mi c
                        %annotation{:encoding => "application/x-tex"} a - \partial^{vert} c
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mo □
                          %mo →
                          %msup
                            %mrow
                            %mo □
                          %mi B
                        %annotation{:encoding => "application/x-tex"} A_\Box \to {}^\Box B
              %li
                %p
                  exactness at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mo □
                        %mo →
                        %msup
                          %mrow
                          %mo □
                        %mi B
                        %mo →
                        %msup
                          %mi B
                          %mi hor
                      %annotation{:encoding => "application/x-tex"} A_\Box \to {}^\Box B \to B^{hor}
                %p
                  An element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msup
                          %mrow
                          %mo □
                        %mi B
                      %annotation{:encoding => "application/x-tex"} [b] \in {}^\Box B
                  is in the kernel of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mrow
                          %mo □
                        %mi B
                        %mo →
                        %msup
                          %mi B
                          %mi hor
                      %annotation{:encoding => "application/x-tex"} {}^\Box B \to B^{hor}
                  if there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mo ∂
                            %mi hor
                          %mi a
                          %mo =
                          %mi b
                        %annotation{:encoding => "application/x-tex"} \partial^{hor} a = b
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msup
                          %mrow
                          %mo □
                        %mi B
                      %annotation{:encoding => "application/x-tex"} [b] \in {}^\Box B
                  has to satisfy in particular
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi vert
                        %mi b
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial^{vert} b = 0
                  it follows that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %msup
                          %mo ∂
                          %mi vert
                        %mi a
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial^{hor} \partial^{vert}a  = 0
                  and hence that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  represents an element in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mo □
                        %annotation{:encoding => "application/x-tex"} A_{\Box}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi b
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [b]
                  is in the image of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi A
                            %mo □
                          %mo →
                          %msup
                            %mrow
                            %mo □
                          %mi B
                        %annotation{:encoding => "application/x-tex"} A_{\Box} \to {}^{\Box }B
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mrow
                            %mo □
                          %mi B
                          %mo →
                          %msup
                            %mi B
                            %mi hor
                        %annotation{:encoding => "application/x-tex"} {}^\Box B \to B^{hor}
              %li
                %p
                  exactness at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mrow
                          %mo □
                        %mi B
                        %mo →
                        %msup
                          %mi B
                          %mi hor
                        %mo →
                        %msup
                          %mrow
                          %mo □
                        %mi D
                      %annotation{:encoding => "application/x-tex"} {}^\Box B \to B^{hor} \to {}^\Box D
                %p
                  An element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msup
                          %mi B
                          %mi hor
                      %annotation{:encoding => "application/x-tex"} [b] \in B^{hor}
                  is in the kernel of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi B
                          %mi hor
                        %mo →
                        %msup
                          %mrow
                          %mo □
                        %mi D
                      %annotation{:encoding => "application/x-tex"} B^{hor} \to {}^\Box D
                  if there is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  with
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mo ∂
                            %mi vert
                          %mi b
                          %mo =
                          %msup
                            %mo ∂
                            %mi vert
                          %msup
                            %mo ∂
                            %mi hor
                          %mi a
                        %annotation{:encoding => "application/x-tex"} \partial^{vert} b = \partial^{vert} \partial^{hor} a
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi vert
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo −
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial^{vert}(b - \partial^{hor}a) = 0
                  Since in addition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mo ∂
                          %mi hor
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo −
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \partial^{hor}(b - \partial^{hor}a) = 0
                  by assumption on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  and the chain complex property, this says that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi b
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mi b
                        %mo −
                        %msup
                          %mo ∂
                          %mi hor
                        %mi a
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [b] = [b - \partial^{hor} a]
                  is in the image of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mrow
                            %mo □
                          %mi B
                          %mo →
                          %msup
                            %mi B
                            %mi hor
                        %annotation{:encoding => "application/x-tex"} {}^\Box B \to B^{hor}
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi B
                            %mi hor
                          %mo →
                          %msup
                            %mrow
                            %mo □
                          %mi D
                        %annotation{:encoding => "application/x-tex"} B^{hor} \to {}^\Box D
          %h3#IntraExtramuralIsomorphisms Intramural and extramural isomorphisms
          %p
            The following two statements are direct consequences (special cases) of the salamander lemma, prop.
            = succeed "." do
              %a.maruku-ref{:href => "#SalamanderLemma"}
            %a.maruku-ref{:href => "#Intramural"}
            and lemma
            = succeed "," do
              %a.maruku-ref{:href => "#Extramural"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            %a.existingWikiWord{:href => "/nlab/show/diagram+chasing+lemmas"} diagram chasing lemmas
            in
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            follow in a natural way from combining these
            %em intramural isomorphisms
            with long
            %a.existingWikiWord{:href => "/nlab/show/zigzags"} zigzags
            of these
            = succeed "." do
              %em extramural isomorphisms
            = succeed "." do
              %em
                %a{:href => "#Implications"} The basic diagram chasing lemmas
          #ExtramuralIso.num_cor
            %h6#corollary Corollary
            %p
              %strong (extramural isomorphisms)
            %p
              If the rows of a double complex are exact at the domain and codomain of a horizontal morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi hor
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \partial^{hor} : A \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi hor
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} A^{hor} = 0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mi hor
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} B^{hor} = 0
              %a.maruku-ref{:href => "#Extramural"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo □
                    %mo →
                    %msup
                      %mrow
                      %mo □
                    %mi B
                  %annotation{:encoding => "application/x-tex"}
                    A_{\Box} \to {}^\Box B
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              Similarly if for a vertical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \partial : A \to B
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi vert
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} A^{vert} = 0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mi vert
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} B^{vert} = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mo □
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mo □
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A_\Box
                    \\\
                    \\downarrow
                    \\\
                    {}^\Box B
                    }
            %p is an isomorphism.
          %p
            This appears as
            = succeed "." do
              %a{:href => "#Bergman"} Bergman, cor. 2.1
          %p It is straightforward to check this directly on elements:
          .proof
            %h6#proof_5 Proof
            %p
              It is sufficient to show that under the given assumptions both the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              and the
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
              of the given map are trivial. We discuss the horizontal case. The proof of the vertical case is verbatim the same, only with the roles of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} \partial^{vert}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} \partial^{hor}
              exchanged.
            %p
              Suppose an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi A
                      %mo □
                  %annotation{:encoding => "application/x-tex"} [a] \in A_{\Box}
              is in the kernel of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi hor
                      %mo :
                      %msub
                        %mi A
                        %mo □
                      %mo →
                      %msup
                        %mrow
                        %mo □
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \partial^{hor} : A_{\Box} \to {}^\Box B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
                      %mo □
                    %mi B
                  %annotation{:encoding => "application/x-tex"} {}^\Box B
              this means that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi hor
                      %msup
                        %mo ∂
                        %mi vert
                      %mi c
                      %mo =
                      %msup
                        %mo ∂
                        %mi hor
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \partial^{hor} \partial^{vert} c = \partial^{hor} a
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi hor
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo −
                      %msup
                        %mo ∂
                        %mi vert
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial^{hor}(a- \partial^{vert} c) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi hor
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} A^{hor} = 0
              this means that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo −
                      %msup
                        %mo ∂
                        %mi vert
                      %mi c
                      %mo =
                      %msup
                        %mo ∂
                        %mi hor
                      %mi d
                    %annotation{:encoding => "application/x-tex"} a - \partial^{vert} c = \partial^{hor} d
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∂
                      %mi hor
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∂
                      %mi vert
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a \in im(\partial^{hor}) + im(\partial^{vert})
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [a] = 0
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mo □
                    %annotation{:encoding => "application/x-tex"} A_\Box
            %p
              Conversely, consider
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msup
                        %mrow
                        %mo □
                      %mi B
                    %annotation{:encoding => "application/x-tex"} [b] \in {}^\Box B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi vert
                    %mi b
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial^{vert}b = 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi hor
                      %mi b
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial^{hor} b = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi hor
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} B^{hor} = 0
              the second condition means that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo =
                      %msup
                        %mo ∂
                        %mi hor
                      %mi a
                    %annotation{:encoding => "application/x-tex"} b = \partial^{hor} a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi vert
                    %msup
                      %mo ∂
                      %mi hor
                    %mi a
                    %mo =
                    %msup
                      %mo ∂
                      %mi vert
                    %mi b
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial^{vert}\partial^{hor} a = \partial^{vert} b = 0
              by the first condition. Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi A
                      %mo □
                  %annotation{:encoding => "application/x-tex"} [a] \in A_{\Box}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [b]
              is its image.
          %p Alternatively, this statement is a direct consequence of the salamander lemma already proven above:
          .proof
            %h6#proof_6 Proof
            %p
              Under the given assumptions the exact sequence of prop.
              %a.maruku-ref{:href => "#SalamanderLemma"}
              involves the exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
