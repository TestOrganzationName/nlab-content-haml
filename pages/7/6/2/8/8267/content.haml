                          %mtd
                          %mtd
                            %mo □
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo □
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi D
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; C
                    \\\
                    \&amp;&amp; \Box
                    \\\
                    \&amp; \swarrow
                    \\\
                    \\Box &amp;&amp;&amp; &amp; \Box
                    \\\
                    \&amp; A &amp;&amp; \nearrow &amp; &amp; B
                    \\\
                    \&amp;&amp; \Box &amp; &amp;&amp; &amp; \Box
                    \\\
                    \&amp;&amp;&amp;&amp;&amp; \swarrow
                    \\\
                    \&amp;&amp;&amp;&amp; \Box
                    \\\
                    \&amp;&amp;&amp;&amp;&amp; D
                    }
                    \\,.
            %p
              These give the salamander lemma, prop.
              %a.maruku-ref{:href => "#SalamanderLemma"}
              below, its name.
          .num_lemma
            %h6#lemma_3 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \partial^{hor} : A \to B
              any horizontal morphism in the double complex, the canonically induced morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi vert
                    %mo →
                    %msup
                      %mi B
                      %mi vert
                  %annotation{:encoding => "application/x-tex"} A^{vert} \to B^{vert}
              on vertical homology is the composite of the above intramural and extramural maps:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mi vert
                    %mo →
                    %msub
                      %mi A
                      %mo □
                    %mo →
                    %msup
                      %mrow
                      %mo □
                    %mi B
                    %mo →
                    %msup
                      %mi B
                      %mi vert
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^{vert} \to A_{\Box} \to {}^\Box B \to B^{vert}
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              By the above, on representatives the first map is the identity, the second is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} \partial^{hor}
              and the third again the identity. Hence the total map is given on representative by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi hor
                    %annotation{:encoding => "application/x-tex"} \partial^{hor}
          %h3#statement Statement
          #SalamanderLemma.num_prop
            %h6#proposition Proposition
            %p
              %strong (Salamander lemma)
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
