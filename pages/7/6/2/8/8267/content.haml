              follows from the intramural isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi hor
                      %mo ≃
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo □
                    %annotation{:encoding => "application/x-tex"} ker(g)^{hor} \simeq ker(g)_{\Box}
              = succeed "," do
                %a.maruku-ref{:href => "#IntramuralIsos"}
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
              of extramural isomorphisms, cor.
              = succeed "," do
                %a.maruku-ref{:href => "#ExtramuralIso"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo □
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo □
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 1
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %msub
                              %mi X
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo □
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                            %mo □
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;&amp;&amp;&amp;&amp;&amp; ker(g)
                    \\\
                    \&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp; \Box
                    \\\
                    \&amp;&amp;&amp;&amp;&amp;&amp;&amp; \swarrow
                    \\\
                    \&amp; &amp;&amp;&amp;&amp;&amp; \Box
                    \\\
                    \&amp; X_1 &amp;&amp;&amp;&amp; \nearrow &amp; &amp; X_2
                    \\\
                    \&amp;&amp; \Box
                    \\\
                    \&amp; \swarrow
                    \\\
                    \\Box
                    \\\
                    \&amp; Y_1
                    }
            %p
              which give
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⋯
                      %mo ≃
                      %msup
                        %mrow
                        %mo □
                      %msub
                        %mi Y
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \cdots \simeq {}^\Box Y_1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ⋯
                      %mo ≃
                      %msub
                        %mn 0
                        %mo □
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \cdots \simeq 0_{\Box} = 0
            %p
              Exactness at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} coker(g)
              is shown analogously.
            %p
              Finally, building the
              %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(h) \to coker(f)
              is the same as giving an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi hor
                  %annotation{:encoding => "application/x-tex"} coker(ker(g) \to ker(h)) \simeq ker(h)^{hor}
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi coker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi coker
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi coker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi hor
                    %annotation{:encoding => "application/x-tex"} ker(coker(f) \to coker(g)) = coker(f)^{hor}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi hor
                    %mo ≃
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi h
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo □
                  %annotation{:encoding => "application/x-tex"} ker(h)^{hor} \simeq ker(h)_{\Box}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mrow
                        %mo □
                      %mi coker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi coker
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi hor
                    %annotation{:encoding => "application/x-tex"} {}^\Box coker(f) \simeq coker(f)^{hor}
              %a.maruku-ref{:href => "#IntramuralIsos"}
              connected by the
              %a.existingWikiWord{:href => "/nlab/show/zigzag"} zigzag
              of extramural isomorphisms, cor.
              %a.maruku-ref{:href => "#ExtramuralIso"}
            .maruku-equation
