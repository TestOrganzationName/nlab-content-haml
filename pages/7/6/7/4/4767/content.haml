                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} S^1 \to \mathbb{C}
            must also be trivial. Therefore, every homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℂ
                    %mo *
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} h \colon \mathbb{C}^* \to \mathbb{C}
            factors through the projection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo *
                    %mo →
                    %msup
                      %mi ℝ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^* \to \mathbb{R}^*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
