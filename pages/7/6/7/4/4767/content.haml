                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            can be injective, nor can such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            be surjective.
          %p
            Taking advantage of biproduct representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo ≅
                  %mi ℝ
                  %mo ⊕
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{C} \cong \mathbb{R} \oplus \mathbb{R}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo *
                    %mo ≅
                    %msup
                      %mi ℝ
                      %mo *
                    %mo ⊕
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^* \cong \mathbb{R}^* \oplus S^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^*
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ,
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a, b, c, d)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo ,
                      %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi i
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi e
                    %mrow
                      %mi a
                      %mi x
                  %msup
                    %mi e
                    %mrow
                      %mi i
                      %mi b
                      %mi x
                  %msup
                    %mi e
                    %mrow
                      %mi c
                      %mi y
                  %msup
                    %mi e
                    %mrow
                      %mi i
                      %mi d
                      %mi y
                  %mo .
                %annotation{:encoding => "application/x-tex"} \phi_{a, b, c, d}(x + i y) = e^{a x} e^{i b x} e^{c y} e^{i d y}.
          %p
            The cases where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %mi d
                  %annotation{:encoding => "application/x-tex"} a = d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi c
                %annotation{:encoding => "application/x-tex"} b = -c
            correspond to those homomorphisms that are
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+functions"} holomorphic functions
            (i.e., that satisfy the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy-Riemann+equations"} Cauchy-Riemann equations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo =
                    %mi a
                    %mo +
                    %mi b
                    %mi i
                  %annotation{:encoding => "application/x-tex"} w = a + b i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi b
                      %mo ,
                      %mi a
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi e
                    %mrow
                      %mi w
                      %mi z
                %annotation{:encoding => "application/x-tex"} \phi_{a, b, -b, a}(z) = e^{w z}
          %p
            with one such homomorphism for each complex number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
            %a.existingWikiWord{:href => "/nlab/show/surjections"} surjections
            whenever
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} w \ne 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} z = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mi w
                  %mo =
                  %msup
                    %mi e
                    %mrow
                      %mi w
                      %mo ′
                %annotation{:encoding => "application/x-tex"} e^w = e^{w'}
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo −
                  %mi w
                  %mo ′
                %annotation{:encoding => "application/x-tex"} w - w'
            is an integer multiple of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi π
                    %mi i
                  %annotation{:encoding => "application/x-tex"} 2 \pi i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo ↦
                  %msup
                    %mi e
                    %mrow
                      %mi w
                      %mi z
                %annotation{:encoding => "application/x-tex"} z \mapsto e^{w z}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo ↦
                  %msup
                    %mi e
                    %mrow
                      %mi w
                      %mo ′
                      %mi z
                %annotation{:encoding => "application/x-tex"} z \mapsto e^{w' z}
            will be different unless
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo =
                    %mi w
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} w = w'
          %p
            So we have these surjections (the
            %strong
              complex
              %a.existingWikiWord{:href => "/nlab/show/exponential+map"} exponential map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ↦
                    %msup
                      %mi e
                      %mrow
                        %mi w
                        %mi z
                  %annotation{:encoding => "application/x-tex"} z \mapsto e^{w z}
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} w \ne 0
            %a.existingWikiWord{:href => "/nlab/show/regular+epimorphisms"} regular epimorphisms
            but not
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphisms"} split epimorphisms
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            (being not split), they have quite a few
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+sections"} local sections
            %a.existingWikiWord{:href => "/nlab/show/domains"} domains
            of the
            %a.existingWikiWord{:href => "/nlab/show/maximal+local+sections"} maximal local sections
            are precisely the
            %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+space"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/open+subspace"} open
            %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense
            subspaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^*
            %strong
              complex logarithm with exponential base
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            is this
            = succeed "-defined" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ↦
                    %msup
                      %mi e
                      %mrow
                        %mi w
                        %mi z
                  %annotation{:encoding => "application/x-tex"} z \mapsto e^{w z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            given, we denote this by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi log
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi w
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \log_{[w]}
            (but please note that in the context of real logarithms, this would ordinarily be denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi log
                    %mi b
                %annotation{:encoding => "application/x-tex"} \log_b
            where
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %msup
                      %mi e
                      %mi w
                  %annotation{:encoding => "application/x-tex"} b = e^w
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} 1 \in R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            may be defined using the
            %a.existingWikiWord{:href => "/nlab/show/contour+integral"} contour integral
            with the same formula
            %a.maruku-eqref{:href => "#eq:integrals"} (1)
            as for the real natural logarithm. We merely insist that the integral be done along a contour within the region
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is connected, there is such a contour; since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is simply connected and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ↦
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi t
                %annotation{:encoding => "application/x-tex"} t \mapsto 1/t
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+map"} holomorphic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mo +
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^+ \subseteq R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            will be equal.
          %p
            The natural exponential map is
            %a.existingWikiWord{:href => "/nlab/show/periodic+function"} periodic
            (with period
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi π
                    %mi{:mathvariant => "normal"} i
                  %annotation{:encoding => "application/x-tex"} 2 \pi \mathrm{i}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≠
                  %mn 1
                %annotation{:encoding => "application/x-tex"} x \ne 1
            by suitably changing the region
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi ln
                          %mi x
                        %mtd
                          %mo ≔
                          %mi C
                          %mo +
                          %msubsup
                            %mo ∫
                            %mrow
                              %msup
                                %mi{:mathvariant => "normal"} e
                                %mi C
                            %mi x
                          %mfrac
                            %mn 1
                            %mi t
                          %mspace{:width => "thinmathspace"}
                          %mi{:mathvariant => "normal"} d
                          %mi t
                          %mo ,
                      %mtr
                        %mtd
                          %msub
                            %mi log
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi w
                              %mo{:stretchy => "false"} ]
                          %mi x
                        %mtd
                          %mo ≔
                          %mfrac
                            %mrow
                              %mi ln
                              %mi x
                            %mi w
                          %mo .
                      %mtr
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array {
                  \\ln x &amp; \coloneqq C + \int_{\mathrm{e}^C}^x \frac{1}{t} \,\mathrm{d}t,\\
                  \\log_{[w]} x &amp; \coloneqq \frac{\ln x}{w} .\\
                  }
          %h3#logarithms_and_lie_groups Logarithms and Lie groups
          %p
            In the classical examples, the multiplicative groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^+
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℂ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathbb{C}^*
            are both
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            are also Lie groups, but they are more than this: they are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+Lie+algebras"} abelian Lie algebras
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            %em the
            Lie algebra of the corresponding Lie group.
          %p
            This generalises. Given any
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            be its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/exponential+map"} exponential map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \exp\colon \mathfrak{g} \to G
            %a.existingWikiWord{:href => "/nlab/show/surjection"} surjective
            under certain conditions (most famously when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is
            %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is not compact). More generally, given any
            %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \mapsto \exp(\phi(x))
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of Lie groups. Any
            %a.existingWikiWord{:href => "/nlab/show/local+section"} local section
            of this map may be called a
            %strong
              logarithm base
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi log
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi ϕ
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \log_{[\phi]}
            with the bracket as in the previous section); any local section of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                %annotation{:encoding => "application/x-tex"} \exp
            itself may be called a
            %strong natural logarithm
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %h2#properties Properties
          %p
          #MercatorSeries.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Mercator+series"}> Mercator series
                )
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
              of the
              %a.existingWikiWord{:href => "/nlab/show/natural+logarithm"} natural logarithm
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{R}
              is the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/series"} series
            #eq:MercatorTaylorSeriesForNaturalLogarithm.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi n
                                %mo =
                                %mn 0
                              %mn ∞
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mi n
                                  %mo !
                            %msub
                              %mrow
                                %mo (
                                %mfrac
                                  %mrow
                                    %msup
                                      %mi d
                                      %mi n
                                  %mrow
                                    %mi d
                                    %msup
                                      %mi x
                                      %mi n
                                %mi ln
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo +
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi x
                                %mo =
                                %mn 0
                            %msup
                              %mi x
                              %mi n
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi n
                                %mo =
                                %mn 1
                              %mn ∞
                            %mfrac
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                              %mi n
                            %msup
                              %mi x
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi x
                            %mo −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msup
                              %mi x
                              %mn 2
                            %mo +
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 3
                            %msup
                              %mi x
                              %mn 3
                            %mo −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 4
                            %msup
                              %mi x
                              %mn 4
                            %mo +
                            %mi ⋯
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underoverset{n = 0}{\infty}{\sum}
                    \\tfrac{1}{n!}
                    \\left(
                    \\frac{d^n}{ d x^n} ln(1 + x)
                    \\right)_{\vert x = 0}
                    x^n
                    \&amp;
                    \\;\;
                    \=
                    \\;\;
                    \\underoverset{n = 1}{\infty}{\sum}
                    \\frac
                    {(-1)^{n+1}}
                    {n}
                    x^n
                    \\\
                    \&amp;
                    \\;\;
                    \=
                    \\;\;
                    x
                    \- \tfrac{1}{2} x^2
                    + \tfrac{1}{3} x^3
                    \- \tfrac{1}{4} x^4
                    + \cdots
                    \\,.
                    \\end{aligned}
            %p
          .proof
            %h6 Proof
            %p For the first two terms notice that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo →
                      %mrow
                        %mi x
                        %mo →
                        %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    ln(1 + x)
                    \\;\xrightarrow{x \to 0}\;
                    ln(1)
                    \\,=\,
                    0
            %p
              and that the
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              of the
              %a.existingWikiWord{:href => "/nlab/show/natural+logarithm"} natural logarithm
              is:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi x
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo +
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 1
                          %mo +
                          %mi x
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo →
                      %mrow
                        %mi x
                        %mo →
                        %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d x} \ln(1 + x)
                    \\;=\;
                    \\tfrac{1}{1+x}
                    \\;\xrightarrow{ x \to 0 }\;
                    1
                    \\,.
            %p
              From here on, noticing for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}_+
              that:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi x
                    %mrow
                      %mo (
                      %mfrac
                        %mn 1
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo +
                          %mi x
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi k
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi k
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo +
                        %mi x
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo →
                      %mrow
                        %mi x
                        %mo →
                        %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{d}{d x}
                    \\left(
                    \\frac{1}{(1 + x)^k}
                    \\right)
                    \\;=\;
                    \- k
                    \\frac{1}{(1 + x)^{k+1}}
                    \\;\xrightarrow{x \to 0}\;
                    \- k
            %p
              we get, for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %msub
                        %mi ℕ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}_+
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mfrac
                              %mrow
                                %msup
                                  %mi d
                                  %mi n
                              %mrow
                                %mi d
                                %msup
                                  %mi x
                                  %mi n
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo +
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %msup
                                  %mi d
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                              %mrow
                                %mi d
                                %msup
                                  %mi x
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                            %mrow
                              %mo (
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 1
                                  %mo +
                                  %mi x
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo !
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %mfrac
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo +
                                %mi x
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi n
                                    %mo −
                                    %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mover
                              %mo →
                              %mrow
                                %mi x
                                %mo →
                                %mn 0
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo !
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\frac{d^n}{d x^n}
                    ln(1 + x)
                    \&amp;
                    \\;=\;
                    \\frac{d^{n-1}}{d x^{n-1}}
                    \\left(
                    \\frac{1}{1 + x}
                    \\right)
                    \\\
                    \&amp;
                    \\;=\;
                    (n-1)! \cdot (-1)^{n-1}
                    \\frac{1}{(1 + x)^{n-1}}
                    \\\
                    \&amp;
                    \\;\xrightarrow{ x \to 0 }\;
                    (n-1)! \cdot (-1)^{n+1}
                    \\end{aligned}
                    \\,.
            %p
              Plugging this into the defining equation on the left of
              %a.maruku-eqref{:href => "#eq:MercatorTaylorSeriesForNaturalLogarithm"} (2)
              and using
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                      %mrow
                        %mi n
                        %mo !
                    %mo =
                    %mfrac
                      %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{(n-1)!}{n!} = \frac{1}{n}
            %p yields the claim.
          %h2#related_concepts Related concepts
          %ul
            %li
