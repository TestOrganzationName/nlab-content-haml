          %h2#definition Definition
          %h3#general_definition_in_a_coring General definition in a coring
          %p
            Given an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/coring"} coring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi Δ
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\Delta,\epsilon)
            (a
            %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            in the category of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-algebra)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %strong semi-grouplike
            element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} g\in C
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo ⊗
                  %mi g
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Delta(g) = g\otimes g
                  \\,.
          %p
            A
            %strong grouplike
            (or group-like) element is a semi-grouplike one such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \epsilon(g) = 1
          %p
            %strong Proposition.
            An
            = succeed "-coring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi Δ
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\Delta,\epsilon)
            has a grouplike element iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a right or left
            = succeed "-comodule." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            %em Proof.
            Given a grouplike element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} g\in C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo =
                  %msub
                    %mi ρ
                    %mi g
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                  %mo ≅
                  %mi C
                %annotation{:encoding => "application/x-tex"} \rho = \rho_g : A \to A\otimes_A C\cong C
            by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mi A
                  %msub
                    %mo ⊗
                    %mi A
                  %mi ga
                  %mo =
                  %mi ga
                %annotation{:encoding => "application/x-tex"}
                  \\rho(a) = 1_A \otimes_A ga = ga
          %p
            it is clear that this is a map of
            = succeed "-bimodules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo ⊗
                    %msub
                      %mi id
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi A
                    %msub
                      %mo ⊗
                      %mi A
                    %mi ga
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %msub
                      %mo ⊗
                      %mi A
                    %msub
                      %mn 1
                      %mi A
                    %mo ⊗
                    %mi ga
                    %mo =
                    %mi g
                    %mo ⊗
                    %mi ga
                  %annotation{:encoding => "application/x-tex"} (\rho\otimes id_C)(1_A\otimes_A ga) = g\otimes_A 1_A\otimes ga = g\otimes ga
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi id
                  %mo ⊗
                  %msub
                    %mi Δ
                    %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi A
                  %mo ⊗
                  %mi ga
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mn 1
                    %mi A
                  %msub
                    %mo ⊗
                    %mi A
                  %mi g
                  %mo ⊗
                  %mi ga
                  %mo =
                  %mi g
                  %mo ⊗
                  %mi ga
                %annotation{:encoding => "application/x-tex"} (id\otimes \Delta_C)(1_A\otimes ga) = 1_A \otimes_A g\otimes ga = g\otimes ga
            hence the coassociativity and similarly for the counit.
          %p
            Conversely, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\rho)
            be a right
            = succeed "-comodule." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi A
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                  %mo ≅
                  %mi C
                %annotation{:encoding => "application/x-tex"} \rho(1_A)\in A\otimes_A C \cong C
            is a grouplike.
          %p
            For the left comodules the story is similar, e.g.
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ag
                  %annotation{:encoding => "application/x-tex"} \rho(a) = ag
          %p Note that coring homomorphisms send grouplike elements to grouplike elements. This can be assembled into a functor, and moreover, this functor is representable.
          %p
          .num_theorem
            %h6 Theorem
            %p
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi A
                    %mtext -
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi CoRing
                    %mo →
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} G : A\text{-}\mathsf{CoRing} \to \mathsf{Set}
              is representable:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ≅
                      %msub
                        %mi{:mathvariant => "normal"} Hom
                        %mrow
                          %mi A
                          %mtext -
                          %mstyle{:mathvariant => "sans-serif"}
                            %mi CoRing
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G \cong \mathrm{Hom}_{A\text{-}\mathsf{CoRing}}(A,-)
            %p
          %p
            %em Proof.
          %p
            We can assign each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi GC
                %annotation{:encoding => "application/x-tex"} g \in GC
            the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ρ
                    %mi g
                %annotation{:encoding => "application/x-tex"} \rho_g
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi A
                    %mo ↦
                    %mi g
                  %annotation{:encoding => "application/x-tex"} 1_A \mapsto g
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi A
                  %annotation{:encoding => "application/x-tex"} 1_A
          %h3#special_case_grouplike_elements_in_coalgebras Special case: grouplike elements in coalgebras
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            is special case of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coring"} coring
          %p
            The grouplike elements in a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebra"} Hopf algebra
            form a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is just a group over the category of coalgebras over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (the monoidal structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            is even the categorical product), so the set of grouplike elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mrow
                      %mi k
                      %mtext -
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi CoAlg
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_{k\text{-}\mathsf{CoAlg}}(k,H)
            is canonically a group.
          %h2#relation_to_differential_graded_algebras Relation to differential graded algebras
          %p For corings with a (sometimes semi-)grouplike element one can define many useful notions which do not exist for general corings.
          %p
            For example, given a semi-grouplike element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi C
                  %mo =
                  %msub
                    %mo ⊕
                    %mi i
                  %msup
                    %mi Ω
                    %mi i
                  %mi C
                %annotation{:encoding => "application/x-tex"} \Omega C = \oplus_i \Omega^i C
            of the coring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi i
                  %mi C
                  %mo =
                  %mi C
                  %msub
                    %mo ⊗
                    %mi A
                  %mi …
                  %msub
                    %mo ⊗
                    %mi A
                  %mi C
                %annotation{:encoding => "application/x-tex"} \Omega^i C = C\otimes_A \ldots \otimes_A C
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            times) over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            can be equipped with a
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} +1
            in a canonical way making it a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
          %p
            in degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi a
                  %mo =
                  %mi g
                  %mi a
                  %mo −
                  %mi a
                  %mi g
                %annotation{:encoding => "application/x-tex"}
                  d a = g a - a g
          %p and in higher degree
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi c
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo ⊗
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi c
                    %mi n
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi c
                    %mi n
                  %mo ⊗
                  %mi g
                  %mo +
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi n
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi c
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                  %mo ⊗
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi c
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi c
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d(c_1\otimes\ldots\otimes c_n) = g\otimes c_1\otimes\ldots\otimes c_n + (-1)^{n+1}c_1\otimes\ldots\otimes c_n\otimes g + \sum_{i=1}^n c_1\otimes\ldots\otimes c_{i-1}\otimes \Delta(c_i)\otimes c_{i+1}\otimes\ldots \otimes c_n\,.
          %p In fact, by a result in
          %ul
            %li
              A. V. Roiter,
              = succeed ";" do
                %em Matrix problems and representations of BOCS’s
          %p
            %a.existingWikiWord{:href => "/nlab/show/semi-free+differential+graded+algebras"} semi-free differential graded algebras
            are in bijective correspondence with corings with a group-like element. Moreover flat
            %a.existingWikiWord{:href => "/nlab/show/connection+for+coring"} connections
            for a semi-free dga are in
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            correspondence with the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
          %p
            A special case of this construction is when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %mn 1
                  %msub
                    %mo ⊗
                    %mi R
                  %mn 1
                %annotation{:encoding => "application/x-tex"} g = 1\otimes_R 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/Sweedler+coring"} Sweedler coring
            for a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} R\to S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega(S/R)
            for that extension; for this reason the complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi C
                  %mo =
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega C = \Omega(C,g)
            above for any coring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and semi-grouplike
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is sometimes said to be an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Amitsur+complex"} Amitsur complex
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
                , R. Wisbauer,
                = succeed "," do
                  %em Corings and comodules
                = succeed "," do
                  %strong 309
            %li
              %p
                C. Menini, D. Ştefan,
                = succeed "," do
                  %em Descent theory and Amitsur cohomology of triples
                %strong 266
                (2003), no. 1, 261–304.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
                ,
                = succeed "," do
                  %em Flat connections and comodules
                %a{:href => "http://arxiv.org/abs/math/0608170"} math.QA/0608170
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T.+Brzezi%C5%84ski"}> T. Brzeziński
