                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} ]
              %li
                %p
                  Raoni W. Arroyo, Jonnas R. B. Arenhart,
                  = succeed "," do
                    %em Whence deep realism for Everettian quantum mechanics?
                  %strong 52
                  121 (2022) &amp;lbrack;
                  %a{:href => "https://arxiv.org/abs/2210.16713"}> arXiv:2210.16713
                  ,
                  = succeed "&rbrack;" do
                    %a{:href => "https://doi.org/10.1007/s10701-022-00643-0"} doi:10.1007/s10701-022-00643-0
              %li#SS23Monadology
                %p
