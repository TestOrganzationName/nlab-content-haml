                  %path{:d => "M -28.295307 -64.66329 L 28.092541 -64.66329 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.991806,0,0,-0.991806,53.11813,74.472058)"}
