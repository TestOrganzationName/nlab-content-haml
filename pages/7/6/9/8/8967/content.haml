                  %path{:d => "M -2.484899 2.869918 C -2.031969 1.148783 -1.019768 0.333508 0.000309696 -0.00126617 C -1.019768 -0.336041 -2.031969 -1.147377 -2.484899 -2.868512 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0,0.991806,0.991806,0,12.985631,126.27313)"}
