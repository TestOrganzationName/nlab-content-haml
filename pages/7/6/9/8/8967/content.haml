                    %use{:x => "50.187345", "xlink:href" => "#bEoG1XYSz7dHjDtmBk9Ujd8VzzA=-glyph1-5", :y => "148.952688"}
          %p
            A morphism of pullbacks around
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,g)
            consists of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                  %mo ′
                %annotation{:encoding => "application/x-tex"} s:X\to X'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mi Y
                  %mo →
                  %mi Y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} t:Y\to Y'
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ′
                    %mi s
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p's=p
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mi s
                    %mo =
                    %mi t
                    %mi q
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} q s=t q'
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mi r
                    %mo ′
                    %mi s
                  %annotation{:encoding => "application/x-tex"} r = r's
          .un_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Z
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} g:Z\to A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\to B
              as above, a
              %strong distributivity pullback
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
              is a terminal object of the category of pullbacks around
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f,g)
          %p
            If the above diagram is a distributivity pullback, we say that it exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            as a
            = succeed "." do
              %em
                distributivity pullback of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %h2#properties Properties
          %h3#connection_to_exponentiation Connection to exponentiation
          .un_theorem
            %h6#theorem Theorem
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\to B
              is
              %a.existingWikiWord{:href => "/nlab/show/exponentiable+morphism"} exponentiable
              if and only if all distributivity pullbacks along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              exist.
          .proof
            %h6#proof Proof
            %p
              The universal property of a distributivity pullback says exactly that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mover
                      %mo →
                      %mi r
                    %mi B
                  %annotation{:encoding => "application/x-tex"} Y\xrightarrow{r} B
              is the exponential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mi f
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \Pi_f g
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %h3#connection_to_distributivity Connection to distributivity
          %p
            In a category with pullbacks, for any pullback around
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f,g)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            exponentiable, we have a canonical Beck-Chevalley isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi r
                    %mo *
                  %msub
                    %mi f
                    %mo *
                  %mover
                    %mo →
                    %mo ≅
                  %msub
                    %mi q
                    %mo *
                  %msup
                    %mi p
                    %mo *
                  %msup
                    %mi g
                    %mo *
                  %mo .
                %annotation{:encoding => "application/x-tex"} r^* f_* \xrightarrow{\cong} q_* p^* g^* .
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/mate"} mate
            of the inverse of this is a transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                      %mo ,
                      %mi r
                  %mo :
                  %msub
                    %mi r
                    %mo !
                  %msub
                    %mi q
                    %mo *
                  %msup
                    %mi p
                    %mo *
                  %mo →
                  %msub
                    %mi f
                    %mo *
                  %msub
                    %mi g
                    %mo !
                %annotation{:encoding => "application/x-tex"} \delta_{p,q,r}:r_! q_* p^* \to f_* g_!
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              A pullback around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f,g)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              exponentiable is a distributivity pullback if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                        %mo ,
                        %mi r
                  %annotation{:encoding => "application/x-tex"} \delta_{p,q,r}
              is an isomorphism.
          .proof
            %h6#proof_2 Proof
            %p
              See
              = succeed "." do
                %a{:href => "#Weber"} (Weber, Proposition 2.2.3)
          %p
            Invertibility of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            expresses that
            %a.existingWikiWord{:href => "/nlab/show/dependent+products"} dependent products
            (the functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_*
            and
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mo *
                  %annotation{:encoding => "application/x-tex"} q_*
            %a.existingWikiWord{:href => "/nlab/show/dependent+sums"} dependent sums
            (the functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi g
                    %mo !
                %annotation{:encoding => "application/x-tex"} g_!
            and
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mo !
                  %annotation{:encoding => "application/x-tex"} r_!
          %p
            For instance, in the category of sets, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi z
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi z
                      %mo ∈
                      %mi Z
                %annotation{:encoding => "application/x-tex"} (C_z)_{z\in Z}
            is a
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mo *
                  %msub
                    %mi g
                    %mo !
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi b
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi b
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                  %msub
                    %mi C
                    %mi z
                %annotation{:encoding => "application/x-tex"} (f_* g_! C)_b = \prod_{f(a)=b} \sum_{g(z)=a} C_z
          %p while
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi r
                    %mo !
                  %msub
                    %mi q
                    %mo *
                  %msup
                    %mi p
                    %mo *
                  %mi C
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi b
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi b
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi y
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (r_! q_* p^* C)_b = \sum_{r(y)=b} \prod_{q(x)=y} C_{p(x)}
          %p
            As a very simple example, if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} B=1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} A=\{0,1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 00
                  %mo ,
                  %mn 01
                  %mo ,
                  %mn 02
                  %mo ,
                  %mn 10
                  %mo ,
                  %mn 11
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Z=\{00,01,02,10,11\}
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi i
                  %annotation{:encoding => "application/x-tex"} g(i j) = i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is the set of sections of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the set of pairs of a section and an element of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            the evaluation. Then if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mn 00
                    %mo ,
                    %msub
                      %mi C
                      %mn 01
                    %mo ,
                    %msub
                      %mi C
                      %mn 02
                    %mo ,
                    %msub
                      %mi C
                      %mn 10
                    %mo ,
                    %msub
                      %mi C
                      %mn 11
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C = (C_{00}, C_{01}, C_{02}, C_{10}, C_{11})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %msub
                    %mi g
                    %mo !
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 00
                  %mo +
                  %msub
                    %mi C
                    %mn 01
                  %mo +
                  %msub
                    %mi C
                    %mn 02
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 10
                  %mo +
                  %msub
                    %mi C
                    %mn 11
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_* g_! C = (C_{00} + C_{01} + C_{02}) \times (C_{10} + C_{11})
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi r
                    %mo !
                  %msub
                    %mi q
                    %mo *
                  %msup
                    %mi p
                    %mo *
                  %mi C
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 00
                  %mo ×
                  %msub
                    %mi C
                    %mn 10
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 00
                  %mo ×
                  %msub
                    %mi C
                    %mn 11
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 01
                  %mo ×
                  %msub
                    %mi C
                    %mn 10
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 01
                  %mo ×
                  %msub
                    %mi C
                    %mn 11
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 02
                  %mo ×
                  %msub
                    %mi C
                    %mn 10
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mn 02
                  %mo ×
                  %msub
                    %mi C
                    %mn 11
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  r_! q_* p^* C = (C_{00}\times C_{10}) + (C_{00}\times C_{11}) +
                  (C_{01}\times C_{10}) + (C_{01}\times C_{11}) +
                  (C_{02}\times C_{10}) + (C_{02}\times C_{11}).
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            of the ambient category, if we express
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            as
            %a.existingWikiWord{:href => "/nlab/show/dependent+types"} dependent types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi B
                  %mo ⊢
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Type
                  %mspace{:width => "2em"}
                  %mi and
                  %mspace{:width => "2em"}
                  %mi b
                  %mo :
                  %mi B
                  %mo ,
                  %mi a
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} b:B \vdash A(b) : Type \qquad and \qquad b:B, a:A(b) \vdash Z(b,a) : Type
          %p
            then the exponential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in a distributivity pullback is the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product+type"} dependent product type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi B
                  %mo ⊢
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Type
                  %mo .
                %annotation{:encoding => "application/x-tex"} b:B \vdash \prod_{a:A(b)} Z(b,a) : Type.
          %p
            and the distributivity isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            says that for any further dependent type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi B
                  %mo ,
                  %mi a
                  %mo :
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi z
                  %mo :
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ⊢
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} b:B, a:A(b), z:Z(b,a) \vdash W(b,a,z) : Type
          %p
            in the context of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi B
                %annotation{:encoding => "application/x-tex"} b:B
            we have an isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi ϕ
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %mo ≅
                  %mspace{:width => "2em"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi z
                      %mo :
                      %mi Z
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sum_{\phi:\prod_{a:A(b)} Z(b,a) } \prod_{a:A(b)} W(b,a,\phi(a)) \qquad \cong \qquad  \prod_{a:A(b)} \sum_{z:Z(b,a)} W(b,a,z).
          %p
            This isomorphism (or more specifically the left-to-right map) has traditionally been called the “axiom of choice” in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Martin-Lof+type+theory"} Martin-Lof type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                %annotation{:encoding => "application/x-tex"} \sum
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                %annotation{:encoding => "application/x-tex"} \prod
            are interpreted according to
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
            then it looks like the set-theoretic axiom of choice. However, this is not really appropriate, since this is a provable statement rather than an additional axiom, and does not have any of the usual strong consequences of the set-theoretic axiom of choice. See
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            for further discussion.
          %h3#connection_to_pullback_complements Connection to pullback complements
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is an isomorphism, then a distributivity pullback is also a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/final+pullback+complement"} final pullback complement
          %h3#connection_to_partial_products Connection to partial products
          %p
            Just as distributivity pullbacks encode the right adjoint to a
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            functor,
            %em partial products
            (as for example in
            = succeed ")" do
              %a{:href => "#Tholen"} Dyckhoff and Tholen, Section 2
            %em pullback functor
            – existence of such an adjoint is an equivalent condition for exponentiability of a morphism.
          %h2#related_pages Related pages
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/exponentiable+morphism"} exponentiable morphism
          %h2#references References
          %ul#Weber
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mark+Weber"}> Mark Weber
              ,
              = succeed "," do
                %em Polynomials in categories with pullbacks
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1106.1983"} arXiv
              %a{:href => "http://tac.mta.ca/tac/volumes/30/16/30-16abs.html"} TAC
          %ul
            %li#Tholen
              %span.newWikiWord>
                Roy Dyckhoff
                %a{:href => "/nlab/new/Roy+Dyckhoff"} ?
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
              = succeed "," do
                %em Exponentiable morphisms, partial products and pullback complements
              %a{:href => "https://doi.org/10.1016/0022-4049%2887%2990124-1"} doi:10.1016/0022-4049(87)90124-1
          %p
            Distributivity pullbacks are exhibited as
            %a.existingWikiWord{:href => "/nlab/show/bipullbacks"} bipullbacks
            in
            %a.existingWikiWord{:href => "/nlab/show/Span"} Span
            in §7 of:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "," do
                %em Polynomials as spans
              = succeed "&rbrack;" do
                %a{:href => "http://cahierstgdc.com/wp-content/uploads/2020/04/STREET-LXI-2.pdf"} pdf
