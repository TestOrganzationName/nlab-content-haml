          %h2#overview Overview
          %p
            %em DisCoPy
            is a toolbox for computing with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagrams
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            and
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} strong monoidal functors
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Python"} Python
            = succeed "." do
              %a{:href => "#GitHubDisCoPy"} GitHub
          %p
            The name stands for
            = succeed "," do
              %em Distributional Compositional Python
            %a.existingWikiWord{:href => "/nlab/show/DisCoCat"} DisCoCat
            models of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/natural+language"} natural language
          %h2#string_diagrams String diagrams
          %p
            The core data structure is
            = succeed "," do
              %a{:href => "https://discopy.readthedocs.io/en/main/_autosummary/discopy.monoidal.Diagram.html"}
                %code Diagram
            %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagrams
            in the
            %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/premonoidal+category"} premonoidal category
          %p
            Fix a monoidal
            %a.existingWikiWord{:href => "/nlab/show/signature+%28in+logic%29"} signature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo =
                  %msub
                    %mi Σ
                    %mn 1
                  %mover
                    %mo →
                    %mrow
                      %mtext dom
                      %mo ,
                      %mtext cod
                  %msubsup
                    %mi Σ
                    %mn 0
                    %mo ⋆
                %annotation{:encoding => "application/x-tex"} \Sigma = \Sigma_1 \xrightarrow{\text{dom}, \text{cod}} \Sigma_0^\star
            for a set of
            %em boxes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Sigma_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \Sigma_0
            and its
            %a.existingWikiWord{:href => "/nlab/show/free+monoid"} free monoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Σ
                      %mn 0
                      %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \Sigma_0^\star
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi s
                  %mo →
                  %mi t
                %annotation{:encoding => "application/x-tex"} f \colon s \to t
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msub
                    %mi Σ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f \in \Sigma_1
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext dom
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi s
                %annotation{:encoding => "application/x-tex"} \text{dom}(f) = s
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext cod
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi t
                  %annotation{:encoding => "application/x-tex"} \text{cod}(f) = t
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi Σ
                      %mn 0
                      %mo ⋆
                    %mo ×
                    %msub
                      %mi Σ
                      %mn 1
                    %mo ×
                    %msubsup
                      %mi Σ
                      %mn 0
                      %mo ⋆
                  %annotation{:encoding => "application/x-tex"} L(\Sigma) = \Sigma_0^\star \times \Sigma_1 \times \Sigma_0^\star
            %em layer
            is a triple
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi s
                    %mo →
                    %mi t
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} l = (u, f \colon s \to t, v) \in L(\Sigma)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext dom
                  %mo{:stretchy => "false"} (
                  %mi l
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi u
                  %mi s
                  %mi v
                %annotation{:encoding => "application/x-tex"} \text{dom}(l) = u s v
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext cod
                    %mo{:stretchy => "false"} (
                    %mi l
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi u
                    %mi t
                    %mi v
                  %annotation{:encoding => "application/x-tex"} \text{cod}(l) = u t v
            = succeed "-notation," do
              %a.existingWikiWord{:href => "/nlab/show/string+diagram"} string diagram
