            %path{:d => "M 28.347875 7.087625 C 28.347875 4.322 28.347875 2.763406 28.347875 0.0016875 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.3985", :transform => "matrix(1, 0, 0, -1, 0.199, 34.822)"}
            %path{:d => "M 21.261937 7.087625 L 35.433813 7.087625 L 35.433813 21.2595 L 21.261937 21.2595 L 21.261937 7.087625 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.3985", :transform => "matrix(1, 0, 0, -1, 0.199, 34.822)"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "25.022", "xlink:href" => "#lKscsD4n1ZhHMcP-d8zYVdilaPA=-glyph-0-5", :y => "23.637"}
          %p
            The set of
            %em diagrams
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(\Sigma)
            is the
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} set of arrows
            in the
            %a.existingWikiWord{:href => "/nlab/show/free+category"} free category
            %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
            by the layers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(\Sigma)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is given by a length
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext len
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \text{len}(d) = n \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext dom
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msubsup
                    %mi Σ
                    %mn 0
                    %mo ⋆
                %annotation{:encoding => "application/x-tex"} \text{dom}(d) \in \Sigma_0^\star
            and a list of layers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} layers
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi d
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} \layers(d) = (d_1, \dots, d_n) \in L(\Sigma)^n
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext dom
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mtext dom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \text{dom}(d) = \text{dom}(d_0)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext cod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mtext dom
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi d
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \text{cod}(d_i) = \text{dom}(d_{i + 1})
            for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i \leq n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} cod
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} cod
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \cod(d) = \cod(d_n)
          %p
            Note that in order to define a diagram uniquely, its layers have more data than necessary. It is enough to specify a list
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} boxes
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msubsup
                    %mi Σ
                    %mn 1
                    %mi n
                %annotation{:encoding => "application/x-tex"} \boxes(d) \in \Sigma_1^n
            of generators together with a list
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} offsets
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} N
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \offsets(d) \in \N^n
            = succeed "," do
              %a{:href => "#DelpeuchVicary18"} Delpeuch and Vicary (2018)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Globular"} Globular
            %a.existingWikiWord{:href => "/nlab/show/homotopy.io"} homotopy.io
            as well as DisCoPy.
          %p We can define identity, composition and tensor of diagrams in terms of this combinatorial encoding:
          %ul
            %li
              The identity diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext id
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \text{id}(x)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msubsup
                      %mi Σ
                      %mn 0
                      %mo ⋆
                  %annotation{:encoding => "application/x-tex"} x \in \Sigma_0^\star
              is defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext len
                    %mo{:stretchy => "false"} (
                    %mtext id
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \text{len}(\text{id}(x)) = 0
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtext dom
                      %mo{:stretchy => "false"} (
                      %mtext id
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \text{dom}(\text{id}(x)) = x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %li
              Given two diagrams
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 0
                    %mo ,
                    %msub
                      %mi d
                      %mn 1
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_0, d_1 \in D(\Sigma)
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtext cod
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mtext dom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \text{cod}(d_0) = \text{dom}(d_1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo ∘
                    %msub
                      %mi d
                      %mn 0
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_1 \circ d_0 \in D(\Sigma)
              is defined by vertical concatenation, i.e.
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtext layers
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo ∘
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mtext layers
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mtext layers
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \text{layers}(d_1 \circ d_0) = \text{layers}(d_0) \text{layers}(d_1)
              %code d0 &gt;&gt; d1
              or
              = succeed "." do
                %code d1 &lt;&lt; d0
            %li
              Given a diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \in D(\Sigma)
              and a type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msubsup
                        %mi Σ
                        %mn 0
                        %mo ⋆
                    %annotation{:encoding => "application/x-tex"} x \in \Sigma_0^\star
              %a.existingWikiWord{:href => "/nlab/show/whiskering"} whiskerings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊗
                    %mi d
                  %annotation{:encoding => "application/x-tex"} x \otimes d
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ⊗
                    %mi x
                  %annotation{:encoding => "application/x-tex"} d \otimes x
              are defined by concatenating
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              with
              = succeed "-labeled" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo ,
                    %mi f
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} l = (u, f, v) \in L(\Sigma)
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ⊗
                    %mi l
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi u
                    %mo ,
                    %mi f
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \otimes l = (x u, f, v)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi l
                      %mo ⊗
                      %mi x
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo ,
                      %mi f
                      %mo ,
                      %mi v
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} l \otimes x = (u, f, v x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext layers
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⊗
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ⊗
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi x
                    %mo ⊗
                    %msub
                      %mi d
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \text{layers}(x \otimes d) = (x \otimes d_1, \dots, x \otimes d_n)
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtext layers
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ⊗
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo ⊗
                      %mi x
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi d
                        %mi n
                      %mo ⊗
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \text{layers}(d \otimes x) = (d_1 \otimes x, \dots, d_n \otimes x)
            %li
              Given two diagrams
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo ,
                      %msub
                        %mi d
                        %mn 1
                      %mo ∈
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_0, d_1 \in D(\Sigma)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                      %mo ⊗
                      %msub
                        %mi d
                        %mn 1
                      %mo =
                      %mtext cod
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %msub
                        %mi d
                        %mn 1
                      %mo ∘
                      %msub
                        %mi d
                        %mn 0
                      %mo ⊗
                      %mtext dom
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_0 \otimes d_1 = \text{cod}(d_0) \otimes d_1 \circ d_0 \otimes \text{dom}(d_1)
              = succeed "." do
                %code d0 @ d1 == d0 @ Id(d1.dom) &gt;&gt; Id(d0.cod) @ d1
          %p
            Diagrams in the free
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            can be seen as premonoidal diagrams quotiented by the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/interchanger"} interchanger
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} monoidal product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ⊗
                  %msub
                    %mn 1
                    %mi c
                  %mo ∘
                  %msub
                    %mn 1
                    %mi b
                  %mo ⊗
                  %mi g
                  %mo =
                  %msub
                    %mn 1
                    %mi a
                  %mo ⊗
                  %mi g
                  %mo ∘
                  %mi f
                  %mo ⊗
                  %msub
                    %mn 1
                    %mi d
                %annotation{:encoding => "application/x-tex"} f \otimes 1_c \circ 1_b \otimes g = 1_a \otimes g \circ f \otimes 1_d
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi a
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} f : a \to b
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} g : c \to d
            %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
            can be seen as monoidal diagrams with generators for cups and caps quotiented by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} snake equations
            = succeed "." do
              %code Diagram.normal_form
          %p
            Diagrams are equipped with an involution
            %code Diagram.dagger
            that implements
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dagger+categories"} dagger categories
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoids
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/balanced+monoidal+categories"} balanced monoidal categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/traced+monoidal+categories"} traced monoidal categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+categories"} closed monoidal categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/pivotal+categories"} pivotal categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/ribbon+categories"} ribbon categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/compact+categories"} compact categories
          %p
            DisCoPy also implements diagrams in
            %a.existingWikiWord{:href => "/nlab/show/hypergraph+categories"} hypergraph categories
            in two different ways:
          %ul
            %li
              as diagrams with
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebras"} Frobenius algebras
              on every object,
            %li
              as cospans of labeled hypergraphs, following
              = succeed "." do
                %a{:href => "#BonchiEtAl22"} Bonchi et al. (2022)
          %h2#monoidal_functors Monoidal functors
          %p
            Diagrams can be evaluated in concrete monoidal categories by applying
            %a{:href => "https://discopy.readthedocs.io/en/main/_autosummary/discopy.monoidal.Functor.html"}
              %code Functor
            instances to them.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                  %mo :
                  %mtext MonSig
                  %mo →
                  %mtext MonCat
                %annotation{:encoding => "application/x-tex"} \mathcal{F} : \text{MonSig} \to \text{MonCat}
            be the functor that sends a monoidal signature to its free monoidal category, and its right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒰
                  %mo :
                  %mtext MonCat
                  %mo →
                  %mtext MonSig
                %annotation{:encoding => "application/x-tex"} \mathcal{U} : \text{MonCat} \to \text{MonSig}
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi ℱ
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} F : \mathcal{F}(\Sigma) \to S
            from a free monoidal category generated by a signature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            into some monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is uniquely defined by a morphism of signature
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi Σ
                    %mo →
                    %mi 𝒰
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F : \Sigma \to \mathcal{U}(S)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi ℱ
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} F : \mathcal{F}(\Sigma) \to S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 0
                  %mo :
                  %msub
                    %mi Σ
                    %mn 0
                  %mo →
                  %mtext Ob
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_0 : \Sigma_0 \to \text{Ob}(S)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 1
                  %mo :
                  %msub
                    %mi Σ
                    %mn 1
                  %mo →
                  %mtext Ar
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_1 : \Sigma_1 \to \text{Ar}(S)
            which commute with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext dom
                %annotation{:encoding => "application/x-tex"} \text{dom}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext cod
                  %annotation{:encoding => "application/x-tex"} \text{cod}
          %p
            Concretely, a DisCoPy functor is defined by
            %code F = Functor(ob, ar)
            where
            %code ob
            and
            %code ar
            are mappings from generating object to types and from box to diagram respectively. These mappings can be either given as Python dictionaries if they have finite domains or as Python functions otherwise. Once its image for each generating object and each box is given,
            %code F
            can be applied to arbitrary diagrams. An optional argument
            %code cod
            can be used to define functors with arbitrary categories as codomain. The domain of the functor is given implicitly by the domain of the
            %code ob
            and
            %code ar
            maps. By default DisCoPy functors are endofunctors from the free category to itself, i.e. they send diagrams to diagrams.
          %p
            Currently, DisCoPy implements
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functors"} strong monoidal functors
            into:
          %ul
            %li
              %p
                the category of
                %a.existingWikiWord{:href => "/nlab/show/Python"} Python
                functions,
            %li
              %p
                the category of
                %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
                in arbitrary
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/rig"} semirings
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+spaces"} finite dimensional vector spaces
                and finite
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/relation"} relations
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                or the
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                as monoidal product,
            %li
              %p
                the category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+channels"} quantum channels
            %li
              %p
                the category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+circuits"} quantum circuits
          %p
            Thus, DisCoPy can be used as an implementation of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/categorical+quantum+mechanics"} categorical quantum mechanics
          %h2#natural_language_processing Natural language processing
          %p
            Diagrams can be used to encode derivations in a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formal+grammar"} formal grammar
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/semantics"} semantics
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/formal+grammar"} formal grammar
              where derivations are diagrams in a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              and in particular
              %a.existingWikiWord{:href => "/nlab/show/context-free+grammar"} context-free grammar
              where derivations are syntax trees,
            %li
              %a.existingWikiWord{:href => "/nlab/show/categorial+grammar"} categorial grammar
              where derivations are diagrams in a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
            %li
              %a.existingWikiWord{:href => "/nlab/show/pregroup+grammar"} pregroup grammar
              and
              %a.existingWikiWord{:href => "/nlab/show/dependency+grammar"} dependency grammar
              where derivations are diagrams in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rigid+monoidal+category"} rigid monoidal category
          %h2#references References
          %ul
            %li
              %p
                Giovanni de Felice,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexis+Toumi"} Alexis Toumi
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Bob Coecke
                = succeed "." do
                  %em DisCoPy: Monoidal Categories in Python
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2005.02975"} arXiv:2005.02975
            %li
              %p
                Konstantinos Meichanetzidis, Stefano Gogioso, Giovanni De Felice, Nicolò Chiappori,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexis+Toumi"} Alexis Toumi
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Bob+Coecke"} Bob Coecke
                = succeed "." do
                  %em Quantum Natural Language Processing on Near-Term Quantum Computers
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2005.04147"} arXiv:2005.04147
            %li#DelpeuchVicary18
              %p
                Delpeuch, Antonin, and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jamie+Vicary"} Jamie Vicary
                %em Normalization for planar string diagrams and a quadratic equivalence algorithm.
                arXiv preprint
                %a{:href => "https://arxiv.org/abs/1804.07832"} arXiv:1804.07832
                (2018).
            %li#BonchiEtAl22
              %p
                Filippo Bonchi, Fabio Gadducci, Aleks Kissinger, Pawel Sobocinski, Fabio Zanasi,
                %em String Diagram Rewrite Theory I: Rewriting with Frobenius Structure.
                %a{:href => "https://doi.org/10.1145/3502719"} DOI:10.1145/3502719
                (2022).
            %li#DisCoPyDoc
              %p
                %em DisCoPy’s documentation.
                %a{:href => "https://docs.discopy.org/"} discopy.readthedocs.io
            %li#GitHubDisCoPy
              %p
                %em DisCoPy’s repository.
                %a{:href => "https://github.com/discopy/discopy"} github.com/discopy/discopy
