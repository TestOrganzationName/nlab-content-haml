                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAAA
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega(v,w)
                    \\;=\;
                    g(J(v),w)
                    \\phantom{AAAAA}
                    g(v,w)
                    \\;=\;
                    \\omega(v,J(v))
                    \\,.
            %p Finally
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi h
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    h(J(-),J(-)) = h(-,-)
            %p
              and so the Riemannian metrics
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              appearing from (and fully determining) Hermitian forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              via
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo =
                    %mi g
                    %mo −
                    %mi i
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} h = g - i \omega
              are precisely those for which
            #eq:HermitianMetric.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g(J(-),J(-)) = g(-,-)
                    \\,.
            %p
              These are called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+metrics"} Hermitian metrics
          .proof
            %h6#proof Proof
            %p
              The positive-definiteness of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is immediate from that of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              follows from the symmetric sesquilinearity of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mrow
                              %mo (
                              %mi h
                              %mo{:stretchy => "false"} (
                              %mi v
                              %mo ,
                              %mi w
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    g(w,v)
                    \&amp; \coloneqq
                    Re(h(w,v))
                    \\\
                    \&amp; =
                    Re\left( h(v,w)^\ast\right)
                    \\\
                    \&amp; =
                    Re(h(v,w))
                    \\\
                    \&amp; =
                    g(v,w)
                    \\,.
                    \\end{aligned}
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              is invariant under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              follows from its sesquilinarity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi i
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi i
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    h(J(v),J(w))
                    \&amp;=
                    i h(v,J(w))
                    \\\
                    \&amp; =
                    i (h(J(w),v))^\ast
                    \\\
                    \&amp; =
                    i (-i) (h(w,v))^\ast
                    \\\
                    \&amp; =
                    h(v,w)
                    \\end{aligned}
            %p
              and this immediately implies the corresponding invariance of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            %p
              Analogously it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is skew symmetric:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo ,
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mrow
                              %mo (
                              %mi h
                              %mo{:stretchy => "false"} (
                              %mi v
                              %mo ,
                              %mi w
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega(w,v)
                    \&amp; \coloneqq
                    \-Im(h(w,v))
                    \\\
                    \&amp; =
                    \-Im\left( h(v,w)^\ast\right)
                    \\\
                    \&amp; =
                    Im(h(v,w))
                    \\\
                    \&amp; = - \omega(v,w)
                    \\,,
                    \\end{aligned}
            %p and the relation between the two components:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega(v,w)
                    \&amp; =
                    \- Im(h(v,w))
                    \\\
                    \&amp; =
                    Re(i h(v,w))
                    \\\
                    \&amp; =
                    Re(h(J(v),w))
                    \\\
                    \&amp; =
                    g(J(v),w)
                    \\end{aligned}
            %p as well as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi J
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Im
                            %mo{:stretchy => "false"} (
                            %mi h
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    g(v,w)
                    \&amp; =
                    Re(h(v,w)
                    \\\
                    \&amp; =
                    Im(i h(v,w))
                    \\\
                    \&amp; =
                    Im(h(J(v),w))
                    \\\
                    \&amp; =
                    Im(h(J^2(v),J(w)))
                    \\\
                    \&amp; =
                    \- Im(h(v,J(w)))
                    \\\
                    \&amp; = \omega(v,J(w))
                    \\,.
                    \\end{aligned}
          %p As a corollary:
          #RelationBetweenKaehlerVectorSpacesAndHermitianSpaces.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (relation between
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+spaces"} Kähler vector spaces
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+spaces"} Hermitian spaces
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              with a
              %a.existingWikiWord{:href => "/nlab/show/linear+complex+structure"} linear complex structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo ∈
                        %msup
                          %mo ∧
                          %mn 2
                        %msup
                          %mi V
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \omega \in \wedge^2 V^\ast
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/linear+K%C3%A4hler+structure"} linear Kähler structure
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#KaehlerVectorSpace"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi V
                        %mo ⊗
                        %mi V
                        %mo →
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} g \in V \otimes V \to  \mathbb{R}
                  is a positive definite
                  %a.existingWikiWord{:href => "/nlab/show/Hermitian+metric"} Hermitian metric
                  %a.maruku-eqref{:href => "#eq:HermitianMetric"} (2)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              are related by
              %a.maruku-eqref{:href => "#eq:RelationBetweennOmegaAndgOnHermitianSpace"} (1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAAAA
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega(v,w)
                    \\;=\;
                    g(J(v),w)
                    \\phantom{AAAAA}
                    g(v,w)
                    \\;=\;
                    \\omega(v,J(v))
                    \\,.
            %p
              Hence Kähler vector spaces are equivalently the
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
              complex
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
          %h2#examples Examples
          %p The archetypical elementary example is the following:
          #StandardAlmostKaehlerVectorSpaces.num_example
            %h6#example Example
            %p
              %strong
                (standard
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V \coloneqq \mathbb{R}^2
              be the 2-dimensional
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              which is given by the canonical identification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                      %mo ≃
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 \simeq \mathbb{C}
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_i)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi J
                      %mi i
                    %msub
                      %mrow
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    J = (J^i{}_j)
                    \\coloneqq
                    \\left(
                    \\array{
                    0 &amp; -1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\,.
            %p Moreover let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ω
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = (\omega_{i j}) \coloneqq \left( \array{0 &amp; 1 \\ -1 &amp; 0} \right)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g = (g_{i j}) \coloneqq \left( \array{ 1 &amp; 0 \\ 0 &amp; 1}  \right)
                    \\,.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi J
                    %mo ,
                    %mi ω
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, J, \omega, g)
              is a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+vector+space"} Kähler vector space
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#KaehlerVectorSpace"}
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              in the standard way and equipped with the
              %a.existingWikiWord{:href => "/nlab/show/bilinear+forms"} bilinear forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ,
                    %mi ω
                    %mi g
                  %annotation{:encoding => "application/x-tex"} J, \omega g
              extended as constant rank-2
              %a.existingWikiWord{:href => "/nlab/show/tensors"} tensors
              over this manifold.
            %p If we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    x,y \;\colon\; \mathbb{R}^2 \longrightarrow \mathbb{R}
            %p
              for the standard
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ≔
                    %mi x
                    %mo +
                    %mi i
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    z \coloneqq x + i y \;\coloneqq\; \mathbb{R}^2 \to \mathbb{C}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi z
                      %mo ¯
                    %mo ≔
                    %mi x
                    %mo −
                    %mi i
                    %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{z} \coloneqq x - i y \;\coloneqq\; \mathbb{R}^2 \to \mathbb{C}
            %p for the corresponding complex coordinates, then this translates to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega
                    \\in
                    \\Omega^2(\mathbb{R}^2)
            %p
              being the
              %a.existingWikiWord{:href => "/nlab/show/differential+2-form"} differential 2-form
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                          %mtd
                            %mo =
                            %mi d
                            %mi x
                            %mo ∧
                            %mi d
                            %mi y
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 2
                                  %mi i
                            %mi d
                            %mi z
                            %mo ∧
                            %mi d
                            %mover
                              %mi z
                              %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega
                    \&amp; =
                    d x \wedge d y
                    \\\
                    \&amp; =
                    \\tfrac{1}{2i} d z \wedge d \overline{z}
                    \\end{aligned}
            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              %a.existingWikiWord{:href => "/nlab/show/tensor"} tensor
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo =
                    %mi d
                    %mi x
                    %mo ⊗
                    %mi d
                    %mi x
                    %mo +
                    %mi d
                    %mi y
                    %mo ⊗
                    %mi d
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g = d x \otimes d x + d y \otimes d y
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi h
                          %mtd
                            %mo =
                            %mi g
                            %mo −
                            %mi i
                            %mi ω
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %mi z
                            %mo ⊗
                            %mi d
                            %mover
                              %mi z
                              %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    h
                    \&amp; =
                    g - i \omega
                    \\\
                    \&amp; =
                    d z \otimes d \overline{z}
                    \\end{aligned}
          .proof
            %h6#proof_2 Proof
            %p
              This is elementary, but, for the record, here is one way to make it fully explicit (we use
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
              and “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} \cdot
              ” denotes
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ω
                              %mrow
                                %mi i
                                %mi j
                                %mo ′
                            %msup
                              %mi J
                              %mrow
                                %mi j
                                %mo ′
                            %msub
                              %mrow
                              %mi j
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mn 1
                                  %mtr
                                    %mtd
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                    %mtd
                                      %mn 0
                              %mo )
                            %mo ⋅
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                                  %mtr
                                    %mtd
                                      %mn 1
                                    %mtd
                                      %mn 0
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo (
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %mn 1
                                    %mtd
                                      %mn 0
                                  %mtr
                                    %mtd
                                      %mn 0
                                    %mtd
                                      %mn 1
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi g
                              %mrow
                                %mi i
                                %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega_{i j'} J^{j'}{}_j
                    \&amp; =
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    \-1 &amp; 0
                    }
                    \\right)
                    \\cdot
                    \\left(
                    \\array{
                    0 &amp; -1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\\
                    \&amp;
                    \=
                    \\left(
                    \\array{
                    1 &amp; 0
                    \\\
                    0 &amp; 1
                    }
                    \\right)
                    \\\
                    \&amp; =
                    g_{i j}
                    \\end{aligned}
            %p and similarly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi J
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mi j
                          %mtd
                            %mo =
                            %msub
                              %mi ω
                              %mrow
                                %mi i
                                %mo ′
                                %mi j
                                %mo ′
                            %msup
                              %mi J
                              %mrow
                                %mi i
                                %mo ′
                            %msub
                              %mrow
                              %mi i
                            %msup
                              %mi J
                              %mrow
                                %mi j
                                %mo ′
                            %msub
                              %mrow
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi J
                              %mi t
                            %mo ⋅
                            %mi ω
                            %mo ⋅
                            %mi J
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mrow
                                %mo (
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mn 0
                                        %mtd
                                          %mn 1
                                      %mtr
                                        %mtd
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                        %mtd
                                          %mn 0
                                  %mo )
                                %mo ⋅
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mn 0
                                        %mtd
                                          %mn 1
                                      %mtr
                                        %mtd
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                        %mtd
                                          %mn 0
                                  %mo )
                                %mo ⋅
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mn 0
                                        %mtd
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                      %mtr
                                        %mtd
                                          %mn 1
                                        %mtd
                                          %mn 0
                                  %mo )
                                %mo )
                              %mrow
                                %mi i
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mrow
                                %mo (
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                        %mtd
                                          %mn 0
                                      %mtr
                                        %mtd
                                          %mn 0
                                        %mtd
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                  %mo )
                                %mo ⋅
                                %mrow
                                  %mo (
                                  %mrow
                                    %mtable
                                      %mtr
                                        %mtd
                                          %mn 0
                                        %mtd
                                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                          %mn 1
                                      %mtr
                                        %mtd
                                          %mn 1
                                        %mtd
                                          %mn 0
                                  %mo )
                                %mo )
                              %mrow
                                %mi i
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mrow
                                %mo (
                                %mrow
                                  %mtable
                                    %mtr
                                      %mtd
                                        %mn 0
                                      %mtd
                                        %mn 1
                                    %mtr
                                      %mtd
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mn 1
                                      %mtd
                                        %mn 0
                                %mo )
                              %mrow
                                %mi i
                                %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ω
                              %mrow
                                %mi i
                                %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\omega(J(-),J(-))_{i j}
                    \&amp; =
                    \\omega_{i' j'} J^{i'}{}_{i} J^{j'}{}_{j}
                    \\\
                    \&amp; =
                    (J^t \cdot \omega \cdot J)_{i j}
                    \\\
                    \&amp; =
                    \\left(
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    \-1 &amp; 0
                    }
                    \\right)
                    \\cdot
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    \-1 &amp; 0
                    }
                    \\right)
                    \\cdot
                    \\left(
                    \\array{
                    0 &amp; -1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\right)_{i j}
                    \\\
                    \&amp; =
                    \\left(
                    \\left(
                    \\array{
                    \-1 &amp; 0
                    \\\
                    0 &amp; -1
                    }
                    \\right)
                    \\cdot
                    \\left(
                    \\array{
                    0 &amp; -1
                    \\\
                    1 &amp; 0
                    }
                    \\right)
                    \\right)_{i j}
                    \\\
                    \&amp; =
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    \-1 &amp; 0
                    }
                    \\right)_{i j}
                    \\\
                    \&amp; =
                    \\omega_{i j}
                    \\end{aligned}
