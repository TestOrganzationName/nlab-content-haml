                  %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi V
                        %mo ⊗
                        %mi V
                        %mo ⟶
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"}
                        h \;\colon\; V \otimes V \longrightarrow \mathbb{C}
            %p
              such that this is
              = succeed "," do
                %em symmetric sesquilinear
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                      %annotation{:encoding => "application/x-tex"} h
                  is complex-linear in the first argument;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
