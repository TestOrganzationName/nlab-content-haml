                        %mi v
                        %mo ,
                        %mi v
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mphantom
                          %mi AA
                        %mo ⇔
                        %mphantom
                          %mi AA
                        %mi v
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} h(v,v) = 0 \phantom{AA} \Leftrightarrow \phantom{AA} v = 0
                  \.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
