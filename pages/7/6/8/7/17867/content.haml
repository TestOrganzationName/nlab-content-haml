                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mo{:stretchy => "false"} ⟨
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} ⟩
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} a \in \langle A \rangle_1
                there exists
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
