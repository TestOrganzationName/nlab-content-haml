                      %annotation{:encoding => "application/x-tex"} a^2 = c
          %p
            The
            = succeed "-vectors" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
