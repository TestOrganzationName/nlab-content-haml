                    %semantics
                      %mrow
                        %mi n
                        %mo :
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n:\mathbb{N}
                = succeed "-multivector" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                = succeed "-multivector" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-multivector:" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo +
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (m+n)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mo{:stretchy => "false"} |
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi m
                    %annotation{:encoding => "application/x-tex"} a \in \vert A \vert_m
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mo{:stretchy => "false"} |
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi n
                      %annotation{:encoding => "application/x-tex"} b \in \vert A \vert_n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mo{:stretchy => "false"} |
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mi m
                          %mo +
                          %mi n
                    %annotation{:encoding => "application/x-tex"} c \in \vert A \vert_{m+n}
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mi b
                      %mo =
                      %mi c
