          %p
            Reformulated in terms of covariant functors, a dual adjunction can be viewed as an ordinary adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊣
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \dashv G
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} F: C \to D^{op}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %msup
                      %mi D
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} G: D^{op} \to C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ⊣
                  %mi F
                %annotation{:encoding => "application/x-tex"} G \dashv F
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %mi D
                  %mo →
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} G: D \to C^{op}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F: C^{op} \to D
          %p
            A
            %em self-dual
            adjunction is a dual adjunction for which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %mi G
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F = G: C \to C
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo =
                    %mi θ
                    %mo :
                    %mn 1
                    %mo →
                    %mi F
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \eta = \theta: 1 \to F F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+closed+category"} symmetric monoidal closed category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F = [-, d]
            is an internal hom into an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi c
                    %mo :
                    %mi c
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \delta_c: c \to [[c, d], d]
