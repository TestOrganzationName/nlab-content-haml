            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#idea Idea
          %p
            A
            %em dual adjunction
            between
            %a.existingWikiWord{:href => "/nlab/show/category"} categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction
            between the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p
            The concept arises in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/duality"} duality
          %p
            Dual adjunctions between
            %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete categories
            are frequently represented by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dualizing+objects"} dualizing objects
          %p
            Dual adjunctions between
            %a.existingWikiWord{:href => "/nlab/show/posets"} posets
            are also called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Galois+connections"} Galois connections
          %h2#definition Definition
          %p
            A
            %em dual adjunction
            consists of
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functors"} contravariant functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} F: C \to D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} G: D \to C
            together with natural transformations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %msub
                    %mn 1
                    %mi C
                  %mo →
                  %mi G
                  %mi F
                %annotation{:encoding => "application/x-tex"} \eta: 1_C \to G F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo :
                  %msub
                    %mn 1
                    %mi D
                  %mo →
                  %mi F
                  %mi G
                %annotation{:encoding => "application/x-tex"} \theta: 1_D \to F G
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mi η
                  %mo ∘
                  %mi θ
                  %mi F
                  %mo =
                  %msub
                    %mn 1
                    %mi F
                %annotation{:encoding => "application/x-tex"} F \eta \circ \theta F = 1_F
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi θ
                    %mo ∘
                    %mi η
                    %mi G
                    %mo =
                    %msub
                      %mn 1
                      %mi G
                  %annotation{:encoding => "application/x-tex"} G \theta \circ \eta G = 1_G
