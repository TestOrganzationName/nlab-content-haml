                        %a.existingWikiWord{:href => "/nlab/show/derived+geometry"} derived geometry
                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Deligne+conjecture"} Deligne conjecture
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/delooping+hypothesis"} delooping hypothesis
                    %li
