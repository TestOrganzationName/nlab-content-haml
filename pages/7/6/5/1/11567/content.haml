                ,
                = succeed "," do
                  %em The extraordinary derived category
                %strong 196
                2 (1987) 231-238 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF01163657"}> doi:10.1007/BF01163657
                \&amp;rbrack;
            %li#SchwedeShipley03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
                = succeed "," do
                  %em Stable model categories are categories of modules
                = succeed "," do
                  %a{:href => "http://www.math.uic.edu/~bshipley/classTopFinal.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S0040-9383(02)00006-X"} doi:10.1016/S0040-9383(02)00006-X
            %li#Shipley02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"}> Brooke Shipley
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi H
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} H \mathbb{Z}
                    \-algebra spectra are differential graded algebras
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/0209215"} arXiv:math/0209215
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/40068065"} jstor:40068065
            %li#Jardine91
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Frederick+Jardine"}> John Frederick Jardine
                ,
                = succeed "," do
                  %em Stable Dold-Kan theory
                = succeed "," do
                  %em Generalized Étale cohomology theories
            %li#BCT
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"}> Andrew Blumberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ralph+Cohen"} Ralph Cohen
