                    %annotation{:encoding => "application/x-tex"} Fib_E \;\colon\; \Pi_1(X) \to Core(Set)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
