                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Grpd)
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are small groupoids;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                  of groupoid homomorphisms modulo homotopy (i.e.
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                  modulo
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            %p
              This is usually denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Grpd
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Grpd)
          %p
            Of course what the above really means is that, without quotienting out homotopies, groupoids form a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            which is enriched over the naive 1-category of groupoids from remark
            = succeed "," do
              %a.maruku-ref{:href => "#1CategoryOfGroupoids"}
            %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoids"} hom-groupoids
          #EquivalenceOfGroupoids.num_defn
            %h6#definition_13 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"}> equivalence of groupoids
                )
            %p
              Given two groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    F\;\colon\; \mathcal{G}_1 \longrightarrow \mathcal{G}_2
            %p
              is an
              %em
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence
              if it is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Grpd)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#HomotopyCategoryOfGroupoids"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒢
                      %mn 2
                    %mo ⟶
                    %msub
                      %mi 𝒢
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    G \;\colon\; \mathcal{G}_2 \longrightarrow \mathcal{G}_1
            %p and a homotopy/natural transformations of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∘
                    %mi F
                    %mo ≃
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi 𝒢
                          %mn 1
                    %mphantom
                      %mi AAAA
                    %mi F
                    %mo ∘
                    %mi G
                    %mo ≃
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi 𝒢
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G \circ F \simeq id_{\mathcal{G}_1}
                    \\phantom{AAAA}
                    F \circ G \simeq id_{\mathcal{G}_2}
                    \\,.
          #FundamentalGroupoid2Functor.num_example
            %h6#example_10 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-functor"} (2,1)-functoriality
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              between them, then this induces a groupoid homomorphism (functor) between the respective
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoids"} fundamental groupoids
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalGroupoid"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_f \;\colon\; \Pi_1(X) \longrightarrow \Pi_1(Y)
            %p
              given on objects by the underlying function of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo ≔
                    %mi f
                  %annotation{:encoding => "application/x-tex"}
                    (F_f)_0 \coloneqq f
            %p
              and given on the class of a
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              by the evident postcomposition with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi γ
                        %mo{:stretchy => "false"} ]
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi f
                        %mo ∘
                        %mi γ
                        %mo{:stretchy => "false"} ]
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (F_f)_{x,y}
                    \\;\colon\;
                    (x \overset{[\gamma]}{\longrightarrow} y)
                    \\;\mapsto\;
                    (f(x) \overset{[f \circ \gamma]}{\longrightarrow} f(y) )
                    \\,.
            %p
              This construction clearly respects
              %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
              and
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              and hence is itself a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Top
                    %mo ⟶
                    %msub
                      %mi Grpd
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_1 \;\colon\; Top \longrightarrow Grpd_1
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              to the
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              of groupoids.
            %p
              But more is true: If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f,g \;\colon\; X \longrightarrow Y
              are two
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ⇒
                    %mi g
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; f \Rightarrow g
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              between them, hence a continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; X \times [0,1] \longrightarrow Y
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \eta(-,0) = f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi g
                    %annotation{:encoding => "application/x-tex"} \eta(-,1) = g
            %p
              This shows that the fundamental groupoid functor in fact descends to
              %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Top
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_1 \;\colon\; Ho(Top) \longrightarrow Ho(Grpd)
                    \\,.
            %p
              (In fact this means it even extends to a
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-functor"} (2,1)-functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              of topological spaces, continuous functions, and
              = succeed "-classes" do
                %a.existingWikiWord{:href => "/nlab/show/higher+homotopy"} higher homotopy
            %p
              As a direct consequence it follows that if there is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %msub
                      %mo ≃
                      %mi h
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq_h Y
            %p
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
              between their
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoids"} fundamental groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_1(X) \simeq \Pi_1(Y)
                    \\,.
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+invariant"} homotopy invariant
              of topological spaces. Of course by prop.
              %a.maruku-ref{:href => "#DeloopingGroupoidEquivalence"}
              the fundamental groupoid is equivalent, as a groupoid, to the disjoint union of the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
              of all the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
              of the given topological spaces, one for each
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
          #GroupoidFromDelooping.num_example
            %h6#example_11 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} B G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{B G}(p,p) \coloneqq G
            %p
              the elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and with inverse morphisms the inverse elements in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              This is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (because the
              %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              at the unique point is the given group:
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mi B
                      %mi G
                      %mo ≃
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \Omega B G \simeq G
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                    %mo ,
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_1, G_2
              two groups, then there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              between
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphisms"} group homomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi G
                      %mn 1
                    %mo →
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi \colon G_1 \to G_2
              and groupoid homomorphisms
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %msub
                        %mi G
                        %mn 1
                      %mo →
                      %mi B
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} B G_1 \to B G_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} B \phi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi ϕ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} (B \phi)_0
              uniquely fixed and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mi ϕ
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi p
                          %mo ,
                          %mi p
                      %mo =
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} (B \phi)_{p,p} = \phi
            %p
              This means that the construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(-)
              is a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Grp
                    %mo ↪
                    %msub
                      %mi Grpd
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    B(-) \;\colon\; Grp \hookrightarrow Grpd_1
            %p
              into from the category
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              of groups to the
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %p But beware that this functor is not fully faithful when homotopies of groupoids are taken into account, because there are in general non-trivial homotopies between morphisms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %mi B
                    %msub
                      %mi ϕ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi G
                    %mo ⟶
                    %mi B
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    B \phi_1, B \phi_2
                    \\;\colon\;
                    B G \longrightarrow B H
            %p
              By definition, such a homotopy (natural transformation)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ⇒
                    %mi B
                    %msub
                      %mi ϕ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \eta \;\colon\; B \phi_1 \Rightarrow B \phi_2
              is a choice of a single element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi p
                    %mo ∈
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \eta_p \in H
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi h
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msup
                      %mi h
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mphantom
                      %mi AAAAAAAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi p
                          %mtd
                            %mover
                              %mo ⟶
                              %mi h
                          %mtd
                            %mi p
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mn 1
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mn 2
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi p
                          %mtd
                            %munder
                              %mo ⟶
                              %mi h
                          %mtd
                            %mi p
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_2(g) = h \cdot \phi_1(g) \cdot h^{-1}
                    \\phantom{AAAAAAAAA}
                    \\array{
                    p &amp;\overset{h}{\longrightarrow}&amp; p
                    \\\
                    {}^{\mathllap{\phi_1(g)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi_2(g)}}
                    \\\
                    p &amp;\underset{h}{\longrightarrow}&amp; p
                    }
            %p hence such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo =
                    %msub
                      %mi Ad
                      %mi h
                    %mo ∘
                    %msub
                      %mi ϕ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_2 = Ad_h \circ \phi_1
                    \\,.
            %p Therefore notably the induced functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Grp
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Grp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B(-) \;\colon\; Grp \longrightarrow Ho(Grp)
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of groupoids is not fully faithful.
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              is canonically a
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              in groupoids, we may also regard
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              as a functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Grp
                    %mo ⟶
                    %msup
                      %mi Grpd
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    B(-) \;\colon\; Grp \longrightarrow Grpd^{\ast/}
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi G
                      %mn 1
                    %mo →
                    %mi B
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} B G_1 \to B G_2
              necessarily preserve the basepoint, this makes no difference at this point. But as we now pass to the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Grp
                    %mo ↪
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Grpd
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B(-) \;\colon\; Grp \hookrightarrow Ho(Grpd^{\ast/})
            %p
              then also the homotopies are required to preserve the basepoint, and for homotopies between homomorphisms between delooped groups this means, since there only is a single point, that these homotopies are all trivial. Hence regarded this way the functor is a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              again, hence an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              onto its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              %a.maruku-ref{:href => "#EveryGroupoidIsEquivalentToDisjointUnionOfGroupDeloopings"}
              below this essential image consists precisely of the (pointed)
              %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected
              groupoids:
            %p
              %em> Groups are equivalently pointed connected groupoids
              \.
          #DeloopingGroupoidDisjointUnion.num_example
            %h6#example_12 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi G
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{G_i\}_{i \in I}
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi B
                    %msub
                      %mi G
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\sqcup} B G_i
              which is the disjoint union groupoid (example
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidsCoproduct"}
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              groupoids
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi G
                      %mi i
                  %annotation{:encoding => "application/x-tex"} B G_i
              (example
              = succeed "):" do
                %a.maruku-ref{:href => "#GroupoidFromDelooping"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoid"} skeletal groupoid
            %p
              Its set of objects is the index set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi G
                                %mi i
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi i
                              %mo =
                              %mi j
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    Hom(i,j)
                    \=
                    \\left\{
                    \\array{
                    G_i &amp;\vert&amp; i = j
                    \\\
                    \\emptyset &amp;\vert&amp; \text{otherwise}
                    }
                    \\right.
          #GroupoidConnectedComponents.num_defn
            %h6#definition_14 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                of a groupoid)
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              with set of objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              “there exists a morphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to
              = succeed "\u201D," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∼
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mi ∅
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (x\sim y)
                    \\;\coloneqq\;
                    \\left( Hom(x,y) \neq \emptyset \right)
            %p
              is clearly an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              is denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0(\mathcal{G})
            %p
              and called the set of
              %em
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
          #InGrupoidAutomorphismGroup.num_defn
            %h6#definition_15 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/automorphism+groups"}> automorphism groups
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              and an object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{G}}(x,x)
              forms a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %em
                %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut_{\mathcal{G}}(x)
              or
              %em vertex group
              or
              %em isotropy group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            %p
              For each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in a groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    B Aut_{\mathcal{G}}(x) \hookrightarrow \mathcal{G}
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidFromDelooping"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B Aut_{\mathcal{G}}(x)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and takes every automorphism of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              “to itself”, regarded now again as a morphism in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
          #GroupoidWeakHomotopyEquivalence.num_prop
            %h6#definition_16 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
