                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mover
                      %mo ⟶
                      %mi f
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x \overset{f}{\longrightarrow} y
                    \\,.
            %p
              The operation of
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              with this morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Aut
                              %mi 𝒢
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
