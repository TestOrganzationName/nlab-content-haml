          #FundamentalGroupFunctor.num_remark
            %h6#remark_5 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                is
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            %p
              The pushforward operation in def.
              %a.maruku-ref{:href => "#PushElementsFundamentalGroup"}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#PointedTopologicalSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %mi Grp
