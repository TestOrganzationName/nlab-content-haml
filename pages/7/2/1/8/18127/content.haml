              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
