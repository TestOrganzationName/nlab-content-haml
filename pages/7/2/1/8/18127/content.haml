                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mtext conjugacy classes of
                          %mtr
                            %mtd
                              %mtext elements of a symmetric group
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left \{
                    \\array{
                    \\text{isomorphism classes of}
                    \\\
                    \\text{finite covering spaces }
                    \\\
                    \\text{over the circle}
                    }
                    \\right\}
                    \\;\simeq\;
                    \\left\{
                    \\array{
                    \\text{conjugacy classes of}
                    \\\
                    \\text{elements of a symmetric group}
                    }
                    \\right\}
            %p
              To see this we may without restriction choose a basepoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x \in S^1
              so that a monodromy representation is equivalently a groupoid morphism of the form (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidRepresentationsAreProductsOfGroupRepresentations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi ℤ
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi B
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi ρ
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho
                    \\;\colon\;
                    B \mathbb{Z}
                    \\overset{\simeq}{\longrightarrow}
                    B \pi_1(S^1,x)
                    \\overset{\rho}{\longrightarrow}
                    Core(Set)
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              on a single generator, such as morphism is uniquely determined by the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} 1 \in \mathbb{Z}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^{-1}(x)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≃
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \phi \colon p^{-1}(x) \overset{\simeq}{\to} \{1, \cdots, n\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in \Sigma(n)
              in the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mi ϕ
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} }
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi ρ
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi σ
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mi ϕ
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x &amp;\mapsto&amp;  p^{-1}(x) &amp;\underoverset{\simeq}{\phi}{\longrightarrow}&amp; \{1, \cdots, n\}
                    \\\
                    {}^{\mathllap{1}}\downarrow &amp;&amp; {}^{\mathllap{\rho(1)}}\downarrow &amp;&amp; \downarrow^{\sigma}
                    \\\
                    x &amp;\mapsto&amp; p^{-1}(x) &amp;\underoverset{\phi}{\simeq}{\longrightarrow}&amp; \{1, \cdots, n\}
                    }
                    \\,.
            %p Now if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi E
                      %mn 1
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; E_1 \overset{\simeq}{\longrightarrow} E_2
            %p
              is an isomorphism of covering spaces, then by the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalTheoremOfCoveringSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Fib
                      %mrow
                        %msub
                          %mi E
                          %mn 1
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi Fib
                      %mrow
                        %msub
                          %mi E
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    Fib(f) \;\colon\; Fib_{E_1} \overset{\simeq}{\longrightarrow} Fib_{E_2}
            %p
              which in turn is by definition a homotopy (natural isomorphism) between the monodromy functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Fib
                        %mrow
                          %msub
                            %mi E
                            %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi B
                      %mi ℤ
                      %mo →
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Fib_{E_i} \;\colon\; B \mathbb{Z} \to Core(Set)
            %p The combination of the naturality square of this natural isomorphism with the above identification yields the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
