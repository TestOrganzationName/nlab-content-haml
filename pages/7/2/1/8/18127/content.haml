                %a.maruku-ref{:href => "#GroupoidRepresentation"}
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (example
              = succeed ")." do
                %a.maruku-ref{:href => "#FundamentalGroupoid"}
          .proof
            %h6#proof_25 Proof
            %p
              First we demonstrate a homotopy (
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"}> natural isomorphism
              ) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mrow
                        %mi Rep
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi Fib
                    %mo ∘
                    %mi Rec
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    id_{Rep(\Pi_1(X), Set)}
                    \\overset{\simeq}{\longrightarrow}
                    Fib \circ Rec
                    \\,.
            %p
              To this end, given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ∈
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \in Rep(\Pi_1(X), Set)
              a
              %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+representation"} groupoid representation
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi ρ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo ⟶
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{\rho}
                    \\;\colon\;
                    \\rho \longrightarrow Fib(Rec(\rho))
            %p
              First consider what the right hand side is like: By def.
              %a.maruku-ref{:href => "#ElementaryReconstructionCoveringSpace"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                  %annotation{:encoding => "application/x-tex"} Rec
              and def.
              %a.maruku-ref{:href => "#CoveringSpaceMonodromy"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                  %annotation{:encoding => "application/x-tex"} Fib
              we have for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              an actual equality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Fib(Rec(\rho))(x) = \rho(x)
                    \\,.
            %p
              To similarly understand the value of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fib(Rec(\rho))
              on morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi γ
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [\gamma] \in \Pi_1(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma \colon [0,1] \to X
              be a representing
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
              we find a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of paths
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi γ
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\gamma_i\}_{i \in \{1,n\}}
              such that
            %ol
              %li
                %p
                  regarded as morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi γ
                          %mi i
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\gamma_i]
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Pi_1(X)
                  they
                  %a.existingWikiWord{:href => "/nlab/show/composition"} compose
                  to
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi γ
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\gamma]
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi γ
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi γ
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∘
                        %mi ⋯
                        %mo ∘
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi γ
                          %mn 2
                        %mo{:stretchy => "false"} ]
                        %mo ∘
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi γ
                          %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        [\gamma] = [\gamma_n] \circ \cdots \circ [\gamma_2] \circ [\gamma_1]
              %li
                %p
                  each
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi γ
                          %mi i
                      %annotation{:encoding => "application/x-tex"} \gamma_i
                  factors through an open subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mi i
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U_i \subset X
                  over which
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Rec
                        %mo{:stretchy => "false"} (
                        %mi ρ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Rec(\rho)
                  trivializes.
            %p
              Hence by
              %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fib(Rec(\rho))
              it is sufficient to understand its value on these paths
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \gamma_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mi i
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi γ
                      %mi i
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Fib(Rec(\rho))([\gamma_i]) = \rho([\gamma_i])
                    \\,.
            %p This means that if we take
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo =
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_\rho(x) \;\colon\; \rho(x) \overset{=}{\longrightarrow} Fib(Rec(\rho))
            %p
              to be the above identification, then this is a homotopy/
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              as required.
            %p
              It remains to see that these morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} \eta_\rho
              are themselves natural in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ρ
                    %mo →
                    %mi ρ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \phi \colon \rho \to \rho'
              the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ρ
                          %mtd
                            %mover
                              %mo ⟶
                              %mi ϕ
                          %mtd
                            %mi ρ
                            %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi eta
                                    %mi ρ
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi η
                                    %mrow
                                      %mi ρ
                                      %mo ′
                        %mtr
                          %mtd
                            %mi Fib
                            %mo{:stretchy => "false"} (
                            %mi Rec
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi Fib
                                %mo{:stretchy => "false"} (
                                %mi Rec
                                %mo{:stretchy => "false"} (
                                %mi ϕ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Fib
                            %mo{:stretchy => "false"} (
                            %mi Rec
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\rho &amp;\overset{\phi}{\longrightarrow}&amp; \rho'
                    \\\
                    {}^{\mathllap{eta_\rho}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\eta_{\rho'}}}
                    \\\
                    Fib(Rec(\rho))
                    \&amp;\underset{Fib(Rec(\phi))}{\longrightarrow}&amp;
                    Fib(Rec(\rho'))
                    }
            %p
              commutes as a diagram in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rep
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Rep(\Pi_1(X), Set)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              the corresponding component diagram commutes. But by the above this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi ϕ
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ρ
                            %mo ′
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo =
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo =
                        %mtr
                          %mtd
                            %mi Fib
                            %mo{:stretchy => "false"} (
                            %mi Rec
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi Fib
                                %mo{:stretchy => "false"} (
                                %mi Rec
                                %mo{:stretchy => "false"} (
                                %mi ϕ
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Fib
                            %mo{:stretchy => "false"} (
                            %mi Rec
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\rho(x) &amp;\overset{\phi(x)}{\longrightarrow}&amp; \rho'(x)
                    \\\
                    {}^{\mathllap{=}}\downarrow &amp;&amp; \downarrow^{\mathrlap{=}}
                    \\\
                    Fib(Rec(\rho))(x)
                    \&amp;\underset{Fib(Rec(\phi))(x) }{\longrightarrow}&amp;
                    Fib(Rec(\rho'))(x)
                    }
            %p and hence this means that the top and bottom horizontal morphism are in fact equal. Direct unwinding of the definitions shows that this is indeed the case.
            %p
              Now we demonstrate a homotopy (
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"}> natural isomorphism
              ) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                    %mo ∘
                    %mi Fib
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi id
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi Cov
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Rec \circ Fib
                    \\overset{\simeq}{\longrightarrow}
                    id_{Core(Cov(X))}
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi Cov
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in Cov(X)
              a covering space, we need to exhibit a natural isomorphism of covering spaces of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϵ
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon_E
                    \\;\colon\;
                    Rec(Fib(E)) \longrightarrow E
                    \\,.
            %p
              Again by def.
              %a.maruku-ref{:href => "#ElementaryReconstructionCoveringSpace"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                  %annotation{:encoding => "application/x-tex"} Rec
              and def.
              %a.maruku-ref{:href => "#CoveringSpaceMonodromy"}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fib
                  %annotation{:encoding => "application/x-tex"} Fib
              the underlying set of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi Fib
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rec(Fib(E))
              is actually equal to that of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
              on underlying sets is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %p
              By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U\subset X
              an open path-connected subset and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a point with the property that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(U,x) \to \pi_1(X,x)
              lands is constant on the trivial element, that the open subsets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \times \{\hat x\} \subset p^{-1}(U)
              form a basis for the topology of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rec
                      %mo{:stretchy => "false"} (
                      %mi Fib
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Rec(Fib(E))
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Rec
                    %annotation{:encoding => "application/x-tex"} Rec
            %p This proves the equivalence.
          #ReconstructCoveringForFreeAndTransitiveMonodromyRepresentation.num_example
            %h6#example_21 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
                reconstructed from
                %a.existingWikiWord{:href => "/nlab/show/free+action"} free
                and
                %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              which is
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+space"}> path-connected
                  ,
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+space"} locally path-connected
              %li
                %p
                  and
                  %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply-connected+space"} semi-locally simply-connected
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#UniversalCoveringSpace"}
          .proof
            %h6#proof_26 Proof
            %p
              By example
              %a.maruku-ref{:href => "#CoveringConnectivityViaMonodromy"}
              the covering space is connected and simply connected precisely if its
              %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
              representation is free and transitive. By the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalTheoremOfCoveringSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
              arises as the monodromy of some covering space. Hence it remains to see that a free and transitive representation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
              exists: The action of any group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on itself, by left multiplication, is free and transitive.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h2#Examples Examples
          %p
            We now use the theorems established above to compute the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
            of topological spaces in some basic examples. In particular we prove the archetypical example saying that the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group+of+the+circle+is+the+integers"} fundamental group of the circle is the integers
            (prop.
            %a.maruku-ref{:href => "#CircleFundamentalGroup"}
            below).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#ExamplesFundamentalGroups Fundamental groups
          #CircleFundamentalGroup.num_prop
            %h6#proposition_17 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group+of+the+circle+is+the+integers"}> fundamental group of the circle is the integers
                )
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi_1
              of the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              is the additive group of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_1(S^1) \overset{\simeq}{\longrightarrow} \mathbb{Z}
            %p
              and the isomorphism is given by assigning
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/winding+number"} winding number
          #ClassicalPointSetProof.proof
            %h6#proof_27 Proof
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/UniversalCoveringOfCircle.png", :width => "150"}/
            %p
              By example
              = succeed "," do
                %a.maruku-ref{:href => "#UniversalCoveringRealLineOfCircle"}
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{S^1}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              is the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi cos
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi sin
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p \coloneqq (cos(2 \pi(-)), \sin(2 \pi(-)))
                    \\;\colon\; \mathbb{R}^1 \longrightarrow S^1
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
              (
              %a{:href => "locally+path-connected+space#LocallyPathConnectedCircle"}> this example
              ) and
              %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
              (
              %a{:href => "semi-locally+simply+connected+topological+space#LocallySimplyConnectedCircle"}> this example
              ) the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
              applies and gives that the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
              equals the automorphism group of its
              %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mrow
                        %mi Cov
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Aut
                      %mrow
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mi Set
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Fib
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aut_{Cov(S^1)}(\mathbb{R}^1)
                    \\;\simeq\;
                    Aut_{\pi_1(S^1) Set}(Fib_{S^1})
                    \\,.
            %p
              Moreover, as a corollary of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
              we have that the
              %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
              representation of a
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(S)
              on itself (
              %a{:href => "universal+covering+space#ReconstructCoveringForFreeAndTransitiveMonodromyRepresentation"}> this prop.
              ).
            %p
              But the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              of any group regarded as an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on itself by left multiplication is canonically isomorphic to that group itself (by
              = succeed ")," do
                %a{:href => "permutation+representation#AutomorphismsOfGAsGTorsor"} this example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mrow
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mi Set
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Fib
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Aut
                      %mrow
                        %mrow
                          %msub
                            %mi π
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} )
                        %mi Set
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Aut_{{\pi_1(S^1)} Set}(Fib_{S^1})
                    \\;\simeq\;
                    Aut_{{\pi_1(S^1)} Set}( \pi_1(S^1) )
                    \\;\simeq\;
                    \\pi_1(S^1)
                    \\,.
            %p Therefore to conclude the proof it is now sufficient to show that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Aut
                      %mrow
                        %mi Cov
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Aut}_{Cov(S^1)}(\mathbb{R}^1) \simeq \mathbb{Z}
                    \\,.
            %p
              To that end, consider a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                          %mtd
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mi f
                          %mtd
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^1 &amp;&amp; \underoverset{\simeq}{f}{\longrightarrow} &amp;&amp; \mathbb{R}^1
                    \\\
                    \&amp; {}_{\mathllap{p}}\searrow &amp;&amp; \swarrow_{\mathrlap{p}}
                    \\\
                    \&amp;&amp; S^1
                    }
                    \\,.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} s \in S^1
              be any point, and consider the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to the fibers over the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 1
                            %mo ∖
