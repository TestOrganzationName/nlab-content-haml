                %annotation{:encoding => "application/x-tex"} \,
          #ElementaryReconstructionCoveringSpace.num_defn
            %h6#definition_21 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reconstruction+of+covering+spaces+from+monodromy"}> reconstruction of covering spaces from monodromy
                )
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi τ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,\tau)
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
                  %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo ∈
                        %mi Rep
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \rho \in Rep(\Pi_1(X),Set)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
                  of its
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of all the sets appearing in this representation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E(\rho) \;\coloneqq\;  \underset{x \in X}{\sqcup} \rho(x)
            %p For
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \subset X
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                %ol
                  %li
                    %p
                      which is
                      %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
                  %li
                    %p
                      for which every element of the
                      %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \pi_1(U,x)
                      becomes trivial under
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi π
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo ,
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo →
                              %msub
                                %mi π
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi x
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} \pi_1(U,x) \to \pi_1(X,x)
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mo ∈
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \hat x \in \rho(x)
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi U
                      %annotation{:encoding => "application/x-tex"} x \in U
            %p consider the subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi U
                        %mo ,
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                    %mo ≔
                    %mrow
                      %mo {
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi x
                      %mo ′
                      %mo ∈
                      %mi U
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mphantom
                        %mi A
                      %mi γ
                      %mspace{:width => "thinmathspace"}
                      %mtext path from
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mtext to
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mo ′
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V_{U,\hat x}
                    \\coloneqq
                    \\left\{
                    \\rho(\gamma)(\hat x)
                    \\;\vert\;
                    x' \in U
                    \\,,\phantom{A}
                    \\gamma \,\text{path from}\, x \,\text{to}\, x'
                    \\right\}
                    \\;\subset\;
                    E(\rho)
                    \\,.
            %p
              The collection of these defines a
              %a.existingWikiWord{:href => "/nlab/show/base+for+a+topology"} base for a topology
              (prop.
              %a.maruku-ref{:href => "#ElementaryReconstructedCoveringSpaceWellDefined"}
              below). Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} \tau_{\rho}
              for the corresponding topology. Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi τ
                      %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E(\rho), \tau_{\rho})
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mo ∈
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E(\rho) &amp;\overset{p}{\longrightarrow}&amp; X
                    \\\
                    \\hat x \in \rho(x) &amp;\mapsto&amp; x
                    }
                    \\,.
            %p Finally, for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ρ
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi ρ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; \rho_1 \longrightarrow \rho_2
            %p
              a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of permutation representations, there is the evident induced function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ρ
                              %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi Rec
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi E
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ρ
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mo ∈
                            %msub
                              %mi ρ
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mi x
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} )
                            %mo ∈
                            %msub
                              %mi ρ
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E(\rho_1)
                    \&amp;\overset{Rec(f)}{\longrightarrow}&amp;
                    E(\rho_2)
                    \\\
                    (\hat x \in \rho_1(x)) &amp;\mapsto&amp; (f_x(\hat x) \in \rho_2(x))
                    }
                    \\,.
          #ElementaryReconstructedCoveringSpaceWellDefined.num_prop
            %h6#proposition_15 Proposition
            %p
              The construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ↦
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho \mapsto E(\rho)
              in def.
              %a.maruku-ref{:href => "#ElementaryReconstructionCoveringSpace"}
              is well defined and yields a
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Moreover, the construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↦
                    %mi Rec
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \mapsto Rec(f)
              yields a homomorphism of covering spaces.
          .proof
            %h6#proof_24 Proof
            %p
              First to see that we indeed have a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              = succeed ")" do
                %a{:href => "topological+base#Recognition"} this prop.
            %p
              So let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              be a point. By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/semi-locally+simply+connected+topological+space"} semi-locally simply connected
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              such that every loop in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is contractible in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mo ′
                      %mi x
                    %mo ⊂
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U'_x \subset U_x
              which is
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path connected
              and, as every subset of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                    %annotation{:encoding => "application/x-tex"} U_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %msub
                      %mo ′
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U'_x
              based on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is contractible as a loop in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \hat x \in E
              be any point over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mrow
                          %mi U
                          %msub
                            %mo ′
                            %mi x
                          %mo ,
                          %mi x
                    %annotation{:encoding => "application/x-tex"} V_{U'_x,x}
            %p The argument for the base open neighbourhoods contained in intersections is similar.
            %p
              Then we need to see that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
