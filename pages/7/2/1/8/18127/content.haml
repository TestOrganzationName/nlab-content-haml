                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi ρ
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
