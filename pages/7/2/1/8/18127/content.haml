                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(E)
              of the total space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is the groupoid
            %p whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are pairs
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x,\hat x)
                  consisting of a point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  and en element
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} ^
                          %mo ∈
                          %msub
                            %mi Fib
                            %mi E
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \hat x \in Fib_E(x)
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mover
                          %mi γ
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ]
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ′
                        %mo ,
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} [\hat \gamma] \colon (x,\hat x) \to (x', \hat x')
                  are morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi γ
                        %mo{:stretchy => "false"} ]
                        %mo{:lspace => "verythinmathspace"} :
                        %mi x
                        %mo →
                        %mi x
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} [\gamma] \colon x \to x'
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Pi_1(X)
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
