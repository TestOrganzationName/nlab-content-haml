            %p This means that the square commutes, as claimed.
          #CoveringSpaceFundamentalGroupoid.num_example
            %h6#example_19 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
                of covering space)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo ⟶
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\longrightarrow} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
