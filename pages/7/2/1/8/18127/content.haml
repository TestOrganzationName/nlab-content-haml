                      %annotation{:encoding => "application/x-tex"} F_0 \;\colon\; X_1 \longrightarrow X_2
                  between the respective sets of objects;
              %li
                %p
                  for each pair
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ∈
                        %msub
                          %mi X
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} x,y \in X_1
                  of objects a function
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi Hom
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi Hom
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi F
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        F_{x,y} \;\colon\; Hom_{\mathcal{G}_1}(x,y) \longrightarrow Hom_{\mathcal{G}_2}(F_0(x), F_0(y))
                %p between sets of morphisms
            %p such that
            %ol
              %li
                %p
                  (respect for composition) for all triples
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo ∈
                        %msub
                          %mi X
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} x,y,z \in X_1
                  and all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in Hom(x,y)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} g \in Hom(y,z)
                  an
                  %a.existingWikiWord{:href => "/nlab/show/equality"} equality
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi y
                            %mo ,
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ∘
                          %mn 2
                        %msub
                          %mi F
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi F
                          %mrow
                            %mi x
                            %mo ,
                            %mi z
                        %mo{:stretchy => "false"} (
                        %mi g
                        %msub
                          %mo ∘
                          %mn 1
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        F_{y,z}(g) \circ_2 F_{x,y}(f)  \;=\; F_{x,z}(g\circ_1 f)
              %li
                %p
                  (respect for identities) for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  an equality
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi x
                            %mo ,
                            %mi x
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi id
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi F
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        F_{x,x}(id_x) = id_{F_0(x)}
                        \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1, \mathcal{G}_2
              two groupoids, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo →
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F,G \;\colon\; \mathcal{G}_1 \to \mathcal{G}_2
              two groupoid homomorphisms/functors, then a
              %em conjugation
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              (necessarily a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; F \Rightarrow G
            %p is
            %ul
              %li
                for each object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x \in X_1
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_1
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi x
                      %mo ∈
                      %msub
                        %mi Hom
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 2
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_{x} \in Hom_{\mathcal{G}_2}(F(x), G(y))
            %p such that
            %ul
              %li
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ∈
                        %msub
                          %mi X
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} x,y \in X_1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %msub
                          %mi Hom
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in Hom_{\mathcal{G}_1}(x,y)
                  an
                  %a.existingWikiWord{:href => "/nlab/show/equality"} equality
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi y
                        %msub
                          %mo ∘
                          %mn 2
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %msub
                          %mi η
                          %mi x
                        %mphantom
                          %mi AAAAAA
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi η
                                      %mi x
                              %mtd
                                %mi G
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mi F
                                      %mo{:stretchy => "false"} (
                                      %mi f
                                      %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi G
                                      %mo{:stretchy => "false"} (
                                      %mi f
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi η
                                      %mi y
                              %mtd
                                %mi G
                                %mo{:stretchy => "false"} (
                                %mi y
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\eta_y \circ_2 F(f)
                        \=
                        G(f) \circ \eta_x
                        \\phantom{AAAAAA}
                        \\array{
                        F(x) &amp;\overset{\eta_x}{\longrightarrow}&amp; G(x)
                        \\\
                        {}^{\mathllap{F(f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{G(f)}}
                        \\\
                        F(y) &amp;\underset{\eta_y}{\longrightarrow}&amp; G(y)
                        }
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1, \mathcal{G}_2
              two groupoids and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                    %mo ,
                    %mi H
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F, G, H \colon \mathcal{G}_1  \longrightarrow \mathcal{G}_2
              three functors between them and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \eta_1 \;\colon\; F \Rightarrow G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ⇒
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \eta_2 \;\colon\; G \Rightarrow H
              conjugation actions/natural isomorphisms between these, there is the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi η
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi F
                    %mo ⇒
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_2 \colon \eta_1  \;\colon\; F \Rightarrow H
            %p with components the composite of the components
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mn 2
                    %mo ∘
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi η
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %msub
                      %mi η
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\eta_2 \circ \eta_1)(x) \coloneqq \eta_2(x) \circ \eta_1(x)
                    \\,.
            %p
              This yields for any two groupoid a
              %em
                %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Grpd
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msub
                      %mi 𝒢
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Grpd}(\mathcal{G}_1, \mathcal{G}_2)
            %p whose objects are the groupoid homomorphisms / functors, and whose morphisms are the conjugation actions / natural transformations.
          %p The archetypical example of a groupoid we already encountered above:
          #FundamentalGroupoid.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"}> fundamental groupoid
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %em
                %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              (as in def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalGroupoidAndFundamentalGroup"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y \in X
              two points, the set of homomorphisms is the set of
              %a.existingWikiWord{:href => "/nlab/show/paths"} paths
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              modulo
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+relative+boundary"} homotopy relative boundary
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mo ∼
                      %mi h
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\Pi_1(X)}(x,y) (P_{x,y})/\sim_h
            %p
              and
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              is given by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/concatenation+of+paths"} concatenation of paths
          .num_remark
            %h6#remark_7 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                are special cases of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/small+groupoid"} small groupoid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidDependentlyTypes"}
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              in which all
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphisms
            %p
              While therefore groupoid theory may be regarded as a special case of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
              %a.existingWikiWord{:href => "/nlab/show/higher+groupoid"} higher groupoid
              theory is
              %em
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              which is rich but quite tractable, for instance via tools such as
              %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} simplicial homotopy theory
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
              is intricate and becomes tractable mostly by making recourse to higher groupoid theory in the guise of
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+theory"} (infinity,1)-category theory
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-categories"} (infinity,n)-categories
          #CoreGroupoid.num_example
            %h6#example_7 Example
            %p
              %strong
                (groupoid
                %a.existingWikiWord{:href => "/nlab/show/core"} core
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              any (
              %a.existingWikiWord{:href => "/nlab/show/small+category"}> small
              )
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    Core(\mathcal{C}) \hookrightarrow \mathcal{C}
            %p
              sometimes called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/core"} core
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              simply by discarding all those
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              that are not
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            %p For instance
            %ul
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \mathcal{C} =
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi Set
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Core(Set)
                  is the groupoid of
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  and
                  %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
                  between them.
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/FinSet"} FinSet
                  then the
                  %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
                  of this groupoid (prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EveryGroupoidIsEquivalentToDisjointUnionOfGroupDeloopings"}
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                  of
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
                  (example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DeloopingGroupoidDisjointUnion"}
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+groups"} symmetric groups
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi FinSet
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %munder
                          %mo ⊔
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                        %mi Σ
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Core(FinSet) \simeq \underset{n \in \mathbb{N}}{\sqcup} \Sigma(n)
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \mathcal{C} =
                  %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi Vect
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Core(Vect)
                  is the groupoid of
                  %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
                  and
                  %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
                  %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
                  between them.
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \mathcal{C} =
                  %a.existingWikiWord{:href => "/nlab/show/FinDimVect"} FinDimVect
                  then the
                  %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
                  of this groupoid is the disjoint union of
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
                  of all the
                  %a.existingWikiWord{:href => "/nlab/show/general+linear+groups"} general linear groups
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Core
                        %mo{:stretchy => "false"} (
                        %mi FinDimVect
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %munder
                          %mo ⊔
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                        %mi GL
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Core(FinDimVect) \simeq \underset{n \in \mathbb{N}}{\sqcup} GL(n)
                        \\,.
          #DiscreteGroupoid.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/discrete+groupoid"}> discrete groupoid
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any set, there is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/discrete+groupoid"} discrete groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Disc(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and whose only morphisms are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
            %p
              This is also the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalGroupoid"}
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              on the set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          #GroupoidsCoproduct.num_example
            %h6#example_9 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"}> disjoint union
                \/
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi 𝒢
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\mathcal{G}_i\}_{i \in I}
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              (
              %a.existingWikiWord{:href => "/nlab/show/coproduct"}> coproduct
              ) is the groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi 𝒢
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\sqcup} \mathcal{G}_i
            %p
              whose set of objects is the disjoint union of the sets of objects of the summand groupoids, and whose sets of morphisms between two objects is that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_i
              if both objects are form this groupoid, and is
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
              otherwise.
          #ProductGroupoid.num_defn
            %h6#definition_11 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/product+category"} product
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi 𝒢
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\mathcal{G}_i\}_{i \in I}
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product groupoid
              is the [groupoid]]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi 𝒢
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\prod} \mathcal{G}_i
            %p
              whose set of objects is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of the sets of objects of the factor groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                        %msub
                          %mi 𝒢
                          %mi i
                        %mo )
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\underset{i \in I}{\prod} \mathcal{G}_i
                    \\right)_0
                    \\;\coloneqq\;
                    \\underset{i \in I}{\prod} (\mathcal{G}_i)_0
            %p
              and whose set of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              between
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (x_i)_{i \in I}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (y_i)_{i \in I}
              is the corresponding Cartesian product of morphisms, with elements denoted
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x_i)_{i \in I} \overset{(f_i)_{i \in I}}{\longrightarrow} (y_i)_{i \in I}
                    \\,.
            %p
              For instance if each of the groupoids is the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi i
                    %mo =
                    %mi B
                    %msub
                      %mi G
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_i = B G_i
              of a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi i
                  %annotation{:encoding => "application/x-tex"} G_i
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidFromDelooping"}
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              of the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/direct+product+group"} direct product group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi B
                    %msub
                      %mi G
                      %mi i
                    %mo ≃
                    %mi B
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi G
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\prod} B G_i
                    \\simeq
                    B \underset{i \in I}{\prod} G_i
                    \\,.
            %p
              As another example, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi 𝒢
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\sqcup} \mathcal{G}_i
              is the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              groupoid from example
              = succeed "," do
                %a.maruku-ref{:href => "#GroupoidsCoproduct"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is any groupoid, then a groupoid homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi 𝒢
                      %mi i
                    %mo ⟶
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\sqcup} \mathcal{G}_i
                    \\longrightarrow
                    \\mathcal{G}
            %p
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (f_i)_{i \in I}
              of groupoid homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mi i
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}_1 \overset{f_i}{\longrightarrow} \mathcal{G}
                    \\,.
            %p
              The analogous statement holds for homotopies between groupoid homomorphisms, and so one find that the
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              out of a coproduct of groupoids is the product groupoid of the separate hom-groupoids:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Grpd
                    %mrow
                      %mo (
                      %munder
                        %mo ⊔
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi 𝒢
                        %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒢
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi Hom
                      %mi Grpd
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Grpd}\left(
                    \\underset{i \in I}{\sqcup} \mathcal{G}_i
                    \\;,\;
                    \\mathcal{G}
                    \\right)
                    \\;\simeq\;
                    \\underset{i \in I}{\prod}
                    Hom_{Grpd}( \mathcal{G}_1, \mathcal{G} )
                    \\,.
          #1CategoryOfGroupoids.num_prop
            %h6#remark_8 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %p
              From def.
              %a.maruku-ref{:href => "#GroupoidDependentlyTypes"}
              we see that there is a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the small groupoids;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are the groupoid homomorphisms (
                  %a.existingWikiWord{:href => "/nlab/show/functors"}> functors
                  ).
          %p
            But since this
            %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            does not reflect the existence of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            between homomorphisms/
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            of groupoids (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#GroupoidDependentlyTypes"}
            %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            is not what one is interested in when considering
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
          %p
            In order to obtain the right notion of category of groupoids that does reflect homotopies, we first consider now the
            %em horizontal
            composition of homotopies/natural transformations.
          #HmotopiesWithMorphismsHorizontaComposition.num_lemma
            %h6#lemma Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
                of
