            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mrow
                        %msub
                          %mi E
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi γ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
