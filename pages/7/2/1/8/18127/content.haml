                                        %mi E
                                        %mn 2
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi σ
                                    %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} }
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi ϕ
                                  %mn 1
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %msubsup
