                            %msup
                              %mi Top
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Top^{\ast/} &amp;\overset{\pi_1}{\longrightarrow}&amp; Grp
                    \\\
