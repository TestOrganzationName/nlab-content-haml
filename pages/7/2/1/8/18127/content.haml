                            %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{1,\cdots, n\}
                    \&amp;\overset{\phi_1^{-1}}{\longrightarrow}&amp;
                    p_1^{-1}(x)
