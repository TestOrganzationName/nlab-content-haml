          #IfFundamentalGroupsIncludeThenfLoopsLiftToLoops.num_example
            %h6#example_17 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e) \overset{p}{\longrightarrow} (X,x)
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (Y,y) \longrightarrow (X,x)
              be a point-preserving
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              such that the image of the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y)
              is contained within the image of the fundamental group of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              in that of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %mo ⊂
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f_\ast(\pi_1(Y,y)) \subset p_\ast(\pi_1(E,e))
                    \\phantom{AA}
                    \\subset
                    \\pi_1(X,x)
                    \\,.
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \ell_Y
              a
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y)
              that happens to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/loop"} loop
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} f \circ \ell
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              to a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %msub
                          %mi ℓ
                          %mi Y
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{f\circ \ell_Y}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              is also a loop there.
          .proof
            %h6#proof_17 Proof
            %p
              By assumption, there is a loop
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℓ
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \ell_E
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              and a homotopy fixing the endpoints of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %mo ∘
                    %msub
                      %mi ℓ
                      %mi E
                    %mo ⇒
                    %mi f
                    %mo ∘
                    %msub
                      %mi ℓ
                      %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{X} \;\colon\; p \circ \ell_E \Rightarrow f\circ \ell_Y
                    \\,.
            %p
              Then by the homotopy lifting property as in example
              = succeed "," do
                %a.maruku-ref{:href => "#CoveringSpacesHomotopyLifting"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,e)
              relative to the basepoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℓ
                      %mi E
                    %mo ⇒
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %msub
                          %mi ℓ
                          %mi Y
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_{E} \;\colon\; \ell_E \Rightarrow \widehat{f \circ \ell_Y}
            %p
              and lifting the homotopy
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \eta_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi E
                  %annotation{:encoding => "application/x-tex"} \eta_E
              is in fact a homotopy between loops, and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %msub
                          %mi ℓ
                          %mi Y
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{f \circ \ell_Y}
              is indeed a loop.
          #TheTheoremLifting.num_prop
            %h6#proposition_11 Proposition
            %p
              %strong (lifting theorem)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
                        %mi E
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} p \colon E \to X
                  be a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi e
                        %mo ∈
                        %mi E
                      %annotation{:encoding => "application/x-tex"} e \in E
                  a point, with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ≔
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} x \coloneqq p(e)
                  denoting its image,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  be a
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                  and
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} y \in Y
                  a point
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \colon (Y,y) \longrightarrow (X,x)
                  a
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  such that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi x
                        %annotation{:encoding => "application/x-tex"} f(y) = x
            %p Then the following are equivalent:
            %ol
              %li
                %p
                  There exists a unique lift
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat f
                  in the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo ,
                                %mi e
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mover
                                      %mi f
                                      %mo{:stretchy => "false"} ^
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi p
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi y
                                %mo{:stretchy => "false"} )
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi f
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo ,
                                %mi x
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; (E,e)
                        \\\
                        \&amp; {}^{\mathllap{\hat f}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                        \\\
                        (Y,y) &amp;\underset{f}{\longrightarrow}&amp; (X,x)
                        }
                %p
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  in that of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is contained in the image of the fundamental group of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  under
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %msub
                          %mi p
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                      %annotation{:encoding => "application/x-tex"}
                        f_\ast(\pi_1(Y,y)) \subset p_\ast( \pi_1(E,e) )
                        \\,
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is path-connected, then the lift in the first item is unique.
          .proof
            %h6#proof_18 Proof
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 1) \Rightarrow 2)
              is immediate. We need to show that the second statement already implies the first.
            %p
              So assume that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} subet
                      %msub
                        %mi p
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_\ast(\pi_1(Y,y)) \subet p_\ast(\pi_1(E,e))
              = succeed "." do
                %a.maruku-ref{:href => "#LiftsOverConnectedSpaceIntoCoveringSpaceAreUniqueRelativePoint"}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is connected and locally path-connected, it is also a
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
              (
              %a{:href => "locally+path-connected+space#ForLocallyPathConnectedTheConnectedComponentsCoincideWithThePathConnectedComponents"}> this prop.
              ). Hence for every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y' \in Y
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              connecting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y'
              and hence a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma
              connecting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(y')
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mi e
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mrow
                                    %mi f
                                    %mo ∘
                                    %mi γ
                                  %mo ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo ∘
                                %mi γ
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{0\} &amp;\overset{e}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow &amp;{}^{\mathllap{\widehat{f \circ \gamma}}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    [0,1]
                    \&amp;\underset{f \circ \gamma}{\longrightarrow}&amp;
                    X
                    }
                    \\,.
            %p Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %mi γ
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\hat f(y') \coloneqq \widehat{f \circ \gamma}(1)
            %p
              is a lift of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(y')
            %p
              We claim now that this pointwise construction is independent of the choice
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y'
              it is indeed continuous. This will prove the claim.
            %p
              First, by the path lifting lemma
              %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
              the lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} f
                        %mo ∘
                        %mi γ
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\f \circ \gamma}
              is unique given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} f \circ \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat f(y')
              depends at most on the choice of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
            %p
              Hence let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \gamma' \colon [0,1] \to Y
              be another path in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              that connects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} y'
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %mi f
                          %mo ∘
                          %mi γ
                          %mo ′
                        %mo ^
                      %mo =
                      %mover
                        %mrow
                          %mi f
                          %mo ∘
                          %mi γ
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{f \circ \gamma'} = \widehat{f \circ \gamma}
            %p
              First observe that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \gamma'
              is related to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              by a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma'
              is related to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma
              by a homotopy, then this is the statement of the homotopy lifting property in the form of example
              = succeed "." do
                %a.maruku-ref{:href => "#CoveringSpacesHomotopyLifting"}
            %p
              Next write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \bar\gamma'\cdot \gamma
              for the
              %a.existingWikiWord{:href => "/nlab/show/path+concatenation"} path concatenation
              of the path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              with the
              %a.existingWikiWord{:href => "/nlab/show/reverse+path"} reverse path
              of the path
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \gamma'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ (\bar\gamma'\cdot \gamma)
              is a loop in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msub
                      %mi p
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\ast(\pi_1(Y,y)) \subset p_\ast(\pi_1(E,e))
              implies, via example
              = succeed "," do
                %a.maruku-ref{:href => "#IfFundamentalGroupsIncludeThenfLoopsLiftToLoops"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi f
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi γ
                          %mo{:stretchy => "false"} ¯
                        %mo ′
                        %mo ⋅
                        %mi γ
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{f \circ (\bar \gamma' \cdot \gamma)}
              which lifts this loop to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is itself a loop in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p By uniqueness of path lifting, this means that the lift of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo ′
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \circ ( \gamma' \cdot (\bar\gamma' \cdot \gamma) )
                    \=
                    (f \circ \gamma') \cdot (f \circ (\bar \gamma' \cdot \gamma) )
            %p
              coincides at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} 1 \in [0,1]
              with that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma'
              at 1. But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo ⋅
                    %mi γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \gamma' \cdot (\bar \gamma' \cdot \gamma)
              is homotopic (via reparameterization) to just
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f \circ \gamma'
              indeed coincides with that of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} f \circ \gamma
            %p
              This shows that the above prescription for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f
              is well defined.
            %p
              It only remains to show that the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f
              obtained this way is continuous.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y' \in Y
              be a point and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                  %annotation{:encoding => "application/x-tex"} W_{\hat f(y')} \subset E
              an open neighbourhood of its image in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mrow
                        %mi y
                        %mo ′
