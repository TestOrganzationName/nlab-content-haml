              a lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} E_1
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi e
