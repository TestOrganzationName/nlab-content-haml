                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Fib
                      %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_1(E)
                    \\;\simeq\;
                    \\int_{\Pi_1(X)} Fib_E
                    \\,.
          .proof
            %h6#proof_22 Proof
            %p
              By the uniqueness of the path-lifting, lemma
              %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
              and the very definition of the
              %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
              functor.
          #CoveringConnectivityViaMonodromy.num_example
            %h6#example_20 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
                is
                %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal
                if
                %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
                is
                %a.existingWikiWord{:href => "/nlab/show/free+action"} free
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
                  precisely if the
                  %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Fib
                          %mi E
                      %annotation{:encoding => "application/x-tex"} Fib_E
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive action
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SimplyConnected"}
                  %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
                %p
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#UniversalCoveringSpace"}
                  %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Fib
                          %mi E
                      %annotation{:encoding => "application/x-tex"} Fib_E
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive
                  and
                  = succeed "." do
