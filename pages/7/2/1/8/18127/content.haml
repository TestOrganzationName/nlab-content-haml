          #GroupRepresentationsAsDeloopingRepresentations.num_example
            %h6#exampledefinition Example/Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/group+representations"} group representations
                are
                %a.existingWikiWord{:href => "/nlab/show/groupoid+representations"} groupoid representations
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo =
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} = B G
              is the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              of a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#GroupoidFromDelooping"}
              %a.existingWikiWord{:href => "/nlab/show/groupoid+representation"} groupoid representation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/group+representation"} group representation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#GroupoidRepresentation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Rep(G) \coloneqq Rep(B G)
            %p
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representation+category"} representation groupoid
            %p
              For each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              the canonical inclusion of the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              of the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              (from def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InGrupoidAutomorphismGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi inc
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    inc_x \;\colon\; B Aut_{\mathcal{G}}(x) \hookrightarrow \mathcal{G}
            %p induces by precomposition a homomorphism of representation groupoids:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi inc
                      %mi x
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi B
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    inc_x^*
                    \\;\colon\;
                    Rep(\mathcal{G})
                    \\longrightarrow
                    Rep(B Aut_{\mathcal{G}}(x))
                    \\,.
            %p
              We say that a groupoid representation is
              %em faithful
              or
              %em free
              if for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              its restriction to a group representation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Aut_{\mathcal{G}}(x)
              this way is transitive or free, respectively.
            %p
              Here the representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              of a group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on some set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %ol
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitive
                  if for all pairs of elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mn 1
                        %mo ,
                        %msub
                          %mi s
                          %mn 2
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s_1, s_2 \in S
                  there is a
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} g \in G
                  such that
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi s
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi s
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \rho(g)(s_1) = s_2
              %li
                %p
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/free+action"} free
                  if whenever
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi s
                      %annotation{:encoding => "application/x-tex"} g(s) = s
                  holds for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s \in S
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  is the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/neutral+elements"} neutral elements
          #GroupoidRepresentationsAreProductsOfGroupRepresentations.num_prop
