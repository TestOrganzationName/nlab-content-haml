                %em
                  %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoid"} skeletal groupoid
            %p
              Concretely, this exists for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I = \pi_0(\mathcal{G})
              the set of
              %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupoidConnectedComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi i
                    %mo ≔
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G_i \coloneqq Aut_{\mathcal{G}}(x)
              the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InGrupoidAutomorphismGroup"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in the given connected component.
          .proof
            %h6#proof_9 Proof
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              we may find a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{x_i\}_{i \in \pi_0(\mathcal{G})}
              of objects of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              being in the
              %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \in \pi_0(\mathcal{G})
            %p
              This choice induces a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inc
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    inc
                    \\;\colon\;
                    \\underset{i \in \pi_0(\mathcal{G})}{\sqcup} Aut_{\mathcal{G}}(x_i)
                    \\longrightarrow
                    \\mathcal{G}
            %p which takes each object and morphism “to itself”.
            %p
              Now using the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              once more, we choose in each connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i \in \pi_0(\mathcal{G})
              and for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              in that connected component a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %msub
                              %mi x
                              %mi i
                            %mo ,
                            %mi y
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    x_i \overset{f_{x_i,y}}{\longrightarrow} y
                    \\,.
            %p Using this we obtain a functor the other way around
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒢
                    %mo ⟶
                    %munder
                      %mo ⊔
                      %mrow
                        %mi i
                        %mo ∈
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi 𝒢
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi Aut
                      %mi 𝒢
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p \;\colon\; \mathcal{G} \longrightarrow \underset{i \in \pi_0(\mathcal{G})}{\sqcup} Aut_{\mathcal{G}}(x_i)
            %p
              which sends each object to its connected component, and which for pairs of objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is given by
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              with the morphisms choosen above:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mi 𝒢
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo ,
                            %mi z
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mrow
                                    %mi y
                                    %mo ,
                                    %mi z
                          %mtd
                          %mtd
                            %msub
                              %mi Aut
                              %mi 𝒢
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                        %mtr
                          %mtd
                        %mtr
                          %mtd
                            %mi y
                          %mtd
                          %mtd
                            %mi y
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %msub
                                  %mi f
                                  %mrow
                                    %msub
                                      %mi x
                                      %mi i
                                    %mo ,
                                    %mi y
                          %mtd
                            %msub
                              %mi x
                              %mi i
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↦
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi z
                          %mtd
                          %mtd
                            %mi z
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi f
                                  %mrow
                                    %msub
                                      %mi x
                                      %mi i
                                    %mo ,
                                    %mi z
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                          %mtd
                            %msub
                              %mi x
                              %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom_{\mathcal{G}}(y,z) &amp;\overset{p_{y,z}}{\longrightarrow}&amp; &amp; Aut_{\mathcal{G}}(x_i) &amp;
                    \\\
                    \\\
                    y                 &amp;&amp;                     y &amp; \overset{f_{x_i,y}}{\longleftarrow}&amp; x_i
                    \\\
                    {}^{\mathllap{f}} \downarrow &amp;\mapsto&amp;     {}^{\mathllap{f}}\downarrow
                    \\\
                    z                 &amp;&amp;                     z &amp; \underset{f_{x_i,z}^{-1}}{\longrightarrow} &amp; x_i
                    }
                    \\,.
            %p It is now sufficient to show that there are conjugations/natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mi inc
                    %mo ≃
                    %mi id
                    %mphantom
                      %mi AAAA
                    %mi inc
                    %mo ∘
                    %mi p
                    %mo ≃
                    %mi id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p \circ inc \simeq id
                    \\phantom{AAAA}
                    inc \circ p \simeq id
                    \\,.
            %p For the first this is immediate, since we even have equality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mi inc
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi id
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p \circ inc \;=\; id
                    \\,.
            %p For the second we observe that choosing
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi f
                      %mrow
                        %msub
                          %mi x
                          %mi i
                        %mo ,
                        %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(y) \coloneqq f_{x_i,y}
            %p yields a naturality square by the above construction:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mi i
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mrow
                                    %msub
                                      %mi x
                                      %mi i
                                    %mo ,
                                    %mi y
                          %mtd
                            %mi y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mrow
                                      %msub
                                        %mi x
                                        %mi i
                                      %mo ,
                                      %mi z
                                  %mo ∘
                                  %mi f
                                  %mo ∘
                                  %msubsup
                                    %mi f
                                    %mrow
                                      %msub
                                        %mi x
                                        %mi i
                                      %mo ,
                                      %mi y
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 1
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                        %mtr
                          %mtd
                            %msub
                              %mi x
                              %mi i
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mrow
                                    %msub
                                      %mi x
                                      %mi i
                                    %mo ,
                                    %mi z
                          %mtd
                            %mi z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x_i &amp;\overset{f_{x_i,y}}{\longrightarrow}&amp; y
                    \\\
                    {}^{ \mathllap{ f_{x_i,z} \circ f \circ f_{x_i,y}^{-1} } }\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                    \\\
                    x_i &amp;\underset{f_{x_i,z}}{\longrightarrow}&amp; z
                    }
                    \\,.
          %p
          #EveryGroupoidIsomorphicToQuasiSkeletalGroupoid.num_remark
            %h6 Remark
            %p
              %strong (every groupoid is isomorphic to a quasi-skeletal groupoid)
              %br/
              Sometimes it is useful to reformulate the content of Prop.
              %a.maruku-ref{:href => "#EveryGroupoidIsEquivalentToDisjointUnionOfGroupDeloopings"}
              as a statement not about
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
              but of
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              between a groupoid and a
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoid"} skeletal groupoid
            %p
              Namely, notice that in particular the
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+groupoid"} codiscrete groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CoDisc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CoDisc(S)
              on any
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} S \in Set
              is equivalent to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+groupoid"} terminal groupoid
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoid"} skeleta
            %p
              Namely if we say that a groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is
              %em quasi-skeletal
              if it is the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              %a.existingWikiWord{:href => "/nlab/show/product+groupoids"} product groupoids
              of
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
              with a
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+groupoid"} codiscrete groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mi CoDisc
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}
                    \\;\simeq\;
                    \\underset{i \in I}{\coprod}
                    \\Big(
                    \\mathbf{B}G_i
                    \\,\times\,
                    CoDisc(S_i)
                    \\Big)
            %p
              then the same construction as in the proof of Prop.
              %a.maruku-ref{:href => "#EveryGroupoidIsEquivalentToDisjointUnionOfGroupDeloopings"}
              shows that every groupoid is
              %em
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              (in the
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              between
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict
              groupoids) to a quasi-skeletal groupoid.
            %p
              To see this in detail, it is clearly sufficient to show for every
              %em connected
              groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_i
              that there is the following isomorphism, where we are using the notation and choices
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mrow
                        %msub
                          %mi x
                          %mi i
                        %mo ,
                        %mi x
                  %annotation{:encoding => "application/x-tex"} f_{x_i,x}
              from the proof of Prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#EveryGroupoidIsEquivalentToDisjointUnionOfGroupDeloopings"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi 𝒢
                                  %mi i
                                %mspace{:width => "thickmathspace"}
                                %mtext connected
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mo ⊢
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                            %mi 𝒢
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi Iso
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mi ϕ
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi 𝒢
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %mo ,
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo ×
                            %mi CoDisc
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi Obj
