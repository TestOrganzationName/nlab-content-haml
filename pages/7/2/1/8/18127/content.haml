                                %mrow
                                  %mi p
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mrow
                                      %msub
                                        %mi U
                                        %mi i
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_i \times Disc(F_i) &amp;&amp; \overset{\simeq}{\longrightarrow} &amp;&amp; \p^{-1}(U_i)
                    \\\
                    \&amp; {}_{\mathllap{pr_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{p|_{U_i}}}
                    \\\
                    \&amp;&amp; U_i
                    }
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              (
              %a{:href => "Introduction+to+Topology+--+1#BinaryProductTopologicalSpace"}> this example
              ) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              with the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              (
              %a{:href => "Introduction+to+Topology+--+1#CoDiscreteTopology"}> this example
              ) on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F_i
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %msub
                            %mi U
                            %mi i
                    %annotation{:encoding => "application/x-tex"} p|_{U_i}
            %p
              In other words
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E \to X
              is a covering space if there exists a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mi i
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi F
                              %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %munder
                              %mo ⊔
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msub
                              %mi U
                              %mi i
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{i}{\sqcup} U_i \times Disc(F_i) &amp;\longrightarrow&amp;  E
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \\underset{i \in I}{\sqcup} U_i &amp;\underset{}{\longrightarrow}&amp; X
                    }
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in U_i \subset X
              a point, the elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi x
                    %mo =
                    %msub
                      %mi F
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F_x  = F_i
              are called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/leaves"} leaves
              of the covering at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              Given two covering spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mi i
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p_i \colon E_i \to X
              , then a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              between them is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon E_1 \to E_2
              between the total covering spaces, which respects the
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              in that the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_1 &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; E_2
                    \\\
                    \&amp; {}_{\mathllap{p_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{p_2}}
                    \\\
                    \&amp;&amp; X
                    }
                    \\,.
            %p
              This defines a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cov
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cov(X)
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+of+covering+spaces"} category of covering spaces
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the covering spaces over
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are the homomorphisms between these.
          #TrivialCoveringSpace.num_example
            %h6#example_13 Example
            %p
              %strong (trivial covering space)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              on that set, then the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              out of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    pr_1 \;\colon\; X \times Disc(S) \longrightarrow X
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %em trivial covering space
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Disc(S)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo ⟶
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\longrightarrow} X
              is any covering space, then an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of covering spaces of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                          %mtd
                            %mi X
                            %mo ×
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi pr
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E &amp;&amp; \overset{\simeq}{\longrightarrow} &amp;&amp; X \times Disc(S)
                    \\\
                    \&amp; {}_{\mathllap{p}}\searrow &amp;&amp; \swarrow_{\mathrlap{pr_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              is called a
              %em trivialization
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mover
                        %mo →
                        %mi p
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
            %p
              It is in this sense that every covering space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is, by definition, locally trivializable.
          #kForlCovringOfCircle.num_example
            %h6#example_14 Example
            %p
              %strong (covering of circle by circle)
            %div{:style => "float:left;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/pFoldCoveringOfCircleB.png", :width => "180"}/
            %p
              Regard the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi z
                    %mo ∈
                    %mi ℂ
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi z
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S^1 = \{ z \in \mathbb{C}  \;\vert\; {\vert z\vert} = 1 \}
              as the
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of elements of unit
              %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %msup
                        %mi ℕ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}^{+}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mn 1
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    p \coloneqq (-)^k \;\colon\; S^1 \longrightarrow S^1
            %p
              given by taking a complex number to its
              = succeed "-th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              times around itself”. Precisely, this is a
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpace"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              leaves at each point.
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "homotopy+equivalence#Hatcher"} Hatcher
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #CoveringOfCircleByRealLine.num_example
            %h6#example_15 Example
            %p
              %strong (covering of circle by real line)
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/UniversalCoveringOfCircle.png", :width => "150"}/
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi π
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo ⟶
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(2 \pi i(-)) \;\colon\; \mathbb{R}^1 \longrightarrow S^1
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %ol
              %li
                %p
                  with the circle regarded as the unit circle in the
                  %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ↦
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi π
                        %mi i
                        %mi t
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        t \mapsto \exp(2\pi i t)
              %li
                %p
                  with the circle regarded as the unit circle in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mi cos
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi π
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi sin
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi π
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        t \mapsto ( cos(2\pi t), sin(2\pi t) )
                        \\,.
            %p
              We may think of this as the result of “winding the line around the circle ad infinitum”. Precisely, this is a
              %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringSpace"}
              %a.existingWikiWord{:href => "/nlab/show/leaves"} leaves
              at each point forming the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %p
              Below in example
              %a.maruku-ref{:href => "#UniversalCoveringRealLineOfCircle"}
              we see that this is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
              of the circle.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p Here are some basic properties of covering spaces:
          #CoveringProjectionsAreOpenMaps.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (covering projections are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/open+maps"} open maps
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E \to X
              is a covering space projection, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
          .proof
            %h6#proof_11 Proof
            %p
              By definition of covering space there exists an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              and
              %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p^{-1}(U_i) \simeq U_i \times Disc(F_i)
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i \in I
              %a.existingWikiWord{:href => "/nlab/show/projections"} projections
              out of a
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              are
              %a.existingWikiWord{:href => "/nlab/show/open+maps"} open maps
              (
              %a{:href => "Introduction+to+Topology+--+1#ProjectionsAreOpenContinuousFunctions"}> this prop.
              ), it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is an open map when restricted to any of the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^{-1}(U_i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mi E
                  %annotation{:encoding => "application/x-tex"} W \subset E
              is the union of its restrictions to these subspaces:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo =
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∩
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W = \underset{i \in I}{\cup} (W \cap p^{-1}(U_i))
                    \\,.
            %p
              Since images preserve unions (
              %a{:href => "interactions+of+images+and+pre-images+with+unions+and+intersections#PreservationOfUnionsAndIntersectionsOfSets"}> this prop.
              ) it follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ∩
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p(W) = \underset{i \in I}{\cup} p(W \cap p^{-1}(U_i))
            %p is a union of open sets, and hence itself open.
          #CoveringSpaceFiberwiseDiagonalOpenAndClosed.num_lemma
            %h6#lemma_5 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber-wise
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                of covering space is
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi p
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
              be a covering space. Consider the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi E
                    %mo ×
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    E \times_X E \coloneqq \{ (e_1, e_2) \in E \times E \;\vert\; p(e_1) = p(e_2) \}
            %p
              hence (by the discussion at
              = succeed ")" do
                %a{:href => "Top#UniversalConstructions"} Top - Universal constructions
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ×
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E \times E
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                            %msub
                              %mo ×
                              %mi X
                            %mi E
                        %mtr
                          %mtd
                            %mi e
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo ,
                            %mi e
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E &amp;\longrightarrow&amp; E \times_X E
                    \\\
                    e &amp;\mapsto&amp; (e,e)
                    }
                    \\,.
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              under this function is an
              %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
              and a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext is open and closed
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta(E) \subset E \times_X E
                    \\;\;\;
                    \\text{is open and closed}
                    \\,.
          .proof
            %h6#proof_12 Proof
            %p
              First to see that it is an open subset. It is sufficient to show that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} e \in E
              there exists an open neighbourhood of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi E
                      %msub
                        %mo ×
                        %mi X
                      %mi E
                    %annotation{:encoding => "application/x-tex"} (e,e) \in E \times_X E
            %p
              Now by definition of covering spaces, there exists an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_{p(e)} \subset X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p(e) \in X
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi e
                                %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} (
                            %mi e
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                          %mtd
                            %mi E
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mrow
                                    %mi p
                                    %mo{:stretchy => "false"} (
                                    %mi e
                                    %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi pr
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mrow
                                %mi p
                                %mo{:stretchy => "false"} (
                                %mi e
                                %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_{p(e)} \times Disc(p^{-1}(p(e)))
                    \&amp;&amp; \overset{\simeq}{\longrightarrow} &amp;&amp; E\vert_{U_{p(e)}}
                    \\\
                    \&amp; {}_{\mathllap{pr_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{p}}
                    \\\
                    \&amp;&amp; U_{p(e)}
                    }
                    \\,.
            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mi e
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U_{p(e)} \times \{e\} \subset E
              is an open neighbourhood. Hence by the nature of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi U
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U_{p(e)} \times U_{p(e)} \subset E \times E
              is an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,e)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E \times E
              and hence by the nature of the
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              the restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi U
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    (E \times_X E) \cap (U_{p(e)} \times U_{p(e)}) \subset E \times_X E
            %p
              is an open neighbourhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e,e)
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msub
                        %mo ×
                        %mi X
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E \times_X E
            %p
              Now to see that the diagonal is closed, hence that the complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E \times_X E) \setminus \Delta(E)
              is an open subset, it is sufficient to show that every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo ,
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (e_1, e_2)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 1
                    %mo ≠
                    %msub
                      %mi e
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} e_1 \neq e_2
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(e_1) = p(e_2)
              has an open neighbourhood in this complement.
            %p
              As before, there is an open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(e_1) = p(e_2)
              over which the cover trivializes, and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U \times \{e_1\}, U \times \{e_2\} \subset E
              are open neighbourhoods of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} e_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e_2
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 1
                      %mo ≠
                      %msub
                        %mi e
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e_1 \neq e_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∖
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E \times_X E) \cap ( (U \times \{e_1\}) \times (U \times \{e_2\}) )
                    \\subset
                    (E \times_X E) \setminus \Delta(E)
            %p is an open subset of the complement of the diagonal in the fiber product.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#lifting_properties Lifting properties
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mover
                    %mo ⟶
                    %mi p
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \overset{p}{\longrightarrow} X
            is any
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            (possibly a
            %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            or a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
            %em
              %a.existingWikiWord{:href => "/nlab/show/section"} section
            is a continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} \sigma \colon  X \to E
            which sends each point in the base to a point in the
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            above it, hence which makes this
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi σ
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo =
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; E
                  \\\
                  \&amp;{}^{\mathllap{\sigma}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  X &amp;=&amp; X
                  }
                  \\,.
          %p
            We may think of this as “lifting” each point in the base to point in the fibers “through” the projection map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y \hookrightarrow X
            is a subspace, we may consider such lifts only over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi σ
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %mo ↪
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; E
                  \\\
                  \&amp;{}^{\mathllap{\sigma}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  Y &amp;\hookrightarrow&amp; X
                  }
          %p
            sometimes called a “local section”. But this suggests that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mover
                    %mo ⟶
                    %mi f
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y \overset{f}{\longrightarrow} X
            any continuous function, we consider “lifting its image through
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi σ
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi Y
                        %mtd
                          %munder
                            %mo ⟶
                            %mi f
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; E
                  \\\
                  \&amp;{}^{\mathllap{\sigma}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  Y &amp;\underset{f}{\longrightarrow}&amp; X
                  }
                  \\,.
          %p
            For example if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y = [0,1]
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+interval"} topological interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f \colon [0,1] \to X
            is a
            %a.existingWikiWord{:href => "/nlab/show/path"} path
            in the base space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            of this is a path in the total space which “runs above” the given path. Such lifts of paths through covering projections is the topic of
            %em
              %a.existingWikiWord{:href => "/nlab/show/monodromy"} monodromy
            = succeed "." do
              %a{:href => "#Monodromy"} below
          %p
            Here it is of interest to consider the lifting problem subject to some constraint. For instance we will want to consider lifts of paths
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \gamma \colon [0,1] \to X
            through a covering projection, subject to the condition that the starting point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \gamma(0)
            is lifted to a prescribed point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} p \in E
          %p
            Since such a point is equivalently a continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi const
                    %mi p
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} const_p \colon \ast \to X
            out of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            that makes both triangles in the following
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commute
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi const
                                %mi p
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi const
                                  %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi σ
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %munder
                            %mo ⟶
                            %mi γ
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\ast &amp;\overset{const_p}{\longrightarrow}&amp; E
                  \\\
                  {}^{\mathllap{const_0}}\downarrow &amp;{}^{\mathllap{\sigma}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  [0,1] &amp;\underset{\gamma}{\longrightarrow}&amp; X
                  }
                  \\,.
          %p
            This is an example of a general situation which plays a central role in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi i
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp;\longrightarrow&amp; E
                  \\\
                  {}^{\mathllap{i}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  B &amp;\longrightarrow&amp; X
                  }
          %p
            is a
            %em
              %a.existingWikiWord{:href => "/nlab/show/lifting+problem"} lifting problem
            and that a diagonal morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi i
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp;\longrightarrow&amp; E
                  \\\
                  {}^{\mathllap{i}}\downarrow &amp;\nearrow&amp; \downarrow^{\mathrlap{p}}
                  \\\
                  B &amp;\longrightarrow&amp; X
                  }
          %p
            such that both resulting triangles commute is a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            taken from some
            %a.existingWikiWord{:href => "/nlab/show/class"} class
            of morphisms, then one says that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            has the
            %em
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
            against this class.
          %p
            We now discuss some
            %a.existingWikiWord{:href => "/nlab/show/right+lifting+properties"} right lifting properties
            satisfied by covering spaces:
          %ol
            %li
              %p
                %a{:href => "#HomotopyLiftingPropertyOfCoveringSpaces"}> homotopy-lifting property
                ,
            %li
              %p
                the
                = succeed "." do
                  %a{:href => "#TheTheoremLifting"} lifting theorem
          %p
            A first application of the lifting theorem is that it gives the concept of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
            (def.
            = succeed "," do
              %a.maruku-ref{:href => "#UniversalCoveringSpace"}
            %a.maruku-ref{:href => "#UniversalCoveringSpaceUniqueUpToIsomorphism"}
            below) which is central to the theory of covering spaces.
          %p
            These lifting properties will be used in
            %a{:href => "#Examples"} below
            for the computation of
            %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
            and higher
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of some topological spaces.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #LiftsOverConnectedSpaceIntoCoveringSpaceAreUniqueRelativePoint.num_lemma
            %h6#lemma_6 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/lifts"} lifts
                out of
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected space
                into
                %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
                are unique relative to any point)
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi p
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
                  be a covering space,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a
                  %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Y
                        %mo ⟶
                        %mi X
                      %annotation{:encoding => "application/x-tex"} f \;\colon\; Y \longrightarrow X
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mn 1
                        %mo ,
                        %msub
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ^
                          %mn 2
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi Y
                        %mo ⟶
                        %mi E
                      %annotation{:encoding => "application/x-tex"} \hat f_1, \hat f_2 \;\colon\; Y \longrightarrow E
                  two
                  %a.existingWikiWord{:href => "/nlab/show/lifts"} lifts
                  of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi E
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mover
                                          %mi f
                                          %mo{:stretchy => "false"} ^
                                        %mi i
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi p
                            %mtr
                              %mtd
                                %mi Y
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mi f
                              %mtd
                                %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; E
                        \\\
                        \&amp; {}^{\mathllap{\hat f_i}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                        \\\
                        Y &amp;\underset{f}{\longrightarrow}&amp; X
                        }
                %p
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo ∈
                          %mo{:stretchy => "false"} {
                          %mn 1
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} i \in \{1,2\}
            %p
              If there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat f_1(y) = \hat f_2(y)
              then the two lifts already agree everywhere:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mn 1
                      %mo =
                      %msub
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \hat f_1 = \hat f_2
          .proof
            %h6#proof_13 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mn 1
                      %mo ,
                      %msub
                        %mi e
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi E
                      %mo ×
                      %mi E
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi e
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mo ⊂
                    %mi E
                    %mo ×
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    E \times_X E \coloneqq \left\{ (e_1, e_2) \in E \times E \;\vert\; p(e_1) = p(e_2) \right\} \subset E \times E
            %p the two lifts determine a single continuous function of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mo ⟶
                    %mi E
                    %msub
                      %mo ×
                      %mi X
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\hat f_1, \hat f_2)
                    \\;\colon\;
                    Y \longrightarrow E \times_X E
                    \\,.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi E
                      %msub
                        %mo ×
                        %mi X
                      %mi E
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi e
                      %mo ∈
                      %mi E
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta(E)  \coloneqq \left\{ (e,e) \in E \times_X E \;\vert\; e \in E  \right\}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              in the fiber product. By lemma
              %a.maruku-ref{:href => "#CoveringSpaceFiberwiseDiagonalOpenAndClosed"}
              this is an open subset and a closed subset of the fiber product space. Hence by continuity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\hat f_1, \hat f_2)
              also its pre-image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    (\hat f_1, \hat f_2)^{-1}(\Delta(E)) \subset Y
            %p
              is both closed and open, hence also its
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              is open in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %p
              Moreover, the assumption that the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \hat f_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat f_2
              agree in at least one point means that the above pre-image is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              implies that this pre-image coincides with all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          #CoveringSpacePathLifting.num_lemma
            %h6#lemma_7 Lemma
            %p
              %strong (path lifting property)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E \to X
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \gamma \colon [0,1] \to X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/path"} path
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} ^
                          %mn 0
                        %mo ∈
                        %mi E
                      %annotation{:encoding => "application/x-tex"} \hat x_0 \in E
                  be a lift of its starting point, hence such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:stretchy => "false"} (
                        %msub
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} ^
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi γ
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} p(\hat x_0) = \gamma(0)
            %p
              then there exists a unique path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \hat \gamma \colon [0,1] \to E
              such that
            %ol
              %li
                %p
                  it is a lift of the original path:
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo ∘
                          %mover
                            %mi γ
                            %mo{:stretchy => "false"} ^
                          %mo =
                          %mi γ
                        %annotation{:encoding => "application/x-tex"} p \circ \hat \gamma = \gamma
              %li
                %p
                  it starts at the given lifted point:
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi γ
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} ^
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \hat \gamma(0) = \hat x_0
            %p
              In other words, every
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mover
                                    %mi x
                                    %mo{:stretchy => "false"} ^
                                  %mn 0
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi γ
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{0\} &amp;\overset{\hat x_0}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    [0,1] &amp;\underset{\gamma}{\longrightarrow}&amp; X
                    }
            %p
              has a unique
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mover
                                    %mi x
                                    %mo{:stretchy => "false"} ^
                                  %mn 0
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi γ
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi γ
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\{0\} &amp;\overset{\hat x_0}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow
                    \&amp;{}^{\mathllap{\hat \gamma}}\nearrow&amp;
                    \\downarrow^{\mathrlap{p}}
                    \\\
                    [0,1] &amp;\underset{\gamma}{\longrightarrow}&amp; X
                    }
                    \\,.
          .proof
            %h6#proof_14 Proof
            %p
              First consider the case that the covering space is trivial, hence of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    pr_1 \;\colon\;  X \times Disc(S) \longrightarrow X
                    \\,.
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
              in this case a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat \gamma \colon [0,1] \to X \times Disc(S)
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of continuous functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                    %mphantom
                      %mi AAAA
                    %msub
                      %mi pr
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    pr_1(\hat \gamma) \colon [0,1] \to X  \phantom{AAAA} pr_2(\hat \gamma) \colon [0,1] \to Disc(S)
                    \\,,
            %p
              Now the lifting condition explicitly fixes
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi pr
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} pr_1(\hat \gamma) = \gamma
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+constant+function"} locally constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is a
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected topological space
              this means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi pr
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} pr_2(\hat \gamma)
              is in fact a
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
              (
              %a{:href => "connected+space#LocallyConstantFunctionsOnConnectedSpaces"}> this example
              ), hence uniquely fixed to be
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi pr
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mover
                          %mi x
                          %mo{:stretchy => "false"} ^
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} pr_2(\hat \gamma) = \hat x_0
            %p This shows the statement for the case of trivial covering spaces.
            %p
              Now consider any covering space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p \colon E \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              such that the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U_x
              becomes a trivial covering space:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi U
                      %mi x
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    p^{-1}(U_x) \simeq U_x \times Disc(p^{-1}(x))
                    \\,.
            %p Consider such a choice
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{U_x \subset X\}_{x \in X}
                    \\,.
            %p
              This is an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/pre-images"} pre-images
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi γ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⊂
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo }
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\gamma^{-1}(U_x)
                    \\subset
                    [0,1]
                    \\right\}_{x \in X}
            %p
              constitute an open cover of the
              %a.existingWikiWord{:href => "/nlab/show/topological+interval"} topological interval
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            %p
              This means that we find a
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite number
              of points
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 0
                    %mo &lt;
                    %msub
                      %mi t
                      %mn 1
                    %mo &lt;
                    %mi ⋯
                    %msub
                      %mo &lt;
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    t_0 \lt t_1 \lt \cdots \lt_{n+1} \in [0,1]
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 0
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} t_0 = 0
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} t_{n+1} = 1
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi j
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 0 \lt j \leq n
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi j
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x_j \in X
              such that the corresponding path segment
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mi j
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma([t_j, t_{j+1}]) \subset X
            %p
              is contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi x
                          %mi j
                  %annotation{:encoding => "application/x-tex"} U_{x_j}
              from above.
            %p
              Now assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %msub
                          %mi t
                          %mi j
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[0,t_j]}
              has been found. Then by the triviality of the covering space over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi x
                          %mi j
                  %annotation{:encoding => "application/x-tex"} U_{x_j}
              and the first argument above, there is a unique lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \gamma\vert_{[t_j, t_{j+1}]}
              to a continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma|_{[t_j,t_{j+1}]}
              with starting point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi t
                        %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat \gamma(t_j)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,t_{j+1}]
              is the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %msub
                      %mi t
                      %mi j
                    %mo{:stretchy => "false"} ]
                    %munder
                      %mo ⊔
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi t
                          %mi j
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mi j
                    %mo ,
                    %msub
                      %mi t
                      %mrow
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,t_j] \underset{\{t_j\}}{\sqcup} [t_j,t_{j+1}]
              (
              %a{:href => "Top#TopologicalnSphereIsPushoutOfBoundaryOfnBallInclusionAlongItself"}> this example
              ), it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %msub
                          %mi t
                          %mi j
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma|_{[0,t_j]}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[t_j,t_{j+1}]}
              uniquely glue to a continuous function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[0,t_{j+1}]}
              which lifts
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %msub
                            %mi t
                            %mrow
                              %mi j
                              %mo +
                              %mn 1
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \gamma\vert_{[0,t_{j+1}]}
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \gamma
            %p
              Conversely, given any lift,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi γ
                      %mo{:stretchy => "false"} ^
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi t
                          %mi j
                        %mo ,
                        %msub
                          %mi t
                          %mrow
                            %mi j
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat \gamma\vert_{[t_j, t_{j+1}]}
              are uniquely fixed by the above inductive argument. Therefore also the total lift is unique. Alternatively, uniqueness of the lifts is a special case of lemma
              = succeed "." do
                %a.maruku-ref{:href => "#LiftsOverConnectedSpaceIntoCoveringSpaceAreUniqueRelativePoint"}
          #HomotopyLiftingPropertyOfCoveringSpaces.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homotopy+lifting+property"} homotopy lifting property
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi p
                        %mi X
                      %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} X
                  be a covering space;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %p
              Then every
              %a.existingWikiWord{:href => "/nlab/show/lifting+problem"} lifting problem
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi y
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\overset{\hat f}{\longrightarrow}&amp; E
                    \\\
                    {}^{\mathllap{ (id_y, const_0)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    Y \times [0,1] &amp;\underset{\eta}{\longrightarrow}&amp; X
                    }
            %p
              has a unique
              %a.existingWikiWord{:href => "/nlab/show/lift"} lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi y
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi η
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi Y
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Y &amp;\overset{\hat f}{\longrightarrow}&amp; E
                    \\\
                    {}^{\mathllap{ (id_y, const_0)}}\downarrow
                    \&amp;{}^{\mathllap{\hat \eta}}\nearrow&amp;
                    \\downarrow^{\mathrlap{p}}
                    \\\
                    Y \times [0,1] &amp;\underset{\eta}{\longrightarrow}&amp; X
                    }
                    \\,.
          .proof
            %h6#proof_15 Proof
            %p
              It is clear what the lift must be: For every point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              the situation restricts to that of path lifting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi const
                                  %mi y
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi const
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi y
                                  %mo ,
                                  %msub
                                    %mi const
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi η
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi const
                                  %mi y
                                %mo ,
                                %mi id
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi Y
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\ast &amp;\overset{const_y}{\longrightarrow}&amp; Y &amp;\overset{f}{\longrightarrow}&amp; E
                    \\\
                    {}^{\mathllap{const_0}}\downarrow
                    \&amp;&amp;
                    {}^{\mathllap{ (id_y, const_0)}}\downarrow
                    \&amp;{}^{\mathllap{\hat \eta}}\nearrow&amp;
                    \\downarrow^{\mathrlap{p}}
                    \\\
                    [0,1] &amp;\underset{(const_y,id)}{\longrightarrow}&amp; Y \times [0,1] &amp;\underset{\eta}{\longrightarrow}&amp; X
                    }
                    \\,.
            %p
              And so at each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              the lift of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta(x,-)
              must be the unique path that lifts this with starting point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat \hat f(y)
            %p
              To that end we generalize he proof of the path lifting to connected open neighbourhoods of points in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an open cover over which the covering space trivializes. Then the pre-images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi η
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{\eta^{-1}(U_i) \subset Y \times [0,1]\}_{i \in I}
              is an open cover of the product space. By nature of the
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space topology
              and the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+topology"} Euclidean topology
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi η
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta^{-1}(U_i)
              is a union of Cartesian products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                    %mo ×
                    %msub
                      %mi I
                      %mi j
                  %annotation{:encoding => "application/x-tex"} V_j \times I_j
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi i
                    %mo ⊂
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} V_i \subset Y
              an open subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi i
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I_i \subset [0,1]
              an interval. Hence there is an open cover of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mo ×
                    %msub
                      %mi I
                      %mi j
                    %mo ⊂
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi j
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"}
                    \\{
                    V_j \times I_j \subset Y \times [0,1]
                    \\}_{j \in J}
            %p
              with the property that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi V
                        %mi j
                      %mo ×
                      %msub
                        %mi I
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \eta(V_j \times I_j) \subset U_i
            %p
              Now by the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y \in Y
              there exists a finite set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi y
                    %mo ⊂
                    %mi J
                  %annotation{:encoding => "application/x-tex"} K_y \subset J
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi k
                    %mo ×
                    %msub
                      %mi I
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi K
                          %mi y
                        %mo ⊂
                        %mi K
                  %annotation{:encoding => "application/x-tex"}
                    \\{ V_k \times I_k \}_{k \in K_y \subset K}
            %p
              still restricts to a cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \{y\} \times [I]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is finite, the intersection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi y
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∩
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi K
                          %mi y
                  %annotation{:encoding => "application/x-tex"}
                    V_y \;\coloneqq\; \underset{k \in K_y}{\cap}
            %p is still open, and so also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi y
                    %mo ×
                    %msub
                      %mi I
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %msub
                          %mi K
                          %mi y
                  %annotation{:encoding => "application/x-tex"}
                    \\{ V_y \times I_k \}_{k \in K_y}
            %p
              still restricts to a cover of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \{y\} \times [0,1]
            %p
              This means that the same argument as for the path lifting in lemma
              %a.maruku-ref{:href => "#CoveringSpacePathLifting"}
              provides a unique lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi η
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi V
                              %mi y
                            %mo ×
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{\eta\vert_{V_y \times [0,1]}}
              for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} y \in Y
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 2
                    %mo ∈
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} y_1, y_2 \in Y
              two points, these lifts clearly have to agree on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi y
                            %mn 1
                      %mo ∩
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi y
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} V_{y_1} \cap V_{y_2}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊂
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                  %annotation{:encoding => "application/x-tex"} \{V_y \times [0,1] \subset Y \times [0,1]\}_{y \in Y}
              is an open cover, means that there is a unique function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \eta
              that restricts to all these local lifts (
              %a{:href => "Top#ClosedSubspacesGluing"}> this prop
              ). This is the required lift.
          #CoveringSpacesAreSerreFibrationsButNotInGeneralHurewiczFibrations.num_remark
            %h6#remark_9 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/covering+spaces"} covering spaces
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibrations"} Hurewicz fibrations
            %p
              Continuous functions that satisfy the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+lifting+property"} homotopy lifting property
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against continuous functions of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %msub
                          %mi const
                          %mn 0
                        %mo{:stretchy => "false"} )
                    %mi Y
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Y \overset{(id, const_0)}{\longrightarrow} Y \times [0,1]
              are called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibrations"} Hurewicz fibrations
              %a.maruku-ref{:href => "#HomotopyLiftingPropertyOfCoveringSpaces"}
              says that covering projections are in particular Hurewicz fibrations.
          #CoveringSpacesHomotopyLifting.num_example
            %h6#example_16 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homotopy+lifting+property"} homotopy lifting property
                for given lifts of paths relative starting point)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p \colon E \to X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              relative the starting point between two
              %a.existingWikiWord{:href => "/nlab/show/paths"} paths
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi γ
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi γ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; \gamma_1 \Rightarrow \gamma_2
            %p
              there is for every lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat \gamma_1, \hat \gamma_2
              of these two paths to paths in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with the same starting point a unique homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi η
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo ⇒
                    %msub
                      %mover
                        %mi γ
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \eta \;\colon\; \hat \gamma_1 \Rightarrow \hat \gamma_2
            %p between the lifted paths that lifts the given homotopy:
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/commuting+squares"} commuting squares
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
