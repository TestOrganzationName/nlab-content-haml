                    \\pi_1 \;\colon\; Top^{\ast/} \longrightarrow Grp
                    \\,.
          #DependenceOnHomotopyClassesFundamentalGroup.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                depends only on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} X,Y \in Top^{\ast/}
              be
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f_1, f_2 \;\colon\; X \longrightarrow Y
              be two base-point preserving continuous functions. If there is a pointed
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#LeftHomotopy"}
              = succeed ")" do
                %a.maruku-ref{:href => "#PointedTopologicalSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi f
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi f
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; f_1 \Rightarrow f_2
            %p
              then the induced
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              on fundamental groups (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PushElementsFundamentalGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_1)_\ast = (f_2)_\ast \;\colon\; \pi_1(X,x) \to \pi_1(Y,y)
                    \\,.
            %p
              In particular if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mo ;
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \;\colon; X \longrightarrow Y
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopyEquivalence"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\ast \;\colon\; \pi_1(X,x) \to \pi_1(Y,y)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_3 Proof
            %p
              This follows by the fact that homotopy respects composition (prop.
              = succeed "):" do
                %a.maruku-ref{:href => "#EquivRelHomotopy"}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \gamma \;\colon\; [0,1] \longrightarrow X
              is a closed path representing a given element of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(X,x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ⇒
                    %msub
                      %mi f
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_1 \Rightarrow f_2
              induces a homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo ∘
                    %mi γ
                    %mo ⇒
                    %msub
                      %mi f
                      %mn 2
                    %mo ∘
                    %mi γ
                  %annotation{:encoding => "application/x-tex"}
                    f_1 \circ \gamma \Rightarrow f_2 \circ \gamma
            %p
              and therefore these represent the same elements in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_1(Y,y)
            %p
              If follows that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a homotopy equivalence with homotopy inverse
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_\ast \colon \pi_1(Y,y) \to \pi_1(X,x)
              is an
              %a.existingWikiWord{:href => "/nlab/show/inverse+morphism"} inverse morphism
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_\ast \colon \pi_1(X,x) \to \pi_1(Y,y)
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_\ast
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .num_remark
            %h6#remark_6 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#DependenceOnHomotopyClassesFundamentalGroup"}
              says that the fundamental group functor from def.
              %a.maruku-ref{:href => "#PushElementsFundamentalGroup"}
              and remark
              %a.maruku-ref{:href => "#FundamentalGroupFunctor"}
              factors through the
              %a.existingWikiWord{:href => "/nlab/show/classical+pointed+homotopy+category"} classical pointed homotopy category
              from remark
              = succeed ":" do
                %a.maruku-ref{:href => "#PointedTopologicalSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi Top
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi π
                                  %mn 1
                          %mtd
                            %mi Grp
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
