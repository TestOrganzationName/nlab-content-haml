                    %msub
                      %mi 𝒢
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{G}_1 \longrightarrow \mathcal{G}_2
              be a homomorphism of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %p
              Assuming the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              then the following are equivalent:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
                  (def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#EquivalenceOfGroupoids"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                  (def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#GroupoidWeakHomotopyEquivalence"}
          .proof
