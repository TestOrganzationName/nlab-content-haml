              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path-connected topological space
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+spaces"} universal covering spaces
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
