          #PointedTopologicalSpaces.num_remark
            %h6#remark_4 Remark
            %p
              %strong (basepoints)
            %p
              Definition
              %a.maruku-ref{:href => "#FundamentalGroupoidAndFundamentalGroup"}
              intentionally offers two variants of the definition.
            %p
              The first, the
              %em
                %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              is canonically given, without choosing a basepoint. As a result, it is a structure that is not quite a
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              but, slightly more generally, a “
              %a.existingWikiWord{:href => "/nlab/show/groupoid"}> groupoid
              ” (a “group with many objects”). We discuss the concept of
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              = succeed "." do
                %a{:href => "#Groupoid"} below
            %p
              The second, the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
            %p In this context it is useful to say that
            %ol
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,x)
                  is
                %ol
                  %li
                    %p
                      a
                      %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi X
                            %annotation{:encoding => "application/x-tex"} X
                  %li
                    %p
                      a
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
                            %mo ∈
                            %mi X
                          %annotation{:encoding => "application/x-tex"} x \in X
                      in the underlying set.
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  of pointed topological spaces
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \;\colon\; (X,x) \longrightarrow (Y,y)
                  is a base-point preserving continuous function, namely
                %ol
                  %li
                    %p
                      a
                      %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi f
                            %mspace{:width => "thickmathspace"}
                            %mo{:lspace => "verythinmathspace"} :
                            %mspace{:width => "thickmathspace"}
                            %mi X
                            %mo ⟶
                            %mi Y
                          %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
                  %li
                    %p
                      such that
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mi y
                            %annotation{:encoding => "application/x-tex"} f(x) = y
            %p
              Hence there is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              are tbe base-point preserving continuous functions.
            %p
              Similarly, a
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              between morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi f
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f, f' \colon (X,x) \to (Y,y)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo ⇒
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \eta \colon f \Rightarrow f'
              of underlying
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              = succeed "," do
                %a.maruku-ref{:href => "#LeftHomotopy"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; X \times [0,1] \longrightarrow Y
            %p preserves the basepoints in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∀
                      %mrow
                        %mi t
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{t \in [0,1]}{\forall} \eta(x,t) = y
                    \\,.
            %p
              These pointed homotopies still form an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              as in prop.
              %a.maruku-ref{:href => "#EquivRelHomotopy"}
              and hence quotienting these out yields the pointed analogue of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              from def.
              = succeed "," do
                %a.maruku-ref{:href => "#HomotopyCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\kappa \;\colon\; Top^{\ast/} \longrightarrow Ho(Top^{\ast/})
                    \\,.
          %p In general it is hard to explicitly compute the fundamental group of a topological space. But often it is already useful to know if two spaces have the same fundamental group or not:
          #PushElementsFundamentalGroup.num_defn
            %h6#definition_7 Definition
            %p
              %strong
                (pushforward of elements of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,y)
              be
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#PointedTopologicalSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; X \longrightarrow Y
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              which respects the chosen points, in that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} f(x) = y
            %p
              Then there is an induced
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groups"} fundamental groups
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FundamentalGroupoidAndFundamentalGroup"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mo *
                          %mtd
                            %msub
                              %mi π
                              %mn 1
