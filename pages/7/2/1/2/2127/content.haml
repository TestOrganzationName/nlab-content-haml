          %h2#definition Definition
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            is
            %strong small
            if it is
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact
            for some
            %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            (and therefore also for all greater regular cardinals).
          %p
            Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is called
            = succeed "-compact" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} corepresentable functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} hom(X,\cdot)
            preserves
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/directed+colimit"} directed colimit
          %h2#details Details
          %p
            We unwrap the definition further. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            be a
            = succeed "-filtered" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo ′
                  %mo ⊂
                  %mi J
                %annotation{:encoding => "application/x-tex"} J' \subset J
            of cardinality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi J
                  %mo ′
                  %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi κ
                %annotation{:encoding => "application/x-tex"} |J'| \lt \kappa
            has an upper bound in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a category and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi J
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : J \to C
            a diagram, called a
            = succeed "-filtered" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} X \in C
            be any
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
          %p
            Then the condition that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            commutes with the colimit over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            means that the map of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %msup
                        %mo →
                        %mi j
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
