                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A:U \quad \Gamma \vdash B:U}{\Gamma \vdash T(\mathrm{EntRel}(A, B)) \equiv \sum_{R:T(A) \times T(B) \to U} \prod_{x:T(A)} \left(\prod_{y:T(A)} \mathrm{isProp}(T(R(x, y)))\right) \times \exists y:T(A).T(R(x, y)) \; \mathrm{type}}
          %p
            For
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+Tarski+universes"} weak Tarski universes
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+types"} equivalence of types
            instead of
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
