                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} isProp
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mo ×
                  %mo ∃
                  %mi y
                  %mo :
