                          %mo )
                        %mo )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi H
                      %mrow
                        %mi gh
                        %mo +
                        %mi af
                    %mrow
                      %mo (
                      %mi CE
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi 𝔤
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi d
                            %mi S
                            %mo ≃
                            %mn 0
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^{gh}
                    \\left(
                    H^{af}
                    \\left(
                    CE\left(  (X/\mathfrak{g})_{d S \simeq 0} \right)
                    \\right)
                    \\right)
                    \\;\Rightarrow\;
                    H^{gh + af}\left(
                    CE\left(  (X/\mathfrak{g})_{d S \simeq 0} \right)
                    \\right)
                    \\,.
            %p
              Under the given assumption the second page of this
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              is concentrated on the row
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi af
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} af = 0
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              (
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              over the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a{:href => "spectral+sequence#ExtensionProblem"} extension problem
              is trivial, and hence the claim follows.
            %p
              Now if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is inside the
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              of a point, then example
              %a.maruku-ref{:href => "#OrdinaryCriticalLocusAsCohomologyOfDerivedCriticalLocus"}
              says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi BV
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^0(s_{BV})
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi deg
                      %mi gh
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} deg_{gh} = 0
              consists of the functions on the ordinary critical locus and hence the abvove result implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi H
                              %mn 0
                            %mrow
                              %mo (
                              %mi CE
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} /
                                %mi 𝔤
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mi d
                                    %mi S
                                    %mo ≃
                                    %mn 0
                                %mo )
                              %mo )
                          %mtd
                            %mo =
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi s
                              %mi BRST
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msup
                                  %mi C
                                  %mn ∞
                                %mrow
                                  %mo (
                                  %msub
                                    %mi X
                                    %mrow
                                      %mi d
                                      %mi S
                                      %mo =
                                      %mn 0
                                  %mo )
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} /
                            %mspace{:width => "thinmathspace"}
                            %munder
                              %munder
                                %mrow
                                  %mi im
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi s
                                    %mi BRST
                                  %mo{:stretchy => "false"} )
                                  %msub
                                    %mo{:stretchy => "false"} |
                                    %mrow
                                      %msup
                                        %mi C
                                        %mn ∞
                                      %mrow
                                        %mo (
                                        %msub
                                          %mi X
                                          %mrow
                                            %mi d
                                            %mi S
                                            %mo =
                                            %mn 0
                                        %mo )
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi s
                              %mi BRST
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msup
                                  %mi C
                                  %mn ∞
                                %mrow
                                  %mo (
                                  %msub
                                    %mi X
                                    %mrow
                                      %mi d
                                      %mi S
                                      %mo =
                                      %mn 0
                                  %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mrow
                              %mo {
                              %msub
                                %mi X
                                %mrow
                                  %mi d
                                  %mi S
                                  %mo =
                                  %mn 0
                              %mover
                                %mo ⟶
                                %mi f
                              %mi ℝ
                              %mspace{:width => "thinmathspace"}
                              %mo{:stretchy => "false"} |
                              %mspace{:width => "thinmathspace"}
                              %mrow
                                %mo (
                                %msubsup
                                  %mi R
                                  %mi α
                                  %mi a
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi S
                                  %mrow
                                    %mo ∂
                                    %msup
                                      %mi ϕ
                                      %mi a
                                %mo =
                                %mn 0
                                %mo )
                              %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    H^0\left( CE\left( (X/\mathfrak{g})_{d S \simeq 0}\right) \right)
                    \&amp; =
                    ker(s_{BRST})\vert_{C^\infty\left( X_{d S = 0} \right) }
                    \\,/\,
                    \\underset{= 0}{
                    \\underbrace{
                    im(s_{BRST})\vert_{C^\infty\left(  X_{d S = 0} \right)}
                    }
                    }
                    \\\
                    \&amp; = ker(s_{BRST})\vert_{C^\infty\left( X_{d S = 0} \right) }
                    \\\
                    \&amp; =
                    \\left\{
                    X_{d S = 0} \overset{f}{\longrightarrow} \mathbb{R}
                    \\,\vert\,
                    \\left(
                    R_\alpha^a \frac{\partial S}{\partial \phi^a}
                    \=
                    0
                    \\right)
                    \\right\}
                    \\end{aligned}
          %p
            This means that under condition
            %a.maruku-eqref{:href => "#eq:VanishingOfNaiveLieAlgebroidBVCohomlogyInNegativeDegree"} (11)
            the construction of a
            %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
            inside an
            %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
            provides a
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of the space of those functions which are
          %ol
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/restriction"} restricted
                to the
                %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
                (a
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+intersection"} homotopy intersection
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                under the
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
                (a
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
          %p
            We apply this general mechanism
            %a{:href => "#DerivedCriticalLocusOnJetBundle"} below
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            by the
            %em
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            of the space of
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            which are
          %ol
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/on-shell"}> on-shell
                ,
            %li
              %p
                %em>
                  %a.existingWikiWord{:href => "/nlab/show/gauge+invariance"} gauge invariant
                \.
          %p
            But in order to control this application, we first establish the tool of the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"}> Schouten bracket
                \/
                %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#SchoutenBracketAntibracket
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"}> Schouten bracket
              \/
              %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
          %p
            Since the infinitesimal cotangent Lie algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi T
                    %mi inf
                    %mo *
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} T^\ast_{inf} \mathfrak{a}
            has function algebra given by tensor products of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            of ordinary
            %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
            exists on the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mrow
                      %mo (
                      %msubsup
                        %mi T
                        %mi inf
                        %mo *
                      %mi 𝔞
                      %mo )
                  %annotation{:encoding => "application/x-tex"} CE\left( T^\ast_{inf} \mathfrak{a}\right)
          #SchoutenBracketAndAntibracket.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
                and
                %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
                for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %mi S
                        %mo ≃
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} (X/\mathfrak{g})_{d S \simeq 0}
              inside an
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
              as in example
              = succeed "." do
                %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
            %p
              Then the graded
              %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              of graded
              %a.existingWikiWord{:href => "/nlab/show/derivations"} derivations
              of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [-,-]
                    \\;\colon\;
                    Der(CE(X/\mathfrak{g}))
                    \\otimes
                    Der(CE(X/\mathfrak{g}))
                    \\longrightarrow
                    Der(CE(X/\mathfrak{g}))
            %p
              uniquely
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/extension"} extends
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi even
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,even)
              on the CE-algebra of the
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %mi S
                        %mo ≃
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} (X/\mathfrak{g})_{d S \simeq 0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi CE
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi d
                          %mi S
                          %mo ≃
                          %mn 0
                      %mo )
                    %mo ⊗
                    %mi C
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi d
                          %mi S
                          %mo ≃
                          %mn 0
                      %mo )
                    %mo ⟶
                    %mi CE
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi d
                          %mi S
                          %mo ≃
                          %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ -,-\right\}
                    \\;\colon\;
                    CE\left( (X/\mathfrak{g})_{d S \simeq 0} \right)
                    \\otimes
                    C\left( (X/\mathfrak{g})_{d S \simeq 0} \right)
                    \\longrightarrow
                    CE\left( (X/\mathfrak{g})_{d S \simeq 0} \right)
            %p
              such that this is a graded
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              in both arguments.
            %p
              This is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
            %p
              There is an elegant way to rewrite this in terms of components: With the notation
              %a.maruku-eqref{:href => "#eq:AntiNotationForDerivations"} (5)
              for the coordinate-derivations the
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
              is equivalently given by
            #eq:Antibracket.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mrow
                              %mo {
                              %mi f
                              %mo ,
                              %mi g
                              %mo }
                          %mtd
                            %mo =
                            %mphantom
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo ←
                                %mi f
                              %mrow
                                %mo ∂
                                %msubsup
                                  %mi ϕ
                                  %mi a
                                  %mo ‡
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo →
                                %mi g
                              %mrow
                                %mo ∂
                                %msup
                                  %mi ϕ
                                  %mi a
                            %mo −
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo ←
                                %mi f
                              %mrow
                                %mo ∂
                                %msup
                                  %mi ϕ
                                  %mi a
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo →
                                %mi g
                              %mrow
                                %mo ∂
                                %msubsup
                                  %mi ϕ
                                  %mi a
                                  %mo ‡
                        %mtr
                          %mtd
                          %mtd
                            %mphantom
                              %mo =
                            %mo +
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo ←
                                %mi f
                              %mrow
                                %mo ∂
                                %msubsup
                                  %mi c
                                  %mi α
                                  %mo ‡
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo →
                                %mi g
                              %mrow
                                %mo ∂
                                %msup
                                  %mi c
                                  %mi α
                            %mo −
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo ←
                                %mi f
                              %mrow
                                %mo ∂
                                %msup
                                  %mi c
                                  %mi α
                            %mfrac
                              %mrow
                                %mover
                                  %mo ∂
                                  %mo →
                                %mi g
                              %mrow
                                %mo ∂
                                %msubsup
                                  %mi c
                                  %mi α
                                  %mo ‡
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left\{ f,g \right\}
                    \&amp; =
                    \\phantom{+}
                    \\frac{\overset{\leftarrow}{\partial} f}{\partial \phi^\ddagger_a}
                    \\frac{\overset{\rightarrow}{\partial} g}{\partial {\phi}^a}
                    \-
                    \\frac{\overset{\leftarrow}{\partial} f}{\partial \phi^a}
                    \\frac{\overset{\rightarrow}{\partial} g}{\partial \phi^\ddagger_a}
                    \\\
                    \&amp;
                    \\phantom{=}
                    +
                    \\frac{\overset{\leftarrow}{\partial} f}{\partial c^\ddagger_\alpha}
                    \\frac{\overset{\rightarrow}{\partial} g}{\partial {c}^{\alpha}}
                    \-
                    \\frac{\overset{\leftarrow}{\partial} f}{\partial c^{\alpha}}
                    \\frac{\overset{\rightarrow}{\partial} g}{\partial c^\ddagger_\alpha}
                    \\end{aligned}
                    \\,,
            %p
              where the arrow over the
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              indicates that we we pick up signs via the
              %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
              either as usual, going through products from left to right (for
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo ∂
                        %mo →
                    %annotation{:encoding => "application/x-tex"} \overset{\rightarrow}{\partial}
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo ∂
                        %mo ←
                    %annotation{:encoding => "application/x-tex"} \overset{\leftarrow}{\partial}
            %p
              In this form the
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
          %p
            (e. g.
            = succeed "," do
              %a{:href => "antibracket#Henneaux90"} Henneaux 90, (53d)
            = succeed ")" do
              %a{:href => "antibracket#HenneauxTeitelboim92"} Henneaux-Teitelboim 92, section 15.5.2
          %p
            The power of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
