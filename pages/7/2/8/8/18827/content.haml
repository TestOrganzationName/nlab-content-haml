                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %msup
                                    %mrow
                                      %mo (
                                      %msub
                                        %mi s
                                        %mi BRST
                                      %mo )
                                    %mn 2
                                %mo ⏟
