                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %msup
                                    %mrow
                                      %mo (
                                      %msub
                                        %mi s
                                        %mi BV
                                      %mo )
                                    %mn 2
                                %mo ⏟
