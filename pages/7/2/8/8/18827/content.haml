                    \\begin{aligned}
                    s_{BV} s_{BV} c^\ddagger_\alpha
                    \&amp; =
                    \-\underset{k \in \mathbb{N}}{\sum}
                    (-1)^k \frac{d^k}{d x^{\mu_1} \cdots d x^{\mu_k}}
                    \\left(
                    R_\alpha^{a \mu_1 \cdots \mu_k} \phi^\ddagger_a
                    \\right)
                    \\\
                    \&amp; =
                    \-\underset{k \in \mathbb{N}}{\sum}
