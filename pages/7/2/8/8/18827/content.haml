                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE^{\bullet, \bullet+1}\left( (X/\mathfrak{g})_{d S \simeq 0} \right)
                    \\\
                    \\uparrow^{\mathrlap{s_{BV}}}
                    \\\
