                              %mi ϕ
                              %mi a
                        %mo =
                        %mn 0
                        %mo )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    H^0
                    \\left(
                    CE\left(
                    (X/\mathfrak{g})_{d S \simeq 0}
                    \\right)
                    \\right)
                    \\;=\;
                    \\left\{
                    X_{d S = 0}
                    \\overset{f}{\to}
                    \\mathbb{R}
                    \\;\vert\;
                    \\left(R_\alpha^a \frac{\partial f}{\partial \phi^a} = 0\right)
                    \\right\}
          .proof
            %h6#proof_4 Proof
            %p
              The first statement follows from the
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+double+complex"} of the double complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi gh
                    %mrow
                      %mo (
                      %msup
                        %mi H
                        %mi af
                      %mrow
                        %mo (
                        %mi CE
                        %mrow
                          %mo (
