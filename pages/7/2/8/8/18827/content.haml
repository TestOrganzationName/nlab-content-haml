                  %annotation{:encoding => "application/x-tex"} \mathbf{d} \colon C^\infty(X) \to \Gamma(T^\ast_{inf} X)
              on functions, and as the degree shift operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝔞
                      %mo •
                    %mo →
                    %mi 𝔞
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathbf{d} \colon \mathfrak{a}_\bullet \to \mathfrak{a}[1]_\bullet
              on the graded elements.
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                %th
                  %a.existingWikiWord{:href => "/nlab/show/derived+Lie+algebroids"} derived Lie algebroids
            %tbody
              %tr
                %td{:style => "text-align: left;"}
