          #BVVariationalBicomplex.num_defn
            %h6#definition_10 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/variational+BV-bicomplex"}> variational BV-bicomplex
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              = succeed ")." do
                %a.maruku-ref{:href => "#GaugeParametersClosed"}
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E/(\mathcal{G} \times_\Sigma T \Sigma)
              from example
              = succeed "," do
                %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
              of the theory.
            %p
              Then its
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(E/(\mathcal{G} \times_\Sigma T \Sigma))
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#WeilAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/BRST+differential"} BRST differential
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi W
                          %mtd
                            %mo =
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo −
                            %msub
                              %mi s
                              %mi BRST
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi δ
                            %mo +
                            %msub
                              %mi s
                              %mi BRST
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_{W}
                    \&amp; = \mathbf{d} - (d - s_{BRST})
                    \\\
                    \&amp; =
                    \\delta + s_{BRST}
                    \\end{aligned}
                    \\,.
            %p
              Therefore we speak of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/variational+BRST-bicomplex"} variational BRST-bicomplex
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet_\Sigma( E/(\mathcal{G} \times_\Sigma T \Sigma) )
                    \\,.
            %p
              Similarly, the Weil algebra of the derived prolonged shell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                        %mo ≃
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} (E/( \mathcal{G} \times_\Sigma T \Sigma ))_{\delta_{EL}L \simeq 0}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DerivedProlongedShell"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mi W
                          %mtd
                            %mo =
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo −
                            %mi s
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi δ
                            %mo +
                            %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_W
                    \&amp; =  \mathbf{d} - (d - s)
                    \\\
                    \&amp; = \delta + s
                    \\end{aligned}
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              is the
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalBVBRSTComplexIsDerivedCriticalLocusOfEulerLagrangeForm"}
              = succeed "\u201D." do
                %a.existingWikiWord{:href => "/nlab/show/variational+bicomplex"} variational bicomplex
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#BVBRSTComplexGlobal
            %strong
              global
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
          %p
            Finally we may apply
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
            to turn the
            %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local BV-BRST complex
            on smooth functions on the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            into a global
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            on graded
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            on the graded
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
          #ComplexBVBRSTGlobal.num_defn
            %h6#definition_11 Definition
            %p
              %strong
                (global
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              = succeed ")." do
                %a.maruku-ref{:href => "#GaugeParametersClosed"}
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo =
                    %msubsup
                      %mi T
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi inf
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi E
                    %msub
                      %mo ×
                      %mi Σ
                    %mi 𝒢
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E_{\text{BV-BRST}}
                    \=
                    T^\ast_{\Sigma,inf}[-1](E \times_\Sigma \mathcal{G}[1])
            %p
              underlying the
              %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local BV-BRST complex
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:BVBRSTGradedFieldBundle"} (15)
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            #eq:LocalAntibracketTransgressed.maruku-equation
              %span.maruku-eq-number (20)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi LocObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi LocObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} {
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} }
                          %mtd
                            %mi LocObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi α
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi τ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi β
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %msub
                              %mi τ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %mi α
                            %mo ,
                            %mi β
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    LocObs(E_{\text{BV-BRST}})
                    \\otimes
                    LocObs(E_{\text{BV-BRST}})
                    \&amp;\overset{\{-,-\}}{\longrightarrow}&amp;
                    LocObs(E_{\text{BV-BRST}})
                    \\\
                    \\tau_\Sigma(\alpha), \tau_\Sigma(\beta)
                    \&amp;\mapsto&amp;
                    \\tau_\Sigma( \{\alpha, \beta\} )
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ,
                    %mi β
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi cp
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha, \beta \in \Omega^{p+1,0}_{\Sigma,cp}(E_{\text{BV-BRST}})
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SpacetimeSupport"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} \tau_\Sigma
              denotes
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression of variational differential forms
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TransgressionOfVariationalDifferentialFormsToConfigrationSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-,-\}
              is the
              %a.existingWikiWord{:href => "/nlab/show/local+antibracket"} local antibracket
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalAntibracket"}
            %p
              This is well-defined, in that this formula indeed depends on the
              %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              only through the
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_\Sigma(\alpha), \tau_\Sigma(\beta)
              which they induce. The resulting bracket is called the (global)
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
            %p
              Indeed the formula makes sense already if at least one of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ,
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \alpha, \beta
              have compact spacetime support (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SpacetimeSupport"}
              %a.existingWikiWord{:href => "/nlab/show/transgression"} transgression
              of the
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+differential"} BV-BRST differential
              %a.maruku-eqref{:href => "#eq:LocalAntibracketVersionOfBVBRSTDifferential"} (19)
              is a well-defined
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              on the graded
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi τ
                        %mi Σ
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo +
                      %msub
                        %mi τ
                        %mi Σ
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mi BRST
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo −
