                                    %mo{:stretchy => "false"} (
                                    %msup
                                      %mi ϕ
                                      %mi A
                                    %mo{:stretchy => "false"} )
                                %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi deg
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ϕ
                                  %mi A
                                %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (-1)^{
                    \\left(
                    n_{(\phi^A)} n_{(\phi^A)}
                    +
                    \\sigma_{(\phi^A)} \sigma_{(\phi^A)}
                    \\right)
                    }
                    \&amp; =
                    (-1)^{
                    \\left(
                    n_{(\phi^A)} + \sigma_{(\phi^A)}
                    \\right)
                    }
                    \\\
                    \&amp; =
                    (-1)^{deg(\phi^A)}
                    \\end{aligned}
                    \\,.
            %p
              From this the identification
              %a.maruku-eqref{:href => "#eq:OnShellPolynomialObservablesAsBVCohomology"} (24)
              follows by
              %a.maruku-eqref{:href => "#eq:PolynomialOnShellObservablesArePolynomialOffShellobservableModuloTheEquationsOfMotion"} (?)
              in theorem
              = succeed "." do
                %a.maruku-ref{:href => "#LinearObservablesForGreeFreeFieldTheoryAreDistributionalSolutionsToTheEquationsOfMotion"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            This concludes our discussion of the
            %a.existingWikiWord{:href => "/nlab/show/reduced+phase+space"} reduced phase space
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            exhibited,
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} dually
            by its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local BV-BRST complex
            %a{:href => "#GaugeFixing"} next chapter
            we finally turn to the key implication of this construction: the
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixing
            of a
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            which makes the collection of
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            and
            %a.existingWikiWord{:href => "/nlab/show/auxiliary+fields"} auxiliary fields
            (
            %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
            and
