                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    0 &amp; =
                    \\left( d_{CE\left( (X/\mathfrak{g})_{d S \simeq 0} \right)} \right)^2
                    \\\
                    \&amp; =
                    \\left( s_{BV} +  s_{BRST}\right)^2
                    \\\
                    \&amp; =
                    \\underset{ = 0 }{
                    \\underbrace{
                    \\left( s_{BV}\right)^2
                    }}
                    +
                    \\underset{ = 0 }{
                    \\underbrace{
                    \\left( s_{BRST} \right)^2
                    }}
                    +
                    \\underset{ = 0 }{
                    \\underbrace{
                    \\left[ s_{BV}, s_{BRST} \right]
