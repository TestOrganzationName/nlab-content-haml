                    \\left( s_{BV} \right)^2 = 0
            %p
              is non-trivial only on the
              %a.existingWikiWord{:href => "/nlab/show/antifields"} antifields
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ghost+fields"} ghost fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi s
                              %mi BV
                            %msub
                              %mi s
                              %mi BV
                            %msubsup
                              %mi c
