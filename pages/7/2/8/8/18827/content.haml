              = succeed "-degree" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi af
                    %annotation{:encoding => "application/x-tex"} af
            #eq:VanishingOfNaiveLieAlgebroidBVCohomlogyInNegativeDegree.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo ≤
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi BV
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
