                    S_{\text{BV-BRST}}
                    \\right\}
                    \\;=\;
                    0
                    \\,.
            %p
              Conversely, given a shifted
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi 𝔤
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T^\ast[-1](X \times \mathfrak{g}[1])
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ShiftedCotangentBundleForCriticalLocusInsideLieAlgebroid"} (8)
              %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} struture
              of a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              of degree +1 on its
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              is equivalent to a degree-0 element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi 𝔤
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \in C^\infty(T^\ast[-1](X \times \mathfrak{g}[1]))
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mi S
