                    \\;=\;
                    \\frac{\overset{\leftarrow}{\delta}_{EL} \mathbf{L}'}{\delta \phi^A}
                    \\frac{\delta}{\delta \phi^{\ddagger}_A}
            %p
              With this the expression for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-S',-\}
              follows directly from the definition of the global antibracket (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ComplexBVBRSTGlobal"}
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange equations
              %a.maruku-eqref{:href => "#eq:DifferentialOperatorEulerLagrangeDerivative"} (?)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi Φ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi A
                    %mo =
                    %msubsup
                      %mi j
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (P \Phi)_A = j^\infty_\Sigma(\Phi)\left( \frac{\delta_{EL} L}{\delta \phi^A} \right)
                    \\,.
            %p
              where the sign
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi deg
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ϕ
                          %mi A
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1)^{deg(\phi^A)}
              is the relative sign between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                      %mrow
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi A
                    %mo =
                    %mfrac
                      %mrow
                        %msub
                          %mover
                            %mi δ
                            %mo →
                          %mi EL
                        %mi L
                        %mo ′
                      %mrow
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi A
                  %annotation{:encoding => "application/x-tex"} \frac{\delta_{EL} L}{\delta \phi^A} = \frac{\overset{\rightarrow}{\delta}_{EL} L'}{\delta \phi^A}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msub
                          %mover
                            %mi δ
                            %mo ←
                          %mi EL
                        %mi L
                        %mo ′
                      %mrow
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi A
                  %annotation{:encoding => "application/x-tex"} \frac{\overset{\leftarrow}{\delta}_{EL} L'}{\delta \phi^A}
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#SchoutenBracketAndAntibracket"}
            %p
              By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} L'
              defines a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}'
              is quadratic in the fields, so that from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} deg(\mathbf{L}) = 0
              it follows that the derivations from the left and from the right differ by the relative sign
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo (
                                %msub
                                  %mi n
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msup
                                      %mi ϕ
                                      %mi A
                                    %mo{:stretchy => "false"} )
                                %msub
                                  %mi n
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msup
                                      %mi ϕ
                                      %mi A
                                    %mo{:stretchy => "false"} )
                                %mo +
                                %msub
                                  %mi σ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msup
                                      %mi ϕ
                                      %mi A
                                    %mo{:stretchy => "false"} )
                                %msub
                                  %mi σ
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msup
                                      %mi ϕ
