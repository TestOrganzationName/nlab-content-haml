          #ClassicalWeilAlgebra.num_example
            %h6#example_10 Example
            %p
              %strong
                (classical
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              with corresponding
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
