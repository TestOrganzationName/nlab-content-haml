                    %mi 𝒢
                    %msub
                      %mo ×
                      %mi Σ
                    %mi T
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
