                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %msub
                                  %mi s
                                  %mi BV
                                %mo +
                                %msub
                                  %mi s
                                  %mi BRST
                                %mo )
                              %mn 2
                        %mtr
