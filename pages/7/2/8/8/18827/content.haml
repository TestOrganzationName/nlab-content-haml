              and the
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
