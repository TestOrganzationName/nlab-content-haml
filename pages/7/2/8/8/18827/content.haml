                    %annotation{:encoding => "application/x-tex"} s_{BRST}
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %msub
                        %mo ×
                        %mi Σ
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} E \times_\Sigma \mathcal{G}
            #eq:BRSTFunctionForClosed.maruku-equation
              %span.maruku-eq-number (18)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi BRST
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
