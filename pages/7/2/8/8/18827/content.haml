          %p
            The following example illustrates how the concept of
            %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi d
                      %mi S
                      %mo ≃
                      %mn 0
                %annotation{:encoding => "application/x-tex"} X_{d S \simeq 0}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theoretic
            version of the ordinary concept of
            %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi d
                        %mi S
                        %mo =
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} X_{d S = 0}
          #OrdinaryCriticalLocusAsCohomologyOfDerivedCriticalLocus.num_example
            %h6#example_4 Example
            %p
              %strong
                (ordinary
                %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
                is
                %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                of
                %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
                in degree 0)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be an
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinitesimalNeighbourhood"}
              %a.existingWikiWord{:href => "/nlab/show/super+Cartesian+space"} super Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperCartesianSpace"}
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ϕ
                        %mi a
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\phi^a)
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              is a truncated
              %a.existingWikiWord{:href => "/nlab/show/polynomial+algebra"} polynomial algebra
              or
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+algebra"} formal power series algebra
              in the
              %a.existingWikiWord{:href => "/nlab/show/variables"} variables
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mi a
                    %annotation{:encoding => "application/x-tex"} \phi^a
            %p
              Consider for simplicity the special case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} = 0
              so that there is no
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of the
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi d
                        %mi S
                        %mo ≃
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} X_{d S \simeq 0}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mrow
                              %mo (
                              %msubsup
                                %mi ϕ
                                %mi a
                                %mo ‡
                              %mo )
                          %mtd
                            %mrow
                              %mo (
                              %msup
                                %mi ϕ
                                %mi a
                              %mo )
                          %mtd
                        %mtr
                          %mtd
                            %mi deg
                            %mo =
                          %mtd
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                          %mtd
                            %mn 0
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp;
                    \&amp;
                    \\left(
                    \\phi^\ddagger_a
                    \\right)
                    \&amp;
                    \\left(
                    \\phi^a
                    \\right)
                    \&amp;
                    \\\
                    deg = &amp;
                    \&amp;
                    \-1
                    \&amp;
                    0
                    \&amp;
                    \\end{aligned}
            %p
              and
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %mi CE
                                %mrow
                                  %mo (
                                  %msub
                                    %mi X
                                    %mrow
                                      %mi d
                                      %mi S
                                      %mo ≃
                                      %mn 0
                                  %mo )
                        %mtr
