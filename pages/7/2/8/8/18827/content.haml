              introduced. Then the local
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              of its
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DerivedProlongedShell"}
              %a.existingWikiWord{:href => "/nlab/show/local+BV-complex"} local BV-complex
              of def.
              = succeed "." do
                %a.maruku-ref{:href => "#BVComplexOfOrdinaryLagrangianDensity"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
