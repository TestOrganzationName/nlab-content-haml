                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; s_{BRST} &amp; s_{BV}
                    \\\
                    deg_{gh} = &amp; +1 &amp; 0
                    \\\
                    deg_{af} = &amp; 0 &amp; +1
                    }
                    \\,.
            %p This implies that in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %msub
                                  %mi d
                                  %mrow
                                    %mi CE
                                    %mrow
                                      %mo (
                                      %mo{:stretchy => "false"} (
                                      %mi X
                                      %mo{:stretchy => "false"} /
                                      %mi 𝔤
                                      %msub
                                        %mo{:stretchy => "false"} )
                                        %mrow
                                          %mi d
                                          %mi S
                                          %mo ≃
