                                    %mo{:stretchy => "false"} )
                                %mo )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo (
                                %msub
                                  %mi n
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msup
                                      %mi ϕ
                                      %mi A
                                    %mo{:stretchy => "false"} )
                                %mo +
                                %msub
                                  %mi σ
