                              %mo ⟵
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔞
                            %mo ′
                            %mo{:stretchy => "false"} )
