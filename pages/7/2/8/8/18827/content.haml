                    H^{\bullet \leq 1}(s_{BV}) = 0
            %p
              then the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the full
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+dg-algebra"} Chevalley-Eilenberg dg-algebra
              is given by the cochain cohomology of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi BRST
                  %annotation{:encoding => "application/x-tex"} s_{BRST}
              on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mn 0
