                    \\\
                    \\left[ s_{BV}, s_{BRST} \right] = 0 &amp;&amp;
                    \\left\{
                    \\array{
                    \\text{ gauge symmetry preserves the shell },
                    \\\
                    \\text{ gauge symmetry acts on Noether identities }
