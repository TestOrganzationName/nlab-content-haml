                            %mo +
                            %msub
                              %mi s
                              %mi BRST
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    CE\left(
                    (X/\mathfrak{g})_{d S \simeq 0}
