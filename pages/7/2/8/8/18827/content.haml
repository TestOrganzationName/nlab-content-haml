                        %mo )
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\left(s_{BRST}\right)^2 = 0
            %p The remaining conditions we may check on 0-jet generators.
            %p The condition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mrow
