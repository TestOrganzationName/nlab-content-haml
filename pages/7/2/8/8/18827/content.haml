                            %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;
                    \\left(
                    c^\ddagger_{\alpha,\mu_1 \cdots \mu_k}
                    \\right)
                    \&amp;
                    \\left(
                    \\phi^a_{,\mu_1 \cdots \mu_k}
                    \\right)
                    ,
                    \\left(
                    \\phi^\ddagger_{a,\mu_1 \cdots \mu_k}
                    \\right)
                    \&amp;
                    \\left(
