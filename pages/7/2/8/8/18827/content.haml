            %p
              whose
              %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
              is the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+dg-algebra"} Chevalley-Eilenberg dg-algebra
              of the derived critical locus
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi CE
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} /
