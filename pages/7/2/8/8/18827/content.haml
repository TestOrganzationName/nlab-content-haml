              be a bundle of
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              = succeed ")," do
                %a.maruku-ref{:href => "#GaugeParametersClosed"}
              %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
              the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
