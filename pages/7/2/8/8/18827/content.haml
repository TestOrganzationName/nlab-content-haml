              which are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mrow
                      %mo (
                      %mi CE
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi 𝔤
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi d
                            %mi S
                            %mo ≃
                            %mn 0
                        %mo )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %msub
                        %mi X
                        %mrow
                          %mi d
                          %mi S
                          %mo =
                          %mn 0
                      %mover
                        %mo →
                        %mi f
                      %mi ℝ
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %msubsup
                          %mi R
                          %mi α
                          %mi a
                        %mfrac
                          %mrow
                            %mo ∂
                            %mi f
