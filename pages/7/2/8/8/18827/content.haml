                              %mi ϕ
                              %mi a
                          %mtd
                            %mo ↦
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %msubsup
                              %mi ϕ
                              %mi a
                              %mo ‡
                          %mtd
                            %mo ↦
                          %mtd
                            %mfrac
                              %mrow
                                %mo ∂
                                %mi S
                              %mrow
                                %mo ∂
                                %msup
                                  %mi ϕ
                                  %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; d_{CE\left( X_{d S \simeq 0} \right)}
                    \\\
                    \\phi^a &amp;\mapsto&amp; 0
                    \\\
                    \\phi^\ddagger_a &amp;\mapsto&amp; \frac{\partial S}{\partial \phi^a}
                    }
                    \\,.
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of the derived critical locus indegree 0 is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              by the ideal which is generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi S
                        %mrow
                          %mo ∂
                          %msup
                            %mi ϕ
                            %mi a
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \left( \frac{\partial S}{\partial \phi^a} \right)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mrow
                      %mo (
                      %mi CE
                      %mrow
                        %mo (
                        %msub
                          %mi X
                          %mrow
                            %mi d
                            %mi S
                            %mo ≃
                            %mn 0
                        %mo )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo (
                      %mfrac
                        %mrow
                          %mo ∂
                          %mi S
                        %mrow
                          %mo ∂
                          %msup
                            %mi ϕ
                            %mi a
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^0\left(
                    CE\left( X_{d S \simeq 0}  \right)
                    \\right)
                    \\;=\;
                    C^\infty(X)/\left( \frac{\partial S}{\partial \phi^a} \right)
                    \\,.
            %p
              But under the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/superpoint"} superpoint
              or
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              of a point, this quotient algebra is just the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              on the ordinary
              %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi d
                          %mi S
                          %mo =
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} X_{d S = 0}
            %p
              (The quotient says that every function on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which vanishes where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi S
                      %mrow
                        %mo ∂
                        %msup
                          %mi ϕ
                          %mi a
                  %annotation{:encoding => "application/x-tex"} \frac{\partial S}{\partial \phi^a}
              vanishes is
              %a.existingWikiWord{:href => "/nlab/show/zero"} zero
              in the quotient. This means that the quotient algebra consists of the functions on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              modulo the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              that identifies two if they agree on the critical locus
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi d
                          %mi S
                          %mo =
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} X_{d S = 0}
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi d
                          %mi S
                          %mo =
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} X_{d S = 0}
            %p
              Hence the
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              yields the ordinary
              %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 0
                    %mrow
                      %mo (
                      %mi CE
                      %mrow
                        %mo (
                        %msub
                          %mi X
                          %mrow
                            %mi d
                            %mi S
                            %mo ≃
                            %mn 0
                        %mo )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mrow
                      %mo (
                      %msub
                        %mi X
                        %mrow
                          %mi d
                          %mi S
                          %mo =
                          %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^0\left(
                    CE\left( X_{d S \simeq 0} \right)
                    \\right)
                    \\;\simeq\;
                    C^\infty\left( X_{d S = 0} \right)
                    \\,.
            %p
              However, it is not in general the case that the
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              is a
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of the ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/critical+locus"} critical locus
              %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
              degree vanishes. Instead, the cohomology of the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              of a
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              in
              %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
              degree detects
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              and more generally
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+action"} L-∞ algebra action
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              under which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is invariant. If this action is incorporated into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by passing to the
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
              and then forming the
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
