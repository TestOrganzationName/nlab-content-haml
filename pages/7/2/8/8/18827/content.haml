            = succeed ":" do
              %a.maruku-ref{:href => "#LieAlgebroidInfinitesimalCotangentBundle"}
          #LocalInfinitesimalCotangentLieAlgebroid.num_defn
            %h6#definition_7 Definition
            %p
              %strong (local infinitesimal cotangent Lie algebroid)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
