                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %mi S
                        %mo ≃
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} (X/\mathfrak{g})_{d S \simeq 0}
              be a
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
              inside an
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              as in example
              = succeed "." do
                %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
            %p
              Then the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
              %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SchoutenBracketAndAntibracket"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mtext BV-BRST
                  %annotation{:encoding => "application/x-tex"} S_{\text{BV-BRST}}
              S_{\text{BV-BRST}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mtext BV-BRST
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi S
                    %mo −
                    %msub
                      %mi d
                      %mrow
                        %mi CE
                        %mrow
                          %mo (
                          %mi X
                          %mo{:stretchy => "false"} /
                          %mi 𝔤
                          %mo )
                  %annotation{:encoding => "application/x-tex"}
                    S_{\text{BV-BRST}}
                    \\;\coloneqq\;
                    S - d_{CE\left( X/\mathfrak{g}\right)}
            %p with itself vanishes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
