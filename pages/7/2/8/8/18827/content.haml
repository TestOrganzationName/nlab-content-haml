                    \\,.
            %p
              Since therefore this equation controls the structure of
              %a.existingWikiWord{:href => "/nlab/show/derived+critical+loci"} derived critical loci
              once the underlying manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is specified, it is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/master+equation"} master equation
              and here specifically the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/classical+master+equation"} classical master equation
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            This concludes our discussion of plain
            %a.existingWikiWord{:href => "/nlab/show/derived+critical+loci"} derived critical loci
            inside
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
            on a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            under
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetries"} infinitesimal gauge symmetries
            generally only up to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
            %a.maruku-ref{:href => "#ChevalleyEilenbergDifferentialOnDerivedCriticalLocusIsHamiltonianViaAntibracket"}
            it is clear that this is best understood by first considering the refinement of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
            %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
            to this situation.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#LocalJetBundleAntibracket
            %strong
              %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local
              %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
          %p
            If we think of the invariant function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            in def.
            %a.maruku-ref{:href => "#DerivedCriticalLocusOfGaugeInvariantFunctionOnLieAlgebroid"}
            as being the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            (example
            = succeed ")" do
              %a.maruku-ref{:href => "#ActionFunctional"}
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            (or rather an
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
            therein), hence with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a Lie algebra of
            %a.existingWikiWord{:href => "/nlab/show/gauge+symmetries"} gauge symmetries
            acting on the field histories, then the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mrow
                    %mo (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi d
                        %mi S
                        %mo ≃
                        %mn 0
                    %mo )
                %annotation{:encoding => "application/x-tex"} CE\left((X/\mathfrak{g})_{d S \simeq 0}\right)
            of the
            %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            of the theory.
          %p
            In applications of interest, the spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is
            %em not
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/compact+space"} compact
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            as in example
            %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
            by considering the action functional for all
            %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} b \mathbf{L}
            Lagrangians, with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in C_{cp}^\infty(\Sigma)
            = succeed ")." do
              %a{:href => "BV-BRST+formalism#FredenhagenRejzner11a"} Fredenhagen-Rejzner 11a
          %p
            Here we instead consider now the “local lift” or “de-transgression” of the above construction from the
            %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
            to the
            %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
            of the field bundle of the theory, refining the
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+complex"} BV-BRST complex
            (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#DerivedCriticalLocusOfActionLiAlgebroidBicomplexStructure"}
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local BV-BRST complex
            (prop.
            %a.maruku-ref{:href => "#LocalBVBRSTComplexIsDerivedCriticalLocusOfEulerLagrangeForm"}
            below), corresponding to the
            %a.existingWikiWord{:href => "/nlab/show/local+BRST+complex"} local BRST complex
            from example
            %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
            (
            %a{:href => "local+BRST+cohomology#BarnichBrandtHenneaux00"}> Barnich-Brandt-Henneaux 00
            ).
          %p
            This requires a slight refinement of the construction that leads to example
            = succeed ":" do
              %a.maruku-ref{:href => "#ArchetypeOfBVBRSTComplex"}
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %msub
                    %mi τ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S = \tau_\Sigma(g\mathbf{L})
            (example
            = succeed ")," do
              %a.maruku-ref{:href => "#ActionFunctional"}
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \mathbf{L}
            is not strictly
            %em invariant
            under
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+transformations"} infinitesimal gauge transformations
            = succeed ")." do
              %a.maruku-ref{:href => "#GaugeParameters"}
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+variational+derivative"} Euler-Lagrange variational derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi EL
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \delta_{EL} \mathbf{L}
            (unless we have already restricted to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
            = succeed "," do
              %a.maruku-ref{:href => "#InfinitesimalSymmetriesOfLagrangianAreAlsoSymmetriesOfTheEquationsOfMotion"}
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            as in example
            = succeed ")." do
              %a.maruku-ref{:href => "#OrdinaryCriticalLocusAsCohomologyOfDerivedCriticalLocus"}
          %p
            This means that the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi EL
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                %annotation{:encoding => "application/x-tex"} \delta_{EL} \mathbf{L}
            is,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
            = succeed ")" do
              %a.maruku-ref{:href => "#LieAlgebroidInfinitesimalCotangentBundle"}
          %p
            But it turns out that it still is a section of local refinement of the cotangent bundle, which is twisted by horizontally exact terms (prop.
            %a.maruku-ref{:href => "#EulerLagrangeFormIsSectionOfLocalCotangentBundleOfJetBundleGaugeActionLieAlgebroid"}
            below). To see the required twist, it is most convenient to make use of a local version of the
            %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
            (def.
            %a.maruku-ref{:href => "#LocalAntibracket"}
            below), via local refinement of example
            = succeed "." do
              %a.maruku-ref{:href => "#ChevalleyEilenbergDifferentialOnDerivedCriticalLocusIsHamiltonianViaAntibracket"}
            %em local
            %a.existingWikiWord{:href => "/nlab/show/derived+critical+locus"} derived critical locus
            as in def.
            %a.maruku-ref{:href => "#DerivedCriticalLocusOfGaugeInvariantFunctionOnLieAlgebroid"}
            but now with the invariance of the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            only up to
            %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivatives"} total spacetime derivatives
            taken into account. Its
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            is called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+BV-BRST+complex"} local BV-BRST complex
            (prop.
            %a.maruku-ref{:href => "#LocalBVBRSTComplexIsDerivedCriticalLocusOfEulerLagrangeForm"}
            below).
          %p
            The following is the direct refinement of the concept of the underlying
            %a.existingWikiWord{:href => "/nlab/show/graded+manifold"} graded manifold
            of the infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
            of an
            %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
            in example
            %a.maruku-ref{:href => "#CotangentBundleOfActionLieAlgebroid"}
            to the case where the base manifold is generalized to a
            %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            to a
            %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
            (def.
            = succeed "):" do
              %a.maruku-ref{:href => "#GaugeParameters"}
          #InfinitesimalCotangentBundleOfFieldAndGaugeParameterBundle.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
                of
                %a.existingWikiWord{:href => "/nlab/show/zero+section"} zero section
                in
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
                of
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                of
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
                with shifted
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/gauge+parameter+bundle"} gauge parameter bundle
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mover
                      %mo →
                      %mi gb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \overset{gb}{\to} \Sigma
              be a bundle of
              %a.existingWikiWord{:href => "/nlab/show/gauge+parameters"} gauge parameters
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GaugeParametrizedInfinitesimalGaugeTransformation"}
              = succeed ")," do
                %a.maruku-ref{:href => "#GaugeParametersClosed"}
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} /
