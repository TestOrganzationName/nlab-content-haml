                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{a}) &amp;\overset{f^\ast}{\longleftarrow}&amp; CE(\mathfrak{a}')
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    C^\infty(X) &amp;\underset{(f\vert_X)^\ast}{\longleftarrow}&amp; C^\infty(Y)
                    }
                    \\,.
            %p
              (This is also called a “
              %a.existingWikiWord{:href => "/nlab/show/curved+sh-map"}> non-curved sh-map
              ”.)
          #GaugeInvariantFunctionsIntermsOfLieAlgebroids.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                in terms of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              be a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinitesimalActionByLieAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝔤
                            %mo ×
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi R
                          %mtd
                          %mtd
                            %mi T
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi pr
                                    %mn 2
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi rb
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathfrak{g} \times X &amp;&amp; \overset{R}{\longrightarrow} &amp;&amp; T X
                    \\\
                    \&amp; {}_{\mathllap{pr_2}}\searrow &amp;&amp; \swarrow_{\mathrlap{rb}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              on a
              %a.existingWikiWord{:href => "/nlab/show/supermanifold"} supermanifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebroids"} Lie algebroids
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomomorphismBetweenLieAlgebroids"}
            #eq:ProjectionMapForActionLieAlgebroid.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⊕
                          %mtd
                            %mn 0
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                          %mtd
                            %mphantom
                              %mi AAA
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msup
                                    %mi p
                                    %mo *
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mn 0
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi 𝔤
                          %mtd
                          %mtd
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⊕
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msup
                              %mo ∧
                              %mo •
                            %msup
                              %mi 𝔤
                              %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;&amp; CE(X) &amp;=&amp; C^\infty(X) &amp;\oplus&amp; 0
                    \\\
                    \\downarrow^{\mathrlap{p}}
                    \&amp;\phantom{AAA}&amp;&amp;
                    \\uparrow^{\mathrlap{p^\ast}}
                    \&amp;&amp;
                    \\uparrow^{\mathrlap{id}} &amp;&amp; \uparrow^{\mathrlap{0}}
                    \\\
                    X/\mathfrak{g}
                    \&amp;&amp;&amp;
                    CE(X/\mathfrak{g})
                    \&amp;=&amp;
                    C^\infty(X)
                    \&amp;\oplus&amp;
                    C^\infty(X) \otimes \wedge^\bullet \mathfrak{g}^\ast
                    }
            %p
              from the manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              regarded as a Lie algebroid by example
              %a.maruku-ref{:href => "#BasicExamplesOfLieAlgebroids"}
              to the
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} X/\mathfrak{g}
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#ActionLieAlgebroid"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
                  %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
                  map
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebras"} differential graded-commutative superalgebras
              is given simply by the identity on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              and the
              %a.existingWikiWord{:href => "/nlab/show/zero+map"} zero map
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}^\ast
            %p
              Next regard the
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              as a Lie algebroid by example
              = succeed "." do
                %a.maruku-ref{:href => "#BasicExamplesOfLieAlgebroids"}
              = succeed ")" do
                %a.maruku-ref{:href => "#HomomorphismBetweenLieAlgebroids"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    S \;\colon\; X/\mathfrak{g} \longrightarrow \mathbb{R}^1
                    \\,,
            %p
              hence
              = succeed "," do
                %em smooth functions on the Lie algebroid
            %ul
              %li
                %p
                  ordinary
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ⟶
                        %msup
                          %mi ℝ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S \;\colon\; X \longrightarrow \mathbb{R}^1
                  on the underlying
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %li
                %p
                  which are
                  %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
                  under the Lie algebra action in that
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} R(-)(S) = 0
            %p
              In terms of the canonical
              %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              %a.maruku-eqref{:href => "#eq:ProjectionMapForActionLieAlgebroid"} (1)
              this says that a smooth function on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              extends to the
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              precisely if it is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi S
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %mtext exists precisely if
                                  %mspace{:width => "thickmathspace"}
                                  %mi S
                                  %mspace{:width => "thickmathspace"}
                                  %mtext is invariant
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi 𝔤
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\overset{S}{\longrightarrow}&amp; \mathbb{R}^1
                    \\\
                    {}^{\mathllap{p}}\downarrow
                    \&amp;
                    \\nearrow_{
                    \\mathrlap{
                    \\text{exists precisely if} \; S \; \text{is invariant}
                    }
                    }
                    \\\
                    X/\mathfrak{g}
                    }
          .proof
            %h6#proof Proof
            %p
              An
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟵
                      %mrow
                        %msup
                          %mi S
                          %mo *
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE( X/\mathfrak{g} )
                    \\overset{S^\ast}{\longleftarrow}
                    C^\infty(\mathbb{R}^1)
            %p
              is fixed by what it does to the canonical
              %a.existingWikiWord{:href => "/nlab/show/coordinate+function"} coordinate function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S^\ast
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S \in C^\infty(X) \hookrightarrow CE(X/\mathfrak{g})
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo =
                      %msub
                        %mi d
                        %mi CE
                      %mi S
                      %mo =
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 = d_{CE} S = R(-)(f)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo {
                              %mi S
                              %mo }
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %msup
                                  %mi S
                                  %mo *
                          %mtd
                            %mrow
                              %mo {
                              %mi x
                              %mo }
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mrow
                                      %mi CE
                                      %mo{:stretchy => "false"} (
                                      %mi X
                                      %mo{:stretchy => "false"} /
                                      %mi 𝔤
                                      %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mrow
                                      %mi CE
                                      %mo{:stretchy => "false"} (
                                      %msup
                                        %mi ℝ
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                  %mo =
                                  %mn 0
                        %mtr
                          %mtd
                            %mrow
                              %mo {
                              %mi R
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mn 0
                              %mo }
                          %mtd
                            %munder
                              %mo ⟵
                              %mrow
                                %msup
                                  %mi S
                                  %mo *
                          %mtd
                            %mrow
                              %mo {
                              %mn 0
                              %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\left\{ S \right\}
                    \&amp;\overset{S^\ast}{\longleftarrow}&amp;
                    \\left\{ x \right\}
                    \\\
                    {}^{\mathllap{d_{CE(X/\mathfrak{g})}}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{d_{CE(\mathbb{R}^1)} = 0 } }
                    \\\
                    \\left\{
                    R(-)(S)
                    \=
                    0
                    \\right\}
                    \&amp;\underset{S^\ast}{\longleftarrow}&amp;
                    \\left\{ 0 \right\}
                    }
          %p
            Given a gauge invariant function, hence a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mi 𝔤
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} S \colon X/\mathfrak{g} \to \mathbb{R}
            on a Lie algebroid (example
            = succeed ")," do
              %a.maruku-ref{:href => "#GaugeInvariantFunctionsIntermsOfLieAlgebroids"}
            %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
