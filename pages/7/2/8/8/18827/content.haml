              is an
              %a.existingWikiWord{:href => "/nlab/show/action+Lie+algebroid"} action Lie algebroid
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ActionLieAlgebroid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi T
                      %mi inf
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi T
                      %mi inf
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T^\ast_{inf}(\mathfrak{a}) = T^\ast_{inf}(X/\mathfrak{g})
              is as in example
              = succeed "." do
                %a.maruku-ref{:href => "#CotangentBundleOfActionLieAlgebroid"}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (d S)^\ast
              has been defined on generators, it is uniquely a homomorphism of graded algebras. It is clear that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mi S
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (d S)^\ast
              is indeed a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebras"} differential graded-commutative superalgebras
              in that it also respects the CE-differentials, then it yields a section as claimed, because by definition it is the identity on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
