                  %a{:href => "#from_mod_to_monoidal_categories"} From Mod to monoidal categories
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#definitions Definitions
          %p
            A
            %strong bilinear form
            is simply a
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo ⊗
                  %mi V
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} \langle -,-\rangle\colon V \otimes V \to k
            out of a
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/module"} modules
            into the
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (typically taken to be a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
          %p
            It is called
            %strong symmetric
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle x,y\rangle = \langle y,x\rangle
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x,y \in V
            = succeed "," do
              %em conjugate-symmetric
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
          %p
            It is called
            %strong antisymmetric
            or
            %strong skew-symmetric
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟨
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle x,y\rangle = -\langle y,x\rangle
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x,y \in V
          %p
            It is called
            %strong alternating
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \langle x,x\rangle = 0
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x \in V
          %p
            It is called
            %strong nondegenerate
            if the
            %a.existingWikiWord{:href => "/nlab/show/mate"} mate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %msup
                    %mi V
                    %mo *
                  %mo =
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V \to V^\ast = \hom(V, k)
            is injective (a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} k = \mathbb{R}
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/positive+definite"} positive definite
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} ⟩
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle x,x\rangle \gt 0
                if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} x \neq 0
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/negative+definite"} negative definite
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} ⟩
                      %mo &lt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \langle x,x\rangle \lt 0
                if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ≠
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} x \neq 0
          %h2#examples Examples
          %p
          #InnerProductOnRealVectorSpace.num_remark
            %h6 Example
            %p
              An
              %em
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              on a
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              (not though generally on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
              = succeed ")" do
                %a.maruku-ref{:href => "#BewareInnerProductsOnComplexVectorSpaces"}
          #BewareInnerProductsOnComplexVectorSpaces.num_remark
            %h6 Remark
            %p
              In contrast to Exp.
              = succeed "," do
                %a.maruku-ref{:href => "#InnerProductOnRealVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              on a
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              is typically
              %em not
              taken to be a bilinear form, but a
              %em
                %a.existingWikiWord{:href => "/nlab/show/sesquilinear+form"} sesquilinear form
              (called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian form
              if positive definite).
          %p
          .num_remark
            %h6 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^n \to \mathbb{R}
              is a
              %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              of class
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} C^2
              %a.existingWikiWord{:href => "/nlab/show/Hessian"} Hessian
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              at a point defines a symmetric bilinear form. It may be degenerate, but in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Morse+theory"} Morse theory
              %a.existingWikiWord{:href => "/nlab/show/Morse+function"} Morse function
              is a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} C^2
              function such that the Hessian at each critical point is nondegenerate.
          %h2#CategorificationsAndnPOV
            Categorification and
            = succeed "POV" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Concepts which relate to (non-degenerate) bilinear forms from the
            %a.existingWikiWord{:href => "/nlab/show/nPOV"} nPOV
            and/or
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorifications
            of the concept of bilinear forms include
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-Hilbert+space"} 2-Hilbert space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+object"}> Calabi-Yau object
                ,
                %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+A-infinity+category"} Calabi-Yau A-infinity category
          %h2#generalizations Generalizations
          %h3#from_ab_to_monoidal_categories From Ab to monoidal categories
          %p
            This concept could be generalized from the
            %a.existingWikiWord{:href => "/nlab/show/category+of+abelian+groups"} category of abelian groups
            to any
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi I
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C, I, \otimes)
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mn 1
                  %mo ,
                  %mi π
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (k, 1, \pi)
            be a
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, \rho)
            be a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/module+object"} module object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            itself is a
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            being represented by the
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/binary+operation"} binary operation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
            = succeed "-preserving" do
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi V
                  %mo ⊗
                  %mi V
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} f:V \otimes V \to k
            from the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊗
                  %mi V
                %annotation{:encoding => "application/x-tex"} V \otimes V
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi I
                    %mo →
                    %mi k
                  %annotation{:encoding => "application/x-tex"} a:I \to k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo :
                    %mi I
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v:I \to V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo :
                    %mi I
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} w:I \to V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi ρ
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi π
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ⊗
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \circ ((\rho \circ (a \otimes v)) \otimes w) = \pi \circ (a \otimes (f \circ (v \otimes w))
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi ρ
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi π
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ⊗
                  %mi w
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \circ (v \otimes (\rho \circ (a \otimes w))) = \pi \circ (a \otimes (f \circ (v \otimes w))
          %p
            However, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is not a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
            %em binary forms
            or something similar.
          %p
            Symmetric bilinear forms can similarly be generalized from the
            %a.existingWikiWord{:href => "/nlab/show/category+of+abelian+groups"} category of abelian groups
            to any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo :
                  %mi I
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} v:I \to V
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo :
                    %mi I
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} w:I \to V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ⊗
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ⊗
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ (v \otimes w) = f \circ (w \otimes v)
          %h3#from_mod_to_monoidal_categories From Mod to monoidal categories
          %p
            This concept could be generalized from the
            %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
            to any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is the
            %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
            of the category of
            = succeed "-modules:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi I
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C, I, \otimes)
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊗
                  %mi V
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} I \otimes V \to V
            is given by the composition of an
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} V \to V
            with the
            %a.existingWikiWord{:href => "/nlab/show/left+unitor"} left unitor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mi V
                    %mo :
                    %mi I
                    %mo ⊗
                    %mi V
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \lambda_V:I \otimes V \to V
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} V \in C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi V
                    %mo ⊗
                    %mi V
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} f:V \otimes V \to I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is not a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
            %em binary forms
            or something similar. In
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+categories"} cartesian monoidal categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mn 1
                    %mo ,
                    %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C, 1, \times)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ×
                  %mi V
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} V \times V \to 1
            always exist and is unique, by the universal property of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            Symmetric bilinear forms can similarly be generalized from the
            %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
            to any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo :
                  %mi I
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} v:I \to V
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo :
                    %mi I
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} w:I \to V
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ⊗
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo ⊗
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \circ (v \otimes w) = f \circ (w \otimes v)
