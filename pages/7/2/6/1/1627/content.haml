            and
            %math#mathml_3d720ed6ed4c6f582f4d5f0a2f0840a264d2fa6a_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the Levi-Civita connection
          %p such that
          %ul
            %li
              %p
