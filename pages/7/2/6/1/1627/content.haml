          %p
            %strong definition
          %ul
            %li
              %p
                %math#mathml_3d720ed6ed4c6f582f4d5f0a2f0840a264d2fa6a_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
