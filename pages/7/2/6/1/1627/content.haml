                      %mi n
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ,
                      %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B String(n) \to B Spin(n) \stackrel{p_1/2}{\to} K(\mathbb{Z},4)
            %li
