                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} Witten(M) = 0
          %p
            question: also
            = succeed "?" do
              %math#mathml_3d720ed6ed4c6f582f4d5f0a2f0840a264d2fa6a_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
