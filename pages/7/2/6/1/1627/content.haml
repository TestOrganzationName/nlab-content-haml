                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \sigma(M,\rho) = 0
          %p
            %strong hypothesis
          %p
            If
            %math#mathml_3d720ed6ed4c6f582f4d5f0a2f0840a264d2fa6a_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a Spin manifold that admits a metric and String structure
            %math#mathml_3d720ed6ed4c6f582f4d5f0a2f0840a264d2fa6a_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
