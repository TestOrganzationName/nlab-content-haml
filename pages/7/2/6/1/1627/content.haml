          %p
            %strong conjecture
            (S. Stolz) if
            %math#mathml_3d720ed6ed4c6f582f4d5f0a2f0840a264d2fa6a_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is String and admits a positive Ricci curvature metric, then
            %math#mathml_3d720ed6ed4c6f582f4d5f0a2f0840a264d2fa6a_82.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
