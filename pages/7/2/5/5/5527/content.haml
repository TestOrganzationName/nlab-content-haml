                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mo =
                    %mfrac
                      %mrow
                        %msub
                          %mi F
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                      %mrow
                        %msub
                          %mi F
                          %mrow
                            %mi p
                            %mo −
                            %mn 1
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                    %mo =
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    E^0_{p,q} = \frac{ F_p C_{p+q}}{F_{p-1} C_{p+q}} = G_p C_{p+q}
            %p
              because for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} c \in F_p C_{p+q}
              we automatically also have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi c
                    %mo ∈
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \partial c \in F_p C_{p+q}
              since the differential respects the filtering degree by assumption.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} r = 1
              def.
              %a.maruku-ref{:href => "#ExplicitForm"}
              gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 1
                    %mo =
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi c
                        %mo ∈
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} |
                        %mo ∂
                        %mi c
                        %mo =
                        %mn 0
                        %mo ∈
                        %msub
                          %mi G
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} }
                      %mrow
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi p
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^1_{p,q} = \frac{\{c \in G_p C_{p+q} | \partial c = 0 \in G_p C_{p+q}\} }{\partial(F_p C_{p+q})} = H_{p+q} (G_p C_\bullet)
                    \\,.
          .num_remark
            %h6#remark_2 Remark
            %p
              There is, in general, a decisive difference between the homology of the associated graded complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_{p+q}(G_p C_\bullet)
              and the associated graded piece of the genuine homology
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi p
                      %msub
                        %mi H
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G_p H_{p+q}(C_\bullet)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo →
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} r \to \infty
          %h3#Convergence Convergence
          %h4#general_definitions General definitions
          #LimitTerm.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}_{r,p,q}
              be a
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              such that for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p,q
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r(p,q)
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r \geq r(p,q)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mrow
                        %mi r
                        %mo ≥
                        %mi r
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mrow
                        %mi r
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^{r \geq r(p,q)}_{p,q} \simeq E^{r(p,q)}_{p,q}
                    \\,.
            %p Then one says that
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/bigraded+object"} bigraded object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mn ∞
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mn ∞
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mrow
                            %mi r
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo ,
                            %mi q
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                      %annotation{:encoding => "application/x-tex"}
                        E^\infty
                        \\coloneqq
                        \\{E^\infty_{p,q}\}_{p,q} \coloneqq \{ E^{r(p,q)}_{p,q} \}_{p,q}
                %p
                  is the
                  %strong limit term
                  of the spectral sequence;
            %ul
              %li
                the spectral sequence
                %strong abuts
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi E
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} E^\infty
          #Degeneration.num_example
            %h6#example Example
            %p
              If for a spectral sequence there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi s
                  %annotation{:encoding => "application/x-tex"} r_s
              such that all
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              on pages after
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi s
                  %annotation{:encoding => "application/x-tex"} r_s
              vanish,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mrow
                          %mi r
                          %mo ≥
                          %msub
                            %mi r
                            %mi s
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial^{r \geq r_s} = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi E
                      %mrow
                        %msub
                          %mi r
                          %mi s
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^{r_s}\}_{p,q}
              is limit term for the spectral sequence. One says in this cases that the spectral sequence
              %strong collapses
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi r
                        %mi s
                    %annotation{:encoding => "application/x-tex"} r_s
          .proof
            %h6#proof_5 Proof
            %p By the defining relation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo ≃
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi E
                      %mi pq
                      %mi r
                  %annotation{:encoding => "application/x-tex"}
                    E^{r+1}_{p,q} \simeq ker(\partial^r_{p-r,q+r-1})/im(\partial^r_{p,q}) = E^r_{pq}
            %p
              the spectral sequence becomes constant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi s
                  %annotation{:encoding => "application/x-tex"} r_s
              on if all the differentials vanish, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mo ∂
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} ker(\partial^r_{p,q}) = E^r_{p,q}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %annotation{:encoding => "application/x-tex"} p,q
          #Collaps.num_example
            %h6#example_2 Example
            %p
              If for a
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}_{r,p,q}
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi s
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} r_s \geq 2
              such that the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi r
                        %mi s
                    %annotation{:encoding => "application/x-tex"} r_s
              = succeed "," do
                %a.maruku-ref{:href => "#Degeneration"}
              = succeed "." do
                %a.maruku-ref{:href => "#LimitTerm"}
              %strong collapses
              on this page.
          .proof
            %h6#proof_6 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} r \geq 2
              the
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              of the spectral sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo →
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                      %mi r
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^r \colon E^r_{p,q} \to E^r_{p-r, q+r-1}
            %p
              have
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              and
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              necessarily in different rows an columns (while for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} r = 1
              both are in the same row and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = 0
              both coincide). Therefore if all but one row or column vanish, then all these differentials vanish.
          #Convergence.num_defn
            %h6#definition_5 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi r
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}_{r,p,q}
              is said to
              %strong converge
              to a
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                  %annotation{:encoding => "application/x-tex"} H_\bullet
              with
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtering
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo •
                      %msub
                        %mi H
                        %mo •
                    %annotation{:encoding => "application/x-tex"} F_\bullet H_\bullet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo ⇒
                    %msub
                      %mi H
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^r_{p,q} \Rightarrow H_\bullet
                    \\,,
            %p
              if the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{G_p H_{p+q}\}_{p,q} \coloneqq \{F_p H_{p+q} / F_{p-1} H_{p+q}\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is the limit term of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed ":" do
                %a.maruku-ref{:href => "#LimitTerm"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn ∞
                    %mo ≃
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∀
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^\infty_{p,q} \simeq G_p H_{p+q} \;\;\;\;\;\;\; \forall_{p,q}
                    \\,.
          .num_remark
            %h6#remark_3 Remark
            %p
              In practice spectral sequences are often referred to via their first non-trivial page, often also the page at which it collapses, def.
              = succeed "," do
                %a.maruku-ref{:href => "#Collaps"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 2
                    %mo ⇒
                    %msub
                      %mi H
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    E^2_{p,q} \Rightarrow H_\bullet
            %p to be read as “There is a spectral sequence whose second page is as shown on the left and which converges to a filtered object as shown on the right.”
          #BoundedSpectralSequence.num_defn
            %h6#definition_6 Definition
            %p
              A spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}
              is called a
              %strong bounded spectral sequence
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                    %mi r
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n,r \in \mathbb{Z}
              the number of non-vanishing terms of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi k
                        %mo ,
                        %mi n
                        %mo −
                        %mi k
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r_{k,n-k}
              is finite.
          #QuadrantSpectralSequence.num_example
            %h6#example_3 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{E^r_{p,q}\}
              is called
            %ul
              %li
                %p
                  a
                  %strong first quadrant spectral sequence
                  if all terms except possibly for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                        %mo ≥
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p,q \geq 0
                  vanish;
              %li
                %p
                  a
                  %strong third quadrant spectral sequence
                  if all terms except possibly for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                        %mo ≤
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p,q \leq 0
                  vanish.
            %p
              Such spectral sequences are bounded, def.
              = succeed "." do
                %a.maruku-ref{:href => "#BoundedSpectralSequence"}
          #BoundedSpectralSequenceHasLimitTerm.num_prop
            %h6#proposition_6 Proposition
            %p
              A bounded spectral sequence, def.
              = succeed "," do
                %a.maruku-ref{:href => "#BoundedSpectralSequence"}
              = succeed "." do
                %a.maruku-ref{:href => "#LimitTerm"}
          .proof
            %h6#proof_7 Proof
            %p
              First notice that if a spectral sequence has at most
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              non-vanishing terms of total degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              on page
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            %p
              Therefore for a bounded spectral sequence for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} L(n) \in \mathbb{Z}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi n
                        %mo −
                        %mi p
                      %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E^r_{p,n-p} = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≤
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p \leq L(n)
              and all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} T(n) \in \mathbb{Z}
              such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi n
                        %mo −
                        %mi q
                        %mo ,
                        %mi q
                      %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E^r_{n-q,q} = 0
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≤
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q \leq T(n)
              and all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            %p
              We claim then that the limit term of the bounded spectral sequence is in position
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
              given by the value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r_{p,q}
              for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo &gt;
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo −
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mi q
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi q
                    %mo +
                    %mn 1
                    %mo −
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mi q
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    r \gt max(  p-L(p+q-1), q + 1 - L(p+q+1) )
                    \\,.
            %p
              This is because for such
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              we have
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi q
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                          %mi r
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} E^r_{p-r, q+r-1} = 0
                  because
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                          %mo −
                          %mi r
                          %mo &lt;
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo +
                          %mi q
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} p-r \lt L(p+q-1)
                  %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mo ∂
                          %mrow
                            %mi p
                            %mo −
                            %mi r
                            %mo ,
                            %mi q
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                          %mi r
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} ker(\partial^r_{p-r,q+r-1}) = 0
                  vanishes;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi E
                          %mrow
                            %mi p
                            %mo +
                            %mi r
                            %mo ,
                            %mi q
                            %mo −
                            %mi r
                            %mo +
                            %mn 1
                          %mi r
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} E^r_{p+r, q-r+1} = 0
                  because
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi q
                          %mo −
                          %mi r
                          %mo +
                          %mn 1
                          %mo &lt;
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo +
                          %mi q
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} q-r + 1 \lt T(p+q+1)
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi im
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mo ∂
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mi r
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} im(\partial^r_{p,q}) = 0
                  vanishes.
            %p Therefore
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mrow
                                %mi r
                                %mo +
                                %mn 1
                          %mtd
                            %mo =
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∂
                              %mrow
                                %mi p
                                %mo −
                                %mi r
                                %mo ,
                                %mi q
                                %mo +
                                %mi r
                                %mo −
                                %mn 1
                              %mi r
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi im
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mo ∂
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mi r
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mi r
                            %mo{:stretchy => "false"} /
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi E
                              %mrow
                                %mi p
                                %mo ,
                                %mi q
                              %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    E^{r+1}_{p,q}
                    \&amp;=
                    ker(\partial^r_{p-r,q+r-1})/im(\partial^r_{p,q})
                    \\\
                    \&amp; \simeq E^r_{p,q}/0
                    \\\
                    \&amp; \simeq E^r_{p,q}
                    \\end{aligned}
                    \\,.
          %h4#ConvergenceGeneral Convergence of bounded filtrations
          #BoundedFiltration.num_defn
            %h6#definition_7 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet C_\bullet
              on a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              is called a
              %strong bounded filtration
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} L(n), T(n) \in \mathbb{Z}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo &lt;
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi C
                      %mi n
                    %mo =
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo &gt;
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi C
                      %mi n
                    %mo ≃
                    %msub
                      %mi C
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F_{p \lt S(n)}C_n = 0
                    \\;\;\;\;\;
                    F_{p \gt T(n)}C_n \simeq C_n
                    \\,.
          .num_prop
            %h6#proposition_7 Proposition
            %p
              The spectral sequence of a complex with bounded filtration, def.
              = succeed "," do
                %a.maruku-ref{:href => "#BoundedFiltration"}
              = succeed "." do
                %a.maruku-ref{:href => "#LimitTerm"}
          .proof
            %h6#proof_8 Proof
            %p
              The spectral sequence of a filtered complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet C_\bullet
              is by def.
              %a.maruku-ref{:href => "#ExplicitForm"}
              at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} E^r_{p,q}
              a
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of a
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi p
                      %msub
                        %mi C
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                    %annotation{:encoding => "application/x-tex"} F_p C_{p+q}
              %a.maruku-ref{:href => "#BoundedFiltration"}
              therefore there are for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                    %mi r
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n,r \in \mathbb{Z}
              finitely many non-vanishing terms of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mrow
                          %mi p
                          %mo ,
                          %mi n
                          %mo −
                          %mi p
                        %mi r
                    %annotation{:encoding => "application/x-tex"} E^r_{p,n-p}
              %a.maruku-ref{:href => "#BoundedSpectralSequence"}
              and hence has a limit term by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#BoundedSpectralSequenceHasLimitTerm"}
          .num_example
            %h6#example_4 Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X \in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              is a
              %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              with cell filtration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mo ↪
                      %msub
                        %mi X
                        %mn 1
                      %mo ↪
                      %mi ⋯
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_0 \hookrightarrow X_1 \hookrightarrow \cdots \hookrightarrow X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_p C_\bullet(X) \coloneqq C_\bullet(X_n)
            %p
              on its
              %a.existingWikiWord{:href => "/nlab/show/singular+chain+complex"} singular chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet(X)
              yields a first-quadrant spectral sequence, example
              = succeed "." do
                %a.maruku-ref{:href => "#QuadrantSpectralSequence"}
          %p Before saying that the spectral sequence of a filtered complex converges to the homology of that complex, we need to be careful about what the filtering is on that homology:
          #FilteringOnHomology.num_defn
            %h6#definition_8 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} F_\bullet C_\bullet
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/filtered+complex"} filtered complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} p \in \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi image
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F_p H_\bullet(C)
                    \\coloneqq
                    image( H_\bullet(F_p C_\bullet) \to H_\bullet(C_\bullet) )
                    \\,.
            %p
              This defines a filtering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_\bullet H_\bullet(C)
              of the homology, regarded as a graded object.
          #AbuttingFiltrationConvergesToHomology.num_prop
            %h6#proposition_8 Proposition
            %p
              If the spectral sequence of a filtered complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo •
                      %msub
                        %mi C
                        %mo •
                    %annotation{:encoding => "application/x-tex"} F_\bullet C_\bullet
              %a.maruku-ref{:href => "#BoundedFiltration"}
              has a limit term, def.
              = succeed "," do
                %a.maruku-ref{:href => "#LimitTerm"}
              = succeed "," do
                %a.maruku-ref{:href => "#Convergence"}
              %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
              of the complex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo ⇒
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^r_{p,q} \Rightarrow H_\bullet(C)
                    \\,.
            %p
              Hence for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p,q
              there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r(p,q)
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mrow
                        %mi r
                        %mo ≥
                        %mi r
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi G
                      %mi p
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^{r \geq r(p,q)}_{p,q} \simeq G_p H_{p+q}(C)
                    \\,,
            %p
              with the filtering on the right as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#FilteringOnHomology"}
          .proof
            %h6#proof_9 Proof
            %p
              By assumption, there is for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p,q
              an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r(p,q)
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r \geq r(p,q)
              the
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "," do
                %a.maruku-ref{:href => "#AlmostChainsCyclesBoundaries"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} F_p C_{p+q}
              are the ordinary
              %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r \geq r(p,q)
              def.
              %a.maruku-ref{:href => "#ExplicitForm"}
              gives
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mrow
                          %mi p
                          %mo ,
                          %mi q
                        %mi r
                      %mo ≃
                      %msub
                        %mi G
                        %mi p
                      %msub
                        %mi H
                        %mrow
                          %mi p
                          %mo +
                          %mi q
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^r_{p,q} \simeq G_p H_{p+q}(C)
          %h4#via_exact_couples_2 Via exact couples
          %p
            It is instructive to note that in the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/exact+couple"} exact couple
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi φ
                      %mi n
                    %mi D
                    %mo →
                    %msub
                      %mi E
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi φ
                      %mi n
                    %mi D
                    %mo →
                    %mrow
                  %annotation{:encoding => "application/x-tex"} \varphi^n D\to E_{(n)} \to \varphi^n D\to{}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi φ
                    %mi n
                  %mi D
                %annotation{:encoding => "application/x-tex"} \varphi^n D
            is the
            %a.existingWikiWord{:href => "/nlab/show/module"} submodule
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D_{(n)}
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mi i
                    %mi H
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mrow
                        %mi i
                        %mo +
                        %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bigoplus_{i} H(F_{i+n})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(F_{i+n})
            representable by elements of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi i
                  %msub
                    %mi D
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ∩
                      %msub
                        %mi F
                        %mi i
                    %mrow
                      %msub
                        %mi F
                        %mi i
                      %mo ∩
                      %msub
                        %mi dF
                        %mrow
                          %mi i
                          %mo +
                          %mi n
                  %mo .
                %annotation{:encoding => "application/x-tex"} F_{i} D_{(n)} = \frac{\ker(d)\cap F_i}{F_i\cap dF_{i+n}}.
          %p
            Separating the grades, the exactness of the couple at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_{(n)}
            then says
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi i
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi E
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mi …
                  %mo →
                  %msub
                    %mi F
                    %mi i
                  %msup
                    %mi H
                    %mrow
                      %mi j
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msup
                    %mi H
                    %mrow
                      %mi j
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_{i} H^j(F_{i+n})\to F_{i+1}H^j(F_{i+n+1}) \to E_{(n)}^{i\dots} \to F_i H^{j+1}(F_{i+n}) \to F_{i+1}H^{j+1}(F_{i+n+1})
          %p
            One can see this as converging (if it sensibly converges) to either a subquotient of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi i
                %annotation{:encoding => "application/x-tex"} F_i
            %em or
            to a
            %a.existingWikiWord{:href => "/nlab/show/module"} submodule
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi i
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_i H^\bullet(C) \lt H^\bullet(C)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi i
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi E
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mi …
                  %mo →
                  %msub
                    %mi F
                    %mi i
                  %msup
                    %mi H
                    %mrow
                      %mi j
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msup
                    %mi H
                    %mrow
                      %mi j
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} F_i H^j(C)\to F_{i+1} H^j(C) \to E_{(\infty)}^{i\dots} \to F_i H^{j+1}(C) \to F_{i+1} H^{j+1}(C).
          %p
            At this stage one can check that the morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi i
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_i H^j(C)\to F_{i+1} H^j(C)
            are indeed definable, and in fact injective, so that whatever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_{(\infty)}
            should be, the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mi …
                  %mo →
                  %msub
                    %mi F
                    %mi i
                  %msup
                    %mi H
                    %mrow
                      %mi j
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} E_{(\infty)}^{i\dots}\to F_i H^{j+1}
            is null; that is, our long-exact sequence breaks up into the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msub
                    %mi F
                    %mi i
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                  %msup
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi E
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mi …
                  %mo →
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} 0\to F_i H^j(C) \to F_{i+1} H^j(C)\to E_{(\infty)}^{i\dots} \to 0 .
          %p
            In summary, if the spectral sequence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_{(n)}
            converges in a sensible way to the correct thing
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_{(\infty)}
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            of the
            %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^\bullet(C)
            induced by the
            %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#examples Examples
          %h3#2term_filtering 2-term filtering
          %p
            The special case where the filtering has just length one is that where we simply have a sub-complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mo •
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo ↪
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} C^{(1)}_\bullet \hookrightarrow C_\bullet
            and want to compute the homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                %annotation{:encoding => "application/x-tex"} C_\bullet
            from that of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mo •
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^{(1)}_\bullet
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi C
                      %mo •
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_\bullet/C^{(1)}_\bullet
          %p This case is easily solved by elementary means and it serves as an instructive blueprint for the general case.
          .num_prop
            %h6#proposition_9 Proposition
            %p
              Given a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/subobject"} sub
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mo •
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo ↪
                      %msub
                        %mi C
                        %mo •
                    %annotation{:encoding => "application/x-tex"} C^{(1)}_\bullet \hookrightarrow C_\bullet
            %ol
              %li
                %p
                  Consider the
                  %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo →
                        %msubsup
                          %mi C
                          %mo •
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi C
                          %mo •
                        %mo →
                        %msub
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} /
                        %msubsup
                          %mi C
                          %mo •
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo →
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        0 \to C^{(1)}_\bullet \to C_\bullet \to C_\bullet/C^{(1)}_\bullet \to 0
              %li
                %p
                  Its
                  %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
                  contains the
                  %a.existingWikiWord{:href => "/nlab/show/connecting+homomorphism"} connecting homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mo :
                        %msub
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} /
                        %msubsup
                          %mi C
                          %mo •
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi H
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi C
                          %mo •
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\delta
                        \:
                        H_\bullet(C_\bullet/C^{(1)}_\bullet)
                        \\to
                        H_{\bullet-1}(C^{(1)}_\bullet)
                        \\,.
                %p Define
                %ul
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi G
                              %mn 1
                            %msub
                              %mi H
                              %mo •
                            %mo ≔
                            %mi ker
                            %mi δ
                          %annotation{:encoding => "application/x-tex"} G_1 H_\bullet \coloneqq ker \delta
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %msub
                              %mi G
                              %mn 2
                            %msub
                              %mi H
                              %mo •
                            %mo ≔
                            %mi coker
                            %mi δ
                          %annotation{:encoding => "application/x-tex"} G_2 H_\bullet \coloneqq coker \delta
                      \.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_\bullet(C_\bullet)
              is sits in the short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi G
                      %mn 0
                    %msub
                      %mi H
                      %mo •
                    %mo →
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi G
                      %mn 1
                    %msub
                      %mi H
                      %mo •
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to G_0 H_\bullet \to H_\bullet(C_\bullet) \to G_1 H_\bullet \to 0
                    \\,.
          %p (…)
          %h3#ExampleHomologyOfTensorProduct Homology of a tensor product of chain complexes
          %p
            Consider two chain complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo ,
                  %mi C
                  %msub
                    %mo ′
                    %mo •
                %annotation{:encoding => "application/x-tex"} C_\bullet, C'_\bullet
            of
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            over a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            Their
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo ⊗
                  %mi C
                  %msub
                    %mo ′
                    %mo •
                  %mo =
                  %msub
                    %mo ⊕
                    %mrow
                      %mi i
                      %mo +
                      %mi j
                      %mo =
                      %mi k
                  %msub
                    %mi C
                    %mi i
                  %mo ⊗
                  %msub
                    %mi C
                    %mi j
                %annotation{:encoding => "application/x-tex"}
                  C_\bullet \otimes C'_\bullet
                  \=
                  \\oplus_{i+j = k} C_i \otimes C_j
          %p
            with
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            on homogenous elements
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mo ⊗
                  %mi β
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo ∂
                  %mi α
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi β
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi deg
                      %mi α
                  %mi α
                  %mo ⊗
                  %mo ∂
                  %mi β
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\partial (\alpha \otimes\beta) =
                  (\partial \alpha)
                  \\otimes \beta
                  +
                  (-1)^{deg \alpha} \alpha \otimes \partial \beta
                  \\,.
          %p
            We may compute the homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C \otimes C'
            by a spectral sequence as follows.
          %p
            Define a filtration on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C \otimes C'
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊗
                  %mi C
                  %mo ′
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo ≔
                  %msub
                    %mo ⊕
                    %mrow
                      %mi i
                      %mo ≤
                      %mi p
                  %msub
                    %mi C
                    %mi i
                  %mo ⊗
                  %msub
                    %mi C
                    %mrow
                      %mi k
                      %mo −
                      %mi i
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F_p(C \otimes C')_{k}
                  \\coloneqq
                  \\oplus_{i \leq p} C_i \otimes C_{k-i}
                  \\,.
          %p
            This means that the
            %a.existingWikiWord{:href => "/nlab/show/associated+graded+object"} associated graded object
            is simply
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn 0
                  %mo =
                  %msub
                    %mi G
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊗
                  %mi C
                  %mo ′
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo =
                  %msub
                    %mi C
                    %mi p
                  %mo ⊗
                  %mi C
                  %msub
                    %mo ′
                    %mi q
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^0_{p,q} = G_p (C \otimes C')_{p+q}
                  \=
                  C_p \otimes C'_q
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            on this is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mrow
                        %mi r
                        %mo =
                        %mn 0
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi p
                    %msub
                      %mi id
                      %mi C
                    %mo ⊗
                    %mo ∂
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \partial_{r = 0} = (-1)^p id_{C} \otimes \partial'
            %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
            gives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn 1
                  %mo =
                  %msub
                    %mi C
                    %mi p
                  %mo ⊗
                  %msub
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^1_{p,q} = C_p \otimes H_q(C')
                  \\,.
          %p
            The next differential is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mn 1
                    %mo =
                    %mo ∂
                    %mo ⊗
                    %msub
                      %mi id
                      %mrow
                        %mi C
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \partial_1 = \partial \otimes id_{C'}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is assumed to be a field we have thus
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn 2
                  %mo =
                  %msub
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mo •
                  %mo ⊗
                  %msub
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msub
                    %mo ′
                    %mo •
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi H
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^2_{p,q} = H_p(C_\bullet \otimes H_q(C'_\bullet))
                  \=
                  H_p(C)\otimes H_q(C')
                  \\,.
          %p
            Therefore every element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn 2
                %annotation{:encoding => "application/x-tex"} E^2_{p,q}
            is represented by a tensor product of a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/cycle"} cycle
            with a
            = succeed "-cycle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C'
            = succeed "-cycle." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ⊗
                    %mi C
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C \otimes C')
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊗
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} C \otimes C'
            = succeed "-page." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E^2
          %p
            The convergence of the spectral sequence to the the homology of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C \otimes C'
            thus says that this is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⊗
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mo ⊕
                    %mrow
                      %mi i
                      %mo +
                      %mi j
                      %mo =
                      %mi k
                  %msub
                    %mi H
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi H
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_{k}(C \otimes C')
                  \\simeq
                  \\oplus_{i+j = k} H_i(C) \otimes H_j(C')
                  \\,.
          %h3#ExampleHomologyDoubleComplex Homology of the total complex of a double complex
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
            of a
            %a.existingWikiWord{:href => "/nlab/show/double+complex"} double complex
            is naturally
            %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtered
            either by either row-degree of column-degree. The corresponding filtering spectral sequence converges under good conditions to the homology of the total complex. See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+double+complex"} spectral sequence of a double complex
          %h3#singular_homology_of_a_cwcomplex Singular homology of a CW-complex
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi Top
                %annotation{:encoding => "application/x-tex"} X \in Top
            be a
            %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            equipped explicitly with the structure of a
            %a.existingWikiWord{:href => "/nlab/show/filtered+topological+space"} filtered topological space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mn 0
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msup
                      %mi X
                      %mi n
                    %mo ↪
                    %mi ⋯
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^0 \hookrightarrow \cdots \hookrightarrow X^n \hookrightarrow \cdots X
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(X)
            the structure of a
            %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi q
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F_q C_\bullet(X) \coloneqq C_\bullet(X^p)
                  \\,.
          %p
            We discuss how the corresponding spectral sequence shows that the
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            coincides with the
            %a.existingWikiWord{:href => "/nlab/show/cellular+homology"} cellular homology
            of the filtering.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/associated+graded+object"} associated graded object
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi G
                    %mi p
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn 0
                  %mo =
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %mi p
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  G_p C_{p+q}(X) = E^0_{p,q} = C_{p+q}(X^p)/C_{p+q}(X^{p-1})
                  \\,.
          .num_prop
            %h6#proposition_10 Proposition
            %p
              The chain homology of the associated graded chain complex is the
              %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 1
                    %mo =
                    %msub
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi p
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi X
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E^1_{p,q} = H_{p+q}(X^p | X^{p-1})
                    \\,.
          %p
            Now by assumption that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X^\bullet
            is the cell decomposition of a
            %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi p
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi X
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mi pCells
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mi q
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi otherwise
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  H_{p+q}(X^p | X^{p+1})
                  \\simeq
                  \\left\{
                  \\array{
                  \\mathbb{Z}[pCells(X)] &amp; q = 0
                  \\\
                  0 &amp; otherwise
                  }
                  \\right.
                  \\,.
          %p The chain homology of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi p
                  %mo ,
                  %msup
                    %mi X
                    %mrow
                      %mi p
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi H
                    %mrow
                      %mi p
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mrow
                      %mi p
                      %mo −
                      %mn 1
                  %mo ,
                  %msup
                    %mi X
                    %mrow
                      %mi p
                      %mo −
                      %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\partial \colon
                  H_p(X^p, X^{p-1})
                  \\to
                  H_{p-1}(X^{p-1}, X^{p-2})
          %p
            is the cellular chain homology
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi p
                      %mi cell
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{cell}_p(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi E
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn 2
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi H
                              %mi p
                              %mi cell
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mi q
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi otherwise
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E^2_{p,q} =
                  \\left\{
                  \\array{
                  H_p^{cell}(X) &amp; q = 0
                  \\\
                  0 &amp; otherwise
                  }
                  \\right.
                  \\,.
          %p
            Since this is concentrated in the
            = succeed "-row" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            differentials vanish.
          %p
            Hence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi H
                      %mi p
                      %mi cell
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_p(X) \simeq H^{cell}_p(X)
          .num_remark
            %h6#remark_4 Remark
            %p
              The generalization of this argument from
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              to
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              is given by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Atiyah%E2%80%93Hirzebruch+spectral+sequence"} Atiyah–Hirzebruch spectral sequence
          %h3#serres_spectral_sequence_of_a_fibration Serre’s spectral sequence of a fibration
          %p
            We indicate the
            %a.existingWikiWord{:href => "/nlab/show/Leray-Serre+spectral+sequence"} Leray-Serre spectral sequence
            of a
            %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            as a special case of the filtering spectral sequence. For more discussion see there. Let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix} A &amp; \to &amp; X \\
                  \\downarrow &amp; &amp; \downarrow \\
                  * &amp; \to &amp; B \end{matrix}
          %p
            be a
            %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            of
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleta
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            naturally give filtered-space structures to both
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi B
                            %mi k
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi B
                            %mrow
                              %mi k
                              %mo +
                              %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix} X_{(k)} &amp; \to &amp; X_{(k+1)} &amp; \to &amp; X \\
                  \\downarrow &amp; &amp; \downarrow &amp; &amp;\downarrow \\
                  B_{k} &amp; \to &amp; B_{k+1} &amp; \to &amp; B \end{matrix}
          %p
            and in turn induce filtrations of the singular chain complex of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The homology
            %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
            for the fibration is essentially that of this filtered complex.
          %p
            It is straight-forward to show that the pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo ;
                  %msub
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_{k+1};X_k)
            is
            = succeed "-connected," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %mi k
                      %mo +
                      %mn 1
                  %mo ;
                  %msub
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_i(X_{k+1};X_k)
            vanishes for
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} i\leq k
            = succeed ":" do
              %em nota bene
          %p
            There is also an important result about the
            %em second
            page of this spectral sequence
          .num_theorem
            %h6#theorem Theorem
            %p
              %em
                The page
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi E
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^{(2)}
                of the homology Serre spectral sequence is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %msub
                      %mi ℋ
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E^{(2)}_{p,q} \simeq H_p(B,\mathcal{H}_q(A|_{b}))
            %p
              %em
                the homology of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                with coefficients in the
                %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
                defined by the action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_1 (B)
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mi q
                        %mo{:stretchy => "false"} (
                        %mi A
                        %msub
                          %mo{:stretchy => "false"} |
                          %mi b
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_q(A|_{b})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is simply connected, these local systems are canonically equivalent to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi H
                          %mi q
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} H_q(A)
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Cartan-Eilenberg+spectral+sequence"} Cartan-Eilenberg spectral sequence
          %p
            %br/
          %div
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/tower+diagram"}> tower diagram
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28infinity%2C1%29-category"} filtering
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/filtered+chain+complex"} filtered chain complex
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/chromatic+tower"} chromatic tower
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/chromatic+spectral+sequence"} chromatic spectral sequence
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleta
                    of
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} simplicial object
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleta
                    of
                    %a.existingWikiWord{:href => "/nlab/show/Sweedler+coring"} Sweedler coring
                    of
                    %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
