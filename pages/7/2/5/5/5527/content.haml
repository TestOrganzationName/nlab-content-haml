                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p,q)
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "-boundaries," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
