                          %mi r
                        %annotation{:encoding => "application/x-tex"} p-r
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi B
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mi r
                        %mo ≔
                        %mo ∂
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mrow
                            %mi p
                            %mo +
                            %mi r
                            %mo −
                            %mn 1
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"} B^{r}_{p,q} \coloneqq \partial(F_{p+r-1} C_{p+q+1}) \,,
                %p
                  is the module of
                  = succeed "." do
                    %strong
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi r
                          %annotation{:encoding => "application/x-tex"} r
                      \-almost
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo ,
                              %mi q
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (p,q)
                      %a.existingWikiWord{:href => "/nlab/show/boundaries"} boundaries
          %p Similarly we set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Z
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn ∞
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi c
                  %mo ∈
                  %msub
                    %mi F
                    %mi p
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} |
                  %mo ∂
                  %mi c
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi F
                    %mrow
                      %mi p
                      %mo −
                      %mn 1
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo =
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi G
                    %mi p
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Z^\infty_{p,q} \coloneqq \{c \in F_p C_{p + q} | \partial c = 0 \}/F_{p-1}C_{p+q}
                  \=
                  Z(G_p C_{p+q})
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi B
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                    %mn ∞
                  %mo =
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B^\infty_{p,q} = \cdots
                  \\,.
          %blockquote
            %p fix
          %p
            From this definition we immediately have that the differentials
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                  %mo →
                  %msub
                    %mi C
                    %mrow
                      %mi p
                      %mo +
                      %mi q
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \partial \colon C_{p+q} \to C_{p+q-1}
            restrict to the
            = succeed "-almost" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
          #DifferentialsOnAlmostChains.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo •
                  %annotation{:encoding => "application/x-tex"} C_\bullet
              restrict on
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∂
                      %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mo →
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                      %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial^r
                    \\colon
                    Z^r_{p,q}
                    \\to
                    Z^r_{p-r, q+r-1}
                    \\,.
            %p
              These are still
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mn 2
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \partial^2 = 0
          .proof
            %h6#proof Proof
            %p
              By the very definition of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} Z^r_{p,q}
              it consists of elements in filtering degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              on which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              decreases the filtering degree to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo −
                      %mi r
                    %annotation{:encoding => "application/x-tex"} p-r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              decreases the actual degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p+q
              by one. This explains that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                  %annotation{:encoding => "application/x-tex"} \partial
              restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                  %annotation{:encoding => "application/x-tex"} Z^r_{p,q}
              lands in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Z
                        %mrow
                          %mi p
                          %mo −
                          %mi r
                          %mo ,
                          %mi q
                          %mo +
                          %mi r
                          %mo −
                          %mn 1
                        %mo •
                    %annotation{:encoding => "application/x-tex"} Z^\bullet_{p-r,q+r-1}
            %p
              Now the image consists indeed of actual boundaries, not just
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Z
                        %mrow
                          %mi p
                          %mo −
                          %mi r
                          %mo ,
                          %mi q
                          %mo +
                          %mi r
                          %mo −
                          %mn 1
                        %mi r
                    %annotation{:encoding => "application/x-tex"} Z^r_{p-r,q+r-1}
          .num_prop
            %h6#proposition_2 Proposition
            %p We have a sequence of canonical inclusions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi B
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mo ↪
                    %msubsup
                      %mi B
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 1
                    %mo ↪
                    %mi ⋯
                    %msubsup
                      %mi B
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn ∞
                    %mo ↪
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn ∞
                    %mo ↪
                    %mi ⋯
                    %mo ↪
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 1
                    %mo ↪
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    B^0_{p,q}
                    \\hookrightarrow
                    B^1_{p,q}
                    \\hookrightarrow
                    \\cdots
                    B^\infty_{p,q}
                    \\hookrightarrow
                    Z^\infty_{p,q}
                    \\hookrightarrow
                    \\cdots
                    \\hookrightarrow
                    Z^1_{p,q}
                    \\hookrightarrow
                    Z^0_{p,q}
                    \\,.
          #KernelsInsideAlmostCycles.num_prop
            %h6#proposition_3 Proposition
            %p
              The
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (r+1)
              = succeed "-kernel" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∂
                        %mi r
                    %annotation{:encoding => "application/x-tex"} \partial^r
              = succeed "-almost" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo =
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                      %mi r
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mo ∂
                          %mi r
                    %msubsup
                      %mi Z
                      %mrow
                        %mi p
                        %mo −
                        %mi r
                        %mo ,
                        %mi q
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Z^{r+1}_{p,q}
                    \=
                    ker( Z^r_{p,q} \stackrel{\partial^r}{\to} Z^r_{p-r, q+r-1} )
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              An element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msub
                      %mi F
                      %mi p
                    %msub
                      %mi C
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"} c \in F_p C_{p+q}
              represents
            %ol
              %li
                %p
                  an element in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Z
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mi r
                      %annotation{:encoding => "application/x-tex"} Z^r_{p,q}
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mi c
                        %mo ∈
                        %msub
                          %mi F
                          %mrow
                            %mi p
                            %mo −
                            %mi r
                        %msub
                          %mi C
                          %mrow
                            %mi p
                            %mo +
                            %mi q
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \partial c \in F_{p-r} C_{p+q-1}
              %li
                %p
                  an element in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Z
                          %mrow
                            %mi p
                            %mo ,
                            %mi q
                          %mrow
                            %mi r
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} Z^{r+1}_{p,q}
                  if even
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
