                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo ,
                            %mi q
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (p,q)
                      \-
                      %a.existingWikiWord{:href => "/nlab/show/chains"} chains
                  or of
                  = succeed ";" do
                    %strong
                      %em
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo +
                              %mi q
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (p+q)
                        \-chains in filtering degree
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi p
                            %annotation{:encoding => "application/x-tex"} p
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %msubsup
                                  %mi Z
                                  %mrow
                                    %mi p
                                    %mo ,
                                    %mi q
                                  %mi r
                              %mtd
                                %mo ≔
                                %mrow
                                  %mo {
                                  %mi c
                                  %mo ∈
                                  %msub
                                    %mi G
                                    %mi p
                                  %msub
                                    %mi C
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mi q
                                  %mo{:stretchy => "false"} |
                                  %mo ∂
                                  %mi c
                                  %mo =
                                  %mn 0
                                  %mspace{:width => "thinmathspace"}
                                  %mi mod
                                  %mspace{:width => "thinmathspace"}
                                  %msub
                                    %mi F
                                    %mrow
                                      %mi p
                                      %mo −
                                      %mi r
                                  %msub
                                    %mi C
                                    %mo •
                                  %mo }
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %mrow
                                  %mo {
                                  %mi c
                                  %mo ∈
                                  %msub
                                    %mi F
                                    %mi p
                                  %msub
                                    %mi C
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mi q
                                  %mo{:stretchy => "false"} |
                                  %mo ∂
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo{:stretchy => "false"} )
                                  %mo ∈
                                  %msub
                                    %mi F
                                    %mrow
                                      %mi p
                                      %mo −
                                      %mi r
                                  %msub
                                    %mi C
                                    %mrow
                                      %mi p
                                      %mo +
                                      %mi q
                                      %mo −
                                      %mn 1
                                  %mo }
                                %mo{:stretchy => "false"} /
                                %msub
                                  %mi F
                                  %mrow
                                    %mi p
                                    %mo −
                                    %mn 1
                                %msub
                                  %mi C
                                  %mrow
                                    %mi p
                                    %mo +
                                    %mi q
                      %annotation{:encoding => "application/x-tex"} \begin{aligned} Z^r_{p,q}  &amp; \coloneqq \left\{ c \in G_p C_{p+q} | \partial c = 0 \, mod\, F_{p-r} C_{\bullet} \right\} \\ &amp; =  \left\{ c \in F_p C_{p+q} | \partial(c) \in F_{p-r} C_{p+q-1} \right\}/ F_{p-1}C_{p+q} \end{aligned}
                %p
                  is the module of
                  %strong
                    %em
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi r
                          %annotation{:encoding => "application/x-tex"} r
                      \-almost
                      = succeed "-" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo ,
                              %mi q
                              %mo{:stretchy => "false"} )
                            %annotation{:encoding => "application/x-tex"} (p,q)
                      %a.existingWikiWord{:href => "/nlab/show/cycles"} cycles
                  (the
                  = succeed "-chains" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo +
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p+q)
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
