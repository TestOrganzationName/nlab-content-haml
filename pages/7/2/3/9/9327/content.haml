            = succeed "." do
              %a{:href => "#Lurie"} HA 2.4.2.5
          %p
          .num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
