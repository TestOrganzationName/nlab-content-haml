                  %annotation{:encoding => "application/x-tex"} \infty
          .num_theorem
            %h6 Theorem
            %p
              Lurie’s construction yields a fully faithful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ×
                    %mo :
                    %msubsup
                      %mi{:mathvariant => "normal"} Cat
                      %mn ∞
                      %mo ×
                    %mo ↪
                    %msubsup
                      %mi{:mathvariant => "normal"} Cat
                      %mn ∞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} (-)^\times:\mathrm{Cat}_\infty^{\times} \hookrightarrow \mathrm{Cat}_\infty^{\otimes}
              whose image is spanned by the Cartesian symmetric monoidal
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %h3#O-monoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi 𝒪
                %annotation{:encoding => "application/x-tex"} \mathcal{O}
            \-algebras as
            = succeed "-monoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
