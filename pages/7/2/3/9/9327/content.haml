              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-category"} ∞-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mo ⊗
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{O}^{\otimes} \rightarrow \mathcal{C}
            is an
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
