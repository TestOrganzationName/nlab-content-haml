          %h2#idea Idea
          %p
            A
            %em cartesian symmetric monoidal (∞,1)-category
            is a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
            whose
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            is given by the categorical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cocartesian+symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} cocartesian symmetric monoidal (∞,1)-category
          %p
            In the special case that the underlying
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            is equivalent to just a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            = succeed "." do
              %span.newWikiWord
                cartesian symmetric monoidal category
                %a{:href => "/nlab/new/cartesian+symmetric+monoidal+category"} ?
          %h2#definition Definition
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%E2%88%9E-category"} symmetric monoidal ∞-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\otimes}
              is
              %strong Cartesian
              if the following conditions are satisfied:
            %ol
              %li
                %p
                  The unit object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mn 1
                          %mi 𝒞
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} 1_{\mathcal{C}} \in \mathcal{C}
                  is final, and
              %li
                %p
                  For every pair of objects
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo ,
                          %mi D
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} C,D \in \mathcal{C}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ≃
                        %mi C
                        %mo ⊗
                        %msub
                          %mn 1
                          %mi 𝒞
                        %mo ←
                        %mi C
                        %mo ⊗
                        %mi D
                        %mo →
                        %msub
                          %mn 1
                          %mi 𝒞
                        %mo ⊗
                        %mi D
                        %mo ≃
                        %mi D
                      %annotation{:encoding => "application/x-tex"}
                        C \simeq C \otimes 1_{\mathcal{C}} \leftarrow C \otimes D \rightarrow 1_{\mathcal{C}} \otimes D \simeq D
                %p
                  exhibit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ⊗
                        %mi D
                      %annotation{:encoding => "application/x-tex"} C \otimes D
                  as the product
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo ×
                          %mi D
                        %annotation{:encoding => "application/x-tex"} C \times D
            %p
          %p
            Equivalently, for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
