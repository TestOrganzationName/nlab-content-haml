                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall_p: P(X \times Y) \to P(X)
                takes
                %a.existingWikiWord{:href => "/nlab/show/open+sets"} open sets
                in
