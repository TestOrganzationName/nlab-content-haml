                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^\ast: P(X) \to P(X \times Y)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∀
                        %mi p
                      %mo =
                      %mo ¬
                      %msub
                        %mo ∃
                        %mi p
                      %mo ¬
                    %annotation{:encoding => "application/x-tex"} \forall_p = \neg \exists_p \neg
            %ul
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is compact, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∀
                        %mi p
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
