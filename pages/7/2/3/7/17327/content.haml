                  %mi Y
                %annotation{:encoding => "application/x-tex"} O \times Y
            may be pictured as a little open “tube” around
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} }
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \{x\} \times Y
            which fits inside
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          #tube.num_lemma
            %h6#lemma Lemma
            %p
              %strong (Tube lemma)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              open in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mi Y
                      %mo ⊆
                      %mi W
                    %annotation{:encoding => "application/x-tex"} \{x\} \times Y \subseteq W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that the “tube”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} O \times Y
              around
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \{x \} \times Y
              is still contained:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo ×
                      %mi Y
                      %mo ⊆
                      %mi W
                    %annotation{:encoding => "application/x-tex"} O \times Y \subseteq W
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_x
              denote the set of open neighborhoods of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %msub
                        %mi 𝒪
                        %mi x
                    %annotation{:encoding => "application/x-tex"} U \in \mathcal{O}_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊸
                    %mi W
                  %annotation{:encoding => "application/x-tex"} U\multimap W
              be the largest open
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi V
                      %mo ⊆
                      %mi W
                    %annotation{:encoding => "application/x-tex"} U \times V \subseteq W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi U
                    %mo ⊸
                    %mi W
                    %mo :
                    %mi U
                    %mo ∈
                    %msub
                      %mi 𝒪
                      %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U \multimap W: U \in \mathcal{O}_x\}
              is an open cover of
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is compact, there is a finite subcover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ⊸
                      %mi W
                      %mo ,
                      %msub
                        %mi U
                        %mn 2
                      %mo ⊸
                      %mi W
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi U
                        %mi n
                      %mo ⊸
                      %mi W
                    %annotation{:encoding => "application/x-tex"} U_1 \multimap W, U_2 \multimap W, \ldots, U_n \multimap W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo =
                    %msub
                      %mi U
                      %mn 1
                    %mo ∩
                    %mi …
                    %mo ∩
                    %msub
                      %mi U
                      %mi n
                    %mo ∈
                    %msub
                      %mi 𝒪
                      %mi x
                  %annotation{:encoding => "application/x-tex"} O = U_1 \cap \ldots \cap U_n \in \mathcal{O}_x
              is the desired open. For,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo ⊆
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} O \subseteq U_i
              implies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo ⊸
                      %mi W
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mo{:stretchy => "false"} (
                      %mi O
                      %mo ⊸
                      %mi W
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (U_i \multimap W) \subseteq (O \multimap W)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo ⊸
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi O
                    %mo ⊸
                    %mi W
                  %annotation{:encoding => "application/x-tex"} Y = \bigcup_{i=1}^n (U_i \multimap W) \subseteq O \multimap W
            %p
              and this implies
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo ×
                      %mi Y
                      %mo ⊆
                      %mi O
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi O
                      %mo ⊸
                      %mi W
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %mi W
                    %annotation{:encoding => "application/x-tex"} O \times Y \subseteq O \times (O \multimap W) \subseteq W
          #ProofOfTubeLemmaViaClosedProjectionCharacterization.proof
            %h6#proof_3 Proof
            %p
              (of the tube lemma
              %a.maruku-ref{:href => "#tube"}
              via
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/closed-projection+characterization+of+compactness"} closed-projection characterization of compactness
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo \
                    %mi W
                  %annotation{:encoding => "application/x-tex"}
                    C \coloneqq (X \times Y) \backslash W
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %a.maruku-ref{:href => "#ProjectingOutCompactSpaceIsClosedMap"}
              also its projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p_X(C) \subset X
              is closed.
            %p Now
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi Y
                            %mo ⊂
                            %mi W
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ×
                            %mi Y
                            %mspace{:width => "thickmathspace"}
                            %mo ∩
                            %mspace{:width => "thickmathspace"}
                            %mi C
                            %mo =
                            %mi ∅
                        %mtr
                          %mtd
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ⇒
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} {
                            %mi x
                            %mo{:stretchy => "false"} }
                            %mo ∩
                            %msub
                              %mi p
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ∅
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\{x\} \times Y \subset W
                    \&amp; \;\Leftrightarrow\;
                    \\{x\} \times Y \; \cap \; C = \emptyset
                    \\\
                    \&amp; \;\Rightarrow\;
                    \\{x\} \cap  p_X(C) = \emptyset
                    \\end{aligned}
            %p
              and hence by the closure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_X(C)
              there is (by
              = succeed ")" do
                %a{:href => "Introduction+to+Topology+--+1#UnionOfOpensGivesClosure"} this lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊃
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U_x \supset \{x\}
              with
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ∩
                    %msub
                      %mi p
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_x \cap p_X(C) = \emptyset
                    \\,.
            %p
              This means equivalently that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                      %mo ×
                      %mi Y
                      %mo ∩
                      %mi C
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} U_x \times Y \cap C = \emptyset
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi x
                      %mo ×
                      %mi Y
                      %mo ⊂
                      %mi W
                    %annotation{:encoding => "application/x-tex"} U_x \times Y \subset W
          %h2#consequences Consequences
          %h3#tychnoff_theorem Tychnoff theorem
          .num_cor
            %h6#corollary Corollary
            %p
              %strong
                (binary
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Tychonoff+theorem"} Tychonoff theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              of two
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X, Y
              is itself compact.
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} \mathcal{U}
              be any open cover of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              be the collection of opens of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              that are unions of finitely many elements of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \{x\} \times Y
              is compact since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is, so there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B \in \mathcal{B}
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mi Y
                      %mo ⊆
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \{x\} \times Y \subseteq B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %msub
                      %mi 𝒪
                      %mi x
                  %annotation{:encoding => "application/x-tex"} U \in \mathcal{O}_x
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi Y
                    %mo ⊆
                    %mi B
                  %annotation{:encoding => "application/x-tex"} U \times Y \subseteq B
              by the tube lemma.
            %p It follows that the collection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi U
                    %mspace{:width => "thickmathspace"}
                    %mi open
                    %mspace{:width => "thickmathspace"}
                    %mi in
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo :
                    %mi U
                    %mo ×
                    %mi Y
                    %mo ⊆
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mi for
                    %mspace{:width => "thickmathspace"}
                    %mi some
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mo ∈
                    %mi ℬ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U\; open\; in\; X: U \times Y \subseteq B \; for\; some\; B \in \mathcal{B}\}
            %p
              covers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              there is a finite subcover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi U
                      %mi n
                  %annotation{:encoding => "application/x-tex"} U_1, \ldots, U_n
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %mi Y
                    %mo ⊆
                    %msub
                      %mi B
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i \times Y \subseteq B_i
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi i
                      %mo ∈
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} B_i \in \mathcal{B}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %msub
                      %mi B
                      %mn 1
