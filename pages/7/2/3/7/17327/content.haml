            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %h2#StatementAndProofs Statements and proofs
          #ProjectingOutCompactSpaceIsClosedMap.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/closed-projection+characterization+of+compactness"}> closed-projection characterization of compactness
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/projection+map"} projection map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p: X \times Y \to X
              out of the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+map"} closed map
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              (the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi p
                    %mo :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_p: P (X \times Y) \to P(X)
              to the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              map
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p^\ast: P(X) \to P(X \times Y)
              %a.existingWikiWord{:href => "/nlab/show/closed+sets"} closed sets
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              are mapped to closed sets in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            Assuming the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+excluded+middle"} principle of excluded middle
            %a.maruku-ref{:href => "#ProjectingOutCompactSpaceIsClosedMap"}
            is equivalent to an alternative formulation:
          #Alternative.num_prop
            %h6#proposition_2 Proposition
            %p
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∀
                      %mi p
                    %mo :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall_p: P(X \times Y) \to P(X)
              be the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
                        %mo *
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
