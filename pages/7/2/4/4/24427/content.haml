          %ul
            %li
              %p We say that a graded bimonoid is bicommutative if the underlying graded monoid is commutative and the underlying graded comonoid is cocommutative.
            %li
              %p We say that a graded bimonoid has trivial units if:
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  is an isomorphism (equivalently,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                  is an isomorphism)
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %mi n
                            %mo ,
                            %mi p
                      %annotation{:encoding => "application/x-tex"} \nabla_{n,p}
                  is an isomorphism if either
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n = 0
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p = 0
                  (we have these equivalences with further properties assumed:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %mi n
                            %mo ,
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} \nabla_{n,0}
                  is an isomorphism iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \nabla_{0,n}
                  is an isomorphism in case of commutativity,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mi n
                            %mo ,
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} \Delta_{n,0}
                  is an isomorphism iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \Delta_{0,n}
                  is an isomorphism in case of cocommutativity,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %mi n
                            %mo ,
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} \nabla_{n,0}
                  is an isomorphism iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mi n
                            %mo ,
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} \Delta_{n,0}
                  is an isomorphism in case of specialty and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ∇
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \nabla_{0,n}
                  is an isomorphism iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                      %annotation{:encoding => "application/x-tex"} \Delta_{0,n}
                  is an isomorphism in case of specialty).
          %p
            Under the conjecture of the page
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+powers+in+a+symmetric+monoidal+%28Q+plus%29-linear+category"} symmetric powers in a symmetric monoidal (Q plus)-linear category
          %p
          .num_prop
            %h6 Conjecture
            %p
              Suppose that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a symmetric monoidal
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℚ
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}^{+}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} (A_{n})_{n \ge 0}
              is the underlying graded object of a special bicommutative graded bimonoid with trivial units, then each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A_{n}
              is a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              symmetric power of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} A_{1}
          %p Note that for a special bicommutative graded bimonoids, the condition of trivial units is equivalent to:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is an isomorphism
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mrow
                        %mi n
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \nabla_{n,0}
              is an isomorphism for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \ge 0
          %p
            Of course, if our category possesses the symmetric powers of an object, we also generate a special bicommutative graded bimonoid with trivial units by taking
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                    %mo =
                    %msup
                      %mi A
                      %mrow
                        %msub
                          %mo ⊗
                          %mi s
                        %mi n
                  %annotation{:encoding => "application/x-tex"} A_{n} = A^{\otimes_{s}n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            is a field of characteristic
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of basis
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi X
                      %mi q
                  %annotation{:encoding => "application/x-tex"} X_{1},...,X_{q}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %msub
                          %mo ⊗
                          %mi s
                        %mi m
                    %mo ≅
                    %msub
                      %mi 𝕂
                      %mi m
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi X
                      %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A^{\otimes_{s}m} \cong \mathbb{K}_{m}[X_{1},...,X_{q}]
            %a.existingWikiWord{:href => "/nlab/show/homogeneous+polynomials"} homogeneous polynomials
            of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            in the variables
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi X
                      %mi q
                  %annotation{:encoding => "application/x-tex"} X_{1},...,X_{q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                  %mo ≅
                  %msub
                    %mi 𝕂
                    %mn 0
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{K} \cong \mathbb{K}_{0}[X_{1},...,X_{q}]
            and the multiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕂
                    %mi m
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %msub
                    %mi 𝕂
                    %mi n
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msub
                    %mi 𝕂
                    %mrow
                      %mi m
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{K}_{m}[X_{1},...,X_{q}] \otimes \mathbb{K}_{n}[X_{1},...,X_{q}] \rightarrow \mathbb{K}_{m+n}[X_{1},...,X_{q}]
            are straightforward as well as the counit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕂
                      %mn 0
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ≅
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}_{0}[X_{1},...,X_{n}] \cong \mathbb{K}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝕂
                    %mrow
                      %mi m
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %msub
                    %mi 𝕂
                    %mi m
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %msub
                    %mi 𝕂
                    %mi n
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{K}_{m+n}[X_{1},...,X_{q}] \rightarrow \mathbb{K}_{m}[X_{1},...,X_{q}] \otimes \mathbb{K}_{n}[X_{1},...,X_{q}]
          %p is defined by:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mo .
                  %mo .
                  %mo .
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi i
                        %mrow
                          %mi m
                          %mo +
                          %mi n
                  %mo ↦
                  %mfrac
                    %mn 1
                    %mrow
                      %mi n
                      %mo !
                      %mi p
                      %mo !
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi σ
                      %mo ∈
                      %msub
                        %mi 𝔖
                        %mrow
                          %mi n
                          %mo +
                          %mi p
                  %msub
                    %mi X
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mo .
                  %mo .
                  %mo .
                  %msub
                    %mi X
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi X
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                  %mo .
                  %mo .
                  %mo .
                  %msub
                    %mi X
                    %mrow
                      %mi σ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mrow
                          %mi n
                          %mo +
                          %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X_{i_{1}}...X_{i_{m+n}} \mapsto \frac{1}{n!p!}\underset{\sigma \in \mathfrak{S}_{n+p}}{\sum} X_{\sigma(i_{1})}...X_{\sigma(i_{n})} \otimes X_{\sigma(i_{n+1})}...X_{\sigma(i_{n+p})}
          %p
            The intuition is that it takes a monomial of degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mi p
                  %annotation{:encoding => "application/x-tex"} n+p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and a monomial of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and then sum all the possibilites (however, the result is obtained by considering the different instances of a variable in a monomial as different entities). For example:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi XYZW
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi XY
                  %mo ⊗
                  %mi ZW
                  %mo +
                  %mi XZ
                  %mo ⊗
                  %mi YW
                  %mo +
                  %mi XW
                  %mo ⊗
                  %mi YZ
                  %mo +
                  %mi YZ
                  %mo ⊗
                  %mi ZW
                  %mo +
                  %mi YW
                  %mo ⊗
                  %mi XZ
                  %mo +
                  %mi ZW
                  %mo ⊗
                  %mi XY
                %annotation{:encoding => "application/x-tex"}
                  \\Delta_{2,2}(XYZW) = XY \otimes ZW + XZ \otimes YW + XW \otimes YZ + YZ \otimes ZW + YW \otimes XZ + ZW \otimes XY
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi XYZ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi XY
                  %mo ⊗
                  %msup
                    %mi Z
                    %mn 2
                  %mo +
                  %mi XZ
                  %mo ⊗
                  %mi YZ
                  %mo +
                  %mi XZ
                  %mo ⊗
                  %mi YZ
                  %mo +
                  %mi YZ
                  %mo ⊗
                  %msup
                    %mi Z
                    %mn 2
                  %mo +
                  %mi YZ
                  %mo ⊗
                  %mi XZ
                  %mo +
                  %msup
                    %mi Z
                    %mn 2
                  %mo ⊗
                  %mi XY
                %annotation{:encoding => "application/x-tex"}
                  \\Delta_{2,2}(XYZ^{2}) = XY \otimes Z^{2} + XZ \otimes YZ + XZ \otimes YZ + YZ \otimes Z^{2} + YZ \otimes XZ + Z^{2} \otimes XY
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo =
                  %mi XY
                  %mo ⊗
                  %msup
                    %mi Z
                    %mn 2
                  %mo +
                  %mn 2
                  %mi XZ
                  %mo ⊗
                  %mi YZ
                  %mo +
                  %mn 2
                  %mi YZ
                  %mo ⊗
                  %msup
                    %mi Z
                    %mn 2
                  %mo +
                  %msup
                    %mi Z
                    %mn 2
                  %mo ⊗
                  %mi XY
                %annotation{:encoding => "application/x-tex"}
                  \= XY \otimes Z^{2} + 2XZ \otimes YZ + 2YZ \otimes Z^{2} + Z^{2} \otimes XY
          %p
            The number of decomposition of a monomial of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mi p
                %annotation{:encoding => "application/x-tex"} n+p
            in one part of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and one part of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is equal to the number of choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            of the variables in the monomial amongst the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mi p
                %annotation{:encoding => "application/x-tex"} n+p
            which appear, thus
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mi n
                          %mo +
                          %mi p
                        %mi n
                      %mo )
                    %mo =
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mi p
                        %mo{:stretchy => "false"} )
                        %mo !
                      %mrow
                        %mi n
                        %mo !
                        %mi p
                        %mo !
                  %annotation{:encoding => "application/x-tex"} \binom{n+p}{n}=\frac{(n+p)!}{n!p!}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mi n
                          %mo +
                          %mi p
                        %mi n
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \binom{n+p}{n}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Δ
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi XYZW
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mn 2
                        %mo +
                        %mn 2
                      %mn 2
                    %mo )
                  %mi XYZW
                  %mo =
                  %mn 6
                  %mi XYZW
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{2,2}(\Delta_{2,2}(XYZW)) = \binom{2+2}{2}XYZW = 6XYZW
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Δ
                    %mrow
                      %mn 2
                      %mo ,
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi XYZ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mn 2
                        %mo +
                        %mn 2
                      %mn 2
                    %mo )
                  %msup
                    %mi XYZ
                    %mn 2
                  %mo =
                  %mn 6
                  %msup
                    %mi XYZ
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{2,2}(\Delta_{2,2}(XYZ^{2})) = \binom{2+2}{2}XYZ^{2} = 6XYZ^{2}
          %p
            The comultiplication can be expressed using the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hasse-Schmidt+derivative"} Hasse-Schmidt derivative
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∈
                  %msub
                    %mi R
                    %mrow
                      %mi m
                      %mo +
                      %mi n
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi X
                    %mi q
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} P \in R_{m+n}[X_{1},...,X_{q}]
            and a monic monomial
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                    %mo .
                    %mo .
                    %mo .
                    %msub
                      %mi Y
                      %mi p
                    %mo ∈
                    %msub
                      %mi R
                      %mi p
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi X
                      %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Y_{1}...Y_{p} \in R_{p}[X_{1},...,X_{q}]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            variables in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mo .
                    %mo .
                    %mo .
                    %mo ,
                    %msub
                      %mi X
                      %mi q
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{X_{1},...,X_{q}\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mrow
                      %msub
                        %mi Y
                        %mn 1
                      %mo .
                      %mo .
                      %mo .
                      %msub
                        %mi Y
                        %mi p
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D_{Y_{1}...Y_{p}}(P)
            is the number of way of extracting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Y
                    %mn 1
                  %mo .
                  %mo .
                  %mo .
                  %msub
                    %mi Y
                    %mi p
                %annotation{:encoding => "application/x-tex"} Y_{1}...Y_{p}
            from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi P
                      %mrow
                        %msub
                          %mi Y
                          %mn 1
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mi Y
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \frac{P}{Y_{1}...Y_{p}}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mn 1
                    %mo .
                    %mo .
                    %mo .
                    %msub
                      %mi Y
                      %mi p
                  %annotation{:encoding => "application/x-tex"} Y_{1}...Y_{p}
