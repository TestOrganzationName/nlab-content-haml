          %h2#Idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+logic"} formal logic
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/sequent+calculus"} sequent calculus
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
            %strong bunched logic
            is a logical
            %a.existingWikiWord{:href => "/nlab/show/theory"} theory
            in which the
            %a.existingWikiWord{:href => "/nlab/show/formulas"} formulas
            appearing in any
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            are not necessarily just a
            %a.existingWikiWord{:href => "/nlab/show/list"} list
            but have some additional structure, usually that of
            %a.existingWikiWord{:href => "/nlab/show/tree"} tree
            whose nodes are then the eponymous “bunches”:
          %p
            Where a classical
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            is traditionally presented as a comma-separated
            %a.existingWikiWord{:href => "/nlab/show/list"} list
            of
            %a.existingWikiWord{:href => "/nlab/show/propositions"} propositions
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} and/or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/types"} types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
