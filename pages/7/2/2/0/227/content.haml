                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine scheme
                  %a.existingWikiWord{:href => "/nlab/show/spectral+topological+space"} spectral topological space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ring+extension"}> ring extension
                ,
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimal+extension"} infinitesimal extension
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/nilradical"}> nilradical
                    ,
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/reduced+ring"} reduced ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pythagorean+ring"} Pythagorean ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/near-ring"} near-ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/module"}> module
                ,
                %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ring+setoid"} ring setoid
          %h2#References References
          %h3#ReferencesGeneral General
          %p Lecture notes:
          %ul
            %li
              Arno Fehm,
              %em Ringe
              (
              %a{:href => "http://www.math.uni-konstanz.de/~fehm/teaching/algebra/geyer2.pdf"}> pdf
              ) (in German)
          %p Textbook accounts:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frank+W.+Anderson"}> Frank W. Anderson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kent+R.+Fuller"} Kent R. Fuller
                = succeed "," do
                  %em Rings and Categories of Modules
                %strong 13
                Springer (1992) &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/978-1-4612-4418-9"}> doi:10.1007/978-1-4612-4418-9
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Edwin+Bland"}> Paul Edwin Bland
                ,
                = succeed "," do
                  %em Rings and Their Modules
                = succeed "," do
                  %a{:href => "https://doi.org/10.1515/9783110250237"} doi:10.1515/9783110250237
                = succeed "&rbrack;" do
                  %a{:href => "http://site.iugaza.edu.ps/mashker/files/%D9%85%D8%AD%D8%A7%D8%B6%D8%B1%D8%A7%D8%AA-%D8%AC%D8%A8%D8%B1-%D8%AF%D9%83%D8%AA%D9%88%D8%B1%D8%A7%D8%A9.pdf"} pdf
          %p#TTFormalizations
            Formalization in
            %a.existingWikiWord{:href => "/nlab/show/univalent+foundations+of+mathematics"} univalent foundations of mathematics
            (
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            with the
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
          %p
            in a context of plain
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Agda"} Agda
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Mart%C3%ADn+Escard%C3%B3"}> Martín Escardó
              ,
              = succeed "," do
                %em
                  %a{:href => "https://www.cs.bham.ac.uk/~mhe/HoTT-UF-in-Agda-Lecture-Notes/HoTT-UF-Agda.html#ring-sip"} Rings
              %em Introduction to Univalent Foundations of Mathematics with Agda
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1911.00580"}> arXiv:1911.00580
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://www.cs.bham.ac.uk/~mhe/HoTT-UF-in-Agda-Lecture-Notes/HoTT-UF-Agda.html"} webpage
          %p
            in a context of
            %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Agda"} Agda
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/1lab"}> 1lab
              \:
              %em
                %a{:href => "https://1lab.dev/Algebra.Ring.html"} Algebra.Ring
          %h3#ReferencesHistory History
          %p
            %a.existingWikiWord{:href => "/nlab/show/Richard+Dedekind"} Richard Dedekind
            had introduced the concept today called
            %em ring
            under the name
            %em Ordnung
            (Ger: order, as in
            = succeed ")." do
              %a{:href => "http://en.wikipedia.org/wiki/Order_%28biology%29"} taxonomic order
            %em Zahlring
            (Ger: number ring/ring of numbers) for this was introduced in section 9.31 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Hilbert"}> David Hilbert
              ,
              = succeed "," do
                %em Die Theorie der algebraischen Zahlkörper
          %p
            There, the word ring just appears with a footnote mentioning Dedekind’s use of the word “Ordnung”, no further motivation is given. So probably Hilbert meant to use “ring” as in “collection of things holding together”, not in the sense of circles or loops (as one might guess from the rings of
            %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_n
          %p The first abstract axiomatic description of rings is in
          %ul
            %li
              Adolf Fraenkel, Journal für die reine und angewandte Mathematik
              %strong 145
              (1914)
          %p which however contains some additional axioms not used anymore. The set of axioms in its modern form appears first in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Emmy+Noether"}> Emmy Noether
              ,
              = succeed "," do
                %em Ideal Theory in Rings
              %strong 83
              (1921)
          %p For historical accounts see
          %ul
            %li
              %p
                I. Kleiner,
                = succeed "," do
                  %em From numbers to rings: the early history of ring theory
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.5169/seals-3627"} web
            %li
              %p
                %em The development of ring theory
                (
                %a{:href => "http://www-history.mcs.st-and.ac.uk/HistTopics/Ring_theory.html"}> pdf
                )
