                        %mi V
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                        %mi V
                      %annotation{:encoding => "application/x-tex"}
                        V \otimes V \otimes V \overset{[-,-,-]}{\longrightarrow} V
            %p
              such that the following three
              %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
              hold, for all
              %a.existingWikiWord{:href => "/nlab/show/elements"} elements
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo ,
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} w,x,y,z \in V
            %ol
              %li
                %p
                  (
                  %strong> unitarity
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi w
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                        %mi z
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi w
                        %mo{:stretchy => "false"} ]
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %annotation{:encoding => "application/x-tex"}
                        \\big\langle [x,y,z],w \big\rangle
                        \\;=\;
                        \-\big\langle z, [x,y,w]\big\rangle
              %li
                %p
                  (
                  %strong> symmetry
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi w
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mo −
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟨
                        %mo{:stretchy => "false"} [
                        %mi z
                        %mo ,
                        %mi w
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi y
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} ⟩
                      %annotation{:encoding => "application/x-tex"}
                        \\big\langle [x,y,z],w \big\rangle
                        \\;=\;
                        \-\big\langle [z,w,x], y \big\rangle
              %li
                %p
                  (
                  %strong> fundamental identity
                  )
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                                %mi x
                                %mo ,
                                %mi y
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %mi v
                                %mo ,
                                %mi w
                                %mo ,
                                %mi z
                                %mo{:stretchy => "false"} ]
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                              %mtd
                                %mo =
                                %mphantom
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mspace{:width => "thickmathspace"}
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                                %mo{:stretchy => "false"} [
                                %mi x
                                %mo ,
                                %mi y
                                %mo ,
                                %mi v
                                %mo{:stretchy => "false"} ]
                                %mo ,
                                %mi w
                                %mo ,
                                %mi z
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                            %mtr
                              %mtd
                              %mtd
                                %mphantom
                                  %mrow
                                    %mo =
                                    %mspace{:width => "thickmathspace"}
                                %mo +
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                                %mi v
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %mi x
                                %mo ,
                                %mi y
                                %mo ,
                                %mi w
                                %mo{:stretchy => "false"} ]
                                %mo ,
                                %mi z
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                            %mtr
                              %mtd
                              %mtd
                                %mphantom
                                  %mrow
                                    %mo =
                                    %mspace{:width => "thickmathspace"}
                                %mo +
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                                %mi v
                                %mo ,
                                %mi w
                                %mo ,
                                %mo{:stretchy => "false"} [
                                %mi x
                                %mo ,
                                %mi y
                                %mo ,
                                %mi z
                                %mo{:stretchy => "false"} ]
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        \\big[x,y, [v,w,z]  \big]
                        \&amp;
                        \= \phantom{+}\;
                        \\big[  [x,y,v], w, z \big]
                        \\\
                        \&amp;
                        \\phantom{=\;} +
                        \\big[ v, [x,y, w] , z \big]
                        \\\
                        \&amp;
                        \\phantom{=\;} +
                        \\big[ v, w , [x,y, z ] \big]
                        \\end{aligned}
          %p
            In this generality, and under the name “generalized metric Lie 3-algebras”, this is due to
            = succeed "," do
              %a{:href => "#CherkisSaemann08"} Cherkis-Saemann 08, 41
            %a{:href => "#dMFFMER08"} dMFFMER 08, Def. 1
          %h2#properties Properties
          %h3#equivalence_to_metric_lie_representations Equivalence to metric Lie representations
          %p
            For the following, let the
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            be the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            and take all
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            involved to be
            %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+spaces"} finite-dimensional
          %p For definiteness, we make the following explicit:
          #ModulesOfMetricLieAlgebras.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representation"}> metric Lie representation
                )
            %p
              An
              %em orthogonal representation of a metric Lie algebra
              is
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/metric+Lie+algebra"} metric Lie algebra
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi g
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\big((\mathfrak{g},[-,-]), g \big)
              %li
                %p
                  a metric
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        (V,k)
                        \\,,
                %p
                  hence a non-degenerate real
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/inner+product+space"} inner product space
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/orthogonal+Lie+algebra"} orthogonal
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                        %mo ⊗
                        %mi V
                        %mover
                          %mo →
                          %mi ρ
                        %mi V
                      %annotation{:encoding => "application/x-tex"}
                        \\mathfrak{g} \otimes V \overset{\rho}{\to} V
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (V,k)
          #LinearDualsAndAdjuncts.num_remark
            %h6#remark Remark
            %p
              %strong (linear duals and adjuncts/transposition)
            %p
              Given an orthogonal representation of a metric Lie algebra as in Def.
              = succeed "," do
                %a.maruku-ref{:href => "#ModulesOfMetricLieAlgebras"}
              %a.existingWikiWord{:href => "/nlab/show/inner+products"} inner products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              exhibit these as
              %a.existingWikiWord{:href => "/nlab/show/self-dual+objects"} self-dual objects
              in the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              of
              %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+spaces"} finite-dimensional vector spaces
              (with respect to the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
            %p
              This means that by passsing to
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
              we may regard
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊗
                    %mi W
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Z
                  %annotation{:encoding => "application/x-tex"}
                    V \otimes W \overset{f}{\longrightarrow} Z
            %p equivalently as linear maps of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mover
                      %mo ⟶
                      %mover
                        %mi f
                        %mo ¯
                    %mi Z
                    %mo ⊗
                    %msup
                      %mi V
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    W \overset{\overline{f}}{\longrightarrow} Z \otimes V^\ast
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mo *
                  %annotation{:encoding => "application/x-tex"} V^\ast
              is the
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %p
              Once we choose a
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi v
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{v_i\}_{i \in \{1, \cdots, dim(V)\}}
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              has components
            #eq:ComponentsOfMetricOnV.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mrow
                        %mi i
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi i
                    %mo ,
                    %msub
                      %mi v
                      %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    k_{i j} \;\coloneqq\; k(v_i, v_j)
            %p
              this forming of adjuncts is equivalently the yoga of “raising and lowering of indices via the metric”. Similarly for a choice of
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi t
                      %mi a
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi a
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{t_a\}_{a \in \{1,\cdots, dim(\mathfrak{g})\}}
              for the Lie algebra, and the induced components
            #eq:ComponentsOfMetricOng.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi a
                        %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi a
                    %mo ,
                    %msub
                      %mi t
                      %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g_{a b} \;\coloneqq\; g(t_a, t_b) \,.
            %p
              Specifically, given the basis component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ρ
                      %mi a
                    %msup
                      %mrow
                      %mi i
                    %msub
                      %mrow
                      %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo ,
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} (\rho_a{}^{i}{}_j)_{a,i,j}
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie action
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                      %mo ⊗
                      %mi V
                      %mover
                        %mo ⟶
                        %mi ρ
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g} \otimes V \overset{\rho}{\longrightarrow} V
            #eq:ComponentsOfLieAction.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi a
                    %mo ,
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ρ
                      %mi a
                    %msup
                      %mrow
                      %mi i
                    %msub
                      %mrow
                      %mi j
                    %msub
                      %mi v
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\rho(t_a, v_i)
                    \\;\coloneqq\;
                    \\rho_a{}^{i}{}_j v_i
            %p
              we get the components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ˜
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo ,
                        %mi i
                        %mo ,
                        %mi j
                  %annotation{:encoding => "application/x-tex"} (\tilde \rho^a{}_{i j})_{a,i,j}
              of the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            #eq:AdjunctOfLieAction.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊗
                    %mi V
                    %mover
                      %mo ⟶
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ˜
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"}
                    V \otimes V \overset{ \tilde \rho }{\longrightarrow} \mathfrak{g}
            %p
              by contracting the original component
              %a.maruku-eqref{:href => "#eq:ComponentsOfLieAction"} (3)
              with the components
              %a.maruku-eqref{:href => "#eq:ComponentsOfMetricOnV"} (1)
              %a.maruku-eqref{:href => "#eq:ComponentsOfMetricOng"} (2)
              of the metric tensors:
            #eq:ComponentsOfAdjunctOfLieAction.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ˜
                      %mi a
                    %msub
                      %mrow
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo ,
                        %mi i
                        %mo ,
                        %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi g
                      %mrow
                        %mi l
                        %mi j
                    %msup
                      %mi k
                      %mrow
                        %mi a
                        %mi b
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ρ
                      %mi b
                    %msup
                      %mrow
                      %mi l
                    %msub
                      %mrow
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    (\tilde \rho^a{}_{i j})_{a,i,j}
                    \\;=\;
                    g_{l j} k^{a b} \, \rho_b{}^l{}_i
          #TrilinearMapInducedFromOrthogonalRepOfMetricLieAlgebra.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (trilinear map induced from
                %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representation"} metric Lie representation
                –
                = succeed ")" do
