          #M2Brane3AlgebrasEquivalentToMetricLieRepresentation.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/M2-brane+3-algebras"} M2-brane 3-algebras
                are equivalent to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/metric+Lie+representations"} metric Lie representations
            %p
              Given an orthogonal representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ⊗
                    %mi V
                    %mover
                      %mo →
                      %mi ρ
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \otimes V \overset{\rho}{\to} V
              of a metric Lie algebra as in Def.
              = succeed "," do
                %a.maruku-ref{:href => "#ModulesOfMetricLieAlgebras"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} [-,-,-]_\rho
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TrilinearMapInducedFromOrthogonalRepOfMetricLieAlgebra"}
              = succeed ")." do
                %a.maruku-ref{:href => "#AxiomsOnM2Brane3Algebra"}
            %p
              Hence this assignment defines a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              from
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of orthogonal representations of metric Lie algebras to
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of M2-brane 3-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mtext orthogonal representations
                          %mrow
                            %mtext metric Lie algebras
                        %mo }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %munderover
                      %mo ⟶
                      %mrow
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi ρ
                        %mspace{:width => "thickmathspace"}
                        %mo ↦
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi ρ
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mrow
                        %mo {
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mtext M2-brane
                          %mrow
                            %mtext 3-algebras
                        %mo }
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    {
                    {\text{orthogonal representations}}
                    \\atop
                    {\text{metric Lie algebras}}
                    }
                    \\right\}_{/\sim}
                    \\underoverset
                    {}
                    {
                    \\;\;\;\;
                    \\rho \;\mapsto\; [-,-,-]_\rho
                    \\;\;\;\;
                    }{\longrightarrow}
                    \\left\{
                    {
                    {\text{M2-brane}}
                    \\atop
                    {\text{3-algebras}}
                    }
                    \\right\}_{/\sim}
                    \\,.
            %p
              Moreover, restricted to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/faithful+representations"} faithful representations
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
