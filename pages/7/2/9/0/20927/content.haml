                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} x \in V
              are expanded as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≔
                      %msup
                        %mi x
                        %mi i
                      %msub
                        %mi v
                        %mi i
                    %annotation{:encoding => "application/x-tex"} x \coloneqq x^i v_i
              %a.maruku-eqref{:href => "#eq:DefiningEquationForD"} (6)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi D
