          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Hyland"}> Martin Hyland
                ,
                = succeed "," do
                  %em First Steps in Synthetic Domain Theory
                = succeed ")" do
                  %a{:href => "https://www.dpmms.cam.ac.uk/~jmeh1/Research/Oldpapers/synthetic91.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcelo+Fiore"} Marcelo Fiore
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gordon+Plotkin"} Gordon Plotkin
                = succeed "," do
                  %em An extension of models of Axiomatic Domain Theory to models of Synthetic Domain Theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/3-540-63172-0_36"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcelo+Fiore"} Marcelo Fiore
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Rosolini"} Giuseppe Rosolini
                = succeed "," do
                  %em The Category of Cpos From a Synthetic Viewpoint
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S1571-0661%2805%2980165-3"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcelo+Fiore"} Marcelo Fiore
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Rosolini"} Giuseppe Rosolini
                = succeed "," do
                  %em Two models of synthetic domain theory
