              %em not
              exhaust all nonabelian differential cocycles. This just means that not every differential class in this case does have a nice representative in the usual sense.
          %h3#InfGaugeTrafo 1-Morphisms: integration of infinitesimal gauge transformations
          %p
            The 1-
            %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
            s in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})(U)
            may be thought of as
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
          .num_defn
            %h6#definition_4 Definition
            %p
              Given a 1-morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})(X)
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^\bullet(U \times \Delta^1)
                    \\leftarrow
                    W(\mathfrak{g})
                    \:
                    A
            %p consider the unique decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mi U
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi vert
                    %mo :
                    %mo =
                    %mi λ
                    %mo ∧
                    %mi d
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A = A_U + ( A_{vert} := \lambda \wedge d t)  \; \;
                    \\,,
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi U
                  %annotation{:encoding => "application/x-tex"} A_U
              the horizonal differential form component and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %msup
                      %mi Δ
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} t : \Delta^1 = [0,1] \to \mathbb{R}
              the canonical coordinate.
            %p
              We call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              the
              %strong gauge parameter
              \. This is a function on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
