                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})(U)
              and any 1-form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              at one vertex, there is a unique lift to a 2-cell in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \exp(\mathfrak{g})_{conn}
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              that
