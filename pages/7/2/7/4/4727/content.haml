                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \tau_1 \exp(\mathfrak{g}) = \mathbf{B}G
          %h3#lie_2algebra_valued_forms Lie 2-algebra valued forms
          %ul
            %li
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra+valued+form"} Lie 2-algebra valued form
          %h3#ordinary_forms_and_the_de_rham_complex
            Ordinary
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \geq 1
            we have that
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} b^{n-1}\mathbb{R}
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
          .num_remark
            %h6#remark_7 Remark
            %p
              Notice that under addition of differential forms,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \exp(b^{n-1}\mathbb{R})_{conn}
              is over each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              an abelian
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %p
              Under the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ch
                      %mo •
                      %mo +
                    %mover
                      %munder
                        %mo →
                        %mi Ξ
                      %mover
                        %mo ←
                        %mi N
                    %mi sAb
                  %annotation{:encoding => "application/x-tex"} Ch_\bullet^+ \stackrel{\overset{N}{\leftarrow}}{\underset{\Xi}{\to}} sAb
              we may therefore identify
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} \exp(b^{n-1}\mathbb{R})_{conn}
              with a presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"} N \exp(b^{n-1}\mathbb{R})_{conn}
              of chain complexes.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The degreewise
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              of differential forms over simplices constitutes a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mo •
                    %mo :
                    %mi N
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi ℝ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %mo →
                    %mrow
                      %mo (
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi d
                            %mi dR
                      %msup
                        %mi Ω
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi d
                            %mi dR
                      %mi ⋯
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi d
                            %mi dR
                      %msup
                        %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^\bullet} :
                    N\exp(b^{n-1}\mathbb{R})_{conn}
                    \\to
                    \\left(
                    C^\infty(-, \mathbb{R})
                    \\stackrel{d_{dR}}{\to}
                    \\Omega^1(-)
                    \\stackrel{d_{dR}}{\to}
                    \\cdots
                    \\stackrel{d_{dR}}{\to}
                    \\Omega^n(-)
                    \\right)
                    \\,.
            %p that is a weak equivalence.
          %p
            This is shown at
            %a{:href => "http://ncatlab.org/nlab/show/circle+n-bundle+with+connection#U1FromLieIntegration"} circle n-bundle with connection – from Lie intgeration
            based on the discussion at
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Lie+infinity-groupoid#DifferentialCoefficientsOfLieInt"} ∞-Lie groupoid – Lie-integrated ∞-groups – differential coefficients
          %h3#supergravity_fields Supergravity fields
          %p
            What is called an “extended soft group manifold” in the literature on the
            %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fre+formulation+of+supergravity"} D'Auria-Fre formulation of supergravity
            is really precisely a collection of
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/supergravity+Lie+3-algebra"} supergravity Lie 3-algebra
            (for 11-dimensional
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            and
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
            are read off from “extded soft group manifolds” in this literature is – apart from this difference in terminology – precisely what is described above.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/groupoid+of+Lie-algebra+valued+forms"} groupoid of Lie-algebra valued forms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-groupoid+of+Lie+2-algebra+valued+forms"} 2-groupoid of Lie 2-algebra valued forms
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/3-groupoid+of+Lie+3-algebra+valued+forms"} 3-groupoid of Lie 3-algebra valued forms
            %li
              %p
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-groupoid of ∞-Lie-algebra valued forms
          %h2#references References
          %p
            The (obvious but conceptually important) observation that
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra-valued+1-forms"} Lie algebra-valued 1-forms
            regarded as morphisms of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mo ∧
                    %mn 1
                  %msup
                    %mi 𝔤
                    %mo *
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X) \leftarrow \wedge^1 \mathfrak{g}^* : A
            are equivalently morphisms of dg-algebras out of the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(X) \leftarrow W(\mathfrak{g}) : A
            and that one may think of as the identity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Id
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{g}) \leftarrow W(\mathfrak{g}) : Id
            as the
            %em
              universal
              = succeed "-connection" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            appears in early articles for instance highlighted on p. 15 of
          %ul
            %li
              Franz W. Kamber; Philippe Tondeur,
              %em Semisimplicial Weil algebras and characteristic classes for foliated bundles in Čech cohomology
              , Differential geometry (Proc. Sympos. Pure Math., Vol. XXVII, Stanford Univ., Stanford, Calif., 1973), Part 1, pp. 283–294. Amer. Math. Soc., Providence, R.I., (1975).
          %p
            following
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Eli+Cartan"} Eli Cartan
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            for more references).
          %p
            The (evident) generalization to Weil algebras of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
          %ul
            %li
              Hisham Sati, Urs Schreiber, Jim Staasheff,
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebra valued connections
              (
              %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#SSSI"}> web
              )
          %p
            but – somewhat implicitly – this construction appears earlier, notably in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D%27Auria-Fre+formulation+of+supergravity"} D'Auria-Fre formulation of supergravity
          %ul
            %li
              %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+an+%28%E2%88%9E%2C1%29-topos+--+references"}> differential cohomology in an (∞,1)-topos – references
              \:
              %a{:href => "http://ncatlab.org/schreiber/show/differential+cohomology+in+an+(%E2%88%9E%2C1)-topos+--+references#InfLieAlgValuedForms"} ∞-Lie algebra valued forms
          %p
            The structure of the formula
            %a.maruku-eqref{:href => "#eq:GaugeTrafo"} (2)
            for infinitesimal gauge transformations of higher forms is widely known in the literature on
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pietro+Fre"} Pietro Fre
              %em
                %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
              \.
          %p
            In this old book no
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            computations that are considered are easily seen to be precisely their
            = succeed "-incarnations." do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
          %p
            The authors use the term
            %em
              extended
              %a.existingWikiWord{:href => "/nlab/show/soft+group+manifold"} soft group manifold
            for what here we identify as an
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                    %mo →
                    %mi inn
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T X \to inn(\mathfrak{g})
          %p With this terminological translation understood, and observing that all their constructions straightforwardly generalize to more general dg-algebras than these authors conisder explicitly, we find that
          %ul
            %li
              %p
                our equation
                %a.maruku-eqref{:href => "#eq:ShiftedGaugeTrafo"} (1)
                for the possibly shifted gauge transformation is their equation I.3.136;
            %li
              %p
                our equation
                %a.maruku-eqref{:href => "#eq:GaugeTrafo"} (2)
                for the genuine gauge transfomation is their equation for
                %em horizontal
                or
                %a.existingWikiWord{:href => "/nlab/show/rheonomy"} rheonomic
                gauge transformations III.3.23 .
          %p
            In fact their full rheonomy constraint III.3.32 is essentialy the same horizontality constraint, but applied not just to the 1-simplex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^1
            %a.existingWikiWord{:href => "/nlab/show/supermanifold"} super simplex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi p
                  %annotation{:encoding => "application/x-tex"} \Delta^{1|p}
        .revisedby
