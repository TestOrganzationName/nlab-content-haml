            %h6#remark_4 Remark
            %p
              By the nature of the
              %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi d
                      %mrow
                        %mi d
                        %mi s
                    %msub
                      %mi A
                      %mi U
                    %mo =
                    %msub
                      %mi d
                      %mi U
                    %mi λ
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mo{:stretchy => "false"} [
                    %mi λ
                    %mo ∧
                    %mi A
                    %mo ∧
                    %mi A
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ⋯
                    %mo +
                    %msub
                      %mi ι
                      %mi s
                    %msub
                      %mi F
                      %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
