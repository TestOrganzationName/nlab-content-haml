                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{n+1}_{conn}(X,\mathbb{Z})
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
            %ol
              %li
                %p
                  of integral
                  %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
                  by differential
                  = succeed "-forms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
