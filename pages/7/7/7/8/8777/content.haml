              %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle n-group
              %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundles"} principal infinity-bundles
              (either, depending on perspective, by def.
              %a.maruku-ref{:href => "#FlatSmoothDeligneComplex"}
              or else, more intrinsically, by the very statement of prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CurvatureExactSequence"}
