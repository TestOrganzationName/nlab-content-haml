          %h4#the_dependent_curvature_type The dependent curvature type
          %p
            The universal curvature characteristic, def.
            = succeed "," do
              %a.maruku-ref{:href => "#UniversalCurvatureCharacteristic"}
            %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊢
                  %msub
                    %mi curv
                    %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo →
                  %msub
                    %mo ♭
                    %mi dR
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi G
