                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 2
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \colon X \to \flat_{dR} \mathbf{B}^2 G
            in this
            %a.existingWikiWord{:href => "/nlab/show/context"} context
            is
