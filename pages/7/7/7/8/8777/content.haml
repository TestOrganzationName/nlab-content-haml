                  for any such good open cover the
                  %a{:href => "&#268;ech+cohomology#CechComplex"} Cech complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msub
                          %mi A
                          %mo •
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\bullet((X,\{U_i\}),A_\bullet)
                  already computes Cech cohomology (i.e. there is no further need to form the
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  of Cech complexes over refinements of covers);
              %li
                %p
                  the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi Ch
                          %mo +
                        %mo{:stretchy => "false"} (
                        %mi Smooth
                        %mn 0
                        %mi Type
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Ch
                          %mo +
                      %annotation{:encoding => "application/x-tex"} C^\bullet((X,\{U_i\}),-) \colon Ch_+(Smooth0Type) \to Ch_+
                  preserves weak equivalences and fibrations.
            %p
              This means in particular that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                    %mo →
                    %msub
                      %mi Z
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet \to Y_\bullet \to Z_\bullet
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Ch
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi Smooth
                      %mn 0
                      %mi Type
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ch_+(Smooth0Type)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi Y
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi Z
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^\bullet((X,\{U_i\}), X_\bullet)
                    \\to
                    C^\bullet((X,\{U_i\}), Y_\bullet)
                    \\to
                    C^\bullet((X,\{U_i\}), Z_\bullet)
            %p
              is a homotopy fiber sequence of chain complexes, and therefore the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
              sit in the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+in+homology"} long exact sequence in homology
              of this sequence of chain complexes.
          #OrdinaryCohomologyFromCechCohomology.num_example
            %h6#example_5 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet = (\mathbf{B}^{n+1}\mathbb{Z})_\bullet
              as in example
              = succeed "," do
                %a.maruku-ref{:href => "#DeloopingsOfAbelianSheaf"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Cech
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi ℤ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^0_{Cech}(X, (\mathbf{B}^{n+1}\mathbb{Z})_\bullet)
                    \\simeq
                    H^{n+1}(X,\mathbb{Z})
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Similarly for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mo •
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} A_\bullet = (\flat \mathbf{B}^n U(1))_{\bullet}
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi Cech
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo ♭
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^0_{Cech}(X, (\flat\mathbf{B}^{n}U(1))_\bullet)
                    \\simeq
                    H^{n}(X,U(1))
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              = succeed "-coefficients." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
          #DeRhamTheorem.num_example
            %h6#example_6 Example
            %p
              Passing to
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              (e.g. via def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CechComplex"}
              %a.maruku-ref{:href => "#TheDeRhamResolutionOfConstantFunctions"}
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+theorem"} de Rham theorem
          %p We will have need to give names to truncations of the de Rham complex. One is this:
          #TruncatedDeRham.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Smooth
                    %mn 0
                    %mi Type
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^{\bullet \leq n} \in Ch_+(Smooth0Type)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Ω
                      %mrow
                        %mo •
                        %mo ≤
                        %mi n
                    %mo ≔
                    %mrow
                      %mo [
                      %mi ℝ
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mn 1
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %mi ⋯
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi n
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{\Omega}^{\bullet \leq n}
                    \\coloneqq
                    \\left[
                    \\mathbb{R}
                    \\stackrel{\mathbf{d}}{\to}
                    \\mathbf{\Omega}^1
                    \\stackrel{\mathbf{d}}{\to}
                    \\cdots
                    \\stackrel{\mathbf{d}}{\to}
                    \\mathbf{\Omega}^{n-1}
                    \\stackrel{\mathbf{d}}{\to}
                    \\mathbf{\Omega}^{n}
                    \\right]
            %p
              with all
              = succeed "-forms," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          #CohomologyWithCoefficientsInTruncatedDeRham.num_example
            %h6#example_7 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
              of the truncated de Rham complex in def.
              %a.maruku-ref{:href => "#TruncatedDeRham"}
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^n(X)/im(\mathbf{d})
          %h5#TheDeligneComplex The Deligne complex
          #TheSmoothDeligneComplex.num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              the
              %strong smooth Deligne complex
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Smooth
                    %mn 0
                    %mi Type
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}^n U(1)_{conn})_\bullet
                    \\in
                    Ch_+(Smooth0Type)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"} abelian sheaves
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo [
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi d
                          %mi log
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mn 1
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %mi ⋯
                      %mover
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi d
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Ω
                        %mi n
                      %mo ]
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}^n U(1)_{conn})_\bullet
                    \\;
                    \\coloneqq
                    \\;
                    \\left[
                    U(1) \stackrel{\mathbf{d} log}{\to}
                    \\mathbf{\Omega}^1
                    \\stackrel{\mathbf{d}}{\to}
                    \\cdots
                    \\stackrel{\mathbf{d}}{\to}
                    \\mathbf{\Omega}^n
                    \\right]
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and with the differentials as in def.
              %a.maruku-ref{:href => "#SheavesOfFormsAndDeRhamDifferential"}
              and example
              = succeed "." do
                %a.maruku-ref{:href => "#LogDiffInSmoothContext"}
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi conn
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msubsup
                      %mi H
                      %mi Cech
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^{n+1}_{conn}(X,\mathbb{Z})
                    \\coloneqq
                    H^0_{Cech}(X,(\mathbf{B}^n U(1)_{conn})_\bullet)
            %p
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
          #RModZResolutionOfU1DeligneComplex.num_remark
            %h6#remark_8 Remark
            %p
              By example
              %a.maruku-ref{:href => "#LogDiffInSmoothContext"}
              the obvious
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                          %mtd
                            %mo ↪
                          %mtd
                            %mi ℝ
                          %mtd
                            %mover
                              %mo →
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mn 1
                          %mtd
                            %mover
                              %mo →
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                          %mtd
                            %mi ⋯
                          %mtd
                            %mover
                              %mo →
                              %mstyle{:mathvariant => "bold"}
                                %mi d
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} /
