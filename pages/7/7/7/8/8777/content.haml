                            %mi 𝔾
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\flat \mathbf{B}\mathbb{G} &amp;\longrightarrow&amp; \ast &amp; = &amp; \{0\}
                    \\\
