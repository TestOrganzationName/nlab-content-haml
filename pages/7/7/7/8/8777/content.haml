                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Smooth
                    %mn 0
                    %mi Type
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} (
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo ,
                    %msub
                      %mi Ch
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ch_+(Smooth0Type)
                    \=
                    Ch_+(Sh(CartSp))
                    \=
                    Sh(CartSp,Ch_+)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              in the smooth sheaves of def.
              = succeed "," do
                %a.maruku-ref{:href => "#Smooth0Types"}
              %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              whose objects are
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              of
              %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"} abelian sheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} CartSp
            %p
              Regard this as equipped with the structure of a
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              induced by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+chain+complexes"} projective model structure on chain complexes
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              labeled as follows: a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi A
                      %mo •
                    %mo →
                    %msub
                      %mi B
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon A_\bullet \to B_\bullet
              is called
            %ul
              %li
                %p
                  a
