            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi State
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} {
                            %mo ⋆
                            %mo{:stretchy => "false"} }
                            %mo ,
                          %mtd
                            %mi ν
