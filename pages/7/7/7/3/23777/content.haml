                            %mi ω
                        %mtr
                          %mtd
                            %mi ∅
                            %mo ,
                          %mtd
                            %mtext otherwise
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{State}(E)(\omega, \nu) =
                    \\left\{
                    \\begin{array}{ll}
                    \\{\star\}, &amp; \nu \leq \omega\\
                    \\emptyset, &amp; \text{otherwise}
                    \\end{array}
                    \\right.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
