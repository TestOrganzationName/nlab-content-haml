                      %mrow
                        %mo{:stretchy => "false"} ‖
                        %mi f
                        %mo{:stretchy => "false"} ‖
                        %mo ≤
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \|f\| \leq 1
                  with respect to the operator norm,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
