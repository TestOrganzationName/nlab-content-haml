                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi π
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi f
                      %annotation{:encoding => "application/x-tex"}
                        f \circ \pi_{1}(e) =  \pi_{2}(e) \circ f
                %p
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
