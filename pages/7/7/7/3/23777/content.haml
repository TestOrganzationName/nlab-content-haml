          %h2#remark Remark
          %p
            This is a small subcollection of my (
            %a.existingWikiWord{:href => "/nlab/show/Tom+Mainiero"}> Tom Mainiero
            ‘s) personal notes on some functorial aspects of the
            %a.existingWikiWord{:href => "/nlab/show/Gelfand-Naimark-Segal+construction"} Gelfand-Naimark-Segal construction
            (GNS construction) that have been sitting around for a while. Please feel free to contribute! The ideas here underlie some of the constructs of
            = succeed ":" do
              %a{:href => "#Mainiero2019"} Homtools
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%C4%8Cech+methods"} Čech methods
          %h2#baby Baby’s first GNS functor
          %p
            For the purposes of this section,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a fixed a unital ring and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is a unital
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            will not appear explicitly in any of the discussion in this section (so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            could effectively just be thought of as a unital ring), we keep it around as the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is a finite-dimensional (semisimple)
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
          .num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo •
                  %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\bullet}
              denote the category with:
            %ul
              %li
                %p
                  objects given by
                  = succeed ":" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/pointed+module"}
                        pointed left
                        = succeed "-modules" do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
                                %mi Q
                              %annotation{:encoding => "application/x-tex"} Q
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo ,
                        %mi m
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (M,m)
                  of a left
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                  with an element
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi m
                          %mo ∈
                          %mi M
                        %annotation{:encoding => "application/x-tex"} m \in M
              %li
                %p morphisms given by point preserving intertwiners.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ⊙
                  %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\odot}
              is the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo •
                  %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\bullet}
              whose objects are
              %em cyclic
              pointed modules:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,m)
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mi m
                      %mo =
                      %mi M
                    %annotation{:encoding => "application/x-tex"} Q m = M
          %p
          .num_remark
            %h6 Remark
            %p
              For those that find the notion of a
              %a.existingWikiWord{:href => "/nlab/show/pointed+module"} pointed module
              somewhat awkward, note that:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo •
                  %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\bullet}
              is equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                        %mi Q
                      %mi Q
                      %mo{:stretchy => "false"} /
                      %msub
                        %mrow
                        %mi Q
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                    %annotation{:encoding => "application/x-tex"} {}_{Q}{Q}/{}_{Q}\mathbf{Mod}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi Q
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                  %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+modules"}
                  category of left
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
          %p
          #rem:mod_reflective.num_remark
            %h6 Remark
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ⊙
                  %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\odot}
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                        %mi Q
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Mod
                        %mo •
                    %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\bullet}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ⊙
                    %mo ⟶
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \colon {}_{Q}\mathbf{Mod}^{\odot} \longrightarrow {}_{Q}\mathbf{Mod}^{\bullet}
            %p is given by the “cyclification” functor:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Cyc
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo •
                    %mo ⟶
                    %msub
                      %mrow
                      %mi Q
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mo ⊙
                  %annotation{:encoding => "application/x-tex"}
                    \\mathsf{Cyc} \colon {}_{Q}\mathbf{Mod}^{\bullet} \longrightarrow {}_{Q}\mathbf{Mod}^{\odot}
            %p
              that acts on objects by assigning to any pointed module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,m)
              the cyclic pointed submodule generated by the orbit of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Cyc
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo ⋅
                    %mi m
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{Cyc} \colon (M,m) \to (Q \cdot m, m)
              and acts on morphisms by restriction to cyclic submodules.
          %p
          .num_defn
            %h6 Notation
            %p
              For any left
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi M
                  %annotation{:encoding => "application/x-tex"} m \in M
              as:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Ann
                      %mi Q
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi q
                    %mo ∈
                    %mi Q
                    %mo :
                    %mi q
                    %mo ⋅
                    %mi m
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Ann}_{Q}(m) \coloneqq \{ q \in Q : q \cdot m = 0 \}.
            %p
          %p
            The following lemma, which will become useful later, describes the structure of the hom-sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi Q
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\bullet}((M,m), (N,n))
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi m
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,m)
            is a cyclic pointed module.
          %p
          #lem:cyclic_thinness.num_lemma
            %h6 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,m)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N,n)
              be pointed
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,m)
              is cyclic. Then there exists a morphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,m)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (N,n)
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %msub
                        %mi{:mathvariant => "normal"} Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Ann}_{Q}(m) \subseteq \mathrm{Ann}_{Q}(n)
          .proof
            %h6 Proof
            %p
              This follows quickly from the fact that a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f: (M,m) \rightarrow (N,n)
              must satisfy
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi q
                    %mi n
                  %annotation{:encoding => "application/x-tex"} f(q m) =q n
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} q \in Q
          %p
            There is an immediate corollary of this Lemma:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi Q
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                    %mo ⊙
                %annotation{:encoding => "application/x-tex"} {}_{Q}\mathbf{Mod}^{\odot}
            is equivalent to the poset of left-ideals of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            (thought of as a category). This equivalence of categories is actually part of the restriction of a larger adjunction. We now spell out the definitions behind this claim.
          %p
          .num_defn
            %h6 Definition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}(Q)
              is the
              %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin category
              given by the poset of left ideals of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
            %ul
              %li
                %p
                  objects are left ideals of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Q
                        %annotation{:encoding => "application/x-tex"} Q
              %li
                %p
                  there is a unique morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                        %mover
                          %mo →
                          %mo !
                        %mi J
                      %annotation{:encoding => "application/x-tex"} I \overset{!}{\to} J
                  if and only if
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                          %mo ⊆
                          %mi J
                        %annotation{:encoding => "application/x-tex"} I \subseteq J
            %p
          %p
            The process of taking annihilators of distinguished points of left
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Ann
                    %mi Q
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mrow
                    %mi Q
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                    %mo •
                  %mo ⟶
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathsf{Ann}_{Q} \colon {}_{Q}\mathbf{Mod}^{\bullet} \longrightarrow \mathbf{L}(Q).
          %p Explicitly: it acts on objects by:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Ann
                    %mi Q
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi{:mathvariant => "normal"} Ann
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathsf{Ann}_{Q} \colon (M,m) \mapsto \mathrm{Ann}_{Q}(m),
          %p and its action on morphisms is deduced from the following straightforward remark.
          %p
          .num_remark
            %h6 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (M,m) \to (N,n)
              is a morphism of pointed modules, then
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ⋅
                      %mi n
                      %mo =
                      %mi q
                      %mo ⋅
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi q
                      %mo ⋅
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} q \cdot n = q \cdot f(m) = f(q \cdot m)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %msub
                        %mi{:mathvariant => "normal"} Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Ann}_{Q}(m) \subseteq \mathrm{Ann}_{Q}(n)
          %p
            Thus, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \colon (M,m) \to (N,n)
            a
            = succeed "-morphism," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mi Q
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathbf{Mod}^{\bullet}_{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Ann
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Ann
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Ann
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Ann}_{Q}(f) \colon \mathsf{Ann}_{Q}(m) \to \mathsf{Ann}_{Q}(n)
            as the unique
            = succeed "-morphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{L}(Q)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Ann
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo !
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Ann
                    %mi Q
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathsf{Ann}_{Q}(m) \overset{!}{\to} \mathsf{Ann}_{Q}(n)
            given by the inclusion of ideals
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Ann
                      %mi Q
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %msub
                      %mi{:mathvariant => "normal"} Ann
                      %mi Q
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Ann}_{Q}(m) \subseteq \mathrm{Ann}_{Q}(n)
          %p
            Alternatively, given any left-ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            of some
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} Q/I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mn 1
                      %mi Q
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %msub
                      %mn 1
                      %mi Q
                    %mo +
                    %mi I
                  %annotation{:encoding => "application/x-tex"} [1_{Q}] \coloneqq 1_{Q} + I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi Q
                %annotation{:encoding => "application/x-tex"} 1_{Q}
            is the identity of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo ⋅
                    %mo{:stretchy => "false"} [
                    %msub
                      %mn 1
                      %mi Q
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi Q
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} Q \cdot [1_{Q}] = Q/I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Q/I, [1])
            is
            = succeed "." do
              %em cyclic
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Quot
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mrow
                    %mi Q
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi Mod
                    %mo ⊙
                %annotation{:encoding => "application/x-tex"}
                  \\mathsf{Quot} \colon \mathbf{L}(Q) \longrightarrow {}_{Q}\mathbf{Mod}^{\odot}
          %p whose action on objects is as described above:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Quot
                  %mo{:lspace => "verythinmathspace"} :
                  %mi I
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi Q
