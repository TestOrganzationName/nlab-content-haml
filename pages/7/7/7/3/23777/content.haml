                        %mi Quot
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathsf{Quot}}_{Q} = \iota \circ \mathsf{Quot}_{Q}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              the inclusion functor of cyclic pointed modules into pointed modules.
          .proof
            %h6 Proof
            %p We will define a unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi L
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Ann
                      %mi Q
                    %mo ∘
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Quot
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \colon \mathrm{id}_{\mathbf{L}(Q)} \longrightarrow \mathsf{Ann}_{Q} \circ \mathsf{Quot}
            %p and counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Quot
                    %mo ∘
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Ann
                      %mi Q
                    %mo ⟶
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mrow
                        %msub
                          %mrow
                          %mi Q
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi Mod
                          %mo •
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon \colon \mathsf{Quot} \circ \mathsf{Ann}_{Q} \longrightarrow \mathrm{id}_{{}_{Q}\mathbf{Mod}^{\bullet}}.
            %p
              satisfying the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/triangle+identities"} triangle identities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is given by assigning the identity morphism to each object of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{L}(Q)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Ann
                        %mi Q
                      %mo ∘
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Quot
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Ann
                        %mi Q
                      %mrow
                        %mo [
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mo{:stretchy => "false"} /
                        %mi I
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                        %mo ]
                      %mo =
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \mathsf{Ann}_{Q} \circ \mathsf{Quot}(I) = \mathsf{Ann}_{Q} \left[(Q/I,[1]) \right] = I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              is a bit more interesting: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi M
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathsf{M} = (M,m)
              be a pointed-module and define
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Quot
                      %mo ∘
                      %msub
                        %mstyle{:mathvariant => "sans-serif"}
                          %mi Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi M
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi Q
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi{:mathvariant => "normal"} Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (K,k) \coloneqq \mathsf{Quot} \circ \mathsf{Ann}_{Q}(\mathsf{M}) = (Q/\mathrm{Ann}_{Q}(m),[1])
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi{:mathvariant => "normal"} Ann
                        %mi Q
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{Ann}_{Q}(k) = \mathrm{Ann}_{Q}(m)
              %a.maruku-ref{:href => "#lem:cyclic_thinness"}
              there is a unique morphism
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi K
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ,
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (K,k) \rightarrow (M,m)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϵ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi M
                          %mo ,
                          %mi m
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \epsilon_{(M,m)}
          %h3#connection_to_the_gns_construction Connection to the GNS construction
          %p
            The above observations are simple shadows of the functorality of the GNS construction for
            %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} C*-algebras
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebra"} W*-algebras
            %em opposite
            of the category of ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{L}(Q)
            can be thought of as a stand-in for the category of states (to every
            = succeed "-algebraic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi E
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \rho \colon E \to \mathbb{C}
            on a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^{\ast}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            we can associate the left ideal given by the “left kernel”
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi e
                    %mo ∈
                    %mi E
                    %mo :
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mo *
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{e \in E: \rho(e^{*} e) = 0 \}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi Quot
                %annotation{:encoding => "application/x-tex"} \mathsf{Quot}
            is a toy-model of the GNS construction.
          %h2#notationterminology Notation/Terminology
          %p
            In the following the letters
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ,
                  %mi F
                %annotation{:encoding => "application/x-tex"} E, F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            will denote
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \W^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi C
                %annotation{:encoding => "application/x-tex"} A, B, C
            will denote
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
          %p
            The term (normal) state will be taken to mean
            %em (normal) positive linear functional
            Note that this is at odds with some definitions in the physics literature, where “state” typically means “normalized” positive linear functional (if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi E
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} f(1_{E}) = 1
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi E
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} f: E \to \mathbb{C}
            a positive linear functional). Using the definition of “state” here, the zero map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo :
                  %mi E
                  %mo →
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} 0: E \to \mathbb{C}
            is a perfectly valid state.
          %h1#the_gns_construction_as_a_functor_on_a_fixed_calgebra
            The GNS construction as a functor on a fixed C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mo
                    %mo *
                %annotation{:encoding => "application/x-tex"} ^\ast
            \-algebra
          %p
            With an appropriate notion of a “category of states”, one can explore functorial properties of the GNS construction as in Arthur Parzygnat’s work (see
            %a{:href => "#Parzygnat2016"} Parzygnat2016
            and
            = succeed ")." do
              %a{:href => "#Parzygnat2018"} Parzygnat2018
          %p
            The construction here is from a slightly different perspective, using a mildly richer category of states based on the natural poset structure on the collection of (normal) states on a fixed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi W
                    %mo *
                %annotation{:encoding => "application/x-tex"} W^\ast
            or
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          %h2#the_category_of_normal_states_over_a_fixed_w_calgebra
            The category of (normal) states over a fixed (W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mo
                    %mo *
                %annotation{:encoding => "application/x-tex"} ^\ast
            ) C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mo
                    %mo *
                %annotation{:encoding => "application/x-tex"} ^\ast
            \-algebra.
          %p
            Begin by recalling a well-known posetal relation on the set of states
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext State(E)
                %annotation{:encoding => "application/x-tex"} \text{State(E)}
            on a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          .num_defn
            %h6 Definition
            %p
              For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo ∈
                      %mtext State
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f, g \in \text{State}(E)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≤
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \leq g
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo −
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f - g
              is a state, where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} -
              denotes pointwise subtraction; equivalently:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≤
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \leq g
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mo *
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mo *
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(e^\ast e) \leq g(e^\ast e)
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} e \in E
          %p It is a straightforward exercise to show this relation is posetal.
          %p
            The story for normal states in the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtext NState(A)
                %annotation{:encoding => "application/x-tex"} \text{NState(A)}
            denote the set of normal states on a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (a subset of
            = succeed ");" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext State
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \text{State}(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ,
                  %mi g
                  %mo ∈
                  %mtext NState(A)
                %annotation{:encoding => "application/x-tex"} f, g \in \text{NState(A)}
            we can define a relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ≤
                    %mtext norm
                %annotation{:encoding => "application/x-tex"} \leq_{\text{norm}}
            by:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %msub
                    %mo ≤
                    %mtext norm
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \leq_{\text{norm}} g
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo −
                  %mi g
                %annotation{:encoding => "application/x-tex"} f - g
            is a normal state. Because the space of linear functionals splits as an orthogonal sum into normal and singular parts, it follows immediately that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %msub
                    %mo ≤
                    %mtext norm
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \leq_{\text{norm}} g
            for normal linear functionals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≤
                    %mi g
                  %annotation{:encoding => "application/x-tex"} f \leq g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            when discussing states on
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          %p
          .num_remark
            %h6 Remark
            %p
              We can easily define weaker versions of the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
              that may also be of interest: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              positive linear functionals on a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
              algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≪
                  %annotation{:encoding => "application/x-tex"} \ll
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≲
                  %annotation{:encoding => "application/x-tex"} \lesssim
              in the following manner:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ≪
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \ll g
                  if there is an inclusion of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ker
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo ⊆
                          %msup
                            %mi ker
                            %mi L
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \ker^{L}(g) \subseteq \ker^{L}(f)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                      %annotation{:encoding => "application/x-tex"} h
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ker
                          %mi L
                        %mo{:stretchy => "false"} (
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} {
                        %mi e
                        %mo ∈
                        %mi E
                        %mo :
                        %mi h
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mo *
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\ker^{L}(h) \coloneqq \{e \in E: h(e^\ast e ) = 0 \}.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ≲
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \lesssim g
                  if there exists a
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ≥
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} C \geq 0
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mo *
                        %mi e
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mi C
                        %mi g
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mo *
                        %mi e
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(e^\ast e) \leq C g(e^\ast e)
                  for every
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi e
                          %mo ∈
                          %mi E
                        %annotation{:encoding => "application/x-tex"} e \in E
            %p We have the following immediate properties:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi f
                        %mo ≤
                        %mi g
                        %mo ⇒
                        %mi f
                        %mo ≲
                        %mi g
                        %mo ⇒
                        %mi f
                        %mo ≪
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \leq g \Rightarrow f \lesssim g \Rightarrow f \ll g
                  \.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ≤
                      %annotation{:encoding => "application/x-tex"} \leq
                  is a partial order as it is antisymmetric:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ≤
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \leq g
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ≤
                        %mi f
                      %annotation{:encoding => "application/x-tex"} g \leq f
                  if and only if
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo =
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f = g
            %p
              However, the weaker preorders
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≪
                  %annotation{:encoding => "application/x-tex"} \ll
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≲
                  %annotation{:encoding => "application/x-tex"} \lesssim
              do not satisfy antisymmetry: e.g.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi f
                    %mo ≲
                    %mi f
                  %annotation{:encoding => "application/x-tex"} 2 f \lesssim f
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ≲
                      %mn 2
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f \lesssim 2f
            %p
              Moreover, while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≲
                  %annotation{:encoding => "application/x-tex"} \lesssim
              is only a mild weakening of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                    %annotation{:encoding => "application/x-tex"} \leq
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≪
                  %annotation{:encoding => "application/x-tex"} \ll
              is vastly different. In particular, we will show there is a unique Radon-Nikodym derivative associated to every pair of functionals related by the preorders
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \leq
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≲
                    %annotation{:encoding => "application/x-tex"} \lesssim
              = succeed "," do
