                      %semantics
                        %mrow
                          %mi π
                        %annotation{:encoding => "application/x-tex"} \pi
              %li
                %p
                  morphisms given by contractive linear point-preserving intertwiners: a morphism from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℋ
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathcal{H}_{1}, v_{1}, \pi_1)
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℋ
                          %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %msub
                          %mi π
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathcal{H}_2, v_2, \pi_2)
