          %h3#in_a_category_with_zero_morphisms In a category with zero morphisms
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            be a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over
            %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
            (which is notably the case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
