                          %mn 1
                        %mo ,
                        %msub
                          %mi c
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi c
                      %mn 1
                    %mo ⊔
                    %msub
                      %mi c
                      %mn 2
                    %mo ⟶
                    %msub
                      %mi c
                      %mn 1
                    %mo ×
                    %msub
                      %mi c
                      %mn 2
