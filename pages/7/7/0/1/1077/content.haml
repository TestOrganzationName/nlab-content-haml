                %annotation{:encoding => "application/x-tex"} c_1 \sqcup c_2
            both exist.
          #TheCanonicalComparisonMorphism.num_defn
            %h6#definition Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mrow
