                  %mo →
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊕
                  %msub
                    %mi c
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c_1\oplus c_2,p_1:c_1\oplus c_2\to c_1,p_2:c_1\oplus c_2\to c_2,i_1:c_1\to c_1\oplus c_2,i_2:c_2\to c_1\oplus c_2)
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊕
                  %msub
                    %mi c
                    %mn 2
                  %mo ,
                  %msub
                    %mi p
                    %mn 1
                  %mo ,
                  %msub
                    %mi p
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c_1\oplus c_2,p_1,p_2)
            is a product tuple,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊕
                  %msub
                    %mi c
                    %mn 2
                  %mo ,
