          #Biproduct.num_defn
            %h6#definition_2 Definition
            %p
              If the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                        %mo ,
                        %msub
                          %mi c
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} r_{c_1,c_2}
              in def.
              = succeed "," do
                %a.maruku-ref{:href => "#TheCanonicalComparisonMorphism"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ×
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1 \times c_2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ⊔
                    %msub
                      %mi c
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} c_1 \sqcup c_2
              are called
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              %strong biproduct
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} c_1
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} c_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo ⊕
                      %msub
                        %mi c
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} c_1 \oplus c_2
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              (which is often an example).
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                        %mo ,
                        %msub
                          %mi c
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} r_{c_1,c_2}
              is an isomorphism for all objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo ,
                    %msub
                      %mi c
                      %mn 2
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} c_1, c_2 \in \mathcal{C}
              and hence a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    r \;\colon\; (-)\sqcup (-) \stackrel{\simeq}{\longrightarrow} (-) \times (-)
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is called a
              = succeed "." do
                %a{:href => "#SemiadditiveCategories"} semiadditive category
          .num_remark
            %h6#remark Remark
            %p
              Definition
              %a.maruku-ref{:href => "#Biproduct"}
              has a straightforward generalization to biproducts of any number of objects (although this requires extra structure on the category in
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
              if the set indexing these objects might not have
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/decidable+equality"} decidable equality
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              is the biproduct of no objects.
          %h3#pointfree_definition Point-free definition
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an arbitrary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
          %p
            The
            %strong biproduct
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                %annotation{:encoding => "application/x-tex"} c_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 2
                %annotation{:encoding => "application/x-tex"} c_2
            is a
            %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊕
                  %msub
                    %mi c
                    %mn 2
                  %mo ,
