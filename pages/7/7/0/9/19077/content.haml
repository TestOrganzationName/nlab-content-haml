          %h2#harmonic_quadruples Harmonic quadruples
          %p
            A quadruple of points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,B,C,D)
            is called
            %a.existingWikiWord{:href => "/nlab/show/harmonic+ratio"} harmonic
            if the cross-ratio
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
