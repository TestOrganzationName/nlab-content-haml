          %h2#idea Idea
          %p
            A
            %em duoidal category
            is a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with two
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal structures
            which
            %a.existingWikiWord{:href => "/nlab/show/interchange+law"} interchange
            laxly.
          %h2#definition Definition
          %h3#duoidal_categories_2 Duoidal categories
          %p
            A
            = succeed "," do
              %strong duoidal category
            = succeed "," do
              %strong 2-monoidal category
            %a.existingWikiWord{:href => "/nlab/show/pseudomonoid"} pseudomonoid
            in the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MonCat
                    %mi l
                %annotation{:encoding => "application/x-tex"} MonCat_l
            of
            %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functors"} lax monoidal functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ⋄
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\diamond,I)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⋆
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\star,J)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mo :
                  %mi C
                  %mo ×
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \star:C\times C\to C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo :
                  %mn 1
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} J:1\to C
            are
            %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functors"} lax monoidal functors
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ⋄
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\diamond,I)
            and the
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
            axioms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⋄
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\diamond,I)
            are
            %a.existingWikiWord{:href => "/nlab/show/monoidal+natural+transformations"} monoidal natural transformations
            with respect to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo ⋄
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\diamond,I)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            consists of
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⋆
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ⋄
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ⋆
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⋄
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ⋄
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A\star B) \diamond (C\star D) \to (A\diamond C) \star (B\diamond D)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo →
                  %mi I
                  %mo ⋆
                  %mi I
                %annotation{:encoding => "application/x-tex"} I\to I\star I
          %p
            while the laxity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            consists of transformations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo ⋄
                  %mi J
                  %mo →
                  %mi J
                %annotation{:encoding => "application/x-tex"} J\diamond J \to J
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo →
                  %mi J
                  %mo .
                %annotation{:encoding => "application/x-tex"} I \to J.
          %p
            There are then various axioms, which in particular say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
          %p
            It is equivalent to ask that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⋄
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\diamond,I)
            is a pseudomonoid structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⋆
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\star,J)
            in the 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi MonCat
                    %mi c
                %annotation{:encoding => "application/x-tex"} MonCat_c
            of monoidal categories and
            %em colax
            monoidal functors.
          %p
            The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo →
                  %mi J
                %annotation{:encoding => "application/x-tex"} I\to J
            can be shown to be equal to the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mover
                    %mo →
                    %mo ≅
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo ⋆
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ⋄
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ⋆
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi J
                  %mo ⋄
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ⋄
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ≅
                  %mi J
                %annotation{:encoding => "application/x-tex"} I \xrightarrow{\cong} (J\star I)\diamond (I\star J) \to (J\diamond I) \star (I\diamond J) \xrightarrow{\cong} J
          %p
            as well as the dual composite. If this map is an isomorphism, the duoidal category is called
            = succeed "." do
              %strong normal
          %h3#duoidal_functors Duoidal functors
          %p
            There are three natural kinds of functors between duoidal categories, which are compatibly lax or colax with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
          %h3#virtual_duoidal_categories Virtual duoidal categories
          %p
            A
            %strong virtual duoidal category
            is a pseudomonoid in the 2-category of
            %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            (called
            %strong monoidal multicategories
            in Appendix B of
            = succeed ")." do
              %a{:href => "#FrancoVasilakopoulou"} López Franco &amp; Vasilakopoulou
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ⋆
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\star,J)
            = succeed "-monoidal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representable+multicategory"} representable multicategory
          %p
            In particular, note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            in a virtual duoidal category is a functor of multicategories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} 1\to C
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            in the multicategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi J
                  %annotation{:encoding => "application/x-tex"} ()\to J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            %strong normal
            if this map exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            as a unit object for the multicategory structure.
          %p Nearly all the definitions given below for duoidal categories (except for coduoids and colax/colax functors) make sense just as well for virtual ones.
          %h3#produoidal_categories Produoidal categories
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/produoidal+category"} produoidal category
            is a pair of pseudomonoids that interchange laxly (a
            = succeed ")" do
              %em duoidale
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctors
            %a.existingWikiWord{:href => "/nlab/show/promonoidal+category"} promonoidal categories
            are the profunctorial analogue of monoidal categories.
          %h2#examples Examples
          %ul
            %li
              %p
                Any
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
                can be made into a (normal) duoidal category in which the two monoidal structures agree. The interchange transformation is built out of the braiding. Indeed, by the Eckmann-Hilton argument, a duoidal category whose above structure transformations are invertible necessarily arises in this way (up to equivalence).
            %li
              %p
                Similarly but somewhat more generally, an 2-monoidal category, as a special case of
                %a.existingWikiWord{:href => "/nlab/show/iterated+monoidal+category"} iterated monoidal category
                (in the sense of Balteanu, Fiedorowicz, Schwänzl, and Vogt), is a duoidal category. More precisely, 2-monoidal categories are the duoidal categories such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
                are
                %em normal
                lax monoidal functors, meaning concretely that the morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo →
                      %mi I
                      %mo ⋆
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I\to I\star I
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo →
                      %mi J
                    %annotation{:encoding => "application/x-tex"} I\to J
                are isomorphisms.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mo ⋄
                      %mo ,
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (C,\diamond,I)
                is a monoidal category with
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal structure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mo ⋆
                      %mo ,
                      %mi J
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (C,\star,J)
                is a monoidal category with finite coproducts, then it becomes duoidal with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \diamond
                the cocartesian monoidal structure.
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                are monoidal categories, with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                small and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                cocomplete and closed, then the functor category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [A,B]
                is duoidal with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                the pointwise tensor product,
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⋆
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi Y
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X\star Y)(a) = X(a) \otimes Y(a)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \diamond
                the
                %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
                tensor product.
            %li
              %p
                In particular, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a monoid (in Set) and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                a cocomplete closed monoidal category, then the category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mi A
                    %annotation{:encoding => "application/x-tex"} B^A
                of “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                \-graded objects of
                = succeed "\u201D" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                the pointwise (or “Hadamard”) product and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \diamond
                the “Cauchy” product,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⋄
                        %mi Y
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi c
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi a
                            %mo +
                            %mi b
                            %mo =
                            %mi c
                        %msub
                          %mi X
                          %mi a
                        %mo ⊗
                        %msub
                          %mi Y
                          %mi b
                      %annotation{:encoding => "application/x-tex"} (X\diamond Y)_c = \sum_{a+b=c} X_a \otimes Y_b
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+category"} pointed
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/split+mono"} split mono
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi B
                        %mi A
                    %annotation{:encoding => "application/x-tex"} B^A
                a different duoidal structure with the roles of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \diamond
                switched.
            %li
              %p
                Similarly, the category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi core
                      %mo{:stretchy => "false"} (
                      %mi FinSet
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Vect
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [core(FinSet),Vect]
                of vector
                %a.existingWikiWord{:href => "/nlab/show/species"} species
                has both a “Hadamard product”
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ⋄
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p\diamond q)(I) = p(I) \otimes q(I)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ⋆
                        %mi q
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                          %mrow
                            %mi I
                            %mo =
                            %mi S
                            %mo ⊔
                            %mi T
                        %mi p
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi q
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p\star q)(I) = \bigoplus_{I = S\sqcup T} p(S) \otimes q(T)
            %li
              %p
                The category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FF
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} FF(C)
                of
                %a.existingWikiWord{:href => "/nlab/show/functorial+factorizations"} functorial factorizations
                on a category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a duoidal category. The
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                product of functorial factorizations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} F'
                is obtained by
                = succeed "-factoring" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                = succeed "-factoring" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} F'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \diamond
                product is obtained by
                = succeed "-factoring" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                = succeed "-factoring" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} F'
                %em second
                factor.
            %li
              %p
                The category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi V
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} C=[V,V]
                of endofunctors of a closed symmetric monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is
                %em virtually
                duoidal, with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                being functor composition the multicategory structure being “the one that would be represented by Day convolution if it existed”. That is, a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi H
                    %annotation{:encoding => "application/x-tex"} (F,G) \to H
                is a natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ⊗
                      %mi G
                      %mo →
                      %mi H
                      %mo ∘
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} F\otimes G \to H\circ \otimes
                between functors
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ×
                        %mi V
                        %mo →
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V\times V \to V
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                can’t in general be expected to have
                = succeed "-sized" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                is monoidally
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi End
                        %mi κ
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} End_\kappa(V)
                of
                = succeed "-accessible" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi End
                        %mi κ
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi V
                        %mi κ
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} End_\kappa(V) \simeq [V_\kappa,V]
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi κ
                    %annotation{:encoding => "application/x-tex"} V_\kappa
                is the essentially small subcategory of
                = succeed "-presentable" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} V=Set
                then this (virtual) duoidal structure is normal with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mi J
                    %annotation{:encoding => "application/x-tex"} I=J
                being the identity functor, but for general
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                it need not be normal.
            %li
              %p
                As special case of the preceding when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} V=Set
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                        %mo =
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \kappa=\omega
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi FinSet
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [FinSet,Set]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Set
                      %mo ,
                      %mi Set
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi f
                    %annotation{:encoding => "application/x-tex"} [Set,Set]_f
                of
                %span.newWikiWord
                  finitary endofunctors
                  %a{:href => "/nlab/new/finitary+endofunctors"} ?
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⋆
                      %annotation{:encoding => "application/x-tex"} \star
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \diamond
                by convolution with the monoidal structure of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FinSet
                      %annotation{:encoding => "application/x-tex"} FinSet
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi FinSet
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [FinSet,Set]
                duoidal.
            %li
              %p
                More generally, instead of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi End
                        %mi κ
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi V
                        %mi κ
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} End_\kappa(V) = [V_\kappa,V]
                we can consider any category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi V
                      %mo ′
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [V',V]
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} V'
                is a small monoidal subcategory of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                as long as the category of functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V\to V
                that are left Kan extended from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} V'
                is closed under composition. For instance, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is a monoidal category and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi A
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} V=[A^{op},Set]
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ′
                        %mo =
                        %mi A
                      %annotation{:encoding => "application/x-tex"} V'=A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi V
                      %mo ′
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi Prof
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [V',V] \simeq Prof(A,A)
                is the category of endo-profunctors of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %a.existingWikiWord{:href => "/nlab/show/proarrow+equipment"} proarrow equipment
                is duoidal by a similar construction:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
                is proarrow composition and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋄
                    %annotation{:encoding => "application/x-tex"} \diamond
                is convolution with the monoidal structure on both sides.
            %li
              %p
                We can do something similar for
                %a.existingWikiWord{:href => "/nlab/show/generalized+operads"} generalized operads
                with respect to any
                %a.existingWikiWord{:href => "/nlab/show/monoidal+monad"} monoidal
                %a.existingWikiWord{:href => "/nlab/show/pseudomonad"} pseudomonad
                on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/collections"} collections
          %h2#structures_in_duoidal_categories Structures in duoidal categories
          %h3#bimonoids_bicomonoids_and_duoids Bimonoids, bicomonoids, and duoids
          %p
            In a duoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mon
                    %mo ⋄
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mon_\diamond(C)
            of
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            objects with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋄
                %annotation{:encoding => "application/x-tex"} \diamond
            is again a monoidal category under the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            product. Specifically, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are
            = succeed "-monoids," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⋆
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\star B
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⋆
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ⋄
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⋆
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⋄
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ⋄
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo ⋆
                  %mi B
                  %mo .
                %annotation{:encoding => "application/x-tex"} (A\star B) \diamond (A\star B) \to (A\diamond A) \star (B\diamond B) \to A\star B.
          %p
            We define a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/bimonoid"} bimonoid
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to be a
            %a.existingWikiWord{:href => "/nlab/show/comonoid"} comonoid
            in the monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Mon
                      %mo ⋄
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Mon_\diamond(C),\star)
            = succeed "-monoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            = succeed "-comonoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
          %p
            Of course, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided
            %a.existingWikiWord{:href => "/nlab/show/bimonoid"} bimonoid
            in a braided monoidal category.
          %p
            A nontrivially duoidal example is that a bimonoid with respect to the duoidal structure on functorial factorizations described above is precisely an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+weak+factorization+system"} algebraic weak factorization system
          %p
            Similarly, a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/duoid"} duoid
            is defined to be a
            = succeed "-monoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Mon
                    %mo ⋄
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ⋆
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Mon_\diamond(C),\star)
            of
            = succeed "-monoids," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            %em coduoid
            is a
            = succeed "-comonoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            = succeed "-comonoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            are equivalently duoidal functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} 1\to C
            of the three possible kinds (see above).
          %h3#rings_and_nearrings Rings and near-rings
          %p
            We can define
            %a.existingWikiWord{:href => "/nlab/show/near-rig"} (near-)
            %a.existingWikiWord{:href => "/nlab/show/rigs"} rigs
            and near-
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            in a duoidal category, where the additive and multiplicative monoidal structures are expressed with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋄
                %annotation{:encoding => "application/x-tex"} \diamond
            respectively. Since the distributive law requires duplication of variables, we need the additive monoidal structure to actually be a
            %a.existingWikiWord{:href => "/nlab/show/bimonoid"} bimonoid
            (or a
            %a.existingWikiWord{:href => "/nlab/show/Hopf+monoid"} Hopf monoid
            in the case of a ring), and hence that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            is (on its own) braided.
          %p
            More precisely, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a duoidal category such that the tensor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            is braided (and probably some compatibility holds between the braiding and the duoidal structure). A
            %strong near-rig
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            together with
          %ul
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/bimonoid"} bimonoid
                structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                with respect to the braided monoidal category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mo ⋆
                        %mo ,
                        %mi J
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (C,\star,J)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi add
                      %mo :
                      %mi R
                      %mo ⋆
                      %mi R
                      %mo →
                      %mi R
                    %annotation{:encoding => "application/x-tex"} add:R\star R \to R
                and “coaddition”
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo :
                        %mi R
                        %mo →
                        %mi R
                        %mo ⋆
                        %mi R
                      %annotation{:encoding => "application/x-tex"} \Delta:R\to R\star R
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
                structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                with respect to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mo ⋄
                        %mo ,
                        %mi I
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (C,\diamond,I))
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi mult
                        %mo :
                        %mi R
                        %mo ⋄
                        %mi R
                        %mo →
                        %mi R
                      %annotation{:encoding => "application/x-tex"} mult : R \diamond R \to R
            %li
              %p The following diagram commutes, expressing right distributivity:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi R
                              %mo ⋆
                              %mi R
                              %mo{:stretchy => "false"} )
                              %mo ⋄
                              %mi R
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mi add
                                  %mo ⋄
                                  %mi id
                            %mtd
                              %mi R
                              %mo ⋄
                              %mi R
                            %mtd
                              %mover
                                %mo →
                                %mi mult
                            %mtd
                              %mi R
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %mi id
                                  %mo ⋄
                                  %mi Δ
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mi add
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi R
                              %mo ⋆
                              %mi R
                              %mo{:stretchy => "false"} )
                              %mo ⋄
                              %mo{:stretchy => "false"} (
                              %mi R
                              %mo ⋆
                              %mi R
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi R
                              %mo ⋄
                              %mi R
                              %mo{:stretchy => "false"} )
                              %mo ⋆
                              %mo{:stretchy => "false"} (
                              %mi R
                              %mo ⋄
                              %mi R
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mi mult
                                  %mo ⋆
                                  %mi mult
                            %mtd
                              %mi R
                              %mo ⋆
                              %mi R
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (R\star R) \diamond R &amp; \xrightarrow{add\diamond id} &amp;
                      R\diamond R &amp; \xrightarrow{mult} &amp;
                      R\\
                      ^{id \diamond \Delta}\downarrow &amp; &amp; &amp; &amp;
                      \\uparrow^{add}\\
                      (R\star R) \diamond (R\star R) &amp;\to &amp;
                      (R\diamond R) \star (R\diamond R) &amp; \xrightarrow{mult \star mult} &amp;
                      R\star R
                      }
            %li
              %p The following diagram commutes, expressing right absorption:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi R
                            %mtd
                              %mover
                                %mo →
                                %mi ϵ
                            %mtd
                              %mi J
                            %mtd
                              %mover
                                %mo →
                                %mn 0
                            %mtd
                              %mi R
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mo ≅
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mi mult
                          %mtr
                            %mtd
                              %mi I
                              %mo ⋄
                              %mi R
                            %mtd
                              %mo →
                            %mtd
                              %mi J
                              %mo ⋄
                              %mi R
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mn 0
                                  %mo ⋄
                                  %mi id
                            %mtd
                              %mi R
                              %mo ⋄
                              %mi R
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      R &amp; \xrightarrow{\epsilon} &amp;
                      J &amp; \xrightarrow{0} &amp;
                      R\\
                      ^\cong\downarrow &amp; &amp; &amp; &amp; \uparrow^{mult} \\
                      I\diamond R &amp; \to &amp;
                      J \diamond R &amp; \xrightarrow{0\diamond id} &amp;
                      R\diamond R
                      }
          %p
            It is a
            %strong near-ring
            if the additive bimonoid structure is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hopf+monoid"} Hopf monoid
            %strong rig
            or
            %strong ring
            if the left distributive law and left absorption also hold.
          %p
            Of course, this all makes sense in particular in a braided monoidal category regarded as duoidal. In particular, in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
          %p
            One can show that for near-rings, cocommutativity is automatic, in which case the Hopf monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mi add
                  %mo ,
                  %mi Δ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (R,add,\Delta)
            can equivalently be regarded as a Hopf monoid in the
            %em cartesian
            monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CComon
                    %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CComon_\star(C)
            of cocommutative comonoids in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ⋆
                    %mo ,
                    %mi J
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C, \star, J)
            %a.existingWikiWord{:href => "/nlab/show/colax-distributive+rig+category"} colax-distributive rig category
            induced by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋄
                %annotation{:encoding => "application/x-tex"} \diamond
            and the cartesian structure of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CComon
                      %mo ⋆
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CComon_\star(C)
          %h3#strong_and_commutative_monoids Strong and commutative monoids
          %p
            Note that the constraints
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                  %mo ⋄
                  %mi J
                  %mo →
                  %mi J
                %annotation{:encoding => "application/x-tex"} J\diamond J\to J
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo →
                  %mi J
                %annotation{:encoding => "application/x-tex"} I\to J
            make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            into a
            = succeed "-monoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            = succeed "-comonoid)." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            = succeed "-monoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            = succeed "-monoidal," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            = succeed "-monoidal," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ⋆
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ⋄
                  %mi A
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ⋆
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo ⋄
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⋆
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ⋄
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ⋄
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi M
                  %mo ⋆
                  %mi N
                  %mo .
                %annotation{:encoding => "application/x-tex"} (M\star N) \diamond A \to (M\star N) \diamond (A\star A) \to (M\diamond A) \star (N\diamond A) \to M\star N.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            admits reflexive coequalizers preserved in each variable by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            = succeed "-bimodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo ⋄
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,\diamond)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋄
                %annotation{:encoding => "application/x-tex"} \diamond
            the usual tensor product of bimodules. (In the absence of such coequalizers, this category is virtually duoidal.)
          %p
            We define a
            %strong
              bistrong
              = succeed "-monoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
            in a duoidal category to be a
            = succeed "-monoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            = succeed "-bimodules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/tensorial+strength"} tensorial strength
            %em normal
            duoidal category, every object is uniquely a
            = succeed "-bimodule," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            = succeed "-monoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            = succeed "-bimodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo ,
                    %mo ⋄
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (J,\diamond)
          %p
            If the monoidal structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋄
                %annotation{:encoding => "application/x-tex"} \diamond
            is
            %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided
            (compatibly with
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            %strong
              strong
              = succeed "-monoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⋆
                    %annotation{:encoding => "application/x-tex"} \star
            to be a bistrong one whose
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋄
                  %annotation{:encoding => "application/x-tex"} \diamond
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            be arbitrary objects and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            a (bi)strong
            = succeed "-monoid." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mi S
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \sigma:S\to M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo :
                  %mi T
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \tau:T\to M
            be morphisms
            %strong commute
            if the following diagram commutes:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi T
                          %mo ⋄
                          %mi S
                        %mtd
                          %mover
                            %mo →
                            %mo ≅
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo ⋆
                          %mi J
                          %mo{:stretchy => "false"} )
                          %mo ⋄
                          %mo{:stretchy => "false"} (
                          %mi J
                          %mo ⋆
                          %mi S
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo ⋄
                          %mi J
                          %mo{:stretchy => "false"} )
                          %mo ⋆
                          %mo{:stretchy => "false"} (
                          %mi J
                          %mo ⋄
                          %mi S
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mo ≅
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %mi τ
                              %mo ⋆
                              %mi σ
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi J
                          %mo ⋆
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ⋄
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo ⋆
                          %mi J
                          %mo{:stretchy => "false"} )
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi M
                          %mo ⋆
                          %mi M
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mi mult
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi J
                          %mo ⋄
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo ⋆
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo ⋄
                          %mi J
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi σ
                              %mo ⋆
                              %mi τ
                        %mtd
                          %mi M
                          %mo ⋆
                          %mi M
                        %mtd
                          %mover
                            %mo →
                            %mi mult
                        %mtd
                          %mi M
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  T\diamond S &amp; \xrightarrow{\cong} &amp;
                  (T\star J) \diamond (J \star S) &amp; \to &amp;
                  (T\diamond J) \star (J\diamond S) \\
                  ^\cong\downarrow  &amp;&amp;&amp;&amp; \downarrow^{\tau \star \sigma}\\
                  (J\star T) \diamond (S \star J) &amp;&amp;&amp;&amp; M\star M\\
                  \\downarrow &amp;&amp;&amp;&amp; \downarrow^{mult}\\
                  (J\diamond S) \star (T\diamond J) &amp; \xrightarrow{\sigma \star \tau} &amp;
                  M\star M &amp; \xrightarrow{mult} &amp; M.
                  }
          %p
            We say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is
            %strong commutative
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi M
                %annotation{:encoding => "application/x-tex"} id_M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi M
                %annotation{:encoding => "application/x-tex"} id_M
            commute.
          %p
            In a braided monoidal category regarded as a normal duoidal one, this reduces to the usual notion of
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
            object. On the other hand, in the endofunctor-like examples above, it results in the notion of
            %a.existingWikiWord{:href => "/nlab/show/commutative+monad"} commutative monad
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+theory"} commutative theory
          %h2#relation_to_intercategories Relation to intercategories
          %p
            A duoidal category is the same as an
            %a.existingWikiWord{:href => "/nlab/show/intercategory"} intercategory
            with one object and only identity horizontal arrows, vertical arrows, horizontal cells, and vertical cells. The objects of the duoidal category are the basic cells of the intercategory, and its morphisms are the cubes. Like duoidal categories, intercategories support three (but not four) different kinds of morphism.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/distributivity+for+monoidal+structures"} distributivity for monoidal structures
            %li
              %a.existingWikiWord{:href => "/nlab/show/intercategory"} intercategory
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcelo+Aguiar"}> Marcelo Aguiar
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Swapneel+Mahajan"} Swapneel Mahajan
                = succeed "," do
                  %em Monoidal Functors, Species and Hopf Algebras
                = succeed "." do
                  %a{:href => "http://www.math.iitb.ac.in/~swapneel/aguiar.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "," do
                  %em Understanding the small object argument
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/0712.0724"} arXiv
                %a.existingWikiWord{:href => "/nlab/show/iterated+monoidal+category"} that term
                is also used for the case when the two units coincide.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Batanin"}> Michael Batanin
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Martin+Markl"} Martin Markl
                %em Centers and homotopy centers in enriched monoidal categories.
                Advances in Mathematics
                %strong 230
                , 4-6 (2012), 1811–1858. Here apparently the term “duoidal category” was introduced.
            %li
              %p
                T. Booker,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
                = succeed "," do
                  %em Tannaka duality and convolution for duoidal categories
                %a{:href => "https://www.emis.de/journals/TAC/volumes/28/6/28-06.pdf"} pdf
                %a{:href => "https://arxiv.org/abs/1111.5659"} arXiv:1111.5659
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "," do
                  %span.newWikiWord
                    Ignacio López Franco
                    %a{:href => "/nlab/new/Ignacio+L%C3%B3pez+Franco"} ?
                = succeed "," do
                  %em Commutativity
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1507.08710"} arXiv:1507.08710
                = succeed "," do
                  %em Commutativity and tensor products of theories, monads, and operads
                %a{:href => "https://www.dpmms.cam.ac.uk/~ill20/ct2013-talk.pdf"} slides
            %li
              %p
                Zoran Petrić and
                %a.existingWikiWord{:href => "/nlab/show/Todd+Trimble"} Todd Trimble
                2014,
                = succeed "," do
                  %em
                    Symmetric bimonoidal intermuting categories and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ω
                          %mo ×
                          %mi ω
                        %annotation{:encoding => "application/x-tex"} \omega \times \omega
                    reduced bar constructions
                %a{:href => "https://arxiv.org/abs/0906.2954"} arXiv:0906.2954
            %li#FrancoVasilakopoulou
              %p
                %span.newWikiWord>
                  Ignacio López Franco
                  %a{:href => "/nlab/new/Ignacio+L%C3%B3pez+Franco"} ?
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christina+Vasilakopoulou"} Christina Vasilakopoulou
                = succeed "," do
                  %em Duoidal categories, measuring comonoids and enrichment
                %a{:href => "https://arxiv.org/abs/2005.01340"} arXiv:2005.01340
                (2020).
          %p The relationship between duoidal categories and symmetric monoidal categories is essentially a consequence of:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexei+Davydov"}> Alexei Davydov
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Ingo+Runkel"} Ingo Runkel
              = succeed "," do
                %em An alternative description of braided monoidal categories
              %strong 23
              (2015) 279-309 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s10485-013-9338-3"}> doi:10.1007/s10485-013-9338-3
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://www.math.uni-hamburg.de/home/runkel/PDF/bcat.pdf"} pdf
          %p On bimonoids in duoidal categories
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gabriella+B%C3%B6hm"}> Gabriella Böhm
                ,
                = succeed "," do
                  %em (Hopf) bimonoids in duoidal categories
                = succeed "," do
                  %em Hopf algebras and their generalizations from a category theoretical point of view
                %strong 2226
                (2018) (chapter
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/978-3-319-98137-6_7"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gabriella+B%C3%B6hm"}> Gabriella Böhm
                , Y. Chen, L. Zhang,
                = succeed "," do
                  %em On Hopf monoids in duoidal categories
                %strong 394
                (2013) 139–172 (2013)
                %a{:href => "https://mathscinet.ams.org/mathscinet/relay-station?mr=3092715"} MR3092715
                %a{:href => "https://doi.org/10.1016%2Fj.jalgebra.2013.07.016"} doi
            %li
              %p
                Y. Chen, G. Böhm,
                = succeed "," do
                  %em Weak bimonoids in duoidal categories
                = succeed ":12" do
                  %strong 218
                %a{:href => "https://doi.org/10.1016/j.jpaa.2014.04.001"} doi
          %p A related concept is discussed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Kosta+Do%C5%A1en"}> Kosta Došen
              , Zoran Petrić:
              = succeed "," do
                %em Intermutation
              %strong 20
              (2012) 43-95 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0701325"}> arXiv:math/0701325
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s10485-010-9228-x"} doi:10.1007/s10485-010-9228-x
          %p
            On a
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            to
            %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
            with two classes of loose morphism:
          %ul
            %li
              Patrick Schultz,
              = succeed "," do
                %em Algebraic Weak Factorization Systems in Double Categories
          %p
            On a
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            to
            %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
            with “oplax” monoidal structure:
