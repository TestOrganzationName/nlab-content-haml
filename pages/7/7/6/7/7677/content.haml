          %h2#definition Definition
          %p
            Let
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a prime number, let
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a field of characteristic
            = succeed "." do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            we define
          .maruku-equation
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_12.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo :
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mi A
                            %mo →
                            %mi A
                        %mtr
                          %mtd
                            %mi x
                            %mo ↦
                            %msup
                              %mi x
                              %mi p
                %annotation{:encoding => "application/x-tex"}
                  f_A:
                  \\begin{cases}
                  A\to A
                  \\\
                  x\mapsto x^p
                  \\end{cases}
          %p
            The
            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            by scalar restriction along
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi k
                  %mo :
                  %mi k
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} f_k:k\to k
            is denoted by
            = succeed "." do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi f
                  %annotation{:encoding => "application/x-tex"} A_{f}
          %p
            The
            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            by scalar extension along
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
