            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
