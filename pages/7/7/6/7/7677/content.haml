                    %mi k
                %annotation{:encoding => "application/x-tex"} {}^\hat\;:Sch_k\to fSch_k
            commutes with the above constructions the Frobenius morphism can be defined for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal k-schemes
          %h3#in_terms_of_symmetric_products In terms of symmetric products
          %p
            We give here another characterization of the
            %a.existingWikiWord{:href => "/nlab/show/Frobenius+morphism"} Frobenius morphism
            in terms of symmetric products.
          %p
            Let
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a prime number, let
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a field of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            = succeed "," do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            be a
            = succeed "-vector" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ⊗
                    %mi p
                  %mi V
                %annotation{:encoding => "application/x-tex"} \otimes^p V
            denote the
            = succeed "-fold" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi TS
                    %mi p
                  %mi V
                %annotation{:encoding => "application/x-tex"} TS^p V
            denote the subspace of symmetric tensors. Then we have the symmetrization operator
          .maruku-equation
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_45.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi V
                  %mo :
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %msup
                              %mo ⊗
                              %mi p
                            %mi V
                            %mo →
                            %msup
                              %mi TS
                              %mi p
                            %mi V
                        %mtr
                          %mtd
                            %msub
                              %mi a
                              %mn 1
                            %mo ⊗
                            %mi ⋯
                            %mo ⊗
                            %msub
                              %mi a
                              %mi n
                            %mo ↦
                            %msub
                              %mi Σ
                              %mrow
                                %mi σ
                                %mo ∈
                                %msub
                                  %mi S
                                  %mi p
                            %msub
                              %mi a
                              %mrow
                                %mi σ
                                %mo{:stretchy => "false"} (
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi ⋯
                            %mo ⊗
                            %msub
                              %mi a
                              %mrow
                                %mi σ
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  s_V:
                  \\begin{cases}
                  \\otimes^p V\to TS^p V
                  \\\
                  a_1\otimes\cdots\otimes a_n\mapsto \Sigma_{\sigma\in S_p}a_{\sigma(1)}\otimes\cdots\otimes a_{\sigma(n)}
                  \\end{cases}
          %p end the linear map
          .maruku-equation
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_46.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi α
                    %mi V
                  %mo :
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %msup
                              %mi TS
                              %mi p
                            %mi V
                            %mo →
                            %msup
                              %mo ⊗
                              %mi p
                            %mi V
                        %mtr
                          %mtd
                            %mi a
                            %mo ⊗
                            %mi λ
                            %mo ↦
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ⊗
                            %mi ⋯
                            %mo ⊗
                            %mi a
                            %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\alpha_V:
                  \\begin{cases}
                  TS^p V\to\otimes^p V
                  \\\
                  a\otimes \lambda\mapsto\lambda(a\otimes\cdots\otimes a)
                  \\end{cases}
          %p
            then the map
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi α
                        %mi V
                  %msup
                    %mi TS
                    %mi p
                  %mi V
                  %mo →
                  %msup
                    %mi TS
                    %mi p
                  %mi V
                  %mo{:stretchy => "false"} /
                  %mi s
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ⊗
                    %mi p
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V^{(p)}\stackrel{\alpha_V}{\to}TS^p V\to TS^p V/s(\otimes^p V)
            is bijective and we define
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi V
                  %mo :
                  %msup
                    %mi TS
                    %mi p
                  %mi V
                  %mo →
                  %msup
                    %mi V
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda_V:TS^p V\to V^{(p)}
            by
          .maruku-equation
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_49.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi V
                  %mo ∘
                  %mi s
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \lambda_V\circ s=0
          %p and
          .maruku-equation
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_50.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi V
                  %mo ∘
                  %msub
                    %mi α
                    %mi V
                  %mo =
                  %mi id
                %annotation{:encoding => "application/x-tex"} \lambda_V \circ \alpha_V= id
          %p
            If
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi TS
                    %mi p
                  %mi A
                %annotation{:encoding => "application/x-tex"} TS^p A
            is a
            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi λ
                    %mi A
                %annotation{:encoding => "application/x-tex"} \lambda_A
            is a
            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            If
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msub
                    %mi Sp
                    %mi k
                  %mi A
                %annotation{:encoding => "application/x-tex"} X=Sp_k A
            is a ring spectrum we abbreviate
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi p
                  %mi X
                  %mo =
                  %msubsup
                    %mi S
                    %mi k
                    %mi p
                  %mi X
                  %mo :
                  %mo =
                  %msub
                    %mi Sp
                    %mi k
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi TS
                    %mi p
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S^p X=S^p_k X:=Sp_k (TS^p A)
            and the following diagram is commutative.
          .maruku-equation
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_59.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi F
                                %mi X
                        %mtd
                          %msup
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi X
                            %mi p
                        %mtd
                          %mover
                            %mo →
                            %mi can
                        %mtd
                          %msup
                            %mi S
                            %mi p
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X
                  \&amp;\stackrel{F_X}{\to}&amp;
                  X^{(p)}
                  \\\
                  \\downarrow&amp;&amp;\downarrow
                  \\\
                  X^p
                  \&amp;\stackrel{can}{\to}&amp; S^p X
                  }
          %h2#properties Properties
          %p
            Note that the Frobenius
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi p
                %annotation{:encoding => "application/x-tex"} F_p
            is an endomorphism of a field
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            only if the characteristic of
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is
            = succeed "." do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            However if we pass from rings to schemes, in general it is not true that Frobenius is a monomorphism. The following proposition gives necessary and sufficient conditions for the Frobenius to be a monomorphism in case of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal schemes
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "-formal" do
                %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_65.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/locally+algebraic+scheme"} locally algebraic scheme
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              %a.existingWikiWord{:href => "/nlab/show/etale+scheme"} étale
              iff the
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+morphism"} Frobenius morphism
              = succeed "is" do
                %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi X
                      %mo :
                      %mi X
                      %mo →
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_X:X\to X^{(p)}
          %h2#examples Examples
          %p
            If
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %msub
                    %mi Sp
                    %mi k
                  %mi A
                %annotation{:encoding => "application/x-tex"} X=Sp_k A
            is a
            = succeed "-ring" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Sp
                    %mi k
                  %msup
                    %mi A
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^{(p)}=Sp_k A^{(p)}
            and
            = succeed "." do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi X
                    %mo =
                    %msub
                      %mi Sp
                      %mi k
                    %msub
                      %mi F
                      %mi A
                  %annotation{:encoding => "application/x-tex"} F_X=Sp_k F_A
          %p
            If
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mi 𝔽
                %annotation{:encoding => "application/x-tex"} k=\mathbb{F}
            is a finite field we have
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mi X
                %annotation{:encoding => "application/x-tex"} X^{(p)}=X
            however
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi X
                %annotation{:encoding => "application/x-tex"} F_X
            will not equal
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi X
                %annotation{:encoding => "application/x-tex"} id_X
            in general.
          %p
            If
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ↪
                  %msup
                    %mi k
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                %annotation{:encoding => "application/x-tex"} k\hookrightarrow k^\prime
            is a field extension we have
            = succeed "." do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %mi X
                        %msub
                          %mo ⊗
                          %mi k
                        %msup
                          %mi k
                          %mstyle{:scriptlevel => "0"}
                            %mo ′
                    %mo =
                    %msub
                      %mi F
                      %mi X
                    %msub
                      %mo ⊗
                      %mi k
                    %msup
                      %mi k
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} F_{X\otimes_k k^\prime}=F_X\otimes_k k^\prime
