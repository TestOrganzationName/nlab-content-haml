                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mi R
                            %mo{:stretchy => "false"} )
                            %mo :
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi R
                            %mo{:stretchy => "false"} )
                            %mo →
                            %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi R
                              %mi f
                            %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  F_X:
                  \\begin{cases}
                  X\to X^{(p)}
                  \\\
                  X(f_R):X(R)\to X(R_f)
                  \\end{cases}
          %p
            If
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "-scheme" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
