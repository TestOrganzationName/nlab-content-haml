                    \\end{cases}
          %p
            For a
            = succeed "-functor" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
