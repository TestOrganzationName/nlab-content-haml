                  %mi k
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} f_k:k\to k
            is denoted by
            = succeed "." do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %mo{:stretchy => "false"} (
