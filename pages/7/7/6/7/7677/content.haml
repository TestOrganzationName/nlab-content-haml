                  %annotation{:encoding => "application/x-tex"} k
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            we define
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi X
                  %msub
                    %mo ⊗
                    %mrow
                      %mi k
                      %mo ,
                      %msub
                        %mi f
                        %mi k
                  %mi k
                %annotation{:encoding => "application/x-tex"} X^{(p)}:=X\otimes_{k,f_k} k
            which satisfies
            = succeed "." do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{(p)}(R)=X(R_f)
            %em Frobenius morphism
            for
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the transformation of
            = succeed "-functors" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_30.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi X
                  %mo :
                  %mrow
                    %mo {
                    %mrow
