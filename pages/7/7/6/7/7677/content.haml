                      %mi p
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^{(p)}
            is a
            = succeed "-scheme," do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            Since the completion functor
            %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
