                    %mo →
                    %mrow
                      %msub
                        %mi s
                        %mo *
                  %mi R
                  %mo .
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} (s^*\dashv s_*):S.Mod\stackrel{s_*}{\to} R.Mod
          %p
            from the category of
            = succeed "-" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/module"} modules
            to that of
            = succeed "-modules" do
              %math#mathml_38f85b6fe6e1ae443dfdccc7d9732b950176ebd6_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
