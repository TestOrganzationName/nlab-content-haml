            %li#BeardsleyNakamura24
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Beardsley"}> Jonathan Beardsley
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/So+Nakamura"} So Nakamura
                %em
                  Projective Geometries and Simple Pointed Matroids as
                  = succeed "-modules" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔽
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2404.04730"}> arXiv:2404.04730
                \&amp;rbrack;
          %p
            The approach in terms of
            %a.existingWikiWord{:href => "/nlab/show/Lambda-rings"} Lambda-rings
            due to
          %ul
            %li#Borger09
              %a.existingWikiWord{:href => "/nlab/show/James+Borger"}> James Borger
              ,
              %em Lambda-rings and the field with one element
              (
              %a{:href => "http://arxiv.org/abs/0906.3146"}> arXiv/0906.3146
              )
          %p with details in
          %ul
            %li#Borger08
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Borger"}> James Borger
                ,
                %em The basic geometry of Witt vectors, I: The affine case
                (
                %a{:href => "http://arxiv.org/abs/0801.1691"}> arXiv:0801.1691
                )
            %li#Borger10
              %p
                %a.existingWikiWord{:href => "/nlab/show/James+Borger"}> James Borger
                ,
                %em The basic geometry of Witt vectors, II: Spaces
                (
                %a{:href => "http://arxiv.org/abs/1006.0092"}> arXiv:1006.0092
                )
          %p More discussion relating to this includes
          %ul
            %li#LeBruyn13
              %a.existingWikiWord{:href => "/nlab/show/Lieven+Le+Bruyn"}> Lieven Le Bruyn
              ,
              %em Absolute geometry and the Habiro topology
              (
              %a{:href => "http://arxiv.org/abs/1304.6532"}> arXiv:1304.6532
              )
          %h3#relation_to_stable_homotopy_theory Relation to stable homotopy theory
          %p
            The interpretation of
            %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
            as
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
            is amplified in the following articles:
          %ul
            %li#Deitmar06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anton+Deitmar"}> Anton Deitmar
                ,
                %em
                  Remarks on zeta functions and K-theory over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔽
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                (
                %a{:href => "https://arxiv.org/abs/math/0605429"}> arXiv:math/0605429
                )
            %li#Guillot06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Guillot"}> Pierre Guillot
                ,
                %em Adams operations in cohomotopy
                (
                %a{:href => "https://arxiv.org/abs/math/0612327"}> arXiv:0612327
                )
            %li#MoravaSanthanam
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jack+Morava"}> Jack Morava
                , Rekha Santhanam,
                = succeed "," do
                  %em Power operations and absolute geometry
                = succeed ")" do
                  %a{:href => "http://www.lemiller.net/media/slidesconf/AbsolutePower.pdf"} pdf
            %li#Mahanta17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Snigdhayan+Mahanta"}> Snigdhayan Mahanta
                ,
                = succeed "," do
                  %em
                    G-theory of
                    = succeed "-algebras" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi 𝔽
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1110.6001"} arXiv:1110.6001
            %li#Berman18
              %p
                John D. Berman, p. 92 of
                %em Categorified algebra and equivariant homotopy theory
                (
                %a{:href => "https://arxiv.org/abs/1805.08745"}> arXiv:1805.08745
                )
            %li#ChuLorscheidSanthanam10
              %p
                Chenghao Chu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Oliver+Lorscheid"} Oliver Lorscheid
                = succeed "," do
                  %em
                    Sheaves and K-theory for
                    = succeed "-schemes" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi 𝔽
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1010.2896"} arxiv:1010.2896
          %p
            and generalization from
            = succeed "-schemes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
          %ul
            %li
              Jens Niklas Eberhardt,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Oliver+Lorscheid"} Oliver Lorscheid
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Matthew+B.+Young"} Matthew B. Young
              = succeed "," do
                %em Algebraic K-theory and Grothendieck-Witt theory of monoid schemes
              %strong 301
              (2022) 1407–1445 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2009.12636"}> arXiv:2009.12636
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00209-021-02919-z"} doi:10.1007/s00209-021-02919-z
          %p see also:
          %ul
            %li#MoravaSomeBackground
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jack+Morava"}> Jack Morava
                \:
                %em
                  Some background on Manin’s theorem
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝔽
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ∼
                        %mi 𝕊
                      %annotation{:encoding => "application/x-tex"} K(\mathbb{F}_1) \sim \mathbb{S}
                \&amp;lbrack;
                %a{:href => "http://www.alainconnes.org/docs/Morava.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a{:href => "/nlab/files/MoravaSomeBackground.pdf"} pdf
            %li#ConnesConsani16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alain+Connes"}> Alain Connes
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Caterina+Consani"} Caterina Consani
                = succeed "," do
                  %em Absolute algebra and Segal’s Gamma sets
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1502.05585"} arXiv:1502.05585
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Beardsley"}> Jonathan Beardsley
                \:
                %em
                  The Eilenberg-MacLane Spectrum of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔽
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2508.01524"}> arXiv:2508.01524
                \&amp;rbrack;
          %h3#in_quantum_field_theory In quantum field theory
          %p
            Speculation on
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔽
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
            (via
            %a.existingWikiWord{:href => "/nlab/show/wonderful+compactifications"} wonderful compactifications
            of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
          %ul
            %li
              %p
                Dori Bejleri,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matilde+Marcolli"} Matilde Marcolli
                = succeed "," do
                  %em
                    Quantum field theory over
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔽
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                %strong 69
                (2013) 40-59 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1209.4837"}> arXiv:1209.4837
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.geomphys.2013.03.002"} doi:10.1016/j.geomphys.2013.03.002
            %li
              %p
                Seyed Khaki,
                %em
                  Original
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔽
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_1
                  in emergent spacetime
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2401.07822"}> arXiv:2401.07822
                \&amp;rbrack;
