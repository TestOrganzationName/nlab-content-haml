              %svg{:height => "90.236pt", :version => "1.2", :viewbox => "0 0 119.377 90.236", :width => "119.377pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
