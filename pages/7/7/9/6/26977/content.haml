          is well-defined.
          %p
          .num_defn
            %h6 Definition
            %p
              %strong (weak composite)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
