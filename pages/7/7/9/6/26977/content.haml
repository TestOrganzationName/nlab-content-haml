                  %annotation{:encoding => "application/x-tex"} X, Y
              be diagrammatic
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty, n)
              %strong functor
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is simply a natural transformation of the underlying diagrammatic sets.
              %br/
          %p
          .num_defn
            %h6 Definition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                \-equivalence)
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              be a functor of diagrammatic
              = succeed "-categories." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty, n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                \-equivalence
              if:
            %ul
              %li
                for every 0-cell
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} y \in Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                such that
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ≃
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} y \simeq f(x)
              %li
                for every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} n \gt 0
                = succeed "-cells" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n - 1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x_1, x_2
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ⇒
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} y \colon f(x_1) \Rightarrow f(x_2)
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi x
                        %mn 1
                      %mo ⇒
                      %msub
                        %mi x
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x \colon x_1 \Rightarrow x_2
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ≃
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} y \simeq f(x)
            %p
          %p
            From
            = succeed "," do
              %a{:href => "#ChanavatHadzihasanovic2024Model"} CH24model
          #n_model_structure.num_theorem
            %h6 Theorem
            %p
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} n\in \mathbb{N} \cup \{ \infty \}
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model structure
              on diagrammatic sets where
            %ul
              %li
                cofibrations are monomorphisms, and are generated by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo ∂
                        %mi U
                        %mo ↪
                        %mi U
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                        %mi U
                        %mspace{:width => "thickmathspace"}
                        %mtext atom
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{ \partial U \hookrightarrow U \mid U\; \text{atom} \}
              %li
                fibrant object are the diagrammatic
                = succeed "-categories," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty, n)
              %li
                weak equivalences between fibrant objects are the
                = succeed "-equivalences." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
            %p
          %p
          .num_theorem
            %h6 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"}> homotopy hypothesis
                )
              %br/
              The model structure for diagrammatic
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty, 0)
              = succeed "." do
                %a.maruku-ref{:href => "#kan_model_structure"}
          %h2#references References
          %p
            The origin of the name is in the following, where diagrammatic sets were presheaves over Johnson’s
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pasting+scheme"} pasting schemes
          %ul
            %li
              Kapranov, M. M., and Voevodsky, V. A..
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoids and homotopy types.
              Cahiers de Topologie et Géométrie Différentielle Catégoriques 32.1 (1991) (
              %a{:href => "http://eudml.org/doc/91469"}> link
              )
          %p An older treatment of diagrammatic sets:
          %ul
            %li#Hadzihasanovic2020
              %a.existingWikiWord{:href => "/nlab/show/Amar+Hadzihasanovic"}> Amar Hadzihasanovic
              ,
              = succeed "," do
                %em Diagrammatic sets and rewriting in weak higher categories
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2007.14505"} arXiv:2007.14505
          %p For an updated version, together with results for higher groupoids:
          %ul
            %li#ChanavatHadzihasanovic2024Homotopy
              Clémence Chanavat, Amar Hadzihasanovic,
              = succeed "," do
                %em Diagrammatic sets as a model of homotopy types
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2407.06285v1"} arXiv:2407.06285
          %p For the notion of equivalence in diagrammatic sets:
          %ul
            %li#ChanavatHadzihasanovic2024Eq
              Clémence Chanavat, Amar Hadzihasanovic,
              = succeed "," do
                %em Equivalences in diagrammatic sets
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2410.00123"} arXiv:2410.00123
          %p
            For the model structures on diagrammatic
            = succeed "-categories:" do
