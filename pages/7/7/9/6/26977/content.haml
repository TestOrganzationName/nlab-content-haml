          %h2#idea Idea
          %p
            Diagrammatic sets are
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/atom+category"} atom category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/polygraph"} polygraphs
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher categories
          %h2#definition Definition
          %p
          .num_defn
            %h6 Definition
            %p
              %strong (diagrammatic set)
              %br/
              A
              %strong diagrammatic set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a presheaf over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊙
                    %annotation{:encoding => "application/x-tex"} \odot
              %a.existingWikiWord{:href => "/nlab/show/atom+category"} category of atoms
              and cartesian maps. Diagrammatic sets and
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              form the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊙
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \odot\mathbf{Set}
          %h2#properties Properties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi RDCpx
                %annotation{:encoding => "application/x-tex"} \mathbf{RDCpx}
            be the category of
            %a.existingWikiWord{:href => "/nlab/show/regular+directed+complex"} regular directed complexes
            and cartesian maps. Since atoms are regular directed complexes, there is a
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo ⊙
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi RDCpx
                  %annotation{:encoding => "application/x-tex"} i \colon \odot \hookrightarrow \mathbf{RDCpx}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is canonically a colimit of its atoms, in the sense that there is a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mi P
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi RDCpx
                %annotation{:encoding => "application/x-tex"}
                  P^* \colon P \to \mathbf{RDCpx}
          %p
            sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} x \in P
            to the atom
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} cl
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{cl}(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \le y
            to the inclusion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} cl
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi{:mathvariant => "normal"} cl
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{cl}(x) \hookrightarrow \mathrm{cl}(y)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                  %msup
                    %mi P
                    %mo *
                  %mo ≅
                  %mi P
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\colim P^* \cong P.
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \odot\mathbf{Set}
            is the
            %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊙
                  %annotation{:encoding => "application/x-tex"} \odot
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mi P
                  %mo →
                  %mo ⊙
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P^* \colon P \to \odot\mathbf{Set}.
          %p
            sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi P
                %annotation{:encoding => "application/x-tex"} x \in P
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} cl
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y(\mathrm{cl}(x))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            defines a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/restricted+Yoneda+embedding"} restricted Yoneda embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi RDCpx
                  %mo →
                  %mo ⊙
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"}
                  i^* \colon \mathbf{RDCpx} \to \odot\mathbf{Set}
          %p
            that sends a regular directed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to the presheaf
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi RDCpx
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{RDCpx}(i^*(-), P)
          %p
          .num_prop
            %h6 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                  %annotation{:encoding => "application/x-tex"} i^*
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful
          This means that
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mi i
              %annotation{:encoding => "application/x-tex"} i
          is a
          = succeed "," do
            %a.existingWikiWord{:href => "/nlab/show/dense+functor"} dense functor
          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
            %semantics
              %mrow
                %mstyle{:mathvariant => "bold"}
                  %mi RDCpx
              %annotation{:encoding => "application/x-tex"} \mathbf{RDCpx}
          as a full subcategory of
          = succeed "," do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \odot\mathbf{Set}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                  %mo ↪
                  %mstyle{:mathvariant => "bold"}
                    %mi RDCpx
                  %mo ↪
                  %mo ⊙
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\odot\mathbf{Set} \hookrightarrow \mathbf{RDCpx} \hookrightarrow \odot\mathbf{Set}.
          %p
            Furthermore, the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                %annotation{:encoding => "application/x-tex"} \odot
            is monoidal for the Gray product. By
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \odot\mathbf{Set}
            is also monoidal for (what we also call) the Gray product, with monoidal unit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} y\mathbf{1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{1}
            is the (Point). Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ,
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P, Q
            be regular directed complexes, we have two ways of computing
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ⊗
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P \otimes Q
          %ul
            %li
              via Day convolution when seeing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ,
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P, Q
              as presheaves over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊙
                      %mstyle{:mathvariant => "bold"}
                        %mi Set
                    %annotation{:encoding => "application/x-tex"} \odot\mathbf{Set}
            %li
              directly via the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+directed+complex#operations"} Gray product of regular directed complexes
          %p
            Of course, those two ways give the same result, i.e.
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ⊗
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^*(P \otimes Q) = i^*(P) \otimes i^*(Q)
          %p
            Another feature is the boundary. Similarly to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary of a simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            has a boundary
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mi U
                %annotation{:encoding => "application/x-tex"} \partial U
            which can be computed in two ways:
          %ul
            %li
              as the regular directed complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo \
                    %mo{:stretchy => "false"} {
                    %msub
                      %mo ⊤
                      %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} U \backslash \{ \top_U \}
              with underlying poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              without its top-element,
            %li
              as the diagrammatic set generated from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi yU
                  %annotation{:encoding => "application/x-tex"} yU
              minus its unique non-degenerate cell in dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dim
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \dim U
          %p
            Again, those two ways coincide in the sense that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ∂
                    %mi yU
                  %annotation{:encoding => "application/x-tex"} i^*(\partial U) = \partial yU
          %h2#diagrammatic_sets_and_higher_category_theory Diagrammatic sets and higher category theory
          %p
            The richness of shapes in the category of atoms, as well as the quite rigid behavior of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊙
                %annotation{:encoding => "application/x-tex"} \odot
            where they live make them a good candidate for modelling
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \colon U \to X
            whose domain is an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %strong
              %a.existingWikiWord{:href => "/nlab/show/k-morphism"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-cell
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is more generally an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is furthermore round, we speak of a
            = succeed "." do
              %strong
                round
                = succeed "-diagram" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
          %p Before the more conjectural case of weak higher categories, we can deal with the case of higher groupoids.
          %h3#higher_groupoids Higher groupoids
          %p
          .num_defn
            %h6 Definition
            %p
              %strong (diagrammatic horn)
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              be an atom, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊑
                    %msup
                      %mo ∂
                      %mi α
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V \sqsubseteq \partial^\alpha U
              be a
              %a.existingWikiWord{:href => "/nlab/show/regular+directed+complex#submolecule"} rewritable submolecule
              of either the input or output boundary. The
              %strong diagrammatic horn
              defined by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ,
                    %mi V
                  %annotation{:encoding => "application/x-tex"} U, V
              is the regular directed complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Λ
                      %mi U
                      %mi V
                    %mo ≔
                    %mi U
                    %mo \
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo \
                    %mo ∂
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda^V_U \coloneqq U \backslash (V \backslash \partial V).
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi λ
                      %mi U
                      %mi V
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Λ
                      %mi U
                      %mi V
                    %mo ↪
                    %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\lambda^V_U \colon \Lambda^V_U \hookrightarrow U
            %p for the inclusion of a horn into its atom.
          %p
          .num_remark
            %h6 Example
            %p
              Recall that the
              %a.existingWikiWord{:href => "/nlab/show/atom+category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊙
                  %annotation{:encoding => "application/x-tex"} \odot
              contains as a full subcategory the oriented simplices, which is a category isomorphic to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              is also a diagrammatic horn.
          %p
          .num_defn
            %h6 Definition
            %p
              %strong (Kan diagrammatic set)
              %br/
              A
              %strong Kan diagrammatic set
              is a diagrammatic set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
