                  %annotation{:encoding => "application/x-tex"} q(y)\ne 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ∈
                  %mi Y
                %annotation{:encoding => "application/x-tex"} y\in Y
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} q(y)=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            one can for example take
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mo †
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} |
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi δ
                      %mrow
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %mi x
                  %annotation{:encoding => "application/x-tex"} k^\dagger(x|y)=\delta_{x_0,x}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} x_0
            is a fixed element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is nonempty since it admits a probability measure.)
          %p
            Bayesian inverses are not unique, but they are uniquely defined on the support of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %a.existingWikiWord{:href => "/nlab/show/almost+surely"} almost sure
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
          %h3#measuretheoretic_case Measure-theoretic case
          %p
            The situation is more delicate outside the discrete case. Given
            %a.existingWikiWord{:href => "/nlab/show/probability+spaces"} probability spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A},p)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B},q)
            %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#measurepreserving_kernels"} measure-preserving Markov kernel
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝒜
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k:(X,\mathcal{A},p)\to(Y,\mathcal{B},q)
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#bayesian_inversion"} Bayesian inverse
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is a Markov kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo †
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi ℬ
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k^\dagger:(Y,\mathcal{B},q)\to(X,\mathcal{A},p)
            such that for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} B\in\mathcal{B}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi A
                  %mi k
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi dx
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∫
                    %mi B
                  %msup
                    %mi k
                    %mo †
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi dy
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\int_A k(B|x)\,p(dx) = \int_B k^\dagger(A|y)\,q(dy)
          %p
            As one can see from
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#almost_sure_equality"} Markov kernel - Almost sure equality
            %a.existingWikiWord{:href => "/nlab/show/almost+surely"} almost sure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
          %p
            Existence, on the other hand, is more tricky. In general, a kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo †
                %annotation{:encoding => "application/x-tex"} k^\dagger
            as above may fail to exist. The problem is that in order for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo †
                %annotation{:encoding => "application/x-tex"} k^\dagger
            to be a well-defined
            %a.existingWikiWord{:href => "/nlab/show/Markov+kernel"} Markov kernel
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B})\to(X,\mathcal{A})
          %ul
            %li
              the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ↦
                    %msup
                      %mi k
                      %mo †
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y\mapsto k^\dagger(A|y)
              is
              %a.existingWikiWord{:href => "/nlab/show/measurable+function"} measurable
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              for all
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} A\in\mathcal{A}
            %li
              the assignment
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %msup
                      %mi k
                      %mo †
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A\mapsto k^\dagger(A|y)
              is a
              %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} y\in Y
          %p
            The first condition can be taken care of using
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/conditional+expectation"} conditional expectation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A})
            is
            %a.existingWikiWord{:href => "/nlab/show/standard+Borel"} standard Borel
            and either
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B})
              is standard Borel too
          %p or
          %ul
            %li
              the kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} k:X\to Y
              is in the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi f
                  %annotation{:encoding => "application/x-tex"} \delta_f
              for a measurable
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f:X\to Y
          %p then a Bayesian inverse always exists.
          %p
            (See also
            %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#bayesian_inversion"} Markov kernel - Bayesian inversion
            and
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernel#conditionals"} Markov kernel - Conditionals
          %h2#in_categorical_probability In categorical probability
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorical+probability"} categorical probability
          %h3#in_markov_categories In Markov categories
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Markov+categories"} Markov categories
          %p
            The abstraction of a
            %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            is given by an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Markov+category"} Markov category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi I
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p:I\to X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f:X\to Y
            = succeed "A" do
              %br/
            %strong Bayesian inverse
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            with respect to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo †
                  %mo :
                  %mi Y
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f^\dagger:Y\to X
            such that the following equation holds, where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo =
                    %mi f
                    %mo ∘
                    %mi p
                  %annotation{:encoding => "application/x-tex"} q=f\circ p
