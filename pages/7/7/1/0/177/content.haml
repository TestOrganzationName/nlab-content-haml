            %em directed graph
            (often abbreviated to the contraction
            = succeed ")" do
              %em digraph
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/digraph"} digraph
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            = succeed "." do
