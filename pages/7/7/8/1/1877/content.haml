          %title Dowkers Theorem
          %h1#dowkers_theorem Dowker's Theorem
          .maruku_toc
            %ul
              %li
                %a{:href => "#note"} Note
              %li
                %a{:href => "#the_two_nerves_of_a_relation_dowkers_construction"} The two nerves of a relation: Dowker’s construction
              %ul
                %li
                  %a{:href => "#barycentric_subdivisions"} Barycentric subdivisions
              %li
                %a{:href => "#contiguity"} Contiguity
              %ul
                %li
                  %a{:href => "#dowkers_theorem_2"} Dowker’s Theorem
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#note Note
          %p
            The purpose of this entry is simply to state and prove a result of Dowker that was mentioned at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Vietoris+complex"} Vietoris complex
          %p To keep the discussion fairly self contained, certain ideas will be repeated from that, and possibly other, entries.
          %h2#the_two_nerves_of_a_relation_dowkers_construction The two nerves of a relation: Dowker’s construction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X, Y
            be sets and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            a relation between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ⊆
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    R
                    \\subseteq X \times Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi R
                  %mi y
                %annotation{:encoding => "application/x-tex"} x R y
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi R
                  %annotation{:encoding => "application/x-tex"} (x, y) \in R
          .un_example
            %h6#example Example
            %p
              (In addition to those given in
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Vietoris+complex"} Vietoris complex
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              is a simplex and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo ⊆
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \tau \subseteq \sigma
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \tau \neq \emptyset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
              is a simplex. For our purposes here, set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mi V
                      %mi K
                  %annotation{:encoding => "application/x-tex"} X = V_K
              to be the set of vertices of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo =
                      %msub
                        %mi S
                        %mi K
                    %annotation{:encoding => "application/x-tex"} Y = S_K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi R
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x R y
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is a vertex of the simplex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
          %p
            %strong Returning to the general situation,
            we define two
            %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial complexes
            associated to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo =
                      %msub
                        %mi K
                        %mi R
                      %mo :
                    %annotation{:encoding => "application/x-tex"} K = K_R:
              %ul
                %li
                  %p
                    the set of vertices is the set
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                %li
                  %p
                    a
                    = succeed "-simplex" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                    is a set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi x
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi x
                            %mi p
                          %mo{:stretchy => "false"} }
                          %mo ⊆
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \{x_0, \cdots, x_p\}\subseteq X
                    such that there is some
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo ∈
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} y \in Y
                    with
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi x
                            %mi i
                          %mi R
                          %mi y
                        %annotation{:encoding => "application/x-tex"} x_i R y
                    for
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                            %mo =
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi p
                          %annotation{:encoding => "application/x-tex"} i = 0, 1, \cdots, p
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo =
                      %msub
                        %mi L
                        %mi R
                      %mo :
                    %annotation{:encoding => "application/x-tex"} L = L_R :
              %ul
                %li
                  the set of vertices is the set
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} Y
                %li
                  a
                  = succeed "-simplex" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  is a set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi y
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi y
                          %mi p
                        %mo{:stretchy => "false"} }
                        %mo ⊆
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} \{y_0, \cdots, y_p\}\subseteq Y
                  such that there is some
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mi R
                        %msub
                          %mi y
                          %mi j
                      %annotation{:encoding => "application/x-tex"} x R y_j
                  for
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                          %mo =
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %mi p
                        %annotation{:encoding => "application/x-tex"} j  = 0, 1, \cdots, p
          %p Clearly the two constructions are in some sense dual to each other.
          .un_remark
            %h6#note_2 Note
            %p
              These two simplicial complexes were denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V(R)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(R)
              at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Vietoris+complex"} Vietoris complex
          %p We next need some classical subdivision ideas.
          %h3#barycentric_subdivisions Barycentric subdivisions
          %p
            Combinatorially, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is a simplicial complex with vertex set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi K
                  %annotation{:encoding => "application/x-tex"} V_K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            the partially ordered set of its simplices. Explicitly we write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi K
                %annotation{:encoding => "application/x-tex"} S_K
            for the set of simplices of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi K
                  %mo ,
                  %mo ⊆
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S_K, \subseteq)
            for the partially ordered set with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊆
                %annotation{:encoding => "application/x-tex"} \subseteq
            being the obvious inclusion. The
            = succeed "," do
              %strong barycentric subdivision
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi K
                %annotation{:encoding => "application/x-tex"} S_K
            as its set of vertices and a finite set of vertices of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} K'
            (i.e. simplices of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} K'
            if it is totally ordered by inclusion. (Thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} K'
            is the simplicial complex given by taking the nerve of the poset,
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi K
                    %mo ,
                    %mo ⊆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_K, \subseteq)
          .un_remark
            %h6#note_3 Note
            %p
              It is important to note that there is in general
              %em no
              natural simplicial map from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K'
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi K
                  %annotation{:encoding => "application/x-tex"} V_K
              is ordered in such a way that the vertices of any simplex in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              are totally ordered (for instance by picking a total order on
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi K
                    %annotation{:encoding => "application/x-tex"} V_K
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo :
                    %mi K
                    %mo ′
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \varphi : K' \rightarrow K
            %p by:
            %ul
              %li
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ′
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mn 0
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %msub
                        %mi x
                        %mi p
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \sigma' = \{ x_0, \cdots, x_p\}
                is a vertex of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} K'
                (so
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi σ
                        %mo ′
                        %mo ∈
                        %msub
                          %mi S
                          %mi K
                      %annotation{:encoding => "application/x-tex"}
                        \\sigma'
                        \\in S_K
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mi σ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \varphi \sigma'
                be the least vertex of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \sigma'
                in the given fixed order.
            %p
              This preserves simplices, but reverses order so if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo ′
                    %mo ⊂
                    %msub
                      %mi σ
                      %mn 2
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \sigma_1' \subset \sigma_2'
              then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi σ
                        %mn 1
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mi φ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi σ
                        %mn 2
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\varphi (\sigma_1') \geq
                      \\varphi(\sigma_2')
          %p
            If one changes the order, then the resulting map is
            = succeed ":" do
              %em contiguous
          %h2#contiguity Contiguity
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo ,
                  %mi ψ
                  %mo :
                  %mi K
                  %mo →
                  %mi L
                %annotation{:encoding => "application/x-tex"} \varphi, \psi : K \rightarrow L
            be two simplicial maps between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial complexes
            %strong contiguous
            if for any simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\varphi (\sigma) \cup \psi
                  (\sigma)
            forms a simplex in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
          %p Contiguity gives a constructive form of homotopy applicable to simplicial maps.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo :
                  %mi K
                  %mo →
                  %mi L
                %annotation{:encoding => "application/x-tex"} \psi : K \rightarrow L
            is a simplicial map, then it induces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo ′
                  %mo :
                  %mi K
                  %mo ′
                  %mo →
                  %mi L
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \psi' : K' \rightarrow L'
            after subdivision. As there is no way of knowing / picking compatible orders on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi K
                %annotation{:encoding => "application/x-tex"} V_K
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mi L
                %annotation{:encoding => "application/x-tex"} V_L
            in advance, we get that on constructing
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi φ
                    %mi K
                  %mo :
                  %mi K
                  %mo ′
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} \varphi_K : K' \rightarrow K
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi φ
                    %mi L
                  %mo :
                  %mi L
                  %mo ′
                  %mo →
                  %mi L
                %annotation{:encoding => "application/x-tex"} \varphi_L : L' \rightarrow L
          %p
            that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi φ
                    %mi L
                  %mi ψ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \varphi_L \psi'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %msub
                    %mi φ
                    %mi K
                %annotation{:encoding => "application/x-tex"} \psi \varphi_K
            will be contiguous to each other but rarely equal.
          %p
            %strong
              Returning to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi R
                  %annotation{:encoding => "application/x-tex"} K_R
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi R
                    %annotation{:encoding => "application/x-tex"} L_R
            we order the elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} y'
            is a vertex of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %msub
                      %mo ′
                      %mi R
                  %annotation{:encoding => "application/x-tex"} L'_R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi y
                      %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    y' = \{y_0,
                    \\cdots, y_p\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi R
                %annotation{:encoding => "application/x-tex"} L_R
            and there is an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  x \in
                  X
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi R
                    %msub
                      %mi y
                      %mi i
                    %mo ,
                    %mi i
                    %mo =
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi p
                  %annotation{:encoding => "application/x-tex"} x R y_i, i = 0, 1, \cdots, p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mi y
                  %mo ′
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"} \psi y' = x
            for one such
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi y
                  %msub
                    %mo ′
                    %mn 0
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi y
                  %msub
                    %mo ′
                    %mi q
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \sigma = \{ y'_0, \cdots, y'_q\}
            is a
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %msub
                      %mo ′
                      %mi R
                  %annotation{:encoding => "application/x-tex"} L'_R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %msub
                    %mo ′
                    %mn 0
                %annotation{:encoding => "application/x-tex"} y'_0
            is its least vertex (in the inclusion ordering)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi φ
                    %mi L
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi y
                    %mn 0
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi y
                  %msub
                    %mo ′
                    %mn 0
                  %mo ⊂
                  %msup
                    %mi y
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mi for
                  %mi each
                  %msub
                    %mi y
                    %mi i
                  %mo ∈
                  %mi σ
                %annotation{:encoding => "application/x-tex"}
                  \\varphi_L (y^\prime_0) \in y'_0 \subset y^\prime  for each  y_i \in
                  \\sigma
          %p
            hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mi y
                  %msub
                    %mo ′
                    %mi i
                  %mi R
                  %msub
                    %mi φ
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi y
                  %msub
                    %mo ′
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \psi y'_i R \varphi_L (y'_0)
            and the elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mi y
                  %msub
                    %mo ′
                    %mn 0
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %mi ψ
                  %mi y
                  %msub
                    %mo ′
                    %mi q
                %annotation{:encoding => "application/x-tex"}
                  \\psi y'_0,
                  \\cdots, \psi y'_q
            form a simplex in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi R
                  %annotation{:encoding => "application/x-tex"} K_R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo :
                  %mi L
                  %msub
                    %mo ′
                    %mi R
                  %mo →
                  %msub
                    %mi K
                    %mi R
                %annotation{:encoding => "application/x-tex"}
                  \\psi : L'_R
                  \\rightarrow K_R
            is a simplicial map. It, of course, depends on the ordering used and on the choice of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi x
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar x
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mi y
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \psi y'
            gives a contiguous map.
          %p
            Reversing the roles of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            in the above we get a simplicial map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %mo :
                  %msub
                    %mi K
                    %mi R
                  %mo ′
                  %mo →
                  %msub
                    %mi L
                    %mi R
                  %mo .
                %annotation{:encoding => "application/x-tex"} \bar\psi : K_R' \rightarrow L_R.
          %p Applying barycentric subdivisions again gives
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %mo ′
                  %mo :
                  %msub
                    %mi K
                    %mi R
                  %mo ″
                  %mo →
                  %msub
                    %mi L
                    %mi R
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \bar\psi' : K_R'' \rightarrow L_R'
          %p
            and composing with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo :
                  %msub
                    %mi L
                    %mi R
                  %mo ′
                  %mo →
                  %msub
                    %mi K
                    %mi R
                %annotation{:encoding => "application/x-tex"} \psi : L_R' \rightarrow K_R
            gives a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %mo ′
                  %mo :
                  %msub
                    %mi K
                    %mi R
                  %mo ″
                  %mo →
                  %msub
                    %mi K
                    %mi R
                  %mo .
                %annotation{:encoding => "application/x-tex"} \psi \bar\psi' : K_R'' \rightarrow K_R.
          %p
            Obviously,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} K'
            is ordered by inclusion of simplices, so there is a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                    %mo :
                    %msub
                      %mi K
                      %mi R
                    %mo ″
                    %mo →
                    %msub
                      %mi K
                      %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \varphi_{K'}:K_R''\rightarrow K_R'
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi φ
                    %mi K
                  %msub
                    %mi φ
                    %mrow
                      %mi K
                      %mo ′
                  %mo :
                  %msub
                    %mi K
                    %mi R
                  %mo ″
                  %mo →
                  %msub
                    %mi K
                    %mi R
                  %mo .
                %annotation{:encoding => "application/x-tex"} \varphi_K \varphi_{K'} : K_R''\rightarrow K_R.
          .un_proposition
            %h6#proposition_dowker_1952_p_88 Proposition (Dowker, 1952, p. 88)
            %p
              The two maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi K
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \varphi_K \varphi_{K'}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \psi \bar\psi'
              are contiguous.
          %p
            Before proving this, note that contiguity implies homotopy and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi φ
                    %mi K
                  %msub
                    %mi φ
                    %mrow
                      %mi K
                      %mo ′
                %annotation{:encoding => "application/x-tex"} \varphi_K \varphi_{K'}
            is homotopic to the identity map on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mi R
                %annotation{:encoding => "application/x-tex"} K_R
            after realisation, i.e., this proves the following modulo the proof of the proposition (see addendum below):
          .un_theorem
            %h6#dowkers_theorem_2 Dowker’s Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi K
                      %mi R
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi L
                      %mi R
                    %mo{:stretchy => "false"} |
                    %mo .
                  %annotation{:encoding => "application/x-tex"} |K_R| \simeq |L_R|.
          %p The homotopy depends on the ordering of the vertices and so is not natural.
          .proof
            %h6#proof_of_proposition Proof of Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ‴
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 0
                    %mo ″
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo ″
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi q
                    %mo ″
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \sigma''' = \{ x_0'', x_1'', \cdots, x_q''\}
              be a simplex of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi R
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} K_R''
              and as usual assume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} x_0''
              is its least vertex, then for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i \gt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo ″
                    %mo ⊂
                    %msub
                      %mi x
                      %mi i
                    %mo ″
                    %mo .
                  %annotation{:encoding => "application/x-tex"} x_0'' \subset x_i''.
            %p
              We have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \varphi_{K'}
              is clearly order reversing so
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                      %mo ⊆
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mn 0
                      %mo ″
                    %annotation{:encoding => "application/x-tex"}
                      \\varphi_{K'}
                      x_i'' \subseteq \varphi_{K'} x_0''
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo =
                      %mover
                        %mi φ
                        %mo{:stretchy => "false"} ¯
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mn 0
                      %mo ″
                    %annotation{:encoding => "application/x-tex"}
                      y = \bar\varphi \varphi_{K'}
                      x_0''
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mn 0
                      %mo ″
                    %annotation{:encoding => "application/x-tex"} x \in \varphi_{K'} x_0''
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mi Ry
                    %annotation{:encoding => "application/x-tex"} x Ry
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi φ
                        %mi K
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                      %mo ∈
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                      %mo ⊆
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mn 0
                      %mo ″
                    %annotation{:encoding => "application/x-tex"}
                      \\varphi_K
                      \\varphi_{K'} x_i'' \in \varphi_{K'} x_i'' \subseteq \varphi_{K'} x_0''
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi φ
                        %mi K
                      %msub
                        %mi φ
                        %mrow
                          %mi K
                          %mo ′
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                      %mi R
                      %mi y
                    %annotation{:encoding => "application/x-tex"} \varphi_K \varphi_{K'} x_i'' R y
            %p
              For each vertex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x'
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                      %mo ,
                      %mover
                        %mi ψ
                        %mo{:stretchy => "false"} ¯
                      %mi x
                      %mo ′
                      %mo ∈
                      %mover
                        %mi ψ
                        %mo{:stretchy => "false"} ¯
                      %mo ′
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                    %annotation{:encoding => "application/x-tex"}
                      x_i'', \bar \psi x' \in \bar \psi'
                      x_i''
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                    %msub
                      %mi x
                      %mn 0
                    %mo ″
                    %mo ∈
                    %msub
                      %mi x
                      %mn 0
                    %mo ″
                    %mo ⊂
                    %msub
                      %mi x
                      %mi i
                    %mo ″
                    %mo ,
                    %mi y
                    %mo =
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                    %msub
                      %mi xx
                      %mn 0
                    %mo ″
                    %mo ∈
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %msub
                      %mi x
                      %mi i
                    %mo ″
                  %annotation{:encoding => "application/x-tex"}
                    \\varphi_{K'}x_0'' \in x_0'' \subset x_i'', y =
                    \\bar \psi \varphi_{K'} xx_0'' \in \bar \psi' x_i''
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                    %annotation{:encoding => "application/x-tex"}
                      x_i
                      ''
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                      %mo ,
                      %mi ψ
                      %mover
                        %mi ψ
                        %mo{:stretchy => "false"} ¯
                      %mo ′
                      %msub
                        %mi x
                        %mi i
                      %mo ″
                      %mi R
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x_i'', \psi \bar \psi' x_i'' R y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi k
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ″
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi ψ
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo ‴
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                    %msub
                      %mi φ
                      %mi K
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ″
                    %mo{:stretchy => "false"} )
                    %mo ∪
                    %mi ψ
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ;
                    %msub
                      %mi x
                      %mi i
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} \varphi_k \varphi_{K'} (\sigma '') \cup \psi \bar \psi (\sigma''') = \bigcup \varphi_K \varphi_{K'} (x_i'')\cup \psi \bar \psi; x_i ''
            %p
              forms a simplex in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi R
                    %annotation{:encoding => "application/x-tex"} K_R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi K
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \varphi_K \varphi_{K'}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \psi \bar \psi'
              are contiguous.
          %p
            %strong Addendum.
            In the current form, it is difficult to see why
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %mo ′
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \bar\psi' \psi
            should be homotopic to the identity on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi L
                      %mi R
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |L_R|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi K
                    %mi R
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |K_R|
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi L
                      %mi R
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |L_R|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi K
                    %mi R
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |K_R|
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi L
                      %mi R
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |L_R|
          %p
            From above, observe that we have maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %msub
                    %mi φ
                    %mrow
                      %mi K
                      %mo ′
                  %mo :
                  %msub
                    %mi K
                    %mi R
                  %mo ″
                  %mo →
                  %msub
                    %mi L
                    %mi R
                %annotation{:encoding => "application/x-tex"} \bar\psi \varphi_{K'}:K_R'' \rightarrow L_R
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi L
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo :
                    %msub
                      %mi K
                      %mi R
                    %mo ″
                    %mo →
                    %msub
                      %mi L
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \varphi_L \bar\psi' : K_R'' \rightarrow L_R
          .un_proposition
            %h6#proposition_dowker_1952_lemma_6_p_89 Proposition (Dowker 1952, Lemma 6, p. 89)
            %p
              The two maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %msub
                      %mi φ
                      %mrow
                        %mi K
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \bar\psi \varphi_{K'}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi L
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \varphi_L \bar\psi'
              are contiguous.
          %p
            Thus upon passing to the geometric realization, we get that the realizations of the maps are homotopic, i.e.
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |\bar\psi| \simeq |\bar\psi'|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi φ
                    %mrow
                      %mi K
                      %mo ′
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |\varphi_{K'}|
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi φ
                    %mi L
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |\varphi_L|
            are homotopic to the respective identity maps.
          %p
            Thus we obtain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi ψ
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo ′
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %mi ψ
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} |
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |\psi||\bar\psi'| \simeq |\psi||\bar\psi|
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi K
                      %mi R
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |K_R|
          %p By symmetric arguments, we obtain the following results:
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo{:stretchy => "false"} ¯
                    %mi ψ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \bar\psi \psi'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi L
                    %msub
                      %mi φ
                      %mrow
                        %mi L
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \varphi_L \varphi_{L'}
              are contiguous.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi φ
                      %mi K
                    %mi ψ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \varphi_K \psi'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %msub
                      %mi φ
                      %mrow
                        %mi L
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} \psi \varphi_{L'}
              are contiguous.
          %p
            Passing to the geometric realization, we get that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo ′
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |\bar\psi| |\psi'|
            is homotopic to the identity on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi L
                      %mi R
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |L_R|
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi ψ
                    %mo ′
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %mi ψ
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |\psi'|\simeq |\psi|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |\bar\psi||\psi|
            is homotopic to the identity on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi L
                      %mi R
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |L_R|
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi ψ
                  %mo{:stretchy => "false"} |
                  %mo :
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi L
                    %mi R
                  %mo{:stretchy => "false"} |
                  %mo →
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi K
                    %mi R
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |\psi|: |L_R| \rightarrow |K_R|
            is a homotopy equivalence, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |\bar\psi|
            as its homotopy inverse.
