                    and a complex analogue
                = succeed ")" do
                  %a{:href => "https://www.jstor.org/stable/2372970"} jstor:2372970
            %li#Novikov60
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Novikov"}> Sergei Novikov
                ,
                = succeed "," do
                  %em Some problems in the topology of manifolds connected with the theory of Thom spaces
            %li#Novikov62
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sergei+Novikov"}> Sergei Novikov
                ,
                = succeed "," do
                  %em Homotopy properties of Thom complexes
                = succeed "," do
                  %a{:href => "http://www.mi-ras.ru/~snovikov/6.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/NovikovThomComplexes.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
                ,
                = succeed "," do
                  %em Elementary proofs of some results of cobordism theory using Steenrod operations
                %strong 7
                1 (1971) 29-56 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0001-8708(71)90041-7"}> doi:10.1016/0001-8708(71)90041-7
                \&amp;rbrack;
              %blockquote
                %p
                  (using
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Steenrod+operations"} Steenrod operations
          %p Textbook accounts:
          %ul
            %li#Stong68
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Stong"}> Robert Stong
                ,
                = succeed "," do
                  %em Notes on Cobordism theory
                = succeed "," do
                  %a{:href => "http://pi.math.virginia.edu/StongConf/Stongbookcontents.pdf"} toc pdf
                = succeed "," do
                  %a{:href => "http://press.princeton.edu/titles/6465.html"} ISBN:9780691649016
                = succeed ")" do
                  %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/stongcob.pdf"} pdf
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , section 1.5 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
          %p Lecture notes:
          %ul
            %li#Buchstaber
              %p
                %a.existingWikiWord{:href => "/nlab/show/Victor+Buchstaber"}> Victor Buchstaber
                ,
                %em Geometric cobordism theory
                (
                %a{:href => "http://www.maths.manchester.ac.uk/~peter/MATH41101notes07.pdf"}> pdf
                )
            %li#Francis
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
                (notes by
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Owen+Gwilliam"} Owen Gwilliam
                = succeed "," do
                  %em
                    %a{:href => "http://math.northwestern.edu/~jnkf/classes/mflds/"} Topology of manifolds
                %em Lecture 2: Cobordism
                (
                %a{:href => "http://math.northwestern.edu/~jnkf/classes/mflds/2cobordism.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gerald+H%C3%B6hn"}> Gerald Höhn
                ,
                %em
                  Komplexe elliptische Geschlechter und
                  = succeed "-\u00E4quivariante" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} S^1
                (german) (
                %a{:href => "http://arxiv.org/PS_cache/math/pdf/0405/0405232v1.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sander+Kupers"}> Sander Kupers
                ,
                %em Oriented bordism: Calculation and application
                (
                %a{:href => "https://www.utsc.utoronto.ca/people/kupers/wp-content/uploads/sites/50/orientedbordism.pdf"}> pdf
                )
          %p
            Details for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/framed+cobordism"} framed cobordism
          %ul
            %li#WangXu10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Guozhen+Wang"}> Guozhen Wang
                , Zhouli Xu, section 2 of
                = succeed "," do
                  %em A survey of computations of homotopy groups of Spheres and Cobordisms
                = succeed ")" do
                  %a{:href => "https://ncatlab.org/nlab/files/WangXuHomotopyGroupsOfSpheres2010.pdf"} pdf
            %li#Putnam
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Putman"}> Andrew Putman
                ,
                %em Homotopy groups of spheres and low-dimensional topology
                (
                %a{:href => "http://www.math.rice.edu/~andyp/notes/HomotopySpheresLowDimTop.pdf"}> pdf
                )
          %p
            The relation to
            %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
            is made explicit in
          %ul
            %li#Kosinski93
              %a.existingWikiWord{:href => "/nlab/show/Antoni+Kosinski"}> Antoni Kosinski
              , chapter IX of
              = succeed "," do
                %em Differential manifolds
              = succeed ")" do
                %a{:href => "http://www.maths.ed.ac.uk/~v1ranick/papers/kosinski.pdf"} pdf
          %p Further discussion of oriented cobordism includes
          %ul
            %li#ManifoldAtlas
              %p
                Manifold Atlas,
                %em
                  %a{:href => "https://web.archive.org/web/20241113162806/http://www.map.mpim-bonn.mpg.de/Oriented_bordism"} Oriented bordism
            %li#ConnorFloyd62
              %p
                P. E. Conner, E. E. Floyd,
                = succeed "," do
                  %em Differentiable periodic maps
                = succeed "," do
                  %a{:href => "http://projecteuclid.org/euclid.bams/1183524501"} Euclid
                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/cf1.pdf"} pdf
          %p
            A historical review in the context of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/complex+cobordism+cohomology+theory"} complex cobordism cohomology theory
            %a.existingWikiWord{:href => "/nlab/show/Brown-Peterson+theory"} Brown-Peterson theory
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Doug+Ravenel"}> Doug Ravenel
              , chapter 4, section 2 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Complex+cobordism+and+stable+homotopy+groups+of+spheres"} Complex cobordism and stable homotopy groups of spheres
          %p On fibered cobordism groups:
          %ul
            %li
              Astey, Greenberg, Micha, Pastor,
              %em Some fibered cobordisms groups are not finitely generated
              (
              %a{:href => "http://www.ams.org/journals/proc/1988-104-01/S0002-9939-1988-0958093-3/S0002-9939-1988-0958093-3.pdf"}> pdf
              )
          %p
            Discussion of the
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %ul
            %li
              %p
                G. Comezana and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em A completion theorem in complex cobordism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"}> Igor Kriz
                ,
                = succeed "," do
                  %em
                    The
                    = succeed "\u2013equivariant" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mi p
                          %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p
            %li#Strickland01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"}> Neil Strickland
                ,
                = succeed "," do
                  %em Complex cobordism of involutions
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0105020"} arXiv:math/0105020
            %li
              %p
                William Abrams,
                = succeed "," do
                  %em Equivariant complex cobordism
                = succeed ")" do
                  %a{:href => "http://deepblue.lib.umich.edu/bitstream/handle/2027.42/99796/abramwc_1.pdf"} pdf
