              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} x\in A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi B
