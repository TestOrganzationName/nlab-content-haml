            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi(x',y')
            %strong function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mrow
                    %msub
                      %mo =
                      %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mrow
                    %msub
                      %mo =
                      %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:(A,{=_A}) \to (B,{=_B})
            is a relation which is (a)
            %em
              %a.existingWikiWord{:href => "/nlab/show/entire+relation"}> entire
              \:
            for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
