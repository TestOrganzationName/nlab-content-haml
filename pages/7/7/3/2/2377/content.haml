                  %annotation{:encoding => "application/x-tex"} y=_B y'
          %p
            Now Axiom 2 reads: for any sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mrow
                    %msub
                      %mo =
                      %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,{=_A})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mrow
                    %msub
                      %mo =
                      %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B,{=_B})
            and any relation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mrow
                      %msub
                        %mo =
                        %mi A
                    %mo{:stretchy => "false"} )
                    %mo ↬
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mrow
                      %msub
                        %mo =
                        %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varphi:(A,{=_A})\looparrowright (B,{=_B})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mrow
