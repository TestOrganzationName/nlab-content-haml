          #ProjectiveModule.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %em
                projective
                = succeed "-module" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              in the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %p
              Hence an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is
              %em projective
              precisely if for all
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi epi
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; A
                    \\\
                    \&amp; &amp; \downarrow^{\mathrlap{epi}}
                    \\\
                    N &amp;\underset{f}{\longrightarrow}&amp; B
                    }
            %p
              where the vertical morphism is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mover
                      %mo →
                      %mi ϕ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} N \overset{\phi}{\to} A
              making a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ϕ
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi epi
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; A
                    \\\
                    \&amp; {}^{\mathllap{\phi}}\nearrow &amp; \downarrow^{\mathrlap{epi}}
                    \\\
                    N &amp;\underset{f}{\longrightarrow}&amp; B
                    }
                    \\,.
          #NProjectiveIFFHomNExact.num_prop
            %h6#proposition Proposition
            %p
              An
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is projective (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ProjectiveModule"}
              %a.existingWikiWord{:href => "/nlab/show/hom+functor"} hom functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi R
                        %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi R
                    %mi Mod
                    %mo →
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{R Mod}(N, - ) : R Mod \to Ab
            %p
              (out of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+functor"} exact functor
          .proof
            %h6#proof Proof
            %p
              The hom-functor in question is a
              %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact functor
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is projective.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_R(N,-)
              is right exact means equivalently that if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi A
                    %mover
                      %mo ⟶
                      %mi i
                    %mi B
                    %mover
                      %mo ⟶
                      %mi p
                    %mi C
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    A
                    \\overset{i}{\longrightarrow}
                    B
                    \\overset{p}{\longrightarrow}
                    C
                    \\to
                    0
                    \\,
            %p
              is any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is any
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              its
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              inclusion, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_R(N,p)
              is an epimorphism, hence that for any element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %msub
                        %mi Hom
                        %mi R
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f \in Hom_R(N,C)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi C
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; B
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    N &amp;\underset{f}{\longrightarrow}&amp; C
                    }
            %p
              there exists a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi N
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \phi \colon N \to B
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %msub
                        %mi Hom
                        %mi R
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi p
                      %mo ∘
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} f =  Hom_R(N,p)(\phi) \coloneqq p \circ \phi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi ϕ
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %munder
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; B
                    \\\
                    \&amp;{}^{\mathllap{\phi}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    N &amp;\underset{f}{\longrightarrow}&amp; C
                    }
                    \\,.
            %p
              This is manifestly the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is projective.
          %h2#properties Properties
          %h3#existence_of_enough_projective_modules Existence of enough projective modules
          #FreeModulesAreProjective.num_lemma
            %h6#lemma Lemma
            %p
              Assuming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ≃
                    %msup
                      %mi R
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N \simeq R^{(S)}
              is projective.
          .proof
            %h6#proof_2 Proof
            %p
              Explicitly: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} S \in Set
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi R
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(S) = R^{(S)}
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} F(S) \to N
              is specified equivalently by a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi S
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : S \to U(N)
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the underlying set of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mo ⊕
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R^{(S)} \simeq \oplus_{s \in S} R
              of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi S
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert S\vert}
              copies of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
            %p
              Accordingly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi N
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \tilde N \to N
              an epimorphism, the underlying function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi N
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(\tilde N) \to U(N)
              is an epimorphism, and the
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              says that we have all lifts
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi N
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ˜
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; U(\tilde N)
                    \\\
                    \&amp; {}^{\tilde f} \nearrow &amp; \downarrow
                    \\\
                    S &amp;\stackrel{f}{\to}&amp; U(N)
                    }
                    \\,.
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              these are equivalently lifts of module homomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi N
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mi R
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi S
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \tilde N
                    \\\
                    \&amp; \nearrow &amp; \downarrow
                    \\\
                    R^{(S)} &amp;\stackrel{}{\to}&amp; N
                    }
                    \\,.
          #FreeForgetfulCounitEpimorphism.num_prop
            %h6#proposition_2 Proposition
            %p
              Assuming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              has
              = succeed ":" do
                %em
                  %a{:href => "projective%20object#EnoughProjectives"} enough projectives
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              there exists an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi N
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} \tilde N \to N
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi N
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde N
              is a projective module.
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(U(N))
              be the
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              on the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(N)
              underlying
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              %a.maruku-ref{:href => "#FreeModulesAreProjective"}
              this is a projective module.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon : F(U(N)) \to N
            %p
              of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (F \dashv U)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
          %p
            Actually, the full axiom of choice is not necessary here; it is enough to have the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/presentation+axiom"} presentation axiom
            %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
            has enough projectives (whereas the axiom of choice states that
            %em every
            set is projective). Then we can replace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(N)
            above by a projective set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ↠
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P \twoheadrightarrow U(N)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                  %mo ↠
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ↠
                  %mi N
                %annotation{:encoding => "application/x-tex"} F(P) \twoheadrightarrow F(U(N)) \twoheadrightarrow N
            (and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(P)
            is projective).
          %h3#explicit_characterizations Explicit characterizations
          %p
            We discuss the more explicit characterization of projective modules as
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct summands
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
          #DirectSummandOfFreeIsProjective.num_lemma
            %h6#lemma_2 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} N \in R Mod
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct summand
              of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ′
                    %mo ∈
                    %mi R
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} N' \in R Mod
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} S \in Set
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi R
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi N
                    %mo ⊕
                    %mi N
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    R^{(S)} \simeq N \oplus N'
                    \\,,
            %p
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is a projective module.
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \tilde K \to K
              be a surjective homomorphism of modules (which is equivalently an epimorphism in the category of modules) and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi N
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} f : N \to K
              a homomorphism. We need to show that there is a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi K
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ˜
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \tilde K
                    \\\
                    \&amp; {}^{\mathllap{\tilde f}}\nearrow &amp; \downarrow
                    \\\
                    N &amp;\stackrel{f}{\to}&amp; K
                    }
                    \\,.
            %p
              By the definition of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi id
                      %mi N
                    %mo :
                    %mi N
                    %mo →
                    %mi N
                    %mo ⊕
                    %mi N
                    %mo ′
                    %mo →
                    %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    id_N : N \to N \oplus N' \to N
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ⊕
                    %mi N
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} N \oplus N'
              is free by assumption, and hence projective by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#FreeModulesAreProjective"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat f
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi K
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi f
                                  %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %mo →
                          %mtd
                            %mi N
                            %mo ⊕
                            %mi N
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi K
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; &amp;&amp; \tilde K
                    \\\
                    \&amp;&amp; &amp; {}^{\mathllap{\hat f}}\nearrow &amp; \downarrow
                    \\\
                    N &amp;\to&amp; N \oplus N'  &amp;\to&amp; K
                    }
                    \\,.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mi N
                    %mo →
                    %mi N
                    %mo ⊕
                    %mi N
                    %mo ′
                    %mover
                      %mo →
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f : N \to N \oplus N' \stackrel{\hat f}{\to} \tilde K
              is a lift of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          #ProjectiveIsPreciselyDirectSummandOfFreeModule.num_prop
            %h6#proposition_3 Proposition
            %p
              An
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is projective precisely if it is a
              %a.existingWikiWord{:href => "/nlab/show/direct+summand"} direct summand
              of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
          .proof
            %h6#proof_5 Proof
            %p
              By lemma
              = succeed "," do
                %a.maruku-ref{:href => "#DirectSummandOfFreeIsProjective"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is a direct summand, then it is projective. So we need to show the converse.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(U(N))
              be the
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              on the
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(N)
              underlying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              as in the proof of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#FreeForgetfulCounitEpimorphism"}
              %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    \\epsilon : F(U(N)) \to N
            %p
              of the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊣
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (F \dashv U)
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is projective, there is a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              as a direct summand of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(U(N))
          %p
            This proposition is often stated more explicitly as the existence of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dual+basis"} dual basis
          %p In some cases, this can be further strengthened:
          .num_prop
            %h6#proposition_4 Proposition
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/principal+ideal+domain"} principal ideal domain
              (in particular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}
              the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
            The details are discussed at
            = succeed "." do
              %em
                %a{:href => "http://ncatlab.org/nlab/show/principal+ideal+domain#StructureTheoryOfModules"} pid - Structure theory of modules
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  is finite locally free, in that there exists a partition
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi f
                          %mi i
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} 1 = \sum_i f_i \in R
                  such that the localized modules
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo{:stretchy => "false"} [
                        %msubsup
                          %mi f
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} P[f_i^{-1}]
                  are finitely generated free modules over
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                          %mo{:stretchy => "false"} [
                          %msubsup
                            %mi f
                            %mi i
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} R[f_i^{-1}]
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  is finitely generated and projective.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                      %annotation{:encoding => "application/x-tex"} P
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
                  in the category of
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                  %a.existingWikiWord{:href => "/nlab/show/modules"} modules
                  (equipped with the tensor product as its monoidal structure).
              %li
                %p
                  There exist elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi x
                          %mi n
                        %mo ∈
                        %mi P
                      %annotation{:encoding => "application/x-tex"} x_1,\ldots,x_n \in P
                  and linear forms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϑ
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi ϑ
                          %mi n
                        %mo ∈
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mo ,
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \vartheta_1,\ldots,\vartheta_n \in Hom(P,R)
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi ϑ
                          %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi x
                          %mi i
                      %annotation{:encoding => "application/x-tex"} x = \sum_i \vartheta_i(x) x_i
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi P
                        %annotation{:encoding => "application/x-tex"} x \in P
          .proof
            %h6#proof_6 Proof
            %p
              The equivalence of 2., 3., and 4. is mostly formal. For the equivalence with 1., see
              %a{:href => "http://math.stackexchange.com/questions/16814/finitely-generated-projective-modules-are-locally-free"} this math.SE discussion
              for good references. Note that the equivalences are true without assuming that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is
              %a.existingWikiWord{:href => "/nlab/show/Noetherian+ring"} Noetherian
              or that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              satisfies some finiteness condition.
          %h3#RelationToProjectiveResolution Relation to projective resolutions of chain complexes
          .num_defn
            %h6#definition_3 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo ∈
                      %mi R
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} N \in R Mod
              %strong
                %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              is a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi N
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ∈
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Q N)_\bullet \in Ch_\bullet(R Mod)
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi N
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"}
                    Q N \to N
            %p
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              regarded as a complex concentrated in degree 0) such that
            %ol
              %li
                %p
                  this morphism is a
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                  (this is what makes it a
                  = succeed ")," do
                    %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ⋯
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mi N
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 1
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mi N
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 0
                        %mo →
                        %mi N
                      %annotation{:encoding => "application/x-tex"} \cdots \to (Q N)_1 \to (Q N)_0 \to N
                %p
                  being an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              %li
                %p
                  all whose entries
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Q
                        %mi N
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi n
                      %annotation{:encoding => "application/x-tex"} (Q N)_n
                  are projective modules.
          .num_remark
            %h6#remark Remark
            %p
              This means precisely that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi N
                    %mo →
                    %mi N
                  %annotation{:encoding => "application/x-tex"} Q N \to N
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              with respect to the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
              (see
              = succeed ")" do
                %a{:href => "model%20structure%20on%20chain%20complexes#StandardQuillenOnBounded"} here
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Every
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
            See
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective resolution
          %h2#examples Examples
          #ModuleOverAFieldIsProjective.num_prop
            %h6#proposition_7 Proposition
            %p
              Assuming the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
              %a.existingWikiWord{:href => "/nlab/show/basis+theorem"} basis theorem
              every module over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              = succeed ")." do
                %a.maruku-ref{:href => "#DirectSummandOfFreeIsProjective"}
          .num_prop
            %h6#proposition_8 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is the ring of
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/division+ring"} division ring
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Schanuel%27s+lemma"} Schanuel's lemma
            %li
