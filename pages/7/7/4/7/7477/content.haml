          %h2#definition Definition
          %p
            A
            %strong completely distributive lattice
            is a
            %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            in which arbitrary
            %a.existingWikiWord{:href => "/nlab/show/joins"} joins
            and arbitrary meets
            %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distribute
            over each other.
          %p
            More formally: given a complete lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            and functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi J
                  %mo →
                  %mi I
                %annotation{:encoding => "application/x-tex"} p: J \to I
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi J
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} f: J \to L
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mrow
                      %mi j
                      %mo ∈
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mrow
                      %mi sections
                      %mspace{:width => "thickmathspace"}
                      %mi s
                      %mo :
                      %mi I
                      %mo →
                      %mi J
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bigwedge_{i \in I} \bigvee_{j \in p^{-1}(i)} f(j) \geq \bigvee_{sections\; s: I \to J} \bigwedge_{i \in I} f(s(i))
          %p
            where “section” means
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi p
                  %annotation{:encoding => "application/x-tex"} f, p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
