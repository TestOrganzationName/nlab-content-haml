            property.
          %h2#properties Properties
          %h3#algebraic_lattices Algebraic lattices
          .num_prop
            %h6#proposition Proposition
            %p
              The category of
              %a.existingWikiWord{:href => "/nlab/show/Alexandroff+locales"} Alexandroff locales
              is equivalent to that of completely distributive
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebraic+lattice"} algebraic lattices
          %p
            This appears as remark 4.3 in (
            %a{:href => "#Caramello11"}> Caramello 2011
            ).
          %h3#completely_distributive_boolean_algebras Completely distributive Boolean algebras
          .num_lemma
            %h6#lemma Lemma
            %p A complete totally ordered poset is completely distributive.
          .proof
            %h6#proof Proof
            %p
              (Note: this uses the
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi j
                        %mo ∈
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi sections
                        %mspace{:width => "thickmathspace"}
                        %mi s
                        %mo :
                        %mi I
                        %mo →
                        %mi J
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \bigwedge_{i \in I} \bigvee_{j \in p^{-1}(i)} f(j) \gt \bigvee_{sections\; s: I \to J} \bigwedge_{i \in I} f(s(i)).
            %p
              Denote the left side by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and the right by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              strictly between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi j
                          %mo ∈
                          %msup
                            %mi p
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo{:stretchy => "false"} )
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \bigvee_{j \in p^{-1}(i)} f(j) \geq x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f(j) \gt y
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo ∈
                      %msup
                        %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j \in p^{-1}(i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f(s(i)) \gt y
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f(s(i)) \geq x
              for this case, so that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi sections
                          %mspace{:width => "thickmathspace"}
                          %mi s
                          %mo :
                          %mi I
                          %mo →
                          %mi J
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mi x
                      %mo &gt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} \bigvee_{sections\; s: I \to J} \bigwedge_{i \in I} f(s(i)) \geq x \gt y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &gt;
                      %mi z
                      %mo &gt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \gt z \gt y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mi z
                  %annotation{:encoding => "application/x-tex"} f(s(i)) \gt z
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≥
