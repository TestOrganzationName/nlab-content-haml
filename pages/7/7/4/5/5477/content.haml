                            %mo{:stretchy => "false"} [
                            %msup
                              %mi C
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                          %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \in [C^{op}, sSet]
                      is degreewise a
                      %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                      of
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representables
                  %li
                    %p
                      the
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                      obtained by replacing each copy of a representable by a point is
                      = succeed "," do
                        %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
                      %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi lim
                              %mo →
                            %mo :
                            %mo{:stretchy => "false"} [
                            %msup
