                            \\lim_\to C(\{U\}) \stackrel{\simeq}{\to} *
                            \\,.
          %h2#properties Properties
          .un_theorem
            %h6#theorem Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf+%28%E2%88%9E%2C1%29-topos"} (∞,1)-sheaf (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
              over locally and globally
              = succeed "-conneted" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/n-localic+%28%E2%88%9E%2C1%29-topos"} 1-localic
              %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} ∞-connected (∞,1)-topos
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Δ
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mi Γ
                        %mover
                          %mo ←
                          %mi Δ
                      %mover
                        %mo →
                        %mi Π
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv \Delta \dashv \Gamma) :
                    Sh_{(\infty,1)}(C)
                    \\stackrel{\stackrel{\Pi}{\to}}{\stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\to}}}
                    \\infty Grpd
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          %p
            To prove this, we we use the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            to
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} present
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi proj
                %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
            for the projective global model structure and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi loc
                %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
            for its
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
            at the set of morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to U
            out of the
            %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            for each covering family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi loc
                    %mo ∘
                %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}^\circ
            for the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            on the fibrant-cofibrant objects. By the discussion at
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi proj
                      %mo ,
                      %mi loc
                    %mo ∘
                %annotation{:encoding => "application/x-tex"}
                  Sh_{(\infty,1)}(C) \simeq [C^{op}, sSet]_{proj, loc}^\circ
          %p
            and the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
          %p To establish these, we proceed by a sequence of lemmas.
          .un_lemma
            %h6#standard_fact Standard fact
            %p The model categories
            %ul
              %li
                %p
                  standard
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi sSet
                            %mi Quillen
                        %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              %li
                %p
                  global
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi C
                            %mi op
                          %mo ,
                          %mi sSet
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mi proj
                              %mo ,
                              %mi loc
                        %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
              %li
                %p
                  local
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi sSet
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi proj
                            %mo ,
                            %mi loc
                      %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
            %p
              are all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+categories"} left proper model categories
          .proof
            %h6#proof Proof
            %p
              The first since all objects are cofibrant. The second by general statements about the global
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localization
              preserves left propernes.
          .un_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family in the
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \in [C^{op}, sSet]
              is a cofibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              both in the projective model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              as well as in the Cech local model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
          .proof
            %h6#proof_2 Proof
            %p
              By assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+simplicial+presheaves#CofibrantObjects"} Dugger's theorem on cofibrant objects
              in the projective model structure this implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(U)
              is cofibrant in the global model structure. By general properties of left
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization
              we have that the cofibrations in the local model structure as the same as in the global one. Finally that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \to U
              is a weak equivalence in the local model structure holds effectively by definition (since we are localizing at these morphisms).
          .un_prop
            %h6#proposition Proposition
            %p
              On a locally and globally
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              the
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mi Γ
                      %mover
                        %mo ←
                        %mi Δ
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    (\Delta \dashv \Gamma) : Sh_{(\infty,1)}(C)
                    \\stackrel{\overset{\Delta}{\leftarrow}}{\underset{\Gamma}{\to}}
                    \\infty Grpd
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
              by the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Const
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mover
                      %mo →
                      %mo ←
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (Const \dashv \Gamma) :  [C^{op}, sSet]_{proj,loc}
                    \\stackrel{\leftarrow}{\to}
                    sSet_{Quillen}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is the functor that evaluates on the point,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mi X
                      %mo =
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Gamma X = X(*)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Const
                  %annotation{:encoding => "application/x-tex"} Const
              is the functor that sends a simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the presheaf constant on that value,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Const
                      %mi S
                      %mo :
                      %mi U
                      %mo ↦
                      %mi S
                    %annotation{:encoding => "application/x-tex"} Const S : U \mapsto S
          .proof
            %h6#proof_3 Proof
            %p
              We use (as described there) that
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              that model the
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            %p
              That we have an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Const
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Const \dashv \Gamma)
              follows for instance by observing that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              has a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              we may think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              as being the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo =
                    %msub
                      %mi lim
                      %mo ←
                  %annotation{:encoding => "application/x-tex"} \Gamma = \lim_\leftarrow
              that takes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %p
              To see that we have a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              first notice that we have a Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Const
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mover
                      %mo →
                      %mo ←
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    (Const \dashv \Gamma) :
                    [C^{op}, sSet]_{proj}
                    \\stackrel{\leftarrow}{\to}
                    sSet_{Quillen}
            %p
              on the global model structure, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              manifestly preserves fibrations and acyclic fibrations there. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
              is
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left proper
              and has the same cofibrations as the global model structure, it follows with
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corollary A.3.7.2
              (see the discussion of
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/show/Quillen+adjunction#sSet"} sSet-Quillen adjunctions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              preserves fibrant objects. But every fibrant object in the local structure is in particular fibrant in the global structure, hence in particular fibrant over the terminal object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %p
              The left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Const
                    %mo :
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} Const : sSet_{Quillen} \to [C^{op},sSet]_{proj}
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
              are computed objectwise), and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stackification"} ∞-stackification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} Id : [C^{op}, sSet]_{proj} \to [C^{op}, sSet]_{proj,loc}
              is a left
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/exact+%28%E2%88%9E%2C1%29-functor"} exact (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Const
                    %mo :
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} Const : sSet_{Quillen} \to [C^{op}, sSet]_{proj,loc}
              preserves finite homotopy limits.
            %p
              This means that our Quillen adjunction does model a
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C) \to \infty Grpd
              %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
              the space of these geometric morphisms to
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
          .proof
            %h6#proof_of_the_theorem Proof of the theorem
            %p
              By general abstract facts the
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Const
                    %mo :
                    %mi sSet
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Const : sSet \to [C^{op}, sSet]
              given on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} S \in sSet
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Const
                      %mi S
                    %mo :
                    %mi U
                    %mo ↦
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Const_S : U \mapsto S
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              has an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mi X
                    %mo ↦
                    %msup
                      %mo ∫
                      %mi U
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mi lim
                      %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi : X \mapsto \int^U X(U) = \lim_\to X
            %p
              naturally in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              operation. Notice that since
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              is itself a
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              (on the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
              is the point (by a simple
              = succeed "-style" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            %p
              Regarded as a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen} \to [C^{op}, sSet]_{proj}
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Const
                  %annotation{:encoding => "application/x-tex"} Const
              manifestly preserves fibrations and acyclic fibrations and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Const
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mover
                      %munder
                        %mo ←
                        %mi Const
                      %mover
                        %mo →
                        %mrow
                          %munder
                            %mi lim
                            %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv Const) : [C^{op}, sSet]_{proj}
                    \\stackrel{\overset{\lim_\to}{\to}}{\underset{Const}{\leftarrow}}
                    sSet_{Quillen}
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} \Pi : [C^{op},sSet]_{proj} \to sSet_{Quillen}
              preserves cofibrations. Since by general properties of left
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization of model categories
              the cofibrations of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [C^{op},sSet]_{proj,loc}
              are the same, also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} \Pi : [C^{op}, sSet]_{proj,loc} \to sSet_{Quillen}
              preserves cofibrations.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper model category
              it follows as before with
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corollary A.3.7.2
              (see the discussion of
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/show/Quillen+adjunction#sSet"} sSet-Quillen adjunctions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Const
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mover
                      %munder
                        %mo ←
                        %mi Const
                      %mover
                        %mo →
                        %mrow
                          %munder
                            %mi lim
                            %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv Const) : [C^{op}, sSet]_{proj,loc}
                    \\stackrel{\overset{\lim_\to}{\to}}{\underset{Const}{\leftarrow}}
                    sSet_{Quillen}
            %p
              to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Const
                  %annotation{:encoding => "application/x-tex"} Const
              preserves fibrant objects. That means that constant simplicial presheaves satisfy
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              along
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              families in the
              = succeed "-cohesive" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and every simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              it must be true that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi Const
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Const
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op}, sSet](U, Const S) \to [C^{op}, sSet](C(U), Const S)
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(U)
              is cofibrant by the above lemma and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Const
                    %mi S
                  %annotation{:encoding => "application/x-tex"} Const S
              is fibrant in the projective structure by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is fibrant. So the simplicial hom-complexes in the above equaltion really are the correct
              = succeed "s.)" do
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-space
            %p
              But that this is the case follows by the condition on the
              = succeed "-cohesive" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              by which
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mo →
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \lim_\to C(U) \simeq *
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Const
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %munder
                      %mi lim
                      %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C^{op}, sSet](C(U), Const S) = sSet(\lim_\to C(U), S) \simeq sSet(*, S) = S
                    \\,.
            %p So we have established that also
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Const
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mover
                      %munder
                        %mo ←
                        %mi Const
                      %mover
                        %mo →
                        %mrow
                          %munder
                            %mi lim
                            %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv Const) : [C^{op}, sSet]_{proj,loc} \stackrel{\overset{\lim_\to}{\to}}{\underset{Const}{\leftarrow}}
                    sSet_{Quillen}
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            %p
              It is clear that the left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              preserves the terminal object: since that is representable by assumption on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj,loc}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕃
                      %msub
                        %mi lim
                        %mo →
                      %mo *
                      %mo =
                      %msub
                        %mi lim
                        %mo →
                      %mo *
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \mathbb{L} \lim_\to * = \lim_\to * = *
          %h2#examples Examples
          .un_prop
            %h6#proposition_2 Proposition
