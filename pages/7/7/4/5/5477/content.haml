                  %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
            %p
              are locally and globally
              = succeed "-connected" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive
          %p
            This implies that
