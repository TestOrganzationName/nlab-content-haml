                          %annotation{:encoding => "application/x-tex"} \lim_\to : [C^{op}, sSet] \to sSet
                      of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                            %mo{:stretchy => "false"} (
