          %h2#idea Idea
          %p
            The concept of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
            %a.existingWikiWord{:href => "/nlab/show/C-star+category"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
              \-categories
            like
            %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebras"} von Neumann algebras
            (aka
            = succeed "-algebras)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
                \-algebras
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi W
                      %mo *
                  %annotation{:encoding => "application/x-tex"} W^\ast
              \-algebroids
            or
            = succeed "." do
              %em von Neumann algebroids
          %h2#definition Definition
          %p
            A
            %strong W*-category
            is a
            %a.existingWikiWord{:href => "/nlab/show/C%2A-category"} C*-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that for any objects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A,B\in C
            %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom(A,B)
            admits a
            %a.existingWikiWord{:href => "/nlab/show/predual"} predual
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Banach+space"} Banach space
            %a.existingWikiWord{:href => "/nlab/show/Banach+space"} Banach space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} Hom(A,B)_*
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} (Hom(A,B)_*)^*
            is isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom(A,B)
            in the category of
            %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/contractive+maps"} contractive maps
            (alias
            = succeed ")." do
              %em short maps
          %h2#wfunctors W*-functors
          %p
            A
            %strong W*-functor
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F\colon C\to D
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} F(f^*)=F(f)^*
            for any
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and the map of
            %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom(A,B)\to Hom(F(A),F(B))
            admits a
            %a.existingWikiWord{:href => "/nlab/show/predual"} predual
            for any objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#bounded_natural_transformation Bounded natural transformation
          %p
            The good notion of natural transformations between W*-categories is given by
            = succeed ":" do
              %strong bounded natural transformations
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} t\colon F\to G
            between W*-functors is bounded if the norm of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mi X
                  %mo{:lspace => "verythinmathspace"} :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t_X\colon F(X)\to G(X)
            is bounded with respect to the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#the_bicategory_of_wcategories The bicategory of W*-categories
          %p
            W*-categories, W*-functors, and bounded natural transformations form a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            is a good setting to work with objects like
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+spaces"} Hilbert spaces
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+W%2A-modules"} Hilbert W*-modules
            over
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebras"} von Neumann algebras
            %a.existingWikiWord{:href => "/nlab/show/W%2A-representations"} W*-representations
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/von+Neumann+algebras"} von Neumann algebras
          %p
            In particular, in this
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            %a.existingWikiWord{:href => "/nlab/show/category+of+Hilbert+spaces"} category of Hilbert spaces
            has infinite
            %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
            (generalizing the definition of a
            %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
            to infinite families of objects), unlike in the usual
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            = succeed "," do
