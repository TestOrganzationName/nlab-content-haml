                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i,j \in I
              are
              %a.existingWikiWord{:href => "/nlab/show/linear+functions"} linear functions
              over each point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} x \in U_i \cap U_j
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              is a bundle morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BundlesAndFibers"}
              %a.existingWikiWord{:href => "/nlab/show/local+trivializations"} local trivializations
              on both sides with respect to which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            %p
              The inclined reader may notice that this makes vector bundles over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (denoted
              = succeed ");" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Vect
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} Vect_{/X}
          #ModuleOfSectionsOfAVectorBundle.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/module"} module
                of
                %a.existingWikiWord{:href => "/nlab/show/sections"} sections
                of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi vb
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{vb}{\to} X
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#VectorBundle"}
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} set of sections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_X(E)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BundlesAndFibers"}
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              by
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              over the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#AlgebraOfSmoothFunctionsOnCartesianSpaces"}
              = succeed "-wise" do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi ℝ
                            %msub
                              %mi Γ
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi Γ
                              %mi X
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo ,
                            %mi s
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ↦
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mi s
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C^\infty(X) \otimes_{\mathbb{R}} \Gamma_X(E) &amp;\longrightarrow&amp; \Gamma_X(E)
                    \\\
                    (f,s) &amp;\mapsto&amp; (x \mapsto f(x) \cdot s(x))
                    }
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi fb
                          %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_1 \overset{fb_1}{\to} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi fb
                          %mn 2
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_2 \overset{fb_2}{\to} X
              two
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi fb
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi fb
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_1 &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; E_2
                    \\\
                    \&amp; {}_{\mathllap{fb_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{fb_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              a vector bundle homomorphism (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
              = succeed ")" do
                %a.maruku-ref{:href => "#Sections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_\ast \;\colon\; \Gamma_X(E_1) \longrightarrow \Gamma_X(E_2)
            %p
              is compatible with this
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              by smooth functions and hence constitutes a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            %p
              The inclined reader may notice that this means that taking
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+sections"} spaces of sections
              yields a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Vect
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %mo ⟶
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_X(-)
                    \\;\colon\;
                    Vect_{/X}
                    \\longrightarrow
                    C^\infty(X) Mod
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/category+of+vector+bundles"} category of vector bundles
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to that over
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(X)
          #TangentVectorFields.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#TrivialBundleOnCartesianSpace"}
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mo ≔
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                            %mo ×
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi tb
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T \mathbb{R}^n &amp;\coloneqq&amp; \mathbb{R}^n \times \mathbb{R}^n
                    \\\
                    \\mathllap{tb}\downarrow &amp;&amp; \downarrow\mathrlap{pr_1}
                    \\\
                    \\mathbb{R}^n &amp;=&amp; \mathbb{R}^n
                    }
            %p
              is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi a
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (x^a)_{a = 1}^n
              the
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoordinateFunctionsAreSmoothFunctions"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi a
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (\partial_a)_{a = 1}^n
              for the corresponding
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sections"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi T
                            %msup
                              %mi ℝ
                              %mi n
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi v
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi tb
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; T \mathbb{R}^n
                    \\\
                    \&amp; {}^{\mathllap{v}}\nearrow&amp; \downarrow\mathrlap{tb}
                    \\\
                    \\mathbb{R}^n &amp;=&amp; \mathbb{R}^n
                    }
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              has a unique expansion of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %msup
                      %mi v
                      %mi a
                    %msub
                      %mo ∂
                      %mi a
                  %annotation{:encoding => "application/x-tex"}
                    v = v^a \partial_a
            %p
              where a sum over indices is understood (
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"}> Einstein summation convention
              ) and where the components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi v
                      %mi a
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (v^a \in C^\infty(\mathbb{R}^n))_{a = 1}^n
              are
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
            %p
              Such a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is also called a smooth
              %em
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector+field"} tangent vector field
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %p
              Each tangent vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              determines a
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              on
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi D
                                  %mi v
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi f
                          %mtd
                            %mo ↦
                          %mtd
