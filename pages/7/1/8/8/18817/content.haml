                  %annotation{:encoding => "application/x-tex"} v
              of parameter length
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              of the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              along
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exp(t v)
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℒ
                        %mi v
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi Ω
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}_v \colon \Omega^\bullet(X) \to \Omega^\bullet(X)
              %a.existingWikiWord{:href => "/nlab/show/anticommutator"} anticommutator
              of the contraction derivation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                  %annotation{:encoding => "application/x-tex"} \iota_v
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#deRhamDifferential"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ℒ
                              %mi v
                          %mtd
                            %mo ≔
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi t
                            %mi exp
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mi v
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mi ω
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %mi t
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mi v
                            %mi d
                            %mi ω
                            %mo +
                            %mi d
                            %msub
                              %mi ι
                              %mi v
                            %mi ω
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{L}_v
                    \&amp;\coloneqq
                    \\frac{d}{d t } \exp(t v)^\ast \omega \vert_{t = 0}
                    \\\
                    \&amp; =
                    \\iota_v d \omega + d \iota_v \omega
                    \\,.
                    \\end{aligned}
          %p
            Finally we turn to the concept of
            %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration of differential forms
            (def.
            %a.maruku-ref{:href => "#IntegrationOfDifferentialFormsOverSmoothSingularChainsInCartesianSpaces"}
            below). First we need to say what it is that differential forms may be integrated over:
          #SingularSimplicesInCartesianSpaces.num_defn
            %h6#definition_14 Definition
            %p
              %strong
                (smooth
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+chains"} singular simplicial chains
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                standard
                %a.existingWikiWord{:href => "/nlab/show/n-simplex"} n-simplex
              in the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mi i
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mo ≤
                      %msup
                        %mi x
                        %mn 1
                      %mo ≤
                      %mi ⋯
                      %mo ≤
                      %msup
                        %mi x
                        %mi n
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta^n
                    \\;\coloneqq\;
                    \\left\{
                    (x^i)_{i = 1}^n
                    \\;\vert\;
                    0 \leq x^1 \leq \cdots \leq x^n
                    \\right\}
                    \\;\subset\;
                    \\mathbb{R}^n
                    \\,.
            %p
              More generally, a
              %em
                smooth
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular n-simplex
              in a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma
                    \\;\colon\;
                    \\mathbb{R}^n
                    \\longrightarrow
                    \\mathbb{R}^k
                    \\,,
            %p to be thought of as a smooth extension of its restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi Δ
                          %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Δ
                      %mi n
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma\vert_{\Delta^n}
                    \\;\colon\;
                    \\Delta^n
                    \\longrightarrow
                    \\mathbb{R}^k
                    \\,.
            %p
              (This is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular
              simplex because there is no condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              be an
              %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
              in any way, in particular
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              may be a
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/singular+chain"} singular chain
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is a
              %a.existingWikiWord{:href => "/nlab/show/formal+linear+combination"} formal linear combination
              of singular
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
            %p
              In particular, given a singular
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
              %em
                %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary
              is a
              %a.existingWikiWord{:href => "/nlab/show/singular+chain"} singular chain
              of singular
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \partial \sigma
          #IntegrationOfDifferentialFormsOverSmoothSingularChainsInCartesianSpaces.num_defn
            %h6#definition_15 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration"}> fiber
                \-
                %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"}> integration of differential forms
                ) over smooth
                %a.existingWikiWord{:href => "/nlab/show/singular+chains"} singular chains
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n(\mathbb{R}^n)
              a
              %a.existingWikiWord{:href => "/nlab/show/differential+n-form"} differential n-form
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DifferentialnForms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mi f
                    %mi d
                    %msup
                      %mi x
                      %mn 1
                    %mo ∧
                    %mi ⋯
                    %mi d
                    %msup
                      %mi x
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = f d x^1 \wedge \cdots d x^n
                    \\,,
            %p
              then its
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration
              over the standard
              %a.existingWikiWord{:href => "/nlab/show/n-simplex"} n-simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n \subset \mathbb{R}^n
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SingularSimplicesInCartesianSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              (e.g.
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Riemann+integral"} Riemann integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mi n
                    %mi ω
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∫
                      %mrow
                        %mn 0
                        %mo ≤
                        %msup
                          %mi x
                          %mn 1
                        %mo ≤
                        %mi ⋯
                        %mo ≤
                        %msup
                          %mi x
                          %mi n
                        %mo ≤
                        %mn 1
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msup
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %msup
                      %mi x
                      %mn 1
                    %mi ⋯
                    %mi d
                    %msup
                      %mi x
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\Delta^n} \omega
                    \\;\coloneqq\;
                    \\underset{0 \leq x^1 \leq \cdots \leq x^n \leq 1}{\int} f(x^1, \cdots, x^n) \, d x^1 \cdots d x^n
                    \\,.
            %p More generally, for
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo ∈
                        %msup
                          %mi Ω
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n(\mathbb{R}^k)
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/differential+n-forms"} differential n-forms
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo =
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mi i
                        %msub
                          %mi c
                          %mi i
                        %msub
                          %mi σ
                          %mi i
                      %annotation{:encoding => "application/x-tex"} C = \underset{i}{\sum} c_i \sigma_i
                  a singular
                  = succeed "-chain" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SingularSimplicesInCartesianSpaces"}
            %p
              in any
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
              %em
                %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the integrations, as above, of the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential forms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PullbackOfDifferentialForms"}
              %a.existingWikiWord{:href => "/nlab/show/n-simplices"} n-simplices
              in the chain:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi C
                    %mi ω
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %msub
                      %mi c
                      %mi i
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi Δ
                          %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi σ
                      %mi i
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_C \omega
                    \\;\coloneqq\;
                    \\underset{i}{\sum}
                    c_i
                    \\int_{\Delta^n} (\sigma_i)^\ast \omega
                    \\,.
            %p
              Finally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              another Cartesian space, then
              %em
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
                of differential forms along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mi C
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U \times C \to U
              is the linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi C
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi dim
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\int_C \;\colon\; \Omega^{\bullet + dim(C)}(U \times C) \longrightarrow \Omega^\bullet(U)
            %p
              which on differential forms of the form
