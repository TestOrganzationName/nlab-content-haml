                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/higher+Lie+theory"} higher Lie theory
              %tr
                %td{:style => "text-align: left;"}
                  %strong
                    needed in
                    %a.existingWikiWord{:href => "/nlab/show/QFT"} QFT
                    for:
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#MinkowskiSpacetime"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
                  %br/
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#DiffeologicalSpaceOfFieldHistories"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+surface"} Cauchy surface
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#CauchySurface"}
                  %br/
                  %a.existingWikiWord{:href => "/nlab/show/perturbation+theory"} perturbation theory
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LocalObservablesOnInfinitesimalNeighbourhood"}
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                  (expl.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#DiracFieldBundle"}
                  %a.existingWikiWord{:href => "/nlab/show/Pauli+exclusion+principle"} Pauli exclusion principle
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+gauge+symmetry"}> infinitesimal gauge symmetry
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
                  %br/
                  (expl.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LocalOffShellBRSTComplex"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#SmoothFunctions
            %strong Abstract coordinate systems
          %p
            What characterizes
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            is that it models
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            on
            = succeed "," do
              %em
                the
                %a.existingWikiWord{:href => "/nlab/show/continuum"} continuum
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %a.existingWikiWord{:href => "/nlab/show/smooth+structure"} smooth structure
            (def.
            %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
            below). We may think of these
            %em
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            as the “abstract
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/coordinate+systems"} coordinate systems
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            between them as the “abstract
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/coordinate+transformations"} coordinate transformations
          %p
            We will eventually consider
            %a{:href => "#FieldBundles"} below
            much more general “
            %a.existingWikiWord{:href => "/nlab/show/smooth+spaces"}> smooth spaces
            ”
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            than just the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^n \to X
            mapping a Cartesian space smoothly into them. All structure on
            %a.existingWikiWord{:href => "/nlab/show/generalized+smooth+spaces"} generalized smooth spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is thereby reduced to
            %em compatible systems
            of structures on just
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f\colon \mathbb{R}^n \to X
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/functorial+geometry"} functorial geometry
          %p
            Notice that the popular concept of a
            %em
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            (def./prop.
            %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
            below) is essentially that of a
            %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            which
            %em locally looks just like
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^n \to X
            which are (
            %a.existingWikiWord{:href => "/nlab/show/open+map"}> open
            )
            %em
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            onto their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/images"} images
            %em fix
            such local coordinate identifications
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/functorial+geometry"} functorial geometry
            we do not even focus attention on those
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^n \to X
            that are isomorphisms onto their image, but consider
            %em all
            “probes” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            by “abstract coordinate systems”. This makes
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            both simpler as well as more powerful. The analogous insight for
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            is due to
            = succeed ";" do
              %a{:href => "functorial+geometry#Grothendieck65"} Grothendieck 65
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            by
            = succeed "." do
              %a{:href => "synthetic+differential+geometry#Lawvere67"} Lawvere 67
          %p
            This allows to combine the best of two superficially disjoint worlds: On the one hand we may reduce all constructions and computations to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            literature; on the other hand we have full conceptual control over the coordinate-free generalized spaces analyzed thereby. What makes this work is that all
            = succeed "-constructions" do
              %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            %em
              %a.existingWikiWord{:href => "/nlab/show/functorial+geometry"} functorially
            considered over all abstract coordinate systems.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #CartesianSpacesAndSmoothFunctionsBetweenThem.num_defn
            %h6#definition Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
                and
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                between them)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              we say that the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              of
              %a.existingWikiWord{:href => "/nlab/show/n-tuples"} n-tuples
              of
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              is a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    x^k \;\colon\; \mathbb{R}^n \longrightarrow \mathbb{R}
            %p
              which send an
              %a.existingWikiWord{:href => "/nlab/show/n-tuple"} n-tuple
              of real numbers to the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mi ⋯
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} k \in \{1, \cdots, n\}
            %p For
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; \mathbb{R}^{n} \longrightarrow \mathbb{R}^{n'}
            %p
              any
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              along the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial f}{\partial x^k}
                    \\;\colon\;
                    \\mathbb{R}^{n}
                    \\longrightarrow
                    \\mathbb{R}^{n'}
                    \\,.
            %p
              If this exists, we may in turn ask that the
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              of the partial derivative exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mo ∂
                          %mn 2
                        %mi f
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                        %mo ∂
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                    %mo ≔
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\partial^2 f}{\partial x^{k_1} \partial x^{k_2}}
                    \\coloneqq
                    \\frac{\partial}{\partial x^{k_2}} \frac{\partial f}{\partial x^{k_1}}
            %p and so on.
            %p
              A general higher
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              obtained this way is, if it exists, indexed by an
              %a.existingWikiWord{:href => "/nlab/show/n-tuple"} n-tuple
              of
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi ℕ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \alpha \in \mathbb{N}^n
              and denoted
            #eq:PartialDerivativeWithManyIndices.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mo ∂
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi α
                            %mo{:stretchy => "false"} |
                        %mi f
                      %mrow
                        %msup
                          %mo ∂
                          %mrow
                            %msub
                              %mi α
                              %mn 1
                        %msup
                          %mi x
                          %mn 1
                        %msup
                          %mo ∂
                          %mrow
                            %msub
                              %mi α
                              %mn 2
                        %msup
                          %mi x
                          %mn 2
                        %mi ⋯
                        %msup
                          %mo ∂
                          %mrow
                            %msub
                              %mi α
                              %mi n
                        %msup
                          %mi x
                          %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\alpha
                    \\;\coloneqq\;
                    \\frac{
                    \\partial^{\vert \alpha \vert} f
                    }{
                    \\partial^{\alpha_1} x^1
                    \\partial^{\alpha_2} x^2
                    \\cdots
                    \\partial^{\alpha_n} x^n
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi n
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                    %msub
                      %mi α
                      %mi i
                  %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert} \coloneqq \underoverset{n}{i = 1}{\sum} \alpha_i
              is the total
              %em order
              of the partial derivative.
            %p
              If all partial derivative to all orders
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi ℕ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \alpha \in \mathbb{N}^n
              of a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mi n
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^n \to \mathbb{R}^{n'}
              exist, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is called a
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          %p
            Of course the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∘
                  %mi f
                %annotation{:encoding => "application/x-tex"} g \circ f
            of two smooth functions is again a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                          %mo ↗
                        %mtd
                        %mtd
                          %msup
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi g
                      %mtr
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                        %mtd
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %mi g
                              %mo ∘
                              %mi f
                        %mtd
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %msub
                                %mi n
                                %mn 3
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbb{R}^{n_2}
                  \\\
                  \&amp; {}^{\mathllap{f}}\nearrow &amp;&amp; \searrow^{\mathrlap{g}}
                  \\\
                  \\mathbb{R}^{n_1}
                  \&amp;&amp; \underset{g \circ f}{\longrightarrow} &amp;&amp;
                  \\mathbb{R}^{n_3}
                  }
                  \\,.
          %p
            The inclined reader may notice that this means that
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            with
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            between them constitute a
            %em
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            (“
            %a.existingWikiWord{:href => "/nlab/show/CartSp"}> CartSp
            ”); but the reader not so inclined may ignore this.
          %p
            For the following it is useful to think of each
