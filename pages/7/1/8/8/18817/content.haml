              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msup
                      %mi x
                      %mi a
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (d x^a)_{a = 1}^n
              as a
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
              for the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              are equivalently the
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sections"}
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              (example
              = succeed "," do
                %a.maruku-ref{:href => "#TrivialBundleOnCartesianSpace"}
              = succeed ")" do
                %a.maruku-ref{:href => "#VectorBundle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi T
                              %mo *
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mo ≔
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                            %mo ×
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi cb
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi pr
                                  %mn 1
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi ℝ
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T^\ast \mathbb{R}^n &amp;\coloneqq&amp; \mathbb{R}^n \times (\mathbb{R}^n)^\ast
                    \\\
                    \\mathllap{cb}\downarrow &amp;&amp; \downarrow\mathrlap{pr_1}
                    \\\
                    \\mathbb{R}^n &amp;=&amp; \mathbb{R}^n
                    }
            %p
              called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#Differential1FormsOnCartesianSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Γ
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mo *
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^1(\mathbb{R}^n) = \Gamma_{\mathbb{R}^n}(T^\ast \mathbb{R}^n)
                    \\,.
            %p
              This amplifies via example
              %a.maruku-ref{:href => "#ModuleOfSectionsOfAVectorBundle"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^1(\mathbb{R}^n)
              has the
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              of a
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              over the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^n)
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              with
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            %ol
              %li
                %p
                  The set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Omega^1(\mathbb{R}^k)
                  of
                  %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
                  in a
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Differential1FormsOnCartesianSpaces"}
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                  with addition given by componentwise addition
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                            %mtr
                              %mtd
                                %mi ω
                                %mo +
                                %mi λ
                              %mtd
                                %mo =
                                %msub
                                  %mi ω
                                  %mi i
                                %mi d
                                %msup
                                  %mi x
                                  %mi i
                                %mo +
                                %msub
                                  %mi λ
                                  %mi i
                                %mi d
                                %msup
                                  %mi x
                                  %mi i
                            %mtr
                              %mtd
                              %mtd
                                %mo =
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi ω
                                  %mi i
                                %mo +
                                %msub
                                  %mi λ
                                  %mi i
                                %mo{:stretchy => "false"} )
                                %mi d
                                %msup
                                  %mi x
                                  %mi i
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        \\begin{aligned}
                        \\omega + \lambda &amp; =
                        \\omega_i d x^i + \lambda_i d x^i
                        \\\
                        \&amp; = (\omega_i + \lambda_i) d x^i
                        \\end{aligned}
                        \\,,
              %li
                %p
                  The abelian group
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Omega^1(\mathbb{R}^k)
                  is naturally equipped with the structure of a
                  %a.existingWikiWord{:href => "/nlab/show/module"} module
                  over the
                  %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of
                  %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^k)
                  (example
                  = succeed ")," do
                    %a.maruku-ref{:href => "#AlgebraOfSmoothFunctionsOnCartesianSpaces"}
                  %a.existingWikiWord{:href => "/nlab/show/action"} action
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi Ω
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^k) \times\Omega^1(\mathbb{R}^k) \to \Omega^1(\mathbb{R}^k)
                  is given by componentwise multiplication
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ⋅
                        %mi ω
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ⋅
                        %msub
                          %mi ω
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mi d
                        %msup
                          %mi x
                          %mi i
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        f \cdot \omega = ( f \cdot \omega_i) d x^i
                        \\,.
            %p
              Accordingly there is a canonical pairing between
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              and
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#TangentVectorFields"}
            #eq:PairingVectorFieldsWithDifferential1Forms.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mo{:stretchy => "false"} (
                            %mi T
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mi ℝ
                            %msub
                              %mi Γ
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mi n
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mo *
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi ι
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi ω
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi ι
                                  %mi v
                                %mi ω
                                %mo ≔
                                %msup
                                  %mi v
                                  %mi a
                                %msub
                                  %mi ω
                                  %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_{\mathbb{R}^n}(T \mathbb{R}^n)
                    \\otimes_{\mathbb{R}}
                    \\Gamma_{\mathbb{R}^n}(T \ast \mathbb{R}^n)
                    \&amp;\overset{\iota_{(-)}(-) }{\longrightarrow}&amp;
                    C^\infty(\mathbb{R}^n)
                    \\\
                    (v,\omega)
                    \&amp;\mapsto&amp;
                    \\mathrlap{
                    \\iota_v \omega \coloneqq v^a \omega_a
                    }
                    }
            %p
              With
              %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
              in hand, we may collect all the first-order
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              into a single object: the
              %em
                %a.existingWikiWord{:href => "/nlab/show/exterior+derivative"} exterior derivative
              or
              %em
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
            #eq:deRhamDifferentialOnFunctionsOnCartesianSpace.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mn ∞
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi d
                          %mtd
                            %msup
                              %mi Ω
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi f
                          %mtd
                            %mo ↦
                          %mtd
                            %mpadded{:width => "0"}
                              %mrow
                                %mi d
                                %mi f
                                %mo ≔
                                %mfrac
                                  %mrow
                                    %mo ∂
                                    %mi f
                                  %mrow
                                    %mo ∂
                                    %msup
                                      %mi x
                                      %mi a
                                %mi d
                                %msup
                                  %mi x
                                  %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C^\infty(\mathbb{R}^n) &amp;\overset{d}{\longrightarrow}&amp; \Omega^1(\mathbb{R}^n)
                    \\\
                    f &amp;\mapsto&amp; \mathrlap{ d f \coloneqq \frac{\partial f}{ \partial x^a} d x^a }
                    }
                    \\,.
            %p
              Under the above pairing with
              %a.existingWikiWord{:href => "/nlab/show/tangent+vector+fields"} tangent vector fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              this yields the particular
              %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
              along
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %mi d
                    %mi f
                    %mo =
                    %msub
                      %mi D
                      %mi v
                    %mi f
                    %mo =
                    %msup
                      %mi v
                      %mi a
                    %mfrac
                      %mrow
                        %mo ∂
                        %mi f
                      %mrow
                        %mo ∂
                        %msup
                          %mi x
                          %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_v d f = D_v f = v^a \frac{\partial f}{\partial x^a}
                    \\,.
          %p
            We think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} d  x^i
            as a measure for
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
            displacements along the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x^i
            %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            and a smooth function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mover
                        %mi n
                        %mo{:stretchy => "false"} ˜
                    %mo →
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^{\tilde n} \to \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mover
                      %mi n
                      %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{\tilde n}
            by sending whatever happens there first with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            and then applying the given measure there. This is captured by the following definition:
          #PullbackOfDifferential1FormsOnCartesianSpaces.num_defn
            %h6#definition_10 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"}> pullback of differential 1-forms
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mover
                        %mi k
                        %mo{:stretchy => "false"} ˜
                    %mo →
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \phi \colon \mathbb{R}^{\tilde k} \to \mathbb{R}^k
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %strong
                %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback of differential 1-forms
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mover
                        %mi k
                        %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
