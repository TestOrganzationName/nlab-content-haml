                    %mn 0
                    %mphantom
                      %mi AAAA
                    %mtext for all
                    %mspace{:width => "thinmathspace"}
                    %mi x
                    %mo ∈
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    det
                    \\left(
                    \\array{
                    \\frac{\partial f^1}{\partial x^1}(x)
                    \&amp;\cdots&amp;
                    \\frac{\partial f^n}{\partial x^1}(x)
                    \\\
                    \\vdots &amp;&amp; \vdots
                    \\\
                    \\frac{\partial f^1}{\partial x^n}(x)
                    \&amp;\cdots&amp;
                    \\frac{\partial f^n}{\partial x^n}(x)
                    }
                    \\right)
                    \\;\neq\;
                    0
                    \\phantom{AAAA}
                    \\text{for all} \, x \in \mathbb{R}^n
                    \\,.
            %p
              If the function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is both a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+diffeomorphism"} local diffeomorphism
              %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
              then we call it an
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/open+embedding"} open embedding
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mi n
                    %mover
                      %mo ↪
                      %mrow
                        %mphantom
                          %mi A
                        %mi et
                        %mphantom
                          %mi A
                    %msup
                      %mi ℝ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\;
                    \\mathbb{R}^n \overset{\phantom{A}et\phantom{A}}{\hookrightarrow} \mathbb{R}^n
                    \\,.
          #DifferentiablyGoodOpenCover.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/differentiably+good+open+cover"} differentiably good open cover
              is
            %ul
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mrow
                            %mo {
                            %msup
                              %mi ℝ
                              %mi n
                            %munderover
                              %mo ↪
                              %mi et
                              %mrow
                                %mphantom
                                  %mi AA
                                %msub
                                  %mi f
                                  %mi i
                                %mphantom
                                  %mi AA
                            %msup
                              %mi ℝ
                              %mi n
                            %mo }
                          %mrow
                            %mi i
                            %mo ∈
                            %mi I
                      %annotation{:encoding => "application/x-tex"}
                        \\left\{
                        \\mathbb{R}^n
                        \\underoverset{et}{\phantom{AA}f_i\phantom{AA}}{\hookrightarrow}
                        \\mathbb{R}^n
                        \\right\}_{i \in I}
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/open+embeddings"} open embeddings
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LocalDiffeomorphismBetweenCartesianSpaces"}
            %p
              such that the
              %a.existingWikiWord{:href => "/nlab/show/images"} images
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ≔
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    U_i \coloneqq im(f_i) \subset \mathbb{R}^n
            %p satisfy:
            %ol
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"}> open cover
                  ) every point of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                  is contained in at least one of the
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} U_i
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/good+open+cover"}> good
                  ) all
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                  %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mn 1
                        %mo ∩
                        %mi ⋯
                        %mo ∩
                        %msub
                          %mi U
                          %mrow
                            %msub
                              %mi i
                              %mi k
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} U_{i_1} \cap \cdots \cap U_{i_k} \subset \mathbb{R}^n
                  are either
                  %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
                  or themselves images of
                  %a.existingWikiWord{:href => "/nlab/show/open+embeddings"} open embeddings
                  according to def.
                  = succeed "." do
                    %a.maruku-ref{:href => "#LocalDiffeomorphismBetweenCartesianSpaces"}
            %p
              The inclined reader may notice that the concept of
              %a.existingWikiWord{:href => "/nlab/show/differentiably+good+open+covers"} differentiably good open covers
              from def.
              %a.maruku-ref{:href => "#DifferentiablyGoodOpenCover"}
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              on the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %em
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              of
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              with
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              between them, making it a
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/site"} site
          %p
            (
            %a.existingWikiWord{:href => "/schreiber/show/Cech+Cocycles+for+Differential+characteristic+Classes"}> Fiorenza-Schreiber-Stasheff 12, def. 6.3.9
            )
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#BundlesAndSections
            %strong
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
          %p
            Given any context of
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            and
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            between them, such as the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            from def.
            %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
            it is of interest to fix one
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and consider other objects
            %em
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} parameterized over
            it. These are called
            %em
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#BundlesAndFibers"}
            %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
            in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
          %p
            Of course the theory of bundles is mostly trivial over Cartesian spaces; it gains its main interest from its generalization to more general
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            (def./prop.
            %a.maruku-ref{:href => "#SmoothManifoldInsideDiffeologicalSpaces"}
            below). It is still worthwhile for our development to first consider the relevant concepts in this simple case first.
          %p
            For more exposition see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundles+in+physics"} fiber bundles in physics
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          #BundlesAndFibers.num_defn
            %h6#definition_4 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/bundles"}> bundles
                )
            %p
              We say that a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              just to amplify that we think of it as exhibiting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              as being a “space over
              = succeed "\u201D:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi fb
                        %mtr
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E
                    \\\
                    \\downarrow\mathrlap{fb}
                    \\\
                    X
                    }
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              a point, we say that the
              %em
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              of this
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is the
              %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
            #eq:FiberOfAFiberBundle.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi x
                    %mo ≔
                    %msup
                      %mi fb
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    E_x \coloneqq fb^{-1}(\{x\}) \subset E
            %p
              of the point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              under the smooth function. We think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fb
                  %annotation{:encoding => "application/x-tex"} fb
              as exhibiting a “smoothly varying” set of
              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              spaces over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Given two
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi fb
                          %mn 1
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_1 \overset{fb_1}{\to} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi fb
                          %mn 2
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_2 \overset{fb_2}{\to} X
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                of bundles
              between them is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon E_1 \to E_2
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianSpacesAndSmoothFunctionsBetweenThem"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi fb
                      %mn 2
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi fb
                      %mn 1
                    %mphantom
                      %mi AAAA
                    %mtext i.e.
                    %mphantom
                      %mi AAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mn 1
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                          %mtd
                            %msub
                              %mi E
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi fb
                                    %mn 1
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi fb
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    fb_2  \circ f = fb_1
                    \\phantom{AAAA}
                    \\text{i.e.}
                    \\phantom{AAA}
                    \\array{
                    E_1 &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; E_2
                    \\\
                    \&amp; {}_{\mathllap{fb_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{fb_2}}
                    \\\
                    \&amp;&amp; X
                    }
                    \\,.
            %p
              Hence a bundle homomorphism is a smooth function that sends
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              to
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              over the same point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi x
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f\left(
                    (E_1)_x
                    \\right)
                    \\;\subset\;
                    (E_2)_x
                    \\,.
            %p
              The inclined reader may notice that this defines a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/bundles"} bundles
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CartSp
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} CartSp_{/X}
          #Sections.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/sections"}> sections
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} X
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BundlesAndFibers"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/section"} section
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} s \colon X \to E
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fb
                    %mo ∘
                    %mi s
                    %mo =
                    %msub
                      %mi id
                      %mi X
                    %mphantom
                      %mi AAAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi s
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi fb
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo =
                          %mtd
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    fb \circ s = id_X
                    \\phantom{AAAAA}
                    \\array{
                    \&amp;&amp; E
                    \\\
                    \&amp;
                    {}^{\mathllap{s}}\nearrow
                    \&amp; \downarrow\mathrlap{fb}
                    \\\
                    X &amp;=&amp; X
                    }
                    \\,.
            %p
              This means that
