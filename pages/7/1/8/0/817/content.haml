                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                  which is
                %p
                  also
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
