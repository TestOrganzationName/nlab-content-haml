                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(\mathbf{X},\mathbf{V})
          %p
            A common kind of example are categories of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
            in an ordinary
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Func(\Delta^{op}, C)
            on the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            – which one wants to regard not just enriched in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Func
