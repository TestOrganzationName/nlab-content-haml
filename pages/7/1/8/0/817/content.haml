                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ≡
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} Func(\Delta^{op}, Set) \,\equiv\,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
          %p
            We may bootstrap the discussion of this situation by first considering the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
