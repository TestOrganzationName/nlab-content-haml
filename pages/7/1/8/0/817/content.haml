                  be a
                  %a.existingWikiWord{:href => "/nlab/show/bicomplete+category"} bicomplete
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
