                  %mstyle{:mathvariant => "bold"}
                    %mi X
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Func(\mathbf{X},\mathbf{V})
            is closed monoidal under the
            = succeed "-objectwise" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{V}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi V
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{V} =
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            this reduces to the statement of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
          %p
          #EnhancedEnichmentFormulas.num_prop
            %h6 Proposition
            %p Let
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
