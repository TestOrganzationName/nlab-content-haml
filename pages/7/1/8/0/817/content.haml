          %h2#idea Idea
          %p
            In the context of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            (with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            any suitable
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/cosmos+for+enrichment"} cosmos for enrichment
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi D
                %annotation{:encoding => "application/x-tex"} \mathbf{D}
            a
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                \-enriched categories
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are the
                %a.existingWikiWord{:href => "/nlab/show/enriched+functors"} enriched functors
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:lspace => "verythinmathspace"} :
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi D
                      %annotation{:encoding => "application/x-tex"} F \colon \mathbf{C} \longrightarrow \mathbf{D}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi F
                      %mo ⇒
                      %mi F
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \eta \colon F \Rightarrow F'
                are the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformations"} enriched natural transformations
          %p
            This notion is a generalization of the plain notion of the
            %em
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+small+categories"} locally small categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ≡
                %annotation{:encoding => "application/x-tex"} V \equiv
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            equipped with its
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
          %p
            As such one may and does call this ordinary category the “enriched functor category” between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \mathbf{D}
          %p
            However, this category of enriched functors canonically enhances further to a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            itself, hence to an “enriched-functor enriched-category”, then traditionally often denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi D
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathbf{C}, \mathbf{D}]
