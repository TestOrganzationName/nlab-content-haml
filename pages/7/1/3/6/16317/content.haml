              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruples"} adjoint quadruples
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
