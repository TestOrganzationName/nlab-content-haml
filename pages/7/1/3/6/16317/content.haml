          %h2#idea Idea
          %p
            The concept of
            %em
              super smooth
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            or
            %em
              super smooth
              %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
            is the combination of
            %em
              %a.existingWikiWord{:href => "/nlab/show/super+%E2%88%9E-groupoid"} super ∞-groupoid
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            of smooth super-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-groupoids is a context that realizes
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
          %p
            Super smooth
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+groups"} super Lie groups
            and their
            %a.existingWikiWord{:href => "/nlab/show/deloopings"} deloopings
            etc. Under
            %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
            these map to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+L-%E2%88%9E+algebras"} super L-∞ algebras
          %h2#definition Definition
          %p
            We consider one of at least two possible definitions, that differ (only) in some fine technical detail. The other is at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/smooth+super+infinity-groupoid"} smooth super infinity-groupoid
          .num_defn
            %h6#definition_2 Definition
            %p Write
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                  for the site of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+spaces"} Cartesian spaces
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi InfPoint
                        %mo ≔
                        %msup
                          %mi WAlg
                          %mi op
                      %annotation{:encoding => "application/x-tex"} InfPoint \coloneqq WAlg^{op}
                  for the category of first-order
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
                  (i.e. the
                  %a.existingWikiWord{:href => "/nlab/show/abstract+duality"} formal duals
                  of
                  %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
                  over the
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                        %mo ⊕
                        %mi V
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}\oplus V
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  a finite-dimensional square-0
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/nilpotent+ideal"} nilpotent ideal
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SuperPoint
                        %mo ≔
                        %msubsup
                          %mi WAlg
                          %mi super
                          %mi op
                      %annotation{:encoding => "application/x-tex"} SuperPoint \coloneqq WAlg_{super}^{op}
                  for the category of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/superpoints"} superpoints
                  %a.existingWikiWord{:href => "/nlab/show/formal+duals"} formal duals
                  to commutative
                  %a.existingWikiWord{:href => "/nlab/show/superalgebras"} superalgebras
                  which are super-
                  %a.existingWikiWord{:href => "/nlab/show/Weil+algebras"}> Weil algebras
                  \.
            %p
              There are then “semidirect product” sites
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                    %mo ⋊
                    %mi InfinPoint
                  %annotation{:encoding => "application/x-tex"} CartSp \rtimes InfinPoint
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CartSp
                    %mo ⋊
                    %mi SuperPoint
                  %annotation{:encoding => "application/x-tex"} CartSp \rtimes SuperPoint
              (whose objects are
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              of the given form inside
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+supergeometry"} synthetic differential supergeometry
              and whose morphisms are all morphisms in that context (not just the product morphisms)).
            %p Set then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSmooth
                    %mn ∞
                    %mi Grpd
                    %mo ≔
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo ⋊
                    %mi InfPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    FormalSmooth\infty Grpd \coloneqq Sh_\infty(CartSp \rtimes InfPoint)
            %p
              for the collection of
              %a.existingWikiWord{:href => "/nlab/show/formal+smooth+%E2%88%9E-groupoids"} formal smooth ∞-groupoids
              (see there) and finally
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SuperSmooth
                    %mn ∞
                    %mi Grpd
                    %mo ≔
                    %msub
                      %mi Sh
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo ⋊
                    %mi SuperPoint
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    SuperSmooth\infty Grpd \coloneqq Sh_\infty(CartSp \rtimes SuperPoint)
            %p
              for that of super smooth
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %h2#properties Properties
          %h3#Cohesion Cohesion
          #SequenceOfSites.num_remark
            %h6#remark Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              in question are alternatingly (co-)
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"} reflective subcategories
              of each other (we always display
              %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
              above their right adjoints)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mover
                      %mo ↪
                      %mo ⟵
                    %mi CartSp
                    %mover
                      %mo ⟵
                      %mo ↪
                    %mi CartSp
                    %mo ⋊
                    %mi InfPoint
                    %mover
                      %mover
                        %mo ⟵
                        %mo ↪
                      %mo ⟵
                    %mi CartSp
                    %mo ⋊
                    %mi SuperPoint
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ast
                    \\stackrel{\longleftarrow}{\hookrightarrow}
                    CartSp
                    \\stackrel{\hookrightarrow}{\longleftarrow}
                    CartSp\rtimes InfPoint
                    \\stackrel{\longleftarrow}{\stackrel{\hookrightarrow}{\longleftarrow}}
                    CartSp \rtimes SuperPoint
                    \\,.
            %p Here
            %ul
              %li
                %p
                  the first inclusion picks the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^0
              %li
                %p
                  the second inclusion is that of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/reduced+objects"} reduced objects
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/reduction"} reduction
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/reduced+algebra"} reduced algebra
              %li
                %p
                  the third inclusion is that of even-graded algebras, the reflection sends a
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℤ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                  = succeed "." do
                    %em
                      %a{:href => "super+algebra#AdjointsToInclusionOfPlainAlgebra"} superalgebra – Adjoints to the inclusion of plain algebras
          .num_remark
            %h6#remark_2 Remark
            %p
              Passing to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-categories of (∞,1)-sheaves
              = succeed "," do
