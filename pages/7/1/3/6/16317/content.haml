          .proof
            %h6#proof Proof
            %p
              All the sites are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+sites"} ∞-cohesive sites
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-topos"} cohesive (infinity,1)-topos
              = succeed "," do
                %a{:href => "differential+cohesive+%28infinity%2C1%29-topos#PresentationOnInfinitesimalNeighbourhoodSites"} ∞-cohesive neighbourhood site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Smooth
                    %mn ∞
                    %mi Gpd
                    %mo ↪
                    %mi SuperFormalSmooth
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Smooth\infty Gpd\hookrightarrow SuperFormalSmooth\infty Grpd
              exhibits
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
            %p
              With this the rightmost adjoint quadruple gives the
              %a.existingWikiWord{:href => "/nlab/show/Aufhebung"} Aufhebung
