            %em Yang-Mills-Higgs action functional
            (or
            = succeed ")" do
              %em YMH action functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi YMH
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Ad
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
