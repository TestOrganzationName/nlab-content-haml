              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(b)
              is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} b=\ast
              (we get this fact from regularity, together with a point
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x:X(\ast)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+homotopy+type+theory"} equivalence
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi b
                        %mo :
                        %mi BG
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{b:BG} P(b)
            %p
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible+type"} contractible
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mo{:stretchy => "false"} ‖
                    %mi P
                    %mo =
                    %mi X
                    %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} t : \| P = X \|
              to obtain the proof.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a principal homogeneous space on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo :
                        %mi G
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi g
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} \sum_{(g:G)} g_\ast(x)=y
              is contractible for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo :
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x,y:X(\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{X}
              is regular, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is regular.
          .proof
            %h6#proof_3 Proof
            %p
              Again, we first show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X(\ast)
              is
              %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} merely
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+type"} inhabited
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{X}
              has center of contraction
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ,
                      %msub
                        %mi p
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (P,p_0)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi P
                    %mo =
                    %mi X
                    %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} \|P=X\|
              and since we are proving a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo =
                      %mi X
                    %annotation{:encoding => "application/x-tex"} P=X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} \|X(\ast)\|
              follows from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 0
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_0:P(\ast)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a mere proposition, so we get to use
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo :
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x_0:X(\ast)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo ,
                      %msub
                        %mi x
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\ast,x_0)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo :
                        %mi BG
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo :
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo :
                        %mi b
                        %mo =
                        %mo *
                        %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} trans
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \prod_{(b:BG)} \prod_{(x:X(b))} \sum_{(\alpha : b=\ast)} \mathrm{trans}(\alpha,x) = x_0
              \.
            %p Of course, it would suffice to prove the stronger statement
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo :
                        %mi BG
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo :
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} isContr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi α
                        %mo :
                        %mi b
                        %mo =
                        %mo *
                        %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} trans
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{(b:BG)} \prod_{(x:X(b))} \mathrm{isContr} (\sum_{(\alpha : b=\ast)} \mathrm{trans}(\alpha,x) = x_0)
              \.
            %p
              However, now we get to use that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BG
                  %annotation{:encoding => "application/x-tex"} BG
              is connected. Therefore it suffices to show that
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                    %mi isContr
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi α
                        %mo :
                        %mi G
                    %mi{:mathvariant => "normal"} trans
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{x:X(*)} isContr (\sum_{\alpha : G} \mathrm{trans}(\alpha,x) = x_0)
            %p This holds by assumption.
