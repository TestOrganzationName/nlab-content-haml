            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasi-categories"} model structure for quasi-categories
          %p
            For more see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/relation+between+sSet-enriched+categories+and+quasi-categories"} relation between sSet-enriched categories and quasi-categories
