                  %a{:href => "https://press.princeton.edu/titles/8957.html"} pup:8957
                = succeed "&rbrack;" do
                  %a{:href => "https://www.math.ias.edu/~lurie/papers/HTT.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,2)
