          #InRealNumbers.num_defn
            %h6#definition_2 Definition
            %p
              %strong (pointwise continuous function in the real numbers)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              be the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℝ
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ∈
                    %mi ℝ
                    %mo{:stretchy => "false"} |
                    %mn 0
                    %mo &lt;
                    %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{+} \coloneqq \{a \in \mathbb{R} \vert 0 \lt a\}
            %p
              be the positive elements in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f:\mathbb{R} \to \mathbb{R}
              is
              %strong continuous at a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
              if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isContinuousAt
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo ∀
                    %mi ϵ
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo .
                    %mo ∃
                    %mi δ
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo .
                    %mo ∀
                    %mi x
                    %mo ∈
                    %mi ℝ
                    %mo .
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} |
                    %mi x
                    %mo −
                    %mi c
                    %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mi δ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} |
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isContinuousAt(f, c) \coloneqq \forall \epsilon \in \mathbb{R}_{+}. \exists \delta \in \mathbb{R}_{+}. \forall x \in \mathbb{R}. (\vert x - c \vert \lt \delta) \to (\vert f(x) - f(c) \vert \lt \epsilon)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %strong pointwise continuous
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              if it is continuous at all points
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi isPointwiseContinuous
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo ∀
                    %mi c
                    %mo ∈
                    %mi ℝ
                    %mo .
                    %mi isContinuousAt
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} isPointwiseContinuous(f) \coloneqq \forall c \in \mathbb{R}. isContinuousAt(f, c)
          #BetweenArchimedeanOrderedFields.num_defn
            %h6#definition_3 Definition
            %p
              %strong (pointwise continuous function between Archimedean ordered fields)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
