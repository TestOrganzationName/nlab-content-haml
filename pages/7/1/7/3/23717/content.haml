                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \prod_{a:X} \prod_{\epsilon:\mathrm{R}_+} \sum_{\delta:\mathbb{R}_+} \prod_{b:X} (\delta_X(a, b) \lt \delta) \to (\delta_Y(f(a), f(b)) \lt \epsilon)
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/type+theoretic+axiom+of+choice"} type theoretic axiom of choice
              %a.existingWikiWord{:href => "/nlab/show/dependent+function+types"} dependent function types
              over
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
            %blockquote
              %p
                There exists as structure a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo :
                      %mi X
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} R
                        %mo +
                      %mo →
                      %msub
                        %mi{:mathvariant => "normal"} R
                        %mo +
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega:X \to (\mathrm{R}_+ \to \mathrm{R}_+)
                such that for all elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo :
                        %mi X
                      %annotation{:encoding => "application/x-tex"} a:X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
                and for all elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo :
                        %mi X
                      %annotation{:encoding => "application/x-tex"} b:X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \delta_Y(f(a), f(b))
                is less than
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
