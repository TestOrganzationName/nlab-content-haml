                      %mrow
                        %mi δ
                        %mo :
                        %msub
                          %mi ℝ
                          %mo +
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi b
                        %mo :
                        %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi δ
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ,
