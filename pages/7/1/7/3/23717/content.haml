                    %annotation{:encoding => "application/x-tex"} \delta_X(a, b)
                is less than
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega(\epsilon)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi ω
                        %mo :
                        %mi X
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msub
