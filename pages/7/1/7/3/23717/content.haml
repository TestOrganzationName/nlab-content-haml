                          %mo +
                        %mo →
                        %msub
                          %mi{:mathvariant => "normal"} R
                          %mo +
                        %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
