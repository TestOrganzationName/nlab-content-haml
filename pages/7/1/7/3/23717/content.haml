                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \mathcal{U}(X), \approx)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
