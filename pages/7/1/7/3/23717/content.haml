                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{\omega:X \to (\mathrm{R}_+ \to \mathrm{R}_+)} \prod_{a:X} \prod_{\epsilon:\mathrm{R}_+} \prod_{b:X} (\delta_X(a, b) \lt \omega(\epsilon)) \to (\delta_Y(f(a), f(b)) \lt \epsilon)
            %p
          %p
            There exists a similar definition for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/uniform+spaces"} uniform spaces
          %p
          .num_defn
            %h6 Definition
            %p
              Given uniform spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝒰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
