                          %mn 1
                      %annotation{:encoding => "application/x-tex"} G_1
              %ul
                %li
                  %p
                    %strong (convention F)
                    horizontal composition is given by
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
