              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coequalizers"} coequalizers
              %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
              by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is inhabited (this is clear by inspection in
              %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              – which is what
              %a{:href => "#JohnsonRosebrughWood10"} JRW10
              observe on their p. 13 – for the general case use
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Johnstone 2002, vol 1, Lem. 1.3.2
          %p
          #MonadicityOfLawfulLensesAsMonadicDescent.num_remark
            %h6 Remark
            %p
              %strong
                (relation to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/monadic+descent"} monadic descent
              %br/
              In (
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"}> algebraic
              )
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
              %a.maruku-ref{:href => "#LawfulLensesMonadicity"}
              is known as
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/monadic+descent"} monadic descent
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo →
                        %mo *
                      %annotation{:encoding => "application/x-tex"} V \to \ast
                  (reflecting that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/inhabited+objects"} inhabited
                  %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
                  given that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                      %annotation{:encoding => "application/x-tex"} \mathbf{C}
                  is assumed to be a
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                  = succeed "," do
                    %em morphism of effective descent
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mo ◊
                          %mi V
                      %annotation{:encoding => "application/x-tex"} \lozenge_V
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/modale"}> modale
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                  is
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/descent+data"} descent data
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
                  object in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi C
                            %mrow
                              %mo{:stretchy => "false"} /
                              %mi V
                        %annotation{:encoding => "application/x-tex"} \mathbf{C}_{/V}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} EM-category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi C
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi V
                        %msup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %msub
                              %mo ◊
                              %mi V
                      %annotation{:encoding => "application/x-tex"} \big(\mathbf{C}_{/V}\big)^{\lozenge_V}
                  is the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/category+of+descent+data"} category of descent data
                  along
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo →
                          %mo *
                        %annotation{:encoding => "application/x-tex"} V \to \ast
            %p
              and so the monadicity theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi V
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %msub
                          %mo ◊
                          %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} \,\simeq\, \big(\mathbf{C}_{/V}\big)^{\lozenge_V}
              in Prop.
              %a.maruku-ref{:href => "#LawfulLensesMonadicity"}
              states that objects over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              which are equipped with such descent data are equivalent to objects over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} V \to \ast
          %p
          .num_remark
            %h6 Remark
            %p
              %strong
                (relation to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/epistemic+logic"} epistemic logic
              %br/
              Prop.
              %a.maruku-ref{:href => "#LawfulLensesMonadicity"}
              says that the category of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◊
                        %mi V
                    %annotation{:encoding => "application/x-tex"} \lozenge_V
              %a.existingWikiWord{:href => "/nlab/show/modales"} modales
              among objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}_{/V}
              is equivalent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◊
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \lozenge_V
              as the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/possibility"} possibility
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/modality"} modality
              %em potentiality
              = succeed "." do
                %a{:href => "necessity+and+possibility#RelationToPotentiality"} there
