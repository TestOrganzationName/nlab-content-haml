          %p
            e) To complete the inductive step, we define
            = succeed "-equivalences" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ta
                      %mi wg
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Ta_{wg}^{n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %msubsup
                    %mi Ta
                    %mi wg
                    %mi n
                %annotation{:encoding => "application/x-tex"} X\in Ta_{wg}^{n}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msubsup
                      %mi X
                      %mn 0
                      %mi d
                    %mo ×
                    %msubsup
                      %mi X
                      %mn 0
                      %mi d
                  %annotation{:encoding => "application/x-tex"} (a,b)\in X_0^d\times X_0^d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X(a,b)\subset X_1
            be the fiber at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b)
            of the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 0
                      %mo ,
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi X
                    %mn 0
                  %mo ×
                  %msub
                    %mi X
                    %mn 0
                  %mover
                    %mo →
                    %mrow
                      %mi γ
                      %mo ×
                      %mi γ
                  %msubsup
                    %mi X
                    %mn 0
                    %mi d
                  %mo ×
                  %msubsup
                    %mi X
                    %mn 0
                    %mi d
                  %mspace{:width => "thickmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  X_1\xrightarrow{(d_0,d_1)} X_0\times X_0 \xrightarrow{\gamma\times\gamma}  X^d_0\times X^d_0\;.
          %p
            We define a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\rightarrow  Y
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ta
                    %mi wg
                    %mi n
                %annotation{:encoding => "application/x-tex"} Ta_{wg}^{n}
            to be an
            = succeed "-equivalence" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            i) For all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %msubsup
                    %mi X
                    %mn 0
                    %mi d
                %annotation{:encoding => "application/x-tex"} a,b\in X_0^d
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mi a
                  %mo ,
                  %mi f
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  f(a,b): X(a,b)\rightarrow  Y(f a,f b)
          %p
            is a
            = succeed "-equivalence." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %p
            ii)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi f
                %annotation{:encoding => "application/x-tex"} p^{(n-1)}f
            is a
            = succeed "-equivalence." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %h3#tamsamani_categories
            Tamsamani
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} {n}
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ta
                    %mi n
                %annotation{:encoding => "application/x-tex"} Ta^{n}
            of Tamsamani
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ta
                    %mi wg
                    %mi n
                %annotation{:encoding => "application/x-tex"} Ta_{wg}^{n}
            whose objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi k
                        %mn 1
                      %mi …
                      %msub
                        %mi k
                        %mi r
                      %mn 0
                %annotation{:encoding => "application/x-tex"} X_{k_1\ldots k_r 0}
            are discrete for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi k
                      %mn 1
                    %mi …
                    %msub
                      %mi k
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Δ
                      %mrow
                        %msup
                          %mi r
                          %mi op
                  %annotation{:encoding => "application/x-tex"} (k_1\ldots k_r)\in    \Delta^{{r}^{op}}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi r
                    %mo ≤
                    %mi n
                    %mo −
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 1\leq r\leq n-2
          %p
            The embedding
            %a.maruku-eqref{:href => "#eq:eq3"} (1)
            restricts to an embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ta
                    %mi n
                  %mo ↪
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mrow
                      %msup
                        %mrow
                        %mi op
                  %mo ,
                  %mrow
                    %msub
                      %mi Ta
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  Ta_{n}\hookrightarrow [\Delta^{{}^{op}},{Ta_{n-1}}]
          %p
            and the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p^{(n-1)}
            in
            %a.maruku-eqref{:href => "#eq:eq4"} (2)
            restricts to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Ta
                    %mi n
                  %mo →
                  %msup
                    %mi Ta
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  p^{(n-1)}:Ta^{n}\rightarrow Ta^{n-1}
          %p
            The induced Segal maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
