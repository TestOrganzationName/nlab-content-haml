          %h2#idea Idea
          %p
            Classically,
            %a.existingWikiWord{:href => "/nlab/show/n-category"}
              models of weak
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            comprise sets of cells in dimension 0 up to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %img{:src => "/nlab/files/Glob_Shape_N.jpg", :width => "300px"}/
          %p
            On the other hand, non-globular structures exist in higher category theory: for instance,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-fold+category"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-fold categories
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalization
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Cat
                    %mn 0
                  %mo =
                  %mi Set
                  %mo ,
                  %mspace{:width => "2em"}
                  %mspace{:width => "2em"}
                  %msup
                    %mi Cat
                    %mi n
                  %mo =
                  %mi Cat
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Cat
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Cat^{0}=Set,\qquad\qquad Cat^{n}=Cat(Cat^{n-1})\;.
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mtext -
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} n\text{-}Cat
            of
            %a.existingWikiWord{:href => "/nlab/show/strict+n-category"}
              strict
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            is defined by iterated
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mtext -
                  %mi Cat
                  %mo =
                  %mi Set
                  %mo ,
                  %mspace{:width => "2em"}
                  %mspace{:width => "2em"}
                  %mi n
                  %mtext -
                  %mi Cat
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mtext -
                  %mi Cat
                  %mo ,
                  %mo ×
                  %mo{:stretchy => "false"} )
                  %mtext -
                  %mi Cat
                  %mspace{:width => "thickmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  0\text{-}Cat=Set,\qquad\qquad n\text{-}Cat=((n-1)\text{-}Cat,\times)\text{-}Cat\;.
          %p There is an embedding
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mtext -
                  %mi Cat
                  %mo ↪
                  %msup
                    %mi Cat
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  n\text{-}Cat\hookrightarrow Cat^{n}
          %p
            such that a strict
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            For instance, in the case
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n=2
            %a.existingWikiWord{:href => "/nlab/show/double+category"} double categories
            in which the category of objects and vertical arrows is discrete. In pictures:
            %img{:src => "/nlab/files/2-Cat.jpg", :width => "800px"}/
            We see that the picture on the right becomes the one on the left when all vertical morphisms are identities.
          %p
            In the weakly globular approach to higher categories, the cells in each dimension instead of forming a set, have a higher categorical structure which is homotopically discrete, that is only equivalent (in a higher categorical sense) to a set. This condition, called weak globularity condition, is a new paradigm to weaken higher categorical structures and allows to use rigid structures, namely
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mtext -
                  %mi Cat
                  %mo ↪
                  %msubsup
                    %mi Cat
                    %mi wg
                    %mi n
                  %mo ↪
                  %msup
                    %mi Cat
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  n\text{-} Cat \hookrightarrow Cat_{wg}^{n} \hookrightarrow Cat^{n}
          %p
            so that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Cat
                    %mi wg
                    %mi n
                %annotation{:encoding => "application/x-tex"} Cat_{wg}^{n}
            of weakly globular
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            In the case
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n=2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a double category satisfying two conditions: the first is the weak globularity condition, stating that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            of objects and vertical arrows is equivalent to a discrete category, that is it is an equivalence relation. The set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi pX
                    %mn 0
                %annotation{:encoding => "application/x-tex"} pX_0
            of connected components of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                %annotation{:encoding => "application/x-tex"} X_0
            plays the role of ‘set of objects’ in the weak structure. We therefore need to define a composition of horizontal arrows whose source and target are in the same vertical connected component
            %img{:src => "/nlab/files/Horiz-Comp.jpg", :width => "700px"}/
          %p For this purpose, we impose a second condition: for each ‘staircase path’
          %p
            %img{:src => "/nlab/files/Staircase.jpg", :width => "600px"}/
          %p A more concise way to express this second condition is in term of the so called induced Segal maps condition.
          %p
            Weakly globular double categories have been shown by Paoli and Pronk to be suitably equivalent to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategories
          %p
            In dimension
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n\geq2
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mtext -
                    %mi Cat
                    %mo ↪
                    %msup
                      %mi Cat
                      %mi n
                  %annotation{:encoding => "application/x-tex"} n\text{-} Cat\hookrightarrow Cat^{n}
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n=1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n\geq1
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The additional conditions in the definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Cat
                    %mi wg
                    %mi n
                %annotation{:encoding => "application/x-tex"} Cat_{wg}^{n}
            are given inductively in terms of induced Segal maps conditions. They guarantee the existence of weakly associative and weakly unital compositions but, like in the Tamsamani-Simpson model, their
            %a.existingWikiWord{:href => "/nlab/show/coherence+law"} coherences
            are not given explicitly but they are automatically encoded in the
            %a.existingWikiWord{:href => "/nlab/show/multisimplicial+set"} multi-simplicial
            combinatorics.
          %p
            Weakly globular
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            and to be suitably equivalent to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Homotopy+Theory+of+Higher+Categories"} Tamsamani-Simpson model
          %h2#homotopically_discrete_fold_categories
            Homotopically discrete
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The definition of weakly globular
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          #def01.num_defn
            %h6 Definition
            %p
              Let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Cat
                        %mi hd
                        %mn 0
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Cat_{hd}^{0}=Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Cat
                      %mi hd
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ⊂
                    %msup
                      %mi Cat
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} Cat_{hd}^{n-1}\subset Cat^{n-1}
              of homotopically discrete
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msup
                      %mi Cat
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X\in Cat^{n}
              is homotopically discrete if:
            %p
              a)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a levelwise equivalence relation, that is for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi k
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi k
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi Δ
                        %mrow
                          %msup
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                            %mi op
                    %annotation{:encoding => "application/x-tex"} (k_1,\ldots,k_{n-1})\in\Delta^{{n-1}^{op}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi k
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                    %mo ∈
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} X_{k_1,\ldots,k_{n-1}}\in Cat
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              (that is, a category equivalent to a discrete one).
            %p
              b)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi p
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %mo ∈
                    %msubsup
                      %mi Cat
                      %mi hd
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} p^{(n-1)}X\in Cat_{hd}^{n-1}
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
