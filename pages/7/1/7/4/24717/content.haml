            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-types." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p There is an alternative more explicit way to obtain a fundamental functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi n
                  %mo :
                  %mi n
                  %mtext -types
                  %mo →
                  %msubsup
                    %mi GCat
                    %mi wg
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{H}_{n}:n\text{-types}\rightarrow  GCat_{wg}^{n}
          %p based on the work of Blanc and Paoli. This work shows in particular how the notion of weak globularity arises naturally in topology.
          %p
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{H}_n
            is given by the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi n
                  %mo :
                  %mi n
                  %mtext -types
                  %mover
                    %mo →
                    %mi 𝒮
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mrow
                      %msup
                        %mrow
                        %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Or
                        %mi n
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mrow
                      %msup
                        %mi n
                        %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi 𝒫
                        %mi n
                  %msup
                    %mi Gpd
                    %mi n
                  %mspace{:width => "thickmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{H}_n: n\text{-types}\xrightarrow{\mathcal{S}} [\Delta^{{}^{op}},Set] \xrightarrow{Or_{n}} [\Delta^{{n}^{op}},Set]\xrightarrow{\mathcal{P}_n} Gpd^{n}\;.
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            is the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular functor
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Or
                    %mi n
                %annotation{:encoding => "application/x-tex"} Or_{n}
            is the functor induced by
            %a.existingWikiWord{:href => "/nlab/show/ordinal+sum"} ordinal sum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi or
                      %mi n
                    %mo :
                    %msup
                      %mi Δ
                      %mrow
                        %msup
                          %mi n
                          %mi op
                    %mo →
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} or_{n}:    \Delta^{{n}^{op}} \rightarrow  \Delta
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Or
                    %mi n
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mi …
                      %msub
                        %mi p
                        %mi n
                  %mo =
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                      %mo +
                      %msub
                        %mi p
                        %mn 1
                      %mo +
                      %mi …
                      %mo +
                      %msub
                        %mi p
                        %mi n
                %annotation{:encoding => "application/x-tex"}
                  (Or_{n} X)_{p_1\ldots p_n}=X_{n-1+p_1+\ldots+ p_n}
          %p
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_n
            is left adjoint to the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a{:href => "https://ncatlab.org/nlab/show/nerve#internal_nerve"} nerve
            functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi n
                    %mo :
                    %msup
                      %mi Gpd
                      %mi n
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mrow
                        %msup
                          %mi n
                          %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    N_n:Gpd^{n}\rightarrow
                    [\Delta^{{n}^{op}},Set]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒫
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{P}_n
            is in general very difficult, this becomes easy on those multi-simplicial sets in the essential image of the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Or
                    %mi n
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} Or_{n}\mathcal{S}
            and one obtain
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℋ
                    %mi n
                  %mi X
                  %mo =
                  %msup
                    %mover
                      %mi π
                      %mo{:stretchy => "false"} ^
                    %mn 1
                  %msup
