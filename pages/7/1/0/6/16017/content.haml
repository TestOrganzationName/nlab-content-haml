          %p The original articles:
          %ul
            %li#Kripke59
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+A.+Kripke"}> Saul A. Kripke
                ,
                = succeed "," do
                  %em A Completeness Theorem in Modal Logic
                %strong 24
                1 (1959) 1-14 &amp;lbrack;
                %a{:href => "https://doi.org/10.2307/2964568"}> doi:10.2307/2964568
                ,
                = succeed "," do
                  %a{:href => "https://www.jstor.org/stable/2964568"} jstor:2964568
                = succeed "&rbrack;" do
                  %a{:href => "https://www.filosoficas.unam.mx/~morado/Cursos/17Modal/Kripke1959.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+A.+Kripke"}> Saul A. Kripke
                ,
                = succeed "," do
                  %em Semantical Considerations on Modal Logic
                %strong 16
                (1963) 83-94 &amp;lbrack;
                %a{:href => "http://saulkripkecenter.org/wp-content/uploads/2019/03/Semantical-Considerations-on-Modal-Logic-PUBLIC.pdf"}> pdf
                \&amp;rbrack;
            %li#Kripke63
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+A.+Kripke"}> Saul A. Kripke
                ,
                = succeed "," do
                  %em Semantical Analysis of Modal Logic I. Normal Modal Propositional Calculi
                %strong 9
                5-6 (1963) 67-96 &amp;lbrack;
                %a{:href => "https://doi.org/10.1002/malq.19630090502"}> doi:10.1002/malq.19630090502
                \&amp;rbrack;
            %li#Kripke65
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+A.+Kripke"}> Saul A. Kripke
                ,
                = succeed "," do
                  %em Semantical Analysis of Modal Logic II. Non-Normal Modal Propositional Calculi
                %em The Theory of Models
                (Proceedings of the 1963 International Symposium at Berkeley) Studies in Logic and the Foundations of Mathematics (1965) 206-220 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/B978-0-7204-2233-7.50026-5"}> doi:10.1016/B978-0-7204-2233-7.50026-5
                \&amp;rbrack;
          %p Modern exposition:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Patrick+Blackburn"}> Patrick Blackburn
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Johan+van+Benthem"} Johan van Benthem
              = succeed "," do
                %em Modal logic: a semantic perspective
              = succeed "," do
                %em The Handbook of Modal Logic
              %strong 3
              (2007) &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/S1570-2464(07)80004-8"}> doi:10.1016/S1570-2464(07)80004-8
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://cgi.csc.liv.ac.uk/~frank/MLHandbook/"} book webpage
          %p
            In general see the
            %a{:href => "modal+logic#References"} reference at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/modal+logic"} modal logic
          %ul
            %li#BradleySwartz79
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raymond+D.+Bradley"}> Raymond D. Bradley
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Norman+Swartz"} Norman Swartz
                = succeed "," do
                  %em Possible Worlds – An Introduction to Logic and its Philosophy
                = succeed "," do
                  %a{:href => "http://www.sfu.ca/~swartz/pw/"} webpage
                = succeed "&rbrack;" do
                  %a{:href => "https://www.sfu.ca/~swartz/pw/text/pw_all.pdf"} pdf
            %li
              %p
                Rod Girle,
                = succeed "," do
                  %em Possible Worlds
                = succeed "&rbrack;" do
                  %a{:href => "https://www.jstor.org/stable/j.cttq48cx"} jstor:j.cttq48cx
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Johan+van+Benthem"}> Johan van Benthem
                , §2.2 of:
                %em Modal Logic for Open Minds
                (2010) &amp;lbrack;
                %a{:href => "http://web.stanford.edu/group/cslipublications/cslipublications/site/9781575865980.shtml"}> ISBN:9781575865980
                ,
                %a{:href => "http://fenrong.net/teaching/mljvb.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
