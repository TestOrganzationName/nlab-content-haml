          %title Contents
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#related_lab_entries"}
                  Related
                  = succeed "Lab" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/geometric+infinity-stacks"} geometric infinity-stacks
            within all
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-groupoids"} smooth infinity-groupoids
            are called
            = succeed "." do
              %em
                Lie
                = succeed "-groupoids" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} presentation
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan-fibrant+simplicial+manifolds"} Kan-fibrant simplicial manifolds
          %p
            In the language of groupoids, the Kan conditions (see below) correspond to composing and inverting various morphisms. For example, the existence of a composition for arrows is given by the condition
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Kan
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Kan(2,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Kan
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Kan(2,0)
            and
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Kan
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Kan(2,2)
          %p
            %img{:src => "/nlab/files/kan-mor.jpg", :width => "300px"}/
          %p
            Here we recall that a simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %em Kan
            if any map from the horn
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Λ
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Lambda[m,j]
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi m
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} m\ge 1
            ,
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo =
                    %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %mi m
                  %annotation{:encoding => "application/x-tex"} j=0,\dots,m
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[m]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Kan
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Kan(m,j)
            the
            %em Kan condition
            for the horn
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mi m
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Lambda[m,j]
            %em Kan simplicial set
            is therefore a simplicial set satisfying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Kan
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Kan(m,j)
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} m\ge 1
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mi m
                  %annotation{:encoding => "application/x-tex"} 0\leq j\leq m
          %p
            Note that the composition of two arrows is in general not unique, but any two of them can be joined by a
            = succeed "-morphism" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Kan
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Kan(3,2)
          %p
            %img{:src => "/nlab/files/composition.jpg", :width => "350px"}/
          %p
            The associativity can be given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Kan
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                %annotation{:encoding => "application/x-tex"} \Kan(2, 1)!
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Kan
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Kan(3, 2)
            illustrated below:
          %p
            %img{:src => "/nlab/files/ass-mor.jpg", :width => "350px"}/
          %p
            In an
            = succeed "-groupoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-morphisms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
          #groupoid.num_defn
            %h6 Definition
            %p
              An
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
