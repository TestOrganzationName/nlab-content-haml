          %p Source:
          %pre
            %code
              :preserve
                \begin{centre}
                    \begin{xymatrix[font = \large]@C+2pc}
                        A \rtwocell^f_g{\alpha} & B
                    \end{xymatrix}
                \end{centre}
          %h4#older_workaround_for_commutative_diagrams Older workaround for commutative diagrams
          %p An older workaround is to use use arrays or matrices. For example,
          %pre
            %code
              :preserve
                   $$
                   \begin{matrix}
                     (f/g)& \to & A \\
                     \downarrow&\underset{\alpha}{\swarr}&\, \downarrow f\\
                     B &\underset{g}{\to} & C
                   \end{matrix}
                   $$          %p produces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} /
                          %mi g
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %munder
                            %mo ↙
                            %mi α
                        %mtd
                          %mspace{:width => "thinmathspace"}
                          %mo{:stretchy => "false"} ↓
                          %mi f
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %munder
                            %mo →
                            %mi g
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  (f/g)&amp; \to &amp; A \\
                  \\downarrow&amp;\underset{\alpha}{\swarr}&amp;\, \downarrow f\\
                  B &amp;\underset{g}{\to} &amp; C
                  \\end{matrix}
          %p
            In many cases, you may wish to tweak the alignments (say, of vertical arrows), using
            %code \mathrlap{}
            or
            = succeed ":" do
              %code \mathllap{}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi B
                            %mpadded{:width => "0"}
                              %mi A
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mn 1
                            %mpadded{:width => "0"}
                              %mi A
                      %mtr
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msup
                                  %mi σ
                                  %mi A
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msup
                                  %mi t
                                  %mi A
                      %mtr
                        %mtd
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi B
                          %msup
                            %mo{:stretchy => "false"} )
                            %mpadded{:width => "0"}
                              %mi A
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %msubsup
                                %mi χ
                                %mi σ
                                %mi A
                        %mtd
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mpadded{:width => "0"}
                              %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  B^{\mathrlap{A}} &amp; \longrightarrow &amp; 1^{\mathrlap{A}} \\
                  \\mathllap{\scriptsize{\sigma^A}}\downarrow &amp; &amp; \downarrow \mathrlap{\scriptsize{t^A}} \\
                  P(B)^{\mathrlap{A}} &amp; \underset{\chi_\sigma^A}{\longrightarrow} &amp;  P(1)^{\mathrlap{A}}
                  \\end{matrix}
          %p is produced by
          %pre
            %code
              :preserve
                    \[
                    \begin{matrix}
                    B^{\mathrlap{A}} & \longrightarrow & 1^{\mathrlap{A}} \\
                    \mathllap{\scriptsize{\sigma^A}}\downarrow & & \downarrow               \mathrlap{\scriptsize{t^\alpha}} \\
                    P(B)^{\mathrlap{A}} & \underset{\chi_\sigma^A}{\longrightarrow} & P(1)^{\mathrlap{A}}
                    \end{matrix}
                    \]          %p Matrix and array environments also accept certain options. Here is an example using a “\rowlines{solid}” option to hack a sequent derivation (much more nicely than by resorting to \frac commands):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:rowlines => "solid"}
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi B
                          %mo →
                          %mi P
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi in
                          %mspace{:width => "thickmathspace"}
                          %mstyle{:mathvariant => "bold"}
                            %mi S
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi B
                          %mo ↛
                          %mi A
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi in
                          %mspace{:width => "thickmathspace"}
                          %mi Rel
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi S
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi X
                          %mo ↛
                          %mi A
                          %mo ×
                          %mi B
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi in
                          %mspace{:width => "thickmathspace"}
                          %mi Rel
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi S
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi X
                          %mo →
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ×
                          %mi B
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi in
                          %mspace{:width => "thickmathspace"}
                          %mstyle{:mathvariant => "bold"}
                            %mi S
                %annotation{:encoding => "application/x-tex"}
                  \\array{\arrayopts{\rowlines{solid}}
                  X \times B \to P A\;\;\; in\; \mathbf{S} \\
                  X \times B \nrightarrow A\;\;\; in\; Rel(\mathbf{S}) \\
                  X \nrightarrow A \times B\;\;\; in\; Rel(\mathbf{S}) \\
                  X \to P(A \times B)\;\;\; in \; \mathbf{S}
                  }
          %p is produced by
          %pre
            %code
              :preserve
                   $$
                   \array{
                   \arrayopts{\rowlines{solid}}
                   X \times B \to P A\;\;\; in\; \mathbf{S} \\
                   X \times B \nrightarrow A\;\;\; in\; Rel(\mathbf{S}) \\
                   X \nrightarrow A \times B\;\;\; in\; Rel(\mathbf{S}) \\
                   X \to P(A \times B)\;\;\; in \; \mathbf{S}
                   }$$          %p But use Tikz wherever possible.
          %h3#ImageFiles Image files
          %p One can upload an image to the nLab as follows.
          %ol
            %li
              %p
                Add
                %code [[some_picture.jpg:pic]]
                or
                %code [[some text that you wish to display|some_picture.jpg:pic]]
                to the page to which you wish to add the image. Save your edit.
            %li
              %p
                Click on the
                %code ?
                symbol that appears after ‘some_picture.jpg’ or ‘some text that you wish to display’ on the page.
            %li
              %p You will be sent to a page where you can upload the image.
            %li
              %p After uploading the image, you will need to make some edit to the page to refresh it. After this, the picture should appear on the page.
          %p
            The
            %code :pic
            functionality does not allow much configuration.Once it is uploaded, one can replace it by an
            %code imagefromfile
            block, such as the following.
          %pre
            %code
              :preserve
                    \begin{imagefromfile}
                        "file_name": "FileName.xyz"
                    \end{imagefromfile}          %p The contents of the block must be a valid JSON, but without curly opening and closing braces. There are several possible parameters. A common case is the following, which sets the width of the image (the height is automatically adjusted correspondingly).
          %pre
            %code
              :preserve
                    \begin{imagefromfile}
                        "file_name": "FileName.xyz",
                        "width": 300
                    \end{imagefromfile}          %p The default unit is pixels; to specify a different one, or to make it explicit, one uses the ‘unit’ parameter. Currently the only permitted values are “px” and “em”, which correspond to pixels and ‘em’ respectively.
          %pre
            %code
              :preserve
                    \begin{imagefromfile}
                        "file_name": "FileName.xyz",
                        "width": 300,
                        "unit": "px"
                    \end{imagefromfile}          %p Another common case is the following, which puts the image to the right of the page with the other text fitting around it, with a nice margin in between. The ‘unit’ inside the ‘margin’ block behaves in the same way as the overall width/height, in particular defaulting to pixels, but applies only to the margin.
          %pre
            %code
              :preserve
                    \begin{imagefromfile}
                        "file_name": "FileName.xyz",
                        "float": "right",
                        "margin": {
                            "top": -40,
                            "right": 0,
                            "bottom": 20,
                            "left": 20
                        }
                    \end{imagefromfile}          %p The full list of options is shown below. Except for “file_name”, these are all either optional or have defaults.
          %pre
            %code
              :preserve
                    \begin{imagefromfile}
                        "file_name": "FileName.xyz",
                        "web": "nlab",
                        "width": 300,
                        "height": 300,
                        "unit": "px",
                        "float": "right",
                        "margin": {
                            "top": -40,
                            "right": 0,
                            "bottom": 20,
                            "left": 20,
                            "unit": "px"
                        },
                        "alt": "Some picture",
                        "caption": "This is some picture"
                    \end{imagefromfile}          %p
            These should be fairly self-explanatory. The
            %code alt
            parameter corresponds to the
            %code &lt;img&gt;
            attribute of the same name.
          %p
            Note in particular that a caption can be added. If one is floating the graphic and one uses a negative value for
            %code top
            in the values for
            = succeed "," do
              %code margin
            %code bottom
            in order for text wrapping around the image not to obscure the caption.
          %p Be judicious when floating graphics. It may be easier to read a page, especially on a mobile phone, if the graphic is simply placed below a paragraph rather than floating to the side of it.
          %h3#how_to_centre How to centre
          %p Text or figures can be centred exactly as in LaTeX. For instance,
          %div{:style => "text-align: center"}
            Hello!
          %p is produced by
          %pre
            %code
              :preserve
                
                    \begin{centre}
                        Hello!
                    \end{centre}
          %p or by the following (i.e. either UK or US spelling can be used).
          %pre
            %code
              :preserve
                
                    \begin{center}
                        Hello!
                    \end{center}
          %h2#other_sources_of_information Other Sources of Information
          %h3#instiki_howto Instiki HowTo
          %p
            For general information and help with Instiki, see the
            %a{:href => "http://golem.ph.utexas.edu/instiki/show/HomePage"} Instiki
            wiki.
          %p Here are some useful specifics:
          %ul
            %li
              %a{:href => "http://daringfireball.net/projects/markdown/syntax"} Use basic Markdown syntax
            %li
              %a{:href => "http://maruku.rubyforge.org/maruku.html#extra"} Make tables, footnotes, etc
            %li
              %a{:href => "http://golem.ph.utexas.edu/instiki/show/Theorems"} Add definitions and theorems
            %li
              %a{:href => "https://golem.ph.utexas.edu/~distler/maruku/proposal.html"} Add metadata to your markup
            %li
              %a{:href => "http://golem.ph.utexas.edu/~distler/blog/itex2MMLcommands.html"} Type itex equations
            %li
              %a{:href => "http://golem.ph.utexas.edu/instiki/show/Syntax#wiki"} Use wiki syntax
            %li
              %a{:href => "http://golem.ph.utexas.edu/instiki/show/SVG"} Embed SVG in equations
            %li
              %a{:href => "http://golem.ph.utexas.edu/instiki/show/File+Uploads"} Upload files
            %li
              %a{:href => "http://golem.ph.utexas.edu/instiki/show/AccessKeys"} Use keyboard shortcuts
          %h3#survey_of_available_math_typesetting_commands Survey of available math typesetting commands
          %ul
            %li
              %a{:href => "http://golem.ph.utexas.edu/~distler/blog/itex2MMLcommands.html"} itex2MML Command Summary
            %li
              %a{:href => "https://golem.ph.utexas.edu/~distler/WebTeX/docs/wtxsec5.html"} webTeX documentation
          %p
            This is worth perusing carefully; for example, iTeX does not provide a command such as
            %code \prescript
            to generate left subscripts. Instead it contains the more general
            %code \multiscripts
            command to typeset subscripts and superscripts both to the left and right of an expression. For instance, the math mode text
            %code \multiscripts{_0^2_1}{R}{_i^j_k}
            produces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mmultiscripts
                    %mi R
                    %mi i
                    %mi j
                    %mi k
                    %none
                    %mprescripts
                    %mn 0
                    %mn 2
                    %mn 1
                    %none
                %annotation{:encoding => "application/x-tex"} \multiscripts{_0^2_1}{R}{_i^j_k}
          %h2#technical Technical
          %h3#software
            Software required to use the
            = succeed "Lab" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The
            = succeed "Lab" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a{:href => "http://en.wikipedia.org/wiki/MathML"} MathML
            %em native
            MathML support, and hence immediate rendering of the formulas, are those based on the Gecko, Blink, and WebKit rendering engines, e.g., Firefox, Chrome/Chromium, Safari, etc.
          %p
            Older unmaintained browsers like Internet Explorer, as well as a few obscure mobile and desktop browsers, fall back to rendering MathML formulas using the
            %a{:href => "https://www.mathjax.org/"} MathJax
            = succeed "." do
              %a{:href => "https://en.wikipedia.org/wiki/Polyfill_(programming%29"} polyfill
          %h3#how_to_deal_with_nlabs_spam_protection_access_denied_error_when_editing_a_page How to deal with nLab’s spam protection (“Access denied” error when editing a page)
          %p
            The
            = succeed "Lab" do
              %em n
            %a{:href => "http://www.spamcop.net/"} spamcop.net
            and
            = succeed "." do
              %a{:href => "http://www.spamhaus.org/"} spamhaus.org
          %ol
            %li
              The
              = succeed "Lab" do
                %em n
            %li
              The
              = succeed "Lab" do
                %em n
            %li If you got your IP dynamically (e.g. using some wireless providers) it is entirely possible that it is not your computer that was behaving badly but a previous one using the same IP. A quick workaround is to disconnect from the network and try reconnecting (sometimes you have to wait a bit before reconnecting to get a new IP). Of course, you should ensure that your virus software is up to date.
          %h3#how_to_deal_with_nlabs_internal_errors How to deal with nLab’s internal errors
          %p
            Sometimes something doesn’t work quite right with the software and it bails out. If you think that you were doing something that should work, please log the error message at the
            = succeed "." do
              %a{:href => "https://nforum.ncatlab.org/"} nForum
          %p There is actually more information contained in the HTML source of the error message (“view source”): some errors can be down to malformed input when editing a page and that can help you fix it yourself.
          %h3#Searching How to search the nLab
          %p
            Most conventional search engines such as Google, Bing, Yandex, Yahoo, Baidu, DuckDuckGo, StartPage, and others allow to search the nlab by appending
            %code site:ncatlab.org
            to the query. If DuckDuckGo is your search engine, you can type “!nl” to search the nLab, e.g., “!nl morphism”.
          %p
            %strong The built-in search.
            This is via the search box at the top of every page. The distinguishing characteristics of this search are:
          %ol
            %li
              It uses
              = succeed "." do
                %em regular expressions
            %li
              It searches the
              %em source
              of each page.
          %p
            Instiki’s search uses regular expressions. That means you can do all sorts of fancy searches, but it also means that pages with special characters in their names are hard to search for. For instance, if you search for
            %code (n,r)-category
            you will come up with nothing, because Instiki interprets the parentheses as a regular expression grouping construct. To search for actual parentheses, you need to backslash them: search instead for
            = succeed "." do
              %code \(n,r\)-category
          %h4#regular_expressions Regular Expressions
          %p
            Regular expressions are a powerful way of extending search capabilities to take into account that one often wants to search for more than just a set phrase. In a regular expression, certain characters are declared to be “special” and have a particular interpretation (somewhat like TeX with its special catcodes). A special character can always be “escaped” to interpret it as an ordinary character. Thus
            %code .
            means “match any single character” but
            %code \.
            means “match a period”.
          %p
            As Instiki is written in ruby, it uses the ruby version of regular expressions (each language has its own version; the differences are usually minor). The following is based on the list at
            = succeed "." do
              %a{:href => "http://www.ruby-doc.org/docs/ProgrammingRuby/html/language.html#UJ"} ruby-doc
          %dl
            %dt Special characters
            %dd
              The special characters are:
              = succeed "," do
                %code .
              = succeed "," do
                %code |
              = succeed "," do
                %code (
              = succeed "," do
                %code )
              = succeed "," do
                %code [
              = succeed "," do
                %code \
              = succeed "," do
                %code ^
              = succeed "," do
                %code {
              = succeed "," do
                %code +
              = succeed "," do
                %code $
              = succeed "," do
                %code *
              = succeed "." do
                %code ?
            %dt
              %code> \b
              ,
              %code \B
            %dd
              Match word boundaries and nonword boundaries respectively. Thus
              %code cat
              matches against
              %code category
              and
              %code cat
              but
              %code cat\b
              only matches
              %code cat
              (and
              = succeed ")." do
                %code scat
            %dt
              %code> [
              …
              %code ]
            %dd
              This matches against a single character in a list. The characters
              = succeed "," do
                %code |
              = succeed "," do
                %code (
              = succeed "," do
                %code )
              = succeed "," do
                %code [
              = succeed "," do
                %code ^
              = succeed "," do
                %code $
              = succeed "," do
                %code *
              %code ?
              are treated as regular characters in such a list. You can specify a range using
              = succeed ":" do
                %code -
              = succeed "." do
                %code a-z
              %code ]
              or
              %code -
              it must come at the start of the list. A
              %code ^
              at the start negates the list.
            %dt
              %code> \d
              ,
              = succeed "," do
                %code \s
              %code \w
            %dd These match, respectively, digits, spaces, and word characters.
            %dt
              %code> \D
              ,
              = succeed "," do
                %code \S
              %code \W
            %dd These are the negations of the lowercase versions.
            %dt
              %code .
              (period)
            %dd Matches any character except a newline.
            %dt
              %code> (
              …
              %code )
            %dd
              Parentheses group pieces of the regular expression. This is important for the following modifications. In these,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              stands for a sub-expression which can be a single character, a
              = succeed "\u2026" do
                %code [
              = succeed "," do
                %code ]
              = succeed "\u2026" do
                %code (
              = succeed "." do
                %code )
            %dt
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              %code *
            %dd
              Matches zero or more occurrences of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %code ab*
              matches
              = succeed "," do
                %code a
              = succeed "," do
                %code ab
              = succeed "," do
                %code abb
              %code (cat)*
              matches
              = succeed "," do
                %code cat
              = succeed "," do
                %code catcat
