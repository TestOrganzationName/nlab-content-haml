                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mo •
                            %mo ,
                            %msub
                              %mi U
                              %mi T
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi Ab
                            %mo{:stretchy => "false"} (
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ¯
                              %mo •
                            %mo ,
                            %msub
                              %mi U
                              %mi T
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi R
                            %mi Mod
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ¯
                              %mo •
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi T
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi R
                            %mi Mod
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ¯
                              %mo •
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi K
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{O}(Y)
                    \&amp; \simeq Sh(C)^\Delta(Y_\bullet, U_T(-))
                    \\\
                    \&amp; \simeq Sh(C)/X(f_\bullet , U_T(-) \times X)
                    \\\
                    \&amp; \simeq Ab(Sh(C)/X)( \bar f_\bullet, U_T(-)\times X)
                    \\\
                    \&amp; \simeq R Mod( i(\bar f_\bullet), i(U_T(-) \times X) )
                    \\\
                    \&amp; \simeq R Mod( i(\bar f_\bullet), K )
                    \\end{aligned}
                    \\,.
            %p
              To compute this, we use the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ¯
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ¯
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
