                    \\\
                    \&amp; \simeq \int_{k \in \Delta} T Alg(\Delta(k,n)\cdot A_k, B)
                    \\\
                    \&amp; \simeq T Alg( \int^{k \in \Delta} \Delta(k,n) \cdot A_k, B)
                    \\\
                    \&amp; \simeq T Alg(A_n , B)
                    \\,,
                    \\end{aligned}
            %p
              where in the last step we used the isomorphism (described at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
