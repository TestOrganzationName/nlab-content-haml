                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msubsup
                              %mi cdgAlg
                              %mi k
                              %mi op
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ∘
                            %mo{:stretchy => "false"} (
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi i
                            %mi 𝒪
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Sh_C(X, Spec A) &amp; \simeq \mathbf{H}({\lim_{\to}}_i U_i, Spec A)
                    \\\
                    \&amp; \simeq {\lim_\leftarrow}_i \mathbf{H}(U_i, Spec A)
                    \\\
                    \&amp; \simeq
                    {\lim_\leftarrow}_i C(U_i, A)
                    \\\
                    \&amp; \simeq
                    {\lim_\leftarrow}_i (cdgAlg_k)^\circ(A, \mathcal{O}(U_i))
                    \\\
                    \&amp; \simeq
                    (cdgAlg_k)^\circ(A, {\lim_\to}_i  \mathcal{O}(U_i))
                    \\\
                    \&amp; \simeq
                    (cdgAlg_k^{op})^\circ({\lim_\to}_i  \mathcal{O}(U_i), A)
                    \\end{aligned}
                    \\,.
          %p
            This is considered in (
            %a{:href => "#BenZviNadler"}> Ben-Zvi/Nadler, prop. 3.1
            ).
          .num_lemma
            %h6#observation_3 Observation
            %p
              The above
              %a{:href => "#YonedaQuillenAdjunction"} Yoneda-Quillen adjunction
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              the theory of commutative
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-Yoneda" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msubsup
                      %mi Alg
                      %mi k
                      %mi op
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msubsup
                      %mi Alg
                      %mi k
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    T Alg_k^{op} \hookrightarrow (T Alg_k^{\Delta})^{op}
          .proof
            %h6#proof_10 Proof
            %p
              By the general discussion of cofibrant replacement in the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              we have that every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} X \in [C^{op}, sSet]_{proj,loc}
              has a cofibrant resolution of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Δ
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ⋅
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi i
                            %mi n
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mi n
                    %annotation{:encoding => "application/x-tex"} \int^{[k] \in \Delta} \mathbf{\Delta}[k] \cdot \coprod_{i_n} U_{i_n}
              %a.existingWikiWord{:href => "/nlab/show/fat+simplex"} fat simplex
              tensored degreewise with a coproduct of representables such that the degenerate cells split off as direct summands (a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi n
                  %annotation{:encoding => "application/x-tex"} [n] \mapsto \coprod_{i_n} U_{i_n}
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy cofibrant
              an therefore the whole coend is a model for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            %p
              Since both the simplex as well as the
              %a.existingWikiWord{:href => "/nlab/show/fat+simplex"} fat simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}
              are Reedy cofibrant cosimplicial simplicial sets, this is moreover equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi i
                          %mi n
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \int^{[k]} \mathbf{\Delta}[k] \cdot \coprod_{i_n} U_{i_n}
              and this is still cofibrant. Now the left Quillen functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              takes this to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∫
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ⋅
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi i
                            %mi n
                      %mi 𝒪
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \int^{[k]} \mathbf{\Delta}[k] \cdot \coprod_{i_n} \mathcal{O}(U_{i_n})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (T Alg^{\Delta})^{op}
              is cofibrant, this coend is still a homotopy colimit.
            %p
              This shows that the
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of the left Quillen functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}
              sends the decomposition of any
              = succeed "-stack" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-colimit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-colimit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h2#Examples Examples and applications
          .num_prop
            %h6#proposition_examples Proposition (Examples)
            %p The conditons of the above theorem are satisfied for instance for
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  the theory of ordinary commutative algebras over a field
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fpqc+topology"} fpqc topology
                %p
                  In this case the adjunction is that considered in (
                  %a{:href => "#Toen"}> Toën
                  ).
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                  the theory of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ↪
                        %mi T
                        %msup
                          %mi Alg
                          %mi op
                      %annotation{:encoding => "application/x-tex"} C \hookrightarrow T Alg^{op}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/site"} site
                  of the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
          %h3#rational_homotopy_theory Rational homotopy theory
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            the Lawvere theory of
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒪
                  %mo ⊣
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{O} \dashv j)
            reproduces the setup discussed at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory+in+an+%28%E2%88%9E%2C1%29-topos"} rational homotopy theory in an (∞,1)-topos
          %h3#lie_theory_in_the_cahiers_topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Lie theory in the
            = succeed "-Cahiers" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p In this section we study the general theory for the case that
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ≔
                  %annotation{:encoding => "application/x-tex"} T \coloneqq
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              is the (
              %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
              of the) Lawvere theory of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Smooth
                  %mi Alg
                  %mo ≔
                  %mi T
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} Smooth Alg \coloneqq T Alg
            for the category of smooth algebras. Sheaf toposes on sub-sites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊂
                  %mi Smooth
                  %msup
                    %mi Alg
                    %mi op
                %annotation{:encoding => "application/x-tex"} C \subset Smooth Alg^{op}
            are well known to provide
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
            %a.existingWikiWord{:href => "/nlab/show/Models+for+Smooth+Infinitesimal+Analysis"} well adapted models
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
          %p We consider here the choice
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi Smooth
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C \subset Smooth Alg^{op}
              is the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
          .num_defn
            %h6#definition_8 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Cahiers+topos"} Cahiers topos
              is the
              %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi ThCartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(ThCartSp)
              on the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊂
                    %mi CartSp
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \subset CartSp Alg^{op}
              with
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              given by the families
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo ×
                      %mi S
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi Id
                          %mo{:stretchy => "false"} )
                      %mi X
                      %mo ×
                      %mi S
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \times S \stackrel{(p,Id)}{\to} X \times S\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} U \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal space
              (the dual of a Weil algebra) and where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              is a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %p
              The
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-Cahiers-topos
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              on
              %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
              with respect to the good open cover coverage.
          .num_remark
            %h6#remark_3 Remark
            %p
              The good open cover
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              generates the
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
              of all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ThCartSp
                  %annotation{:encoding => "application/x-tex"} ThCartSp
              with covering families coming from all open covers of Cartesian spaces is equivalent to the sheaf topos on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ThCartSp
                  %annotation{:encoding => "application/x-tex"} ThCartSp
              with only good open covering.
            %p
              By the discussioin at
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+simplicial+presheaves#LocalizationAtCoverage"} Cech localization of simplicial presheaves at a coverage
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %p
              Therefore we may model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ThCartSp
                      %mrow
                        %mi good
                        %mo −
                        %mi open
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(ThCartSp_{good-open})
              by the
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ThCartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [ThCartSp^{op}, sSet]_{proj}
              at the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact space
              = succeed "s)" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
              to an open ball, hence to a Cartesian space. We shall adopt for the present purposes therefore that a cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              is
              %em good
              if all finite intersections are isomorphic to Cartesian spaces.
            %p
              The point is that with this definition, the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ThCartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} C(U) \in [ThCartSp^{op}, sSet]_{proj}
              is cofibrant, by the
              %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+simplicial+presheaves#CofibrantObjects"} characterization of cofibrant objects
              in the projective model structure.
            %p As a consequence of this, we have the following useful technical result.
          .num_lemma
            %h6#definitionobservation Definition/Observation
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ThCartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                  %annotation{:encoding => "application/x-tex"} [ThCartSp^{op}, sSet]_{proj,cov}
              for the
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              of the global projective model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ThCartSp
                      %mi op
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [ThCartSp^{op}]_{proj}
              at the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi S
                  %annotation{:encoding => "application/x-tex"} C(U) \to X\times S
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ×
                    %mi S
                    %mo →
                    %mi X
                    %mo ×
                    %mi S
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \times S \to X \times S\}
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ThCartSp"} ThCartSp
            %p We have that
            %ul
              %li
                %p
                  this presents the
                  = succeed "-Cahiers" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Sh
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn ∞
                              %mo ,
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi ThCartSp
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi ThCartSp
                            %mi op
                          %mo ,
                          %mi sSet
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mi proj
                              %mo ,
                              %mi cov
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(ThCartSp) \simeq ([ThCartSp^{op}, sSet]_{proj,cov})
              %li
                %p
                  the fibrant objects of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi ThCartSp
                          %mi op
                        %mo ,
                        %mi sSet
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mrow
                            %mi proj
                            %mo ,
                            %mi cov
                      %annotation{:encoding => "application/x-tex"} [ThCartSp^{op}, sSet]_{proj,cov}
                  are precisely those fibrant objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi ThCartSp
                          %mi op
                        %mo ,
                        %mi sSet
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi proj
                      %annotation{:encoding => "application/x-tex"} A \in [ThCartSp^{op}, sSet]_{proj}
                  such that for all goop open covers
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo ×
                        %mi S
                        %mo →
                        %mi X
                        %mo ×
                        %mi S
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{ U_i \times S \to X \times S\}
                  with Cech nerve
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi U
                        %mo :
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                        %mo ×
                        %mi S
                      %annotation{:encoding => "application/x-tex"} p_U : C(U) \to X \times S
                  we have that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi ThCartSp
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mi U
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        [ThCartSp^{op}, sSet]( p_U , A )
                %p
                  is a weak equivalence (of
                  = succeed "es)." do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              The Cech nerves projections
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi U
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                    %mo ×
                    %mi S
                  %annotation{:encoding => "application/x-tex"} p_U : C(U) \to X \times S
              induce isomorphisms on the cohomology of their cosimplicial function algebras:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi p
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^p(\mathcal{O}(p_U))
              is an isomorphism, for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
          .proof
            %h6#proof_11 Proof
            %p
              This is a standard fact about
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cohomology
              %a.existingWikiWord{:href => "/nlab/show/partition+of+unity"} partition of unity
              subordinate to the cover. See
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/partition+of+unity#CechCoboundaries"} Coboundaries for Cech cocycles
          %p
            This means that the assumptions of the
            %a{:href => "#PassageToLocalTheorem"} Theorem on passage to the local model structure
            are satisfied.
          .num_cor
            %h6#corollary Corollary
            %p
              We have a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Smooth
                    %msubsup
                      %mi Alg
                      %mi proj
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mover
                      %munder
                        %mo →
                        %mi j
                      %mover
                        %mo ←
                        %mi 𝒪
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ThCartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi cov
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Smooth Alg^\Delta_{proj})^{op}
                    \\stackrel{\overset{\mathcal{O}}{\leftarrow}}{\underset{j}{\to}}
                    [ThCartSp^{op}, sSet]_{proj,cov}
                    \\,.
          %h4#lie_algebroids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Lie algebroids
          .num_defn
            %h6#definition_9 Definition
            %p
              The objects of the
              = succeed "-Cahiers" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %strong synthetic differential
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+groupoid"} ∞-Lie groupoid
            %p
              The objects of the reflective sub-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-category of
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-Cahiers" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mover
                      %mo ↪
                      %mo ←
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ThCartSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} \stackrel{\leftarrow}{\hookrightarrow}
                    \\mathbf{H} = Sh_{(\infty,1)}(ThCartSp)
            %p
              we call
              = succeed "s." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebroid"} ∞-Lie algebroid
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
          %p (…)
          %p
            Passing along the embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo ↪
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{L} \hookrightarrow \mathbf{H}
            we may compute
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cohomology
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          %p (…)
          %h4#the_infinitesimal_path_groupoid_of_a_manifold
            The infinitesimal path
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p (…)
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi CartSp
                %annotation{:encoding => "application/x-tex"} U \in CartSp
            let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi U
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mo •
                  %mo ∈
                  %msup
                    %mi C
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                %annotation{:encoding => "application/x-tex"}
                  U^{\Delta^\bullet_{inf}} \in C^{\Delta^{op}}
          %p
            be the simplicial object of
            %a{:href => "http://ncatlab.org/nlab/show/infinitesimal%20object#SpacOfInfSimpl"} infinitesimal simplices
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            %strong Definition
          %p We call
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mi inf
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi ℝ
                  %mi j
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi U
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mo •
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\Pi}_{inf}(U)
                  \\coloneqq
                  \\mathbb{R}j\; (U^{\Delta^\bullet_{inf}})
                  \\in
                  [C^{op}, sSet]
          %p
            the infinitesimal path
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            Or the
            %strong
              path
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            \.
          %p (…)
          %h4#the_tangent_category_of_smooth_algebras The tangent category of smooth algebras
          %p (…)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/tangent+category"} tangent category
            of the category of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            = succeed "-rings." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            %strong Proposition
            This abstract definition of module over
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            The tangent category of the category of
            %em simplicial
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %p
            This serves the purpose of presenting the
            = succeed "-stack" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} T Alg^{op}
          %p (…)
          %h2#appendix Appendix
          %h3#Enrichment Enrichment of categories of simplicial objects
          %p
            We make use of the canonical structure of an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            on any
            %a.existingWikiWord{:href => "/nlab/show/category+of+cosimplicial+objects"} category of cosimplicial objects
            in a category with all limits and colimits (see there).
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A \in (T Alg^{\Delta})^{op}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} S \in sSet
              we have that the tensoring is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⋅
                    %mi S
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi S
                          %mi s
                    %mi A
                    %mo ∈
                    %mi T
                    %mi Alg
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (A \cdot S)_n
                    \=
                    \\prod_{S_s} A \in T Alg
                    \\,,
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              taken in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi Alg
                    %annotation{:encoding => "application/x-tex"} T Alg
          %h3#model_structure_on_cosimplicial_abelian_groups Model structure on cosimplicial abelian groups
          %p
            We use the
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ab
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} Ab^\Delta
            whose fibratin are the degreewise surjections, and whose weak equivalences are the usual
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ab
                      %mi Δ
                    %mo ≃
                    %msubsup
                      %mi Ch
                      %mo +
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ab^\Delta \simeq Ch^\bullet_+(Ab)
          %p
            The model structure is described in detail at
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+chain+complexes#CochainNonNegProj"} model structure on chain complexes - the projective structure
          %p
            The structure of a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            is described in detail at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+abelian+groups"} model structure on cosimplicial abelian groups
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+stack"}> geometric stack
                ,
                %a.existingWikiWord{:href => "/nlab/show/geometric+%E2%88%9E-stack"} geometric ∞-stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
          %h2#references References
          %p
            The Quillen adjunction over abelian
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %ul
            %li#Toen
              %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"}> Bertrand Toën
              ,
              = succeed "," do
                %em Champs affines
              %strong 12
              (2006), no. 1, 39-135 (
              %a{:href => "https://arxiv.org/abs/math/0012219"}> arXiv:math/0012219
              ,
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/s00029-006-0019-z"} doi:10.1007/s00029-006-0019-z
          %p
            over ordinary commutative
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory+in+an+%28infinity%2C1%29-topos"} rational homotopy theory in an (infinity,1)-topos
          %p
            The generalization to arbitrary abelian
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %ul
            %li#Stel
              %p
                %a.existingWikiWord{:href => "/nlab/show/Herman+Stel"}> Herman Stel
                ,
                = succeed "," do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                    \-Stacks and their function algebras – with applications to
                    = succeed "-Lie" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
                = succeed "," do
                  %a{:href => "https://dspace.library.uu.nl/handle/1874/203187"} dspace:1874/203187
                = succeed ")" do
                  %a.existingWikiWord{:href => "/schreiber/show/master+thesis+Stel"} web
            %li#Stel13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Herman+Stel"}> Herman Stel
                ,
                %em
                  Cosimplicial
                  = succeed "-rings" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} C^\infty
                (
                %a{:href => "http://arxiv.org/abs/1310.7407"}> arXiv:1310.7407
                )
          %p on which this entry here is based.
          %p The considerations in
          %ul
            %li#Spivak
              %a.existingWikiWord{:href => "/nlab/show/David+Spivak"}> David Spivak
              ,
              = succeed "," do
                %em Derived smooth manifolds
              = succeed ")" do
                %a{:href => "http://www.uoregon.edu/~dspivak/derived-smooth-manifolds.pdf"} pdf
          %p
            on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/derived+smooth+manifold"} derived smooth manifold
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            %em derived synthetic differential geometry
            would consider the combination of both aspects: simplicial presheaves on duals of simplicial
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                %annotation{:encoding => "application/x-tex"} \mathcal{O}
            taking them to cosimplicial-simplicial
            = succeed "-rings." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} C^\infty
          %p For ordinary commutative algebras the generalizaton of Toen’s setup to geometry over duals of simplicial algebras is used for instance in
          %ul
            %li#BenZviNadler
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
              %em Loop spaces and connections
              (
              %a{:href => "http://arxiv.org/abs/1002.3636"}> arXiv:1002.3636
              )
