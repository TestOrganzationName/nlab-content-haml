              %a.existingWikiWord{:href => "/nlab/show/internal+%E2%88%9E-groupoid"} internal ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            We recall some basics and then discuss a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on cosimplicial
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            contains the theory of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
          %h4#TAlgebras
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            \-Algebras
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            may be thought of as a generalization of the theory of ordinary
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
          %p
            A Lawvere theory is encoded in its
            %a.existingWikiWord{:href => "/nlab/show/syntactic+category"} syntactic category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi k
                %annotation{:encoding => "application/x-tex"} x^k
            of a fixed object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi T
                  %annotation{:encoding => "application/x-tex"} x \in T
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(k,1)
            as the set of
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              \-algebra
            is accordingly a product-preserving functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi T
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} A : T \to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U_T(A) \coloneqq A(1) \in Set
            is the underlying set, and its value
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi U
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi k
                  %mo →
                  %msub
                    %mi U
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A(f) : U_T(A)^k \to U_T(A)
            on an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in T(k,1)
            is the
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            as implemented by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            The category of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Alg
                  %mo ⊂
                  %mo{:stretchy => "false"} [
                  %mi T
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} T Alg \subset [T, Set]
            of the
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi T
                    %mi op
                %annotation{:encoding => "application/x-tex"} T^{op}
            on these product-preserving functors.
          %p
            %strong> Examples
            \.
          %ul
            %li
              %p
                The category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi 𝒜𝒷
                    %annotation{:encoding => "application/x-tex"} T = \mathcal{Ab}
                of free finitely generated abelian groups is the syntactic category of the Lawvere theory whose algebras are abelian groups.
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                a field, the category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi k
                    %annotation{:encoding => "application/x-tex"} T = k
                of free finitely generated
                = succeed "-algebras" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "s;" do
                  %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            %li
              %p
                The category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                    %annotation{:encoding => "application/x-tex"} T =
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                is the syntactic category whose algebras are
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
          %p
            A morphism of Lawvere theories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 1
                  %mo →
                  %msub
                    %mi T
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T_1 \to T_2
            is again a product-preserving functor.
          .num_defn
            %h6#definition Definition
            %p
              An
              %strong abelian Lawvere theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is a morphism of Lawvere theories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ab
                        %mi T
                      %mo :
                      %mi 𝒜𝒷
                      %mo →
                      %mi T
                    %annotation{:encoding => "application/x-tex"} ab_T : \mathcal{Ab} \to T
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            abelian,
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ab
                    %mi T
                    %mo *
                  %mo :
                  %mi T
                  %mi Alg
                  %mo →
                  %mi Ab
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ab_T^* : T Alg \to Ab
                  \\,.
          %p
            This functor is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
          %p For example associative algebras and smooth algebras are algebras over an abelian Lawvere theory, and their underlying abelian groups are the evident ones.
          %p
            Similarly, the forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi T
                  %mo :
                  %mi T
                  %mi Alg
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U_T : T Alg \to Set
            has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi T
                    %mo :
                    %mi Set
                    %mo →
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} F_T : Set \to T Alg
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            this sends the
            = succeed "-element" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi k
                    %mo ↦
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_T(n) : k \mapsto T(n,k)
          %p
            More generally, for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi T
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} A \in T Alg
            the copresheaf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi T
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  T Alg(F_T(-), A) : T \to Set
          %p
            is isomorphic to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            The free
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_T(1)
            on a single generator may be thought of as the
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                \-line
          %ul
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi k
                    %annotation{:encoding => "application/x-tex"} T = k
                we have that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} F_T(1) = k[X]
                is the free
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi CartSp
                    %annotation{:encoding => "application/x-tex"} T = CartSp
                we have that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mi T
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F_T(1) = C^\infty(\mathbb{R})
          %p
            We say more on the canonical
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/line+object"} line object
            below in
            %a{:href => "#Line"} The Line object
          %h4#ModelTAlg
            Model structure on cosimplicial
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          #ModelTransferToTAlg.num_theorem
            %h6#theorem Theorem
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+abelian+groups"} model structure on cosimplicial abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ab
                      %mi proj
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} Ab^\Delta_{proj}
              whose weak equivalences are the morphisms that induce
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              under passage to
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} normalized cochain complexes
              and fibrations are the degreewise surjections.
            %p
              With respect to the
              %a{:href => "#Enrichment"} canonical sSet-enrichment
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+cosimplicial+objects"} category of cosimplicial objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ab
                        %mi Δ
                    %annotation{:encoding => "application/x-tex"} Ab^{\Delta}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ab
                      %mi T
                    %mo :
                    %mi 𝒜𝒷
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} ab_T : \mathcal{Ab} \to T
              any abelian Lawvere theory, the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ab
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Δ
                    %mo ⊣
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ab
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Δ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msup
                            %mi ab
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi ab
                            %mo *
                    %msup
                      %mi Ab
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"}
                    ((ab_*)^\Delta \dashv (ab^*)^\Delta )
                    \: T Alg^{\Delta} \stackrel{\overset{ab_*}{\leftarrow}}{\underset{ab^*}{\to}} Ab^\Delta
            %p
              induces a
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msubsup
                      %mi Alg
                      %mi proj
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} T Alg^{\Delta}_{proj}
              on the category of cosimplicial
              = succeed "-algebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ab
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} (ab^*)^\Delta
              become weak equivalences and fibrations, respectively, in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ab
                        %mi proj
                        %mi Δ
                    %annotation{:encoding => "application/x-tex"} Ab^\Delta_{proj}
            %p
              This, too, is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              with respect to its
              = succeed "." do
                %a{:href => "#Enrichment"} standard sSet-enrichment
          .proof
            %h6#proof Proof
            %p
              The proof of the existence of the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cochain+complexes"} model structure on cochain complexes
              in non-negative degree –
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ch
                      %mo +
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch^\bullet_+(Ab)
              – whose fibrations are the
              %em degreewise surjections
              (and weak equivalences the usual
              = succeed ")s" do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+chain+complexes#CochainNonNegProj"} here
            %p
              By the dual
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ab
                      %mi Δ
                    %mo ≃
                    %msubsup
                      %mi Ch
                      %mo +
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ab^\Delta \simeq Ch^\bullet_+(Ab)
              this induces the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+cosimplicial+abelian+groups"} model structure on cosimplicial abelian groups
              whose fibrations are the degreewise surjections (using that the
              %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} normalized cochain complex functor
              sends surjections to surjections).
            %p
              That with the standard structure of an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ab
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} Ab^\Delta
              this constitutes a
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+on+cosimplicial+abelian+groups#SimplicialEnrichmentOfProjective"} here
            %p
              Now we use the basic fact of
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theories"} Lawvere theories
              that any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %msub
                      %mi T
                      %mn 1
                    %mo →
                    %msub
                      %mi T
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : T_1 \to T_2
              of such induces a pair of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo *
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi T
                      %mn 2
                    %mi Alg
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msup
                            %mi f
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi f
                            %mo *
                    %msub
                      %mi T
                      %mn 1
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"}
                    (f_* \dashv f^*) : T_2 Alg \stackrel{\overset{f_*}{\leftarrow}}{\underset{f^*}{\to}}
                    T_1 Alg
            %p
              between their categories of algebras: the
              = succeed "." do
                %a{:href => "http://ncatlab.org/nlab/show/Lawvere%20theory#AdjCatAlgs"} adjunction of relatively free algebras
            %p
              Since by assumption that our
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is an abelian Lawvere theory we are given a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ab
                    %mo :
                    %mi Ab
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} ab : Ab \to T
              from the theory of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ab
                      %mo *
                    %mo ⊣
                    %msup
                      %mi ab
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi T
                    %mi Alg
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msup
                            %mi ab
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi ab
                            %mo *
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"}
                    (ab_* \dashv ab^*) : T Alg \stackrel{\overset{ab_*}{\leftarrow}}{\underset{ab^*}{\to}}
                    Ab
            %p and hence also an adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi ab
                      %mo *
                      %mi Δ
                    %mo ⊣
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ab
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Δ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                    %mover
                      %munder
                        %mo →
                        %mrow
                      %mover
                        %mo ←
                        %mrow
                    %msup
                      %mi Ab
                      %mi Δ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (ab_*^\Delta \dashv (ab^*)^\Delta) : T Alg^\Delta \stackrel{\overset{}{\leftarrow}}{\underset{}{\to}}
                    Ab^\Delta
                    \\,.
            %p
              We need to check that the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ab
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} (ab^*)^\Delta
              induces the
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} T Alg^\Delta
              from the above model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ab
                        %mi proj
                        %mi Δ
                    %annotation{:encoding => "application/x-tex"} Ab^\Delta_{proj}
            %p
              By the facts recalled at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msubsup
                      %mi Alg
                      %mi proj
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} T Alg^\Delta_{proj}
            %ul
              %li
                %p has a fibrant replacement functor;
              %li
                %p
                  has functorial
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
            %p and for the simplicial enrichment that
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ab
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi Δ
                    %annotation{:encoding => "application/x-tex"} (ab^*)^\Delta
                preserves the
                = succeed "ing." do
                  %a.existingWikiWord{:href => "/nlab/show/power"} power
            %p The first condition is trivial, since all objects are fibrant. The last condition is evidently satisfied, since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi T
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mi S
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi U
                      %mi T
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi S
                          %mi n
                    %msub
                      %mi A
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi S
                          %mi n
                    %msub
                      %mi U
                      %mi T
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi S
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U_T(A^S)_n = U_T(\prod_{S_n} A_n) = \prod_{S_n} U_T(A_n) = ((U_T(A))^S)_n
                    \\,.
            %p
              Using this, we claim that we can take the path space object functor to be given by
              = succeed "ing" do
                %a.existingWikiWord{:href => "/nlab/show/power"} power
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi I
                    %mo :
                    %mi A
                    %mo ↦
                    %msup
                      %mi A
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-)^I : A \mapsto A^{\Delta[1]}
                    \\,.
            %p
              This is because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[0] \coprod \Delta[0] \hookrightarrow \Delta[1] \to \Delta[0]
              factors the co-diagonal in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              by a cofibration followed by a weak equivalence between cofibrant objects. Accordingly the induced
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %msup
                      %mi A
                      %mi I
                    %mo →
                    %mi A
                    %mo ×
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A \to A^I \to A \times A
            %p
              factors the digonal, and the morphism on the left is a weak equivalence, since it is the image under the left Quillen functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A^{(-)}
              of a weak equivalence between cofibrant objects (and by the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              such weak equivalences are preserved by left Quillen functors).
          %h3#simplicial_presheaves_on_duals_of_algebras
            Simplicial presheaves on duals of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            A good notion of a generalized
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            modeled on objects in a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            in such generalized spaces is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p We are interested here in that case that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ⊂
                  %mi C
                  %mo ↪
                  %mi T
                  %msup
                    %mi Alg
                    %mi op
                %annotation{:encoding => "application/x-tex"}
                  T \subset C \hookrightarrow T Alg^{op}
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            of the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            = succeed "-algebras," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            an abelian Lawvere theory. In the remainder of this section we assume such a choice to be fixed. Below in the section on
            %a{:href => "#Examples"} Examples and applications
            we discuss concrete choices of interest.
          %p Notice that such a choice induces also a full subcategory of (co)simplicial objects
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                  %mo ↪
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mi Alg
                    %mi Δ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^{\Delta^{op}} \hookrightarrow (T Alg^\Delta)^{op}
                  \\,.
          %h4#ProlongedYoneda The prolonged Yoneda embedding
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %mi T
                  %msup
                    %mi Alg
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  j : T Alg^{op} \to [C^{op}, Set]
          %p
            for the ordinary
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mi Alg
                    %mi Δ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  j : (T Alg^\Delta)^{op} \to [C^{op}, sSet]
          %p for its degreewise simplicial prolongation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ∈
                  %mi T
                  %mi Alg
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ↦
                  %mi T
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi n
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  j(A) : (B \in T Alg)  \mapsto ([n] \mapsto T Alg(A_n, B))
                  \\,.
          .num_lemma
            %h6#simplicialYoneda Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi T
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} B \in T Alg
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi s
                  %annotation{:encoding => "application/x-tex"} (T Alg^\Delta)_s
              denoting the
              %a{:href => "#Enrichment"} simplicially enriched
              category of
              = succeed "-algebras," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi s
                      %mi op
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    j(A) \simeq (T Alg^\Delta)^{op}_s(-, A)
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Using
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/end"} end
              = succeed "-calculus" do
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              %a{:href => "#Enrichment"} canonical enrichment
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %msup
                        %mi Alg
                        %mi Δ
                    %annotation{:encoding => "application/x-tex"} T Alg^\Delta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi T
                    %msup
                      %mi Alg
                      %mi op
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi Alg
                    %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} B \in T Alg^{op} \hookrightarrow (T Alg \Delta)^{op}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mi T
                    %msup
                      %mi Alg
                      %mi Δ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} A \in (T Alg^\Delta)^{op}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi T
                            %msup
                              %mi Alg
                              %mi Δ
                            %msubsup
                              %mo{:stretchy => "false"} )
                              %mi s
                              %mi op
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ,
                            %mi A
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi n
                          %mtd
                            %mo ≔
                            %mo{:stretchy => "false"} (
                            %mi T
                            %msup
                              %mi Alg
                              %mi Δ
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi op
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ⋅
                            %msup
                              %mi Δ
                              %mi n
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi k
                                %mo ∈
                                %mi Δ
                            %mi T
                            %mi Alg
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi A
                              %mi k
                            %mo ,
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi Δ
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo ,
                                %mi n
                                %mo{:stretchy => "false"} )
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mo ∫
                              %mrow
                                %mi k
                                %mo ∈
                                %mi Δ
                            %mi T
                            %mi Alg
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi A
                              %mi k
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi T
                            %mi Alg
                            %mo{:stretchy => "false"} (
                            %msup
                              %mo ∫
                              %mrow
                                %mi k
                                %mo ∈
                                %mi Δ
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %msub
                              %mi A
                              %mi k
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi T
