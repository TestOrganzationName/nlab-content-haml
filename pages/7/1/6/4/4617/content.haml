                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (T Alg^\Delta)^{op}_s(B, A)_n
                    \&amp; \coloneqq
                    (T Alg^\Delta)^{op}(B \cdot \Delta^n, A)
                    \\\
