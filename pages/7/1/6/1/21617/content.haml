            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            which cannot be distinguished by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %h3#via_dehn_surgery Via Dehn surgery
          %p
            The 3-dimensional lens space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L(p,q) \coloneqq L(p, \{1,q\})
            %a.existingWikiWord{:href => "/nlab/show/coprime+integers"} coprime integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %a.existingWikiWord{:href => "/nlab/show/Dehn+surgery"} Dehn surgery
            on an
            %a.existingWikiWord{:href => "/nlab/show/unknot"} unknot
            with coefficient
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mi p
                      %mi q
                  %annotation{:encoding => "application/x-tex"} -\frac{p}{q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
