            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi …
                  %annotation{:encoding => "application/x-tex"} \ldots
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_{n}
            from left to right, for a
            %a.existingWikiWord{:href => "/nlab/show/continued+fraction"} continued fraction
            representation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mfrac
