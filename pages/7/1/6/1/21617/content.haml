                  %annotation{:encoding => "application/x-tex"} L\big(n,\{l_i\}_{i=0}^d\big)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
