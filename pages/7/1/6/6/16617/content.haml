          %h2#idea Idea
          %p
            One can ask whether a nonlinear map between locally convex topological vector spaces is smooth according to various definitions. The definition due to Michal, developed by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Andree+Ehresmann"} Bastiani
          %h2#definition Definition
          %p
            A map
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo :
                  %mi E
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} \Phi:E\rightarrow F
            from a
            %a.existingWikiWord{:href => "/nlab/show/locally+convex+topological+vector+space"} locally convex topological vector space
            (lctvs)
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            into another lctvs
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is said to be
            %strong Michal-Bastiani smooth
            (or
            = succeed ")" do
              %strong MB-smooth
            %a.existingWikiWord{:href => "/nlab/show/directional+derivatives"} directional derivatives
            of order
            = succeed "," do
              %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_5.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi k
                  %mi Φ
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi y
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi y
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mrow
                      %mfrac
                        %mrow
                          %msup
                            %mo ∂
                            %mi k
                        %mrow
                          %mo ∂
                          %msub
                            %mi λ
                            %mn 1
                          %mi ⋯
                          %mo ∂
                          %msub
                            %mi λ
                            %mi k
                      %mo |
                    %mrow
                      %msub
                        %mi λ
                        %mn 1
                      %mo =
                      %mi ⋯
                      %mo =
                      %msub
                        %mi λ
                        %mi k
                      %mo =
                      %mn 0
                  %mi Φ
                  %mrow
                    %mo (
                    %mi x
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi j
                        %mo =
                        %mn 1
                      %mi k
                    %msub
                      %mi λ
                      %mi j
                    %msub
                      %mi y
                      %mi j
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  D^k\Phi[x](y_1,\ldots,y_k) = \left.\frac{\partial^k}{\partial\lambda_1\cdots\partial\lambda_k}\right|_{\lambda_1=\cdots=\lambda_k=0}\Phi\left(x+\sum^k_{j=1}\lambda_j y_j\right)
          %p
            exist and the maps
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi k
                  %mi Φ
                  %mo :
                  %mi E
                  %mo ×
                  %msup
                    %mi E
                    %mi k
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} D^k\Phi:E\times E^k\rightarrow F
            are
            %span.newWikiWord
              jointly continuous
              %a{:href => "/nlab/new/jointly+continuous+map"} ?
            for all
            = succeed "." do
              %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k\in\mathbb{N}
            = succeed "," do
              %a{:href => "#Michal38"} Michal 38
            = succeed ")," do
              %a{:href => "#Michal40"} Michal 40
            = succeed ")." do
              %a{:href => "#Bastiani64"} Bastiani 64
          %p
            This notion of smoothness is the one used in
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Milnor"} Milnor
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            (
            %a{:href => "#Milnor"}> Milnor 84
            ) and Hamilton’s exposé of the Nash-Moser
            %a.existingWikiWord{:href => "/nlab/show/inverse+function+theorem"} inverse function theorem
            (
            %a{:href => "#Hamilton"}> Hamilton 92
            ). A comparison to other notions of smoothness for topological vector spaces with various properties is in (
            %a{:href => "#Keller"}> Keller 74
            ).
          %h2#properties Properties
          %p MB-smooth maps have the following properties.
          %ul
            %li
              %p
                Continuous
                %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
                are MB-smooth;
            %li
              %p
                MB-smooth maps are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
            %li
              %p
                MB-smooth maps are smooth in the sense of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/convenient+vector+spaces"} convenient vector spaces
                %a.existingWikiWord{:href => "/nlab/show/chain+rule"} chain rule
                holds;
            %li
              %p
                Maps between
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+spaces"} Fréchet spaces
                are MB-smooth if and only if they are conveniently smooth.
          %p
            Note that a map that is smooth in the sense of a convenient vector space (equivalently, a smooth map between the corresponding
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            = succeed ")." do
              %a{:href => "#Glockner06"} Glöckner 06
            %em isomorphism
            that is not MB-smooth, so the faithful and non-full functor
          .maruku-equation
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_8.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lctvs
                    %mi MB
                  %mo →
                  %msub
                    %mi lctvs
                    %mi convenient
                  %mo ↪
                  %mi DiffeologicalSpace
                %annotation{:encoding => "application/x-tex"}
                  lctvs_{MB} \to lctvs_{convenient} \hookrightarrow DiffeologicalSpace
          %p
            is not even injective on isomorphism classes. The following example was supplied in (
            %a{:href => "#TaQ15"}> TaQ 15
            ):
          %p
            Let
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be the vector space of all real (two-sided) sequences
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} sp
                  %msub
                    %mi x
                    %mi i
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi i
                  %mo ∈
                  %mi ℤ
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} x=\langle\sp x_i\mid i\in\mathbb{Z}\rangle
            for which
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} x_i=0
            for
            = succeed "," do
              %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≪
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} i\ll 0
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %msup
                    %mi ℝ
                    %mi ℕ
                  %mo ×
                  %msup
                    %mi ℝ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℕ
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E\to\mathbb{R}^\mathbb{N}\times\mathbb{R}^{(\mathbb{N})}
            defined by
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi u
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x\mapsto(u,v)
            where
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi i
                  %mo =
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} u_i=x_{i-1}
            and
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi v
                    %mi i
                  %mo =
                  %msub
                    %mi x
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi i
                %annotation{:encoding => "application/x-tex"} v_i=x_{-i}
            for
            = succeed "." do
              %code.maruku-mathml i\gt 0}
          %p
            Then define the bijection
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi E
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} i\gt 0}f:E\to E
            by
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mi y
                %annotation{:encoding => "application/x-tex"} x\mapsto y
            where
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi y
                    %mi i
                  %mo =
                  %msub
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} y_i=x_i
            for
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} i\neq 0
            and
            = succeed "." do
              %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mn 0
                    %mo =
                    %msub
                      %mi x
                      %mn 0
                    %mo +
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ⋅
                    %msub
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y_0=x_0+\sum_{i\in\mathbb{N}}(x_i\cdot x_{-i})
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo ↦
                  %mi x
                %annotation{:encoding => "application/x-tex"} y\mapsto x
            where
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi y
                    %mi i
                  %mo =
                  %msub
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} y_i=x_i
            for
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} i\neq 0
            and
            = succeed "." do
              %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 0
                    %mo =
                    %msub
                      %mi y
                      %mn 0
                    %mo −
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi i
                    %mo ⋅
                    %msub
                      %mi y
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x_0=y_0-\sum_{i\in\mathbb{N}}(y_i\cdot y_{-i})
            = succeed "," do
              %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi ℕ
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ℕ
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^\mathbb{N}\times\mathbb{R}^{(\mathbb{N})}\to\mathbb{R}
            = succeed "," do
              %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo ∈
                        %mi ℕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo ⋅
                    %msub
                      %mi x
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x\mapsto \sum_{i\in\mathbb{N}}(x_i\cdot x_{-i})
            %math#mathml_aa861fef85ddd8b16238b939681c79796b7a91e7_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is discontinuous and so not MB-smooth.
