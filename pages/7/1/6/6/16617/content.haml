          %ul
            %li#Michal38
              %p
                Aristotle Demetrius Michal,
                = succeed "," do
                  %em Differential calculus in linear topological spaces
                %strong 24
                (1938), 340-342 (
                %a{:href => "http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1077109/pdf/pnas01796-0040.pdf"}> pdf
                )
            %li#Michal40
