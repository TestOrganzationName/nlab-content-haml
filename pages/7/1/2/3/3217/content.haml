                %annotation{:encoding => "application/x-tex"} {}_{synthdiff}
            and evaluate the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            in def.
            %a.maruku-ref{:href => "#GeometricAndEtale"}
            first on all representables of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
