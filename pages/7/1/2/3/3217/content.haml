            %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
