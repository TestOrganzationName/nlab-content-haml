                    %annotation{:encoding => "application/x-tex"} Y
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/simple+foliations"} simple foliations
          .num_example
            %h6#example_9 Example
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              gives a folitation on its space of
              = succeed ":" do
