                          %mtd
                            %mo →
                          %mtd
                            %mi 𝒢
                          %mtd
                            %mo =
                            %msub
                              %mi 𝒢
                              %mn 0
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
