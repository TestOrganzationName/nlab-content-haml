          %h2#examples Examples
          #SimpleFoliation.num_example
            %h6#example_8 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              a
              %a.existingWikiWord{:href => "/nlab/show/submersion"} submersion
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              of the submersion constitute a foliation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
