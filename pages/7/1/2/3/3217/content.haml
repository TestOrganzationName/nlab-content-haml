            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            by the
            %a.existingWikiWord{:href => "/nlab/show/d%C3%A9calage"} décalage
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
