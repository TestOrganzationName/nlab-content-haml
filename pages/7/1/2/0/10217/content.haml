                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi PRA
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ev: Term(0) \to \mathbf{PRA}(0, 1)
            be the corresponding quotient map. The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ev
                %annotation{:encoding => "application/x-tex"} ev
            has a section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi num
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi PRA
