                    %mstyle{:mathvariant => "bold"}
                      %mi PRA
                  %annotation{:encoding => "application/x-tex"} \mathbf{PRA}
          %h3#syntactic_terminology_and_notation Syntactic terminology and notation
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Form
                  %mo{:stretchy => "false"} (
                  %mi PA
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Form(PA)
            be the set of all formulas of PA, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(j)
            the set of formulas with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/free+variables"} free variables
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi(j)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi F
                  %mo ′
                %annotation{:encoding => "application/x-tex"} F, F'
            belong to the same equivalence class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi F
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [F]
            if they are provably equivalent in PA. Thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [-]: \Phi(j) \to T(j)
            is the corresponding quotient map. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Term
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Term(0)
            denote the set of closed terms in the logical theory
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PRA
                  %annotation{:encoding => "application/x-tex"} PRA
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \to 1
            in the Lawvere theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi PRA
                %annotation{:encoding => "application/x-tex"} \mathbf{PRA}
            are equivalence classes of terms, and we let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ev
                  %mo :
                  %mi Term
