                            %mrow
                              %mi code
                              %mo ×
                              %mn 1
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi PRA
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
