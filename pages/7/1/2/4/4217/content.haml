                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} A \vee B \equiv \prod_{P:\mathrm{Prop}} ((A \to P) \times (B \to P)) \to P
          %p
            By
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
          %p
          .num_theorem
            %h6 Theorem
            %p The two definitions above are equivalent.
          %p
          .proof
            %h6 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
              of a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is equivalent to the following dependent function type
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi A
                    %mo{:stretchy => "false"} ‖
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
