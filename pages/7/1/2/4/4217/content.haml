                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo )
                    %annotation{:encoding => "application/x-tex"} \left(\prod_{x:A} B(x)\right) \simeq \left(\prod_{x:A} C(x)\right)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi A
                    %mo +
                    %mi B
                    %mo{:stretchy => "false"} ‖
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi P
                          %mo :
                          %mi{:mathvariant => "normal"} Prop
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo +
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi P
                      %mo )
                    %mo ≃
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi P
                          %mo :
                          %mi{:mathvariant => "normal"} Prop
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi P
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \| A + B \| \simeq \left(\prod_{P:\mathrm{Prop}} ((A + B) \to P) \to P\right) \simeq \left(\prod_{P:\mathrm{Prop}} ((A \to P) \times (B \to P)) \to P\right)
            %p
          %p
            If one has the
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is given by the following type:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∨
                  %mi B
                  %mo ≔
                  %mo ∃
                  %mi b
                  %mo :
                  %mi{:mathvariant => "normal"} bool
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mi{:mathvariant => "normal"} true
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mi{:mathvariant => "normal"} false
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \vee B \coloneqq \exists b:\mathrm{bool}.((b = \mathrm{true}) \to A) \times ((b = \mathrm{false}) \to B)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ∨
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \vee Q
            of two
            %a.existingWikiWord{:href => "/nlab/show/mere+propositions"} mere propositions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is also the
            %a.existingWikiWord{:href => "/nlab/show/join+type"} join type
            of the two types
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo *
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} P * Q
            %a.existingWikiWord{:href => "/nlab/show/subtype"} subtype
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is the
            %a.existingWikiWord{:href => "/nlab/show/union"} union
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            as two subtypes of the unit types, and the union of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            as subtypes of the unit type is defined to be the
            %a.existingWikiWord{:href => "/nlab/show/join+type"} join type
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
            %a.existingWikiWord{:href => "/nlab/show/pushout+type"} pushout type
            of the two product projection functions from the
            %a.existingWikiWord{:href => "/nlab/show/product+type"} product type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ×
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \times Q
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            respectively.
          %h2#classical_vs_constructive Classical vs constructive
          %p
            There are a variety of connectives that are distinct in
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            but are all equivalent to disjunction in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo ¬
                          %mo{:stretchy => "false"} (
                          %mo ¬
                          %mi P
                          %mo ∧
                          %mo ¬
                          %mi Q
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mi ⇗
                        %mtd
                        %mtd
                          %mi ⇖
                      %mtr
                        %mtd
                          %mo ¬
                          %mi P
                          %mo →
                          %mi Q
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi P
                          %mo ←
                          %mo ¬
                          %mi Q
                      %mtr
                        %mtd
                        %mtd
                          %mi ⇖
                        %mtd
                        %mtd
                          %mi ⇗
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mo ¬
                          %mi P
                          %mo →
                          %mi Q
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %mi P
                          %mo ←
                          %mo ¬
                          %mi Q
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo ⇑
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi P
                          %mo ∨
                          %mi Q
                %annotation{:encoding => "application/x-tex"}
                  \\array {           &amp;          &amp; \neg(\neg{P} \wedge \neg{Q}) \\
                  \&amp; &amp;#x21d7; &amp;          &amp; &amp;#x21d6; \\
                  \\neg{P} \rightarrow Q &amp;          &amp;          &amp;          &amp; P \leftarrow \neg{Q} \\
                  \&amp; &amp;#x21d6; &amp;          &amp; &amp;#x21d7; \\
                  \&amp;          &amp; (\neg{P} \rightarrow Q) \wedge (P \leftarrow \neg{Q}) \\
                  \&amp;          &amp; \Uparrow \\
                  \&amp;          &amp; P \vee Q }
          %p
            (A single arrow is implication in the object language; a double arrow is entailment in the metalanguage.) Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mi P
                  %mo ∧
                  %mo ¬
                  %mi Q
                %annotation{:encoding => "application/x-tex"} \neg{P} \wedge \neg{Q}
            is the
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            of every item in this diagram.
          %p
            In the
            %span.newWikiWord
              double-negation interpretation
              %a{:href => "/nlab/new/double-negation+interpretation"} ?
            of classical logic in intuitionistic logic,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo ∧
                  %mo ¬
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg(\neg{P} \wedge \neg{Q})
            is the interpretation in intuitionistic logic of disjunction in classical logic. For this reason,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo ∧
                  %mo ¬
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg(\neg{P} \wedge \neg{Q})
            is sometimes called
            = succeed "." do
              %em classical disjunction
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo ∧
                  %mo ¬
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \neg(\neg{P} \wedge \neg{Q})
            is merely the fallback position when nothing better can be found. (And as can be seen in the example in the paragraph after next, sometimes even this is not valid.)
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/antithesis+interpretation"} antithesis interpretation
            of
            %a.existingWikiWord{:href => "/nlab/show/affine+logic"} affine logic
            in intuitionistic logic,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ¬
                  %mi P
                  %mo →
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ←
                  %mo ¬
                  %mi Q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\neg{P} \rightarrow Q) \wedge (P \leftarrow \neg{Q})
            is the interpretation of the
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+disjunction"} multiplicative disjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ⅋
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \parr Q
            for affirmative propositions. More generally, a statement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            in affine logic is interpreted as a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi P
                    %mo +
                  %mo ,
                  %msup
                    %mi P
                    %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (P^+,P^-)
            of mutually contradictory statements in intuitionistic logic;
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo −
                %annotation{:encoding => "application/x-tex"} P^-
            is simply the negation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo +
                %annotation{:encoding => "application/x-tex"} P^+
            for affirmative propositions, but in general,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo −
                %annotation{:encoding => "application/x-tex"} P^-
            only entails
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mrow
                      %msup
                        %mi P
                        %mo +
                  %annotation{:encoding => "application/x-tex"} \neg{P^+}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ⅋
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \parr Q
            is interpreted as
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi P
                      %mo −
                    %mo →
                    %msup
                      %mi Q
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi P
                      %mo +
                    %mo ←
                    %msup
                      %mi Q
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi P
                      %mo −
                    %mo ∧
                    %msup
                      %mi Q
                      %mo −
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \big((P^- \rightarrow Q^+) \wedge (P^+ \leftarrow Q^-), P^- \wedge Q^-\big)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ⅋
                  %mi Q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo +
                %annotation{:encoding => "application/x-tex"} (P \parr Q)^+
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi P
                      %mo −
                    %mo →
                    %msup
                      %mi Q
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi P
                      %mo +
                    %mo ←
                    %msup
                      %mi Q
                      %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P^- \rightarrow Q^+) \wedge (P^+ \leftarrow Q^-)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo ⅋
                  %mi Q
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo −
                %annotation{:encoding => "application/x-tex"} (P \parr Q)^-
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mo −
                    %mo ∧
                    %msup
                      %mi Q
                      %mo −
                  %annotation{:encoding => "application/x-tex"} P^- \wedge Q^-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ⊕
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \oplus Q
            is interpreted as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi P
                      %mo +
                    %mo ∨
                    %msup
                      %mi Q
                      %mo +
                    %mo ,
                    %msup
                      %mi P
                      %mo −
                    %mo ∧
                    %msup
                      %mi Q
                      %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P^+ \vee Q^+, P^- \wedge Q^-)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ⊕
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \oplus Q
            entails
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo ⅋
                  %mi Q
                %annotation{:encoding => "application/x-tex"} P \parr Q
            in affine logic, even though they are independent in linear logic.)
          %p
            For a non-affirmative example, in the arithmetic of (located)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ∨
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a = 0) \vee (b = 0)
            from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi b
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a b = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo ¬
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \neg\big(\neg(a = 0) \wedge \neg(b = 0)\big)
            without
            %a.existingWikiWord{:href => "/nlab/show/Markov%27s+principle"} Markov's principle
            (or at least some weak version of it), but it
            %em is
            valid to derive
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo #
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a \# 0) \rightarrow (b = 0)
            (and conversely), where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo #
                %annotation{:encoding => "application/x-tex"} \#
            is the usual
            %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
            between real numbers. (Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo +
                %annotation{:encoding => "application/x-tex"} P^+
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} a = 0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mo −
                %annotation{:encoding => "application/x-tex"} P^-
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo #
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \# 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            and
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo #
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo #
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"} \neg\big((a \# 0) \wedge (b \# 0)\big)
            (which is actually equivalent).
          %h2#RoI Rules of inference
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/rule+of+inference"} rules of inference
            for disjunction in
            %a.existingWikiWord{:href => "/nlab/show/sequent+calculus"} sequent calculus
            are dual to those for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} conjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "true", :rowspacing => "1.0ex"}
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi Γ
                              %mo ,
                              %mi p
                              %mo ,
                              %mi Δ
                              %mo ⊢
                              %mi Σ
                              %mo ;
                              %mspace{:width => "thickmathspace"}
                              %mi Γ
                              %mo ,
                              %mi q
                              %mo ,
                              %mi Δ
                              %mo ⊢
                              %mi Σ
                            %mrow
                              %mi Γ
                              %mo ,
                              %mi p
                              %mo ∨
                              %mi q
                              %mo ,
                              %mi Δ
                              %mo ⊢
                              %mi Σ
                          %mspace{:width => "thickmathspace"}
                          %mtext left additive
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi Δ
                              %mo ,
                              %mi p
                              %mo ,
                              %mi Σ
