                              %mi Γ
                              %mo ⊢
                              %mi Δ
                              %mo ,
                              %mi p
                              %mo ∨
                              %mi q
                              %mo ,
                              %mi Σ
                          %mspace{:width => "thickmathspace"}
                          %mtext right additive 0
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi Δ
                              %mo ,
                              %mi q
                              %mo ,
                              %mi Σ
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi Δ
                              %mo ,
                              %mi p
                              %mo ∨
                              %mi q
                              %mo ,
                              %mi Σ
                          %mspace{:width => "thickmathspace"}
                          %mtext right additive 1
                      %mtr
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin {gathered}
                  \\frac { \Gamma , p , \Delta \vdash \Sigma ; \; \Gamma , q , \Delta \vdash \Sigma } { \Gamma , p \vee q , \Delta \vdash \Sigma } \; \text {left additive} \\
                  \\frac { \Gamma \vdash \Delta , p , \Sigma } { \Gamma \vdash \Delta , p \vee q , \Sigma } \; \text {right additive 0} \\
                  \\frac { \Gamma \vdash \Delta , q , \Sigma } { \Gamma \vdash \Delta , p \vee q , \Sigma } \; \text {right additive 1} \\
                  \\end {gathered}
          %p Equivalently, we can use the following rules with weakened contexts:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "true", :rowspacing => "1.0ex"}
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi Γ
                              %mo ,
                              %mi p
                              %mo ⊢
                              %mi Δ
                              %mo ;
                              %mspace{:width => "thickmathspace"}
                              %mi q
                              %mo ,
                              %mi Σ
                              %mo ⊢
                              %mi Π
                            %mrow
                              %mi Γ
                              %mo ,
                              %mi p
                              %mo ∨
                              %mi q
                              %mo ,
                              %mi Σ
                              %mo ⊢
                              %mi Δ
                              %mo ,
                              %mi Π
                          %mspace{:width => "thickmathspace"}
                          %mtext left multiplicative
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi Δ
                              %mo ,
                              %mi p
                              %mo ,
                              %mi q
                              %mo ,
                              %mi Σ
                            %mrow
                              %mi Γ
                              %mo ⊢
                              %mi Δ
                              %mo ,
                              %mi p
                              %mo ∨
                              %mi q
                              %mo ,
                              %mi Σ
                          %mtext right multiplicative
                      %mtr
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin {gathered}
                  \\frac { \Gamma , p \vdash \Delta ; \; q , \Sigma \vdash \Pi } { \Gamma , p \vee q , \Sigma \vdash \Delta , \Pi } \; \text {left multiplicative} \\
                  \\frac { \Gamma \vdash \Delta , p , q , \Sigma } { \Gamma \vdash \Delta , p \vee q , \Sigma } \text {right multiplicative} \\
                  \\end {gathered}
          %p
            The rules above are written so as to remain valid in logics without the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/exchange+rule"} exchange rule
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∨
                  %mi q
                %annotation{:encoding => "application/x-tex"} p \vee q
            in these rules as
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⊕
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p \oplus q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo ∨
                  %mi q
                %annotation{:encoding => "application/x-tex"} p \vee q
            in those rules as
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⅋
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p \parr q
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            rules for disjunction are a little more complicated than those for conjunction:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "true", :rowspacing => "1.0ex"}
                      %mtr
