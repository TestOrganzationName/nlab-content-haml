                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \| A \| \simeq \prod_{P:\mathrm{Prop}} (A \to P) \to P
            %p
              Substituting the sum type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo +
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A + B
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ‖
                    %mi A
                    %mo +
                    %mi B
                    %mo{:stretchy => "false"} ‖
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi P
                        %mo :
                        %mi{:mathvariant => "normal"} Prop
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo +
