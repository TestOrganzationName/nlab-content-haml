                      %mo ⊢
                      %mi P
                      %mo ∨
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} true
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi P
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %mi Q
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} prop
                    %mrow
                      %mi Γ
