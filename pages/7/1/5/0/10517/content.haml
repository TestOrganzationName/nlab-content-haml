                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi B
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} A\to B+1
            is equivalent to a decomposition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo +
                  %mi E
                %annotation{:encoding => "application/x-tex"} D+E
            together with a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} D\to B
            (the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} E\to 1
            being unique), and in a Boolean category every subobject of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is complemented and hence induces such a coproduct decomposition. The universal partial map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo +
                  %mn 1
                  %mo ⇀
                  %mi B
                %annotation{:encoding => "application/x-tex"} B+1 \rightharpoonup B
            has domain the summand
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ↦
                  %mi B
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} B\mapsto B+1
            is also known as the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/maybe+monad"} maybe monad
          %p
            Partial map classifiers also exist in every
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mn 1
                  %mo →
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} t : 1 \to \Omega
            denote the top element, the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi t
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} t_*(B)
            is precisely the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo ⊥
                  %mo →
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} B_\bot \to \Omega
            classifying
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⊆
                    %msub
                      %mi B
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} B \subseteq B_\bot
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ,
                          %msub
                            %mi B
                            %mo ⊥
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≅
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi p
                              %mo :
                              %mi A
                              %mo →
                              %mi Ω
                          %mi 𝒞
                          %mo{:stretchy => "false"} /
                          %mi Ω
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %msub
                            %mi t
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi p
                              %mo :
                              %mi A
                              %mo →
                              %mi Ω
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi t
                            %mo *
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %mrow
                              %mi A
                              %mo ′
                              %mo ⊆
                              %mi A
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ′
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≅
                          %msub
                            %mi Par
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathcal{C}(A, B_\bot)
                  \&amp;\cong \coprod_{p : A \to \Omega} \mathcal{C}/\Omega(p, t_*(B))
                  \\\&amp;\cong \coprod_{p : A \to \Omega} \mathcal{C}(t^*(p), B)
                  \\\&amp;\cong \coprod_{A' \subseteq A} \mathcal{C}(A', B)
                  \\\&amp;\cong Par_{\mathcal{C}}(A, B)
                  \\end{aligned}
          %p
            Alternatively, in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} B_\bot
            that more closely follow the classical construction are:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} B_\bot
                is a
                %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
                of the
                %a.existingWikiWord{:href => "/nlab/show/power+object"} power object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒫
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \mathcal{P}B
                consisting of the
                %a.existingWikiWord{:href => "/nlab/show/subsingleton"} subsingleton
                subobjects of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mo ⊥
                      %mo ⇀
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B_\bot \rightharpoonup B
                has domain the set of
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                subobjects of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} B_\bot
                is the object of partial maps
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ⇀
                        %mi B
                      %annotation{:encoding => "application/x-tex"} 1 \rightharpoonup B
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mo ⊥
                      %mo ⇀
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B_\bot \rightharpoonup B
                has domain the set of partial maps which are total, on which it is an isomorphism.
          %p
            Note that neither of these constructions is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative
            %a.existingWikiWord{:href => "/nlab/show/higher+category"} higher category
            (or in its internal logic such as
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          .num_remark
            %h6#remark Remark
            %p
              In an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} intuitionistic context
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} B + 1
              still classifies something: namely partial maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⇀
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \rightharpoonup B
              whose domain of definition is a
              %a.existingWikiWord{:href => "/nlab/show/decidable+subset"} decidable subobject
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} type theory
              one uses the partiality
              %a{:href => "monad+%28in+computer+science%29"} monad
              to treat general recursion as an algebraic effect. In this we we obtain a classifier for recursively enumerable subsets. Is
              %a{:href => "http://www.cs.ox.ac.uk/ralf.hinze/WG2.8/22/slides/tarmo.pdf"} this
              the first appearance? It is clear that this idea can be generalized to other classes of propositions.
          %h2#relative_partial_maps Relative partial maps
          %p
            Given objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi X
