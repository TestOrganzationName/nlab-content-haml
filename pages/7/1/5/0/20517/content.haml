                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{F}
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mover
                      %mi H
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{H}
              ) being the (dual)
              = succeed "/" do
