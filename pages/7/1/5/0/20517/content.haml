            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "88.578", "xlink:href" => "#f-u2bUXZQi0gPQKa5_flVSzrSXQ=-glyph-1-2", :y => "8.126"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "86.717", "xlink:href" => "#f-u2bUXZQi0gPQKa5_flVSzrSXQ=-glyph-2-2", :y => "73.983"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "86.717", "xlink:href" => "#f-u2bUXZQi0gPQKa5_flVSzrSXQ=-glyph-3-2", :y => "73.983"}
            %path{:d => "M 77.41575 -5.978125 L 77.41575 -64.505469 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.478", :transform => "matrix(1, 0, 0, -1, 9.303, 9.475)"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "80.124", "xlink:href" => "#f-u2bUXZQi0gPQKa5_flVSzrSXQ=-glyph-4-1", :y => "86.446"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "88.578", "xlink:href" => "#f-u2bUXZQi0gPQKa5_flVSzrSXQ=-glyph-1-3", :y => "82.108"}
          %p Write
          #eq:FiberVectorField.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mn 5
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  v^5 \in \Gamma( T \Sigma^6 )
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            which reflects the infinitesimal
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            on
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:FibrationWorldvolume"} (5)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %mi d
                  %mo ,
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⟶
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_{v^5}
                  \\;=\;
                  \\big[d, \iota_{v^5} \big]
                  \\;\colon\;
                  \\Omega^\bullet\big( \Sigma^6 \big)
                  \\longrightarrow
                  \\Omega^\bullet\big( \Sigma^6  \big)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            of
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            along
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi v
                      %mn 5
                  %annotation{:encoding => "application/x-tex"} v^5
            %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+magic+formula"} Cartan's magic formula
            expressing it as an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/anti-commutator"} anti-commutator
          %p
            Next consider an
            %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connection"} Ehresmann connection
            on the
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:FibrationWorldvolume"} (5)
            %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\theta^5
                  \\;\in\;
                  \\Omega^1\big( \Sigma^6 \big)
          %p such that
          #eq:EhresmannConditions.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi θ
                    %mn 5
                  %mo =
                  %mn 1
                  %mphantom
                    %mi AA
                  %mtext and
                  %mphantom
                    %mi AA
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi θ
                    %mn 5
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\iota_{v^5} \theta^5 = 1
                  \\phantom{AA}
                  \\text{and}
                  \\phantom{AA}
                  \\mathcal{L}_{v^5} \theta^5 = 0
          %p So in particular
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⟶
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\theta^5 \wedge \iota_{v^5}
                  \\;:\;
                  \\Omega^\bullet\big( \Sigma^6\big)
                  \\longrightarrow
                  \\Omega^\bullet\big( \Sigma^6\big)
          %p
            is a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/projection+operator"} projection operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo ∘
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                %annotation{:encoding => "application/x-tex"}
                  \\theta^5 \wedge \iota_{v^5}
                  \\circ
                  \\theta^5 \wedge \iota_{v^5}
                  \\;=\;
                  \\theta^5 \wedge \iota_{v^5}
          %p
            The complementary projection is that onto
            %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} hor
                  %mo :
                  %mo =
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} id
                  %mo −
                  %msup
                    %mi θ
                    %mn 5
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⟶
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  (-)^{\mathrm{hor}}
                  \:=
                  \\big(\mathrm{id} - \theta^5 \iota_{v^5})
                  \\;:\;
                  \\Omega^\bullet\big( \Sigma^6\big)
                  \\longrightarrow
                  \\Omega^\bullet\big( \Sigma^6\big)
          %p
            We require
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi v
                    %mn 5
                %annotation{:encoding => "application/x-tex"} v^5
            %a.maruku-eqref{:href => "#eq:FiberVectorField"} (6)
            to be a
            %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isometry"} isometry
          #eq:HodgeStarCommutingWithIsometryContraction.maruku-equation
            %span.maruku-eq-number (8)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mo ∘
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %mo ∘
                  %mo ⋆
                  %mspace{:width => "thickmathspace"}
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi Ω
                    %mn 3
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ⟶
                  %msup
                    %mi Ω
                    %mn 4
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msup
                    %mi Σ
                    %mn 6
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\star \circ \iota_{v^5}
                  \=
                  \-
                  \\theta^5 \wedge \circ \star
                  \\;:\;
                  \\Omega^3\big( \Sigma^6\big)
                  \\longrightarrow
                  \\Omega^4\big( \Sigma^6 \big)
          %h4#selfduality_after_compactification
            Self-duality after
            = succeed "-compactification" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
          %p
            Set (
            %a{:href => "#PerrySchwarz96"}> PS 96 (5)
            )
          #eq:DefOfCalF.maruku-equation
            %span.maruku-eq-number (9)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{F}
                  \\;\coloneqq\;
                  \\iota_{v^5} H
          %p
            and (
            %a{:href => "#PerrySchwarz96"}> PS 96 (6)
            )
          #eq:DefOfTildeH.maruku-equation
            %span.maruku-eq-number (10)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ˜
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo ⋆
                  %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\tilde H
                  \\;\coloneqq\;
                  \\iota_{v^5} \star H
          %p
            With this notation the self-duality condition
            %a.maruku-eqref{:href => "#eq:SelfDualityIn6d"} (4)
            is equivalently (
            %a{:href => "#PerrySchwarz96"}> PS 96 (9)
            , see
            %a.maruku-eqref{:href => "#eq:EquivalentIncarnationsOfSelfDuality"} (12)
            below):
          #eq:SelfDualityIntermsOfcalF.maruku-equation
            %span.maruku-eq-number (11)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{F}
                  \\;=\;
                  \\tilde H
          %p To make this fully explicit, notice that we have the following chain of logical equivalences:
          #eq:EquivalentIncarnationsOfSelfDuality.maruku-equation
            %span.maruku-eq-number (12)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi H
                          %mo =
                          %mo ⋆
                          %mi H
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo ⇔
                          %mrow
                            %mo (
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                  %mtd
                                    %mphantom
                                      %mrow
                                        %mtext and
                                        %mspace{:width => "thickmathspace"}
                                    %msub
                                      %mi ι
                                      %mrow
                                        %msub
                                          %mi v
                                          %mn 5
                                    %mi H
                                    %mo =
                                    %msub
                                      %mi ι
                                      %mrow
                                        %msup
                                          %mi v
                                          %mn 5
                                    %mo ⋆
                                    %mi H
                                %mtr
                                  %mtd
                                  %mtd
                                    %mtext and
                                    %mspace{:width => "thickmathspace"}
                                    %msup
                                      %mi θ
                                      %mn 5
                                    %mo ∧
                                    %mi H
                                    %mo =
                                    %msup
                                      %mi θ
                                      %mn 5
                                    %mo ∧
                                    %mo ⋆
                                    %mi H
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo ⇔
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mi H
                          %mo =
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mo ⋆
                          %mi H
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ⇔
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi ℱ
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mover
                            %mi H
                            %mo ˜
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\big(
                  H = \star H
                  \\big)
                  \&amp; \Leftrightarrow
                  \\left(
                  \\array{
                  \&amp;
                  \\phantom{\text{and}\;}
                  \\iota_{v_5} H  = \iota_{v^5} \star H
                  \\\
                  \&amp;
                  \\text{and}\;
                  \\theta^5 \wedge H = \theta^5 \wedge \star H
                  }
                  \\right)
                  \\\
                  \&amp; \Leftrightarrow
                  \\big(
                  \\iota_{v^5} H = \iota_{v^5} \star H
                  \\big)
                  \\\
                  \&amp;\Leftrightarrow
                  \\big(
                  \\mathcal{F}
                  \\;=\;
                  \\widetilde H
                  \\big)
                  \\end{aligned}
          %p
            Here the first step is decomposition of the self-duality equation into components, the second step follows by
            %a.maruku-eqref{:href => "#eq:HodgeStarCommutingWithIsometryContraction"} (8)
            and the third step invokes the definitions
            %a.maruku-eqref{:href => "#eq:DefOfCalF"} (9)
            and
            %a.maruku-eqref{:href => "#eq:DefOfTildeH"} (10)
            and the fourth step the equality
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:DecompositionOfCalF"} (14)
          %h4#the_gauge_field The gauge field
          %p
            Define the
            %a.existingWikiWord{:href => "/nlab/show/vector+potential"} vector potential
            (
            %a{:href => "#PerrySchwarz96"}> PS 96 above (4)
            )
          #eq:AField.maruku-equation
            %span.maruku-eq-number (13)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  A
                  \\;\coloneqq\;
                  \-
                  \\iota_{v^5} B
          %p With this we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi A
                  %mo ∧
                  %msup
                    %mi θ
                    %mn 5
                  %mo +
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B
                  \\;=\;
                  A \wedge \theta^5
                  +
                  B^{\mathrm{hor}}
                  \\,.
          %p
            Set also (
            %a{:href => "#PerrySchwarz96"}> PS 96 above (4)
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi d
                  %mi A
                  %msup
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi{:mathvariant => "normal"} hor
                %annotation{:encoding => "application/x-tex"}
                  F
                  \\;\coloneqq\;
                  \\big( d A \big)^{\mathrm{hor}}
          %p
            then (
            %a{:href => "#PerrySchwarz96"}> PS 96 (5)
            )
          #eq:DecompositionOfCalF.maruku-equation
            %span.maruku-eq-number (14)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi ℱ
                        %mtd
                          %mo ≔
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mi d
                          %mi B
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi d
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mi B
                          %mo +
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mo ,
                          %mi d
                          %mo{:stretchy => "false"} ]
                          %mi B
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi d
                          %mi A
                          %mo +
                          %msub
                            %mi ℒ
                            %mn 5
                          %mi B
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi F
                          %mo +
                          %msup
                            %mi θ
                            %mn 5
                          %mo ∧
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mi d
                          %mi A
                          %mo +
                          %msub
                            %mi ℒ
                            %mn 5
                          %msup
                            %mi B
                            %mi{:mathvariant => "normal"} hor
                          %mo +
                          %munder
                            %munder
                              %mrow
                                %msub
                                  %mi ℒ
                                  %mn 5
                                %msup
                                  %mi θ
                                  %mn 5
                                %mo ∧
                                %msub
                                  %mi ι
                                  %mrow
                                    %msup
                                      %mi v
                                      %mn 5
                                %mi B
                              %mo ⏟
                            %mrow
                              %mo =
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mi θ
                                %mn 5
                              %mo ∧
                              %msub
                                %mi ℒ
                                %mrow
                                  %msup
                                    %mi v
                                    %mn 5
                              %mi A
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi F
                          %mo +
                          %msub
                            %mi ℒ
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %msup
                            %mi B
                            %mi{:mathvariant => "normal"} hor
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\mathcal{F}
                  \&amp;\coloneqq
                  \\iota_{v^5} H
                  \\\
                  \&amp; =
                  \\iota_{v^5} d B
                  \\\
                  \&amp; =
                  \- d \iota_{v^5} B + [\iota_{v^5}, d] B
                  \\\
                  \&amp; =
                  d A + \mathcal{L}_5 B
                  \\\
                  \&amp; =
                  F
                  + \theta^5 \wedge \iota_{v^5} d A
                  + \mathcal{L}_5 B^{\mathrm{hor}}
                  +
                  \\underset{
                  \= -\theta^5 \wedge \mathcal{L}_{v^5} A
                  }{
                  \\underbrace{
                  \\mathcal{L}_5 \theta^5 \wedge \iota_{v^5} B
                  }
                  }
                  \\\
                  \&amp;
                  \=
                  F
                  +
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\end{aligned}
          %p
            where in the last step under the brace we used
            %a.maruku-eqref{:href => "#eq:EhresmannConditions"} (7)
            and
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:AField"} (13)
          %p
            Hence in terms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                %annotation{:encoding => "application/x-tex"} B^{\mathrm{hor}}
            the self-duality condition
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:SelfDualityIn6d"} (4)
            %a.maruku-eqref{:href => "#eq:SelfDualityIntermsOfcalF"} (11)
            is equivalently expressed as on the right of the following
          #eq:SelfDualityDecomposition.maruku-equation
            %span.maruku-eq-number (15)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi H
                  %mo =
                  %mo ⋆
                  %mi H
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mover
                    %mi H
                    %mo ˜
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi F
                  %mo +
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  \\big(
                  H = \star H
                  \\big)
                  \\;\Leftrightarrow\;
                  \\big(
                  \\widetilde H
                  \\;=\;
                  F + \mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
          %h4#weak_selfduality_and_psequations_of_motion Weak self-duality and PS-equations of motion
          %p Notice that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi θ
                            %mn 5
                          %mo ∧
                          %mi d
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mi A
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi hor
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo =
                          %msup
                            %mi θ
                            %mn 5
                          %mo ∧
                          %mi d
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi d
                          %mi A
                          %mo −
                          %msup
                            %mi θ
                            %mn 5
                          %mo ∧
                          %msub
                            %mi ι
                            %mrow
                              %msub
                                %mi v
                                %mn 5
                          %mi d
                          %mi A
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msup
                            %mi θ
                            %mn 5
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %mi d
                          %msup
                            %mi θ
                            %mn 5
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msub
                            %mi ι
                            %mrow
                              %msub
                                %mi v
                                %mn 5
                          %mi d
                          %mi A
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\theta^5 \wedge d
                  \\big( (d A)^{hor} \big)
                  \&amp; =
                  \\theta^5 \wedge d
                  \\big( d A - \theta^5 \wedge \iota_{v_5} d A\big)
                  \\\
                  \&amp; =
                  \\theta^5 \wedge (d \theta^5) \wedge \iota_{v_5} d A
                  \\end{aligned}
                  \\,.
          %p
            Hence assume now hat the Ehresmann connection is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msup
                      %mi θ
                      %mn 5
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d \theta^5 = 0
          %p
            Then the self-duality condition in the form
            %a.maruku-eqref{:href => "#eq:SelfDualityDecomposition"} (15)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi H
                    %mo ˜
                  %mo −
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi{:mathvariant => "normal"} hor
                %annotation{:encoding => "application/x-tex"}
                  \\widetilde H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\;=\;
                  (d A)^{\mathrm{hor}}
          %p
            implies, after applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %mi d
                %annotation{:encoding => "application/x-tex"} \theta^5 \wedge d
            to both sides, the second-order equation (
            %a{:href => "#PerrySchwarz96"}> PS 96 (16)
            )
          #eq:TheEquationOfMotion.maruku-equation
            %span.maruku-eq-number (16)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo =
                  %mo ⋆
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %mi d
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mover
                    %mi H
                    %mo ˜
                  %mo −
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  (H = \star H)
                  \\;\;\;\Rightarrow\;\;\;
                  \\theta^5
                  \\wedge
                  d
                  \\big(
                  \\widetilde H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\;=\;
                  0
          %p This equation by itself is hence a weakened form of the self-duality condition, a kind of “self-duality up to horizontally closed terms”.
          %p
            The proposal of
            %a{:href => "#PerrySchwarz96"} Perry-Schwarz 96, Sec. 2
            is to take this as the relevant
            %a.existingWikiWord{:href => "/nlab/show/equation+of+motion"} equation of motion
            for the theory on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
          %h4#lagrangian_density Lagrangian density
          %p
            Therefore one is looking now for a
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            whose
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange equations
            are
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:TheEquationOfMotion"} (16)
          %p
            The
            %em Perry-Schwarz-Lagrangian
            is (
            %a{:href => "#PerrySchwarz96"}> PS 96 (17)
            )
          #eq:CartanCalculusPerrySchwarzLagrangian.maruku-equation
            %span.maruku-eq-number (17)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ˜
                  %mo −
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ∧
                  %mo ⋆
                  %mover
                    %mi H
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"}
                  L
                  \\;\coloneqq\;
                  \-
                  \\tfrac{1}{2}
                  \\big(
                  \\tilde H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\wedge
                  \\star
                  \\tilde H
          %p
            With
            %a.maruku-eqref{:href => "#eq:HodgeStarCommutingWithIsometryContraction"} (8)
            the Lagrangian
            %a.maruku-eqref{:href => "#eq:CartanCalculusPerrySchwarzLagrangian"} (17)
            becomes
          #eq:LagrangianUsingIsometry.maruku-equation
            %span.maruku-eq-number (18)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi L
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mover
                            %mi H
                            %mo{:stretchy => "false"} ˜
                          %mo −
                          %msub
                            %mi ℒ
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %msup
                            %mi B
                            %mi{:mathvariant => "normal"} hor
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ∧
                          %mi H
                          %mo ∧
                          %msup
                            %mi θ
                            %mn 5
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mo ⋆
                          %mi H
                          %mo −
                          %msub
                            %mi ℒ
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %msup
                            %mi B
                            %mi{:mathvariant => "normal"} hor
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ∧
                          %mi H
                          %mo ∧
                          %msup
                            %mi θ
                            %mn 5
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  L
                  \&amp; =
                  \-
                  \\tfrac{1}{2}
                  \\big(
                  \\tilde H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\wedge
                  H
                  \\wedge \theta^5
                  \\\
                  \&amp; =
                  \-
                  \\tfrac{1}{2}
                  \\big(
                  \\iota_{v^5} \star H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\wedge
                  H
                  \\wedge \theta^5
                  \\end{aligned}
          %p
            where in the second line we inserted the definition
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:DefOfTildeH"} (10)
          %p
            Notice that
            %a.maruku-eqref{:href => "#eq:LagrangianUsingIsometry"} (18)
            is the quadratic part of the following form-valued
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            on 2-form fields:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msup
                    %mi B
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi d
                  %msup
                    %mi B
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %msup
                    %mi θ
                    %mn 5
                %annotation{:encoding => "application/x-tex"}
                  (B, B^\prime)
                  \\;\mapsto\;
                  \-
                  \\tfrac{1}{2}
                  \\big(
                  \\iota_{v^5} \star (d B)
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\wedge
                  (d B^\prime)
                  \\wedge \theta^5
          %p
            Moreover, this bilinear form is
            %em symmetric
            up to a total derivative. For the first summand this is manifest from its incarnation in
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:CartanCalculusPerrySchwarzLagrangian"} (17)
          %p
            As a consequence, the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange equations
            of the Perry-Schwarz Lagrangian density
            %a.maruku-eqref{:href => "#eq:LagrangianUsingIsometry"} (18)
            may be computed from twice the variation of just the second factor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi δ
                          %msub
                            %mi L
                            %mi{:mathvariant => "normal"} sd
                        %mtd
                          %mo =
                          %mn 2
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mstyle{:displaystyle => "false"}
                            %mfrac
                              %mn 1
                              %mn 2
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mo ⋆
                          %mi H
                          %mo −
                          %msub
                            %mi ℒ
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %msup
                            %mi B
                            %mi{:mathvariant => "normal"} hor
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo ∧
                          %mi d
                          %mo{:stretchy => "false"} (
                          %mi δ
                          %mi B
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msup
                            %mi θ
                            %mn 5
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mi d
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi ι
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %mo ⋆
                          %mi H
                          %mo −
                          %msub
                            %mi ℒ
                            %mrow
                              %msup
                                %mi v
                                %mn 5
                          %msup
                            %mi B
                            %mi{:mathvariant => "normal"} hor
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                          %mo ∧
                          %mo{:stretchy => "false"} (
                          %mi δ
                          %mi B
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msup
                            %mi θ
                            %mn 5
                          %mo +
                          %mi d
                          %mo{:stretchy => "false"} (
                          %mi ⋯
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\delta L_{\mathrm{sd}}
                  \&amp; =
                  2
                  \\Big(
                  \-
                  \\tfrac{1}{2}
                  \\big(
                  \\iota_{v^5} \star H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\wedge
                  d(\delta B)
                  \\wedge
                  \\theta^5
                  \\Big)
                  \\\
                  \&amp; =
                  \\Big(
                  d
                  \\big(
                  \\iota_{v^5} \star H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\Big)
                  \\wedge
                  (\delta B)
                  \\wedge \theta^5
                  +
                  d(\cdots)
                  \\end{aligned}
          %p
            to indeed be
            = succeed ":" do
              %a.maruku-eqref{:href => "#eq:TheEquationOfMotion"} (16)
          #eq:EquationsOfMotion.maruku-equation
            %span.maruku-eq-number (19)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi θ
                    %mn 5
                  %mo ∧
                  %mi d
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo ⋆
                  %mi H
                  %mo −
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\theta^5 \wedge
                  d
                  \\big(
                  \\iota_{v^5} \star H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\;=\;
                  0
                  \\,.
          %p
            Notice that if we do use the self-duality condition
            %a.maruku-eqref{:href => "#eq:SelfDualityIn6d"} (4)
            on the Perry-Schwarz Lagrangian
            %a.maruku-eqref{:href => "#eq:LagrangianUsingIsometry"} (18)
            it becomes
          #eq:NonCovariantLagrangianInFlatSpacetime.maruku-equation
            %span.maruku-eq-number (20)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi{:mathvariant => "normal"} sd
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo −
                  %mstyle{:displaystyle => "false"}
                    %mfrac
                      %mn 1
                      %mn 2
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mi H
                  %mo −
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %msup
                    %mi B
                    %mi{:mathvariant => "normal"} hor
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo ∧
                  %mi H
                  %mo ∧
                  %msup
                    %mi θ
                    %mn 5
                  %mphantom
                    %mi AAAAA
                  %mtext if
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi H
                  %mo =
                  %mo ⋆
                  %mi H
                %annotation{:encoding => "application/x-tex"}
                  L_{\mathrm{sd}}
                  \\;=\;
                  \-
                  \\tfrac{1}{2}
                  \\big(
                  \\iota_{v^5} H
                  \-
                  \\mathcal{L}_{v^5} B^{\mathrm{hor}}
                  \\big)
                  \\wedge
                  H
                  \\wedge \theta^5
                  \\phantom{AAAAA}
                  \\text{if} \;\; H = \star H
          %h4#example_reduction_to_5d_maxwell_theory Example: Reduction to 5d Maxwell theory
          %p Consider the special case that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mi B
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_{v^5} B = 0
                  \\,,
          %p
            which corresponds to keeping only the 0-mode under
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            along the circle fiber.
          %p
            Then
            %a.maruku-eqref{:href => "#eq:DecompositionOfCalF"} (14)
            becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                  %mo =
                  %mi F
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{F} = F
          %p
            and so the self-duality condition
            %a.maruku-eqref{:href => "#eq:SelfDualityDecomposition"} (15)
            now becomes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mrow
                      %msup
                        %mi v
                        %mn 5
                  %mo ⋆
                  %mi H
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi F
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota_{v^5} \star H \;=\; F
                  \\,.
          %p which means that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mi F
                  %mo ∧
                  %msup
                    %mi θ
                    %mn 5
                  %mo +
                  %msub
                    %mo ⋆
                    %mn 5
                  %mi F
                %annotation{:encoding => "application/x-tex"}
                  H = F \wedge \theta^5 + \star_5 F
          %blockquote
            %p (check relative sign)
          %p
            Since
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi H
                    %mo =
                    %mi d
                    %mo ∘
                    %mi d
                    %mi B
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d H = d \circ d B = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi d
                          %mi H
                          %mo =
                          %mn 0
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtd
                          %mo ⇔
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                          %mi d
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi F
                          %mo ∧
                          %msup
                            %mi θ
                            %mn 5
                          %mo +
                          %msub
                            %mo ⋆
                            %mn 5
                          %mi F
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo =
                          %mn 0
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ⇔
                          %mrow
                            %mo (
                            %mrow
                              %mo {
                              %mrow
                                %mtable
                                  %mtr
                                    %mtd
                                      %msub
                                        %mi d
                                        %mn 5
                                      %mi F
                                    %mtd
                                      %mo =
                                      %mn 0
                                  %mtr
                                    %mtd
                                      %msub
                                        %mi d
                                        %mn 5
                                      %msub
                                        %mo ⋆
                                        %mn 5
                                      %mi F
                                    %mtd
                                      %mo =
                                      %mn 0
                            %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\big(
                  d H = 0
                  \\big)
                  \&amp; \Leftrightarrow
                  \\Big(
                  d
                  \\big(
                  F \wedge \theta^5
                  +
                  \\star_5 F
                  \\big)
                  \= 0
                  \\Big)
                  \\\
                  \&amp; \Leftrightarrow
                  \\left(
                  \\left\{
                  \\array{
                  d_5 F &amp; = 0
                  \\\
                  d_5 \star_5 F &amp; = 0
                  }
                  \\right.
                  \\right)
                  \\end{aligned}
          %p
            These are of course
            %a.existingWikiWord{:href => "/nlab/show/Maxwell%27s+equations"} Maxwell's equations
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn 5
                  %annotation{:encoding => "application/x-tex"} \Sigma^5
          %p
            (
            %a{:href => "#PerrySchwarz96"}> PS 96 above (16)
            )
          %h3#TheFullInteractingModel For the full interacting M5-brane sigma model
          %p
            The full interacting PS Lagrangian (
            %a{:href => "#PerrySchwarz96"}> PS 96 (63)
            ) has more terms..
          %p (…)
          %p
            (
            %a{:href => "#Schwarz97"}> Schwarz 97
            ,
            = succeed ")" do
              %a{:href => "#APPS97"} APPS 97
          %p (…)
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/D%3D5+super+Yang-Mills+theory"} D=5 super Yang-Mills theory
          %h2#references References
          %p The Perry-Schwarz action is due to
          %ul
            %li#PerrySchwarz96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Malcolm+Perry"}> Malcolm Perry
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Interacting Chiral Gauge Fields in Six Dimensions and Born-Infeld Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9611065"} arXiv:hep-th/9611065
            %li#Schwarz97
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"}> John Schwarz
                ,
                = succeed "," do
                  %em Coupling a Self-Dual Tensor to Gravity in Six Dimensions
                = succeed "," do
                  %a{:href => "http://cds.cern.ch/record/317663"} cds:317663
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/S0370-2693(97)00094-4"} doi:10.1016/S0370-2693(97)00094-4
            %li#APPS97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mina+Aganagic"}> Mina Aganagic
                , Jaemo Park, Costin Popescu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em World-Volume Action of the M Theory Five-Brane
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9701166"} arXiv:hep-th/9701166
          %p
            A similar construction but with compactification along the
            %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
            direction is due to
          %ul
            %li#HenneauxTeitelboim88
              %a.existingWikiWord{:href => "/nlab/show/Marc+Henneaux"}> Marc Henneaux
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Claudio+Teitelboim"} Claudio Teitelboim
              = succeed "," do
                %em
                  Dynamics of chiral (self-dual)
                  = succeed "-forms" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0370-2693(88)90712-5"} doi:10.1016/0370-2693(88)90712-5
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/double+dimensional+reduction"} double dimensional reduction
            to the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma-model"} Green-Schwarz sigma-model
            of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/D4-brane"} D4-brane
          %ul
            %li
              %p
                %a{:href => "#APPS97"} APPS 97, Section 6
            %li#APPS97b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mina+Aganagic"}> Mina Aganagic
                , Jaemo Park, Costin Popescu,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Schwarz"} John Schwarz
                = succeed "," do
                  %em Dual D-Brane Actions
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9702133"} arXiv:hep-th/9702133
          %p
            The covariant version via a
            %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar
            %a.existingWikiWord{:href => "/nlab/show/auxiliary+field"} auxiliary field
            is due to
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"}> Paolo Pasti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em On Lorentz Invariant Actions for Chiral P-Forms
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9611100"} arXiv:hep-th/9611100
            %li#PST97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"}> Paolo Pasti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em Covariant Action for a D=11 Five-Brane with the Chiral Field
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9701037"} arXiv:hep-th/9701037
            %li#BLNPST97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Bandos"}> Igor Bandos
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kurt+Lechner"} Kurt Lechner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexei+Nurmagambetov"} Alexei Nurmagambetov
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Paolo+Pasti"} Paolo Pasti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dmitri+Sorokin"} Dmitri Sorokin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mario+Tonin"} Mario Tonin
                = succeed "," do
                  %em Covariant Action for the Super-Five-Brane of M-Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/9701149"} arXiv:hep-th/9701149
          %p Speculations about non-abelian generalizations (for several coincident M5-branes):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chong-Sun+Chu"}> Chong-Sun Chu
              ,
              = succeed "," do
                %em A proposal for the worldvolume action of multiple M5-branes
              = succeed ")" do
                %a{:href => "http://hep.phy.ntnu.edu.tw/old_version/talks/2013/2013-05-09Chong-SunChu.pdf"} pdf
          %p The above text follows
          %ul
            %li#FSS19c
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
