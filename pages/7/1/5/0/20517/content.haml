            %path{:d => "M 9.302469 -0.0015625 L 67.833719 -0.0015625 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.478", :transform => "matrix(1, 0, 0, -1, 9.303, 9.475)"}
