            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "77.135", "xlink:href" => "#f-u2bUXZQi0gPQKa5_flVSzrSXQ=-glyph-2-1", :y => "9.475"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
