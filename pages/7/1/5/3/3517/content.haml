                              %mo{:stretchy => "false"} ↓
                              %mi v
                        %mtr
                          %mtd
                            %mi K
                          %mtd
                            %munder
                              %mo →
                              %mi k
                          %mtd
                            %mi G
                          %mtd
                            %munder
                              %mo →
                              %mi p
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{L &amp; \overset{l}{\to} &amp; H &amp; \overset{q}{\to} &amp; C\\
                    ^u\downarrow &amp;&amp; \downarrow^w &amp;&amp; \downarrow^v \\
                    K &amp; \underset{k}{\to} &amp; G&amp; \underset{p}{\to} &amp; B}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              are
              %a.existingWikiWord{:href => "/nlab/show/split+epimorphisms"} split epimorphisms
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                  %annotation{:encoding => "application/x-tex"} l
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              are their
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                    %annotation{:encoding => "application/x-tex"} w
          %p
            (see
            = succeed ")" do
              %a{:href => "#Janelidze09"} Janedlze 2009, Prop. 1.3.3.
          .num_remark
            %h6#remark_2 Remark
            %p
