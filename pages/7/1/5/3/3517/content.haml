          %h3#short_split_five_lemma Short split five lemma
          %p
            The
            %strong short split five lemma
            is a statement usually stated in the setup of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/semiabelian+categories"} semiabelian categories
          .num_cor
            %h6#corollary_2 Corollary
            %p
              %strong (short split five lemma)
            %p Given a commutative diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi L
                          %mtd
                            %mover
                              %mo →
                              %mi l
