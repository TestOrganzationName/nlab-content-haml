                          %mtd
                            %mo →
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi B
                              %mo{:stretchy => "false"} ˜
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                          %mtd
