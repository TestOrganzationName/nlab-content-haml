                            %mi H
                          %mtd
                            %mover
                              %mo →
                              %mi q
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mi u
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mi w
                          %mtd
