                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                    %mo −
                    %msub
                      %mi f
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi f
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} f_3 (d a_2 + a_3) = d f_2(a_2) + f_3(a_3) = d b' + f_3(a_3) = b - f_3(a_3) + f_3(a_3) = b
            %p
              demonstrating that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is in the image of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} f_3
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} f_3
              is an epimorphism.
          %p
          #FiveLemmaForNonabelianGroups.num_remark
            %h6 Remark
            %p
              %strong
                (five-lemma for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/non-abelian+groups"} non-abelian groups
              %br/
              The five lemma (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FiveLemma"}
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              of all
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              (including
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+groups"} non-abelian groups
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian
              %a.existingWikiWord{:href => "/nlab/show/homological+category"} homological category
              (by
              = succeed ");" do
                %a{:href => "homological+category#CategoryOfGroupsIsHomological"} this Example
              = succeed "." do
                %a{:href => "#InHomologicalCategories"} below
          %p
          .num_remark
            %h6 Remark
            %p
              One may avoid appealing to the
              %a.existingWikiWord{:href => "/nlab/show/Freyd-Mitchell+embedding+theorem"} Freyd-Mitchell embedding theorem
              in the above proof if one works with
              %a.existingWikiWord{:href => "/nlab/show/element+in+an+abelian+category"} generalized elements
              or uses the device of
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} interpreting
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular logic
              in the given abelian category. The former requires a bit of manual reformulation, while the latter is almost automatic, as the element-based proof given above only uses (constructive) regular reasoning.
