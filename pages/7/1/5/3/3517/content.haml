            %p
              then the middle vertical morphism (dashed) is also an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          (e.g.
          = succeed ")" do
            %a{:href => "#Janelidze09"} Janelidze 2009, Thm. 1.4.4
          %p
          #FiveLemmaInHomologicalCategoryOfNonabelianGroups.num_remark
            %h6 Example
            %p
              %strong (five-lemma in the homological category of non-abelian groups)
              %br/
              Since the category
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              of all
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              (including
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/non-abelian+groups"} non-abelian groups
              %a.existingWikiWord{:href => "/nlab/show/homological+category"} homological
              (by
              = succeed ")," do
                %a{:href => "homological+category#CategoryOfGroupsIsHomological"} this Example
              %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
              (Rem.
              = succeed ")" do
                %a.maruku-ref{:href => "#FiveLemmaForNonabelianGroups"}
              = succeed "." do
                %a.maruku-ref{:href => "#FiveLemmaInHomologicalCategories"}
          %h2#immediate_consequences Immediate consequences
          %h3#short_five_lemma Short five lemma
          %p
            A special case of the five lemma is the
            %em short five lemma
            where the objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %msub
                    %mi B
                    %mn 1
                  %mo ,
                  %msub
                    %mi A
                    %mn 5
                  %mo ,
                  %msub
                    %mi B
                    %mn 5
                %annotation{:encoding => "application/x-tex"} A_1,B_1,A_5,B_5
            above are all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zero+objects"} zero objects
          #ShortFiveLemma.num_cor
            %h6#corollary Corollary
            %p
              %strong (short five lemma)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \to B \to C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \to \tilde B \to C
              be two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exact+sequences"} exact sequences
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} f \colon B \to \tilde B
              makes the
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi f
                          %mtd
                          %mtd
                            %mi C
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi B
                              %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; B
                    \\\
                    \&amp; \nearrow &amp;&amp; \searrow
                    \\\
                    A &amp;&amp;\downarrow^{\mathrlap{f}}&amp;&amp; C
                    \\\
                    \&amp; \searrow &amp;&amp; \nearrow
                    \\\
                    \&amp;&amp; \tilde B
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commute
              , then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_2 Proof
            %p
              Apply prop.
              %a.maruku-ref{:href => "#FiveLemma"}
              to the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
