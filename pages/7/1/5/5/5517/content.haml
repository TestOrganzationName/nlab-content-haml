            In the terminology of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifold
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Jandl+gerbe"} Jandl gerbe
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                \/
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
