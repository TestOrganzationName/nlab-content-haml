          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi a
                  %mo →
                  %mi a
                %annotation{:encoding => "application/x-tex"} t \colon a \to a
            in a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %strong Kleisli object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi t
                %annotation{:encoding => "application/x-tex"} a_t
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            is, if it exists, the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
            right
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %a.existingWikiWord{:href => "/nlab/show/module+over+a+monad"} module
            or
            = succeed "-opalgebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi t
                %annotation{:encoding => "application/x-tex"} a_t
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represents
            the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi RMod
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} RMod(-,t)
            that takes an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            to the category of right
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} a \to x
          %p
            This means that there is a “free”
            %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi t
                  %mo{:lspace => "verythinmathspace"} :
                  %mi a
                  %mo →
                  %msub
                    %mi a
                    %mi t
                %annotation{:encoding => "application/x-tex"} f_t \colon a \to a_t
            and a
            %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi f
                    %mi t
                  %mi t
                  %mo ⇒
                  %msub
                    %mi f
                    %mi t
                %annotation{:encoding => "application/x-tex"} \alpha \colon f_t t \Rightarrow f_t
            that induce an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi t
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi RMod
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(a_t,x) \cong RMod(x,t)
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %mi a
                    %mo →
                    %mi x
                    %mo ,
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi r
                    %mi t
                    %mo →
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r \colon a \to x, \rho \colon r t \to r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi a
                    %mi t
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} h \colon a_t \to x
            whose
            %a.existingWikiWord{:href => "/nlab/show/composition"} composite
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi t
                %annotation{:encoding => "application/x-tex"} f_t
            (respectively
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            (resp.
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
