          .num_remark
            %h6 Example
            %p
              The motivating example is that of ordinary
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+categories"} Kleisli categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C_T
              for monads in the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              %a.existingWikiWord{:href => "/nlab/show/endofunctors"} endofunctors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              on
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %p
          .num_remark
            %h6 Example
            %p
              In a (
              %a.existingWikiWord{:href => "/nlab/show/locally+ordered"}> locally ordered
              )
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bicategory+of+relations"} bicategory of relations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              is part of a
              %a.existingWikiWord{:href => "/nlab/show/splitting"} splitting
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              as an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/idempotent"} idempotent
          %p
          .num_remark
            %h6 Example
            %p
              For a monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mi ⇸
                    %mi A
                  %annotation{:encoding => "application/x-tex"} T \colon A &amp;#8696; A
              in the bicategory
              %a.existingWikiWord{:href => "/nlab/show/Prof"} Prof
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi T
                  %annotation{:encoding => "application/x-tex"} A_T
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/bijective-on-objects+functor"} bijective-on-objects functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %msub
                        %mi A
                        %mi T
                    %annotation{:encoding => "application/x-tex"} A\to A_T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi T
                  %annotation{:encoding => "application/x-tex"} A_T
              has the same objects as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A_T(a,b) = T(a,b)
              %a.existingWikiWord{:href => "/nlab/show/monad+unit"} monad unit
              and multiplication of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            %p
              Every functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B \to A
              yields a monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(f,f)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Prof
                    %annotation{:encoding => "application/x-tex"} Prof
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %msub
                      %mi A
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B \to A_{A(f,f)} \to A
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Because of this, we can identify a monad on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} Prof
              with a bijective-on-objects functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \to B
          %h2#properties Properties
          %p
          .num_remark
            %h6 Remark
            %p
              By 2-category theoretic
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal duality
              (see at
              = succeed "):" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/opposite+2-category"} opposite 2-category
            %ol
              %li
                %p
                  Kleisli objects in a 2-category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                  are equivalently
                  %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+objects"} Eilenberg-Moore objects
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi K
                            %mi op
                        %annotation{:encoding => "application/x-tex"} K^{op}
              %li
                %p
                  Kleisli objects for monads in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi K
                          %mi co
                      %annotation{:encoding => "application/x-tex"} K^{co}
                  are equivalently Kleisli objects for
                  %a.existingWikiWord{:href => "/nlab/show/comonads"} comonads
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
            %p
          %p
          .num_remark
            %h6 Remark
            %p
              Kleisli objects for a monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              are equivalently a particular sort of
              %a.existingWikiWord{:href => "/nlab/show/weighted+limit"} weighted
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-colimits"} 2-colimits
              %a.existingWikiWord{:href => "/nlab/show/lax+colimits"} lax colimits
              of the
              %a.existingWikiWord{:href => "/nlab/show/lax+functor"} lax functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \ast \to K
              corresponding to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+object"} Eilenberg-Moore object
          %h2#references References
          %p An original article is
          %ul
            %li#Street72
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "," do
                %em The formal theory of monads
              %strong 2
              2 (1972) 149-168 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0022-4049(72)90019-9"}> doi:10.1016/0022-4049(72)90019-9
              \&amp;rbrack;
          %p
            Generalization from
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            to more general
            %a.existingWikiWord{:href => "/nlab/show/categories+enriched+in+a+bicategory"} categories enriched in a bicategory
            (where “Kleisli objects” are then called “collages”) is in
          %ul
            %li#GarnerShulman13
              %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"} Michael Shulman
              = succeed "," do
                %em Enriched categories as a free cocompletion
              %p
                Advances in Mathematics
                %strong 289
                (2016) 1-94 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1301.3191"}> arXiv:1301.3191
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2015.11.012"} doi:10.1016/j.aim.2015.11.012
