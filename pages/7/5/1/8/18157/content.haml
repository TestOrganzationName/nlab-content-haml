                  %annotation{:encoding => "application/x-tex"} U_{i_0}, U_{i_1}
              form a
              %a.existingWikiWord{:href => "/nlab/show/finite"} finite
              %a.existingWikiWord{:href => "/nlab/show/subobject"} sub
