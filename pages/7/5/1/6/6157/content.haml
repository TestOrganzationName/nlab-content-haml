          %h2#idea Idea
          %p
            The notion of an
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-module bundle
            is a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopification
            of the notion of a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/module+bundle"} module bundle
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %a.existingWikiWord{:href => "/nlab/show/fields"} fields
            and
            %a.existingWikiWord{:href => "/nlab/show/rings"} rings
            are replaced by
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-rings"} ∞-rings
            and
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            by
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-modules"} ∞-modules
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/parameterized+stable+homotopy+theory"} parameterized stable homotopy theory
          %p
            Recall that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/module"} module
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            over a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is classified by a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi X
                  %mo →
                  %mi k
                %annotation{:encoding => "application/x-tex"} \alpha : X \to k
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
            regarded as an object in the relevant
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %em discrete
            or
            %em flat
            vector bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} k Mod
            is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            of vector spaces. There is the subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mi Line
                  %mo ↪
                  %mi k
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} k Line \hookrightarrow k Mod
            of 1-
            %a.existingWikiWord{:href => "/nlab/show/dimension"}> dimension
            al
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi X
                  %mo →
                  %mi k
                  %mi Line
                  %mo ↪
                  %mi k
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} \alpha : X \to k Line \hookrightarrow k Mod
            are
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is the
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mo →
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \lim_\to \alpha
          %p
            These statements
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorify
            in a straightforward manner to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is generalized to a commutative
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-ring"} ∞-ring
            %em
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            \. Modules are replaced by
            %a.existingWikiWord{:href => "/nlab/show/module+spectrum"} module spectra
            and colimits by
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
          %p
            The resulting notion of
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orientation in generalized cohomology
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            and
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Thom+isomorphism"} Thom isomorphism
          %p
            Further generalization of the concept leads to
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-vector+bundle"} (∞,n)-vector bundle
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E-ring"} E-∞-ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is an object of the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} (\cdots (K Mod) Mod ) \cdots Mod
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,k)
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,k-1)
            = succeed "-modules," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,k-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times.
          %h2#discrete_vector_bundles
            Discrete
            = succeed "-vector" do
