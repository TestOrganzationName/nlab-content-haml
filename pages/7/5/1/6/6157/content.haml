              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and the morphism encoding an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is reads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo :
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mi Mod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha : \Pi(X) \to A Mod
                    \\,.
            %p
              This assignment of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              etc. may be regarded as the
              %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              of the (unique and flat, due to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discreteness
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} connection on an ∞-bundle
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
            %p
              Equivalently, this morphism may be regarded as an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-representation"} ∞-representation
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X = B G
              is the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              of a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-group"} discrete ∞-group
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the same as an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-representation"} ∞-representation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} A Mod
          %h3#lines_and_line_bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Lines and
            = succeed "-line" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Line
                    %mo ↪
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    A Line \hookrightarrow A Mod
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+sub-%28%E2%88%9E%2C1%29-category"} full sub-(∞,1)-category
              on the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                \-lines
              \: on those
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as an
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A Mod(X)
              on morphisms factoring through this inclusion we call the
              = succeed "-catgeory" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  \-line
                  = succeed "-bundles" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          %p
            This appears as (
            %a{:href => "#ABG"}> ABG def. 3.12
            ), (
            %a{:href => "#ABGHR08"}> ABGHR 08, 7.5
            ).
          .num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be an
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty A
              the underlying
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \pi_0 \Omega^\infty A
              the ordinary
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              of connected components, writ
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 0
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi A
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} (\pi_0 \Omega^\infty A)^\times
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(A)
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi GL
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mn 0
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi A
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo ×
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi π
                              %mn 0
                            %msup
                              %mi Ω
                              %mn ∞
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    GL_1(A) &amp;\to&amp; \Omega^\infty A
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    (\pi_0 \Omega^\infty A)^\times &amp;\to&amp; \pi_0 \Omega^\infty A
                    }
                    \\,.
          .num_prop
            %h6#proposition Proposition
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Aut
                      %mrow
                        %mi A
                        %mi Line
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    GL_1(A) \simeq Aut_{A Line}(A)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+units"} ∞-group of units
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with the
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              Since every
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as an
              = succeed "-module," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Line
                    %mo ≃
                    %mi B
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi B
                    %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A Line \simeq B GL_1(A) \simeq B Aut(A)
            %p
              that identifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Line
                  %annotation{:encoding => "application/x-tex"} A Line
              as the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              of either of these two
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
          %p
            This appears in (
            %a{:href => "#ABG"}> ABG, 3.6
            ) (
            %a{:href => "http://arxiv.org/pdf/1002.3004v2.pdf#page=10"}> p. 10
            ). See also (
            %a{:href => "#ABGHR08"}> ABGHR 08, section 6
            ).
          .num_remark
            %h6#remark_2 Remark
            %p
              This means that every
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/associated+%E2%88%9E-bundle"} associated
              to a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_1(A)
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              which is
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} modulated
              by a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi B
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \to B GL_1(A)
          .num_defn
            %h6#definition_4 Definition
            %p
              A
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_1(A)
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is also called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
              – or better: a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/local+coefficient+%E2%88%9E-bundle"} local coefficient ∞-bundle
              – for
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} cohomology
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            For the moment see
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            for more on this.
          %h3#SectionsAndTwistedCohomology Sections and twisted cohomology
          .num_defn
            %h6#definition_5 Definition
            %p
              The
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of an
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} f : X \to A Mod
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              over this functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi f
                    %mo :
                    %mo =
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo →
                      %mi α
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X^f := \lim_\to (X \stackrel{\alpha}{\to} A Mod)
                    \\,.
            %p
              The corresponding
              %em spectrum of sections
              is the
              = succeed "-dual" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi Mod
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi f
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(f) := Mod_A(X^f, A)
                    \\,.
          %p
            This is (
            %a{:href => "#ABG"}> ABG, def. 4.1
            ) and (
            %a{:href => "#ABG"}> ABG, p. 15
            ), (
            %a{:href => "#ABGII"}> ABG11, remark 10.16
            ).
          .num_remark
            %h6#remark_3 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              an
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(f)
              is called in (
              %a{:href => "#ABGHR08"}> ABGHR 08, def. 7.27, remark 7.28
              ) the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom A-module
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and written
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mi f
                    %annotation{:encoding => "application/x-tex"} M f
          %p
            Because for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi S
                %annotation{:encoding => "application/x-tex"} A = S
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mi f
                %annotation{:encoding => "application/x-tex"} M f
            is indeed the classical
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            of the spherical fibration given by
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo =
                    %mi S
                  %annotation{:encoding => "application/x-tex"} K = S
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi K
                    %mi Line
                    %mo =
                    %mi S
                    %mi Line
                  %annotation{:encoding => "application/x-tex"} f : X \to K Line = S Line
              an
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              any other
              = succeed "-ring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} S \to A
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi S
                    %mi Mod
                    %mo →
                    %mi A
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\to} S Mod \to A Mod
              is the classical
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              tensored with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi S
                    %mi Line
                    %mo →
                    %mi A
                    %mi Line
                    %mo →
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi X
                      %mi f
                    %msub
                      %mo ∧
                      %mi S
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(X \stackrel{f}{\to} S Line \to A Line \to A Mod)
                    \\simeq
                    X^f \wedge_S A
                    \\,.
          %p
            This is (
            %a{:href => "#ABGHR08"}> ABGHR 08, theorem 4.5
            ).
          %h3#trivializations_and_orientations Trivializations and orientations
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi A
                    %mi Line
                  %annotation{:encoding => "application/x-tex"} f : X \to A Line
              an
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "-bundle," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              of
              %strong trivializations
              is the
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi A
                            %mi Line
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; *
                    \\\
                    \&amp; \nearrow &amp; \downarrow
                    \\\
                    X &amp;\stackrel{f}{\to}&amp; A Line
                    }
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} K \to A
              the canonical inclusion and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi K
                    %mi Line
                  %annotation{:encoding => "application/x-tex"} f : X \to K Line
              a
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                \-orientation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a trivialization of the associated
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi K
                      %mi Line
                      %mo →
                      %mi A
                      %mi Line
                    %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\to} K Line \to A Line
          %p
            That this encodes the notion of
            %a.existingWikiWord{:href => "/nlab/show/orientation+in+generalized+cohomology"} orientation in A-cohomology
            is around (
            %a{:href => "#ABGHR08"}> ABGHR 08, 7.32
            ).
          #ThomModuleInOrientedCase.num_cor
            %h6#corollary Corollary
            %p
              Every trivialization/orientation of an
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi A
                    %mi Line
                  %annotation{:encoding => "application/x-tex"} f : X \to A Line
              induces an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Σ
                      %mn ∞
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(f) \simeq (\Sigma^\infty X )\wedge A
            %p
              of the
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              \/ the
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom A-module
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              with the
              = succeed "-spectrum" do
                %a.existingWikiWord{:href => "/nlab/show/homology"} generalized A-homology
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet \Gamma(f) \simeq H_\bullet(X,A)
                    \\,.
          %p
            This appears as (
            %a{:href => "#ABGHR08"}> ABGHR 08, cor. 7.34
            ).
          %p
            Therefore if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            %em not
            trivializable, we may regard its
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted A-cohomology
          .num_defn
            %h6#definition_7 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi A
                    %mi Line
                  %annotation{:encoding => "application/x-tex"} f : X \to A Line
              an
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "-bundle," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %strong
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted A-homology
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mo •
                      %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_\bullet^f(X, A) := \pi_\bullet(\Gamma(f)) := \pi_\bullet(M f)
                    \\,.
            %p
              The
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                \-
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted A-cohomology
                is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi f
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi f
                    %mo ,
                    %msup
                      %mi Σ
                      %mo •
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet_f(X,A) := \pi_0 A Mod(M f, \Sigma^\bullet A)
                    \\,.
          %h2#Structured
            Structured
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            We discuss now
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-toposes"} (∞,1)-toposes
          %p (…)
          %h2#applications Applications
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/string+topology"} string topology
                operations on a compact
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                may be understood as arising from a
                %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
                with
                %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                whose
                %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
                is a flat
                = succeed "-line" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "-bundle" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo ,
                      %mo ∇
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (P,\nabla)
                which is
                = succeed "-oriented" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (for instance for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi H
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} A = H \mathbb{Q}
                the
