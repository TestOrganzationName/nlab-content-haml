                    %mi Mod
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A Mod(X) := Func(X, A Mod)
                    \\,.
          %p
            In this form this appears as (
            %a{:href => "#ABG"}> ABG def. 3.7
            ). Compare this to the analogous definition at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          .num_remark
            %h6#remark Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is regarded as a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              then the corresponding
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \Pi X
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
