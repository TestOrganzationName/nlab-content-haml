                    %mi C
                    %mo ¯
                  %mo ⊗
                  %mover
                    %mi C
                    %mo ¯
                  %mo .
                %annotation{:encoding => "application/x-tex"} \partial(C_n) \subseteq C_{n-1},  \quad \overline{C} = C/\eta(k), \quad \overline{\Delta} : \overline{C} \to \overline{C}\otimes \overline{C}.
          %p
            The
            %em Cobar construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ∂
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(C,\partial, \eta)
            is the cocommutative pre-dgha defined by
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ∂
                    %mo ,
                    %mi η
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msup
