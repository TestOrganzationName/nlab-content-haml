                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi μ
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi c
                          %msub
                            %mo ′
                            %mrow
                              %mi i
                              %mi μ
                          %mo{:stretchy => "false"} |
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
