                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} \eta(i) = (-1)^{\sum_{k=1}^i |s a_k|}
          %p
            %strong Note
          %ol
            %li
              %p
                %em> the image of a 1-connected cdga is a connected commutative Hopf algebra
                \.
            %li
              %p
                The construction uses the
                %em suspension
                operator on the graded vector spaces. This mirrors the reduced suspension at the cell complex level.
          %ul
            %li
              %p The construction uses a tensor algebra construction. This from one point of view handles the formal concatenation aspect, but has also a rich structure of a coalgebraic structure with reduced diagonal, given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Δ
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ⊗
                      %mi …
                      %mo ⊗
                      %msub
                        %mi v
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi p
                          %mo =
                          %mn 1
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mn 1
                      %mo ⊗
                      %mi …
                      %mo ⊗
                      %msub
                        %mi v
                        %mi p
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mo ⊗
                      %mi …
                      %mo ⊗
                      %msub
                        %mi v
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} \bar{\Delta}(v_1\otimes \ldots \otimes v_n) = \sum_{p=1}^{n-1} (v_1\otimes \ldots \otimes v_p)\otimes(v_{p+1}\otimes \ldots \otimes v_n),
              %p
                (see
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/differential+graded+coalgebra"} differential graded coalgebra
              %p This can be interpreted as looking at how a formal concatenation can be ‘subdivided’ into its various parts.
          %h3#the_cobar_construction The Cobar construction
          %p
            (due to J. F. Adams, see
            = succeed ")" do
              %a{:href => "#FelixHalperinThomas92"} Felix-Halperin0Thomas 92
          %p We define a functor:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi pre
                  %mi η
                  %mi CoDGC
                  %mo →
                  %mi pre
                  %mi CoDGHA
                %annotation{:encoding => "application/x-tex"} F :pre \eta  CoDGC \to pre CoDGHA
          %p
            so essentially from cocommutative
            %a.existingWikiWord{:href => "/nlab/show/differential+graded+coalgebra"} differential graded coalgebras
            to cocommutative
            %a.existingWikiWord{:href => "/nlab/show/differential+graded+Hopf+algebra"} differential graded Hopf algebras
            (with frills attached in the way of coaugmentations, etc).
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ∂
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,\partial,\eta)
            be a cocommutative differential
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∂
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %msub
                    %mi C
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ,
                  %mspace{:width => "1em"}
                  %mover
                    %mi C
                    %mo ¯
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi η
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "1em"}
