                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(s\overline{A})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi d
                  %mo ,
                  %mi ε
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(A,d,\varepsilon)
            thus becomes merely a differential
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is not (graded) cocommutative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ∂
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(C,\partial,\eta)
            is merely a differential
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          %p In particular, let
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ε
                      %mo −
                      %mi DGA
                    %annotation{:encoding => "application/x-tex"} \varepsilon-DGA
                be the category of augmented differential graded algebras, (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %msub
                        %mo ⊕
                        %mrow
                          %mi p
                          %mo ≥
                          %mn 0
                      %msub
                        %mi A
                        %mi p
                    %annotation{:encoding => "application/x-tex"} A = \oplus_{p\geq 0}A_p
                ).
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi DGC
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} DGC_0
                , the category of connected differential graded coalgebras,
          %p then the Bar and Cobar constructions yield functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %mi ε
                  %mi DGA
                  %mo →
                  %msub
                    %mi DGC
                    %mn 0
                %annotation{:encoding => "application/x-tex"} B: \varepsilon DGA\to DGC_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msub
                    %mi DGC
                    %mn 0
                  %mo →
                  %mi ε
                  %mi DGA
                  %mo .
                %annotation{:encoding => "application/x-tex"} F : DGC_0\to  \varepsilon DGA.
          .num_theorem
            %h6#proposition Proposition
            %p
              (Husemoller-Moore-
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"}> Stasheff
              )
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is right adjoint to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %p
              For any objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,d)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ε
                      %mo −
                      %mi DGA
                    %annotation{:encoding => "application/x-tex"} \varepsilon-DGA
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,\partial)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi DGC
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} DGC_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi α
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mi FB
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{\alpha} : FB(A,d) \to (A,d)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi β
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi BF
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mo ∂
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{\beta} : (C,\partial) \to BF(C,\partial)
            %p
              are weak equivalences /
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphisms
          %p These latter morphisms are defined by
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi α
                        %mo{:stretchy => "false"} ^
                      %mo :
                      %mi T
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mover
                        %mrow
                          %mi T
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mover
                            %mi A
                            %mo ¯
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi δ
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat{\alpha} : T(s^{-1}\overline{T(s\overline{A})}), \delta)\to (A,d)
                is the zero mapping on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msup
                        %mi T
                        %mrow
                          %mo ≥
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mover
                        %mi A
                        %mo ¯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} s^{-1}T^{\geq 2}(s\overline{A})
                and the natural isomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mi s
                      %mover
                        %mi A
                        %mo ¯
                      %mover
                        %mo →
                        %mo ≃
                      %mover
                        %mi A
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} s^{-1}s\overline{A} \stackrel{\simeq}{\to} \overline{A}
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi s
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mi s
                        %mover
                          %mi A
                          %mo ¯
                      %annotation{:encoding => "application/x-tex"} s^{-1}s\overline{A}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi β
                        %mo{:stretchy => "false"} ^
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mo ∂
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mover
                        %mrow
                          %mi sT
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi s
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mover
                            %mi C
                            %mo ¯
                        %mo ¯
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi D
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat{\beta} : (C,\partial) \to (T(\overline{sT(s^{-1}\overline{C}}),D)
                is the unique lifting of
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mover
                        %mi C
                        %mo ¯
                      %mo →
                      %mover
                        %mrow
                          %mi T
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi s
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mover
                            %mi C
                            %mo ¯
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mo →
                      %mover
                        %mrow
                          %mi sT
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi s
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mover
                            %mi C
                            %mo ¯
                          %mo{:stretchy => "false"} )
                        %mo ¯
                      %mo .
                    %annotation{:encoding => "application/x-tex"} C\to s^{-1}\overline{C} \to \overline{T(s^{-1}\overline{C})}\to \overline{sT(s^{-1}\overline{C})}.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Koszul+duality"} Koszul duality
          %h2#references References
          %p The source used for the above was
          %ul
            %li
              D. Tanré,
              = succeed "," do
                %em Homotopie rationnelle: Modèles de Chen, Quillen, Sullivan
          %p This was augmented with material from
          %ul
            %li
              H. J. Baues,
              = succeed "," do
                %em Geometry of loop spaces and the cobar construction
          %p See also:
          %ul
            %li#FelixHalperinThomas92
              %a.existingWikiWord{:href => "/nlab/show/Yves+Felix"}> Yves Felix
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Halperin"} Stephen Halperin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jean-Claude+Thomas"} Jean-Claude Thomas
              = succeed "," do
                %em Adams’ Cobar Equivalence
              = succeed ")" do
                %a{:href => "https://www.jstor.org/stable/2153950"} jstor:2153950
          %p Review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dev+Sinha"}> Dev Sinha
                , Section 1 in:
                = succeed "," do
                  %em Koszul duality in algebraic topology - an historical perspective
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1001.2032"} arXiv:1001.2032
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mathieu+Anel"}> Mathieu Anel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} André Joyal
                = succeed "," do
                  %em On the bar-cobar duality for algebras and operads
                %a{:href => "http://mathieu.anel.free.fr/mat/doc/Anel-Joyal-Boston-Operades.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mathieu+Anel"}> Mathieu Anel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} André Joyal
                = succeed "," do
                  %em Sweedler theory for (co)algebras and the bar-cobar constructions
                %a{:href => "https://arxiv.org/abs/1309.6952"} arXiv:1309.6952
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kathryn+Hess"}> Kathryn Hess
                ,
                = succeed "," do
                  %em The cobar construction: a modern perspective
                %a{:href => "https://sma.epfl.ch/~hessbell/Minicourse_Louvain_Notes.pdf"} pdf
          %p
            Identifying the cobar construction on
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular chains
            on a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            with the dg-algebra of chains on its
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Frank+Adams"}> John Frank Adams
                \:
                = succeed "," do
                  %em On the cobar construction
                %strong 42
                7 (1956) 409–412 &amp;lbrack;
                %a{:href => "https://doi.org/10.1073%2Fpnas.42.7.409"}> doi:10.1073/pnas.42.7.409
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Manuel+Rivera"}> Manuel Rivera
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mahmoud+Zeinalian"} Mahmoud Zeinalian
                = succeed "," do
                  %em Cubical rigidification, the cobar construction, and the based loop space
                %strong 18
                (2018) 3789-3820 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1612.04801"}> arXiv:1612.04801
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2018.18.3789"} doi:10.2140/agt.2018.18.3789
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Manuel+Rivera"}> Manuel Rivera
                \:
                = succeed "," do
                  %em Adams’ cobar construction revisited
                %strong 27
                (2022) 1213-1223 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1910.08455"}> arxiv:1910.08455
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://ems.press/content/serial-article-files/26673"} pdf
          %p
            Generalization of the bar-cobar constructions to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dg-Hopf+algebras"} dg-Hopf algebras
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Benoit+Fresse"}> Benoit Fresse
                ,
                %em The universal Hopf operads of the bar construction
                (
                %a{:href => "https://arxiv.org/abs/math/0701245"}> arXiv:math/0701245
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Murray+Gerstenhaber"}> Murray Gerstenhaber
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Voronov"} Alexander Voronov
                = succeed "," do
                  %em Homotopy G-algebras and moduli space operad
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9409063"} arXiv:hep-th/9409063
            %li
              %p
                Justin Young,
                %em Brace bar-cobar duality
                (
                %a{:href => "https://arxiv.org/abs/1309.2820"}> arXiv:1309.2820
                )
