                              %mo ′
                      %annotation{:encoding => "application/x-tex"} \overline{\Delta}c_i = \sum_\mu c'_{i\mu}\otimes  c^{\prime\prime}_{i\mu}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
