                    %annotation{:encoding => "application/x-tex"} \eta(i) = (-1)^{ \sum^i_{k=1}|s^{-1}c_k|}.
          %p The image of a 1-connected cdgc is a connected cocommutative dgha.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is of finite type,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo #
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ∂
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \#F(C,\partial,\eta)
            is isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo #
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ∂
                  %mo ,
                  %mi η
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B\#(C,\partial,\eta)
            as a differential
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is not (graded) commutative, the differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi E
                %annotation{:encoding => "application/x-tex"} d_E
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi d
                  %mo ,
                  %mi ε
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(A,d,\varepsilon)
            does not respect the shuffle product on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
