                        %mi c
                        %mi i
                      %mo ⊗
                      %mi …
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi c
                        %mi n
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} \partial_I (s^{-1}c_1\otimes \ldots\otimes s^{-1}c_n) = -\sum_{i = 1} ^n\eta(i-1)s^{-1}c_1\otimes \ldots\otimes s^{-1}c_{i-1}\otimes s^{-1}\partial c_i\otimes \ldots s^{-1}c_n,
          %p and
          %ul
            %li
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi E
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi s
