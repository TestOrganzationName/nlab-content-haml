                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/differential+graded+coalgebra"} differential graded coalgebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi C
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{C}
                is the cokernel of the coaugmentation,
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
            %li
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi I
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi c
                        %mn 1
                      %mo ⊗
                      %mi …
                      %mo ⊗
                      %msup
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
