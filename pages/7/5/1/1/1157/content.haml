                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} \partial_E (s^{-1}c_1\otimes \ldots\otimes s^{-1}c_n) = -\sum_{i = 1} ^n\eta(i-1)\sum_\mu (-1)^{|c'_{i\mu}| +1} (s^{-1}c_1\otimes \ldots\otimes s^{-1}c'_{i\mu}\otimes  s^{-1}c^{\prime\prime}_{i\mu}\otimes \ldots\otimes s^{-1}c_n),
              %p
                with
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
