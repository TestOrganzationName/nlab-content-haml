                %mrow
                  %mi A
                  %mo ,
                  %mi B
                %annotation{:encoding => "application/x-tex"} A, B
            are affine spaces, then the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(A, B)
            is closed under all affine space operations pointwise defined on the set of all functions from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aff
                %annotation{:encoding => "application/x-tex"} Aff
            a
            %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
            structure; on general grounds, it is in fact a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+closed+category"} symmetric monoidal closed category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
