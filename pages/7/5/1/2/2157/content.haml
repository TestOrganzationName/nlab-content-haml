                        %mo +
                        %mi …
                        %mo +
                        %msub
                          %mi r
                          %mi n
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} r_0 + \dots + r_n = 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mrow
                          %msub
                            %mi r
                            %mn 0
                          %mo ,
                          %mi …
                          %mo ,
                          %msub
                            %mi r
                            %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi A
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \gamma_{r_0,\ldots,r_n}\colon A^{n+1}\to A
                (thought of as
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi γ
                          %mrow
                            %msub
                              %mi r
                              %mn 0
                            %mo ,
                            %mi …
                            %mo ,
                            %msub
                              %mi r
                              %mi n
