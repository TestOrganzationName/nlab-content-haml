                      %mn 1
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mn 1
                  %mo ⊗
                  %mn 1
                  %mo ≅
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mn 1
                %annotation{:encoding => "application/x-tex"} (\bigsqcup_{n+1} 1) \otimes (\bigsqcup_{m+1} 1) \cong \bigsqcup_{(m+1)(n+1)} 1 \otimes 1 \cong \bigsqcup_{(m+1)(n+1)} 1
          %p
            with dimension
            = succeed "." do
