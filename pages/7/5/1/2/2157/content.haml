                    %msub
                      %mi Th
                      %mi Vect
                  %annotation{:encoding => "application/x-tex"} Th_{Vect}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Th
                    %mi Aff
