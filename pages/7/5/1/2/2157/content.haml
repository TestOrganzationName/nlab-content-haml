                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨆
                    %mrow
                      %mi m
