                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_1, \ldots, a_{n+1}
            is an affine basis of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi b
                    %mrow
                      %mi m
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} b_1, \ldots, b_{m+1}
            a basis of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \otimes B
            has an affine basis consisting of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mi n
                  %mo +
                  %mi m
                  %mo +
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} m n + m + n + 1
            many elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi i
                    %mo ⊗
                    %msub
                      %mi b
                      %mi j
                  %annotation{:encoding => "application/x-tex"} a_i \otimes b_j
          %p
            The embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aff
                  %mo →
                  %mi Vect
                  %mo{:stretchy => "false"} /
                  %mi k
                %annotation{:encoding => "application/x-tex"} Aff \to Vect/k
            described in the previous subsection, sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊔
                    %mo !
                    %mo :
                    %mn 1
                    %mo ⊔
                    %mi A
                    %mo →
                    %mn 1
                    %mo ⊔
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 \sqcup !: 1 \sqcup A \to 1 \sqcup 1
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            (preserves the tensor product up to coherent isomorphism) if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vect
                  %mo{:stretchy => "false"} /
                  %mi k
                %annotation{:encoding => "application/x-tex"} Vect/k
            is endowed with the obvious tensor product acquired from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} Vect
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vect
                  %mo{:stretchy => "false"} /
                  %mi k
                %annotation{:encoding => "application/x-tex"} Vect/k
            is the coreflection of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} Vect
            from monoidal categories to
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/semicartesian+monoidal+categories"} semicartesian monoidal categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aff
                  %mo →
                  %mi Vect
                  %mo{:stretchy => "false"} /
                  %mi k
                %annotation{:encoding => "application/x-tex"} Aff \to Vect/k
            was in fact discovered by one of us in conjunction with this fact, and is the same as the functor induced by universality from the strong monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Aff
                  %mo →
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} Aff \to Vect
            given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %mn 1
                    %mo ⊔
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \mapsto 1 \sqcup A
          %h2#further_remarks Further Remarks
          %p
            Every finitely-generated affine space is isomorphic to the
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is the
            %a.existingWikiWord{:href => "/nlab/show/base+field"} base field
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is a
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            (possibly
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝔸
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{A}^n
            and identified with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi n
                  %annotation{:encoding => "application/x-tex"} k^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} -1
            by convention (so
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} k^{-1} = \empty
          %p
            The notion of affine space may be generalised to
            %strong affine module
            by replacing the vector space above by a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            and the base field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/heap"} heap
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is invertible in
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo ≠
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 2 \ne 0
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %h2#affine_spaces_as_model_spaces Affine spaces as model spaces
          %p Affine spaces typically serve as local models for more general kinds of spaces.
          %p
            For instance a
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            that is locally isomorphic to an affine space over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %p
            Similarly, in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            a
            %a.existingWikiWord{:href => "/nlab/show/scheme"} scheme
            is locally isomorphic to an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/affine+scheme"} affine scheme
          %p
            Therefore there are attempts to axiomatize properties of categories of affine spaces for the purpose of using these as model spaces for more complicated geometries. One such axiomatization is the notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28%E2%88%9E%2C1%29-toposes%29"} geometry (for structured (∞,1)-toposes)
            = succeed "." do
              %a{:href => "/nlab/show/geometry+(for+structured+(infinity%2C1%29-toposes%29#Pregeometry"} pregeometry
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
                of an affine space is an
                %em
                  %a.existingWikiWord{:href => "/nlab/show/affine+group"} affine group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/polydisk"} polydisk
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/projective+space"}> projective space
                ,
                %a.existingWikiWord{:href => "/nlab/show/conical+space"} conical space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relative+affine+n-space"} relative affine n-space
          %h2#references References
          %p Textbook accounts:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Igor+R.+Shafarevich"}> Igor R. Shafarevich
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Alexey+O.+Remizov"} Alexey O. Remizov
              %em Linear Algebra and Geometry
              (2012) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/978-3-642-30994-6"}> doi:10.1007/978-3-642-30994-6
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://maa.org/press/maa-reviews/linear-algebra-and-geometry"} MAA-review
          %p See also:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
                ,
                %em Categories of Affine Spaces
                , JPAA
                %strong 61
                (1989) pp.243-250.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/George+Janelidze"} George Janelidze
                %em Modularity and Descent
                , JPAA
                %strong 99
                (1995) pp.255-265.
            %li
              %p
                Michel Thiébaud,
                %em Modular Categories
                , pp.386-400 in
                %em Proc. Como conference - Category Theory
                , LNM
                %strong 1488
                Springer Heidelberg 1991.
