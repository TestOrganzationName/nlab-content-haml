              depending smoothly on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
          %h3#integrating_the_string_lie_2algebra_to_the_string_lie_2group Integrating the string Lie 2-algebra to the string Lie 2-group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔰𝔱𝔯𝔦𝔫𝔤
                  %mo =
                  %msub
                    %mi 𝔤
                    %mi μ
                %annotation{:encoding => "application/x-tex"} \mathfrak{string} = \mathfrak{g}_\mu
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mn 3
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔤
                    %mi μ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_3 \exp(\mathfrak{g}_\mu)
            is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                %annotation{:encoding => "application/x-tex"} \mathbf{B}String
          %ul
            %li
              %p with a single object;
            %li
              %p
                whose morphisms are based paths in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                whose 2-morphisms are equivalence class of pairs
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Sigma,c)
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                          %mo :
                          %msubsup
                            %mi D
                            %mo *
                            %mn 2
                          %mo →
                          %mi G
                        %annotation{:encoding => "application/x-tex"} \Sigma : D^2_*  \to G
                    is a smooth based map (where we use a
                    %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi D
                            %mn 2
                          %mo ≃
                          %msup
                            %mi Δ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} D^2 \simeq \Delta^2
                    which away from the corners is smooth, so that forms with sitting instants there do not see any non-smoothness, and the basepoint of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi D
                            %mo *
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} D^2_*
                    is the 0-vertex of
                    = succeed ")" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Δ
                              %mn 2
                          %annotation{:encoding => "application/x-tex"} \Delta^2
                %li
                  %p
                    and
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                            %mo ∈
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} c \in U(1)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo :
                          %msup
                            %mi D
                            %mn 3
                          %mo →
                          %mi G
                        %annotation{:encoding => "application/x-tex"} \phi : D^3 \to G
                    filling them the labels
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi c
                            %mn 1
                          %mo ,
                          %msub
                            %mi c
                            %mn 2
                          %mo ∈
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} c_1, c_2 \in U(1)
                    differ by the integral
                    = succeed ",," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi D
                                  %mn 3
                            %msup
                              %mi ϕ
                              %mo *
                            %mi μ
                            %mo{:stretchy => "false"} (
                            %mi θ
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi mod
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi ℤ
                          %annotation{:encoding => "application/x-tex"} \int_{D^3} \phi^* \mu(\theta) \;\; mod \;\; \mathbb{Z}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mi θ
                  %mo ∧
                  %mo{:stretchy => "false"} [
                  %mi θ
                  %mo ∧
                  %mi θ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \mu(\theta) = \langle \theta\wedge [\theta \wedge \theta]\rangle
            the 3-form obtained by plugging it into the cocycle.
          %p
            This is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-group"} string Lie 2-group
            = succeed ")" do
              %a{:href => "#Henriques"} Henriques
          %h3#integrating_lie_algebroids_to_stacky_lie_groupoids Integrating Lie algebroids to (stacky) Lie groupoids
          %p
            Unlike finite dimensional Lie algebras, not every Lie algebroid may be integrated to a Lie groupoid. There exists topological obstruction coming from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_2(L)
            of the leaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo ⊂
                  %mi M
                %annotation{:encoding => "application/x-tex"} L\subset M
            of a Lie algebroid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} A\to M
            = succeed "." do
              %a{:href => "#Crainic"} Crainic-Fernandes 01
            %span.newWikiWord
              Lie algebroid homotopy groups
              %a{:href => "/nlab/new/Lie+algebroid+homotopy+groups"} ?
            induced by the natural
            %span.newWikiWord
              Lie algebroid fibration
              %a{:href => "/nlab/new/Lie+algebroid+fibration"} ?
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi L
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} A|_L \to L
            %a{:href => "#BZ"} Brahic-Zhu 10
            ).
          %p
            Let us now describe the construction of the universal groupoid for a Lie algebroid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a{:href => "#Crainic"} Crainic-Fernandes 01
            and was earlier discovered in the setting of Poisson manifolds as the phase space of
            %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma+model"} Poisson sigma model
            in
            = succeed "." do
              %a{:href => "#CattaneoFelder01"} Cattaneo-Felder 00
          %p
            Given a Lie algebroid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} A\to M
            = succeed "-path" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %msup
                      %mi Δ
                      %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} T\Delta^1 \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo =
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a=\rho(\gamma)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo =
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \gamma=\pi(a)
            is the base path of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            (see
            %a{:href => "https://ncatlab.org/nlab/show/Lie+groupoid#example"} example
            ).
          %p
            An (end-fixing)
            = succeed "-homotopy" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo □
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} T\square \to A
            satisfying certain boundary conditions. Let us be more precise: a vector bundle morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo □
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} T\square \to A
            can be denoted by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi dt
                  %mo +
                  %mi b
                  %mi ds
                %annotation{:encoding => "application/x-tex"} a dt + b ds
            (see
            %a{:href => "https://ncatlab.org/nlab/show/Lie+groupoid#example_2"} example
            ). Then the boundary condition is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} b(s,0)=0
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} b(s,1)=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi adt
                  %mo +
                  %mi bds
                %annotation{:encoding => "application/x-tex"} adt+bds
            is a Lie algebroid morphism is equivalent to the following PDE:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi t
                  %mi b
                  %mo −
                  %msub
                    %mo ∂
                    %mi s
                  %mi a
                  %mo =
                  %msub
                    %mo ∇
                    %mrow
                      %mi ρ
                      %mi α
                  %mi β
                  %mo −
                  %msub
                    %mo ∇
                    %mrow
                      %mi ρ
                      %mi β
                  %mi α
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi α
                  %mo ,
                  %mi β
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \partial_t b- \partial_s a= \nabla_{\rho \alpha} \beta - \nabla_{\rho \beta} \alpha +[\alpha, \beta]
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            is a TM connection on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            are certain time dependent sections of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            extending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            respectively. Notice that there is also a way writing down the right hand side independent of choice of sections. See Section 1 of
            = succeed "." do
              %a{:href => "#Crainic"} Crainic-Fernandes 01
          %p
            Then the universal groupoid associated to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is the space of
            = succeed "-paths" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mi a
                    %mi A
                  %annotation{:encoding => "application/x-tex"} P_a A
            = succeed "-homotopies." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Fortunately
            = succeed "-homotopies" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mon
                    %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi P
                    %mi aA
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mon_F(P_aA)
            represents a differentiable stack which becomes a stacky Lie groupoid over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/Lie%27s+third+theorem"} Lie's third theorem
            for Lie algebroids.
            = succeed "." do
              %a{:href => "#TZ"} Tseng-Zhu 04
