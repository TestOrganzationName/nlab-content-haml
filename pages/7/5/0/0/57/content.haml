                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              the projection on the space of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/harmonic+forms"} harmonic forms
              %a{:href => "http://ncatlab.org/nlab/show/Hodge+theory#ResultsOverRiemannianManifold"} central result of Hodge theory
              for
