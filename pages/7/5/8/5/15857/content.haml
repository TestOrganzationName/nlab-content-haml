                %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} spectrum of a symmetric monoidal (∞,1)-category
          %h2#references References
          %ul
            %li#Balmer02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paul+Balmer"}> Paul Balmer
                ,
                = succeed "," do
                  %em Presheaves of triangulated categories and reconstruction of schemes
                = succeed ":3" do
                  %strong 324
                = succeed "," do
                  %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/Reconstr.dvi"} dvi
                %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/Reconstr.pdf"} pdf
                = succeed ";" do
                  %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/Reconstr.ps"} ps
                = succeed "," do
                  %em The spectrum of prime ideals in tensor triangulated categories
                = succeed ":149\u2013168," do
                  %strong 588
                %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/Spectrum.dvi"} dvi
                %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/Spectrum.pdf"} pdf
                = succeed ";" do
                  %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/Spectrum.ps"} ps
                = succeed "," do
                  %em Spectra, spectra, spectra - Tensor triangular spectra versus Zariski spectra of endomorphism rings
                = succeed ":3" do
                  %strong 10
                %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/SSS.dvi"} dvi
                %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/SSS.pdf"} pdf
                %a{:href => "http://www.math.ucla.edu/~balmer/Pubfile/SSS.ps"} ps
            %li#Lurie
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality+for+geometric+stacks"} Tannaka duality for geometric stacks
            %li#CJF11
