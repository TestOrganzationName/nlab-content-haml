                  exists
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mo *
                        %mo ⊣
                        %msub
                          %mi f
                          %mo *
                        %mo ⊣
                        %msup
                          %mi f
