              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Disc
                  %mo ⊣
                  %mi Γ
                  %mo ⊣
                  %mi Codisc
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi E
                  %mover
                    %mover
                      %munder
                        %mo ⟵
                        %mi Codisc
                      %munder
                        %mo ⟶
                        %mi Γ
                    %mover
                      %mo ⟵
                      %mi Disc
                  %mi S
                %annotation{:encoding => "application/x-tex"}
                  (Disc \dashv \Gamma \dashv Codisc) :
                  E
                  \\stackrel{\overset{Disc}{\longleftarrow}}{\stackrel{\underset{\Gamma}{\longrightarrow}}{\underset{Codisc}{\longleftarrow}}}
                  S
          %p
            to indicate that if we think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            as sending a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            to its underlying
            = succeed "-object" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Disc
                %annotation{:encoding => "application/x-tex"} Disc
            creates the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
            %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete object
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Codisc
                %annotation{:encoding => "application/x-tex"} Codisc
            the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+space"} codiscrete space
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+object"} codiscrete object
