          %h2#idea Idea
          %p
            %strong Objective number theory
            is the study of
            %a.existingWikiWord{:href => "/nlab/show/addition"} addition
            and
            %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
            (and eventually
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/exponentiation"} exponentiation
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
