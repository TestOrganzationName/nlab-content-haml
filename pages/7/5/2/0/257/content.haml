                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo ⟶
                              %mphantom
                                %mi AAAA
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id \colon
                    \&amp;
                    A
                    \&amp;\longrightarrow&amp;
                    X
                    \&amp;\overset{\phantom{AAAA}}{\longrightarrow}&amp; A
                    \\\
                    \&amp;
                    {}^{\mathllap{\in W \cap Cof}}\downarrow
                    \&amp;(po)&amp;
                    \\downarrow^{\mathrlap{\in W \cap Cof}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\in W \cap Cof}}
                    \\\
                    id \colon
                    \&amp; A' &amp;\overset{}{\longrightarrow}&amp;
                    X'
                    \&amp;\overset{\phantom{AA}\phantom{AA}}{\longrightarrow}&amp; A'
                    \\\
                    \&amp;
                    {}^{\mathllap{\in Fib}}
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\in W }}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\in Fib}}
                    \\\
                    id \colon &amp; B &amp;\longrightarrow&amp; Y &amp;\underset{\phantom{AAAA}}{\longrightarrow}&amp; B
                    }
                    \\,,
            %p
              where the other three squares are induced by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the pushout, as is the identification of the middle horizontal composite as the identity on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} A'
              = succeed "," do
                %a{:href => "weak+factorization+system#ClosuredPropertiesOfWeakFactorizationSystem"} this prop.
              %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
              so is the middle bottom vertical morphism.
            %p Thus the previous case now gives that the bottom left vertical morphism is a weak equivalence, and hence the total left vertical composite is.
          %h3#RedundancyInTheAxioms Redundancy in the defining factorization systems
          %p It is clear that:
          #AnyTwooClassesDetermineTheThird.num_remark
            %h6#remark_2 Remark
            %p Given a model category structure, any two of the three classes of special morphisms (cofibrations, fibrations, weak equivalences) determine the third:
            %ul
              %li
                %p
                  given
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo =
                          %mi RLP
                          %mo{:stretchy => "false"} (
                          %mi W
                          %mo ∩
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F = RLP(W \cap C)
              %li
                %p
                  given
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo =
                          %mi LLP
                          %mo{:stretchy => "false"} (
                          %mi W
                          %mo ∩
                          %mi F
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} C = LLP(W \cap F)
              %li
                %p
                  given
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                  as the class of morphisms which factor into a morphism in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi LLP
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} LLP(F)
                  followed by a morphism in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi RLP
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} RLP(C)
            %p
              (Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi RLP
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} RLP(S)
              denotes the class of morphisms with the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LLP
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} LLP(S)
              denotes the class of morphisms with the
              %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
              against
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %p But, in fact, already the cofibrations and the fibrant objects determine the model structure.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              A model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi W
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C,W,F)
              on a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is determined by its class of cofibrations and its class of fibrant objects.
          %p
            This statement appears for instance as (
            %a{:href => "#Joyal"}> Joyal, prop. E.1.10
            )
          .proof
            %h6#proof_2 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ,
                    %mi F
                    %mo ,
                    %mi W
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C,F,W \subset Mor(\mathcal{E})
              be a model category.
            %p
              By remark
              %a.maruku-ref{:href => "#AnyTwooClassesDetermineTheThird"}
              it is sufficient to show that the cofibrations and the fibrant objects determine the class of weak equivalences. Moreover, these are already determined by the weak equivalences between cofibrant objects, because for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} u : A \to B
              any morphism,
              %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial
              cofibrant replacement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↪
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mo ≃
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \emptyset \hookrightarrow \hat A \stackrel{\simeq}{\to} A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↪
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mo →
                      %mo ≃
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \emptyset \hookrightarrow \hat B \stackrel{\simeq}{\to} B
              with 2-out-of-3 implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              is a weak equivalence precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u : \hat A \to \hat B
              is.
            %p
              By the nature of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                  %annotation{:encoding => "application/x-tex"} Ho
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              and by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u : \hat A \to \hat B
              between cofibrant objects is a weak equivalence precisely if for every fibrant object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi B
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho(\hat u, X) : Ho(\hat B, X) \to Ho(\hat A, X)
            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              of sets. The
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              that defines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(\hat A,X)
              may be taken to be given by
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              induced by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cylinder+objects"} cylinder objects
              %a.existingWikiWord{:href => "/nlab/show/codiagonals"} codiagonals
              into cofibrations followed by acyclic fibrations. So all this is determined already by the class of cofibrations, and hence weak equivalences are determined by the cofibrations and the fibrant objects.
          %h3#BasicClosurePropertiesOfClassOfModelCategories Basic closure properties of class of model categories
          %p
          #ProductModelStructure.num_prop
            %h6 Proposition
            %p
              %strong (product model structure)
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              a
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              of their
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              carries the
              %em product model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ×
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \times \mathcal{D}
              whose
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              are the
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of the corresponding such morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
            %p
              More generally, for an
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi 𝒞
                      %mi s
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                  %annotation{:encoding => "application/x-tex"} \big(\mathcal{C}_s\big)_{s \in S}
              of model categories, there is the analogous product model structure on their
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \underset{s \in S}{\prod} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              and morphisms are
              %a.existingWikiWord{:href => "/nlab/show/dependent+coproduct"} dependent
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of objects and morphisms in the
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_i
          (e.g.
          = succeed ")" do
            %a{:href => "#Hovey99"} Hovey (1999), Exp. 1.1.6
          %p
          #OppositeModelStructure.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/opposite+model+structure"}> opposite model structure
                )
              %br/
              If a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              carries a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
              carries the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/opposite+model+structure"} opposite model structure
            %p
              its weak equivalences are those morphisms whose dual was a weak equivalence in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and similarly for its cofibrations.
          (e.g.
          = succeed ")" do
            %a{:href => "#Hovey99"} Hovey (1999), Rem. 1.1.7
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
                along
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
              %br/
              Given an
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
              %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒟
                    %mover
                      %mo ⟶
                      %mo ∼
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} R \colon \mathcal{D} \overset{\sim}{\longrightarrow} \mathcal{C}
              between
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              and a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              carries the
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              whose
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              are the
              %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              of the corresponding morphisms in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊣
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L \dashv R
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          (cf.
          %a{:href => "transferred+model+structure#RightTransferAlongAdjointEquivalence"} this Example
          at
          = succeed ")" do
            %em
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
          %h3#homotopy_and_homotopy_category Homotopy and Homotopy category
          %p See at
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+in+a+model+category"} homotopy in a model category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
          %h2#examples Examples
          %h3#trivial_model_structure Trivial model structure
          %p
          #TrivialModelStructure.num_remark
            %h6 Example
            %p
              %strong (trivial model structure)
              %br/
              Every
              %a.existingWikiWord{:href => "/nlab/show/bicomplete+category"} bicomplete category
              carries its
              %em
                %a.existingWikiWord{:href => "/nlab/show/trivial+model+structure"} trivial model structure
              whose weak equivalences are the
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              and all morphisms are both cofibrations and fibrations.
          %p
          .num_remark
            %h6 Remark
            %p
              Trivial as this example
              %a.maruku-ref{:href => "#TrivialModelStructure"}
              may be, to the extent that model categories are presentations of certain
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-categories
              it shows that/how ordinary (
              %a.existingWikiWord{:href => "/nlab/show/bicomplete+category"}> bicomplete
              )
              %a.existingWikiWord{:href => "/nlab/show/1-categories"} 1-categories
              are subsumed as a special case.
          %h3#classical_model_structures Classical model structures
          %p The archetypical model structures are the
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
          %p and the
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"}> classical model structure on simplicial sets
              \.
          %p
            These model categories are
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            and encapsulate much of “classical”
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            (in terms of
            %a.existingWikiWord{:href => "/nlab/show/CW+complexes"} CW complexes
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
          %p
            The passage to
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            is given by
            %a.existingWikiWord{:href => "/nlab/show/model+structures+on+spectra"} model structures on spectra
            built out of either of these two classical model structures. See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Model+categories+of+diagram+spectra"} Model categories of diagram spectra
            for a unified treatment.
          %p
            Accordingly
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            with its
            %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
            and
            %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
            (which may be thought of as a sub-topic of
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            via the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structures+on+chain+complexes"} model structures on chain complexes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structures+on+dg-algebras"} model structures on dg-algebras
          %p
            In fact, the original definition of model categories in
            %a{:href => "#Quillen67"} Quillen67
            was motivated by the
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            between constructions in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
          %h3#categorical_model_structures Categorical model structures
          %p
            Of interest to category theorists is that many notions of
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher categories
            come equipped with model structures, witnessing the fact that when retaining only invertible
            %a.existingWikiWord{:href => "/nlab/show/transfors"} transfors
            between
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} category
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/canonical+model+structure"}> canonical model structure
              s, including “categorical” model structures for
              %ul
                %li categories
                %li
                  (strict or weak)
                  %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
                %li
                  %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-categories"}> strict ∞-categories
                  , and
                %li
                  %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoids"}> strict ∞-groupoids
                  \.
          %p
            Model categories have successfully been used to compare many different notions of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+categories"} simplicially enriched categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              (via the Joyal
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            %li
              %a.existingWikiWord{:href => "/nlab/show/Segal+categories"} Segal categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/complete+Segal+spaces"} complete Segal spaces
          %p There are related model structures for enriched higher categories:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+enriched+categories"} model structure on enriched categories
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-categories"} model structure on dg-categories
          %p Other “higher categorical structures” can also be expected to form model categories, such as the
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dendroidal+sets"} model structure on dendroidal sets
          %p
            which generalizes the Joyal model structure from
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operads"} (∞,1)-operads
          %p
            There is also another class of model structures on categorical structures, often called
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Thomason+model+structure"} Thomason model structure
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalences"} equivalences
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalent
            to the
            %a.existingWikiWord{:href => "/nlab/show/Quillen+model+structure+on+topological+spaces"} Quillen model structure on topological spaces
            and thus (via the
            %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
            and
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Quillen+model+structure+on+simplicial+sets"} Quillen model structure on simplicial sets
          %h3#parametrized_model_structures Parametrized model structures
          %p
            The
            %em parameterized
            version of the model structure on simplicial sets is a
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              or
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sheaves"} model structure on simplicial sheaves
              or
          %p
            which serves as a
            %a.existingWikiWord{:href => "/nlab/show/models+for+infinity-stack+%28infinity%2C1%29-toposes"} model for ∞-stack (∞,1)-toposes
            (for
            = succeed "es," do
              %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
          %h3#functor_and_localized_model_structures Functor and localized model structures
          %p Many model structures, including those for complete Segal spaces, simplicial presheaves, and diagram spectra, are constructed by starting with a model structure on a functor category, such as a
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"}> projective model structure
              ,
            %li
              %a.existingWikiWord{:href => "/nlab/show/injective+model+structure"}> injective model structure
              , or
            %li
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"}> Reedy model structure
              ,
          %p
            and applying a general technique called
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization"} Bousfield localization
            which forces a certain class of morphisms to become weak equivalences. It can also be thought of as forcing a certain class of objects to become fibrant.
          %h3#limit_and_colimit_model_structures Limit and colimit model structures
          %p
            Model structures can be induced on certain (usually
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/lax+limit"} lax
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction+for+model+categories"} Grothendieck construction for model categories
              (lax colimits)
            %li
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sections"} model structure on sections
              (lax limit)
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-category+of+model+categories"} 2-category of model categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} simplicial homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/synthetic+homotopy+theory"} synthetic homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/localization+of+model+categories"} localization of model categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/double+category+of+model+categories"} double category of model categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/premodel+category"} premodel category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+%28%E2%88%9E%2C1%29-category"} model (∞,1)-category
          %div
            %p
              %strong Algebraic model structures:
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+model+structures"} Quillen model structures
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
              %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+factorization+systems"} weak factorization systems
            %table
              %thead
                %tr
                  %th structure
                  %th small-set-generated
                  %th small-category-generated
                  %th algebraicized
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} weak factorization system
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/combinatorial+wfs"} combinatorial wfs
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/accessible+wfs"} accessible wfs
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/algebraic+wfs"} algebraic wfs
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/accessible+model+category"} accessible model category
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/algebraic+model+category"} algebraic model category
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/transfinite+construction+of+free+algebras"} construction method
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
                  %td{:style => "text-align: left;"}
                    same as
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo →
                        %annotation{:encoding => "application/x-tex"} \to
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/algebraic+small+object+argument"} algebraic small object argument
          %h2#References References
          %p The concept of a model category originates with
          %ul
            %li#Quillen67
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
              , Chapter I,
              %em Axiomatic homotopy theory
              in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopical+Algebra"} Homotopical Algebra
              %strong 43
              Springer (1967) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BFb0097438"}> doi:10.1007/BFb0097438
              \&amp;rbrack;
          %p and the modern form of the axioms (replacing requirement of finite (co-)limits by small (co-)limits ) is due to:
          %ul
            %li#DwyerHirschhornKan97
              %a.existingWikiWord{:href => "/nlab/show/William+G.+Dwyer"}> William G. Dwyer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Philip+S.+Hirschhorn"} Philip S. Hirschhorn
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+M.+Kan"} Daniel M. Kan
              %em
                %a.existingWikiWord{:href => "/nlab/show/Model+Categories+and+More+General+Abstract+Homotopy+Theory"} Model Categories and More General Abstract Homotopy Theory
              (1997) &amp;lbrack;
              %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/dhk.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/DwyerHirschhornKan-ModelCategories.pdf", :title => "pdf"} pdf
          %h4#monographs_and_textbooks Monographs and textbooks
          %ul
            %li#Hovey99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Model+Categories"} Model Categories
                %strong 63
                AMS (1999) &amp;lbrack;
                %a{:href => "https://bookstore.ams.org/surv-63-s"}> ISBN:978-0-8218-4361-1
                ,
                = succeed "," do
                  %a{:href => "https://doi.org/http://dx.doi.org/10.1090/surv/063"} doi:10.1090/surv/063
                = succeed "&rbrack;" do
                  %a{:href => "http://books.google.co.uk/books?id=Kfs4uuiTXN0C&printsec=frontcover"} Google books
            %li#Hovey99Err
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                ,
                %em Errata to Model Categories
                (1999) &amp;lbrack;
                %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/hovey-model-cats-errata.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Hovey-ModelCategories-Errata.pdf", :title => "pdf"} pdf
