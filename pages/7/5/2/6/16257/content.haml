            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
