            %p
              We can then construct the
              %a.existingWikiWord{:href => "/nlab/show/semi-direct+product"} semi-direct product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ⋊
                      %mi G
                    %annotation{:encoding => "application/x-tex"} M \rtimes G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mn 0
                    %mo ,
                    %msub
                      %mi g
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mn 0
                    %mi η
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi m
                      %mn 1
                    %mi η
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m_0, g_0) \cdot (m_1, g_1) = (m_0 \eta (g_0) m_1 \eta (g_0)^{-1}, g_0 g_1)
            %p
              There is a group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⋊
                    %mi G
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} M \rtimes G \to H
              defined by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi m
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (m, g) \mapsto m \eta (g)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∩
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                      %mi η
