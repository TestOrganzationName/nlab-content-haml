                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi e
                    %annotation{:encoding => "application/x-tex"} \epsilon (\eta (g)^{-1} h_1) = \epsilon (\eta (g)^{-1} h_2) = e
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
