                  %annotation{:encoding => "application/x-tex"} \mu (\eta (\epsilon (h_2)) h_1, h_2 \eta (\epsilon (h_1))) = \mu (\eta (\epsilon (h_2)), h_2) \mu (h_1, \eta (\epsilon (h_1))) = h_2 h_1
            %p
              but on the other hand, if
