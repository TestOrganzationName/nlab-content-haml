              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∘
                      %mi η
                      %mo =
                      %msub
                        %mi id
                        %mi G
                    %annotation{:encoding => "application/x-tex"} \epsilon \circ \eta = id_G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi h
                        %mn 0
                      %mo ,
                      %msub
                        %mi h
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ϵ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi h
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ϵ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi h
                        %mn 1
