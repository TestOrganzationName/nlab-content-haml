                    %annotation{:encoding => "application/x-tex"} M \cap \operatorname{im} \eta = \{ e \}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} M \rtimes G
              as a Beck module over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              by defining
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo :
                      %mi M
                      %mo ⋊
                      %mi G
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \epsilon : M \rtimes G \to G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo :
                      %mi G
                      %mo →
                      %mi M
                      %mo ⋊
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \eta : G \to M \rtimes G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ⋊
                    %mi G
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ⋊
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi M
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mu : (M \rtimes G) \times_G (M \rtimes G) \to M \rtimes G
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \epsilon (m, g) = g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta (g) = (0, g)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mn 0
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mn 1
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi m
                      %mn 1
                    %msub
                      %mi m
                      %mn 0
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu ((m_0, g), (m_1, g)) = (m_1 m_0, g)
            %p
              Thus, we have an equivalence between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Ab}(\mathcal{C}_{/ G})
              and the category of left
              = succeed "-modules," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a group and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be a left
              = succeed "-module." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with left
              = succeed "-modules," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              are precisely crossed homomorphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi M
                    %annotation{:encoding => "application/x-tex"} G \to M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %mi G
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \delta : G \to M
              satisfying the following equation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi g
                      %mn 0
                    %mo ⋅
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta (g_0 g_1) = \delta (g_0) + g_0 \cdot \delta (g_1)
          .proof
            %h6#proof_8 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi M
                    %mo ⋊
                    %mi G
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \epsilon : M \rtimes G \to G
              be the evident projection. A group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi G
                    %mo →
                    %mi M
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \phi : G \to M \rtimes G
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∘
                    %mi ϕ
                    %mo =
                    %msub
                      %mi id
                      %mi G
                  %annotation{:encoding => "application/x-tex"} \epsilon \circ \phi = id_G
              is the same thing as a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %mi G
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \delta : G \to M
              satisfying the equation below,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\delta (g_0), g_0) \cdot (\delta (g_1), g_1) = (\delta (g_0 g_1), g_0 g_1)
            %p which is equivalent to the defining equation for crossed homomorphisms.
          %h2#the_tangent_category The tangent category
          %p
            One may assemble the individual categories of Beck modules over the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            into a category fibred over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/tangent+category"} tangent category
          %h2#references References
          %p The concept is due to
          %ul
            %li#Beck67
              %a.existingWikiWord{:href => "/nlab/show/Jon+Beck"}> Jon Beck
              ,
              = succeed "," do
                %em Triples, algebras and cohomology
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/2/tr2abs.html"} TAC
          %p and was popularized in
          %ul
            %li#Quillen70
              %a.existingWikiWord{:href => "/nlab/show/Daniel+G.+Quillen"}> Daniel G. Quillen
              ,
              = succeed "," do
                %em On the (co-)homology of commutative rings
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              = succeed "," do
                %em Acyclic models
          %p
            An application to
            %a.existingWikiWord{:href => "/nlab/show/knot+theory"} knot theory
            is given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Markus+Szymik"}> Markus Szymik
              ,
              = succeed "," do
                %em Alexander-Beck modules detect the unknot
