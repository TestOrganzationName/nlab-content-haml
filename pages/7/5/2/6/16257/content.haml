                  %annotation{:encoding => "application/x-tex"} \mu (h_0 h_1, h_2 h_3) = \mu (h_0, h_2) \mu (h_1, h_3)
            %p and in particular,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
