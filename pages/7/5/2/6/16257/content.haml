                  %annotation{:encoding => "application/x-tex"} \mathbf{Ab}(\mathcal{C}_{/ A}) \to \mathcal{C}_{/ A}
              creates limits and
              = succeed "-filtered" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
