                        %mn 1
                    %msub
                      %mi h
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} (
