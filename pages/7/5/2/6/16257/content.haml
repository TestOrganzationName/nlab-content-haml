                      %mi M
                      %mo =
                      %mi ker
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} M = \ker \epsilon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              restricts to the pre-existing group structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mi ϵ
