                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu (b_1, b_2) = \mu (\eta (a) + b_1 - \eta (a), \eta (a) + b_2 - \eta (a)) = \mu (\eta (a), \eta (a)) + \mu (b_1 - \eta(a), b_2 - \eta (a)) = \eta (a) + \mu (b_1 - \eta(a), b_2 - \eta (a))
