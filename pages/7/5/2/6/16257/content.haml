                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \Omega_A
              has the same universal property as the
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
