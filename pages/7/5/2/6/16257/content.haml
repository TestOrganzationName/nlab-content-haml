                  %mo →
                  %msub
                    %mi 𝒞
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi A
                %annotation{:encoding => "application/x-tex"} U : \mathbf{Ab}(\mathcal{C}_{/ A}) \to \mathcal{C}_{/ A}
            has a left adjoint,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ω
                    %mi A
                %annotation{:encoding => "application/x-tex"} \Omega_A
            is simply the value of the left adjoint at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
