                      %mi h
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mu (\eta (g)^{-1} h_1, \eta (g)^{-1} h_2) = \mu (e, \eta (g)^{-1} h_2) \mu (\eta (g)^{-1} h_1, e) = \eta (g)^{-1} h_2 \eta (g)^{-1} h_1
            %p so we conclude that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
