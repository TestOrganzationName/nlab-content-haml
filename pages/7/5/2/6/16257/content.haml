                %semantics
                  %mrow
                    %mi δ
                    %mo :
                    %mi A
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \delta : A \to M
              satisfying the following equations,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
