              has a left adjoint.
          .proof
            %h6#proof_4 Proof
            %p
              The forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Ab
                    %mo{:stretchy => "false"} (
                    %msub
