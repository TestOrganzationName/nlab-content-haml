                  %annotation{:encoding => "application/x-tex"} \eta : A \to B
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi B
