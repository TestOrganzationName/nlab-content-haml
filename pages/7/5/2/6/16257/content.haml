                  %annotation{:encoding => "application/x-tex"} \mu (\eta (\epsilon (b_2)) b_1, b_2 \eta (\epsilon (b_1))) = \mu (\eta (\epsilon (b_2)), b_2) \mu (b_1, \eta (\epsilon (b_1))) = b_2 b_1
            %p hence,
