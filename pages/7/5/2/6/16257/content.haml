                        %mi A
                    %annotation{:encoding => "application/x-tex"} \epsilon \circ \eta = id_A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo{:stretchy => "false"} (
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mn 0
                      %mo ,
                      %msub
                        %mi b
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
