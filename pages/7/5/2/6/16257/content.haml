                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo{:stretchy => "false"} (
