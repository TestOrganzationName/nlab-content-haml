                      %mo ×
                      %mi A
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \mu : B \times_A B \to B
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
