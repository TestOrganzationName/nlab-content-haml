          %h2#examples Examples
          %h3#OverAssociativeAlgebras Beck modules over associative algebras
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
