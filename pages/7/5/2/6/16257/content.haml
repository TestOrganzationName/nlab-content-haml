                      %mi h
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu (h_1, h_2) = \mu (\eta (g) \eta (g)^{-1} h_1, \eta (g) \eta (g)^{-1} h_2) = \mu (\eta (g), \eta (g)) \mu (\eta (g)^{-1} h_1, \eta (g)^{-1} h_2) = \eta (g) \mu (\eta (g)^{-1} h_1, \eta (g)^{-1} h_2)
            %p
              and writing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              for the unit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo{:stretchy => "false"} (
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msup
                        %mo{:stretchy => "false"} )
