          %p
            Beck derivations of
            %a.existingWikiWord{:href => "/nlab/show/C%5E%E2%88%9E-rings"} C^∞-rings
            then coincide with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/C%5E%E2%88%9E-derivations"} C^∞-derivations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
