                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          .proof
            %h6#proof_6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              be an
              = succeed "-bimodule," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊕
                    %mi M
                  %annotation{:encoding => "application/x-tex"} A \oplus M
              as a ring as above, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo :
                    %mi A
                    %mo ⊕
                    %mi M
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \epsilon : A \oplus M \to A
              be the obvious projection. A ring homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                    %mo ⊕
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \phi : A \to A \oplus M
              satisfying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∘
