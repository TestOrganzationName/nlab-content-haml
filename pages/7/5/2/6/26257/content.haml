              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} F_1
              sends
              = succeed "-vertical" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "-vertical" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} p'
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo :
                    %mi D
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \varphi:D \to E
              be a vertical map in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi φ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mn 1
                        %mi B
                    %annotation{:encoding => "application/x-tex"} p(\varphi) = 1_{B}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B=p(D)=p(E)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi φ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi F
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi F
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_1(\varphi) : F_1(D) \to F_1(E)
              is a 1-cell over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mn 1
                      %mi φ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi F
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi φ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %msub
                            %mi F
                            %mn 0
                          %mi B
                    %annotation{:encoding => "application/x-tex"} p'(F_1\varphi) = F_0(p(\varphi)) = 1_{F_0B}
          %p Thus fibred functors preserve the vertical-cartesian factorization of maps.
