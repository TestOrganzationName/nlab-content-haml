          %h1#corenatural_transformations Core-natural transformations
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#asNatural"} Alternative characterisations
              %li
