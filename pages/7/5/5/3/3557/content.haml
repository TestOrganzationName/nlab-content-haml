              %a.existingWikiWord{:href => "/nlab/show/Heyting+prealgebra"} Heyting prealgebra
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
