                  %msup
                    %mo{:stretchy => "false"} )
                    %mi Y
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi X
                %annotation{:encoding => "application/x-tex"} P(A)^f \colon P(A)^Y \to P(A)^X
          %p
            preserves the
            %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            structure. Now define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Pred
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pred_T(X)
            to be the poset obtained from the preorder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi X
                %annotation{:encoding => "application/x-tex"} P(A)^X
            by posetal reflection. With the help of functional completeness, it may be shown that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Pred
                    %mi T
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Pred_T(X)
            is in fact a Heyting algebra, and we get in this way a hyperdoctrine; see
            %a{:href => "http://ncatlab.org/nlab/show/partial+combinatory+algebra#realizability_toposes_11"} here
            for details. Notice in this case we have, by construction, an epimorphism between set-valued functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi hom
                    %mi Set
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi Pred
                      %mi T
                    %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \hom_{Set}(-, P(A)) \to {|Pred_T|}
          %p
            and thus we obtain a tripos, called the
            %em realizability tripos
            associated with the PCA
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#from_triposes_to_toposes From triposes to toposes
          %p
            Every first-order hyperdoctrine
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi T
                  %mo ,
                  %msub
                    %mi Pred
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T = (C_T, Pred_T)
            gives rise to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bicategory+of+relations"} bicategory of relations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            and where
            %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-cells
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are triples
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi r
                    %mo ∈
                    %msub
                      %mi Pred
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, Y, r \in Pred_T(X \times Y))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            as a “relation”
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} r \colon X \to Y
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Pred
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(X, Y) = Pred_T(X \times Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo ∘
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mo ∃
                    %mi y
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (r \circ s)(x, z) = \exists_y r(x, y) \wedge s(y, z)
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internally
            in the hyperdoctrine:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Pred
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %msub
                            %mi Pred
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ×
                          %mi Z
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msubsup
                                %mi π
                                %mrow
                                  %mi X
                                  %mo ×
                                  %mi Y
                                %mo *
                              %mo ×
                              %msubsup
                                %mi π
                                %mrow
                                  %mi Y
                                  %mo ×
                                  %mi Z
                                %mo *
                        %mtd
                          %msub
                            %mi Pred
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo ×
                          %mi Y
                          %mo ×
                          %mi Z
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %msub
                            %mi Pred
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo ×
                          %mi Y
                          %mo ×
                          %mi Z
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mo ∧
                        %mtd
                          %msub
                            %mi Pred
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo ×
                          %mi Y
                          %mo ×
                          %mi Z
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ×
                              %mi δ
                              %mo ×
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mo *
                        %mtd
                          %msub
                            %mi Pred
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %mo ×
                          %mi Z
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∃
                                %mrow
                                  %mn 1
                                  %mo ×
                                  %mo !
                                  %mo ×
                                  %mn 1
                        %mtd
                          %msub
                            %mi Pred
                            %mi T
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Z
                          %mo{:stretchy => "false"} )
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Pred_T(X \times Y) \times Pred_T(Y \times Z) &amp; \stackrel{\pi_{X \times Y}^\ast \times \pi_{Y \times Z}^\ast}{\to} &amp; Pred_T(X \times Y \times Y \times Z) \times Pred_T(X \times Y \times Y \times Z) \\
                  \&amp; \stackrel{\wedge}{\to} &amp; Pred_T(X \times Y \times Y \times Z) \\
                  \&amp; \stackrel{(1 \times \delta \times 1)^\ast}{\to} &amp; Pred_T(X \times Y \times Z) \\
                  \&amp; \stackrel{\exists_{1 \times ! \times 1}}{\to} &amp; Pred_T(X \times Z).
                  }
          %p
            This gives in fact a
            %a.existingWikiWord{:href => "/nlab/show/dagger-category"} dagger-category
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/poset"} posets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo †
                  %mo :
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (-)^\dagger: \hom(X, Y) \to \hom(Y, X)
            is the evident isomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Pred
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Pred
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pred_T(X \times Y) \to Pred_T(Y \times X)
            %em opposite
            of a relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} r \colon X \to Y
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mo †
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} r^\dagger \colon Y \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} r \colon X \to X
            is
            %em symmetric
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mo †
                    %mo =
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r^\dagger = r
            %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
            (bicategories of relations being essentially equivalent to unitary pretabular allegories).
          %p
            In this context, a
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/partial+equivalence+relation"} partial equivalence relation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} r \colon X \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mi r
                  %mo ≤
                  %mi r
                %annotation{:encoding => "application/x-tex"} r r \leq r
            plus symmetry
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mo †
                    %mo =
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r^\dagger = r
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} r \colon X \to X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≤
                    %mi r
                    %msup
                      %mi r
                      %mo †
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r \leq r r^\dagger r
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ≤
                  %mi r
                  %msup
                    %mi r
                    %mo †
                  %mi r
                  %mo =
                  %mi r
                  %mi r
                  %mi r
                  %mo ≤
                  %mi r
                  %mi r
                %annotation{:encoding => "application/x-tex"} r \leq r r^\dagger r = r r r \leq r r
          %p
            in addition to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mi r
                    %mo ≤
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r r \leq r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is in fact idempotent.)
          %p
            We will be interested in
            %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} splitting
            not all
            %a.existingWikiWord{:href => "/nlab/show/idempotents"} idempotents
            (as in
            = succeed "-based" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "-based" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pos
                  %annotation{:encoding => "application/x-tex"} Pos
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
          .num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              be a tripos, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Rel
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Rel_T
              be the bicategory of relations obtained from
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Split
                      %mi per
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Rel
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Split_{per}(Rel_T)
              be the bicategory obtained by splitting the PERs. Then the locally discrete bicategory of maps (whose 1-cells are left adjoints or total functional relations) in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Split
                      %mi per
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Rel
                      %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Split_{per}(Rel_T)
              is a topos.
          %p
            In the case of a
            = succeed "," do
              %a{:href => "#Topos"}
                tripos induced from a topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Rel
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Rel_T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            In the case of a
            %a{:href => "#PCA"} realizability tripos
            associated with a PCA
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %a.existingWikiWord{:href => "/nlab/show/Kleene%27s+first+algebra"} Kleene's first algebra
            (the PCA whose elements are natural numbers taken as codes for computer programs taking natural number input and producing natural number output if they halt, with obvious application partial function), this is also called the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/effective+topos"} effective topos
          %p
            Before we undertake a conceptual analysis of this theorem, we give in the next section some details for the tripos attached to a complete Heyting algebra, described
            = succeed "." do
              %a{:href => "#Heyt"} here
            = succeed "," do
              %span.newWikiWord
                Higgs
                %a{:href => "/nlab/new/Denis+Higgs"} ?
            %em à la
            Scott and Solovay).
          %h3#weak_triposes Weak triposes
          %p
            In
            %a{:href => "#Pitts02"} Pitts 2002
            it is observed that a somewhat weaker condition than suffices to ensure that the above construction yields a topos.
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong weak tripos
              is a first-order hyperdoctrine
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              together with, for every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} C_T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi c
                  %annotation{:encoding => "application/x-tex"} P c
              and an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi in
                      %mi c
                    %mo ∈
                    %msub
                      %mi Pred
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ×
                    %mi P
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} in_c \in Pred_T(c \times P c)
              such that for any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              and element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %msub
                        %mi Pred
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ×
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p \in Pred_T(c \times b)
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi i
                    %mo :
                    %mi b
                    %mo .
                    %mo ∃
                    %mi s
                    %mo :
                    %mi P
                    %mi c
                    %mo .
                    %mo ∀
                    %mi x
                    %mo :
                    %mi c
                    %mo .
                    %msub
                      %mo ∈
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \forall i:b. \exists s:P c. \forall x:c. \in_c(x,s) \Leftrightarrow p(x,i).
          %p
            This generalization is not vacuous either. For instance, it is shown in
            %a{:href => "#Pitts02"} Pitts 2002
            that for any infinite
            %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            there is a weak tripos over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FinSet
                  %annotation{:encoding => "application/x-tex"} FinSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be complete since we have only finite sets in the base; but we do need
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            to be Boolean rather than just Heyting in order to prove that this is a weak tripos. The resulting topos has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            as its poset of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/subterminal+objects"} subterminal objects
          %p
            In fact, it also seems unnecessary for the hyperdoctrine
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            to have equality, since in constructing a topos we equip every object with a
            %em new
            partial equivalence relation to become its “equality”. However, the above construction that goes through a bicategory of relations does rely on the existence of equality, as does the statement of the universal property of this construction (since equality in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            gives an embedding of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            as “constant objects” in its associated topos, which is the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit of an adjunction
          %h3#a_synthetic_view_of_triposes A “synthetic” view of triposes
          %p
            Every tripos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            over a topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            gives rise to a so-called “constant objects” functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi P
                  %mo :
                  %mi S
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} \Delta_P : S \to E
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} [
                  %mi P
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} S[P]
            induced by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %msub
                    %mi{:mathvariant => "normal"} eq
                    %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (I,\mathrm{eq}_I)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} eq
                    %mi I
                %annotation{:encoding => "application/x-tex"} \mathrm{eq}_I
            is the equality predicate on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            in the sense of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi P
                  %mo :
                  %mi S
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} \Delta_P : S \to E
            we know that
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi P
                    %annotation{:encoding => "application/x-tex"} \Delta_P
                preserves finite limits
            %li
              %p
                every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                appears as subquotient of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi P
                      %mi I
                    %annotation{:encoding => "application/x-tex"} \Delta_P I
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %li
              %p
                there is a subobject
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo :
                      %mi T
                      %mo ↣
                      %msub
                        %mi Δ
                        %mi P
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} t : T \rightarrowtail \Delta_P\Sigma
                such that every mono
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo :
                      %mi X
                      %mo ↣
                      %msub
                        %mi Δ
                        %mi P
                      %mi I
                    %annotation{:encoding => "application/x-tex"} m : X \rightarrowtail \Delta_P I
                appears as pullback of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
                along
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi P
                      %mi f
                    %annotation{:encoding => "application/x-tex"} \Delta_P f
                for some (typically not unique) map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi I
                      %mo →
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} f : I \to \Sigma
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          %p
            and that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is obtained from the subobject fibration of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            by change of base along along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \Delta_P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            correspond up to equivalence to functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            validates the above conditions (1)-(3). Moreover,
            %em weak
            triposes over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            correspond to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            which validate only conditions (1) and (2). Such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            are inverse image parts of localic geometric morphisms iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            has a right adjoint.
          %p
            Somewhat surprisingly the “chaotic” functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            to the topos of reflexive graphs is a weak tripos in the above sense. For every non-empty set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi I
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} (-)^I : \mathbf{Set} \to \mathbf{Set}
            is a weak tripos. For non-isomorphic finite non-empty sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            the functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi I
                %annotation{:encoding => "application/x-tex"} (-)^I
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi J
                %annotation{:encoding => "application/x-tex"} (-)^J
            are not equivalent. Thus, nonequivalent weak triposes over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbf{Set}
            can give rise to equivalent toposes. It is an open question whether this is also possible for genuine non-weak triposes over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Set
                  %annotation{:encoding => "application/x-tex"} \mathbf{Set}
          %h2#relation_to_valued_sets
            Relation to
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p
            Consider the tripos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %msub
                    %mi T
                    %mi H
                %annotation{:encoding => "application/x-tex"} T = T_H
            obtained from a complete Heyting algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            (
            %a{:href => "#Heyt"}> example 2
            ), or more exactly the bicategory of relations obtained from this. Let us describe explicitly the bicategory obtained by splitting the PERs:
          %ul
            %li
              %p
                An object in the PER-splitting completion in this case is a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                equipped with a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ×
                      %mi X
                      %mo →
                      %mi H
                    %annotation{:encoding => "application/x-tex"} e \colon X \times X \to H
                which is symmetric and transitive in the sense described above. This boils down to having, for all elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x, y, z \in X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} e(x, y) = e(y, x)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} e(x, y) \wedge e(y, z) \leq e(x, z)
              %p
                This is also known as an
                = succeed "." do
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                    \-valued set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊤
                      %mo ≤
                      %mi e
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \top \leq e(x, x)
                for all
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
                can be thought of as a measure of equality.
            %li
              %p
                A morphism from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi e
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X, e_X)
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi e
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Y, e_Y)
                is a relation
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} r \colon X \to Y
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ×
                        %mi Y
                        %mo →
                        %mi H
                      %annotation{:encoding => "application/x-tex"} r \colon X \times Y \to H
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ∘
                        %msub
                          %mi e
                          %mi X
                        %mo =
                        %mi r
                        %mo =
                        %msub
                          %mi e
                          %mi Y
                        %mo ∘
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r \circ e_X = r = e_Y \circ r
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelope
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ∘
                        %msub
                          %mi e
                          %mi X
                        %mo ≤
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r \circ e_X \leq r
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi Y
                      %mo ∘
                      %mi r
                      %mo ≤
                      %mi r
                    %annotation{:encoding => "application/x-tex"} e_Y \circ r \leq r
                mean we have a two-sided “action”:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "2em"}
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %msub
                        %mi e
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"} e_X(x', x) \wedge r(x, y) \leq r(x', y), \qquad r(x, y) \wedge e_Y(y, y') \leq r(x, y').
              %p
                The condition
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ≤
                      %mi r
                      %mo ∘
                      %msub
                        %mi e
                        %mi X
                    %annotation{:encoding => "application/x-tex"} r \leq r \circ e_X
                means
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                        %mrow
                          %mi x
                          %mo ′
                          %mo ∈
                          %mi X
                      %msub
                        %mi e
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mi r
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ′
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} r(x, y) \leq \bigvee_{x' \in X} e_X(x, x') \wedge r(x', y)
              %p
                but since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi X
                    %annotation{:encoding => "application/x-tex"} e_X
                is symmetric and transitive, we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi r
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi y
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≤
                            %mtd
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                                %mrow
                                  %mi x
                                  %mo ′
                                  %mo ∈
                                  %mi X
                              %msub
                                %mi e
                                %mi X
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi x
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %mi r
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ′
                              %mo ,
                              %mi y
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                            %mtd
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                                %mrow
                                  %mi x
                                  %mo ′
                              %msub
                                %mi e
                                %mi X
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi x
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %msub
                                %mi e
                                %mi X
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ′
                              %mo ,
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %mi r
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ′
                              %mo ,
                              %mi y
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≤
                            %mtd
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                                %mrow
                                  %mi x
                                  %mo ′
                              %msub
                                %mi e
                                %mi X
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi x
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo ∧
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ′
                              %mo ,
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo ≤
                              %mi e
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi x
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      r(x, y) &amp; \leq &amp; \bigvee_{x' \in X} e_X(x, x') \wedge r(x', y)\\
                      \&amp; = &amp; \bigvee_{x'} e_X(x, x') \wedge e_X(x', x) \wedge r(x', y)\\
                      \&amp; \leq &amp; \bigvee_{x'} e_X(x, x') \wedge e(x', x) \leq e(x, x)
                      }
              %p
                so that in fact we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %msub
                          %mi e
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} r(x, y) \leq e_X(x, x)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mi e
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} r(x, y) \leq e(y, y)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ≤
                        %mi r
                        %mo ∘
                        %msub
                          %mi e
                          %mi X
                      %annotation{:encoding => "application/x-tex"} r \leq r \circ e_X
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ≤
                        %msub
                          %mi e
                          %mi Y
                        %mo ∘
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r \leq e_Y \circ r
          %p
            Such morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            are called
            = succeed "." do
              %em
                relations between
                = succeed "-valued" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Split
                    %mi per
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Rel
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Split_{per}(Rel_T)
            may be composed just as they are in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Rel
                      %mi T
                  %annotation{:encoding => "application/x-tex"} Rel_T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is an
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi r
                      %mo †
                  %annotation{:encoding => "application/x-tex"} r^\dagger
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelope
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, e)
            to itself is given by the relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            (clearly the identity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi X
                %annotation{:encoding => "application/x-tex"} 1_X
            doesn’t work!). The result
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Split
                    %mi per
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Rel
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Split_{per}(Rel_T)
            is also a bicategory of relations (although, as we will eventually see, much more is true).
          %p
            A relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi e
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi e
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} r \colon (X, e_X) \to (Y, e_Y)
            between PERs is
            %em functional
            if
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∘
                      %msup
                        %mi r
                        %mo †
                      %mo ≤
                      %msub
                        %mn 1
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %msub
                            %mi e
                            %mi Y
                          %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi e
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} r \circ r^\dagger \leq 1_{(Y, e_Y)} = e_Y
                (“well-definedness”).
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mi X
                      %mo =
                      %msub
                        %mn 1
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %msub
                            %mi e
                            %mi X
                          %mo{:stretchy => "false"} )
                      %mo ≤
                      %msup
                        %mi r
                        %mo †
                      %mo ∘
                      %mi r
                    %annotation{:encoding => "application/x-tex"} e_X = 1_{(X, e_X)} \leq r^\dagger \circ r
                (“totality”);
          %p The first of these conditions means
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi r
                    %mo †
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %msub
                    %mi e
                    %mi Y
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi y
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} r^\dagger(y, x) \wedge r(x, y') = r(x, y) \wedge r(x, y') \leq e_Y(y, y')
          %p The second condition means
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mrow
                      %mi y
                      %mo ∈
                      %mi Y
                  %mi r
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %msup
                    %mi r
                    %mo †
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} e_X(x, x') \leq \bigvee_{y \in Y} r(x, y) \wedge r^\dagger(y, x')
          %p
            which certainly implies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mi y
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e_X(x, x) \leq \bigvee_y r(x, y)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mi y
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e_X(x, x) \leq \bigvee_y r(x, y)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi e
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo ′
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≤
                        %mtd
                          %msub
                            %mi e
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msub
                            %mi e
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≤
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mi y
                          %mi r
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msub
                            %mi e
                            %mi X
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi x
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≤
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mi y
                          %mi r
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %mi r
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ′
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≤
                        %mtd
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                            %mi y
                          %mi r
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi y
                          %mo{:stretchy => "false"} )
                          %mo ∧
                          %msup
                            %mi r
                            %mo †
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo ,
                          %mi x
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  e_X(x, x') &amp; \leq &amp; e_X(x, x) \wedge e_X(x, x') \\
                  \&amp; \leq &amp; \bigvee_y r(x, y) \wedge e_X(x, x') \\
                  \&amp; \leq &amp; \bigvee_y r(x, y) \wedge r(x', y) \\
                  \&amp; \leq &amp; \bigvee_y r(x, y) \wedge r^\dagger(y, x').
                  }
          %p
            Thus totality of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} r \colon X \to Y
            is equivalent to
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                    %mi r
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} e_X(x, x) \leq \bigvee_{y \in Y} r(x, y)
          .num_theorem
            %h6#theorem_higgs Theorem (Higgs)
            %p
              For a complete Heyting algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
          %p
            Thus all
            %a.existingWikiWord{:href => "/nlab/show/localic+topos"} localic toposes
            arise as toposes of
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is the Heyting algebra of subobjects of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            Compare the description by Walters of sheaves over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            as certain types of Cauchy-complete categories enriched in a bicategory. Notice that in that description, the homs are symmetric (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(x, y) = \hom(y, x)
            ), so that the Cauchy completion or idempotent-splitting completion is the same as the completion by splitting symmetric idempotents.
          .num_remark
            %h6#remark_2 Remark
            %p
              The triposes over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              of this form are precisely those for which the preorder imposed on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Set
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi P
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Hom_{Set}(X, P) \simeq P^X
              is the straightforward
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi Set
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi P
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi P
                    %annotation{:encoding => "application/x-tex"} Hom_{Set}(1, P) \simeq P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is the carrier of the generic predicate; in all other cases, the former is a finer-grained preorder than the latter. Thus, in some sense, triposes over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              are a generalization of the notion of “complete Heyting algebra” taking advantage of the ability to use preorder rather than poset structure to allow for a weakening of the condition of completeness.
            %p
              An example taking advantage of this generalization is given by
              = succeed "." do
                %a{:href => "#PCA"} realizability triposes
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/realizability"} realizability
          %h2#relation_to_exact_completion Relation to exact completion
          %p
            As stated above, the topos obtained from a tripos can be described as the category of PERs in the bicategory of relations, and functional relations between them. In different language, the bicategory of PERs or symmetric idempotents and relations between them is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power+allegory"} power allegory
          %p
            The process of splitting symmetric idempotents in the bicategory of relations can be analyzed into two steps, the first related to taking a regular completion, and the second to taking an
            %a.existingWikiWord{:href => "/nlab/show/exact+completion"} exact completion
            of a regular category. More exactly, they are analogues on the allegorical side of these two types of completion.
          %p
            The two steps are as follows, starting with a bicategory of relations (or perhaps preferably a
            %a.existingWikiWord{:href => "/nlab/show/framed+bicategory"} framed bicategory
            of relations). Splitting symmetric idempotents can be obtained by
          %ul
            %li
              %p
                First splitting the coreflexive morphisms (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} r \colon X \to X
                is coreflexive if
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ≤
                        %msub
                          %mn 1
                          %mi X
                      %annotation{:encoding => "application/x-tex"} r \leq 1_X
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/allegory"} unitary tabular allegory
            %li
              %p
                Then, in the unitary tabular allegory, split equivalence relations. In allegorical language, this results in an effective (unitary tabular) allegory (Freyd-Scedrov, page 213); on the categorical side, it means we pass from a regular category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                to its
                %a.existingWikiWord{:href => "/nlab/show/regular+and+exact+completions"} exact completion
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mrow
                            %mi ex
                            %mo{:stretchy => "false"} /
                            %mi reg
                      %annotation{:encoding => "application/x-tex"} C_{ex/reg}
          %h2#internal_logic Internal logic
          %p
            Of course, the topos obtained from a tripos has an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            %a.existingWikiWord{:href => "/nlab/show/product+types"} product types
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/power+types"} power types
            %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            and a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"} type of propositions
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/anafunctions"} anafunctions
          %h2#see_also  See also
          %ul
            %li
              %p
                %span.newWikiWord
                  2-tripos
                  %a{:href => "/nlab/new/2-tripos"} ?
            %li
              %p
                %span.newWikiWord
                  (
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  , 1)-tripos
                  %a{:href => "/nlab/new/%28%24%5Cinfty%24%2C+1%29-tripos"} ?
          %h2#references References
          %ul#PittsThesis
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Pitts"}> Andrew Pitts
              ,
              = succeed "," do
                %em
                  The theory of
                  %a.existingWikiWord{:href => "/nlab/show/triposes"} triposes
              %a{:href => "http://www.cl.cam.ac.uk/~amp12/papers/thet/thet.pdf"} pdf
          %ul#Pitts02
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Pitts"}> Andrew Pitts
              ,
              = succeed "," do
                %em Tripos theory in retrospect
              %a{:href => "http://www.cl.cam.ac.uk/~amp12/papers/tritr/tritr.pdf"} pdf
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Freyd"} Peter Freyd
              and Andre Scedrov,
              = succeed "," do
                %em Categories, Allegories
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  In fact one may “quantify” along any term = morphism in the base category
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mi T
                        %annotation{:encoding => "application/x-tex"} C_T
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Pred
                          %mi T
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Pred_T(f)
                  has a left adjoint and a right adjoint, merely if we assume this of projection and diagonal maps and if we assume an appropriate
                  = succeed "," do
                    %a{:href => "http://ncatlab.org/nlab/show/Frobenius+reciprocity#frobenius_laws_and_frobenius_reciprocity_11"} Frobenius law
                  %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+conditions"} Beck-Chevalley conditions
                  for
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  diagrams in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi T
                      %annotation{:encoding => "application/x-tex"} C_T
                  is another matter; the original treatment by Pitts assumed more than is actually necessary. Namely, it was assumed that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi T
                      %annotation{:encoding => "application/x-tex"} C_T
                  is finitely complete and the Beck-Chevalley condition holds for
                  %em all
                  pullbacks in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mi T
                        %annotation{:encoding => "application/x-tex"} C_T
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi C
                            %mi T
                        %annotation{:encoding => "application/x-tex"} C_T
                  %a{:href => "#fnref:1", :rev => "footnote"} ↩
