                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0550-3213%2896%2900008-9"} doi:10.1016/0550-3213%2896%2900008-9
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Wolfgang+Lerche"}> Wolfgang Lerche
