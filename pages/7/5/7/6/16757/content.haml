                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em Two-Dimensional Black Hole and Singularities of CY Manifolds
                %strong 463
                (1996) 55-72 (
                %a{:href => "https://arxiv.org/abs/hep-th/9511164"}> arXiv:hep-th/9511164
