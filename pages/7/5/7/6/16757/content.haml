          %p Textbook accounts include
          %ul
            %li#Durfee79
              %p
                Alan H. Durfee:
                = succeed "," do
                  %em Fifteen characterizations of rational double points and simple critical points
                %strong 25
                (1979) &amp;lbrack;
                %a{:href => "http://dx.doi.org/10.5169/seals-50375"}> doi:10.5169/seals-50375
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.maths.ed.ac.uk/~v1ranick/papers/durfee15.pdf"} pdf
            %li#Slodowy80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Slodowy"}> Peter Slodowy
                \:
