          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msub
                    %mi π
                    %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
