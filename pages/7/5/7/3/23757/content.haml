          %h3#in_arbitrary_dense_linear_orders In arbitrary dense linear orders
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/dense+linear+order"} dense linear order
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %msub
                      %mo &lt;
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A, \lt_A)
            %a.existingWikiWord{:href => "/nlab/show/open+interval"} open interval
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            between elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a \in A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b \in B
            is the set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} OpenInt
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi c
                  %mo ∈
                  %mi A
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo &lt;
                  %mi c
                  %mo &lt;
                  %mi b
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathrm{OpenInt}(a,b) = \{c \in A \vert a \lt c \lt b\}
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/countable+dense+linear+order"} countable dense linear order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msub
                    %mo &lt;
                    %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B, \lt_B)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ⊆
                  %mi A
                %annotation{:encoding => "application/x-tex"} B \subseteq A
            and for all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} a \in A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} b \in A
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \lt b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} c \in B
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo &lt;
                    %mi c
                    %mo &lt;
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \lt c \lt b
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              \-indexed locator
            for an
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} c \in A
            is an element of the indexed
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                  %mo ∈
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo ∈
                      %mi B
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo ∈
                      %mi B
                  %msup
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %mi{:mathvariant => "normal"} OpenInt
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo ⊎
                      %mo{:stretchy => "false"} [
                      %mi{:mathvariant => "normal"} OpenInt
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi{:mathvariant => "normal"} OpenInt
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} l \in \prod_{a \in B} \prod_{b \in B} \left([\mathrm{OpenInt}(a,c)] \uplus [\mathrm{OpenInt}(c,b)]\right)^{[\mathrm{OpenInt}(a,b)]}
          %h2#in_dependent_type_theory In dependent type theory
          %p
            In dependent type theory, given a real number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} r:\mathbb{R}
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            is a
            %a.existingWikiWord{:href => "/nlab/show/dependent+function"} dependent function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo :
                      %mi ℚ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi q
                      %mo :
                      %mi ℚ
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo &lt;
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo &lt;
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo &lt;
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} l:\prod_{p:\mathbb{Q}} \prod_{q:\mathbb{Q}} (p \lt q) \to ((p \lt r) + (r \lt q))
          %p This above type is equivalent to the types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo :
                      %mi ℚ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi q
                      %mo :
                      %mi ℚ
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo &lt;
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo :
                      %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo &lt;
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo &lt;
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{p:\mathbb{Q}} \prod_{q:\mathbb{Q}} (p \lt q) \to \sum_{b:\mathrm{bool}} ((b = 1) \to (p \lt r)) \times ((b = 0) \to (r \lt q))
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo :
                      %mi ℚ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi q
                      %mo :
                      %mi ℚ
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo &lt;
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo →
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi b
                      %mo :
                      %mi{:mathvariant => "normal"} bool
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
