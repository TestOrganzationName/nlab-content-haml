          %h3#in_the_real_numbers In the real numbers
          %p
            A
            %strong locator
            for a real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} c \in \mathbb{R}
            is an element of the indexed
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                  %mo ∈
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo ∈
                      %mi ℚ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo ∈
                      %mi ℚ
                  %msup
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} {
                      %mi d
                      %mo ∈
                      %mi ℝ
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo &lt;
                      %mi d
                      %mo &lt;
                      %mi c
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} ]
                      %mo ⊎
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} {
                      %mi d
                      %mo ∈
                      %mi ℝ
                      %mo{:stretchy => "false"} |
                      %mi c
                      %mo &lt;
                      %mi d
                      %mo &lt;
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} {
                      %mi d
                      %mo ∈
                      %mi ℝ
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo &lt;
                      %mi d
                      %mo &lt;
                      %mi b
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} l \in \prod_{a \in \mathbb{Q}} \prod_{b \in \mathbb{Q}} \left([\{d \in \mathbb{R} \vert a \lt d \lt c\}] \uplus [\{d \in \mathbb{R} \vert c \lt d \lt b\}]\right)^{[\{d \in \mathbb{R} \vert a \lt d \lt b\}]}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊎
                  %mi B
                %annotation{:encoding => "application/x-tex"} A \uplus B
            is the
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            of two sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi A
                %annotation{:encoding => "application/x-tex"} B^A
            is the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} set of functions
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [A]
            is the
            %a.existingWikiWord{:href => "/nlab/show/support+of+a+set"} support
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            is defined in
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ∈
                  %msup
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                        %mrow
                          %mi a
                          %mo ∈
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mi A
                  %mo{:stretchy => "false"} |
                  %mo ∀
                  %mi a
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \prod_{a \in A} B(a) = \{f \in \left(\bigcup_{a\in A} B(a)\right)^A \vert \forall a, f(a) \in B(a) \}
          %p
            for
            %a.existingWikiWord{:href => "/nlab/show/family+of+sets"} family of sets
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi a
                        %mo ∈
                        %mi A
                  %annotation{:encoding => "application/x-tex"} (B(a))_{a \in A}
          %p
            Equivalently, a
            %strong locator
            is an element of the indexed
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi l
                  %mo ∈
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo ∈
