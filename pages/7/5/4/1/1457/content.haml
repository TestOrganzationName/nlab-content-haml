          %h2#idea Idea
          %p
            A
            %strong metric space
            is a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            which comes equipped with a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            which measures
            %em distance
            between points, called a
            = succeed "." do
              %em metric
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            on the set, the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            whose topology comes from some metric is said to be
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/metrizable"} metrizable
          %h2#definitions Definitions
          %p
            Traditionally, a
            %strong metric space
            is defined to be a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a
            %strong distance
            %a.existingWikiWord{:href => "/nlab/show/function"} function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo ×
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d\colon X \times X \to [0, \infty)
          %p
            (valued in
            %a.existingWikiWord{:href => "/nlab/show/nonnegative+number"} non-negative
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/triangle+inequality"}> Triangle inequality
                \:
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ≥
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d(x, y) + d(y, z) \geq d(x, z)
            %li
              %p
                Point inequality:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≥
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 \geq d(x, x)
                (so
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo =
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 0 = d(x,x)
            %li
              %p
                Separation:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x = y
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d(x, y) = 0
                (so
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x = y
                iff
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d(x,y) = 0
            %li
              %p
                Symmetry:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d(x, y) = d(y, x)
          %p
            Given a metric space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, d)
            and a point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            %strong
              %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
            centered at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of radius
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mo ;
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mi y
                  %mo ∈
                  %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                  %mspace{:width => "thinmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mi r
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
                  B_r(x)
                  \\;\coloneqq;
                  \\big\{ y \in X \,\big\vert\, d(x, y) \lt r \big\}
          %p
            and it may be shown that the open balls form a
            %a.existingWikiWord{:href => "/nlab/show/basis+for+a+topology"} basis
            for a
            %a.existingWikiWord{:href => "/nlab/show/topological+structure"} topology
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniform+spaces"} uniform spaces
            %a.existingWikiWord{:href => "/nlab/show/complete+space"} completion
            of a metric space, can be extrapolated to uniform spaces and even
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+spaces"} Cauchy spaces
          %h3#as_a_richman_premetric_space As a Richman premetric space
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %strong metric space
            is a
            %a.existingWikiWord{:href => "/nlab/show/Richman+premetric+space"} Richman premetric space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo ∼
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \sim)
            such that for all non-negative rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %msub
                      %mi ℚ
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} q \in \mathbb{Q}_{\geq 0}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %msub
                      %mi ℚ
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} r \in \mathbb{Q}_{\geq 0}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &lt;
                    %mi r
                  %annotation{:encoding => "application/x-tex"} q \lt r
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} y \in X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo ∼
                    %mi r
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \sim_r y
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo ∼
                      %mi q
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg(x \sim_q y)
          %h3#metrizable_spaces Metrizable spaces
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/metrizable+topological+space"} metrizable topological space
            is a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which admits a metric such that the
            %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
            agrees with the topology on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniform structures
          %p
            Metrizable spaces enjoy a number of separation properties: they are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+space"} regular
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normal+space"} normal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/paracompact+space"} paracompact
          %p
            Metrizable spaces are closed under topological
            %a.existingWikiWord{:href => "/nlab/show/coproducts"} coproducts
            and of course
            %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
            (and therefore
            = succeed ");" do
              %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
            %a.existingWikiWord{:href => "/nlab/show/countable+family"} countable
            %a.existingWikiWord{:href => "/nlab/show/products"} products
            but not general products (for instance, a product of uncountably many copies of the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is not a normal space).
          %p
            Fundamental early work in point-set topology established a number of metrization theorems, i.e., theorems which give sufficient conditions for a space to be metrizable. One of the more useful theorems is due to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Urysohn"} Urysohn
          %p
          #UrysohnMetrizationTheorem.num_theorem
            %h6 Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Urysohn+metrization+theorem"}> Urysohn metrization theorem
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/separation+axiom"} regular, Hausdorff
              %a.existingWikiWord{:href => "/nlab/show/second-countable+space"} second-countable space
              is metrizable.
          %p
          .num_remark
            %h6 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              that is second-countable is metrizable.
          %p
          .num_remark
            %h6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/counter-example"}> counter-example
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              that is merely
              %a.existingWikiWord{:href => "/nlab/show/separable+space"} separable
              need not be metrizable.
            %p
              One
              %a.existingWikiWord{:href => "/nlab/show/counter-example"} counter-example
              is the
              %a.existingWikiWord{:href => "/nlab/show/Stone-Cech+compactification"} Stone-Cech compactification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi ℕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta(\mathbb{N})
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              of
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense
              %a.existingWikiWord{:href => "/nlab/show/ultrafilter"} ultrafilter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit of a sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo ⊆
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} X = \{x_n\} \subseteq \mathbb{N}
              of principal ultrafilters.
            %p
              Namely: Supposing it were, choose complementary subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ⊆
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} A, B \subseteq \mathbb{N}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \cap X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∩
                    %mi X
                  %annotation{:encoding => "application/x-tex"} B \cap X
              are infinite. By the decomposition
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi ℕ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo +
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta(\mathbb{N}) = \beta(A + B) = \beta(A) + \beta(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              belonging to exactly one of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta(A), \beta(B)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \beta(B)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \cap X
              converges to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi V
                    %mo ∈
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                    %mo ∈
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \beta(B) = \{V \in \beta(\mathbb{N}): B \in V\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              intersects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∩
                    %mi X
                  %annotation{:encoding => "application/x-tex"} A \cap X
              non-trivially, i.e.,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is contained in some principal ultrafilter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi prin
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} prin(a)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                      %mo ∩
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a \in A \cap X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              lies in disjoint sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∩
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \cap X
          %h3#variations Variations
          %p
            If we allow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            to take values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0,\infty]
            (the nonnegative
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/lower+reals"} lower reals
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [0,\infty)
            = succeed "." do
              %strong extended metric spaces
            = succeed "." do
              %strong pseudometric spaces
            = succeed "." do
              %strong quasimetric spaces
            %strong Lawvere metric spaces
            for the reasons below.
          %p#LawvereMetricSpacesDefinition
            On the other hand, if we strengthen the
            %a.existingWikiWord{:href => "/nlab/show/triangle+inequality"} triangle inequality
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi max
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} max(d(x,y), d(y,z)) \geq d(x,z) ,
          %p
            then we get
            = succeed "," do
              %strong ultrametric spaces
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/number+fields"} number fields
            = succeed "." do
              %strong Lawvere ultrametric spaces
          %h3#metrics_valued_in_another_archimedean_integral_domain Metrics valued in another Archimedean integral domain
          %p
            In some cases, we might want our
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            of our metric to take values in values other than the real numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modulated+Cauchy+real+numbers"} modulated Cauchy real numbers
            %a.existingWikiWord{:href => "/nlab/show/non-negative+number"} non-negative
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℚ
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{\geq 0}
          %p
            This becomes even more essential in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %a.existingWikiWord{:href => "/nlab/show/modulated+Cauchy+real+numbers"} modulated Cauchy real numbers
            are equivalent to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            with the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+fullness"} axiom of fullness
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/multivalued+Cauchy+real+numbers"} multivalued Cauchy real numbers
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            without the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+fullness"} axiom of fullness
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations
            %a.existingWikiWord{:href => "/nlab/show/universe"} universe
            in the foundations. In other foundations, there isn’t even a single set of Dedekind real numbers. As a result, one cannot resort to merely using the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            for defining the metric as in impredicative mathematics, one has to define metrics and metric spaces more generally.
          %p
            Thus, given an
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+integral+domain"} Archimedean integral domain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              \-metric
            on a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo :
                    %mi X
                    %mo ×
                    %mi X
                    %mo →
                    %msub
                      %mi R
                      %mrow
                        %mo ≥
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} d:X \times X \to R_{\geq 0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mrow
                      %mo ≥
                      %mn 0
                %annotation{:encoding => "application/x-tex"} R_{\geq 0}
            is the set of non-negative elements in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/triangle+inequality"}> Triangle inequality
                \:
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ≥
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d(x, y) + d(y, z) \geq d(x, z)
            %li
              %p
                Point inequality:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≥
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 \geq d(x, x)
                (so
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                        %mo =
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 0 = d(x,x)
            %li
              %p
                Separation:
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x = y
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d(x, y) = 0
                (so
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x = y
                iff
                = succeed ");" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d(x,y) = 0
            %li
              %p
                Symmetry:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d(x, y) = d(y, x)
          %p
            This is equivalently an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ,
                    %mo ≥
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R_{\geq 0}, \geq, +, 0)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+set"} enriched set
          %p
            Given any
            %a.existingWikiWord{:href => "/nlab/show/Archimedean+integral+domain"} Archimedean integral domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and an Archimedean integral subdomain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊆
                    %mi R
                  %annotation{:encoding => "application/x-tex"} S \subseteq R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is an
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi R
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo ,
                    %mo ≥
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R_{\geq 0}, \geq, +, 0)
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type"} type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            be some suitable notion of real number, and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mrow
                      %mo ≥
                      %mn 0
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo :
                      %mi ℝ
                  %mi a
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\geq 0} \coloneqq \sum_{a:\mathbb{R}} a \geq 0
          %p be the non-negative real numbers.
          %p
          .num_defn
            %h6 Definition
            %p
              A
              %strong pseudometric space
              is a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with a function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo :
                      %mi X
                      %mo ×
                      %mi X
                      %mo →
                      %msub
                        %mi ℝ
                        %mrow
                          %mo ≥
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} d:X \times X \to \mathbb{R}_{\geq 0}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} sym
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{sym}(x, y):d(x, y) = d(y, x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} triangle
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{triangle}(x, y, z):d(x, z) \leq d(x, y) + d(y, z)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} idtozerodis
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{idtozerodis}(x, y):(x = y) \to (d(x, y) = 0)
            %p
          %p The last axiom is equivalent to the point inequality axiom
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} ptineq
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathrm{ptineq}(x):d(x, x) = 0
          %p
            by the induction principle of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∼
                  %mi y
                  %mo ≔
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} x \sim y \coloneqq d(x, y) = 0
          %p through the axioms of a pseudometric space.
          %p In set theory, the separation axiom is usually defined as the converse of the identity-to-zero-distance axiom. However, in type theory, since not all identity types are propositions, merely postulating a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} sepax
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo =
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{sepax}(x, y):(d(x, y) = 0) \to (x = y)
          %p
            does not result in a metric space, since there might be many such functions into the identity type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x = y
            %a.existingWikiWord{:href => "/nlab/show/Rezk+completion"} Rezk completeness
            condition for pseudometric spaces, similar to the type-theoretic antisymmetry condition in
            %a.existingWikiWord{:href => "/nlab/show/posets"} posets
            from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preordered types
          %p
          .num_defn
            %h6 Definition
            %p
              A pseudometric space is a
              %strong metric space
              if the axiom
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} idtozerodis
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{idtozerodis}(x, y):(x = y) \to (d(x, y) = 0)
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+in+homotopy+type+theory"} equivalence of types
          %p Since any type of non-negative real numbers is a set, the Rezk completeness condition automatically implies that every metric space is a set.
          %h3#category_of_metric_spaces Category of metric spaces
          %p
            When working with metric spaces one encounters a broad variety of different maps including non-
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
            ones like almost isometries. For a convenient categorical set-up one often restricts to
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/short+map"} short maps
            %a.existingWikiWord{:href => "/nlab/show/Lipschitz+map"} Lipschitz norm
            not greater than 1. The category of Lawvere metric spaces and short maps forms the
            %a.existingWikiWord{:href => "/nlab/show/category+of+metric+spaces"} category of metric spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Met
                  %annotation{:encoding => "application/x-tex"} Met
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Met
                      %mi ord
                  %annotation{:encoding => "application/x-tex"} Met_{ord}
          %h2#LawvereMetricSpace Lawvere metric spaces
          %p
            In
            = succeed "," do
              %a{:href => "#Lawvere73"} Lawvere, 73
            %a{:href => "#LawvereMetricSpacesDefinition"} Lawvere metric spaces
            are precisely
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} categories enriched
            in the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
            %a.existingWikiWord{:href => "/nlab/show/partial+order"} poset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo ≥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ([0, \infty], \geq)
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            is taken to be addition. The
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            operation in this enriched category identifies with the
            %a.existingWikiWord{:href => "/nlab/show/triangle+identity"} triangle identity
            in the metric space (see at
            = succeed ")." do
              %em
                %a{:href => "triangle+inequality#InterpretationInEnrichedCategoryTheory"} triangle inequality – Interpretation in enriched category theory
          %p
            Alternatively, taking the monoidal product to be
            %a.existingWikiWord{:href => "/nlab/show/supremum"} supremum
            instead, enriched categories amount to Lawvere ultrametric spaces.
          %p
            Thus generalized, many constructions and results on metric spaces turn out to be special cases of yet more general constructions and results of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy completion
            %a.existingWikiWord{:href => "/nlab/show/Karoubi+envelope"} Karoubi envelopes
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
          %p
            The symmetry axiom is naturally interpreted as giving an enriched
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            %a.existingWikiWord{:href => "/nlab/show/dagger+category"} category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0, \infty]
            as a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            where the involution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo †
                %annotation{:encoding => "application/x-tex"} \dagger
            is the identity. Note that when one is enriching over a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal
            poset, there is no difference between a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched groupoids
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          %p
            In the presence of the symmetry axiom, the “separation” axiom “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} x=y
            if
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d(x,y)=0
            %a.existingWikiWord{:href => "/nlab/show/skeletal+category"} skeletality
            of an enriched category. That is, a pseudo-metric space is a metric space precisely when it is skeletal. But in the non-symmetric case, this separation axiom is stronger than skeletality; the latter would say only “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi y
                %annotation{:encoding => "application/x-tex"} x=y
            if
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d(x,y)=d(y,x)=0
          %p
            Note that like any kind of enriched category, Lawvere metric spaces are
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            in a
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            of “matrices”, whose objects are sets and whose morphisms from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are functions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo :
                    %mi X
                    %mo ×
                    %mi Y
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} d:X\times Y \to [0,\infty]
            = succeed "." do
              %a{:href => "#HST"} Monoidal topology
          %p
            The category of metric spaces and categories of random maps as generalised metric spaces were studied in the
            %a{:href => "#Meng"} thesis
            of Lawvere’s student Xiao-qing Meng.
          %h2#motivation_for_the_axioms Motivation for the axioms
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/triangle+inequality"} triangle axiom
            is the fundamental idea behind a metric space; it goes back (at least) to
            %a.existingWikiWord{:href => "/nlab/show/Euclid"} Euclid
            and captures the idea that we are discussing the
            %em shortest
            distance between two points. Given the triangle inequality, we have the polygon inequality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ⋯
                  %mo +
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mi d
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 0
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(x_0,x_1) + \cdots + d(x_{n-1},x_n) \geq d(x_0,x_n)
          %p
            for all
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
          %p Besides extended metric spaces (where distances may be infinite), one might consider spaces where distances may be negative. But in fact this gives us nothing new, at least if we have symmetry. First,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(x,x) + d(x,x) \geq d(x,x)
          %p
            forces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d(x,x) \geq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ≥
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 0 \geq d(x, x)
            forces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d(x, x) = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 2 d(x,y) = d(x,y) + d(y,x) \geq d(x,x)
          %p
            forces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d(x,y) \geq 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            elements, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d(x,y) = -d(y,x)
            (but necessarily
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} d(x,x) = 0
            still).
          %p
            We can define a
            %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            on the points of a Lawvere metric space:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} x \leq y \;\Leftrightarrow\; d(x,y) = 0 .
          %p
            Then the symmetry axiom implies that this relation is
            %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric
            and hence an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
            under this equivalence relation satisfies separation; in this way, every pseudometric space is
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            (as an enriched category) to a metric space. Even for quasimetric spaces, we can still define an equivalence relation:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≡
                  %mi y
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo ∧
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} x \equiv y \;\Leftrightarrow\; d(x,y) = 0 \;\wedge\; d(y,x) = 0 .
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⪇
                  %annotation{:encoding => "application/x-tex"} \lneq
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ⪇
                  %mi y
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                  %mo ;
                %annotation{:encoding => "application/x-tex"} x \lneq y \;\Leftrightarrow\; d(x,y) \gt 0 ;
          %p
            then the symmetry axiom implies that this is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness relation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo #
                  %mi y
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                  %mspace{:width => "thickmathspace"}
                  %mo ∨
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} x \# y \;\Leftrightarrow\; d(x,y) \gt 0 \;\vee\; d(y,x) \gt 0 .
          %h2#examples Examples
          %ul
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                carries the
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete metric
                given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 0
                              %mtd
                                %mtext if
                                %mi x
                                %mo =
                                %mi y
                            %mtr
                              %mtd
                                %mn 1
                              %mtd
                                %mtext otherwise
                    %annotation{:encoding => "application/x-tex"}
                      d(x,y) \coloneqq \left\{\array{
                      0 &amp; \text{if } x = y
                      \\\
                      1 &amp; \text{otherwise}
                      }\right.
              %p
                For certain purposes, it makes more sense to make most the non-zero distance
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                instead of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/normed+vector+space"} normed vector space
                is a metric space by
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mrow
                          %mo{:stretchy => "false"} ‖
                          %mi x
                          %mo −
                          %mi y
                          %mo{:stretchy => "false"} ‖
                      %annotation{:encoding => "application/x-tex"} d(x,y) \coloneqq {\|x - y\|}
            %li
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifold"} Riemannian manifold
                becomes a pseudometric space (or a metric space if, as is often assumed, the manifold is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
                %a.existingWikiWord{:href => "/nlab/show/infimum"} infimum
                of the Riemannian lengths of all continuously differentiable
                %a.existingWikiWord{:href => "/nlab/show/path"} paths
                connecting them:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msub
                        %mi inf
                        %mrow
                          %mi x
                          %mover
                            %mo →
                            %mi γ
                          %mi y
                      %mi len
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d(x,y) \coloneqq inf_{x \stackrel{\gamma}{\to} y} len(\gamma)
                      \.
              %p If the manifold might not be connected, then it still becomes an extended metric space.
          %h2#properties Properties
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lebesgue+number+lemma"} Lebesgue number lemma
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+metric+spaces+are+totally+bounded"} sequentially compact metric spaces are totally bounded
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sequentially+compact+metric+spaces+are+equivalently+compact+metric+spaces"} sequentially compact metric spaces are equivalently compact metric spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/countably+compact+metric+spaces+are+equivalently+compact+metric+spaces"} countably compact metric spaces are equivalently compact metric spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/metric+spaces+are+fully+normal"} metric spaces are fully normal
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/metric+spaces+are+paracompact"} metric spaces are paracompact
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/induced+metric"} induced metric
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/metric+jet"}> metric jet
                – a notion of “tangency” for maps of metric spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/complete+metric+space"} complete metric space
                and
                %a.existingWikiWord{:href => "/nlab/show/localic+completion"} localic completion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/separable+metric+space"} separable metric space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/distance+%28graph+theory%29"} distance (graph theory)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Booij+premetric+space"} Booij premetric space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richman+premetric+space"} Richman premetric space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+poset"} enriched poset
          %div
            %p
              %strong Generalized uniform structures
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/proarrow"} proarrow
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Rezk+completion"} Rezk-complete
                    version
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/pro-object"}> pro
                    \-monad
                  %th symmetric versions
                  %th
                  %th
                  %th
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/binary+relation"} binary relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/quasiuniformity"} quasiuniformity
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetric relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/equality"} equality
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/uniformity"} uniformity
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/binary+function"} binary function
                    to
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mn 0
                          %mo ,
                          %mn ∞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} [0,\infty)
                  %td{:style => "text-align: left;"}
