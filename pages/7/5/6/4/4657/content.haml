              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limits+commute+with+limits"} limits commute with limits
              %a.existingWikiWord{:href => "/nlab/show/ends"} ends
              commute with
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              , and finally the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+Yoneda+lemma"} enriched Yoneda lemma
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              \. The end result is hence the same
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              set that also the set of matching families is defined to be a subset of, in
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:SetOfMatching"} (4)
            %p
