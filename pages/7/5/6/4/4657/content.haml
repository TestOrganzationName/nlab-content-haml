          %h2#Definition Definition
          #CechGroupoid.num_defn
            %h6#definition_2 Definition
            %p
              %strong (Cech groupoid)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              of that site. For each
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mi i
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ U_i \overset{\iota_i}{\to} X\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in the given
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              is the
              %a.existingWikiWord{:href => "/nlab/show/presheaf+of+groupoids"} presheaf of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Grpd
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    C(\{U_i\})
                    \\;\in\;
                    [\mathcal{C}^{op}, Grpd]
                    \\;\simeq\;
                    Grpd\left( [\mathcal{C}^{op}, Set]  \right)
            %p
              which, regarded as an
              %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
              in the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              of
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Obj
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Obj_{C(\{U_i\})} \;\coloneqq\; \underset{i}{\coprod}  y(U_i)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} presheaves represented
              (under the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              over all
              %a.existingWikiWord{:href => "/nlab/show/fiber+products"} fiber products
              of these:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mor
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi y
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Mor_{C(\{U_i\})}
                    \\;\coloneqq\;
                    \\underset{i,j}{\coprod}  y(U_i) \times_{y(X)} y(U_j)
                    \\,.
            %p
              This means that for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} V \in \mathcal{C}
              the
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              assigned by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              has as set of objects
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              consisting of an index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi κ
                          %mi i
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V \overset{\kappa_i}{\to} U_i
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi κ
                      %mi i
                    %mo ⟶
                    %msub
                      %mi κ
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    \\kappa_i \longrightarrow \kappa_j
            %p precisely if
            #eq:CechMatchingCondition.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi i
                    %mo ∘
                    %msub
                      %mi κ
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mi j
                    %mo ∘
                    %msub
                      %mi κ
                      %mi j
                    %mphantom
                      %mi AAAAAAAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi V
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi κ
                                    %mi i
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi κ
                                    %mi j
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msub
                              %mi U
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi i
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi j
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_i \circ \kappa_i
                    \\;=\;
                    \\iota_j \circ \kappa_j
                    \\phantom{AAAAAAAA}
                    \\array{
                    \&amp;&amp; V
                    \\\
                    \&amp; {}^{\mathllap{\kappa_i}}\swarrow &amp;&amp; \searrow^{\mathrlap{\kappa_j}}
                    \\\
                    U_i &amp;&amp; &amp;&amp; U_j
                    \\\
                    \&amp; {}_{\mathllap{\iota_i}}\searrow &amp;&amp; \swarrow_{\mathrlap{\iota_j}}
                    \\\
                    \&amp;&amp; X
                    }
          %h2#properties Properties
          %h3#Codescent Codescent
          %p
            We discuss (Prop.
            %a.maruku-ref{:href => "#CechGroupoidCoRepresents"}
            below) how the Cech groupoid co-represents
            %em
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
            as they appear in the definition of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
          %p For reference, we first recall that definition:
          #CompatibleElements.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/matching+family"} matching family
                –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/descent+object"} descent object
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              equipped with a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              and consider a
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Set]
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              and a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msub
                          %mi U
                          %mi i
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ι
                              %mi i
                        %mi X
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \left\{ U_i \overset{\iota_i}{\to} X \right\}_{i \in I}
              of it we say that a
              %em
                %a.existingWikiWord{:href => "/nlab/show/matching+family"} matching family
              (of probes of
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi i
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} (\phi_i \in \mathbf{Y}(U_i))_{i \in I}
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i,j \in I
              and
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mover
                      %mo ←
                      %mrow
                        %msub
                          %mi κ
                          %mi i
                    %mi V
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi κ
                          %mi j
                    %msub
                      %mi U
                      %mi j
                  %annotation{:encoding => "application/x-tex"} U_i \overset{\kappa_i}{\leftarrow} V \overset{\kappa_j}{\to} U_j
              satisfying
            #eq:MatchingCondition.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi i
                    %mo ∘
                    %msub
                      %mi κ
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mi j
                    %mo ∘
                    %msub
                      %mi κ
                      %mi j
