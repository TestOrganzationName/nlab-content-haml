                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_i \circ \kappa_i
                    \\;=\;
                    \\iota_j \circ \kappa_j
                    \\phantom{AAAAAAAA}
                    \\array{
                    \&amp;&amp; V
                    \\\
                    \&amp; {}^{\mathllap{\kappa_i}}\swarrow &amp;&amp; \searrow^{\mathrlap{\kappa_j}}
                    \\\
                    U_i &amp;&amp; &amp;&amp; U_j
                    \\\
                    \&amp; {}_{\mathllap{\iota_i}}\searrow &amp;&amp; \swarrow_{\mathrlap{\iota_j}}
                    \\\
                    \&amp;&amp; X
                    }
            %p we have
            #eq:GluingCondition.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi κ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi κ
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϕ
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Y}(\kappa_i)(\phi_i)
                    \\;=\;
                    \\mathbf{Y}(\kappa_j)(\phi_j)
                    \\,.
            %p We write
            #eq:SetOfMatching.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Match
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⊂
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Match\big(
                    \\{U_i\}_{i \in I}
                    \\,,\,
                    \\mathbf{Y}
                    \\big)
                    \\subset
                    \\underset{i}{\prod} \mathbf{Y}(U_i)
                    \\;\in\;
                    Set
            %p
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
              for the given presheaf and covering.
            %p
              This is also called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/descent+object"} descent object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              for
              %em
                %a.existingWikiWord{:href => "/nlab/show/descent"} descent
              along the
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ι
                            %mi i
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \overset{\iota_i}{\to}X\}
          #CechGroupoidCoRepresents.num_example
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
                co-represents
                %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/codescent"} codescent
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              for
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
              = succeed "-structure," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Y} \in [\mathcal{C}^{op}, Set] \hookrightarrow [\mathcal{C}^{op}, Grpd]
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+presheaf"} enriched presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              be any
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ι
                          %mi i
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \{U_i \overset{\iota_i}{\to} X\}_i
              a
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family with induced
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\}_i)
              (Def.
              %a.maruku-ref{:href => "#CechGroupoid"}>
              ).
            %p
              Then there is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo (
                      %mi C
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mi i
                        %mo )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Match
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mi i
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op},Grpd]
                    \\left(
                    C\left(\{U_i\}_i\right), \, \mathbf{Y}
                    \\right)
                    \\;\simeq\;
                    Match\left( \{U_i\}_i, \, \mathbf{Y} \right)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-groupoid
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              %a.existingWikiWord{:href => "/nlab/show/enriched+presheaves"} enriched presheaves
              and the set of
              %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CompatibleElements"}
            %p
              Since therefore the Cech-groupoid co-represents the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/descent+object"} descent object
              %em
                %a.existingWikiWord{:href => "/nlab/show/codescent+object"} codescent object
              along the given covering.
            %p
              Moreover, under this identification the canonical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mi i
                      %mo )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} }
                              %mi i
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\left( \{U_i\}_i \right) \overset{p_{\{U_i\}_i}}{\longrightarrow} X
              induces the comparison morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %mi Grpd
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mo (
                              %mi X
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %mstyle{:mathvariant => "bold"}
                                %mi Y
                              %mo )
                          %mtd
                            %mo ≃
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msup
                                    %mi 𝒞
                                    %mi op
                                  %mo ,
                                  %mi Grpd
                                  %mo{:stretchy => "false"} ]
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi p
                                    %mrow
                                      %mo{:stretchy => "false"} {
                                      %msub
                                        %mi U
                                        %mi i
                                      %msub
                                        %mo{:stretchy => "false"} }
                                        %mi i
                                  %mo ,
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Y
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %mi Grpd
                            %mo{:stretchy => "false"} ]
                            %mrow
                              %mo (
                              %mi C
                              %mrow
                                %mo (
                                %mo{:stretchy => "false"} {
                                %msub
                                  %mi U
                                  %mi i
                                %msub
                                  %mo{:stretchy => "false"} }
                                  %mi i
                                %mo )
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %mstyle{:mathvariant => "bold"}
                                %mi Y
                              %mo )
                          %mtd
                            %mo ≃
                          %mtd
                            %mi Match
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %msub
                                %mo{:stretchy => "false"} }
                                %mi i
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %mstyle{:mathvariant => "bold"}
                                %mi Y
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [\mathcal{C}^{op}, Grpd]\left( X, \, \mathbf{Y} \right)
                    \&amp; \simeq &amp;
                    \\mathbf{Y}(X)
                    \\\
                    {}^{
                    \\mathllap{
                    [\mathcal{C}^{op}, Grpd](p_{\{U_i\}_i}, \mathbf{Y})
                    }
                    }\downarrow &amp;&amp; \downarrow
                    \\\
                    [\mathcal{C}^{op},Grpd]
                    \\left(
                    C\left(\{U_i\}_i\right), \, \mathbf{Y}
                    \\right)
                    \&amp;\simeq&amp;
                    Match\left( \{U_i\}_i, \, \mathbf{Y} \right)
                    }
                    \\,.
            %p
              In conclusion, this means that the
              %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              is a
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Sheaf"}
          .proof
            %h6#proof Proof
            %p
              The hom-groupoid is computed as the
              %a.existingWikiWord{:href => "/nlab/show/end"} end
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Grpd
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo (
                      %mi C
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mi i
                        %mo )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mrow
                        %mi V
                        %mo ∈
                        %mi 𝒞
                    %mrow
                      %mo [
                      %mi C
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mi i
                        %mo )
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op},Grpd]
                    \\left(
                    C\left(\{U_i\}_i\right), \, \mathbf{Y}
                    \\right)
                    \\;=\;
                    \\int_{V \in \mathcal{C}}
                    \\left[
                    C\left(\{U_i\}_i\right)(V), \, \mathbf{Y}(V)
                    \\right]
                    \\,,
            %p
              where the “integrand” is the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              (here: a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
              at a given
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              to the set (regarded as a groupoid) assigned by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}(V)
              is just a set, that functor groupoid, too, is just a set, regarded as a groupoid. Its elements are the
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} }
                          %mi i
                        %mo )
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C\left(\{U_i\}_i\right)(V) \longrightarrow \mathbf{Y}(V)
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              on sets of objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Obj
                      %mrow
                        %mi C
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %msub
                            %mo{:stretchy => "false"} }
                            %mi i
                          %mo )
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Obj
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i}{\coprod} y(U_i)(V)
                    \=
                    Obj_{C\left(\{U_i\}_i\right)(V)}
                    \\longrightarrow
                    Obj_{\mathbf{Y}(V)}
                    \=
                    \\mathbf{Y}(V)
            %p
              which respect the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              induced by the morphisms in the Cech groupoid at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              Hence the hom-groupoid is a subset of the
              %a.existingWikiWord{:href => "/nlab/show/end"} end
              of these
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/function+sets"} function sets
            .maruku-equation
