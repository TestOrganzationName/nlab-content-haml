                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{g_f\colon X \to A\}_{f\in Mor(C)}
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
