              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              consists of monomorphisms.
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} m\colon A\to B
              be in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mi r
                    %mo =
                    %mi m
                    %mi s
                  %annotation{:encoding => "application/x-tex"} m r = m s
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ,
                      %mi s
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} r,s\colon X\to A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ≠
                      %mi s
                    %annotation{:encoding => "application/x-tex"} r\neq s
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi m
                    %mi r
                    %mo :
                    %mi X
                    %mo →
                    %mi B
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi f
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{m r: X \to B \}_{f\in Mor(C)}
              consisting of one copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mi r
                  %annotation{:encoding => "application/x-tex"} m r
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo =
                    %mi m
                    %mi s
                  %annotation{:encoding => "application/x-tex"} = m s
              ) for each arrow of the ambient category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "-sink" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi e
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi f
                        %mo ∈
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \{e_f\colon X \to Y\}_{f\in Mor(C)}
              followed by an
              = succeed "-morphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Y
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} n\colon Y\to B
            %p
              Now there are at least
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Mor
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} 2^{|Mor(C)|}
              different sinks
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} }
