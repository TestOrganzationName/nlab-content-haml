          %h2#idea Idea
          %p
            A
            %em factorization structure
            is a strengthening of an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
            which allows us to factor, not only single
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            %a.existingWikiWord{:href => "/nlab/show/sinks"} sinks
            (or cosinks).
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi e
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi X
                    %mi i
                  %mo →
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{e_i \colon X_i \to Y\}_{i\in I}
            be a
            %a.existingWikiWord{:href => "/nlab/show/sink"} sink
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} m\colon A \to B
            a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            in some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi e
                    %mi i
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{e_i\}
            is
            %em orthogonal
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            if for any sink
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi f
                    %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi X
                    %mi i
                  %mo →
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{f_i \colon X_i \to A\}_{i\in I}
            and morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Y
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} g\colon Y\to B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %msub
                    %mi f
                    %mi i
                  %mo =
                  %mi g
                  %msub
                    %mi e
                    %mi i
                %annotation{:encoding => "application/x-tex"} m f_i = g e_i
            for all
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i\in I
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mi i
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi f
                                %mi i
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mrow
                              %msub
                                %mi e
                                %mi i
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
