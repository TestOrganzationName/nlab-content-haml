          %h2#idea Idea
          %p
            The generalization of the
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            %em
              %a.existingWikiWord{:href => "/nlab/show/Span"} Span
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories"} (∞,n)-categories
          %p
            An
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
              \-category of correspondences
            in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            is an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            whose
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
                s
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to Y
                are
                %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Z
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; Z
                      \\\
                      \&amp; \swarrow &amp;&amp; \searrow
                      \\\
                      X &amp;&amp;&amp;&amp; Y
                      }
              %p
                in
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                are correspondences of correspondences
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Z
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                              %mi Q
                            %mtd
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                            %mtd
                              %mo ↖
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo ↗
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Z
                              %mo ′
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; Z
                      \\\
                      \&amp; \swarrow &amp;\uparrow&amp; \searrow
                      \\\
                      X &amp;&amp;Q&amp;&amp; Y
                      \\\
                      \&amp; \nwarrow &amp;\downarrow&amp; \nearrow
                      \\\
                      \&amp;&amp; Z'
                      }
              %p
                (where the triangular sub-
                %a.existingWikiWord{:href => "/nlab/show/diagram"}> diagram
                s are filled with
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                which we do not display here)
            %li
              %p
                and so on up to
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/k-morphism"} n-morphism
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \gt n
                \-morphisms are equivalences of order
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo −
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (k-n)
                of higher correspondences.
          %p
            Using the symmetric monoidal structure on
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            this becomes a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
          %p
            More generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            some
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/object"}> object
                s are
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                equipped with an
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-functor"} (∞,n)-functor
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} X \to C
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphism"}> morphism
                s
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \to Y
                are
                %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
                in
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Z
                          %mtr
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                              %mo ⇙
                            %mtd
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                            %mtd
                            %mtd
                              %mo ↙
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi C
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; Z
                      \\\
                      \&amp; \swarrow &amp;&amp; \searrow
                      \\\
                      X &amp;&amp;\swArrow&amp;&amp; Y
                      \\\
                      \&amp; \searrow &amp;&amp; \swarrow
                      \\\
                      \&amp;&amp; C
                      }
            %li
              %p and so on.
          %p
            Even more generally one can allow the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                  %mo ,
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"} X, Y, \cdots
            to be
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-categories"} (∞,n)-categories
            themselves.
          %h2#Definition Definition
          %h3#direct_definition Direct definition
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-category"} (∞,2)-category
            of correspondences in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            is discussed in some detail in (
            %a{:href => "#DyckerhoffKapranov12"}> Dyckerhoff-Kapranov 12, section 10
            ). A sketch of the definition for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            was given in (
            %a{:href => "#Lurie"}> Lurie, page 57
            ). A fully detailed version of this definition is in (
            %a{:href => "#Haugseng14"}> Haugseng 14
            ).
          %h3#DefinitionViaCoalgebras Definition via coalgebras
          %p
            In (
            %a{:href => "#BenZviNadler13"}> BenZvi-Nadler 13, remark 2.9
            ) it is observed that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi E
                    %mi n
                  %msub
                    %mi Alg
                    %mi b
                  %mo{:stretchy => "false"} (
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Corr_n(\mathbf{H}) \simeq E_n Alg_b(\mathbf{H}^{op})
          %p
            is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/En-algebras"} En-algebras
            and
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-bimodules"} (∞,1)-bimodules
            between them in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+%28%E2%88%9E%2C1%29-category"} opposite (∞,1)-category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            (since every object in a cartesian category is uniquely a
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            by its
            %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
            map).
          %p
            (This immediately implies that every object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Corr
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Corr_n(\mathbf{H})
            is a self-
            %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"}> fully dualizable object
            \.)
          %p
            To see how this works, consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            any object regarded as a coalgebra in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            via its
            %a.existingWikiWord{:href => "/nlab/show/diagonal+map"} diagonal map
            (
            %a{:href => "cartesian+monoidal+infinity%2C1-category#CoalgebraObjects"}> here
            ). Then a
            %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            over it is a
            %a.existingWikiWord{:href => "/nlab/show/co-action"} co-action
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi E
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  E \to E \times X
          %p
            and hence is canonically given by just a map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
          %p Then for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi E
                            %mn 1
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi E
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Z
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; E_1 &amp;&amp;&amp;&amp; E_2
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  X &amp;&amp; &amp;&amp; Y &amp;&amp; &amp;&amp; Z
                  }
          %p
            two consecutive correspondences, now interpreted as two bi-comodules, their
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of comodules over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            as a coalgebra is the limit over
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 1
                  %mo ×
                  %msub
                    %mi E
                    %mn 2
                  %mover
                    %mo →
                    %mo →
                  %msub
                    %mi E
                    %mn 1
                  %mo ×
                  %mi Y
                  %mo ×
                  %msub
                    %mi E
                    %mn 2
                  %mover
                    %mover
                      %mo →
                      %mo →
                    %mo →
                  %mo .
                  %mo .
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  E_1 \times E_2
                  \\stackrel{\to}{\to}
                  E_1 \times Y \times E_2
                  \\stackrel{\to}{\stackrel{\to}{\to}}
                  \...
          %p This is indeed the fiber product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mn 1
                  %munder
                    %mo ×
                    %mi Y
                  %msub
                    %mi E
                    %mn 2
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mn 1
                      %mo ,
                      %msub
                        %mi p
                        %mn 2
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi E
                    %mn 1
                  %mo ×
                  %msub
                    %mi E
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  E_1 \underset{Y}{\times} E_2 \stackrel{(p_1, p_2)}{\to} E_1 \times E_2
          %p
            as it should be for the composition of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/correspondences"} correspondences
          %h3#PhasedTensorProduct With the phased tensor product
          #InSliceWithPhasedTensorProduct.num_defn
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ∈
                    %msub
                      %mi Cat
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mi n
