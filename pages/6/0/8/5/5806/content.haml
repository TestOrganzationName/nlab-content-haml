          %h2#Properties Properties
          %h3#FullDualizability Full dualizability
          #CorrnGrpdHasDuals.num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Corr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Corr_n(\infty Grpd)
              is a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+with+duals"} (∞,n)-category with duals
            %p
              More generally, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a symmetric monoidal
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Corr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo ,
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} Corr_n(\infty Grpd,\mathcal{C})^\otimes
              equipped with the phased tensor product of prop.
              = succeed "." do
                %a.maruku-ref{:href => "#InSliceWithPhasedTensorProduct"}
            %p
              In particular every object in these is a
              = succeed "." do
