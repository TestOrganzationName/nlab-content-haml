              equipped with the phased tensor product of prop.
              %a.maruku-ref{:href => "#InSliceWithPhasedTensorProduct"}
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+with+duals"} (∞,n)-category with duals
          %p
            (
            %a{:href => "#Haugseng14"}> Haugseng 14, cor. 7.8
            )
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Bord
                    %mi n
                %annotation{:encoding => "application/x-tex"} Bord_n
            be the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+of+cobordisms"} (∞,n)-category of cobordisms
          #HomsFromBordIntoSpan.num_prop
            %h6#claim Claim
            %p The following data are equivalent
            %ol
              %li
                %p
                  Symmetric monoidal
                  = succeed "-functors" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,n)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Bord
                          %mi n
                        %mo →
                        %msub
                          %mi Corr
                          %mi n
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mi Grpd
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        Bord_n \to Corr_n(\infty Grpd)
              %li
                %p
                  Pairs
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X,V)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} V \to X
                  a
                  %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                  of
                  %a.existingWikiWord{:href => "/nlab/show/rank"} rank
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
