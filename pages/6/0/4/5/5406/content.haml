            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a local ring with
              %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal ideal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi m
                  %annotation{:encoding => "application/x-tex"} k = R/m
              be the residue class
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} f \in R[x]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo ∈
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \bar{f} \in k[x]
              obtained by
              %a.existingWikiWord{:href => "/nlab/show/reduction+mod+p"} reduction
              of the coefficients of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              modulo
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is
              %em Henselian
              if, for any
              %a.existingWikiWord{:href => "/nlab/show/monic+polynomial"} monic
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} f \in R[x]
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                  %annotation{:encoding => "application/x-tex"} \bar{f}
              factorizes as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mi h
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} g_0 h_0
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 0
                    %mo ,
                    %msub
                      %mi h
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} g_0, h_0
              monic and relatively prime in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} k[x]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ,
                    %mi h
                    %mo ∈
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} g, h \in R[x]
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi g
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f = g h
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ¯
                      %mo =
                      %msub
                        %mi g
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \bar{g} = g_0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi h
                        %mo{:stretchy => "false"} ¯
                      %mo =
                      %msub
                        %mi h
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \bar{h} = h_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g, h)
              is the unit ideal in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[x]
          %p
            Often this definition is given just for the case when one of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} g_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mn 0
                %annotation{:encoding => "application/x-tex"} h_0
            is a linear factor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi a
                  %annotation{:encoding => "application/x-tex"} x - a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            can be lifted to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .num_defn
            %h6#definition_3 Definition
            %p
              A Henselian ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              with residue class field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is
              %em strictly Henselian
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is separably closed.
          %h2#examples Examples
          %ul
            %li
              %p
                Any field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                is trivially Henselian.
            %li
              %p
                A complete local ring, such as
                %a.existingWikiWord{:href => "/nlab/show/p-adic+number"} p-adic number
                rings, is Henselian. This includes rings of formal power series over a field,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} k[ [x_1, \ldots, x_n] ]
            %li
              %p
                Rings of convergent power series over a
                %a.existingWikiWord{:href => "/nlab/show/local+field"} local field
                are Henselian.
          %h2#properties Properties
          .num_prop
            %h6#proposition Proposition
            %p The quotient of a Henselian ring is also Henselian.
          .proof
            %h6#proof Proof
            %p
              In the first place, a quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R'
              of a local ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is local (and has the same residue class field
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} R'
              is clearly Henselian since we can lift factorizations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo =
                    %msub
                      %mi g
                      %mn 0
                    %msub
                      %mi h
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \bar{f} = g_0 h_0
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k[x]
              to factorizations in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[x]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ′
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R'[x]
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is local and its reduced ring (i.e.,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              modulo its ideal of nilpotent elements) is Henselian, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              itself is Henselian.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is Henselian and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a local ring that is integral over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              (meaning that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} x \in S
              is an
              %a.existingWikiWord{:href => "/nlab/show/integral+closure"} integral element
              over
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is Henselian.
          %h2#henselization Henselization
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LocRing
                %annotation{:encoding => "application/x-tex"} LocRing
            denote the category of local rings (commutative of course) and local ring homomorphisms (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi R
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} f: R \to S
            is
            %em local
            if the pullback along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            of the maximal ideal of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the maximal ideal of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .num_theorem
            %h6#theorem Theorem
            %p
              The full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocRing
                  %annotation{:encoding => "application/x-tex"} LocRing
              consisting of Henselian rings is reflective. The left adjoint to the full inclusion is called
              = succeed "." do
                %em Henselization
          .num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/valuation+ring"} discrete valuation ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              its field of fractions. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{R}
              be the
              = succeed "-adic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              with respect to its maximal ideal. Then the Henselization of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is isomorphic to the subring of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi R
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{R}
              whose elements are roots of separable polynomials with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
          %p A rule of thumb, as suggested by this example, is that the Henselization is the algebraic part of a local ring completion.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/restricted+formal+power+series"} restricted formal power series
            %li
              %a.existingWikiWord{:href => "/nlab/show/Henselian+pair"} Henselian pair
          %h2#references References
          %p An original reference is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexandre+Grothendieck"}> Alexandre Grothendieck
              , (1967),
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/EGA"} EGA
              %em Étude locale des schémas et des morphismes de schémas
              , Quatrième partie“, Publications Mathématiques de l’IHÉS 32: 5–361. (
              %a{:href => "http://www.numdam.org/numdam-bin/feuilleter?id=PMIHES_1967__32_"}> web
              )
          %p Lecture notes are in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/James+Milne"}> James Milne
              , section 4 of
              %em
                %a.existingWikiWord{:href => "/nlab/show/Lectures+on+%C3%89tale+Cohomology"} Lectures on Étale Cohomology
          %p Other sources include
          %ul
            %li
              %p
                Michel Raynaud,
                = succeed "," do
                  %em Anneaux locaux henséliens
                %strong 169
                1970 doi:
                %a{:href => "https://dx.doi.org/10.1007/BFb0069571"} 10.1007/BFb0069571
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Descent+Theorems"} Descent Theorems
            %li
              %p
                Alonso, Lombardi, Perdry,
                %em Henselian local rings
                (
                %a{:href => "http://drops.dagstuhl.de/volltexte/2006/437/pdf/05021.PerdryHerve.Paper.437.pdf"}> pdf
                )
            %li
              %p
                Krzysztof Jan Nowak,
                %em Remarks on Henselian rings
                (
                %a{:href => "http://www.emis.de/journals/UIAM/PDF/46-79-85.pdf"}> pdf
                );
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
                ,
                %em Rings of smooth functions and their localizations
                (
                %a{:href => "http://nlab.mathforge.org/nlab/files/RingsOfSmoothFunctionsI.pdf"}> pdf
                )
