            %li
              %p
                S. Ferrara and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+van+Nieuwenhuizen"} Peter van Nieuwenhuizen
          %p and the “new minimal” supergravity
          %ul
            %li
              %p
                V. Akulov,
                %a.existingWikiWord{:href => "/nlab/show/Dmitry+Volkov"} Dmitry Volkov
                and V. Soroka,
                = succeed "," do
                  %em Generally covariant theories of gauge fields on superspace
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF01041233"} doi:10.1007/BF01041233
            %li
