            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo =
                  %mn 4
                %annotation{:encoding => "application/x-tex"} d = 4
            supergravity
          %p There are two different off-shell formulations, the “old minimal”
          %ul
