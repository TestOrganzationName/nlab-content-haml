          %title Contents
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#as_classifying_ring_for_formal_group_laws"} As classifying ring for formal group laws
                %li
                  %a{:href => "#lazards_theorem"} Lazard’s theorem
                %li
                  %a{:href => "#as_the_complex_cobordism_cohomology_ring"} As the complex cobordism cohomology ring
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em Lazard ring
            is a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            which is
          %ul
            %li
              the universal
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              for commutative 1-dimensional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+group+laws"} formal group laws
          %p
            and by
            %a.existingWikiWord{:href => "/nlab/show/Quillen%27s+theorem+on+MU"} Quillen's theorem
            also
          %ul
            %li
              the
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              that the
              %a.existingWikiWord{:href => "/nlab/show/complex+cobordism+cohomology+theory"} complex cobordism cohomology theory
              assigns to the point.
          %h2#definition Definition
          %p
            The
            %em Lazard ring
            may be presented by generators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mi j
                %annotation{:encoding => "application/x-tex"} a_{i j}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ,
                  %mi j
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} i,j \in \mathbb{N}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mi j
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi relations
                  %mspace{:width => "thickmathspace"}
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mi below
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  L = \mathbb{Z}[a_{i j}] / (relations\;1,2,3\;below)
          %p and relations as follows
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mrow
                          %mi i
                          %mi j
                      %mo =
                      %msub
                        %mi a
                        %mrow
                          %mi j
                          %mi i
                    %annotation{:encoding => "application/x-tex"} a_{i j} = a_{j i}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mn 10
                      %mo =
                      %msub
                        %mi a
                        %mn 01
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} a_{10} = a_{01} = 1
                ;
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi i
                      %mo ≠
                      %mn 1
                      %mo :
                      %msub
                        %mi a
                        %mrow
                          %mi i
                          %mn 0
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \forall i \neq 1: a_{i 0} = 0
            %li
              %p
                the obvious associativity relations imposed by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \ell(x, \ell(y, z)) = \ell(\ell(x, y), z)
          %p where we write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                  %msub
                    %mi a
                    %mrow
                      %mi i
                      %mi j
                  %msup
                    %mi x
                    %mi i
                  %msup
                    %mi y
                    %mi j
                  %mo ∈
                  %mi L
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\ell(x,y) = \sum_{i,j} a_{i j} x^i y^j \in L[[x,y]].
          %p
            In other words,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \ell(x, y)
            becomes the universal 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            as a formal power series in two variables with coefficients in the Lazard ring, Theorem
            %a.maruku-ref{:href => "#walking"}
            below.
          %h2#properties Properties
          %h3#as_classifying_ring_for_formal_group_laws As classifying ring for formal group laws
          #walking.num_theorem
            %h6#theorem Theorem
            %p
              For any
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              with
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} g(x,y) \in S[ [x,y] ]
              there is a unique ring
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} L \to S
              that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
          %p
            review includes (
            %a{:href => "#Hopkins99"}> Hopkins 99, theorem 2.3, theorem 2.5
            )
          .num_remark
            %h6#remark Remark
            %p
              Passing to
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+commutative+ring"} ring spectra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(L)
              is something like the
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              for formal groups. By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen%27s+theorem+on+MU"} Quillen's theorem on MU
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              to
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              and the
              %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring+spectrum"} E-infinity ring spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi MU
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(MU)
              is something like the derived moduli stack for formal group laws.
          %h3#lazards_theorem Lazard’s theorem
          %p
            %a.existingWikiWord{:href => "/nlab/show/Lazard%27s+theorem"} Lazard's theorem
            states:
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The Lazard ring is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/graded+ring"} graded
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    L \simeq \mathbb{Z}[t_1, t_2, \cdots]
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/variable"} variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi i
                  %annotation{:encoding => "application/x-tex"} t_i
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi i
                    %annotation{:encoding => "application/x-tex"} 2 i
          %p
            review includes (
            %a{:href => "#Hopkins99"}> Hopkins 99, theorem 2.5
            ,
            = succeed ")" do
              %a{:href => "#LurieLect2"} Lurie 10, lect 2, theorem 4
          %h3#as_the_complex_cobordism_cohomology_ring As the complex cobordism cohomology ring
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/Quillen%27s+theorem+on+MU"} Quillen's theorem on MU
            the Lazard ring is the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+cobordism+cohomology+theory"} complex cobordism cohomology theory
          .num_theorem
            %h6#theorem_3 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi P
                  %annotation{:encoding => "application/x-tex"} M P
              denote the peridodic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+cobordism+cohomology+theory"} complex cobordism cohomology theory
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M P(*)
              over the point together with its
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
              is naturally isomorphic to the universal Lazard ring with its formal group law
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ,
                      %mi ℓ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L,\ell)
          .num_remark
            %h6#remark_2 Remark
            %p
              This can be used to make a cohomology theory out of a
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R,f(x,y))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} M P({*}) \to R
              to build the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi M
                    %msup
                      %mi P
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi M
                        %mi P
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo{:stretchy => "false"} )
                    %mi R
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E^n(X) := M P^n(X) \otimes_{M P({*})} R,
            %p
              for any
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n\in\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              built this way will be left exact if the ring morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} M P({*}) \to R
              is a flat morphism. This is the
              %a.existingWikiWord{:href => "/nlab/show/Landweber+exactness"} Landweber exactness
              condition (or maybe slightly stronger). See at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Landweber+exact+functor+theorem"} Landweber exact functor theorem
          %h2#related_entries Related entries
          %ul
            %li
              %p
                for some context see
                %em
                  %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology+-+cohomology+theories"} A Survey of Elliptic Cohomology - cohomology theories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Landweber+exact+functor+theorem"} Landweber exact functor theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lazard%27s+theorem"} Lazard's theorem
          %h2#references References
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michel+Lazard"}> Michel Lazard
                ,
                = succeed "," do
                  %em Sur les groupes de Lie Formels à un Paramètre
                %strong 83
                (1955) &amp;lbrack;
                %a{:href => "http://www.numdam.org/item/?id=BSMF_1955__83__251_0"}> numdam:BSMF_1955__83__251_0
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
                ,
                = succeed "," do
                  %em On the formal group laws of unoriented and complex cobordism theory
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.bams/1183530915"} Euclid
            %li#Adams74
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Adams"}> John Adams
                , part II.5 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Stable+homotopy+and+generalised+homology"}> Stable homotopy and generalised homology
                  , University of Chicago Press, Chicago, Ill., 1974, Chicago Lectures in Mathematics.
            %li#Kochmann96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochmann"}> Stanley Kochmann
                , section 4.4 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#Hopkins99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Hopkins"}> Mike Hopkins
                ,
                = succeed "," do
                  %em Complex oriented cohomology theories and the language of stacks
                = succeed ")" do
                  %a{:href => "http://www.math.rochester.edu/u/faculty/doug/otherpapers/coctalos.pdf"} pdf
            %li#LurieLect2
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Chromatic+Homotopy+Theory"} Chromatic Homotopy Theory
                %em Lazard’s theorem
                (
                %a{:href => "http://www.math.harvard.edu/~lurie/252xnotes/Lecture2.pdf"}> pdf
                )
