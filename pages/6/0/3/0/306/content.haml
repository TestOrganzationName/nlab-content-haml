                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the class of all
              %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is just a
              = succeed "." do
                %strong subobject classifier
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the class of all
              %a.existingWikiWord{:href => "/nlab/show/extremal+monomorphisms"} extremal monomorphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is an
              = succeed "." do
                %strong extremal subobject classifier
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the class of all
              %a.existingWikiWord{:href => "/nlab/show/strong+monomorphisms"} strong monomorphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is a
              = succeed "." do
                %strong strong subobject classifier
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the class of all
              %a.existingWikiWord{:href => "/nlab/show/regular+monomorphisms"} regular monomorphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is a
              = succeed "." do
                %strong regular subobject classifier
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the class of all
              %a.existingWikiWord{:href => "/nlab/show/effective+monomorphisms"} effective monomorphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is an
              = succeed "." do
                %strong effective subobject classifier
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the class of all
              %a.existingWikiWord{:href => "/nlab/show/strict+monomorphisms"} strict monomorphisms
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is a
              = succeed "." do
                %strong strict subobject classifier
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the class of all
              = succeed "-compact" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
              is a
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  \-compact subobject classifier
          %p
            Strong subobject classifiers in particular are important in the definition of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi κ
                %annotation{:encoding => "application/x-tex"} \kappa
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/inaccessible+cardinal"} inaccessible cardinal
            = succeed "-compact" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
            %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+type+theories"} Martin-Löf type theories
            like
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/book+HoTT"} book HoTT
          %h3#object_classifier Object classifier
          %p
            In higher topoi the subobject classifiers are the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} universal fibrations
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-topos"} (n+1,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} n Grpd
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} (n,0) Cat
            of
            %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} (n,0)-categories
            the subobject classifier is the
            %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} forgetful functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi true
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msub
                    %mi Cat
                    %mo *
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  (n,1) true : (n-1,0)Cat_* \to (n-1,0)Cat
          %p
            from the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,1)
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1,0)
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1,0)
          %p
            This is described in more detail at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+universal+bundle"} generalized universal bundle
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} stuff, structure, property
          %p
            In fact, using the notion of
            %a.existingWikiWord{:href => "/nlab/show/%28-1%29-category"} (-1,0)-category
            the subobject classifier in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            does fit precisely into this pattern:
          %p
            the set of truth values
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            may be regarded as the
            %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-category"} (0,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/%28-1%29-category"} (-1,0)-categories
            (of which there are two) and the one-element set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            is the
            %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-category"} (0,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28-1%29-category"} (-1,0)-categories
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} theory
            subobject classifiers are discussed in section 6.1.6 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
              , Princeton UP 2009.
          %p
            Whereas for 1-toposes the
            %em subobject classifier
            is the key structural ingredient (besides the exactness properties), in
            %a.existingWikiWord{:href => "/nlab/show/higher+topos+theory"} higher topos theory
            this role is taken over by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/object+classifier"} object classifier
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+interval"} Lawvere interval
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
                where a weaker notion of subobject classifier only classifies
                = succeed "s." do
                  %a.existingWikiWord{:href => "/nlab/show/strong+monomorphism"} strong monomorphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/discrete+object+classifier"} discrete object classifier
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28sub%29object+classifier+in+an+%28infinity%2C1%29-topos"} (sub)object classifier in an (infinity,1)-topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"}> type of propositions
                ,
                %a.existingWikiWord{:href => "/nlab/show/type+of+types"} type of types
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"}> classifying space
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/classifying+stack"} classifying stack
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
                %a.existingWikiWord{:href => "/nlab/show/derived+moduli+space"} derived moduli space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"}> universal principal bundle
                ,
                %a.existingWikiWord{:href => "/nlab/show/universal+principal+%E2%88%9E-bundle"} universal principal ∞-bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/classifying+morphism"} classifying morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sufficiently+cohesive+topos"} sufficiently cohesive topos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/localic+topos"} localic topos
          %h2#references References
          %p The concept was introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
              ,
              = succeed "," do
                %em Quantifiers and sheaves
              %strong 1
              (1970) 329-334 &amp;lbrack;
              %a{:href => "https://raw.githubusercontent.com/mattearnshaw/lawvere/master/pdfs/1970-quantifiers-and-sheaves.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Lawvere-QuantifiersAndSheaves.pdf", :title => "pdf"} pdf
          %p Discussion of the concept can be found in the usual suspects
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                  3
                , Cambridge UP 1994.
            %li#Goldblatt84
              %p
                R. Goldblatt,
                = succeed "," do
                  %em Topoi - The Categorical Analysis of Logic
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.bia/1403013939"} project euclid
            %li#J77
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                %em Topos Theory
                , Academic Press New York 1977.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
                  I
                , Oxford UP 2002.
            %li#MacLaneMoerdijk
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
                , Springer Heidelberg 1994. (section I.3-4)
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                ,
                %em
                  When is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                      %annotation{:encoding => "application/x-tex"} \Omega
                  a cogenerator in a topos ?
                , Cah. Top. Géom. Diff. Cat.
                %strong XVI
                no.1 (1975) pp.3-15. (
                %a{:href => "http://www.numdam.org/item?id=CTGDC_1975__16_1_3_0"}> numdam
                )
            %li
              %p
                Chang Ku Im,
                %em On elementary toposes
                , Bull. Korean Math. Soc.
                = succeed "," do
                  %strong 16
                = succeed ")" do
                  %a{:href => "https://koreascience.kr/article/JAKO198021167807333.pdf"} pdf
          %p For sheaves
          %ul
            %li#Caramello
              %a.existingWikiWord{:href => "/nlab/show/Olivia+Caramello"}> Olivia Caramello
              ,
              = succeed "," do
                %em Topos Theory: Lectures 7-14: Sheaves on a site
              %a{:href => "https://www.oliviacaramello.com/Teaching/Lectures7_to_14.pdf"} slides
          %p The existence of subobject classifiers in categories of algebras is considered in
          %ul
            %li#JT90
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              %em Collapsed Toposes and Cartesian Closed Varieties
              , JA
              %strong 129
              (1990) pp.446-480.
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  For
                  %strong M
                  the class of strong monomorphisms, this is called a
                  %em weak subobject classifier
                  in Johnstone (2002, p.120).
                  %a{:href => "#fnref:1", :rev => "footnote"} ↩
              %li#fn:2
                %p
                  We mean a nontrivial category, obviously, where “trivial” here means every object is terminal.
                  %a{:href => "#fnref:2", :rev => "footnote"} ↩
