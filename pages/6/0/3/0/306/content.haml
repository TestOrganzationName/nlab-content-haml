                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mn 1
                        %mo ∧
                        %mi Δ
                        %mo =
                        %mo ⊥
                        %mo =
                        %msub
                          %mi i
                          %mn 2
                        %mo ∧
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} i_1 \wedge \Delta = \bot = i_2 \wedge \Delta
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo =
                      %mi Δ
                      %mo ∧
                      %mo ⊤
                      %mo =
                      %mi Δ
                      %mo ∧
