                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo ⊣
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Delta\dashv \Gamma
            assigning to an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            the set of it connected components. We call
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/connected+object"} connected
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            is a
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            and
            %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X^Y)
            is connected for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} Y\in\mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                %annotation{:encoding => "application/x-tex"} \Pi
            preserves
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is contractible iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is connected which in turn implies the same for all other
            %a.existingWikiWord{:href => "/nlab/show/injective+object"} injective objects
            (see at
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/sufficiently+cohesive+topos"} sufficiently cohesive topos
          %p
            Now the subobject classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            has always two disjoint points
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
