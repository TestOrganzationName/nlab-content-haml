          %h3#johnstones_exercise Johnstone’s exercise
          %p
            A curiosity from Johnstone’s
            = succeed "," do
              %a{:href => "#J77"} Topos Theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
