          #OnRegularObservablesPerturbativeSMatrix.num_defn
            %h6#definition Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/perturbative+S-matrix"} perturbative S-matrix
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/perturbative+S-matrix"} perturbative S-matrix
              on
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
              is the
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℏ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}
                    \\;\colon\;
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
                    \\longrightarrow
                    PolyObs(E_{\text{BV-BRST}})_{reg}((\hbar))
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi exp
                      %mrow
                        %msub
                          %mo ⋆
                          %mi F
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi i
                            %mi ℏ
                      %msub
                        %mi S
                        %mi int
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ≔
                    %mn 1
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} i
                          %mi ℏ
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mi ℏ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                    %msub
                      %mi S
                      %mi int
                    %msub
                      %mo ⋆
                      %mi F
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(S_{int})
                    \=
                    \\exp_{\star_F}
                    \\left(
                    \\tfrac{1}{i \hbar} S_{int})
                    \\right)
                    \\coloneqq
                    1
                    +
                    \\tfrac{1}{\i \hbar} S_{int}
                    +
                    \\tfrac{1}{2}
                    \\tfrac{1}{(i \hbar)^2}
                    S_{int} \star_F S_{int}
                    +
                    \\cdots
                    \\,.
            %p
              We think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi int
                  %annotation{:encoding => "application/x-tex"} S_{int}
              here as an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              non-point-
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              We write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}(S_{int})^{-1}
              for the
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              with respect to the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick product
              (which exists by
              = succeed ")" do
                %a{:href => "S-matrix#PerturbativeSMatrixInverse"} this remark
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(S_{int})^{-1} \star_H \mathcal{S}(S_{int})
                    \=
                    1
                    \\,.
            %p
              Notice that this is in general different form the inverse with respect to the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⋆
                        %mi F
                    %annotation{:encoding => "application/x-tex"} \star_F
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi S
                        %mi int
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}(-S_{int})
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⋆
                      %mi F
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(-S_{int})
                    \\star_F
                    \\mathcal{S}(S_{int})
                    \=
                    1
                    \\,.
