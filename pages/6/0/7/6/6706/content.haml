                  %annotation{:encoding => "application/x-tex"}
                    \\{-S',(-)\} \circ \mathcal{R}^{-1}
                    \\;=\;
                    \-
                    \\mathcal{R}^{-1}
                    \\left(
                    \\left\{ S' + S_{int} \,,\, (-) \right\}
                    \\right)
                    \\,.
            %p
              Applied to an observable which is linear in the
              %a.existingWikiWord{:href => "/nlab/show/antifields"} antifields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∫
                      %mi Σ
                    %msup
