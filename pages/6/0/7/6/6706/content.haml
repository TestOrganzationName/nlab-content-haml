                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\{-S',-\}
                    \\;\colon\;
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
                    \\longrightarrow
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              also with respect to the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⋆
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \star_H
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi S
                      %mo ′
                      %mo ,
                      %msub
                        %mi A
                        %mn 1
                      %msub
                        %mo ⋆
                        %mi H
                      %msub
                        %mi A
                        %mn 2
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
