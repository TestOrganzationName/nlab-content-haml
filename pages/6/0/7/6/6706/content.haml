          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            formulated in terms of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
            %em classical master equation
            expresses the nilpotency of the
            %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
            before
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            with respect to the
            %em
              %a.existingWikiWord{:href => "/nlab/show/antibracket"} antibracket
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{-,-\}
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi S
                  %mo +
                  %msub
                    %mi S
                    %mi BRST
                %annotation{:encoding => "application/x-tex"} S + S_{BRST}
            ”:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                      %mo (
                      %msub
                        %mi s
                        %mi BV
                      %mo )
                    %mn 2
                  %mo =
                  %mn 0
                  %mphantom
                    %mi AA
                  %mo ⇔
                  %mphantom
                    %mi AA
                  %msup
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} {
                      %mi S
                      %mo +
                      %msub
                        %mi S
                        %mi BRST
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mn 2
                  %mo =
                  %mn 0
                  %mphantom
                    %mi AA
                  %mo ⇔
                  %mphantom
                    %mi AA
                  %mo{:stretchy => "false"} {
                  %mi S
                  %mo +
                  %msub
                    %mi S
                    %mi BRST
                  %mo ,
                  %mi S
                  %mo +
                  %msub
                    %mi S
                    %mi BRST
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  s_{BV}
                  \\right)^2 = 0
                  \\phantom{AA}
                  \\Leftrightarrow
                  \\phantom{AA}
                  \\left( \{S + S_{BRST},(-)\}\right)^2 = 0
                  \\phantom{AA}
                  \\Leftrightarrow
                  \\phantom{AA}
                  \\{S + S_{BRST}, S + S_{BRST}\} = 0
                  \\,.
          %p
            The
            %em quantum master equation
            (prop.
            %a.maruku-ref{:href => "#QuantumMasterEquation"}
            below) is the version of this equation after
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
            picks up a quantum correction of order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℏ
                %annotation{:encoding => "application/x-tex"} \hbar
            (
            %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
            ) by the
            %a.existingWikiWord{:href => "/nlab/show/BV-operator"} BV-operator
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi BV
                  %annotation{:encoding => "application/x-tex"} \Delta_{BV}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                      %mo (
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} {
                      %mi S
                      %mo +
                      %msub
                        %mi S
                        %mi BRST
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                      %mo +
                      %mi i
                      %mi ℏ
                      %msub
                        %mi Δ
                        %mi BV
                      %mspace{:width => "thinmathspace"}
                      %mo )
                    %mn 2
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(\, \{S + S_{BRST},(-)\} + i \hbar \Delta_{BV} \, \right)^2 = 0
                  \\,.
          %h2#in_causal_perturbation_theory In causal perturbation theory
          %p
            We discuss the quantum master equation in the rigorous formulation of
            %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            via
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            %a.existingWikiWord{:href => "/nlab/show/perturbative+AQFT"} perturbative AQFT
            (
            %a{:href => "#FredenhagenRejzner11b"}> Fredenhagen-Rejzner 11b
            ,
            = succeed ")." do
              %a{:href => "#Rejzner11"} Rejzner 11
          %p
            First we consider all structure just on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            such as the usual point-
            %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
          %p
            Then the
            %a.existingWikiWord{:href => "/nlab/show/extension"} extension
            of all structures from regular to
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            is the
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} renormalization
            step, discussed
            = succeed "." do
              %a{:href => "#RenormalizationAndMasterWardIdentity"} furthter below
          %h3#background Background
          %p
            Throughout, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BST
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BST}},\mathbf{L}')
            be a
            %a.existingWikiWord{:href => "/nlab/show/gauge+fixing"} gauge fixed
            %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
            with global
            %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
            (
            %a{:href => "A+first+idea+of+quantum+field+theory#ComplexBVBRSTGlobal"}> this def.
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi S
                  %mo ′
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi PolyObs
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BRST
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi reg
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %mi PolyObs
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mtext BV-BRST
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi reg
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi ℏ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\{-S', -\}
                  \\;\colon\;
                  PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
                  \\longrightarrow
                  PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar] ]
          %p
            Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} S'
            denotes the gauge fixed free action functional.
          %p
            Moreover, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi H
                %annotation{:encoding => "application/x-tex"} \Delta_H
            be a compatible choice of
            %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
            with associated
            %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
            = succeed "." do
