                            %mfrac
                              %mrow
                                %mi δ
                                %mi S
                                %mo ′
                              %mrow
                                %mi δ
                                %msup
                                  %mstyle{:mathvariant => "bold"}
                                    %mi Φ
                                  %mi a
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi ℛ
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi A
