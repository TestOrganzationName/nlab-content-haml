                    \\begin{aligned}
                    0
                    \&amp; =
                    \\{-S', \mathcal{R}^{-1}(A)\}
                    +
                    \\mathcal{R}^{-1}
                    \\left(
                    \\left\{ S' + S_{int} \,,\, A \right\}_{\mathcal{T}}
                    \\right)
                    \\\
                    \&amp; =
                    \\underset{\Sigma}{\int}
                    \\frac{\delta S'}{\delta \mathbf{\Phi}^a(x)} \mathcal{R}^{-1}(A^a(x))
                    \\, dvol_\Sigma(x)
                    +
                    \\mathcal{R}^{-1}
                    \\left(
                    \\underset{\Sigma}{\int}
