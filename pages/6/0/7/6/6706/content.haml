                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \Delta_F
          #DerivationBVDifferentialForWickAlgebra.num_lemma
            %h6#lemma Lemma
            %p
              %strong
                (global
                %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
                is
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
            %p
              The global
              %a.existingWikiWord{:href => "/nlab/show/BV-differential"} BV-differential
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi S
                    %mo ′
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} }
