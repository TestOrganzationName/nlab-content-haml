                    \&amp; =
                    \\exp_{\mathcal{T}}
                    \\left(
                    \\tfrac{-1}{i \hbar} S_{int}
                    \\right)
                    \\star_F
                    \\left\{
                    \-S',
                    \\exp_{\mathcal{T}}
                    \\left(
                    \\tfrac{1}{i \hbar} S_{int}
                    \\right)
                    \\star_F
                    A
                    \\right\}
                    \\\
                    \&amp; =
                    \\exp_{\mathcal{T}}
                    \\left(
                    \\tfrac{-1}{i \hbar}
                    S_{int}
                    \\right)
                    \\star_F
                    \\left(
                    \\left\{
                    \-S',
                    \\exp_{\mathcal{T}}
                    \\left(
