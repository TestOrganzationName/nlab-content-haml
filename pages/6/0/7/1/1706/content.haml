                              %mo ⟶
                              %mrow
                                %mi L
                                %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} /
                                %mi O
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
