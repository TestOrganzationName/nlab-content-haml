                          %mo{:stretchy => "false"} )
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \xi = \chi^\ast (E O(n)\underset{O(n)}{\times} \mathbb{R}^n)
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\xi)
              = succeed "." do
