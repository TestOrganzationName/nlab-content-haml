              = succeed "." do
                %a.maruku-ref{:href => "#XXiStructure"}
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, def. 2.4.17
            ).
          #CobHypTheoremForTargetSpaceAndVectorBundle.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
              with duals, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \xi \to X
              be an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/dimensional"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with an inner product, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tilde X \to X
              be the
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} O(n)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              of orthonormal
              %a.existingWikiWord{:href => "/nlab/show/frames"} frames
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                    %annotation{:encoding => "application/x-tex"} \xi
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fun
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ξ
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Top
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Fun^\otimes(Bord_n^{(X,\xi)}, \mathcal{C})
                    \\simeq
                    Top_{O(n)}(\tilde X, \tilde \mathcal{C})
                    \\,,
            %p
              where on the right we regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde C
              as a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              carrying the canonical
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              discussed
              = succeed "." do
                %a{:href => "#TheCanonicalOnAction"} above
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, theorem. 2.4.18
            ). The following is some aspects of the idea of the proof in (
            %a{:href => "#Lurie"}> Lurie, p. 57
            ).
          #ActionHomomorphismsAsInfinityActionHomomorphisms.num_remark
            %h6#remark Remark
            %p
              In the language of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-actions"} ∞-actions
              (as discussed there), the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Top_{O(n)}(\tilde X, \tilde \mathcal{C})
              is that of horizontal maps fitting into
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mo ⟶
                          %mtd
                          %mtd
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
