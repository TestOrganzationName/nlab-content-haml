                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} /
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Maps_G(V,W)\simeq \infty Grpd_{/B G}(V/\!/G, W/\!/G)
                    \\,.
            %p This yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi G
                    %mo ,
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
