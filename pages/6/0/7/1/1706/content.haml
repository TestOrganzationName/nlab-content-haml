                          %mtd
                            %mi Phases
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X//O(n) &amp;&amp; \stackrel{L//O(n)}{\longrightarrow} &amp;&amp; Phases//O(n)
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; B O(n)
                    }
                    \\,.
          %p
            By the discussion at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Local+prequantum+field+theory"} Local prequantum field theory
            = succeed "-toposes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            (one sufficient condition is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            has an
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-site"} (infinity,1)-site
            of definition all whose objects are
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/etale+homotopy+theory"} etale contractible
          %p
            Some examples are discussed at
            %em
              %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
            in the section
            = succeed "." do
              %em
                %a{:href => "prequantum+field+theory#HigherChern-SimonsLocalPrequantumFieldTheoryLevels"} Higher Chern-Simons field theory – Levels
          %h4#ForHQFTs For HQFTs
          %p
            If in def.
            %a.maruku-ref{:href => "#CatOfCobordismsWithXIStructure"}
            one chooses
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi B
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X = B SO(n) \times Y
            for any topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            the
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            of the canonical vector bundle bundle on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi SO
                %annotation{:encoding => "application/x-tex"} B SO
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi SO
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} B SO \times Y
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mi n
                    %mi X
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} Bord^{X}_n \to C
            is similar to what Turaev calls an
            %a.existingWikiWord{:href => "/nlab/show/HQFT"} HQFT
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
