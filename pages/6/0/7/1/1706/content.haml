                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Bord_n^{(X//O(n), X \underset{O(n)}{\times} \mathbb{R}^n)  })^\sqcup
                    \\longrightarrow
                    Phases^\otimes
                    \\,.
            %p
              Finally, by theorem
              %a.maruku-ref{:href => "#CobHypTheoremForTargetSpaceAndVectorBundle"}
              and in view of remark
              = succeed "," do
                %a.maruku-ref{:href => "#ActionHomomorphismsAsInfinityActionHomomorphisms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi O
