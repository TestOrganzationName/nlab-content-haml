            %a{:href => "#Lurie"}> Lurie, examples 2.4.12, 2.4.14. 2.4.15
            )
          #CanonicalSOActionOnBnZ.num_prop
            %h6#proposition Proposition
            %p
              For all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SO
                    %annotation{:encoding => "application/x-tex"} SO
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              on
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi n
                    %mi ℤ
                    %mo ∈
                    %msub
                      %mi Ab
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mi CatWithDuals
                  %annotation{:encoding => "application/x-tex"}
                    B^n \mathbb{Z} \in Ab_\infty(\infty Grpd) \hookrightarrow (\infty,n)CatWithDuals
            %p is trivial.
          .proof
            %h6#proof_2 Proof
            %p
              The action on a
              %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty X
              factors through the
              %a.existingWikiWord{:href => "/nlab/show/J-homomorphism"} J-homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo ×
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi J
                        %mo ,
                        %mi id
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Ω
                      %mn ∞
                    %msup
                      %mi S
                      %mn ∞
                    %mo ×
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi X
                    %mover
                      %mo ⟶
                      %mi precomp
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    SO \times \Omega^\infty X
                    \\stackrel{(J,id)}{\longrightarrow}
                    \\Omega^\infty S^\infty \times \Omega^\infty X
                    \\stackrel{precomp}{\longrightarrow}
                    \\Omega^\infty X
                    \\,.
            %p
              But on
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              the
              %a.existingWikiWord{:href => "/nlab/show/image+of+J"} image of J
              is pure
              %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
              which means that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mn ∞
                    %mi X
                    %mo =
                    %msup
                      %mi B
                      %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \Omega^\infty X = B^n \mathbb{Z}
              the induced actions on homotopy groups are all trivial. From this and using the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              it follows that the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          %h3#CobsWithExtraTopStructure For cobordisms with extra topological structure
          %p
            We discuss the cobordism hypothesis for cobordisms that are equipped with the extra
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            of maps into some
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            equipped with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            is (the local refinement of) what has also been called an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/HQFT"} HQFT
          %h4#ForCobordismsWithXXiStructure
            For cobordisms with any structure (“
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ξ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\xi)
            \-structure”)
          #XXiStructure.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \xi \to X
              a
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} m \leq n
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\xi)
                \-structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              consists of the following data
            %ul
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo :
                          %mi N
                          %mo →
                          %mi X
                        %annotation{:encoding => "application/x-tex"} f : N \to X
              %li
                %p
                  An
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mi N
                        %mo ⊕
                        %msup
                          %mi ℝ
                          %mrow
                            %mi n
                            %mo −
                            %mi m
                        %mo ≃
                        %msup
                          %mi f
                          %mo *
                        %mi ξ
                      %annotation{:encoding => "application/x-tex"}
                        T N \oplus \mathbb{R}^{n-m} \simeq f^* \xi
                %p
                  between the
                  = succeed "wise" do
                    %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mi N
                      %annotation{:encoding => "application/x-tex"} T N
                  with the trivial rank
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mi m
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-m)
                  bundle and the
                  %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ξ
                      %annotation{:encoding => "application/x-tex"} \xi
                  along
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, notation 2.4.16
            ).
          %p
            The two extreme cases of def.
            %a.maruku-ref{:href => "#XXiStructure"}
            are the following
          #FramingAsXXiStructur.num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} X = \ast
              the point and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo =
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \xi = \mathbb{R}^n
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\xi)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/framing"} framing
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi fr
                  %annotation{:encoding => "application/x-tex"}
                    (Bord_n^{(\ast, \mathbb{R}^n)})
                    \\simeq
                    Bord_n^{fr}
            %p
              reproduces the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n)
              = succeed "." do
                %a.maruku-ref{:href => "#FramedCobordismsNCat"}
          #UnorientedAsXXiStructur.num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                  %annotation{:encoding => "application/x-tex"} X =
              %a.existingWikiWord{:href => "/nlab/show/BO%28n%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B O(n)
              the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              of real
              %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
              underlying the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo =
                    %mi E
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \xi = E O(n) \underset{O(n)}{\times} \mathbb{R}^n
              the vector bundle
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+bundle"} universal bundle
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\xi)
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-structure" do
                %em no
              = succeed "-inclusion" do
                %a.existingWikiWord{:href => "/nlab/show/maximal+compact+subgroup"} maximal compact subgroup
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)\to GL(n)
              is a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %em unoriented cobordisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi un
                    %mo ≔
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi E
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo ×
                          %mrow
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Bord_n^{un} \coloneqq Bord_n^{(B O(n), E O(n)\underset{O(n)}{\times} \mathbb{R}^n)}
                    \\,.
            %p
              Accordingly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi B
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X = B SO(n)
              the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\xi)
              %em oriented manifolds
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi or
                    %mo ≔
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi E
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo ×
                          %mrow
                            %mi SO
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Bord_n^{or} \coloneqq Bord_n^{(B SO(n), E SO(n)\underset{SO(n)}{\times} \mathbb{R}^n)}
                    \\,.
          %p Generally:
          #GStructureAsXXiStructure.num_example
            %h6#example_4 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi \colon G \to O(n)
              a
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              mapping via a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X = B G
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ξ
                      %mo =
                      %msup
                        %mi χ
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo ×
