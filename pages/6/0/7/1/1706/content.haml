                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mi G
                    %mo ,
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} /
                    %mspace{:width => "negativethinmathspace"}
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Maps_{G}(E G , \tilde C)
                    \\simeq
                    \\infty Grpd_{/ B G}( B G, \tilde C /\!/B G )
                    \\,.
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
