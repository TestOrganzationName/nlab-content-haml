              be an
              %a.existingWikiWord{:href => "/nlab/show/abelian+%E2%88%9E-group"} abelian ∞-group
              object, regarded as a
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category+with+duals"} (∞,n)-category with duals
              %a.existingWikiWord{:href => "/nlab/show/internal+%28%E2%88%9E%2Cn%29-category"} internal
              to
              = succeed "." do
