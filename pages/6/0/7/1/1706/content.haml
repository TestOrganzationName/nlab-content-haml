              is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} /
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi X
                        %munder
                          %mo ×
                          %mrow
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %msup
                          %mi ℝ
                          %mi n
                        %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
