          .proof
            %h6#proof_4 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#UnorientedBulkFieldTheories"}
              the co-restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Bord
                      %mi n
                      %mo ⊔
                    %mover
                      %mo ⟶
                      %mi Z
                    %msub
                      %mi Corr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi Phases
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mo ⊗
                          %mi phased
                    %mo ⟶
                    %msub
                      %mi Corr
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"}
                    Bord_n^\sqcup \stackrel{Z}{\longrightarrow} Corr_n(\mathbf{H}_{/Phases})^{\otimes_{phased}}
                    \\longrightarrow Corr_n(\mathbf{H})^\otimes
            %p
              is equivalent to an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
