                      %mrow
                        %msub
                          %mo ⊗
                          %mi phased
                  %annotation{:encoding => "application/x-tex"}
                    Bord_n^\sqcup \longrightarrow Corr_n(\mathbf{H}_{/Phases})^{\otimes_{phased}}
            %p are equivalent to a choice
            %ol
              %li
                %p
