                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp; \longrightarrow &amp;&amp; \tilde X//O(n)
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow
                    \\\
                    \&amp;&amp; B SO(n)
                    }
            %p
              where the left map is the classifying map for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              and the right one is the canonical one out of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
          .proof{:id => "ProofOf2.4.18"}
            %h6#idea_of_proof_of_theorem_
              Idea of Proof of theorem
              = succeed "." do
                %a.maruku-ref{:href => "#CobHypTheoremForTargetSpaceAndVectorBundle"}
            %p
              Notice that for each point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
              there is an induced inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi fr
                    %mover
                      %mo ⟶
                      %mi x
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ξ
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Bord_n^{fr} \stackrel{x}{\longrightarrow} Bord_n^{(X,\xi)}
            %p
              of the framed cobordisms, def.
              = succeed "," do
                %a.maruku-ref{:href => "#FramedCobordismsNCat"}
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\xi)
              = succeed "," do
                %a.maruku-ref{:href => "#CatOfCobordismsWithXIStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is constant on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ξ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\xi)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/framing"} framing
              %a.maruku-ref{:href => "#CanonicalOnAction"}
              the induced point evaluation is
              = succeed "-equivariant," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Func
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi ξ
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Maps
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha
                    \\;\colon\;
                    Func^\otimes(Bord_n^{(X,\xi)}, \mathcal{C})
                    \\longrightarrow
                    Maps_{O(n)}(\tilde X, \tilde \mathcal{C})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde X
              denotes the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              to which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
            %p
              More generally, this is true for the pullback structure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              along along any map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Y \to X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi Y
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Func
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi ξ
                        %mo{:stretchy => "false"} |
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi Maps
                      %mrow
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %munder
                      %mo ×
                      %mi X
                    %mi Y
                    %mo ,
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha_Y
                    \\;\colon\;
                    Func^\otimes(Bord_n^{(Y,\xi|Y)}, \mathcal{C})
                    \\longrightarrow
                    Maps_{O(n)}(\tilde X\underset{X}{\times} Y, \tilde \mathcal{C})
                    \\,.
            %p
              By the previous comment, observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \alpha_Y
              is an equivalence for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} Y = \ast
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
              of this
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              sends
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              = succeed ")" do
                %a{:href => "#Lurie"} Lurie, theorem 3.1.8
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \alpha_Y
              is an equivalence for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              that appear as
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimits"} (∞,1)-colimits
              of the point. But this is the case for all
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              = succeed "." do
                %a{:href => "limit+in+a+quasi-category#EveryInfinityGroupoidIsHomotopyColimitOfConstantFunctorOverItself"} this proposition
          %p We consider now some special cases of the general definition of local structure-topological field theory
          %h4#StatementForCobordismsInAManifold For framed cobordisms in a topological space
          %p
            We discuss the special case of the cobordism hypothesis for
            = succeed "-cobordisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\xi)
            = succeed ")" do
              %a.maruku-ref{:href => "#CatOfCobordismsWithXIStructure"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                %annotation{:encoding => "application/x-tex"} \xi
            is the trivial vector bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo =
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⊗
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \xi = \mathbb{R}^n \otimes X
          %p
            In this case
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tilde X = O(n) \times X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Bord
                    %mi n
                    %mi fr
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %msubsup
                    %mi Bord
                    %mi n
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi X
                      %mo ×
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Bord_n^{fr}(X) := Bord_n^{(X,X \times \mathbb{R}^n)}
                  \\,.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \Pi(X) \in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            for the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .num_prop
            %h6#corollary_2 Corollary
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fun
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi fr
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Fun^\otimes(Bord^{fr}_n(X), C)
                    \\simeq
                    (\infty,n)Cat(\Pi(X), \tilde C)
                    \\simeq
                    \\infty Grpd(\Pi(X), Core(\tilde C))
                    \\,,
          %p
            This is a special case of the
            = succeed "." do
              %a{:href => "#CobHypTheoremForTargetSpaceAndVectorBundle"} above theorem
          %p
            Notice that one can read this as saying that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cob
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cob_n(X)
            is roughly like the
            %a.existingWikiWord{:href => "/nlab/show/free+functor"} free
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2Cn%29-category"} symmetric monoidal (∞,n)-category
            on the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (relative to
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h4#CobordismsWithGStructure
            For cobordisms with
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            We discuss the special case of the cobordism hypothesis for
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ξ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\xi)
            = succeed ")" do
              %a.maruku-ref{:href => "#CatOfCobordismsWithXIStructure"}
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
            (example
            = succeed ")," do
              %a.maruku-ref{:href => "#GStructureAsXXiStructure"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo :
                  %mi G
                  %mo →
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \chi : G \to O(n)
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                %annotation{:encoding => "application/x-tex"} \mathbf{B}O(n) \to
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed ".." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          %p Let then
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo :
                      %mo =
                      %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X := B G
                be the
                %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
                for
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ξ
                        %mi χ
                      %mo :
                      %mo =
                      %msup
                        %mi ℝ
                        %mi n
                      %msub
                        %mo ×
                        %mi G
                      %mi E
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \xi_\chi := \mathbb{R}^n \times_G E G
                be the corresponding
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated vector bundle
                to the
                %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mi G
                        %mo →
                        %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} E G \to B G
          .num_defn
            %h6#definition_4 Definition
            %p We say
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi G
                    %mo :
                    %mo =
                    %msubsup
                      %mi Bord
                      %mi n
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mi G
                        %mo ,
                        %msub
                          %mi ξ
                          %mi χ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Bord^G_n := Bord_n^{(B G, \xi_\chi)}
                    \\,.
            %p
              is the
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,n)
              = succeed "." do
                %strong
                  cobordisms with
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
          %p
            See (
            %a{:href => "#Lurie"}> Lurie, notation 2.4.21
            )
          .num_defn
            %h6#definition_5 Definition
            %p We have
            %ul
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} G = 1
                  the trivial group, a
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Bord
                          %mi n
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi ξ
                            %mo{:stretchy => "false"} )
                        %mo ≃
                        %msubsup
                          %mi Bord
                          %mi n
                          %mi fr
                      %annotation{:encoding => "application/x-tex"}
                        Bord_n^{(1,\xi)} \simeq Bord_n^{fr}
                %p
                  reproduces the
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,n)
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/framed+cobordisms"} framed cobordisms
                  = succeed "." do
                    %a.maruku-ref{:href => "#FramedCobordismsNCat"}
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo =
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G = SO(n)
                  the
                  %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
                  equipped with the canonical embedding
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo :
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi : SO(n) \to O(n)
                  a
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/orientation"} orientation
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Bord
                          %mi n
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi SO
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mo ≃
                        %msubsup
                          %mi Bord
                          %mi n
                          %mi or
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Bord_n^{(SO(n))} \simeq Bord_n^{or}
                        \\,.
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo =
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G = O(n)
                  the
                  %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
                  itself equipped with the identity map
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi χ
                        %mo :
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \chi : O(n) \to O(n)
                  a
                  = succeed "-structure" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Bord
                          %mi n
                          %mrow
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi Bord
                          %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Bord_n^{O(n)} \simeq Bord_n
                        \\,.
          %p
            See (
            %a{:href => "#Lurie"}> Lurie, example 2.4.22
            ).
          %p
            Then we have the following version of the cobordism hypothesis for manifolds with
            = succeed "-structure." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          #GEquivariantVersion.num_cor
            %h6#corollary_3 Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              equipped with a homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \to O(n)
              to the
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
              (regarded as an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              in
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fun
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi G
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi G
                  %annotation{:encoding => "application/x-tex"}
                    Fun^\otimes( Bord_n^{G}, \mathcal{C} )
                    \\simeq
                    (\tilde {\mathcal{C}})^{G}
            %p
              between extended TQFTs on
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/G-structure"} G-structure
              and the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %a{:href => "invariant#ForInfinityGroupActions"} homotopy invariants
              of the
              %a.existingWikiWord{:href => "/nlab/show/infinity-action"} infinity-action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝒞
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde \mathcal{C}
              (which is induced by the evaluation on the point).
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, theorem 2.4.26
            ).
          .proof{:id => "ProofOf2.4.26"}
            %h6#proof_3 Proof
            %p
              Theorem
              %a.maruku-ref{:href => "#CobHypTheoremForTargetSpaceAndVectorBundle"}
              asserts that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fun
                      %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi Bord
                      %mi n
                      %mi G
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Maps
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mi G
                    %mo ,
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ˜
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Fun^\otimes( Bord_n^{G}, \mathcal{C} )
                    \\simeq
                    Maps_{G}(E G , \tilde C)
                    \\,.
            %p
              Hence it remains to see that the right hand side are equivalently the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+invariants"} homotopy invariants
              of the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi G
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi B
                        %mi G
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} /
