              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orientation"} orientable
              %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/3-manifolds"} 3-manifolds
              correspond to (the closure of) schemes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %msub
                      %mi 𝒪
                      %mi K
