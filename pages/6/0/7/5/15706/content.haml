                    %mi n
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ∈
                    %mi ℤ
                    %mo ,
                    %mi n
                    %mo ≥
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hat{H}^i(Spec \mathcal{O}_K, \mathbb{Z}/n\mathbb{Z}) = \hat{H}^i(Spec \mathbb{Z}, \mathbb{Z}/n\mathbb{Z}) (i \in \mathbb{Z}, n \geq 2)
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi K
                      %mo =
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_K = \mathbb{Z}
            %li
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 1
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M_1 \to M
              be a covering of 3-manifolds. A knot
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              does not necessarily lift to a knot in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} M_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ◃
                    %msub
                      %mi 𝒪
                      %mi K
                  %annotation{:encoding => "application/x-tex"} p \triangleleft \mathcal{O}_K
              gives rise to an ideal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %msub
                        %mi 𝒪
                        %mi L
                    %annotation{:encoding => "application/x-tex"} p \mathcal{O}_L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} /
                    %mi K
                  %annotation{:encoding => "application/x-tex"} L/K
              is a Galois number field extension. (
              %a{:href => "#Goundaroulis"}> Goundaroulis &amp; Kontogeorgis
              ).
          %h3#version_of_deninger Version of Deninger
          %p
            Similar to M^2KR, but with the introduction of a 2-dimensional foliation on the 3-manifold and a flow such that finite primes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            correspond to periodic orbits of length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi log
                  %mi N
                  %mi p
                %annotation{:encoding => "application/x-tex"} log N p
            and the infinite primes correspond to the fixed points of the flow (
            %a{:href => "#Deninger02"}> Deninger02
            ). (See also the work of
            %a{:href => "http://www.math.uni-muenster.de/reine/u/baptiste.morin/"} Baptiste Morin
            on the Weil-étale topos.)
          %h3#ReznikovVariant Version of Reznikov
          %p
            Reznikov has modified the dictionary (
            %a{:href => "#Reznikov00"}> Reznikov 00, section 12
            ) so as to associate a number field with what he calls a
            = succeed "-manifold," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                    %mfrac
                      %mn 1
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} 3\frac{1}{2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(M) \to \pi_1(N)
            is surjective.
          %h2#explanations_for_the_analogy Explanations for the analogy
          %p
            %a.existingWikiWord{:href => "/nlab/show/Barry+Mazur"} Barry Mazur
            observed that for an affine spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X = Spec(D)
            of the ring of integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            in a number field, the groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi et
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mrow
                      %mi m
                      %mo ,
                      %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^n_{et}(X, \mathbb{G}_{m, X})
            vanish (up to 2-torsion) for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n \gt 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}/\mathbb{Z}
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} n = 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔾
                    %mrow
                      %mi m
                      %mo ,
                      %mi X
                %annotation{:encoding => "application/x-tex"} \mathbb{G}_{m, X}
            is the étale sheaf on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            defined by associating to a connected finite étale covering
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} Spec(B) \to X
            the multiplicative group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mrow
                        %mi m
                        %mo ,
                        %mi X
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi B
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}_{m, X}(Y) = B^{\times}
          %p
            Also, there is a non-degenerate pairing for any constructible abelian sheaf
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi H
                    %mi et
                    %mi r
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msup
                    %mi M
                    %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msubsup
                    %mi Ext
                    %mi X
                    %mrow
                      %mn 3
                      %mo −
                      %mi r
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mrow
                      %mi m
                      %mo ,
                      %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi H
                    %mi et
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝔾
                    %mrow
                      %mi m
                      %mo ,
                      %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℚ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  H^r_{et}(X,M^{'}) \times Ext^{3-r}_X(M,\mathbb{G}_{m, X}) \to H^3_{et}(X,\mathbb{G}_{m, X})\simeq \mathbb{Q}/\mathbb{Z},
          %p
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi M
                      %mo ′
                    %mo =
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %msub
                      %mi 𝔾
                      %mrow
                        %mi m
                        %mo ,
                        %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M^{'} = Hom(M, \mathbb{G}_{m, X})
          %p
            %a.existingWikiWord{:href => "/nlab/show/Minhyong+Kim"} Minhyong Kim
            argues that the normal bundle of an embedding of a circle corresponding to a prime in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(\mathbb{Z})
            is 2-dimensional (
            %a{:href => "#Kim"}> Kim
            ).
          %p
            %a.existingWikiWord{:href => "/nlab/show/Baptiste+Morin"} Baptiste Morin
            claims to provide a unified treatment via equivariant etale cohomology (
            %a{:href => "#Morin06"}> Morin06
            ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexander+polynomial"} Alexander polynomial
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/virtually+fibered+conjecture"} virtually fibered conjecture
                says that every
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/irreducible+manifold"} irreducible
                %a.existingWikiWord{:href => "/nlab/show/atoroidal+3-manifold"} atoroidal
                %a.existingWikiWord{:href => "/nlab/show/3-manifold"} 3-manifold
                with infinite
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                has a
                %a.existingWikiWord{:href => "/nlab/show/finite+cover"} finite cover
                which is a
                %a.existingWikiWord{:href => "/nlab/show/surface"} surface
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
                over the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/arithmetic+Chern-Simons+theory"} arithmetic Chern-Simons theory
          %h2#references References
          %ul
            %li#Deninger02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christopher+Deninger"}> Christopher Deninger
                ,
                = succeed "," do
                  %em A note on arithmetic topology and dynamical systems
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0204274"} arxiv:0204274
            %li#Goundaroulis
              %p
                Dimoklis Goundaroulis, Aristides Kontogeorgis,
                = succeed "," do
                  %em On the Principal Ideal Theorem in Arithmetic Topology
                = succeed "," do
                  %a{:href => "http://users.uoa.gr/~kontogar/talks/GkountPSATHA.pdf"} talk
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0705.3937"} paper
            %li#Kim
              %p
                Minhyong Kim,
                %a{:href => "http://minhyongkim.files.wordpress.com/2013/05/baez13-12.pdf"} note
            %li#Koberda08
              %p
                Thomas Koberda,
                = succeed "," do
                  %em Class Field Theory and the MKR Dictionary for Knots
                = succeed ")" do
                  %a{:href => "http://users.math.yale.edu/users/koberda/minorthesis.pdf"} pdf
            %li#Morin06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Baptiste+Morin"}> Baptiste Morin
                ,
                = succeed "," do
                  %em Applications of an Equivariant Etale Cohomology to Arithmetic Topology
                %a{:href => "http://arxiv.org/abs/math/0602064"} arxiv:0602064
                and Utilisation d’une cohomologie étale équivariante en topologie arithmétique, Compositio Math. 144 (2008), no. 1, 32-60.
            %li#Morishita09
              %p
                Masanori Morishita,
                = succeed "," do
                  %em Analogies between Knots and Primes, 3-Manifolds and Number Rings
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0904.3399"} arxiv:0904.3399
            %li#Reznikov00
              %p
                Alexander Reznikov,
                = succeed "," do
                  %em Embedded incompressible surfaces and homology of ramified coverings of three-manifolds
            %li#Sikora
              %p
                Adam Sikora,
                = succeed "," do
                  %em Analogies between group actions on 3-manifolds and number fields
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0107210"} arxiv
            %li#KohnoMorishita06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Toshitake+Kohno"}> Toshitake Kohno
                ,
                %a.existingWikiWord{:href => "/nlab/show/Masanori+Morishita"} Masanori Morishita
                (eds.),
                = succeed "," do
                  %em Primes and Knots
                = succeed ")" do
                  %a{:href => "http://www.ams.org/bookstore-getitem/item=CONM-416"} conm:416
            %li#Morishita12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Masanori+Morishita"}> Masanori Morishita
                ,
                = succeed "," do
                  %em Knots and Primes: An Introduction to Arithmetic Topology
                = succeed ")" do
                  %a{:href => "https://books.google.co.uk/books?id=DOnkGOTnI78C&pg=PA156#v=onepage&q&f=false"} web
            %li#GGW20
              %p
                Claudio Gómez-Gonzáles,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jesse+Wolfson"} Jesse Wolfson
                %em Problems in Arithmetic Topology
                (
                %a{:href => "https://arxiv.org/abs/2012.15434"}> arXiv:2012.15434
                )
