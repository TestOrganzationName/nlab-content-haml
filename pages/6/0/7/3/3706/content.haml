                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{C}, \omega)
              is also called a
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Lambda
                  \-structure
              = succeed ")." do
                %a{:href => "#Severa"} Ševera, section 4
            %p
