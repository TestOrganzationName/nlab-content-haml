            %h6#definition_4 Definition
            %p
              A dg-
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifold"} Lagrangian submanifold
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
