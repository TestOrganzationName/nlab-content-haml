          #ReducedHomologyOf0Sphere.num_example
            %h6#example_2 Example
            %p
              The reduced singular homology of the 0-
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 0
                    %mo ≃
                    %mo *
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mo *
                  %annotation{:encoding => "application/x-tex"} S^0 \simeq {*} \coprod {*}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
