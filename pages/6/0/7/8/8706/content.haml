                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ℤ
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi n
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H_n(S^0) \simeq
                    \\left\{
                    \\array{
                    \\mathbb{Z} &amp; if \; n = 0
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,.
