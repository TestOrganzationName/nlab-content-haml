                  \\\
                  \&amp;&amp; \updownarrow
                  \\\
                  b \colon B
                  \\;\dashv\;
                  \&amp;
                  \\prod_{b' \colon B}
                  D_{b'}
                  \&amp;\xrightarrow{\;\;\;
                  \\epsilon^{ \star_B }_D
                  \\;\;\;}&amp;
                  D_{b}
                  \\\
                  \&amp;
                  (d_{b'})_{b' \colon B}
                  \&amp;\mapsto&amp;
                  d_{b}
                  \\end{array}
          %p
            The adjunction unit is clearly the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} monad unit
          %p
            The adjunction counit gives the
            %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
            on the monad:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi b
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mi B
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi b
                            %mo ′
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mi B
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mi D
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi b
                                %mo{:lspace => "verythinmathspace"} :
                                %mi B
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi ϵ
                              %mrow
                                %msub
                                  %mo ⋆
                                  %mi B
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi p
                              %mi B
                            %msup
                              %mo{:stretchy => "false"} )
                              %mo *
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                      %mtd
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi b
                            %mo ′
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi p
                          %mi B
                        %msup
                          %mo{:stretchy => "false"} )
                          %mo *
                        %mi C
                    %mtr
                      %mtd
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mrow
                            %mi b
                            %mo ′
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi b
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi b
