                    %mo ←
                    %mi B
                    %mo →
                    %mo *
                    %mo →
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ast \leftarrow B \rightarrow \ast \rightarrow \ast
                    \\,.
            %p
          .num_remark
            %h6 Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              obtained by composing the other way around,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
