              %a.existingWikiWord{:href => "/nlab/show/projection+operators"} projection operators
              is “complete” in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                    %msub
                      %mi P
                      %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi.mathscript ℋ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{b \colon B}{\bigoplus} P_b
                    \\;=\;
                    id_{\mathscr{H}}
                    \\,.
            %p
              In summary, this means that for
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
              of
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %mi.mathscript ℋ
                    %mo →
                    %mi.mathscript ℋ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                  %annotation{:encoding => "application/x-tex"} (P_b \colon \mathscr{H} \to \mathscr{H})_{b \colon B}
              as in
              %a.maruku-eqref{:href => "#eq:MapsUnderlyingAlgebraStructureOverLinearReaderMonad"} (1)
              to constitute a
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projection+operators"} projection operators
              %a.existingWikiWord{:href => "/nlab/show/images"} images
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript ℋ
                      %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi im
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{H}_b \;\coloneqq\; im(P_b) \;\subset\; \mathscr{H}
            %p
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} span
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"} \;
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
              under
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                    %msub
                      %mi.mathscript ℋ
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{H}
                    \\;\simeq\;
                    \\underset{b \colon B}{\bigoplus}
                    \\mathscr{H}_b
                    \\,.
            %p
              Such structures, of course, are exactly the images under the right
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Vect
                      %mi B
                    %mo ⟶
                    %mspace{:width => "thickmathspace"}
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} \underset{B}{\prod} \;\colon\; Vect_B \longrightarrow{\;} Vect
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
              of vector spaces.
            %p
              Finally, the
              = succeed "-property" do
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                    %mover
                      %mo →
                      %mi ϕ
                    %mi.mathscript ℋ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathscr{H} \xrightarrow{\phi} \mathscr{H}'
              between the underlying vector spaces of two such
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                              %mrow
                                %mi b
                                %mo{:lspace => "verythinmathspace"} :
                                %mi B
                            %mi.mathscript ℋ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %munder
                                  %mo ⊕
                                  %mrow
                                    %mi b
                                    %mo{:lspace => "verythinmathspace"} :
                                    %mi B
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                              %mrow
                                %mi b
                                %mo{:lspace => "verythinmathspace"} :
                                %mi B
                            %mi.mathscript ℋ
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                    %msub
                                      %mi P
                                      %mi b
                                    %msub
                                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                      %mrow
                                        %mi b
                                        %mo{:lspace => "verythinmathspace"} :
                                        %mi B
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                    %mi P
                                    %msub
                                      %mo ′
                                      %mi b
                                    %msub
                                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                      %mrow
                                        %mi b
                                        %mo{:lspace => "verythinmathspace"} :
                                        %mi B
                        %mtr
                          %mtd
                            %mi.mathscript ℋ
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo −
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi ϕ
                                %mphantom
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo −
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mi.mathscript ℋ
                            %mo ′
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{b \colon B}{\bigoplus}
                    \\mathscr{H}
                    \&amp;\xrightarrow{\;\;\;
                    \\underset{b \colon B}{\oplus}
                    \\;\;\;}&amp;
                    \\underset{b \colon B}{\bigoplus}
                    \\mathscr{H}
                    \\\
                    \\mathllap{
                    {}^{
                    \\big(
                    P_b
                    \\big)_{b \colon B}
                    }
                    }
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\mathrlap{
                    {}^{
                    \\big(
                    P'_b
                    \\big)_{b \colon B}
                    }
                    }
                    \\\
                    \\mathscr{H}
                    \&amp;
                    \\underset{\phantom{---} \phi \phantom{---} }
                    {\longrightarrow}
                    \&amp;
                    \\mathscr{H}'
                    \\,.
                    }
            %p
              The
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              %a.existingWikiWord{:href => "/nlab/show/commutator"} commutes
              with all these
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projection+operators"} projection operators
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi P
                    %msub
                      %mo ′
                      %mi b
                    %mo ∘
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo ∘
                    %msub
                      %mi P
                      %mi b
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    b \colon B
                    \\;\;\;\;
                    \\vdash
                    \\;\;\;\;
                    P'_b \circ \phi
                    \\;=\;
                    \\phi \circ P_b
                    \\,.
            %p
              But this evidently means that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              itself is the image under the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ⊕
                      %mrow
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi ϕ
                      %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\phi
                    \\;=\;
                    \\underset{b \colon}{\oplus}
                    \\phi_b
            %p
              of a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
              of
              %a.existingWikiWord{:href => "/nlab/show/linear+maps"} linear maps
              between the
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi.mathscript ℋ
                      %mi b
                    %mo ⟶
                    %mi.mathscript ℋ
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    b \colon B
                    \\;\;\;
                    \\colon
                    \\;\;\;
                    \\mathscr{H}_b \longrightarrow \mathscr{H}'
                    \\,.
            %p
              This is the defining property of morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Vect
                      %mi B
                  %annotation{:encoding => "application/x-tex"} Vect_B
              and hence shows that
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
              of vector spaces, hence that the two
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} agree
          %p
          #FreeQuantumReaderAlgebras.num_remark
            %h6 Example
            %p
              %strong
                (free quantum
                = succeed "-algebras" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ◯
                          %mi B
                      %annotation{:encoding => "application/x-tex"} \bigcirc_B
              %br/
              The
              %em
                %a{:href => "algebra+over+a+monad#FreeAlgebras"} free
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              are those whose underlying vector space is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi B
                    %mi.mathscript ℬ
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                    %mi.mathscript ℬ
                  %annotation{:encoding => "application/x-tex"} \bigcirc_B \mathscr{B} = \underset{b \colon B}{\bigoplus} \mathscr{B}
              for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℬ
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi Vect
                    %annotation{:encoding => "application/x-tex"} \mathscr{B} \,\in \, Vect
              = succeed "," do
                %a.maruku-ref{:href => "#QuantumBReaderAlgebrasAreBDependentLinearTypes"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/dependent+linear+types"} dependent linear types
              which happen to assign the same vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℬ
                  %annotation{:encoding => "application/x-tex"} \mathscr{B}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                    %annotation{:encoding => "application/x-tex"} b \colon B
            %p
              But
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              of such free
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              = succeed "-dependent" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.maruku-ref{:href => "#QuantumBReaderAlgebrasAreBDependentLinearTypes"}
              but is also immediate under the
              %a{:href => "Kleisli+category#KleisliEquivalence"} Kleisli equivalence
              from observing that
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+morphisms"} Kleisli morphisms
              are of the following form:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi.mathscript ℬ
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %msub
                                  %mi ϕ
                                  %mi b
                                %msub
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mrow
                                    %mi b
                                    %mo{:lspace => "verythinmathspace"} :
                                    %mi B
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                              %mrow
                                %mi b
                                %mo{:lspace => "verythinmathspace"} :
                                %mi B
                            %mi.mathscript ℬ
                            %mo ′
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathscr{B}
                    \&amp;\xrightarrow{
                    \\big(
                    \\phi_b
                    \\big)_{b \colon B}
                    }&amp;
                    \\underset{b \colon B}{\bigoplus}
                    \\mathscr{B}'
                    \\,.
                    }
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory"} quantum information theory
              the
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
              which are free on the
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℂ
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} \,\in\, \mathbb{C} Vect
              (the
              %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+vector+space"} 1-dimensional
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
              %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+spaces"} complex vector spaces
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} of quantum states
              which are
              %a.existingWikiWord{:href => "/nlab/show/linear+space"} spanned
              by the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              regarded as a “
              %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
              = succeed "\u201D." do
                %a.existingWikiWord{:href => "/nlab/show/linear+basis"} basis
            %p
              For example, the
              %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type"} dependent linear type
              of
              %a.existingWikiWord{:href => "/nlab/show/qbits"} qbits
              is the free
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ◯
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \bigcirc_B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi Bool
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \bigcirc_{Bool} \mathbb{C}
              spanned by the
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+type+theory"} classical type
              %a.existingWikiWord{:href => "/nlab/show/Bool"} Bool
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} = \{0,1\}
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bits"} bits
              = succeed "-outcomes" do
                %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mn 0
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \vert 0\rangle
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mn 1
                      %mo{:stretchy => "false"} ⟩
                    %annotation{:encoding => "application/x-tex"} \vert 1 \rangle
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/qbits"} qbits
            %p#QuantumMeasurementAsIndefinitenessHandling
              Curiously, from this one finds that
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
                is exactly indefiniteness handling
            %p where
            %ul
              %li
                %p
                  “indefiniteness” is understood as the the effect/
                  %a.existingWikiWord{:href => "/nlab/show/modality"} modality
                  expressed by the reader monad
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ◯
                          %mi B
                      %annotation{:encoding => "application/x-tex"} \bigcirc_B
                  (see
                  = succeed ")," do
                    %a{:href => "necessity+and+possibility#RelationToPotentiality"} here
              %li
                %p
                  “handling” is understood as
                  %em effect handling
                  in the sense of effect-
                  %a.existingWikiWord{:href => "/nlab/show/monads+in+computer+science"} monads in computer science
                  (see
                  = succeed ");" do
                    %a{:href => "monad+in+computer+science#MonadModulesInIdeaSection"} here
            %p namely:
            %div{:style => "margin: -20px 0px 20px 10px"}
              %img{:src => "/nlab/files/QMeasurementViaIndefinitenessHandling-221109c.jpg", :width => "730px"}/
            %p
              Notice that this process may be understood as the “
              %a.existingWikiWord{:href => "/nlab/show/dynamic+lifting"}> dynamic lifting
              ” of
              = succeed "-results" do
                %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
              %a.existingWikiWord{:href => "/nlab/show/context"} context
              (here:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                  %annotation{:encoding => "application/x-tex"} B =
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Bool"} Bool
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dependent+linear+type+theory"} dependent linear type theory
            %p
              For more on this see at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/quantum+circuits+via+dependent+linear+types"} quantum circuits via dependent linear types
          %p
            %br/
          %p
            This naturally relates to the discussion of
            %a.existingWikiWord{:href => "/nlab/show/quantum+measurement"} quantum measurement
            via
            = succeed "-structures" do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
            %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory+via+dagger-compact+categories"} quantum information theory via dagger-compact categories
            – as follows:
          %p
          #QuantumrReaderMonadIsFrobenius.num_remark
            %h6 Remark
            %p
              %strong (quantum reader monad is Frobenius)
              %br/
              Since the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
              is a
              %a.existingWikiWord{:href => "/nlab/show/biproduct"} biproduct
              and using our running assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of the quantum
              %a.existingWikiWord{:href => "/nlab/show/reader+monad"} reader monad
              from Prop.
              %a.maruku-ref{:href => "#QuantumBReaderAlgebrasAreBDependentLinearTypes"}
              coincides with that of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coreader+comonad"} coreader comonad
              %em
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+monad"} Frobenius monad
              (see there).
          %p
          #QuantumReaderMonadIsSpecialFrobeniusWriterMonad.num_remark
            %h6 Remark
            %p
              %strong (quantum reader monad is special Frobenius writer monad)
              %br/
              Consider the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed
              the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %msup
                          %mo ⊗
                          %mi B
                  %annotation{:encoding => "application/x-tex"} k^{\otimes^B}
              of the
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              with itself as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} algebra
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %msup
                        %mi k
                        %mrow
                          %msup
                            %mo ⊗
                            %mi B
                    %mtext -
                    %mi Writer
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Vect
                    %mo →
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"}
                    {k^{\otimes^B}}\text{-}Writer
                    \\;\colon\;
                    Vect \to Vect
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/writer+monad"} writer monad
              corresponding to this
              %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Writer
                      %mrow
                        %msup
                          %mi k
                          %mrow
                            %msup
                              %mo ⊗
                              %mi B
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi V
                    %mo ⊗
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi k
                      %mrow
                        %msup
                          %mo ⊗
                          %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} Writer_{k^{\otimes^B}}(V) \;\coloneqq\; V \otimes \big( k^{\otimes^B} \big)
              and whose monad multiplication and
              %a.existingWikiWord{:href => "/nlab/show/unit+of+a+monad"} unit of a monad
              are induced from the
              %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
              and
              %a.existingWikiWord{:href => "/nlab/show/unit"} unit
              in this monoid.
            %p
              The above proof of Prop.
              %a.maruku-ref{:href => "#QuantumBReaderAlgebrasAreBDependentLinearTypes"}
              shows at once that this
              %a.existingWikiWord{:href => "/nlab/show/writer+monad"} writer monad
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to the
              = succeed "-reader" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi B
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Writer
                      %mrow
                        %msup
                          %mi k
                          %mrow
                            %msup
                              %mo ⊗
                              %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bigcirc_B
                    \\;\simeq\;
                    Writer_{k^{\otimes^B}}
                    \\,.
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/module+over+a+monad"} monad modules
              over a
              %a.existingWikiWord{:href => "/nlab/show/writer+monad"} writer monad
              are just the ordinary
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
              over the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ◯
                      %mi B
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi k
                      %mrow
                        %msup
                          %mo ⊗
                          %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\bigcirc_B Mod(Vect)
                    \\;\simeq\;
                    \\big(
                    k^{\otimes^B}
                    \\big)Mod(Vect)
                    \\,.
            %p
              This provides a rather transparent re-derivation of and alternative perspective on Example
              = succeed "." do
                %a.maruku-ref{:href => "#FreeQuantumReaderAlgebras"}
            %p
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> Dually
              , as in Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#QuantumReaderMonadIsFrobenius"}
              %a.existingWikiWord{:href => "/nlab/show/coreader+comonad"} coreader comonad
              is isomorphic to the
              %a.existingWikiWord{:href => "/nlab/show/coreader+comonad"} coreader comonad
              corresponding to the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mrow
                          %msup
                            %mo ⊗
                            %mi B
                    %annotation{:encoding => "application/x-tex"} k^{\otimes^B}
            %p
              Hence, as a
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+monad"} Frobenius monad
              (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#QuantumReaderMonadIsFrobenius"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %msup
                          %mo ⊗
                          %mi B
                  %annotation{:encoding => "application/x-tex"} k^{\otimes^B}
              regarded as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
              %a.existingWikiWord{:href => "/nlab/show/quantum+information+theory+via+dagger-compact+categories"} quantum information theory via dagger-compact categories
              \&amp;lbrack;
              %a{:href => "#CoeckePavlović08"}> Coecke &amp; Pavlović (2008), §1.5.1
              ,
              = succeed "&rbrack;." do
                %a{:href => "#CoeckePaquette08"} Coecke &amp; Paquette (2008), §2.3
          #eq:EquivalencesOfTheQuantumReaderMonad.maruku-equation
