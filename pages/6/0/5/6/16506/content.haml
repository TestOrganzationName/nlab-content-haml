          %p
            The
            %strong
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
            is:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                      %mtd
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi b
                            %mo ′
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                        %msub
                          %mi D
                          %mrow
                            %mi b
                            %mo ′
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mi id
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                      %mtd
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi b
                            %mo ′
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                        %msub
                          %mi D
                          %mrow
                            %mi b
                            %mo ′
                    %mtr
                      %mtd
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↕
                    %mtr
                      %mtd
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                        %mspace{:width => "thickmathspace"}
                        %mo ⊣
                        %mspace{:width => "thickmathspace"}
                      %mtd
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi b
                            %mo ′
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                        %msub
                          %mi D
                          %mrow
                            %mi b
                            %mo ′
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi ϵ
                              %mi D
                              %mrow
                                %msub
                                  %mo ⋆
                                  %mi B
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                      %mtd
                        %msub
                          %mi D
                          %mi b
                    %mtr
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi d
                          %mrow
                            %mi b
                            %mo ′
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi b
                            %mo ′
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                      %mtd
                        %mo ↦
                      %mtd
                        %msub
                          %mi d
                          %mi b
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
