                            %mi b
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                        %mi D
                    %mtr
                      %mtd
                      %mtd
                        %mi d
                      %mtd
                        %mo ↦
                      %mtd
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  b \colon B
                  \\; \vdash \;
                  \&amp;
                  D
                  \&amp;\xrightarrow{\;\;\;
                  id_D
                  \\;\;\;}&amp;
                  D
                  \\\
                  \&amp;&amp; \updownarrow
                  \\\
                  \&amp;
                  D
                  \&amp;\xrightarrow{\;\;\;
                  \\eta^{ \bigcirc_B }_D
                  \\;\;\;}&amp;
                  \\prod_{b \colon B} D
                  \\\
                  \&amp;
                  d &amp;\mapsto&amp; (d, \cdots, d)
