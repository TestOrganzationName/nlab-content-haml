                      %msub
                        %mi p
                        %mi B
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} (p_B)^\ast (p_B)_\ast
              %a.existingWikiWord{:href => "/nlab/show/modal+operator"} modal operator
              usually called
              %em
                %a.existingWikiWord{:href => "/nlab/show/necessity"} necessity
          %p
            From the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
          %p
            The
            %strong
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi b
                        %mo{:lspace => "verythinmathspace"} :
                        %mi B
                        %mspace{:width => "thickmathspace"}
                        %mo ⊢
                        %mspace{:width => "thickmathspace"}
                      %mtd
                        %mi D
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mi id
                              %mi D
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                      %mtd
                        %mi D
                    %mtr
                      %mtd
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ↕
                    %mtr
                      %mtd
                      %mtd
                        %mi D
                      %mtd
                        %mover
                          %mo →
                          %mrow
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %msubsup
                              %mi η
