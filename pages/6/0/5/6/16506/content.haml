                            %mo ,
                            %mi b
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                      %mtd
                        %mo ↦
                      %mtd
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi b
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi b
                        %msub
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mrow
                            %mi b
                            %mo{:lspace => "verythinmathspace"} :
                            %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  \\prod_{b \colon B}
                  (p_B)^\ast
                  \\prod_{b' \colon B}
                  (p_B)^\ast
                  D
                  \&amp;\xrightarrow{\;\;\;
                  \\prod_{b \colon B}
                  \\big(
                  \\epsilon^{\star_B}
                  \\big)
                  (p_B)^\ast
                  \\;\;\;}&amp;
                  \\prod_{b' \colon B}
                  (p_B)^\ast
                  C
                  \\\
                  \\big(
                  (f_{b'})_{b}
                  \\big)_{b', b \colon B}
                  \&amp;\mapsto&amp;
