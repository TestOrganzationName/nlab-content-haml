                )
            %li#MM19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francisco+Marmolejo"}> F. Marmolejo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mat%C3%ADas+Menni"} M. Menni
                %em
                  Level
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                , arXiv:1909.12757 (2019). (
                %a{:href => "https://arxiv.org/abs/1909.12757"}> abstract
