          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#as_a_functor_into_a_closed_monoidal_category"} As a functor into a closed monoidal category
              %li
