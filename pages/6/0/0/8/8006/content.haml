                        %a.existingWikiWord{:href => "/nlab/show/operads"} operads
                  %p
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/internal+logic"}> internal logic
                        ,
