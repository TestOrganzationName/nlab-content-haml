                    \\;\;
                    \\colon
                    \\;\;
                    \\mathcal{C}(D_1)
                    \\longrightarrow
                    \\mathcal{E}(D_3)
            %p
              given by the (co-)
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+extension"} bind-operation
              on the factors connected by the distributivity transformation:
            %div{:style => "margin: -20px 0px 20px 0px"}
              %img{:src => "/nlab/files/CoMonKleisliComposition-230930b.pdf", :width => "800px"}/
            %p
          (
          %a{:href => "#BrookesVanStone93"}> Brookes &amp; Van Stone 1993 Thm. 2
          )
          %p
          #MonadTransformationsOnTwoSidedKleisli.num_prop
            %h6 Proposition
            %p
