                        %mo{:stretchy => "false"} )
                    %msup
                      %mi T
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi μ
                          %mi Y
                    %mi T
                    %mo{:stretchy => "false"} (
