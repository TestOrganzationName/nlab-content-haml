              is the identity on objects, and on morphisms it maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f:X\to Y
              to the Kleisli morphism defined by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi Y
                      %mo ∘
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi T
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \eta_Y\circ f:X\to T Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is the unit of the monad.
            %li
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %msub
                      %mi 𝒞
                      %mi T
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} R:\mathcal{C}_T\to\mathcal{C}
              maps an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi X
                    %mo →
                    %mi T
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} k:X\to T Y
              to its
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+extension"} Kleisli extension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mi Y
                      %mo ∘
                      %mi T
                      %mi k
                      %mo :
                      %mi T
                      %mi X
                      %mo →
                      %mi T
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \mu_Y\circ T k:T X\to T Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is the multiplication of the monad.
          %p
            In terms of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad#FreeAlgebras"} free algebras
          %ul
            %li
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi 𝒞
                    %mo →
                    %msub
                      %mi 𝒞
                      %mi T
                  %annotation{:encoding => "application/x-tex"} L:\mathcal{C}\to\mathcal{C}_T
              maps an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the free algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mi X
                      %mo ,
                      %msub
                        %mi μ
                        %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (T X,\mu_X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              is the multiplication of the monad, and a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f:X\to Y
              to the morphism of algebras
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi f
                      %mo :
                      %mi T
                      %mi X
                      %mo →
                      %mi T
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} T f: T X\to T Y
            %li
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %msub
                      %mi 𝒞
                      %mi T
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} R:\mathcal{C}_T\to\mathcal{C}
              is the forgetful functor mapping free algebras and morphisms of algebras to the underlying objects and morphisms of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h3#UniversalProperties Universal properties
          %p
            In more general 2-categories the
            %a.existingWikiWord{:href => "/nlab/show/universal+properties"} universal properties
            of
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+objects"} Kleisli objects
            are dual to the universal properties of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category#Definition"} Eilenberg-Moore objects
          %p
            In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mstyle{:mathvariant => "bold"}
                      %mi T
                %annotation{:encoding => "application/x-tex"} C_{\mathbf{T}}
            is
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            in the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor#RelationToMonads"} category of adjunctions
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi T
                %annotation{:encoding => "application/x-tex"} \mathbf{T}
            (whereas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mstyle{:mathvariant => "bold"}
                      %mi T
                %annotation{:encoding => "application/x-tex"} C^{\mathbf{T}}
            is
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/terminal+objects"} terminal
            %em
              %a.existingWikiWord{:href => "/nlab/show/Category+Theory+in+Context"} Category Theory in Context
            Proposition 5.2.12.
          %h3#limits_and_colimits Limits and colimits
          %ul
            %li
              %p
                By the fact that the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mi 𝒞
                      %mo →
                      %msub
                        %mi 𝒞
                        %mi T
                    %annotation{:encoding => "application/x-tex"} L:\mathcal{C}\to\mathcal{C}_T
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits"} it preserves all the colimits
                which exist in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                While
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
          %p
          #Tlim.num_prop
            %h6 Proposition
            %p
              A limit in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is preserved by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi 𝒞
                    %mo →
                    %msub
                      %mi 𝒞
                      %mi T
                  %annotation{:encoding => "application/x-tex"} L:\mathcal{C}\to\mathcal{C}_T
              if and only if it is preserved by the monad
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo :
                      %mi 𝒞
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} T:\mathcal{C}\to\mathcal{C}
          %p
          .proof
            %h6 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              be a diagram in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              First, suppose that the limit of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is preserved by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %msub
                      %mi 𝒞
                      %mi T
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} R:\mathcal{C}_T\to\mathcal{C}
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoints+preserve+limits"} it preserves limits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is also preserved by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi R
                      %mo ∘
                      %mi L
                    %annotation{:encoding => "application/x-tex"} T=R\circ L
            %p
              Conversely, denote by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %msup
                      %mi 𝒞
                      %mi T
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} U:\mathcal{C}^T\to\mathcal{C}
              the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              from the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+category"} Eilenberg-Moore category
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo :
                    %msub
                      %mi 𝒞
                      %mi T
                    %mo →
                    %msup
                      %mi 𝒞
                      %mi T
                  %annotation{:encoding => "application/x-tex"} J:\mathcal{C}_T\to\mathcal{C}^T
              the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/comparison+functor"} comparison functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %msub
                      %mi 𝒞
                      %mi T
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} R:\mathcal{C}_T\to\mathcal{C}
              factors as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∘
                      %mi J
                    %annotation{:encoding => "application/x-tex"} U\circ J
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi U
                      %mo ∘
                      %mi J
                      %mo ∘
                      %mi L
                    %annotation{:encoding => "application/x-tex"} T=U\circ J\circ L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is preserved by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi U
                      %mo ∘
                      %mi J
                      %mo ∘
                      %mi L
                    %annotation{:encoding => "application/x-tex"} T=U\circ J\circ L
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/created+limit#examples"} monadic functors create limits
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo ∘
                      %mi L
                      %mo :
                      %mi 𝒞
                      %mo →
                      %msup
                        %mi 𝒞
                        %mi T
                    %annotation{:encoding => "application/x-tex"} J\circ L:\mathcal{C}\to\mathcal{C}^T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              is a full inclusion, and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/reflected+limit#Examples"} full inclusions reflect limits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mi 𝒞
                    %mo →
                    %msub
                      %mi 𝒞
                      %mi T
                  %annotation{:encoding => "application/x-tex"} L:\mathcal{C}\to\mathcal{C}_T
              alone.
          %h2#examples Examples
          %h3#general General
          %p
          #CallByValueProgramming.num_remark
            %h6 Example
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/type+theory"} typed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functional+programming"} functional programming
              %span.newWikiWord
                call-by-value
                %a{:href => "/nlab/new/call-by-value"} ?
              functions with
              %a.existingWikiWord{:href => "/nlab/show/side+effects"} side effects
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/computation"} computation
              %a.existingWikiWord{:href => "/nlab/show/co-Kleisli+category"} co-Kleisli category
              of a
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              may be used to model
              %span.newWikiWord
                call-by-name
                %a{:href => "/nlab/new/call-by-name"} ?
              programming , see
              = succeed "." do
                %a{:href => "Kleisli+category+of+a+comonad#CallByNameProgramming"} there
            %p
              Generally, see at
              %em
                %a.existingWikiWord{:href => "/nlab/show/monad+%28in+computer+science%29"} monad (in computer science)
              for more on this.
          %h3#specific Specific
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
                as (co-)Kleisli composition)
              %br/
              See
