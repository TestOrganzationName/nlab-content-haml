          .num_remark
            %h6#remark_2 Remark
            %p
              This Kleisli composition plays an important role in
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/computer+science"} computer science
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monad+%28in+computer+science%29"} monad (in computer science)
          %h3#TwoSidedKleisliCategory Two-sided Kleisli category
          %p
          #ExistenceOfTwoSidedKleisliCategory.num_prop
            %h6 Proposition
            %p
              If in addition to the given monad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              on the same category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %a.existingWikiWord{:href => "/nlab/show/distributivity+law"} distributivity law
              (see
              = succeed ")" do
                %a{:href => "distributive+law#ComonadDistributingOverMonad"} there
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi distr
                      %mrow
                        %mi 𝒞
                        %mo ,
                        %mi ℰ
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo ⟶
                    %mi ℰ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    distr^{\mathcal{C}, \mathcal{E}}
                    \\;\;\colon\;\;
                    \\mathcal{C}
                    \\big(
                    \\mathcal{E}(D)
                    \\big)
                    \\longrightarrow
                    \\mathcal{E}
                    \\big(
                    \\mathcal{C}(D)
                    \\big)
            %p
              then there is a two-sided (“double”)
              %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
              whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are those of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mn 1
                    %mo →
                    %msub
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} D_1 \to D_2
              are morphisms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi prog
                      %mn 12
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    prog_{12}
                    \\;\colon\;
                    \\mathcal{C}(D_1)
                    \\longrightarrow
                    \\mathcal{E}(D_2)
            %p with two-sided Kelisli composition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
