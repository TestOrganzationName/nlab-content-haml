                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℰ
                    %mo{:stretchy => "false"} (
                    %msub
