                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mi f
                    %mi T
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \xrightarrow{f} T Y
              %a.maruku-eqref{:href => "#eq:KleisliMorphism"} (1)
              to
            .maruku-equation
