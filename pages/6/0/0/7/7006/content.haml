            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fibered+category+theory"} fibered category theory
          %h2#references References
          %h3#general General
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Harper"}> Robert Harper
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Licata"} Dan Licata
                %em Canonicity for 2-Dimensional Type Theory
                (
                %a{:href => "http://www.cs.cmu.edu/~drl/pubs/lh112tt/lh112tt.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Harper"}> Robert Harper
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Licata"} Dan Licata
                %em 2-Dimensional directed type theory
                (
                %a{:href => "http://www.cs.cmu.edu/~drl/pubs/lh102dtt/lh102dtt.pdf"} pdf
                = succeed ")" do
                  %a{:href => "http://www.cs.cmu.edu/~drl/pubs/lh102dtt/lh102dtt-slides.pdf"} slides
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Warren"}> Michael Warren
                ,
                %em Directed Type Theory
                (
                %a{:href => "https://video.ias.edu/univalent/1213/0410-MichaelWarren"}> video lecture
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dan+Licata"}> Dan Licata
                , Chapters 7 and 8 of
                %em Dependently Typed Programming with Domain-Specific Logics
                PhD thesis, (
                %a{:href => "http://www.cs.cmu.edu/~drl/pubs/thesis/thesis.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
                = succeed "," do
                  %em A type theory for synthetic ∞-categories
                %strong 1
                1 (2017) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1705.07442"}> arxiv:1705.07442
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://higher-structures.math.cas.cz/api/files/issues/Vol1Iss1/RiehlShulman"} published article
            %li#GWB24
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Gratzer"}> Daniel Gratzer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jonathan+Weinberger"} Jonathan Weinberger
                = succeed "," do
