                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mo ∂
                              %mi j
                            %msub
                              %mo ∂
                              %mi i
                            %mi σ
                            %mo +
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo ≤
                                %mi j
                                %mo ≤
                                %mi i
                                %mo &lt;
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo +
                                %mi j
                            %msub
                              %mo ∂
                              %mi i
                            %msub
                              %mo ∂
                              %mi j
                            %mi σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\partial \partial \sigma
                    \&amp; =
                    \\partial \left(
                    \\sum_{j = 0}^n (-1)^j \partial_j \sigma
                    \\right)
                    \\\
                    \&amp; =
                    \\sum_{j=0}^n \sum_{i = 0}^{n-1} (-1)^{i+j} \partial_i \partial_j \sigma
                    \\\
                    \&amp; =
                    \\sum_{0 \leq i \lt j \leq n} (-1)^{i+j} \partial_i \partial_j \sigma
                    +
                    \\sum_{0 \leq j \leq i \lt n} (-1)^{i + j} \partial_i \partial_j \sigma
                    \\\
                    \&amp; =
                    \\sum_{0 \leq i \lt j \leq n} (-1)^{i+j} \partial_{j-1} \partial_i \sigma
                    +
                    \\sum_{0 \leq j \leq i \lt n} (-1)^{i + j} \partial_i \partial_j \sigma
                    \\\
                    \&amp; =
                    \-
                    \\sum_{0 \leq i \leq j \lt n} (-1)^{i+j} \partial_{j} \partial_i \sigma
                    +
                    \\sum_{0 \leq j \leq i \lt n} (-1)^{i + j} \partial_i \partial_j \sigma
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
            %p Here
            %ol
              %li
                %p
                  the first equality is
                  = succeed ";" do
                    %a.maruku-eqref{:href => "#eq:AlternatingFaceMapDifferential"} (2)
              %li
                %p
                  the second is
                  %a.maruku-eqref{:href => "#eq:AlternatingFaceMapDifferential"} (2)
                  together with the linearity of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                        %annotation{:encoding => "application/x-tex"} d
              %li
                %p the third is obtained by decomposing the sum into two summands;
              %li
                %p
                  the fourth finally uses the simplicial identity def.
                  %a.maruku-ref{:href => "#SimplicialIdentities"}
                  (1) in the first summand;
              %li
                %p
                  the fifth relabels the summation index
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
                  by
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} j +1
              %li
                %p the last one observes that the resulting two summands are negatives of each other.
