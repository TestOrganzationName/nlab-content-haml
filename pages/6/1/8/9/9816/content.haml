                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi M
                      %msub
                        %mi Spin
                        %mo •
                  %msub
                    %mi KO
                    %mo •
                  %mo ≃
                  %msub
                    %mi KO
