                            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
                  %h2#theorems Theorems
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Diaconescu%27s+theorem"} Diaconescu's theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Barr%27s+theorem"} Barr's theorem
                  %div
                    %p
                      %a{:href => "/nlab/edit/topos+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#internal_logic"} Internal logic
              %li
                %a{:href => "#the_real_numbers"} The real numbers
              %li
                %a{:href => "#related_entries"} Related entries
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            of topological spaces notoriously lacks some desirable features. There are therefore quite a few attempts to define “big” categories that contain (all) interesting topological spaces but are better behaved categorically. The
            %strong topological topos
            was proposed in this vein by
            %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"} Peter Johnstone
            in the seventies. As it is conceptually based on sequential convergence it plays an important role in constructive mathematics.
          %h2#definition Definition
          %p
            Let
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            be the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            be the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            whose only two
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}^+
            %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
            of the
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            be the
            %a.existingWikiWord{:href => "/nlab/show/canonical+Grothendieck+topology"} canonical Grothendieck topology
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            Johnstone’s
            %strong topological topos
            (specifically, the one described in the
            = succeed ")" do
              %a{:href => "#Johnstone79"} eponymous paper
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            of canonical
            %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi J
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_J(\Sigma)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi Σ
                        %mi op
                  %mo :
                  %mi X
                  %mo ↦
                  %mi Top
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Top \to Set^{\Sigma^{op}}: X \mapsto Top(-, X)
          %p
            is
            %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
            and factors through
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_J(\Sigma)
            %a.existingWikiWord{:href => "/nlab/show/sequential+space"} sequential spaces
            is full.
          %p
            The category of
            %a.existingWikiWord{:href => "/nlab/show/subsequential+spaces"} subsequential spaces
            can also be found as a full subcategory of this topos (in fact, it consists of the separated objects for the
            %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation topology
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg\neg
          %p
            Importantly, following an idea by Joyal, the topological topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                  %mo ≔
                  %msub
                    %mi Sh
                    %mi J
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{E} \coloneqq Sh_J(\Sigma)
            allows one to represent the
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                  %mo →
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} sSet \to \mathcal{E}
            as the inverse image of a
            %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            to the topos of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/big+topos"} big topos
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            and also for Lawvere’s topos for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/continuum+mechanics"} continuum mechanics
          %h2#internal_logic Internal logic
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            of the topological topos, the
            %a.existingWikiWord{:href => "/nlab/show/limited+principle+of+omniscience"} limited principle of omniscience
            (LPO) for the natural numbers is false (and thus
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            also fails). Specifically, the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℕ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \mathbb{N}^+
            can be constructed internally as the subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 2
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} 2^{\mathbb{N}}
            consisting of non-decreasing sequences, and the discrete space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{N}+1
            includes into it as the set of sequences that are 1 at exactly one place or 0 everywhere. Thus, the non-isomorphy of this map exhibits the failure of LPO.
          %p
            Since the topological topos is generated by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}^+
            %a.existingWikiWord{:href => "/nlab/show/localization"} localize
            at the inclusion
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                    %mo +
                    %mn 1
                    %mo →
                    %msup
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}+1 \to \mathbb{N}^+
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+objects"} codiscrete objects
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
          %p
            On the other hand, the
            %em lesser
            limited principle of omniscience (LLPO)
            %em does
            hold in the topological topos. This is easiest to see from its “analytic” version, which is equivalent to saying that every real number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is either
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \ge 0
            or
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \le 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn ∞
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} (-\infty,0] + [0,\infty) \to \mathbb{R}
            is surjective. This follows from Johnstone’s Proposition 6.2 on the preservation of closed unions, which implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is the pushout of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn ∞
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} (-\infty,0]
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [0,\infty)
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0\}
          %p
            In particular, as Johnstone remarks, this implies that the quotient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ∼
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} [0,1]/(0\sim 1)
            of the unit
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            identifying its endpoints coincides with a “correct” constructive definition of the circle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo =
                    %mi ℝ
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} S^1 = \mathbb{R}/\mathbb{Z}
            %em function
            assigning to every real number a decimal expansion, since no such function can be continuous).
          %h2#the_real_numbers The real numbers
          %p
            One of the important facts about the topological topos is that its
            %a.existingWikiWord{:href => "/nlab/show/real+numbers+object"} real numbers object
            is the set of classical
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            equipped with its usual
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            — or more precisely, with the structure of
            %a.existingWikiWord{:href => "/nlab/show/subsequential+space"} subsequential space
            given by the usual notion of convergence for sequences of real numbers (arising from the usual Euclidean topology).
          %p
            In fact, there are two commonly used definitions of “real number” in a topos: the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+real+numbers"} Dedekind real numbers
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+real+numbers"} Cauchy real numbers
            %a.existingWikiWord{:href => "/nlab/show/Boolean+topos"} Boolean
            or satisfies the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+countable+choice"} axiom of countable choice
            %a.existingWikiWord{:href => "/nlab/show/dependent+choice"} dependent choice
            and hence
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/countable+choice"} countable choice
            = succeed "." do
              %a{:href => "#ShulmanSimpson2024"} Shulman &amp; Simpson 2024
          %p For the Dedekind real numbers, a proof of this can be found in Johnstone’s paper. Here we sketch a proof for the Cauchy reals.
          .un_theorem
            %h6#theorem Theorem
            %p
              The Cauchy real numbers object in the topological topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is the classical set of real numbers with its usual notion of sequential convergence.
          .proof
            %h6#proof Proof
            %p
              For simplicity, we use Cauchy sequences with a fixed modulus:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{N} \to \mathbb{Q}
              is Cauchy if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi x
                        %mi m
                      %mo −
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mfrac
                      %mn 1
                      %mrow
                        %mi m
                        %mo +
                        %mn 1
                    %mo +
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {|x_m - x_n|} \lt \frac{1}{m+1} + \frac{1}{n+1}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ,
                      %mi n
                    %annotation{:encoding => "application/x-tex"} m,n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              is the limit of such a Cauchy sequence, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi y
                      %mo −
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {|y - x_n|} \le \frac{1}{n+1}
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image+functor"} inverse image functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %mi Set
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \Delta : Set \to \mathcal{E}
              preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers+objects"} natural numbers objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              has the discrete structure (only eventually-constant sequences converge). And since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ≅
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q} \cong \mathbb{N}
              constructively, the “rational numbers object”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is also discrete. It follows, by definition of exponentials in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℚ
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}^{\mathbb{N}}
              of sequences of rational numbers has the topology of “pointwise-eventually-constant convergence”: a sequence of sequences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} ((x_{n,k})_k)_n
              converges to a sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (y_k)_k
              if for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              the sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (x_{n,k})_n
              is eventually constant at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mi k
                    %annotation{:encoding => "application/x-tex"} y_k
            %p
              Now the object of Cauchy sequences is a subobject of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℚ
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}^{\mathbb{N}}
              defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mo ∀
                      %mi n
                      %mo ,
                      %mi m
                      %mo ,
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi m
                        %mo −
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mfrac
                        %mn 1
                        %mrow
                          %mi m
                          %mo +
                          %mn 1
                      %mo +
                      %mfrac
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo }
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \left\{ (x_n) \mid \forall n,m, {|x_m - x_n|} \lt \frac{1}{m+1} + \frac{1}{n+1} \right\}.
            %p
              The predicate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi x
                        %mi m
                      %mo −
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mfrac
                      %mn 1
                      %mrow
                        %mi m
                        %mo +
                        %mn 1
                    %mo +
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {|x_m - x_n|} \lt \frac{1}{m+1} + \frac{1}{n+1}
              defines a subobject of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℚ
                        %mi ℕ
                      %mo ×
                      %mi ℕ
                      %mo ×
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}^{\mathbb{N}} \times \mathbb{N}\times \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                  %annotation{:encoding => "application/x-tex"} \lt
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ×
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}\times\mathbb{Q}
              along the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℚ
                      %mi ℕ
                    %mo ×
                    %mi ℕ
                    %mo ×
                    %mi ℕ
                    %mo →
                    %mi ℚ
                    %mo ×
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}^{\mathbb{N}} \times \mathbb{N}\times \mathbb{N} \to \mathbb{Q}\times\mathbb{Q}
              defined by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi m
                      %mo ,
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi m
                        %mo −
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} |
                      %mo ,
                      %mfrac
                        %mn 1
                        %mrow
                          %mi m
                          %mo +
                          %mn 1
                      %mo +
                      %mfrac
                        %mn 1
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,m,n) \mapsto ({|x_m-x_n|},\frac{1}{m+1}+\frac{1}{n+1})
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                    %mo ×
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}\times \mathbb{Q}
              is discrete, and every subobject of a discrete object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is (discrete and) relatively codiscrete, i.e. it has the induced topology. Thus, the predicate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi x
                        %mi m
                      %mo −
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mfrac
                      %mn 1
                      %mrow
                        %mi m
                        %mo +
                        %mn 1
                    %mo +
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {|x_m - x_n|} \lt \frac{1}{m+1} + \frac{1}{n+1}
              also has the induced topology. And since relatively codiscrete maps are the modal maps for a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/modality"} modality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℚ
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}^{\mathbb{N}}
              of pointwise eventually constant convergence.
            %p
              In any topos, there is a monomorphism from the Cauchy real numbers to the Dedekind real numbers, and as remarked above, Johnstone proved that the latter have the usual topology. Moreover, it is easy to see that the
              %em points
              of the Cauchy real numbers object are precisely the classical real numbers: any classical Cauchy sequence certainly induces a Cauchy sequence internal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %p
              To this end, suppose we have a sequence of Cauchy sequences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} ((x_{n,k})_k)_n
              and a Cauchy sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} (y_k)_k
              (all in the above fixed-modulus sense) such that the sequence of real numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} ([x_n])_n
              converges to the real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [y]
              in the usual sense. We want to show that this convergence also happens in the Cauchy real numbers object. To this end, define a new sequence of Cauchy sequences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                  %annotation{:encoding => "application/x-tex"} z_{n,k}
              by setting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %mo =
                    %msub
                      %mi y
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} z_{n,k} = y_{2k+1}
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                      %mo −
                      %msub
                        %mi y
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mfrac
                      %mn 1
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {|[x_n] - y_{2k+1}|} \lt \frac{1}{k+1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %mo =
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                  %annotation{:encoding => "application/x-tex"} z_{n,k} = x_{n,k}
              otherwise. To show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} z_n
              is Cauchy, the only nontrivial case is to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi y
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                      %mo −
                      %msub
                        %mi x
                        %mrow
                          %mi n
                          %mo ,
                          %mi ℓ
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mfrac
                      %mn 1
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo +
                    %mfrac
                      %mn 1
                      %mrow
                        %mi ℓ
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {|y_{2k+1} - x_{n,\ell}|} \lt \frac{1}{k+1} + \frac{1}{\ell+1}
              if
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %msub
                          %mi y
                          %mrow
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mfrac
                        %mn 1
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} {|[x_n] - y_{2k+1}|} \lt \frac{1}{k+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo ,
                        %mi ℓ
                  %annotation{:encoding => "application/x-tex"} x_{n,\ell}
              converges to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x_n]
              with fixed modulus, we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                      %mo −
                      %msub
                        %mi x
                        %mrow
                          %mi n
                          %mo ,
                          %mi ℓ
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mfrac
                      %mn 1
                      %mrow
                        %mi ℓ
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} {|[x_n] - x_{n,\ell}|} \le \frac{1}{\ell+1}
              and the triangle inequality is our friend.
            %p
              It is also evident that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} z_n
              converges to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [x_n]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi z
                        %mi n
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [z_n] = [x_n]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi z
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} ([z_n])_n
              converges to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [y]
              in the Cauchy real numbers object. Let
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mi k
                      %mo =
                      %msub
                        %mi y
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} w_k = y_{2k+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi w
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [w]=[y]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              converges twice as fast, i.e.
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} [
                        %mi w
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %msub
                          %mi w
                          %mi k
                        %mo{:stretchy => "false"} |
                      %mo ≤
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 2
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {|[w] - w_k|} \le \frac{1}{2(k+1)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} ((z_{n,k})_k)_n
              is pointwise-eventually-constant convergent to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mi k
                    %annotation{:encoding => "application/x-tex"} w_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x_n]
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [y]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              there exists an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mi N
                  %annotation{:encoding => "application/x-tex"} n\gt N
              implies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %mo{:stretchy => "false"} [
                        %mi w
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mfrac
                        %mn 1
                        %mrow
                          %mn 2
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {|[x_n] - [w]|}\lt \frac{1}{2(k+1)}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %msub
                          %mi y
                          %mrow
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %msub
                          %mi w
                          %mi k
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mfrac
                        %mn 1
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} {|[x_n] - y_{2k+1}|} = {|[x_n] - w_{k}|} \lt \frac{1}{k+1}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi z
                        %mi n
                    %annotation{:encoding => "application/x-tex"} z_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %mo =
                    %msub
                      %mi w
                      %mi k
                  %annotation{:encoding => "application/x-tex"} z_{n,k} = w_k
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo &gt;
                      %mi N
                    %annotation{:encoding => "application/x-tex"} n\gt N
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} (z_{n,k})_n
              is eventually constant at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mi k
                    %annotation{:encoding => "application/x-tex"} w_k
            %p
              Finally, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mrow
                        %mi n
                        %mo ,
                        %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} ((z_{n,k})_k)_n
              converges to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mi k
                  %annotation{:encoding => "application/x-tex"} w_k
              in the object of Cauchy
              = succeed "," do
                %em sequences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi z
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} ([z_n])_n
              in the object of Cauchy
              %em real numbers
              (the quotient by equivalence of Cauchy sequences) must also converge to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi w
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [w]
              there. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi z
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [z_n]=[x_n]
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi w
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [w]=[y]
