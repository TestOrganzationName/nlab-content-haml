          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is
            %strong algebraically closed
            if every non-constant
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            (with one variable and coefficients from
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            can be factored uniquely (up to
            %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
            of the factors) as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mi c
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} x
                  %mo −
                  %msub
                    %mi a
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} p = c \prod_{i = 1}^n (\mathrm{x} - a_i) ,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            and the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi i
                %annotation{:encoding => "application/x-tex"} a_i
            are elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            An
            %strong algebraic closure
            of an arbitrary field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is an algebraically closed field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{k}
            equipped with a field homomorphism (necessarily an
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi k
                  %mo →
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} i: k \to \bar{k}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{k}
            is an
            %a.existingWikiWord{:href => "/nlab/show/algebraic+extension"} algebraic extension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (which means that every element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{k}
            is the root of some non-zero polynomial with coefficients only from
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            is an algebraic closure of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            can also be described as a maximal algebraic extension of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            proves the existence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{k}
            for any field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/splitting+field"} splitting field
            for a more refined result.) However, note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi k
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{k}
            need not be unique up to
            %em unique
            isomorphism, so it's not really appropriate to speak of
            %a.existingWikiWord{:href => "/nlab/show/the"} the
            algebraic closure of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/automorphism"} automorphism
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %p
            Without choice, the existence and uniqueness of algebraic closures may fail; see
            = succeed "," do
              %a{:href => "#Chow06"} Chow06
            = succeed "," do
              %a{:href => "#Banaschewski92"} Banaschewski92
            = succeed "." do
              %a{:href => "#Richman00"} Richman00
          %p
            Even with choice, algebraic closure is not
            %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
            in any reasonable sense. For example, it is very easy to demonstrate that there is no algebraic closure functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ↦
                  %mover
                    %mi F
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} F \mapsto \widebar{F}
            that renders the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi F
                  %mo →
                  %mover
                    %mi F
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} i: F \to \widebar{F}
            natural:
          .num_example
            %h6#example Example
            %p
              Supposing there were such an algebraic closure functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ↦
                      %mover
                        %mi F
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} F \mapsto \widebar{F}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo →
                    %mi ℂ
                    %munderover
                      %mo ⇉
                      %mi conj
                      %mi id
                    %mi ℂ
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \mathbb{R} \to \mathbb{C} \underoverset{conj}{id}{\rightrightarrows} \mathbb{C}.
            %p We would have a commutative naturality diagram (meaning serially commutative on the right)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℝ
                          %mtd
                            %mover
                              %mo →
                              %mi i
                          %mtd
                            %mi ℂ
                          %mtd
                            %munderover
                              %mo ⇉
                              %mi conj
                              %mi id
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi i
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi id
                        %mtr
                          %mtd
                            %mover
                              %mi ℝ
                              %mo ¯
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mi i
                                %mo ¯
                          %mtd
                            %mover
                              %mi ℂ
                              %mo ¯
                          %mtd
                            %munderover
                              %mo ⇉
                              %mover
                                %mi conj
                                %mo ¯
                              %mover
                                %mi id
                                %mo ¯
                          %mtd
                            %mover
                              %mi ℂ
                              %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R} &amp; \stackrel{i}{\to} &amp; \mathbb{C} &amp; \underoverset{conj}{id}{\rightrightarrows} &amp; \mathbb{C} \\
                    \\mathllap{i} \downarrow &amp; &amp; \mathllap{id} \downarrow &amp; &amp; \downarrow \mathrlap{id} \\
                    \\widebar{\mathbb{R}} &amp; \stackrel{\widebar{i}}{\to} &amp; \widebar{\mathbb{C}} &amp; \underoverset{\widebar{conj}}{\widebar{id}}{\rightrightarrows} &amp; \widebar{\mathbb{C}}
                    }
            %p
              where serial commutativity of the right square(s) forces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi id
                        %mo ¯
                      %mo ≠
                      %mover
                        %mi conj
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \widebar{id} \neq \widebar{conj}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo ∘
                    %mi i
                    %mo =
                    %mi conj
                    %mo ∘
                    %mi i
                  %annotation{:encoding => "application/x-tex"} id \circ i = conj \circ i
              on the top forces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi id
                      %mo ¯
                    %mo =
                    %mover
                      %mi conj
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \widebar{id} = \widebar{conj}
              (no matter which isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \widebar{i}
              is taken to be,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                  %annotation{:encoding => "application/x-tex"} id
              or
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi conj
                    %annotation{:encoding => "application/x-tex"} conj
          %p
            Thus, any two algebraic closures are isomorphic, but
            %a.existingWikiWord{:href => "/nlab/show/unnatural+isomorphism"} not naturally
            so.
          %h2#classical_invariants Classical invariants
          %p
            Putting aside the concerns of constructive mathematics, and freely adopting the principle of the
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          .num_theorem
            %h6#theorem Theorem
            %p
              Two algebraically closed fields
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ,
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K, K'
              are isomorphic iff they have the same characteristic
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              (the nonnegative generator of the
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the unique
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              map
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo →
                      %mi K
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \to K
              %a.existingWikiWord{:href => "/nlab/show/transcendence+degree"} transcendence degree
              (the
              %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
              of any maximal set of algebraically independent elements).
          %p
            In outline, the proof is simple in structure. The “only if” statement is clear, provided we allow that transcendence degree is
            = succeed "." do
              %em well-defined
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            contains a subring isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(p)[S]
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a transcendence basis, and similarly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} K'
            contains a subring isomorphic to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ′
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(p)[S']
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi S
                    %mo →
                    %mi S
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f: S \to S'
            %a.existingWikiWord{:href => "/nlab/show/integral+domains"} integral domains
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ′
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(p)[S] \to \mathbb{Z}/(p)[S']
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔽
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝔽
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}(S) \to \mathbb{F}(S')
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ,
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} K, K'
            are algebraic closures of these fields, and one applies a theorem that an isomorphism of fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔽
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi 𝔽
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{F}(S) \to \mathbb{F}(S')
            can be extended to an isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo →
                  %mi K
                  %mo ′
                %annotation{:encoding => "application/x-tex"} K \to K'
            of their algebraic closures.
          %p
            The full details of such a proof carry some themes important in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/model+theory"} model theory
          %ul
            %li
              %p There is a notion of algebraic closure of a subset,
            %li
              %p
                There are prime models (algebraic closure of prime field
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/(p)
            %li
              %p There are notions of independence and basis, and well-defined degree or dimension,
            %li
              %p There are extensions of isomorphisms of independent sets to isomorphisms of their algebraic closures.
          %p Perhaps the most subtle in the list is the notion of independence and well-definedness of (transcendence) degree, which notably involves verification of the Steinitz exchange axiom:
          .num_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be an algebraically closed field, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cl
                    %mo :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} cl: P(K) \to P(K)
              be the operator that takes a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊆
                    %mi K
                  %annotation{:encoding => "application/x-tex"} S \subseteq K
              to the smallest algebraically closed subfield that contains
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cl
                  %annotation{:encoding => "application/x-tex"} cl
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+stability+theory"} pregeometry
          .proof
            %h6#proof Proof
            %p For the moment, please consult Jacobson, Basic Algebra II, Theorem 8.34. This may be expanded upon a little later.
          %p
            Well-definedness of transcendence degree then follows from abstract considerations of pregeometries; see
            = succeed "." do
              %a{:href => "/nlab/show/matroid#welldefined"} this result
          %h2#examples Examples
          %ul
            %li
              %p
                The
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+algebra"} fundamental theorem of algebra
                is, classically, the statement that the
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex number
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %p
                Arguably, this theorem is not entirely algebraic; the algebraic portion is that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi{:mathvariant => "normal"} i
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R[\mathrm{i}]
                is algebraically closed whenever
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real-closed+field"} real-closed field
                %em not
                (as stated) valid in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                form a real closed field
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %li
              %p
                The algebraic closure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ℚ
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{\mathbb{Q}}
                of the
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+numbers"} algebraic numbers
