                %a.existingWikiWord{:href => "/nlab/show/simple+group"} simple group
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomson%27s+group"} Thomson's group
                T.
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                that is not the
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                of any
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/3-manifold"} 3-manifold
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℤ
                        %mn 4
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}^4
            %li
              %p
                Two
                %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
                non-
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
                groups with the same
                = succeed "." do
