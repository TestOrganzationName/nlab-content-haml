                    %annotation{:encoding => "application/x-tex"} Br_n
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Monster+group"} Monster group
          %p Standard examples of non-finite groups include thr
          %ul
            %li
              %p
                group of
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                (under
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/addition"} addition
            %li
              %p
                group of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}\setminus \{0\}
                under
                = succeed "." do
