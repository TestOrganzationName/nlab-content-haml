          %h3#concrete_examples Concrete examples
          %p
            Standard examples of
            %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
            include the
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/group+of+order+2"} group of order 2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \;\mathbb{Z}/2\mathbb{Z}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %msub
