            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi p
                %annotation{:encoding => "application/x-tex"} \epsilon = 1/p
            (so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msup
                      %mi p
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi p
                  %mo =
                  %msup
                    %mi p
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
