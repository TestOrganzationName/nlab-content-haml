                    %annotation{:encoding => "application/x-tex"} U(\tilde{g})
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi g
