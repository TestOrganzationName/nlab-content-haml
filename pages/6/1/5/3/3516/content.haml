          %h2#idea Idea
          %p
            A
            %em solid functor
            (also called a
            = succeed ")" do
              %em semi-topological functor
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U\colon A\to X
            for which the structure of an
            = succeed "-object" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sinks"} sinks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            has not just a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            but all possible “relative” left adjoints.
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is solid,
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            can be constructed in a natural way out of colimits in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            inherits strong cocompleteness properties from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U\colon A\to X
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              \-structured sink
            is a
            %a.existingWikiWord{:href => "/nlab/show/sink"} sink
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %msub
                      %mi a
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi f
                          %mi i
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U a_i \overset{f_i}{\to} x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mi I
                %annotation{:encoding => "application/x-tex"} i\in I
            need not be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
            %strong
              %a.existingWikiWord{:href => "/nlab/show/semi-final+lift"} semi-final lift
            of such a
            = succeed "-structured" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mover
                    %mo →
                    %mi g
                  %mi U
                  %mi b
                %annotation{:encoding => "application/x-tex"} x\overset{g}{\to} U b
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that
          %ol
            %li
              %p
                Every composite
