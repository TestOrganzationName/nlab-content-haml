                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %msub
                      %mi G
                      %mn 2
                    %mi Spaces
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G_1 Spaces
                    \\underoverset
                    {\underset{\phi^\ast}{\longleftarrow}}
                    {\overset{G_2 \times_{G_1} (-)}{\longrightarrow}}
