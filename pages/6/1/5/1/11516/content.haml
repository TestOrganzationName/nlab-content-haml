                      %mn 1
                    %mi Spaces
                    %mover
                      %mo ⟵
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi ϕ
