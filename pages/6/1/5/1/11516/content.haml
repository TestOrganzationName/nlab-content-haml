            %p
          %p
          #InducedActionIsLeftAdjointToPullbackAction.num_prop
            %h6 Proposition
            %p
              %strong (induced action is left adjoint to pullback action)
              %br/
              Given a topological group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:TopologicalGroupHomomorphism"} (1)
              %em induced action
              functor (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InducedAction"}
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the pullback action functor (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#PullbackAction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                    %mi Spaces
                    %munderover
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⊥
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                      %munder
                        %mo ⟵
                        %mrow
                          %msup
                            %mi ϕ
                            %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi G
                            %mn 2
                          %msub
                            %mo ×
                            %mrow
