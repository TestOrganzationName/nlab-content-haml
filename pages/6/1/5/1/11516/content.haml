          %p
            We may call this the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+G-space"} Euclidean G-space
            associated with the linear representation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %h3#representation_spheres Representation spheres
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mi RO
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V \in RO(G)
            be an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on a
            %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
            of the underlying
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi V
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^V
            inherits the
            %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
            of a
            %a.existingWikiWord{:href => "/nlab/show/G-space"} G-space
            with the
            %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} point at infinity
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              \-
              %a.existingWikiWord{:href => "/nlab/show/representation+sphere"} representation sphere
