            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ↔
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"}
                    f \leftrightarrow \tilde f
            %p
              is clearly a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              and hence establishes the
              %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphisms
