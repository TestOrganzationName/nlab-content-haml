              to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G_1
              %a.existingWikiWord{:href => "/nlab/show/fixed+locus"} fixed locus
              in the
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              between
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
