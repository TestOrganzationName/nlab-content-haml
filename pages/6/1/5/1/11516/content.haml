          %h2#idea Idea
          %p
            In the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            %em
              topological
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            (traditionally just
            = succeed "," do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-space
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            equipped with an
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            – the
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivariance+group"} equivariance group
            (usually taken to be the
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            underlying a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
          %p
            The canonical
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            of topological
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
            between these are
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            on the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/interval"} interval
          %p
            A
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+Whitehead+theorem"} equivariant version
            of the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+theorem"} Whitehead theorem
            says that on
            %a.existingWikiWord{:href => "/nlab/show/G-CW+complexes"} G-CW complexes
            these
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
            are equivalently those maps that induce
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
            on all
            %a.existingWikiWord{:href => "/nlab/show/fixed+point"} fixed point
            spaces for all
            %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            (compact subgroups, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is allowed to be a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
          %p
            By
            = succeed "," do
