            %p
          %p
          #FixedLociAsCoinducedActions.num_remark
            %h6 Example
            %p
              %strong (Fixed loci as coinduced actions)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              be a topological subgroup and consider the group homomorphism
              %a.maruku-eqref{:href => "#eq:TopologicalGroupHomomorphism"} (1)
              to be the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              from the
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi G
                    %annotation{:encoding => "application/x-tex"} N(H) \subset G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ≔
                    %mi q
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi N
