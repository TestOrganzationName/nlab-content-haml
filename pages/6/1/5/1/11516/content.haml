            %p
          %h3#LimitsAndColimits Limits and colimits
          %p
            Recalling that the ambient category is assumed to be a
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+monoidal+category"} cartesian closed
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
          %p
          #ForgetfulFunctorCreatesLimitsAndColimits.num_prop
            %h6 Proposition
            %p
              %strong (forgetful functor to spaces creates all limits and colimits)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              from
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/created+limit"} creates
              all
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          (e.g.
          = succeed ")" do
            %a{:href => "#Schwede18"} Schwede 2018, p. 736-737
          .proof
            %h6 Proof
            %p
              Topological
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} algebras
              over the
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G \times (-)
              %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
              in the change-of-group
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              %a{:href => "#ChangeOfGroupsAndFixedLoci"} above
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} 1 \to G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits"} left adjoints preserve colimits
            %p
              Now the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              in question is the respective
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic functor
              and a general theorem (
              %a{:href => "created+limit#MonadicFunctorsCreateLimits"}> this Prop.
              ) says that monadic functors create all limits that exist in their codomain and those colimits which exist there and are preserved by the monad.
          %p
          #CompactlyGeneratedGSpacesFormARegularCategory.num_prop
            %h6 Proposition
            %p
              %strong
                (compactly generated topological
                = succeed "-spaces" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TopSp
                  %annotation{:encoding => "application/x-tex"} TopSp
              denoting the category of
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+weakly+Hausdorff+spaces"} compactly generated weakly Hausdorff spaces
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+Hausdorff+spaces"} compactly generated Hausdorff spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(TopSp)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi TopSp
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G Act(TopSp)
              of topological
              = succeed "-spaces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
          .proof
            %h6 Proof
            %p
              By
              %a{:href => "compactly+generated+topological+space#kHausIsRegular"} this Prop.
              the given convenient category of topological spaces is regular. Since regularity is purely a condition on limits and colimits (
              %a{:href => "regular+category#RegularCategory"}> this Def.
              ) it transfers along any
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              which
              %a.existingWikiWord{:href => "/nlab/show/created+limits"} creates
              limits and colimits. Therefore the statement follows by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ForgetfulFunctorCreatesLimitsAndColimits"}
          %p
          #RecognitionOfCartesianQuotientProjection.num_lemma
            %h6 Lemma
            %p
              %strong (recognition of cartesian quotient projections)
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+group"} compact topological group
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              be morphism of
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
              = succeed "-spaces." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              Then its
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} naturality
              square
            #eq:QuotientSpaceNaturalitySquare.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtr
                          %mtd
                            %mi X
                            %mo{:stretchy => "false"} /
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi f
                                %mo{:stretchy => "false"} /
                                %mi G
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} /
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \&amp;\overset{f}{\longrightarrow}&amp;
                    Y
                    \\\
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\\
                    X/G
                    \&amp;\overset{f/G}{\longrightarrow}&amp;
                    Y/G
                    }
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/pullback+square"} pullback square
              if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isotropy+groups"} isotropy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi x
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi G
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    G_x \,\simeq\, G_{f(x)}
            %p
              as an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/stabilizer"} stabilizer
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %p
            (
            %a{:href => "#BykovFlores15"}> Bykov-Flores 15, Prop. 4.1
            )
          %p
          .num_remark
            %h6 Remark
            %p
              The assumption in Lemma
              %a.maruku-ref{:href => "#RecognitionOfCartesianQuotientProjection"}
              is met in particular when the action on both sides is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              %a.existingWikiWord{:href => "/nlab/show/isotropy+groups"} isotropy groups
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial
            %p
              This is the case in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              without, however, necessarily needing to be
              %a.existingWikiWord{:href => "/nlab/show/locally+trivial"} locally trivial
              for Lemma
              %a.maruku-ref{:href => "#RecognitionOfCartesianQuotientProjection"}
              to apply (“
              %a{:href => "principal+bundle#CartanPrincipalBundles"}> Cartan principal bundles
              ”).
            %p
              On the other hand, even if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is not
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+group"} compact
              but
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to X/G
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} Y \to Y/G
              are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              which are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+trivial"} locally trivial
              %a.maruku-eqref{:href => "#eq:QuotientSpaceNaturalitySquare"} (3)
              is a
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              (since then the universal comparison morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi G
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to Y \times_{X/G} Y/G
              is a morphism of
              %a.existingWikiWord{:href => "/nlab/show/locally+trivial"} locally trivial
              %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
              over the common base space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X/G
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              over which both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi G
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"} Y \times_{X/G} Y/G
              trivialize).
          %h3#equivariant_tietze_extension_theorem Equivariant Tietze extension theorem
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/equivariant+Tietze+extension+theorem"} equivariant Tietze extension theorem
          %h3#ModelStructureAndHomotopyTheory Model structure and homotopy theory
          %p
            The standard
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            on
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            considers
            %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            which are
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            on all (ordinary)
            %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
            for all suitable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/fine+model+structure+on+topological+G-spaces"} fine model structure on topological G-spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-presheaves
            over the
            %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            On the other hand there is also the standard homotopy theory of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-actions"} infinity-actions
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
            = succeed ")." do
              %a{:href => "#Guillou"} Guillou
          %h2#Examples Examples
          %p
            We discuss some classes of examples of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/G-spaces"} G-spaces
          %h3#EuclideanGSpace
            Euclidean
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mi RO
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V \in RO(G)
            be an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on a
            %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
