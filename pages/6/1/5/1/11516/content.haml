            %p
          %h4#CoinducedActions Coinduced action
          %p
          #CoinducedAction.num_defn
            %h6 Definition
            %p
              %strong (coinduced action)
              %br/
            %p
              Given a topological group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
