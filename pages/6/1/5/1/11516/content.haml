              %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant function
              out of the induced action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
