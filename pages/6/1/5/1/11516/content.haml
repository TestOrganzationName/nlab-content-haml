            %p
          %p
          #CoinducedActionIsRightAdjointToPullbackAction.num_prop
            %h6 Proposition
            %p
              %strong (coinduced action is right adjoint to pullback action)
              %br/
            %p
              Given a topological group homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:TopologicalGroupHomomorphism"} (1)
              = succeed ")" do
                %a.maruku-ref{:href => "#PullbackAction"}
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and the coinduced action functor (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoinducedAction"}
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              in a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 1
                    %mi Spaces
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mi Maps
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi G
                            %mn 2
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mrow
                              %msub
                                %mi G
                                %mn 1
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi ϕ
                            %mo *
                    %msub
                      %mi G
                      %mn 2
                    %mi Spaces
                  %annotation{:encoding => "application/x-tex"}
                    G_1 Spaces
                    \\underoverset
                    {
                    \\underset{
                    Maps
                    \\big(
                    G_2, -
                    \\big)^{G_1}
                    }{\longrightarrow}
                    }
                    {
                    \\overset{
                    \\phi^\ast
                    }{
                    \\longleftarrow
                    }
                    }
                    {\bot}
                    G_2 Spaces
            %p
          %p
          .proof
            %h6 Proof
            %p
            %p
              To see the defining
              = succeed "," do
                %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} G_1
              %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϕ
                      %mo *
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi^\ast X
                    \\overset{
                    \\;\;\;
                    f
                    \\;\;\;
                    }{
                    \\longrightarrow
                    }
                    Y
                    \\,.
            %p From this we obtain the following function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mi Maps
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi G
                              %mn 2
                            %mo ,
                            %mi Y
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %msub
                                  %mi G
                                  %mn 1
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi g
                              %mn 2
                            %mo ↦
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 2
                            %mo ⋅
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X
                    \&amp;
                    \\overset{
                    \\tilde f
                    }{
                    \\longrightarrow
                    }
                    \&amp;
                    Maps
                    \\big(
                    G_2,
                    Y
                    \\big)^{G_1}
                    \\\
                    x
                    \&amp;\mapsto&amp;
                    \\big(
                    g_2
                    \\mapsto
                    f( g_2 \cdot x )
                    \\big)
                    \\,,
                    }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} e \in G_2
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
            %p This is manifestly:
            %ul
              %li
                %p
                  well-defined, due to the
                  = succeed "-equivariance" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi G
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} G_1
                  = succeed ";" do
