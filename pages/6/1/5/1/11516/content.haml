                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G_2
              the
              = succeed "-induced" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} G_2
              %a.existingWikiWord{:href => "/nlab/show/group+action"} action
              given by
            #eq:ActionOnG1EquivariantMapsOutOfG2.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi G
                              %mn 2
                            %mo ×
                            %mi Maps
                            %mo{:stretchy => "false"} (
