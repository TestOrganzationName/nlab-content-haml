          %h3#representation_tori Representation tori
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ∈
                  %mi RO
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V \in RO(G)
            be an
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on a
            %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is the
            %a.existingWikiWord{:href => "/nlab/show/point+group"} point group
            of a
            %a.existingWikiWord{:href => "/nlab/show/crystallographic+group"} crystallographic group
            inside the
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+group"} Euclidean group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ⋊
                  %mi G
                  %mo ↪
                  %mi Iso
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  N \rtimes G
                  \\hookrightarrow
                  Iso(\mathbb{R}^V)
          %p
            then the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            on the Euclidean space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi V
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^V
            descends to the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            by the
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the translational
            %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
            %a.existingWikiWord{:href => "/nlab/show/lattice+in+a+vector+space"} lattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            (
            %a{:href => "crystallographic+group#InducedPointGroupActionOnTorus"}> this Prop.
            ). The resulting
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/n-torus"} n-torus
            with
            = succeed "-action," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %em
              %a.existingWikiWord{:href => "/nlab/show/representation+torus"} representation torus
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
