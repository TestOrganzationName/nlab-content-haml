                    \\longrightarrow
                    P const X
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              (by
              = succeed ")," do
                %a{:href => "double+category+of+model+categories#DerivedNaturalTransformationUpToIsos"} this Prop.
            %p Therefore we have a Quillen adjoint triple of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
