                  Quillen
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
          %h2#examples Examples
          %h3#general General
          #QuillenAdjointTripleFromLeftAndRightQuillenFunctor.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
                from left and right
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+functor"} Quillen functor
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ⊥
                                %mphantom
                                  %mi AA
                              %mi L
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟵
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ⊥
                                %mphantom
                                  %mi AA
                              %mi C
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mphantom
                                  %mo ⊥
                                %mphantom
                                  %mi AA
                              %mi R
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\array{
                    \\underoverset{\phantom{AA}\bot\phantom{AA}}{L}{\longrightarrow}
                    \\\
                    \\underoverset{\phantom{AA}\bot\phantom{AA}}{C}{\longleftarrow}
                    \\\
                    \\underoverset{\phantom{AA}\phantom{\bot}\phantom{AA}}{R}{\longrightarrow}
                    }
                    \\mathcal{D}
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is both a
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              as well as a
              %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              for given
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.existingWikiWord{:href => "/nlab/show/structures"} structures
              on the
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenAdjointTriple"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %munderover
                      %mrow
                        %msub
                          %mrow
                          %mphantom
                            %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
                      %mo ⟵
                      %mover
                        %mo ⟶
                        %mi L
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\underoverset
                    {{\longleftarrow}}
                    {\overset{L}{\longrightarrow}}
                    {{}_{\phantom{Qu}}\bot_{Qu}}
                    \\mathcal{D}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %munderover
                      %mrow
                        %msub
                          %mrow
                          %mphantom
                            %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mi C
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\underoverset
                    {\underset{R}{\longrightarrow}}
                    {\overset{C}{\longleftarrow}}
                    {{}_{\phantom{Qu}}\bot_{Qu}}
                    \\mathcal{D}
          .proof
            %h6#proof Proof
            %p
              The condition of a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              %a.maruku-eqref{:href => "#eq:EquivForQuillenAdjointTriple"} (1)
              is trivially satisfied (
              %a{:href => "Quillen+equivalence#TrivialQuillenEquivalence"}> this Prop.
              ). Similarly the required
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
              %a.maruku-eqref{:href => "#eq:Comparison2MorphismForQuillenAdjointTriple"} (2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi A
                                %mi C
                                %mphantom
                                  %mi A
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi C
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi id
                                %mphantom
                                  %mi AA
                          %mtd
                            %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}
                    \&amp;\overset{\phantom{A}C\phantom{A}}{\longrightarrow}&amp;
                    \\mathcal{D}
                    \\\
                    {}^{\mathllap{C}}
                    \\Big\downarrow
                    \&amp;\swArrow_{\mathrlap{id}}&amp;
                    \\Big\downarrow{}^{ \mathrlap{ id } }
                    \\\
                    \\mathcal{D}
                    \&amp;\underset{\phantom{AA}id\phantom{AA}}{\longrightarrow}&amp;
                    \\mathcal{D}
                    }
            %p
              exists trivially. To check that its
              %a.existingWikiWord{:href => "/nlab/show/derived+natural+transformation"} derived natural transformation
              (
              %a{:href => "double+category+of+model+categories#DerivedNaturalTransformation"}> here
              ) is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              we need to check (by
              = succeed ")" do
                %a{:href => "double+category+of+model+categories#DerivedNaturalTransformationUpToIsos"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/fibrant+and+cofibrant+object"} fibrant and cofibrant object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
              the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mrow
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi j
                          %mrow
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                    %mi P
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Q C(d)
                    \\overset{ p_{C(d)} }{\longrightarrow}
                    C(d)
                    \\overset{ j_{C(d)} }{\longrightarrow}
                    P C(C)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant resolution
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              (in fact, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is assumed to be both left and right Quillen, also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(d)
              is a
              %a.existingWikiWord{:href => "/nlab/show/fibrant+and+cofibrant+objects"} fibrant and cofibrant objects
              and hence we may even take both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p_{C(d)}
              as well as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j_{C(d)}
              to be the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
          %h3#homotopy_colimits Homotopy (co-)limits
          #HomotopyLimitQuillenAdjointTriple.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
                of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+limits"} homotopy limits
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} colimits
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, sSet_{Qu}]_{proj/inj}
              for the projective/injective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %munderover
                      %mrow
                        %msub
                          %mo ≃
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi id
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi id
                          %mphantom
                            %mi AA
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                    \\underoverset
                    {\underset{\phantom{AA}id\phantom{AA}}{\longrightarrow}}
                    {\overset{\phantom{AA}id\phantom{AA}}{\longleftarrow}}
                    {\simeq_{Qu}}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
            %p
              (by
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#ModelCategoriesOfSimplicialPresheaves"} this Prop.
            %p
              Moreover, the
              = succeed "-assigning" do
                %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟵
                      %mi const
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet] \overset{const}{\longleftarrow} sSet
            %p
              is clearly a
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
              for the injective model structure, and a
              %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              for the projective model structure.
            %p
              Together this means that in the
              %a.existingWikiWord{:href => "/nlab/show/double+category+of+model+categories"} double category of model categories
              we have a
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi sSet
                              %mi Qu
                          %mtd
                            %mover
                              %mo ⟶
                              %mi const
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %msub
                              %mi sSet
                              %mi Qu
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi proj
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi const
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mpadded{:width => "0"}
                                %mi id
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mi id
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %msub
                              %mi sSet
                              %mi Qu
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi inj
                          %mtd
                            %munder
                              %mo ⟶
                              %mi id
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %msub
                              %mi sSet
                              %mi Qu
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi inj
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    sSet_{Qu}
                    \&amp;\overset{const}{\longrightarrow}&amp;
                    [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
                    \\\
                    {}^{\mathllap{const}}
                    \\Big\downarrow
                    \&amp;\swArrow_{\mathrlap{id}}&amp;
                    \\Big\downarrow{}^{ \mathrlap{ id } }
                    \\\
                    [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                    \&amp;\underset{id}{\longrightarrow}&amp;
                    [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                    }
            %p
              Moreover, the
              %a.existingWikiWord{:href => "/nlab/show/derived+natural+transformation"} derived natural transformation
