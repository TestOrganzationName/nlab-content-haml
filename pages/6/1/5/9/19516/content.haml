            %p
              then so do the corresponding
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              on the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy categories
          .proof
            %h6#proof_6 Proof
            %p
              The existence of the derived
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              followy by Prop.
              %a.maruku-ref{:href => "#QuillenAdjointTripleInducesAdjointTripleOfDerivedFunctors"}
              and by uniqueness of adjoints (
              %a{:href => "adjoint+functor#UniquenessOfAdjoints"}> this Prop.
              ).
            %p
              The statement about fully faithful functors is Lemma
              = succeed "." do
                %a.maruku-ref{:href => "#DerivedAdjointModalityFromQuillenAdjointQuadruple"}
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
              is by
              %a{:href => "geometry+of+physics+--+categories+and+toposes#ModalOperatorsEquivalentToReflectiveSubcategories"} this Prop.
