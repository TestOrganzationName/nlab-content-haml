                    A(\Phi)
                    \&amp; =
                    \\underset{\Sigma}{\int} g(x) (\Phi(x))^2 \,dvol_\Sigma(x)
                    \\\
                    \&amp; =
                    \\underset{\Sigma \times \Sigma}{\int}
                    \\underset{ = \alpha^{(2)}}{
                    \\underbrace{
                    g(x_1)
                    \\delta(x_1 - x_2)
                    }}
                    \\,
                    \\Phi(x_1) \Phi(x_2) \, dvol_\Sigma(x_1) \, dvol_\Sigma(x_2)
                    \\end{aligned}
                    \\,.
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Σ
                    %mo ×
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} (x_1, x_2) \in \Sigma \times \Sigma
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ≃
                    %mi U
                    %mo ⊂
                    %mi X
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n} \simeq U \subset X \times X
              a
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              around this point, the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⋅
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \cdot \delta(-,-)
              restricted to this chart is proportional to the Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat g
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              evaluated at the sum of the two covectors:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mn 1
                            %mo ,
                            %msub
                              %mi k
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                            %munder
                              %mo ∫
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mn 2
                                    %mi n
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mi δ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi k
                                  %mn 1
                                %mo ⋅
                                %msub
                                  %mi x
                                  %mn 1
                                %mo +
                                %msub
                                  %mi k
                                  %mn 2
                                %mo ⋅
                                %msub
                                  %mi x
                                  %mn 2
                                %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ∝
                            %mover
                              %mi g
                              %mo{:stretchy => "false"} ^
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi k
                              %mn 1
                            %mo +
                            %msub
                              %mi k
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (k_1, k_2)
                    \&amp; \mapsto
                    \\underset{\mathbb{R}^{2n}}{\int}
                    g(x_1)
                    \\delta(x_1, x_2)
                    e^{i (k_1 \cdot x_1 + k_2 \cdot x_2 )}
                    \\, dvol_\Sigma(x_1) \, dvol_\Sigma(x_2)
                    \\\
                    \&amp; \propto \hat g(k_1 + k_2)
                    \\end{aligned}
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a plain
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi g
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat g
              is quickly decaying (according to
              = succeed ")" do
                %a{:href => "compactly+supported+distribution#eq:DecayEstimateForFourierTransformOfNonSingularDistribution"} this inequality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo +
                    %msub
                      %mi k
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} k_1 + k_2
              (
              %a{:href => "wavefront+set#EmptyWaveFronSetCorrespondsToOrdinaryFunction"}> this prop.
              ), as long as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mn 1
                      %mo +
                      %msub
                        %mi k
                        %mn 2
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k_1 + k_2 \neq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mn 1
                    %mo +
                    %msub
                      %mi k
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k_1 + k_2 = 0
              the Fourier transform is constant, and hence in particular not decaying.
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/WaveFrontSetOfDeltaDistributionInTwoVariables.png", :width => "200"}/
            %p#WaveFrontOfdeltaxy
              This means that the wave front set consists of the elements of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, (k, -k))
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \neq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi k
                  %annotation{:encoding => "application/x-tex"} -k
              are both in the
              %a.existingWikiWord{:href => "/nlab/show/closed+future+cone"} closed future cone
              or both in the
              %a.existingWikiWord{:href => "/nlab/show/closed+past+cone"} closed past cone
              precisely if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ⋅
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \cdot \delta(-,-)
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+observable"} microcausal
            %blockquote
              %p
                (graphics grabbed from
                = succeed ")" do
                  %a{:href => "#KhavkineMoretti14"} Khavkine-Moretti 14, p. 45
          %p This shows that microcausality in this case is related to conservation of momentum in the point interaction.
          %p More generally:
          #CompactlySupportedPolynomialLocalDensities.num_example
            %h6#example_3 Example
            %p
              %strong
                (polynomial
                %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                are microcausal)
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mrow
                        %mi h
                        %mo ,
                        %mi v
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{poly}^{h,v}(E)
            %p
              for the space of differential forms on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              which locally are
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              in the field variables.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℱ
                      %mi loc
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ⊗
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi poly
                          %mrow
                            %mn 0
                            %mo ,
                            %mn 0
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %msubsup
                      %mi Ω
                      %mi poly
                      %mrow
                        %mi d
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{F}_{loc}
                    \\; \subset \;
                    C^\infty_c(\Sigma) \underset{\Omega_{poly}^{0,0}(E)}{\otimes} \Omega_{poly}^{d,0}(E)
            %p
              for the subspace of
              %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              (
              %a.existingWikiWord{:href => "/nlab/show/local+Lagrangian+densities"}> local Lagrangian densities
              ) of those which are
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compactly supported
              with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
              (
              %a.existingWikiWord{:href => "/nlab/show/local+observables"}> local observables
              ) and
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              with respect to the field variables.
            %p
              Every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ∈
                    %msub
                      %mi ℱ
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} L \in \mathcal{F}_{loc}
              induces a functional
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_\Sigma(E) \longrightarrow \mathbb{R}
            %p
              by
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integration
              of the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              along the
              %a.existingWikiWord{:href => "/nlab/show/jet+prolongation"} jet prolongation
              of a given
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/section"} section
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo ↦
                    %msub
                      %mo ∫
                      %mi Σ
                    %msup
                      %mi j
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi \mapsto \int_{\Sigma} j^\infty(\phi)^\ast L
                    \\,.
            %p
              These functionals happen to be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/microcausal+functional"} microcausal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℱ
                      %mi loc
                    %mo ↪
                    %msub
                      %mi ℱ
                      %mi mc
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{F}_{loc} \hookrightarrow \mathcal{F}_{mc}
            %p
              into the space of microcausal functionals (e.g.
              = succeed ")." do
                %a{:href => "#FredenhagenRejzner12"} Fredenhagen-Rejzner 12, p. 21
              %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense subspace
              inclusion (e.g.
              = succeed ")" do
                %a{:href => "#FredenhagenRejzner12"} Fredenhagen-Rejzner 12, p. 23
          %h2#properties Properties
          .num_prop
            %h6#proposition Proposition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℱ
                      %mi reg
                    %mo ⊂
                    %msub
                      %mi ℱ
                      %mi mc
                  %annotation{:encoding => "application/x-tex"} \mathcal{F}_{reg} \subset \mathcal{F}_{mc}
              for that subalgebra of the algebra of microcausal functionals whose
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/non-singular+distributions"} non-singular distributions
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℱ
                      %mi reg
                    %mo ⟶
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\langle -\rangle
                    \\;\colon\;
                    \\mathcal{F}_{reg}
                    \\longrightarrow
                    \\mathbb{C}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"} state
              on regular observables which is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-free+Hadamard+state"} quasi-free Hadamard
              %a.existingWikiWord{:href => "/nlab/show/extensions"} extends
              to a state on microcausal functionsal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi ℱ
                              %mi reg
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} ⟨
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mi ℂ
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∃
                                  %mo !
                                  %mo{:stretchy => "false"} ⟨
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} ⟩
                        %mtr
                          %mtd
                            %msub
                              %mi ℱ
                              %mi mc
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{F}_{reg}
                    \&amp;\overset{\langle -\rangle}{\longrightarrow}&amp;
                    \\mathbb{C}
                    \\\
                    \\downarrow &amp; \nearrow_{\mathrlap{\exists ! \langle -\rangle}}
                    \\\
                    \\mathcal{F}_{mc}
                    }
          %p
            (
            %a{:href => "#HollandRuan01"}> Hollands-Ruan 01, remark 1 on p. 12
            , implied by
            = succeed "," do
              %a{:href => "#BrunettiFredenhagen00"} Brunetti-Fredenhagen 00
            = succeed "," do
              %a{:href => "#HollandsWald01"} Hollands-Wald 01
            = succeed ")" do
              %a{:href => "#HollandRuan01"} Hollands-Ruan 01, theorem III.1 (ii)
          %h2#related_concepts Related concepts
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/quantum+probability+theory"} quantum probability theory
                –
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                and
                %a.existingWikiWord{:href => "/nlab/show/states"} states
            %ul
              %li
                %p
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/states"} states
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/classical+state"} classical state
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/quantum+state"} quantum state
                    %ul
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/space+of+states+%28in+geometric+quantization%29"} space of states (in geometric quantization)
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/state+on+a+star-algebra"}> state on a star-algebra
                          ,
                          %a.existingWikiWord{:href => "/nlab/show/quasi-state"} quasi-state
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/qbit"}> qbit
                          ,
                          %a.existingWikiWord{:href => "/nlab/show/Bell+state"} Bell state
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/dimer"}> dimer
                          ,
                          %a.existingWikiWord{:href => "/nlab/show/tensor+network+state"} tensor network state
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/quantum+state+preparation"} quantum state preparation
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/probability+amplitude"}> probability amplitude
                          ,
                          %a.existingWikiWord{:href => "/nlab/show/quantum+fluctuation"} quantum fluctuation
                      %li
                        %p
                          %a.existingWikiWord{:href => "/nlab/show/pure+state"} pure state
                        %ul
                          %li
                            %p
