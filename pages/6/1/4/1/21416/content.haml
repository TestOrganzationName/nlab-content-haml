          %title Contents
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#HadronsAsKKModesOf5dYangMillsTheoryReferences"} Hadrons as KK-modes of 5d Yang-Mills theory
              %li
