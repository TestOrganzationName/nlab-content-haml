                  = succeed "," do
                    %em Stringy excited baryons in holographic QCD
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/2001.01461"} arXiv:2001.01461
            %p
              In relation to
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+monopoles"} Yang-Mills monopoles
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Stefano+Bolognesi"}> Stefano Bolognesi
                ,
                = succeed "," do
                  %em
                    Solitons, Large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    and Holography
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/Bolognesi_SolitonsHolography.pdf", :title => "pdf"} pdf
            %p
