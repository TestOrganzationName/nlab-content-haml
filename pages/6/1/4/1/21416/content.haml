                    %a{:href => "https://arxiv.org/abs/1902.07444"} arXiv:1902.07444
              %li
                %p
                  Yasuhiro Hayashi, Takahiro Ogino,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Tadakatsu+Sakai"} Tadakatsu Sakai
                  = succeed "," do
