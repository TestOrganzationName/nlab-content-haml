                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} inv
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
