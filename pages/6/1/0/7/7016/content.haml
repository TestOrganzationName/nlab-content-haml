            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            of
            %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            to
            %a.existingWikiWord{:href => "/nlab/show/dependent+products"} dependent products
            of pointwise identity types), which one may use for expressing function extensionality
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:FunctionExtensionalityInTypeTheory"} (2)
            %a.existingWikiWord{:href => "/nlab/show/path+induction"} path induction
            (see
