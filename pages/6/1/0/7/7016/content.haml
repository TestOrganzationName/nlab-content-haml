                  %annotation{:encoding => "application/x-tex"} Id_A(a,a')
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            are in general not
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mere+propositions"} mere propositions
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/types"} types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
