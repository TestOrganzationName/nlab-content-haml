                  %mo ′
                %annotation{:encoding => "application/x-tex"} a = a'
            is replaced by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            %a.existingWikiWord{:href => "/nlab/show/terms"} terms
            of
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Id
