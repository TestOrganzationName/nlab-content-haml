            and
            %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel
            %a.existingWikiWord{:href => "/nlab/show/function+type"} functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
