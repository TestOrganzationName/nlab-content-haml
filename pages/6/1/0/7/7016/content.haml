          %p
            %br/
          %h3#judgmental_function_extensionality Judgmental function extensionality
          %p
            One could replace the equivalences of types above with
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
            of types, which results in
            = succeed "." do
              %strong judgmental function extensionality
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} g:A \to B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %msub
                    %mi id
                    %mi B
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  Id_{(A \to B)}(f, g)
                  \\;\;\equiv\;
                  \\prod_{x:A}
                  id_B\big(
                  f(x)
                  ,\,
                  g(x)
                  \\big)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Id
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≡
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi Id
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi Id
                    %mi B
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  Id_{(A \to B)}
                  (f ,\, g)
                  \\;\equiv\;
                  \\prod_{x:A}
                  \\prod_{y:A}
                  \\prod_{p \colon Id_A(x, y)}
                  Id_B\big(
                  f(x) ,\, g(y)
                  \\big)
          %p respectively.
          %h3#for_judgmental_equality_of_sections For judgmental equality of sections
          %p
            Suppose that given functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} f:A \to B
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g:A \to B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} x:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g(x)
            are
            %a.existingWikiWord{:href => "/nlab/show/judgmentally+equal"} judgmentally equal
            to each other
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f(x) \equiv g(x):B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            are judgmentally equal to each other,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ≡
                    %mi g
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \equiv g:A \to B
            %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            with judgmental computation rules.
          %h2#Properties Properties
          %p
            There are a number of axioms in
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            which imply function extensionality. These include
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            %li
              %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            %li
              an
              %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
              with
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental
              %a.existingWikiWord{:href => "/nlab/show/computation+rules"} computation rules
            %li
              %a.existingWikiWord{:href => "/nlab/show/equality+reflection"} equality reflection
              in
              %a.existingWikiWord{:href => "/nlab/show/extensional+type+theory"} extensional type theory
            %li
              the axiom which states that every type is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
          %h3#relation_to_weak_function_extensionality  Relation to weak function extensionality
          %p
            Function extensionality is equivalent to
            %a.existingWikiWord{:href => "/nlab/show/weak+function+extensionality"} weak function extensionality
            – see at
            = succeed "." do
              %em
                %a{:href => "#ReferencesGeneral"} References – General
          %h3#relation_to_the_univalence_axiom Relation to the univalence axiom
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/univalence+axiom"} univalence axiom
            implies type-theoretic function extensionality
            %a.maruku-eqref{:href => "#eq:FunctionExtensionalityInTypeTheory"} (2)
            – see at
            = succeed "." do
              %em
                %a{:href => "#ReferencesInHomotopyTypeTheory"} References – in HoTT
          %h3#relation_to_interval_types Relation to interval types
          %p
            Postulating an
            %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            with
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental
            %a.existingWikiWord{:href => "/nlab/show/computation+rules"} computation rules
            for the point constructors of the interval type implies function extensionality.
          %p
            The proof assumes a typal
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+rule"} uniqueness rule
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Id
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_f \colon Id_{\mathbb{I}}(0, 1) \to Id_A(f(0),f(1))
            be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+application+to+identities"} function application to identities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} concat
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                  %mo :
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{concat}_{a, b, c}: Id_A(a , b) \times Id_A(b , c) \to Id_A(a , c)
            be concatenation of identities (i.e.
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/transitivity"} transitivity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} inv
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                  %mo :
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Id
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{inv}_{a, b}: Id_A(a , b) \to Id_A(b , a)
            be the inverse of identities (i.e.
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/symmetry"} symmetry
          %p
            First the proof constructs a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo :
                  %mi A
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi 𝕀
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k:A \to (\mathbb{I} \to B)
            from a dependent function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %msub
                      %mi Id
                      %mi B
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} h:\prod_{x:A} Id_B\big(f(x) , g(x)\big)
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi β
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mn 0
                      %mo :
                      %msub
                        %mi Id
                        %mi B
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \beta_{k(x)}^0 : Id_B\big(k(x)(0) , f(x)\big)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi β
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mn 1
                      %mo :
                      %msub
                        %mi Id
                        %mi B
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} \beta_{k(x)}^1 : Id_B\big( k(x)(1) , g(x) \big)
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi β
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mi p
                      %mo :
                      %msub
                        %mi Id
                        %mrow
                          %msub
                            %mi Id
                            %mi B
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi{:mathvariant => "normal"} concat
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi{:mathvariant => "normal"} concat
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi g
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi β
                        %mrow
                          %mi k
                          %mo{:stretchy => "false"} (
