                  %div
                    %p
                      %a{:href => "/nlab/edit/infinity-limits+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#in_homotopy_theory"} In homotopy theory
                %li
                  %a{:href => "#as_a_monad"} As a monad
                %li
                  %a{:href => "#in_category_theory"} In category theory
                %li
                  %a{:href => "#ConesOverADiagram"} Cones over a diagram
                %li
                  %a{:href => "#over_a_diagram_in_an_category"}
                    Over a diagram in an
                    = succeed "-category" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn ∞
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\infty,1)
              %li
                %a{:href => "#see_also"} See also
          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %em cone
            of a
            %a.existingWikiWord{:href => "/nlab/show/space"} space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the space obtained by taking the
            = succeed "-shaped" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} X \times I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            may be an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the standard interval
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi I
                %annotation{:encoding => "application/x-tex"} X \times I
            really is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cylinder"} cylinder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is likewise a cone.
          %p
            This notion also makes sense when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is taken to be the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ 0 \to 1 \}
            %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
          %p
            Another, perhaps more common, meaning of ‘cone’ in category theory is that of a
            = succeed "." do
              %em
                cone over (or under) a
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            over the cone category, as above. Explicitly, a cone over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi J
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F\colon J \to C
            is an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            to each vertex of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %em new
            triangle arising in this way
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+triangle"} commutes
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %em
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            is sometimes used for the case when we squash the other end of the interval; thus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            is equipped with a morphism
            %em to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            %em from
            each vertex of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            (but
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            itself still belongs to
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %a.existingWikiWord{:href => "/nlab/show/mapping+cocone"} cocone
            is used for a different dualization.
          %p
            This definition generalizes to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            a cone over an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            is essentially a cone in the sense of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %h2#definition Definition
          %h3#in_homotopy_theory In homotopy theory
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a space, then the cone of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pushout"} homotopy pushout
            of the identity on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            along the unique map to the point:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi cone
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp; \to &amp; X \\
                  \\downarrow &amp; &amp; \downarrow \\
                  * &amp; \to &amp; cone(X)
                  }\,.
          %p
            This homotopy pushout can be computed as the ordinary
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi cone
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi X
                  %mo ×
                  %mi I
                  %msub
                    %mo ⨿
                    %mi X
                  %mo *
                %annotation{:encoding => "application/x-tex"} cone(X) := X\times I \amalg_X *
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi d
                                %mn 1
                        %mtd
                          %mi X
                          %mo ×
                          %mi I
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi cone
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp;\stackrel{d_1}{\to} &amp; X \times I
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  * &amp;\to&amp; cone(X)
                  }
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with the point.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/mapping+cone"} mapping cone
            (q.v.) of a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            is then the pushout along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            of the inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \to cone(X)
          %h3#as_a_monad As a monad
          %p
            In contexts where
            %a.existingWikiWord{:href => "/nlab/show/intervals"} intervals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            can be treated as
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            objects, the cone construction as quotient of a cylinder with one end identified with a point,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi I
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mi p
                  %mo ,
                %annotation{:encoding => "application/x-tex"} C(X) = I \times X/(0 \times X) \sim p,
          %p
            carries a structure of
            %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            and an absorbing element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is the constant map at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            together with
          %ul
            %li
              %p
                An
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of the monoid,
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo :
                        %mi I
                        %mo ×
                        %mi X
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} a: I \times X \to X
            %li
              %p
                A constant or basepoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 1
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x_0 \colon 1 \to X
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi x
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a(0, x) = x_0
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            with finite products and a suitable interval object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            as monoid (for example,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I = [0, 1]
            is a monoid under real multiplication, or under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi min
                %annotation{:encoding => "application/x-tex"} min
            as multiplication). Under some reasonable assumptions (e.g., if the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            has quotients, and these are preserved by the functor
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ×
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %annotation{:encoding => "application/x-tex"} I \times -
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            and the free
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            will be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(X)
            as described above. The category of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-objects," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} ↓
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} 1 \downarrow \mathbf{C}
          %p
            These observations apply for example to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            where the
            %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            is a monoid in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            under the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi min
                %annotation{:encoding => "application/x-tex"} min
            operation (see below).
          %p
            If in addition the underlying category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponentiable+object"} exponentiable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            on pointed
            = succeed "-objects" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            which can be regarded as a
            %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
            construction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mn 1
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msup
                            %mi X
                            %mi I
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi eval
                                %mn 0
                        %mtd
                          %mi X
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P(X) &amp; \to &amp; 1 \\
                  \\downarrow &amp; &amp; \downarrow \\
                  X^I &amp; \stackrel{eval_0}{\to} &amp; X.
                  }
          %p
            For general abstract reasons, the right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            carries a comonad structure whereby
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "-coalgebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/decalage"} decalage
          %h3#in_category_theory In category theory
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a category, then the cone of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %span.newWikiWord
              cocomma category
              %a{:href => "/nlab/new/cocomma+category"} ?
            of the identity on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and the unique map to the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mo →
                        %mtd
                          %mi C
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ⇒
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi cone
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C &amp; \to &amp; C \\
                  \\downarrow &amp; \Rightarrow  &amp; \downarrow \\
                  * &amp; \to &amp; cone(C)
                  }\,.
          %p Again, this may be computed as a pushout:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi C
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi d
                                %mn 1
                        %mtd
                          %mi C
                          %mo ×
                          %mstyle{:mathvariant => "bold"}
                            %mn 2
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo →
                        %mtd
                          %mi cone
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C &amp;\stackrel{d_1}{\to} &amp; C \times \mathbf{2}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  * &amp;\to&amp; cone(C)
                  }
                  \\,.
          %p
            The cone of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            may equivalently be thought of, or defined, as the result of adjoining a new
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#ConesOverADiagram Cones over a diagram
          %p
            A cone
            %em in
            a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is given by a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi J
                %annotation{:encoding => "application/x-tex"} J
            together with a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cone
                    %mo{:stretchy => "false"} (
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} cone(J) \to C
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of the cocomma category, to give such a functor is to give an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi J
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F \colon J \to C
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} T: \Delta(c) \to F
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi J
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \Delta(c):J\to C
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant functor
            at the object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %em cone over the diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            In other words, a cone consists of morphisms (called the
            %strong components
            of the cone)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi j
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi c
                  %mo ⟶
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  T_j
                  \\;\colon\;
                  c \longrightarrow F(j)
                  \\,,
          %p
            one for each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(f): F(j) \to F(k)
            of the diagram, in the sense that each diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mrow
                        %mtd
                          %mrow
                        %mtd
                          %mi c
                        %mtd
                          %mrow
                        %mtd
                          %mrow
                      %mtr
                        %mtd
                          %mrow
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi T
                                  %mi j
                          %mo ↙
                        %mtd
                          %mrow
                        %mtd
                          %mo ↘
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %msub
                                  %mi T
                                  %mi k
                        %mtd
                          %mrow
                      %mtr
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi j
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mrow
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mrow
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  {}&amp;{}&amp;c&amp;{}&amp;{}
                  \\\
                  {}&amp;
                  \\mathllap{\scriptsize{T_j}}\swarrow
                  \&amp;{}&amp;
                  \\searrow\mathrlap{\scriptsize{T_k}} &amp;{}
                  \\\
                  F(j)
                  \&amp;{}&amp;
                  \\stackrel{F(f)}{\longrightarrow} &amp;{}&amp; F(k)
                  \\\
                  }
          %p commutes.
          %p
            It’s called a
            %em cone
            because one pictures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            as sitting at the vertex, and the diagram itself as forming the base of the cone.
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of such cones is a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Δ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha\colon \Delta(c)\to\Delta(c')
            such that the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mrow
                        %mtd
                          %mover
                            %mo ⟶
                            %mi α
                        %mtd
                          %mrow
                        %mtd
                          %mi Δ
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo ′
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mrow
                        %mtd
                          %mpadded{:lspace => "-100%width", :width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mi T
                          %mo ↘
                        %mtd
                          %mrow
                        %mtd
                          %mo ↙
                          %mpadded{:width => "0"}
                            %mstyle{:scriptlevel => "1"}
                              %mrow
                                %mi T
                                %mo ′
                        %mtd
                          %mrow
                      %mtr
                        %mtd
                          %mrow
                        %mtd
                          %mrow
                        %mtd
                          %mi F
                        %mtd
                          %mrow
                        %mtd
                          %mrow
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Delta(c)
                  \&amp;{}&amp;\overset{\alpha}{\longrightarrow} &amp;{}&amp;
                  \\Delta(c')
                  \\\
                  {}&amp;
                  \\mathllap{\scriptsize{T}}\searrow
                  \&amp;{}&amp;
                  \\swarrow\mathrlap{\scriptsize{T'}} &amp;{}
                  \\\
                  {}&amp;{}&amp;F&amp;{}&amp;{}
                  }
          %p
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commutes
            \. Note that naturality of any such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            implies that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
