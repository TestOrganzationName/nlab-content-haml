                %annotation{:encoding => "application/x-tex"} f \in C
            is the
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
