            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo →
                    %mi r
                  %mover
                    %mo →
                    %mi s
                %annotation{:encoding => "application/x-tex"} \stackrel{r}{\to}\stackrel{s}{\to}
            takes the value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(r)\cdot g(s)
          %p
            In order to get back a transformation between vector bundles on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
