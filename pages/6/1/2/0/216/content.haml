            convolution
            %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
            %a.existingWikiWord{:href => "/nlab/show/Banach+algebras"} Banach algebras
            hence over their envoloping
            = succeed "-algebras." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
