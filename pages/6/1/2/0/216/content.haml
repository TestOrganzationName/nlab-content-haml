                        \\,.
          #AsConvolutionAlgebra.num_remark
            %h6#remark Remark
            %p
              We may identify elements in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[\mathcal{C}_1]
              with
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_1 \to R
              with the property that they are non-vanishing only on finitely many elements. Under this identification for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ϕ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \phi_1, \phi_2
              two such functions, their product in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[\mathcal{C}]
              is given by the formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ↦
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                        %mo ∘
                        %msub
                          %mi f
                          %mn 1
                        %mo =
                        %mi f
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_1 \cdot \phi_2
                    \\;
                    \\colon
                    \\;
                    f \mapsto
                    \\sum_{f_2 \circ f_1 = f}
                    \\phi_2(f_2)
                    \\cdot
                    \\phi_1(f_1)
                    \\,,
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %msub
                        %mi f
                        %mn 2
                      %mo ∈
                      %msub
                        %mi 𝒞
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} f,f_1,f_2 \in \mathcal{C}_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              so that every
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              has an
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              then this is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo ↦
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi g
                        %mo ∈
                        %msub
                          %mi 𝒞
                          %mn 1
                    %msub
                      %mi ϕ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ∘
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi ϕ
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_1 \cdot \phi_2
                    \\;
                    \\colon
                    \\;
                    f \mapsto
                    \=
                    \\sum_{g \in \mathcal{C}_1}
                    \\phi_2(f \circ g^{-1})
                    \\cdot
                    \\phi_1(g)
                    \\,.
            %p
              This expresses
              %a.existingWikiWord{:href => "/nlab/show/convolution"} convolution
              of functions.
          #InvolutionByPullbackAlongInversion.num_defn
            %h6#remark_2 Remark
            %p
              If the small category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_\bullet
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inversion
              map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo →
                    %msub
                      %mi 𝒞
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    inv \colon \mathcal{C}_1 \to \mathcal{C}_1
            %p
              then
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+functions"} pullback of functions
              along this map is an
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              of the convolution algebra of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and hence makes it into a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
            %p
              More generally for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              equipped with the structure of a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dagger-category"} dagger-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi 𝒞
                      %mn 1
                    %mo →
                    %msub
                      %mi 𝒞
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\dagger \colon \mathcal{C}_1 \to \mathcal{C}_1
            %p makes the convolution algebra a star-algebra.
          #catalgebraIsWeakHopfalgebra.num_defn
            %h6#remark_3 Remark
            %p
              If the category has finitely many objects and finitely many morphisms, then the category algebra is also a coalgebra via the unique comultiplication where every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 1
                    %mo ⊂
                    %mi R
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi C
                      %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C_1\subset R[C_1]
              is group like; the structure of the coalgebra and that of an algebra are compatible in the sense that they form a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+Hopf+algebra"} weak Hopf algebra
          %h3#ForLieGroupoids For Lie groupoids
          %p
            We discuss groupoid convolution
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
            for
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
            %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
            (def.
            = succeed "," do
              %a.maruku-ref{:href => "#ContinuousCategoryAlgebraWithHalfDensities"}
            %a.maruku-ref{:href => "#GroupoidConvolutionIs2Functor"}
            below).
          #ForLieGroupoids.num_remark
            %h6#remark_4 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a groupoid with extra
              %a.existingWikiWord{:href => "/nlab/show/geometry"} geometric
              structure, then there are natural variants of the above definition.
            %p
              Notably if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              then there is a variant where the functions in remark
              %a.maruku-ref{:href => "#AsConvolutionAlgebra"}
              are taken to be
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              and where the convolution
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              is replaced by an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              %a.existingWikiWord{:href => "/nlab/show/densities"} densities
              over the
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_1
            %p
              More generally, for a
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
              over a Lie groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_1
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of this line bundle tensored with half-densities.
          %p
            See the
            = succeed "." do
              %a{:href => "#ReferencesForSmoothGeometry"} References – For continuous/smooth geometry
          #ContinuousCategoryAlgebraWithHalfDensities.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid+convolution+algebra"}> Lie groupoid convolution algebra
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty_c(\mathcal{G}_1, \sqrt{\Omega})
              for the space of smooth
              %a.existingWikiWord{:href => "/nlab/show/half-densities"} half-densities
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mrow
                        %mi d
                        %mi s
                        %mo =
                        %mn 0
                    %msub
                      %mi Γ
                      %mn 1
                    %mo ⊕
                    %msub
                      %mi T
                      %mrow
                        %mi d
                        %mi t
                        %mo =
                        %mn 0
                    %msub
                      %mi Γ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_{d s = 0}\Gamma_1 \oplus T_{d t = 0}\Gamma_1
              of
              %a.existingWikiWord{:href => "/nlab/show/compact+support"} compact support
              on its
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_1
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi C
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi C
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi C
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\star \;\colon\; C_c(\mathcal{G}_1, \sqrt{\Omega}) \times C_c(\mathcal{G}_1, \sqrt{\Omega}) \to C_c(\mathcal{G}_1, \sqrt{\Omega})
            %p
              be given on elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo ∈
                    %msub
                      %mi C
                      %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f,g \in C_c(\mathcal{G}_1, \sqrt{\Omega})
              over any element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ∈
                    %msub
                      %mi 𝒢
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \gamma \in \mathcal{G}_1
              by the
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ⋆
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi γ
                    %mo ↦
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi γ
                          %mn 2
                        %mo ∘
                        %msub
                          %mi γ
                          %mn 1
                        %mo =
                        %mi γ
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi γ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f \star g) \colon \gamma
                    \\mapsto
                    \\int_{\gamma_2\circ \gamma_1 = \gamma}
                    f(\gamma_1) \cdot f(\gamma_2)
                    \\,.
            %p
              (Here we regard the integrand naturally as taking values in actual
              %a.existingWikiWord{:href => "/nlab/show/densities"} densities
              tensored with the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mi Ω
                  %annotation{:encoding => "application/x-tex"} \sqrt{\Omega}
              along the composition map. This defines the
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              of density-factor which then takes values in
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mi Ω
                    %annotation{:encoding => "application/x-tex"} \sqrt{\Omega}
            %p
              The algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⋆
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C_c^\infty(\mathcal{G}_1, \sqrt{\Omega}), \star)
              is the
              %strong groupoid convolution algebra
              of smooth compactly supported functions. As in remark
              = succeed "," do
                %a.maruku-ref{:href => "#AsConvolutionAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/star-algebra"} star-algebra
              with
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi inv
                        %mo *
                    %annotation{:encoding => "application/x-tex"} inv^\ast
          %p
            This construction originates around (
            %a{:href => "#Connes82"}> Connes 82
            ).
          .num_prop
            %h6#propositiondefinition Proposition/Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi 𝒢
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x \in \mathcal{G}_0
              any point in the manifold of
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              there is an involutive
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \pi_x
              of the convolution algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⋆
                    %mo ,
                    %msup
                      %mi inv
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C_c^\infty(\mathcal{G}_1, \sqrt{\Omega}), \star, inv^\ast)
              of def.
              %a.maruku-ref{:href => "#ContinuousCategoryAlgebraWithHalfDensities"}
              on the
              %a.existingWikiWord{:href => "/nlab/show/canonical+Hilbert+space+of+half-densities"} canonical Hilbert space of half-densities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^2(s^{-1}(x))
              of the source fiber of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              given on any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo ∈
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi \in L^2(s^{-1}(x))
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mi ξ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi γ
                    %mo ↦
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi γ
                          %mn 1
                        %mo ∈
                        %msup
                          %mi t
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi γ
                        %mo{:stretchy => "false"} )
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ξ
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi γ
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_x(f) \xi \colon \gamma
                    \\mapsto
                    \\int_{\gamma_1 \in t^{-1}(\gamma)}
                    f(\gamma_1) \xi(\gamma_1^{-1}\gamma)
                    \\,.
            %p
              This defines a
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} |{\Vert \Vert}
              on the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %mi Ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_c^\infty(\mathcal{G}_1, \Omega)
              given by the
              %a.existingWikiWord{:href => "/nlab/show/supremum"} supremum
              of the norms in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi L
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L^2(s^{-1}(x))
              over all points
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi f
                      %mo{:stretchy => "false"} ‖
                    %mo ≔
                    %msub
                      %mi Sup
                      %mrow
                        %mi x
                        %mo ∈
                        %msub
                          %mi 𝒢
                          %mn 0
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %msub
                        %mi π
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ‖
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    {\Vert f\Vert}
                    \\coloneqq
                    Sup_{x \in \mathcal{G}_0} {\Vert \pi_x(f)\Vert}
                    \\,.
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+completion"} Cauchy completion
              of the
              %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi C
                      %mi c
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mn 1
                    %mo ,
                    %msqrt
                      %mi Ω
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⋆
                    %mo ,
                    %msup
                      %mi inv
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C_c^\infty(\mathcal{G}_1, \sqrt{\Omega}), \star, inv^\ast)
              with respect to this
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/C-star-algebra"} C-star-algebra
              %strong
                convolution
                = succeed "-algebra" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
              of the Lie groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
          %p
            This is recalled at (
            %a{:href => "#Connes94"}> Connes 94, prop. 3 on p. 106
            ).
          #ExtensionToBibundlesAndBimodules.num_remark
            %h6#remark_5 Remark
            %p
              With suitable definitions, this construction constitutes something at least close to a
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              from
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
              to
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebras"} C-star-algebras
              and
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+bimodules"} Hilbert bimodules
              between them:
            %p
              In (
              %a{:href => "#Mrcun99"}> Mrčun 99
              ) the convolution algebra construction for
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+Lie+groupoids"} étale Lie groupoids
              is extended to groupoid
              %a.existingWikiWord{:href => "/nlab/show/bibundles"} bibundles
              and shown to produce a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              to
              %a.existingWikiWord{:href => "/nlab/show/C-star-algebras"} C-star-algebras
              with (isomorphism classes of)
              %a.existingWikiWord{:href => "/nlab/show/bimodules"} bimodules
              between them. In (
              %a{:href => "#KalisnikMrcun"}> Kališnik-Mrčun 07
              ) it is shown that if one remembers the additional
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebroid"} Hopf algebroid
              structure on the convolution
              = succeed "-alegras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %a.existingWikiWord{:href => "/nlab/show/atlas"} atlas
              of the
              %a.existingWikiWord{:href => "/nlab/show/differentiable+stack"} differentiable stack
              of a Lie groupoid) then this construction becomes a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion of étale Lie groupoids into their convolution Hopf algebroids.
            %p
              In (
              %a{:href => "#MuhleReaultWilliams87"}> Muhly-Renault-Williams 87
              ,
              = succeed ")" do
                %a{:href => "#Landsman00"} Landsman 00
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              %a.existingWikiWord{:href => "/nlab/show/bibundle"} bibundle
              to general
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
              is discussed (not necessarily
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+Lie+groupoid"} étale
              %a.existingWikiWord{:href => "/nlab/show/Morita+equivalence"} Morita equivalence
              bimodules (no discussion of composition and functoriality here).
          %p
            A precise form of this statement is the following
            %a{:href => "#Nuiten13"} Nuiten 13, theorem 3.3.1
          #GroupoidConvolutionIs2Functor.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
                is
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-functor"} (2,1)-functor
                from
                %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
                to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
            %p
              The above construction of groupoid convolution algebras (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContinuousCategoryAlgebraWithHalfDensities"}
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-functor"} (2,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi DiffStack
                      %mi prop
                    %mover
                      %mo ⟶
                      %mphantom
                        %mi AAA
                    %msup
                      %mi C
                      %mo *
                    %msubsup
                      %mi Alg
                      %mi bim
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    C^\ast(-)
                    \\;\colon\;
                    DiffStack^{prop}
                    \\overset{\phantom{AAA}}{\longrightarrow}
                    C^\ast Alg^{op}_{bim}
            %p between
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi DiffStack
                          %mi prop
                      %annotation{:encoding => "application/x-tex"} DiffStack_{prop}
                  of
                  %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
                  (i.e.
                  %a.existingWikiWord{:href => "/nlab/show/Lie+groupoids"} Lie groupoids
                  regarded as
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+stacks"} smooth stacks
                  = succeed ")" do
                    %a{:href => "#Nuiten13"} Nuiten 13, def. 2.2.35
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/opposite+2-category"} opposite
                  %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
                  with
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+bimodules"} Hilbert bimodules
                  between them and
                  %a.existingWikiWord{:href => "/nlab/show/intertwiners"} intertwiners
                  between those.
          %p
            (
            %a{:href => "#Nuiten13"}> Nuiten 13, theorem 3.3.1
            )
          %p
            This way, much of
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            is exhibited as actually being the
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            of
            %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
            inside all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+stacks"} smooth stacks
            %a.existingWikiWord{:href => "/nlab/show/groupoid+K-theory"} groupoid K-theory
            is realized as the
            %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            of convolution C
            %em -algebras.
          %h2#equivalent_characterizations Equivalent characterizations
          %p We discuss equivalent characterizations of category algebras/groupoid algebras that are useful in certain context
          %ul
            %li
              %p
                %a{:href => "#WeakColimit"} As a weak colimit over a constant 2Vect-valued functor
            %li
              %p
                %a{:href => "#InTermsOfCompositionOfSpans"} In terms of composition of spans
          %h3#WeakColimit
            As a weak colimit over a constant
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} 2Vect
          %p
            Apparently for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            a
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            the category algebra of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %a.existingWikiWord{:href => "/nlab/show/weak+limit"} weak colimit
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            of the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo →
                  %mi Vect
                  %mtext -
                  %mi Mod
                %annotation{:encoding => "application/x-tex"} \mathcal{C} \to Vect\text{-}Mod
            constant on the ground field algebra.
          %p
            This statement is for instance in (
            %a{:href => "#FHLT"}> FHLT, section 8.4
            ).
          %p
            The 2-cell in the universal co-cone corresponding to the morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
