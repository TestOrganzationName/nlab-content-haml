                      %mo ∘
                      %mi r
                      %mo =
                      %mi t
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (f\star g) : t \mapsto \sum_{s\circ r = t}
                  f(r)\cdot g(s)
                  \\,.
          %p This is indeed the product in the category algebra.
          %p
            Looking at category algebras realizes them as a puny special case of a bigger story which involves
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/bi-brane"} bi-brane
            = succeed "-bundles/" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-gerbes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
          %ul
            %li
              %a.existingWikiWord{:href => "/schreiber/show/Nonabelian+cocycles+and+their+quantum+symmetries"}> Nonabelian cocycles and their quantum symmetries
              \.
          %p This is related to observations such as described here:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
                ,
                %a{:href => "http://golem.ph.utexas.edu/category/2007/03/quantization_and_cohomology_we_16.html"}
                  %em Quantization and Cohomology (Week 17)
            %li
              %p
                Urs Schreiber,
                %a{:href => "http://golem.ph.utexas.edu/category/2007/02/qft_of_charged_nparticle_tdual.html"}
                  %em QFT of Charged n-Particle: T-Duality
          %h2#examples Examples
          %h3#basic_examples Basic examples
          .num_example
            %h6#example Example
            %p
              The convolution algebra of a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/set"} set
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              regarded as a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/discrete+groupoid"} discrete groupoid
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              with only
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              is the ordinary
              %a.existingWikiWord{:href => "/nlab/show/function+algebra"} function algebra
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              the convolution algebra of the
              %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pair
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Pair(X)_\bullet
              is the
              %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                    %mo ×
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi X
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert X\vert} \times {\vert X\vert}
              matrices.
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pair
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} Pair(X)_\bullet
              its
              %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/Lie+groupoid"} Lie groupoid
              its smooth convolution algebra is the algebra of
              %a.existingWikiWord{:href => "/nlab/show/smoothing+kernels"} smoothing kernels
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_example
            %h6#example_4 Example
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = \mathbf{B}G
              is the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              of a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (the groupoid with a single object and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              as its set of morphisms), then def.
              %a.maruku-ref{:href => "#CategoryAlgebra"}
              reduces to that of the
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
