          %p
            The result is the
            %a.existingWikiWord{:href => "/nlab/show/convolution+product"} convolution product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
