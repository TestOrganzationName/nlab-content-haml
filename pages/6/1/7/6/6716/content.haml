                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(2)
                satisfies the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                defining
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin^c(3)
                as a quotient.
            %li
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 4
                      %annotation{:encoding => "application/x-tex"} n=4
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Spin%E1%B6%9C%284%29"} Spinᶜ(4)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} {
                      %mo ±
                      %mo{:stretchy => "false"} (
                      %mi I
