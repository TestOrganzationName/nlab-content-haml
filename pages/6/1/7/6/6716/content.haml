                        %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(4)
                subgroup can be seen as the subgroup of pairs of unitary matrices with both of them having determinant 1.
            %li
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 6
                      %annotation{:encoding => "application/x-tex"} n=6
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Spin%E1%B6%9C%286%29"} Spinᶜ(6)
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Spin%286%29"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 6
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(6) \simeq SU(4)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(4)\times U(1) \to U(4)
                analogous to the above, it can be seen that the group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mn 6
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin^c(6)
                is the connected
                %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 4
                      %mo{:stretchy => "false"} )
