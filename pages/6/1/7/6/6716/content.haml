                      Spin^c(4)
                      \= \big(SU(2)\times SU(2)\times U(1)\big) / \{\pm(I,I,1)\}
                      \\simeq U(2)\times_{U(1)} U(2).
              %p
                This latter group is the
                %a.existingWikiWord{:href => "/nlab/show/fibre+product"} fibre product
                of groups over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi det
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{(A,B)\in U(2)\times U(2)\mid \det(A) = \det(B)\}
                (
                %a{:href => "#OzbagciStipsicz"} Ozbagci–Stipsicz 2004
                Section 6.3). The construction can be seen by considering the surjective homomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      SU(2) \times SU(2) \times U(1)
                      \\to SU(2) \times SU(2) \times U(1) \times U(2)
                      \\to U(2) \times U(2)
              %p
                defined by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi B
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mi A
                        %mo ,
                        %mi z
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (A,B,z) \mapsto (z A,z B)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ×
                          %mrow
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(2)\times_{U(1)} U(2)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Spin
                          %mi c
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin^c(3)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi B
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A,B,z)
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mi A
                        %mo =
                        %mi I
                        %mo =
                        %mi z
                        %mi B
                      %annotation{:encoding => "application/x-tex"} z A = I = z B
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo =
                        %mi B
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mi I
                      %annotation{:encoding => "application/x-tex"} A = B = (1/z) I
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi det
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
