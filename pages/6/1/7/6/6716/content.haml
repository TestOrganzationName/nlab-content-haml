                    %annotation{:encoding => "application/x-tex"} \mathbf{c}_1 mod 2
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}Spin^c
              of the Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                  %annotation{:encoding => "application/x-tex"} Spin^c
              in
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the universal third smooth
              %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+class"} integral Stiefel-Whitney class
              from
              = succeed "." do
                %a.maruku-ref{:href => "#SmoothRefinementOfBockstein"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msup
                      %mi Spin
                      %mi c
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi SO
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi W
                          %mn 3
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}Spin^c
                    \\to
                    \\mathbf{B} SO
                    \\stackrel{\mathbf{W}_3}{\to}
                    \\mathbf{B}^2 U(1)
                    \\,,
          .proof
            %h6#proof_5 Proof
            %p
              Then consider the
              %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msup
                              %mi Spin
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi c
                                    %mn 1
                                  %mi mod
                                  %mn 2
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi SO
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi w
                                  %mn 2
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %msub
                              %mi ℤ
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mstyle{:mathvariant => "bold"}
                                    %mi β
                                  %mn 2
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{B}Spin^c
                    \&amp;\to&amp;
                    \\mathbf{B} U(1)
                    \&amp;\to&amp;
                    {*}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathbf{c}_1 mod 2}} &amp;&amp; \downarrow
                    \\\
                    \\mathbf{B} SO
                    \&amp;\stackrel{\mathbf{w}_2}{\to}&amp;
                    \\mathbf{B}^2 \mathbb{Z}_2
                    \&amp;\stackrel{\mathbf{\beta}_2}{\to}&amp;
                    \\mathbf{B}^2 U(1)
                    }
                    \\,.
            %p
              The right square is a homotopy pullback by prop.
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyFiberOfSmoothBeta2"}
              = succeed "." do
                %a.maruku-ref{:href => "#SpinCAsHomotopyPullbackOfW2AndC1"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi W
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbf{W}_3
              by prop
              = succeed "." do
                %a.maruku-ref{:href => "#SmoothRefinementOfBockstein"}
            %p
              This implies by claim by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
          %h3#relation_to_metaplectic_group_
            Relation to metaplectic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
