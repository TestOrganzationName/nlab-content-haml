          %h2#definition Definition
          .num_remark
            %h6#remark Remark
            %p
              By definition of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(n)
              there is a canonical inclusion
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                    %mo ↪
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/2\mathbb{Z}\hookrightarrow Spin(n)
            %p
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+of+order+2"} group of order 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(n)\hookrightarrow GL_1(Cl(\mathbb{R}^n))
              canonically realized by even
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              elements of unit norm, this is given by the inclusion of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{+1,-1\}
          %blockquote
            %p
              We frequently write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              as shorthand for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
          #DirectDefinitionOfSpinC.num_defn
            %h6#definition_2 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spin
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin^c(n)
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi Spin
                              %mi c
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ×
                              %mrow
                                %msub
                                  %mi ℤ
                                  %mn 2
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mrow
                              %msub
                                %mi ℤ
                                %mn 2
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Spin^c(n) &amp; \coloneqq Spin(n) \times_{\mathbb{Z}_2} U(1)
                    \\\
                    \&amp; = (Spin(n) \times U(1))/{\mathbb{Z}_2}
                    \\,,
                    \\end{aligned}
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              with the
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              by the common
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} sub
              %a.existingWikiWord{:href => "/nlab/show/group+of+order+2"} group of order 2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ↪
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \hookrightarrow Spin
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ↪
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \hookrightarrow U(1)
              (i.e.: the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/central+product+group"} central product group
          %p
            Usually only the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 3
                %annotation{:encoding => "application/x-tex"} n \geq 3
            is considered.
          %p
            Some authors (e.g.
            = succeed ")" do
              %a{:href => "#Gompf97"} Gompf 97, p. 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi Spin
                            %mi c
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≔
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  Spin^c(n)
                  \&amp; \coloneqq
                  Spin(n)\cdot Spin(2)
                  \\\
                  \&amp; \simeq Spin(n) \cdot U(1)
                  \\end{aligned}
          %p
            following the notation
            %a.existingWikiWord{:href => "/nlab/show/Sp%28n%29.Sp%281%29"} Sp(n).Sp(1)
            (see
            = succeed ")." do
              %a{:href => "SpnSp1#SpinnSpin2IsSpinc"} there
          %h2#examples Examples
          %ul
            %li
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo =
                        %mn 3
                      %annotation{:encoding => "application/x-tex"} n=3
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/U%282%29"} U(2)
                %a.existingWikiWord{:href => "/nlab/show/exceptional+isomorphism"} exceptional isomorphism
                between
                %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
                and
                %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
                extends to an isomorphism between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spin^c(3)
                and the
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(2)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Spin
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mo{:stretchy => "false"} (
