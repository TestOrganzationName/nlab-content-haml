                corresponding to the (unique) index-2 subgroup
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 2
                        %mi ℤ
                        %mo ↪
                        %mi ℤ
                        %mo ≃
                        %msub
                          %mi π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 2\mathbb{Z} \hookrightarrow \mathbb{Z} \simeq \pi_1(U(4))
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi μ
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} \mu_4
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/roots+of+unity"} roots of unity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi μ
                        %mn 4
