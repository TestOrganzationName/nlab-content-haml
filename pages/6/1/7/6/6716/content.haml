              %p
                over the exceptional isomorphism
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/SO%283%29"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi PU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} SO(3) \simeq PU(2)
                %a.existingWikiWord{:href => "/nlab/show/quotient+groups"} quotient groups
                are quotients by the respective
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/centers"} centers
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
                (
                %a{:href => "#OzbagciStipsicz"} Ozbagci–Stipsicz 2004
                Section 6.2). This isomorphism follows from considering the surjective homomorphism
                %a.existingWikiWord{:href => "/nlab/show/SU%282%29"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(2) \times U(1) \to U(2)
                given by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mi z
                        %mi A
                      %annotation{:encoding => "application/x-tex"} (A,z) \mapsto z A
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                is precisely
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo ±
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
