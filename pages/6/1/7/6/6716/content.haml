                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \zeta\mapsto (\zeta^{-1}I,\zeta)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
