                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mo =
                        %mo ±
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} z=\pm 1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi B
                      %mo =
                      %mo ±
                      %mi I
                    %annotation{:encoding => "application/x-tex"} A=B=\pm I
                with the same sign as
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                      %annotation{:encoding => "application/x-tex"} z
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo ±
                        %mo{:stretchy => "false"} (
                        %mi I
