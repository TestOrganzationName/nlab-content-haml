                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed "-modules" do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi W
                            %mi k
                        %annotation{:encoding => "application/x-tex"} W_k
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  on which
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  is bijective.
              %li
                %p
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Fiu
                          %mi k
                        %mo →
                        %msub
                          %mi Tor
                          %mi F
                        %msub
                          %mi D
                          %mi k
                        %mo −
                        %mi Mod
                        %mo ↪
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Fiu_k\to Tor_F D_k-Mod\hookrightarrow M(G)
                  between the category of affine étale unipotent
                  = succeed "-groups" do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                  = succeed "-modules" do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
