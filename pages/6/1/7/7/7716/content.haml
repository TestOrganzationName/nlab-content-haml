                  is bijective.
            %p
              (
              %a{:href => "#lecturesOnPDivGroups"}> Demazure p.69
              )
          .proof
            %h6#proof Proof
            %p
              This follows from the theorem, and the fact that if
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is finite, then G is étale (resp, infinitesimal) if and only if
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi G
                  %annotation{:encoding => "application/x-tex"} F_G
              is an isomorphism (resp.
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mi G
                      %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} F_G^n = 0
              for large
              = succeed ")." do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          .num_example
            %h6#example Example
            %ol
              %li
                %p
                  If
                  = succeed "," do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} /
