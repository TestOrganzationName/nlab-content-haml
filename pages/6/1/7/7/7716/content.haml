                          %msub
                            %mo{:stretchy => "false"} )
                            %mi k
                          %mo ∈
                          %msub
                            %mi Feu
                            %mi k
                        %annotation{:encoding => "application/x-tex"} G=(\mathbb{Z}/p\mathbb{Z})_k\in Feu_k
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi k
                      %annotation{:encoding => "application/x-tex"} M(G)=k
                  with
                  = succeed "," do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} F=1
                  = succeed "." do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} V=0
              %li
                %p
                  If
                  = succeed "," do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo =
                          %mi p
                          %msub
                            %mi α
                            %mi k
                          %mo ∈
                          %msub
                            %mi Fiu
                            %mi k
                        %annotation{:encoding => "application/x-tex"} G=p \alpha_k\in Fiu_k
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi k
