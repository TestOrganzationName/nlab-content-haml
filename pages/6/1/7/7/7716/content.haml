                  = succeed "." do
                    %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} V=0
          .num_cor
            %h6#corollary Corollary
            %p
              For
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %msub
                      %mi Feu
                      %mi k
                  %annotation{:encoding => "application/x-tex"} G\in Feu_k
              or
              = succeed "," do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ∈
                      %msub
                        %mi Fiu
                        %mi k
                    %annotation{:encoding => "application/x-tex"} G\in Fiu_k
            .maruku-equation
              %code.maruku-mathml rk(G)= p^{length(M(G))
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ,
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m,n
              be two positive integers. Then
            %ol
              %li
                The canonical injection
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi m
                        %mrow
                          %msub
                            %mi W
                            %mi n
                      %mo →
                      %msub
                        %mi W
                        %mi n
                    %annotation{:encoding => "application/x-tex"} m^{W_n}\to W_n
                defines an element
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo ∈
                      %mi M
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi m
                        %mrow
                          %msub
                            %mi W
                            %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} u\in M(m^{W_n})
                satisfying
                = succeed "." do
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi V
                          %mi n
                        %mi u
                        %mo =
                        %msup
                          %mi F
                          %mi n
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} V^n u= F^n= 0
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_48.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi λ
                      %mrow
                        %mi n
                        %mo ,
                        %mi m
                    %mo :
                    %msub
                      %mi D
                      %mi k
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi k
                    %msup
                      %mi F
                      %mi m
                    %mo +
                    %mi D
                    %msup
                      %mi V
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi M
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi m
                      %mi n
                      %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda_{n,m}: D_k/(D_k F^m + D V^n)\to M(m^W_n)
            %p which is bijective.
          .num_theorem
            %h6#theorem Theorem
            %p There is an isomorphism
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_49.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} M(D(G))\to M(G)^*
            %p
              In prose this means that the autoduality
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ↦
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G\mapsto D(G)
              of
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fiu
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Fiu_k
              corresponds via the Dieudonné-functor
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              to the autoduality
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo →
                    %msup
                      %mi M
                      %mo *
                  %annotation{:encoding => "application/x-tex"} M\to M^*
              in the category
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fin
                    %msub
                      %mi Tor
                      %mrow
                        %mi V
                        %mo ,
                        %mi F
                    %msub
                      %mi D
                      %mi k
                    %mo −
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} fin Tor_{V,F}D_k-Mod
              of
              = succeed "-modules" do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi k
                    %annotation{:encoding => "application/x-tex"} D_k
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              and
              = succeed "." do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          .num_defn
            %h6#definition Definition
            %p
              (Dieudonné-module of an infinitesimal multiplicative
              = succeed "-group)" do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Let
              = succeed "." do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ∈
                      %msub
                        %mi Fim
                        %mi k
                    %annotation{:encoding => "application/x-tex"} G\in Fim_k
              %em
                Dieudonné-module of
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo *
                    %annotation{:encoding => "application/x-tex"} M(G)*
                is defined by
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_61.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} M(G)=M(D(G))^*
            %p
              It follows by the
              %a.existingWikiWord{:href => "/nlab/show/Cartier+duality"} Cartier duality
              between
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fim
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Fim_k
              and
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Feu
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Feu_k
              that the functor
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ↦
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G\mapsto M(G)
              induces a contravariant equivalence
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_65.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fim
                      %mi k
                    %mo →
                    %mi fin
                    %msub
                      %mi Tor
                      %mi F
                    %msub
                      %mi Bij
                      %mi V
                    %msub
                      %mi D
                      %mi k
                    %mo −
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Fim_k\to  fin Tor_F Bij_V D_k-Mod
            %p
              between
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_66.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fim
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Fim_k
              and the category of all
              = succeed "-modules" do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi k
                    %annotation{:encoding => "application/x-tex"} D_k
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_68.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is nilpotent and
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is bijective.
          .num_remark
            %h6#remark Remark
            %p
              Let
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %msub
                      %mi Fimd
                      %mi k
                  %annotation{:encoding => "application/x-tex"} G\in Fimd_k
              (i.e.
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %msub
                      %mi Fim
                      %mi k
                  %annotation{:encoding => "application/x-tex"} G\in Fim_k
              and
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              diagonalizable).
            %p
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi G
                    %mo =
                    %mi D
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G=D(\Gamma_k)
              \. Then
              = succeed "," do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Γ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} D(G)\simeq \Gamma_k
            %p
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_75.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi colim
                    %msub
                      %mi Acu
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Γ
                      %mi k
                    %mo ,
                    %msub
                      %mi W
                      %mi nk
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi colimGr
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %msub
                      %mi W
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Gr
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %msub
                      %mi W
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Mod
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mo ,
                    %msub
                      %mi W
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Mod
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mi Γ
                    %mo ,
                    %msub
                      %mi W
                      %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(D(G))=colim Acu_k(\Gamma_k,W_{nk})=colimGr(\Gamma,W_n(k))=Gr(\Gamma,W_\infty)=Mod_{W(k)}(W(k)\otimes_\mathbb{Z},W_\infty)=Mod_{W(k)}(W(k)\otimes_\mathbb{Z} \Gamma, W_\infty)
            %p and hence
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_76.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi k
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℤ
                    %mi Γ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi π
                  %annotation{:encoding => "application/x-tex"} M(G)\simeq(W(\overline k)\otimes_\mathbb{Z}\Gamma)^\pi
            %p
              where
              = succeed "," do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mn ∞
                      %mo =
                      %mi Quot
                      %mo{:stretchy => "false"} (
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi colim
                        %mi n
                      %msub
                        %mi W
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %munder
                        %mi W
                        %mo ̲
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W_\infty=Quot(W(k))/W(k)=colim_n W_n(k)=\underline W(k)
            %p
              For
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_79.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              we have
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_80.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ⊗
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi λ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi p
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} F(\lambda \otimes \chi)=\lambda^{(p)}\otimes p\chi
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_81.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ⊗
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi λ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi p
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} V(\lambda \otimes \chi)=\lambda^{(p^{-1})}\otimes p\chi
          .num_theorem
            %h6#theorem_2 Theorem
            %p a) The Dieudonné functor
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_82.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
                              %msub
                                %mi F
                                %mi p
                              %msub
                                %mo
                                %mi k
                              %mo =
                              %msub
                                %mi Fiu
                                %mi k
                              %mo ×
                              %msub
                                %mi Feu
                                %mi k
                              %mo ×
                              %msub
                                %mi Fim
                                %mi k
                              %mo →
                              %mo{:stretchy => "false"} (
                              %mi fin
                              %mi W
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                              %mo −
                              %mi Mod
                              %mo ,
                              %mi F
                              %mo ,
                              %mi V
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mi G
                              %mo →
                              %mi M
                              %mo{:stretchy => "false"} (
                              %mi G
                              %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{cases}
                    F_p_k=Fiu_k\times Feu_k\times Fim_k\to (fin W(k)-Mod,F,V)
                    \\\
                    G\to M(G)
                    \\end{cases}
            %p
              is a contravariant equivalence between all finite
              = succeed "-groups" do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-torsion," do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_85.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %msub
                      %mi F
                      %mi M
                    %mo ,
                    %msub
                      %mi V
                      %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M,F_M,V_M)
              where
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is a finite length
              = succeed "-module" do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(k)
              = succeed "," do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi M
                    %annotation{:encoding => "application/x-tex"} F_M
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi M
                  %annotation{:encoding => "application/x-tex"} V_M
              two group endomorphisms of
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              satisfying
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_91.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi M
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi λ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi F
                      %mi M
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_M(\lambda m)=\lambda^{(p)} F_M(m)
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_92.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi M
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi λ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi λ
                    %msub
                      %mi V
                      %mi M
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_M(\lambda^{(p)}m)=\lambda V_M(m)
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_93.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi M
                    %msub
                      %mi V
                      %mi M
                    %mo =
                    %msub
                      %mi V
                      %mi M
                    %msub
                      %mi F
                      %mi M
                    %mo =
                    %mi p
                    %mo ⋅
                    %msub
                      %mi id
                      %mi M
                  %annotation{:encoding => "application/x-tex"} F_M V_M=V_M F_M=p\cdot id_M
            %p
              b)
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_94.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is étale, infinitesimal, unipotent or multiplicative according as
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_95.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi M
                  %annotation{:encoding => "application/x-tex"} F_M
              is isomorphic,
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_96.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi M
                  %annotation{:encoding => "application/x-tex"} F_M
              is nilpotent,
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_97.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi M
                  %annotation{:encoding => "application/x-tex"} V_M
              is nilpotent, or
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_98.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi M
                  %annotation{:encoding => "application/x-tex"} V_M
              is isomorphic
            %p
              c) For any
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_99.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %msub
                      %mi Fp
                      %mi k
                  %annotation{:encoding => "application/x-tex"} G\in Fp_k
              we have
              = succeed "." do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_100.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi rk
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi p
                        %mrow
                          %mi length
                          %mi M
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} rk(G)=p^{length M(G)}
            %p
              d) If
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_101.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is a perfect extension of
              = succeed "," do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_102.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_103.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} M(D(G))=M(G)^*
