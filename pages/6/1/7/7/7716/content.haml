        #revision
          %p This entry is about a section of the text
          %ul
            %li
              Michel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Demazure%2C+lectures+on+p-divisible+groups"} Demazure, lectures on p-divisible groups
              %a{:href => "http://sites.google.com/site/mtnpdivisblegroupsworkshop/lecture-notes-on-p-divisible-groups"} web
          %p
            Recall from
            %span.newWikiWord
              relation of certain classes of k-groups
              %a{:href => "/nlab/new/relation+of+certain+classes+of+k-groups"} ?
            the following:
          %ol
            %li
              %p
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Feu
                        %mi k
                    %annotation{:encoding => "application/x-tex"} Feu_k
                denotes the category of formal étale unipotent affine
                = succeed "-groups." do
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %li
              %p
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Fiu
                        %mi k
                    %annotation{:encoding => "application/x-tex"} Fiu_k
                denotes the category of formal infinitesimal unipotent
                = succeed "-groups." do
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %li
              %p
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(k)
                denotes the Witt ring over
                = succeed "." do
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
            %li
              %p
                For
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi k
                    %annotation{:encoding => "application/x-tex"} D_k
                see
                %span.newWikiWord
                  D_k-module
                  %a{:href => "/nlab/new/D_k-module"} ?
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/III.5%2C+Dieudonn%C3%A9+modules+%28affine+unipotent+groups%29"} III.5, Dieudonné modules (affine unipotent groups)
            %li
              .maruku-equation
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_8.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo :
                      %mrow
                        %mo {
                        %mrow
                          %mtable{:columnalign => "left left", :displaystyle => "false"}
                            %mtr
                              %mtd
                                %msub
                                  %mi Acu
                                  %mi k
                              %mtd
                                %mo →
                              %mtd
                                %mi W
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                                %mo −
                                %mi Mod
                            %mtr
                              %mtd
                                %mi G
                              %mtd
                                %mo ↦
                              %mtd
                                %mi M
                                %mo{:stretchy => "false"} (
                                %mi G
                                %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      M:\begin{cases}
                      Acu_k&amp;\to&amp; W(k)-Mod
                      \\\
                      G&amp;\mapsto&amp;M(G)
                      \\end{cases}
          %p
            is a contravariant functor from affine commutative unipotent
            = succeed "-groups" do
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-modules." do
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(k)
          %p
            Recall moreover from
            %a.existingWikiWord{:href => "/nlab/show/III.5%2C+Dieudonn%C3%A9+modules+%28affine+unipotent+groups%29"} III.5, Dieudonné modules (affine unipotent groups)
            that
            %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Tor
                    %mi V
                  %msub
                    %mi D
                    %mi k
                  %mo −
                  %mi Mod
                  %mo :
                  %mo =
                  %msub
                    %mi Acu
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %msub
                    %mi W
                    %mi nk
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi m
                  %mo ∈
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi V
                    %mi n
                  %mi m
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Tor_V D_k-Mod:=Acu_k(G,W_{nk})=\{m\in M(G)|V^n m =0\}
            is a submodule.
          %p
            which are
            = succeed "-modules" do
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(k)
            = succeed "," do
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Verschiebung+morphism"} Verschiebung morphism
            = succeed "," do
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Frobenius+morphism"} Frobenius morphism
            = succeed ")." do
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .num_prop
            %h6#proposition Proposition
            %p (formulation of the statement is unclear) The functor
            .maruku-equation
              %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_16.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo :
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
                              %msub
                                %mi Acu
                                %mi k
                            %mtd
                              %mo →
                            %mtd
                              %mi W
                              %mo{:stretchy => "false"} (
                              %mi k
                              %mo{:stretchy => "false"} )
                              %mo −
                              %mi Mod
                          %mtr
                            %mtd
                              %mi G
                            %mtd
                              %mo ↦
                            %mtd
                              %mi M
                              %mo{:stretchy => "false"} (
                              %mi G
                              %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    M:\begin{cases}
                    Acu_k&amp;\to&amp; W(k)-Mod
                    \\\
                    G&amp;\mapsto&amp;M(G)
                    \\end{cases}
            %p
              which is a contravariant functor from affine commutative unipotent
              = succeed "-groups" do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-modules" do
                %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(k)
            %ol
              %li
                %p
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Feu
                          %mi k
                        %mo →
                        %msub
                          %mi Tor
                          %mi V
                        %msub
                          %mi D
                          %mi k
                        %mo −
                        %mi Mod
                        %mo ↪
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Feu_k\to Tor_V D_k-Mod\hookrightarrow M(G)
                  between the category of affine étale unipotent
