                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  (and killed by a power of
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  ?)on which
                  %math#mathml_b248f216ae58a24f43d78fb0a7008d123924afdc_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
