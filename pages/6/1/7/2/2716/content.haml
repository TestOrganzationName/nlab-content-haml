          %h2#idea Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Lie+n-algebroid"} Lie n-algebroid
            is
            %em symplectic
            if it is equipped with a non-degenerate binary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            on a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong
                symplectic Lie
                = succeed "-algebroid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              is a pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathfrak{a}, \langle -,- \rangle)
            %p consisting of
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Lie+n-algebroid"} Lie n-algebroid
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔞
                        %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              %li
                %p
                  a binary
                  %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⟨
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} \langle- , - \rangle
                  of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+2)
                %p
                  (a closed element in the shifted elements of the
                  %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
                %p which is non-degenerate.
          %h2#properties Properties
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
            that witnesses this transgression is the Lagrangian of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/AKSZ+theory"} AKSZ theory
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                %annotation{:encoding => "application/x-tex"} \mathfrak{a}
            as its target space and the invariant polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -,- \rangle
            as the (
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of) its background
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
          %h2#examples Examples
          %h3#_symplectic_manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n=0
            \: symplectic manifold
          %p
            A 0-Lie algebroid is just a
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            is the algebra of smooth functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CE(X) = C^\infty(X)
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  W(X) = \Omega^\bullet(X)
          %p
            the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham algebra
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is therefore a non-degenerate closed
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} 2-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^2(X)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic 2-form
          .standout
            %p
              A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X,\;\; \omega)
            %p
              consisting of a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and a symplectic 2-form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
          %h3#PoissonManifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            \: Poisson manifold
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with Poisson bivector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo ∈
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi \in \Gamma(T X) \wedge \Gamma(T X)
            the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
            of the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔞
                  %mo ≔
                  %mi 𝔓
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi π
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{a} \coloneqq \mathfrak{P}(X,\pi)
          %p
            is that of multi-vector fields on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi π
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Sch
                %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{a})} = [\pi, -]_{Sch}
            given by the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Schouten+bracket"} Schouten bracket
          %p
            If we work locally in coordinates then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
            is generated from degree 0 elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} x^i
            and degree 1 elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \partial_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi π
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Sch
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{CE(\mathfrak{a})} = [\pi, -]_{Sch}
                  \\,.
          %p
            The Poisson tensor is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo ≔
                  %mi π
                  %mo =
                  %msup
                    %mi π
                    %mrow
                      %mi i
                      %mi j
                  %msub
                    %mo ∂
                    %mi i
                  %mo ∧
                  %msub
                    %mo ∂
                    %mi j
                %annotation{:encoding => "application/x-tex"} \nu \coloneqq \pi = \pi^{i j} \partial_i \wedge \partial_j
            and that this is a
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} Lie algebroid cocycle
            is the fact that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                  %mi π
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi π
                  %mo ,
                  %mi π
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mi Sch
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{CE(\mathfrak{a})} \pi = [\pi,\pi]_{Sch} = 0
                  \\,.
          %p
            By definition the
            %a.existingWikiWord{:href => "/nlab/show/Weil+algebra"} Weil algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo{:stretchy => "false"} (
                  %mi 𝔞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W(\mathfrak{a})
            is generated from the
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x^i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi i
                %annotation{:encoding => "application/x-tex"} \partial_i
            and their shifted partners
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %msup
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} \mathbf{d}x^i
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msub
                      %mo ∂
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \mathbf{d}\partial_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi π
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo +
                  %mstyle{:mathvariant => "bold"}
                    %mi d
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d_{W(\mathfrak{a})} = [\pi , - ] + \mathbf{d}
                  \\,.
          .un_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              that is in transgression with the cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo =
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \nu = \pi
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msub
                      %mo ∂
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = (\mathbf{d} x^i) \wedge (\mathbf{d} \partial_i)
                    \\;\;\;
                    \\in inv(\mathfrak{a})
                    \\,.
          .proof
            %h6#proof Proof
            %p One checks directly that the element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cs
                      %mi ω
                    %mo =
                    %msup
                      %mi π
                      %mrow
                        %mi i
                        %mi j
                    %msub
                      %mo ∂
                      %mi i
                    %mo ∧
                    %msub
                      %mo ∂
                      %mi j
                    %mo +
                    %msup
                      %mi x
                      %mi i
                    %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msub
                      %mo ∂
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    cs_\omega =
                    \\pi^{i j} \partial_i \wedge \partial_j
                    +
                    x^i \wedge \mathbf{d} \partial_i
            %p
              is a Chern-Simons transgression element for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            %p
              i.e.
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi 𝔞
                          %mo{:stretchy => "false"} )
                      %mi cs
                      %mo{:stretchy => "false"} (
                      %mi ω
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} d_{W(\mathfrak{a})} cs(\omega) = \omega
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi cs
                      %mi ω
                  %annotation{:encoding => "application/x-tex"} cs_\omega
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{a})
              is evidently the Poisson tensor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
          %p
            More details on this at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} Chern-Simons element
          .standout
            %p
              For a
              %a.existingWikiWord{:href => "/nlab/show/Poisson+manifold"} Poisson manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with Poisson tensor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                      %mo =
                      %msup
                        %mi π
                        %mrow
                          %mi i
                          %mi j
                      %msub
                        %mo ∂
                        %mi i
                      %mo ∧
                      %msub
                        %mo ∂
                        %mi j
                    %annotation{:encoding => "application/x-tex"} \pi = \pi^{i j} \partial_i \wedge \partial_j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔓
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi π
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi ω
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msup
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %msub
                      %mo ∂
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\mathfrak{P}(X,\pi), \;\;\;
                    \\omega = (\mathbf{d} x^i) \wedge (\mathbf{d} \partial_i))
            %p
              consisting of the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi π
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{P}(X,\pi)
              and of the
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              that is in transgression with its canonical 2-cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo =
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \nu = \pi
              (the Poisson tensor) is a symplectic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebroid"} Lie algebroid
          %h3#_courant_algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n=2
            \: Courant algebroid
          %p
            A
            = succeed "-symplectic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Courant+algebroid"} Courant algebroid
          %p
            A Courant 2algebroid over the point if given by a
            %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
            with the symplectic form being the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle -, [-,-] \rangle
            on a semisimple Lie algebra. The extension classified by this is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
          %h2#relation_to_other_concepts Relation to other concepts
          %h3#to_chernsimons_theory
            To
            = succeed "-Chern-Simons" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Since the symplectic form on a symplectic Lie
            = succeed "-Algebroid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theoretically
            as an
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            on an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid"} L-∞ algebroid
            = succeed "-algebroid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/target+space"} target space
            for an
            = succeed ":" do
              %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/AKSZ+theory"} AKSZ theory
          %p We have
          %ul
            %li
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
              the
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
            %li
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
              the
              %a.existingWikiWord{:href => "/nlab/show/Courant+sigma+model"} Courant sigma model
            %li and so on.
          %h3#to_multisymplectic_geometry To multisymplectic geometry
          %p
            There is also the closely related notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multisymplectic+geometry"} multisymplectic geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chris+Rogers"} Chris Rogers
              = succeed "," do
                %em Categorified Symplectic Geometry and the String Lie 2-Algebra
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0901.4721"} arXiv
          %p
            for some relations of this to the above situation for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = 2
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/hemistrict+Lie+2-algebra"} hemistrict Lie 2-algebra
          %p An article with more details on this:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chris+Rogers"}> Chris Rogers
              ,
              %em Courant algebroids from categorified symplectic geometry
              (
              %a{:href => "http://math.ucr.edu/~chris/2plectic-algebroid_DRAFT.pdf"}> pdf
              ).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid"} L-∞ algebroid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
                from binary and non-degenerate
                %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            %table
              %thead
                %tr
                  %th
                    %math#mathml_0477fc87f3bab6c93955b29dd7c515f68e3108fd_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
