                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\hat X \to X) =
                  (\mathbf{B}String \to \mathbf{B}G)
                  \\,.
          %h2#HamiltonianVectorFields
            Poisson
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %h3#idea_4 Idea
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            on an ordinary
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            is a
            %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            whose contraction with the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
            yields an exact form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ι
                    %mi v
                  %mi ω
                  %mo =
                  %mi d
                  %mi α
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\iota_v \omega = d \alpha
                  \\,.
          %p
            This definition generalizes verbatim to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/n-plectic+geometry"} n-plectic geometry
          %p
            We observe
            %a{:href => "#OrdinaryHamiltonianVectorFields"} below
            that this condition is equivalent to the fact that the
            %a.existingWikiWord{:href => "/nlab/show/flow"} flow
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \exp(v) : X \to X
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            preserves the connection on any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            = succeed "-groupoids." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h3#definition_3 Definition
          #HamiltonianVectorFieldsOnGrpd.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega : X \to \mathbf{\flat}_{dR} \mathbf{B}^{n+2} U(1)
              be a symplectic
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ω
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mi X
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\hat \omega
                    \:
                    X \to  \mathbf{B}^{n+2} U(1)_{conn}
            %p
              be a
              %a{:href => "#PrequantumBundles"} prequantization
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            %p
              Regard it as an object in the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-topos"} over-(∞,1)-topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
