                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, \omega)
              indeed comes from the
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie n-algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔓
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{P}, \omega)
              such that the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/period"} period
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+element"} transgresses to
              are integral, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat X
              is the
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of the
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+extension"} L-∞ extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi b
                      %mi n
                    %mi ℝ
                    %mo →
                    %mover
                      %mi 𝔓
                      %mo{:stretchy => "false"} ^
                    %mo →
                    %mi 𝔓
                  %annotation{:encoding => "application/x-tex"}
                    b^{n}\mathbb{R} \to  \hat \mathfrak{P} \to \mathfrak{P}
            %p
              classified by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mo ≃
                    %msub
                      %mi τ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi 𝔓
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat X \simeq \tau_{n+1} \exp(\hat \mathfrak{P})
                    \\,.
          %h4#examples_2 Examples
          %h5#__ordinary_prequantum_line_bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n= 1
            – Ordinary prequantum line bundle
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+quantization+of+symplectic+groupoids"} geometric quantization of symplectic groupoids
          %h5#__string_lie_2algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n = 2
            – String Lie 2-algebra
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            a
            %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
            with quadratic
            %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mi 𝔤
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (b \mathfrak{g}, \omega)
            is a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+Lie+n-algebroid"} symplectic Lie 2-algebroid
            (
            %a.existingWikiWord{:href => "/nlab/show/Courant+Lie+2-algebroid"}> Courant Lie 2-algebroid
            ) over the point.
          %p
            In this case the infinitesimal prequantum line 2-bundle is the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of the
            %a.existingWikiWord{:href => "/nlab/show/string+Lie+2-algebra"} string Lie 2-algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi b
                    %mo ^
