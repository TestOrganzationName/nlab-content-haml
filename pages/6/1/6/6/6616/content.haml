                      %mo{:stretchy => "false"} (
                      %mn 1
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi conn
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}/\mathbf{B}^{n+2}U(1)_{conn}
            %p
              Consider the internal
              %a.existingWikiWord{:href => "/nlab/show/automorphism+%E2%88%9E-group"} automorphism ∞-group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %munder
                        %mi Aut
                        %mo ̲
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo{:stretchy => "false"} /
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi conn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    \\underline{Aut}_{\mathbf{H}/\mathbf{B}^{n+1}U(1)_{conn}}(X)
                    \\in \mathbf{H}
            %p
              of auto-
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalences
              that respect the
              %a.existingWikiWord{:href => "/nlab/show/connection+on+an+infinity-bundle"} ∞-connection
              that refines
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            %ul
              %li
                %p
                  Its image under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mo !
                        %mo :
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi H
                          %mrow
                            %mo{:stretchy => "false"} /
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi n
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} p_! : \mathbf{H}_{/\mathbf{B}^n U(1)_{conn}} \to \mathbf{H}
                  we call the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+symplectomorphism"} Hamiltonian symplectomorphism
                    = succeed "-group." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
              %li
                %p
                  Its
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra"} ∞-Lie algebra
                  we call the
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson ∞-Lie algebra
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi ω
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X, \omega)
          %h3#examples_3 Examples
          %h4#OrdinaryHamiltonianVectorFields Ordinary Hamiltonian vector fields
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo :
                    %mi X
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mo ♭
                      %mi dR
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega : X \to \mathbf{\flat}_{dR} \mathbf{B}^2 U(1)
              an ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
              %a.maruku-ref{:href => "#HamiltonianVectorFieldsOnGrpd"}
              reproduces the standard notion of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
          .proof
            %h6#proof Proof
            %p An Hamiltonian diffeomorphism is given by a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi ϕ
                          %mtd
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi ω
                                  %mo{:stretchy => "false"} ^
                            %mo ↘
                          %mtd
                            %msub
                              %mo ⇙
                              %mi α
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ω
                                  %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;&amp;\stackrel{\phi}{\to} &amp;&amp; X
                    \\\
                    \&amp; {}_{\mathllap{\hat \omega}}\searrow
                    \&amp;\swArrow_{\alpha}&amp;
                    \\swarrow_{\mathrlap{\hat \omega}}
                    \\\
                    \&amp;&amp; \mathbf{B} U(1)_{conn}
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            %p
              Assume first that the connection 1-form in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ω
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat \omega
              is globally defined
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \Omega^1(X)
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi A
                      %mo =
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} d A = \omega
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi A
                    %mo −
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi d
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (\phi(t)^* A - A) = d \alpha(t)
                    \\,,
            %p
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha(t) \in C^\infty(X)
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                    %mi A
                    %mo =
                    %mi d
                    %mi α
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_v A = d \alpha'
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is the
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              of which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ↦
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} t \mapsto \phi(t)
              is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/flow"} flow
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Cartan+calculus"} Cartan calculus
              this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi ι
                      %mi v
                    %mi A
                    %mo +
                    %msub
                      %mi ι
                      %mi v
                    %msub
                      %mi d
                      %mi dR
                    %mi A
                    %mo =
                    %mi d
                    %mi α
                    %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    d \iota_v A + \iota_v d_{dR} A  = d \alpha'
            %p hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %mi ω
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi ι
                      %mi v
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_v \omega = d (\alpha' - \iota_v A)
                    \\,.
            %p
              This says that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              to be Hamiltonian, its contraction with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              must be exact. This is precisely the definition of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              here is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ′
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi ι
                        %mi v
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \alpha'-\iota_v A
            %p
              In the general case that the prequantum
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
              is not trivial, we can present it by a
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
              on the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi P
                      %mo *
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(P_* X \to X)
              of the based
              %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
              %a.existingWikiWord{:href => "/nlab/show/surjective+submersion"} surjective submersion
              (regarding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P_* X
              as a
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
              and choosing one base point per connected component, or else assuming without restriction that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is connected).
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \phi = \exp(v) : X \to X
              lifts to a diffeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mo *
                    %mi ϕ
                    %mo :
                    %msub
                      %mi P
                      %mo *
                    %mi X
                    %mo →
                    %msub
                      %mi P
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P_*\phi : P_* X \to P_* X
              by setting
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mo *
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi exp
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P_* \phi(\gamma) : (t \in [0,1]) \mapsto \exp(t v)(\gamma(t))
            %p So we get a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi P
                              %mo *
                            %mo →
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi P
                                  %mo *
                                %mi ϕ
                          %mtd
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi P
                              %mo *
                            %mo →
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi ω
                                  %mo{:stretchy => "false"} ^
                            %mo ↘
                          %mtd
                            %msub
                              %mo ⇙
                              %mi α
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mover
                                  %mi ω
                                  %mo{:stretchy => "false"} ^
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(P_* \to X) &amp;&amp;\stackrel{P_*\phi}{\to} &amp;&amp; C(P_* \to X)
                    \\\
                    \&amp; {}_{\mathllap{\hat \omega}}\searrow
                    \&amp;\swArrow_{\alpha}&amp;
                    \\swarrow_{\mathrlap{\hat \omega}}
                    \\\
                    \&amp;&amp; \mathbf{B} U(1)_{conn}
                    }
            %p
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mo *
                      %mi X
                    %annotation{:encoding => "application/x-tex"} P_* X
