            %a.existingWikiWord{:href => "/nlab/show/smooth+string+2-group"} smooth string 2-group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
