                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mi H
                    %mi dR
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
