              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{1\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi trace
                      %mi X
                    %msup
                      %mo{:stretchy => "false"} }
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \{trace_X\}^\perp
              comprises “states” of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi trace
                      %mi X
                    %msup
                      %mo{:stretchy => "false"} }
                      %mo ⊥
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi trace
                      %mi X
                    %msup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo ⊥
                        %mo ⊥
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi trace
                      %mi Y
                    %msup
                      %mo{:stretchy => "false"} }
                      %mo ⊥
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi trace
                      %mi Y
                    %msup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo ⊥
                        %mo ⊥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\{trace_X\}^\perp,\{trace_X\}^{\perp\perp})\to (Y,\{trace_Y\}^\perp,\{trace_Y\}^{\perp\perp})
              is the same thing as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+operation"} quantum operation
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%B6licher+spaces"}> Frölicher spaces
              \: Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} C=Set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %msup
                        %mi I
                        %mo *
                      %mo =
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} I=I^*=\mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %msub
                      %mo ⊥
                      %mi X
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u\bot_X v
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ∘
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} (v\circ u):\mathbb{R}\to\mathbb{R}
              is smooth. In other words, the focus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊆
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo ,
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F\subseteq C(\mathbb{R},\mathbb{R})
              comprises the smooth maps.
          %h2#general_double_gluing General double gluing
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be any (symmetric)
            %a.existingWikiWord{:href => "/nlab/show/polycategory"} polycategory
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a co-subunary polycategory (i.e. all morphisms have codomain arity 0 or 1), and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mi C
                  %mo →
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L:C\to Chu(E)
            be a polycategory functor. We consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a vertically discrete
            %a.existingWikiWord{:href => "/nlab/show/double+polycategory"} double polycategory
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            as a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi ℂ
                  %mi hu
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C\to \mathbb{C}hu(E)
            into the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/double+Chu+construction"} double Chu construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(E)
            as a vertically discrete double polycategory, including into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mi hu
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{C}hu(E)
            as the horizontal polycategory.
          %p
            The
            %strong double gluing
            polycategory is then the
            %a.existingWikiWord{:href => "/nlab/show/comma+double+category"} comma double
            polycategory (i.e. the
            %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma object
            in the 2-category of polycategories)
