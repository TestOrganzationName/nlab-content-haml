                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(E) = Chu(E,1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a representable multicategory (i.e. a symmetric monoidal category), and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is representable and closed with products so that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Chu(E,1)
                is a
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C\to Chu(E)
                are equivalent to pairs of a lax symmetric monoidal functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mi C
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} L:C\to E
                and a functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo :
                      %mi C
                      %mo →
                      %msup
                        %mi E
                        %mi op
                    %annotation{:encoding => "application/x-tex"} K:C\to E^{op}
                together with a “contraction”
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ⊗
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L(R) \otimes K(R\otimes S) \to K(S)
                satisfying a few axioms. This is how the definition is phrased in
                = succeed "." do
                  %a{:href => "#HylandSchalk"} Hyland and Schalk
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a
                = succeed "-polycategory," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                = succeed "-polycategory" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo :
                      %mi C
                      %mo →
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L:C\to Chu(E)
                are equivalent to functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mo ≤
                          %mn 1
                      %mi C
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} U_{\le 1} C\to E
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mrow
                          %mo ≤
                          %mn 1
                      %mi C
                    %annotation{:encoding => "application/x-tex"} U_{\le 1} C
                is the underlying co-subunary polycategory of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                has a counit that is terminal so that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(E) = Chu(E,1)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mrow
                            %mo =
                            %mn 1
                        %mi C
                        %mo →
                        %mi E
                      %annotation{:encoding => "application/x-tex"} U_{=1} C \to E
                = succeed "-autonomous" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            are closed and representable with sufficient limits and colimits, then one can show (similarly to the conditions for a Chu construction to be representable) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Gl
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gl(L)
            is also representable (as a multicategory or a polycategory, respectively) and closed. Thus, double gluing can produce closed symmetric monoidal and
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
          %p
            The case of double gluing along hom-functors, discussed above, is the case when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                  %mi Set
                %annotation{:encoding => "application/x-tex"} E=Set
            so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(E,1)
            is
            = succeed "-autonomous," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L(X) =C(I,X)
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msup
                      %mi I
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(X) = C(X,I^*)
          %h2#references References
          %ul
            %li#HylandSchalk
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Hyland"} Martin Hyland
                and Andrea Schalk,
                = succeed "," do
                  %em Glueing and orthogonality for models of linear logic
                = succeed ")" do
                  %a{:href => "https://core.ac.uk/download/pdf/21173316.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aleks+Kissinger"} Aleks Kissinger
                and Sander Uijlen,
                = succeed "." do
                  %em A categorical semantics for causal structure
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1701.04732"} 1701.04732
          %p An abstract understanding of the double glueing construction:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
              \:
              = succeed "," do
                %em Three investigations into linear logic
              = succeed "," do
                %a{:href => "https://web.science.mq.edu.au/~rgarner/Thesis/Smith-Knight-Essay.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Garner-LinearLogic.pdf", :title => "pdf"} pdf
