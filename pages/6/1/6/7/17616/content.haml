                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ProCartSp \coloneqq Pro(CartSp)
            %p
              for its category of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pro-objects"} pro-objects
              = succeed "." do
                %strong pro-Cartesian spaces
          #ProCartSpFullyFaithfulInSmoothLoc.num_prop
            %h6#proposition Proposition
            %p
              The functor which sends a formal cofiltered limit of Cartesian spaces to its actual
              %a.existingWikiWord{:href => "/nlab/show/cofiltered+limit"} cofiltered limit
              of
              %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion of
              %a.existingWikiWord{:href => "/nlab/show/pro-Cartesian+spaces"} pro-Cartesian spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#proCartSp"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/smooth+loci"} smooth loci
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi SmthLoc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Pro(CartSp) \hookrightarrow SmthLoc
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Pro(\mathcal{C}) \simeq (Ind(\mathcal{C}^{op}))^{op}
              (
              %a{:href => "pro-object#ProObjectAsFormalDualOfIndObject"}> remark
              ) it is sufficient to show that the functor in question is on opposite categories a fully faithful functor of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi CartSp
                      %mi op
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi SmthLoc
                      %mi op
                    %mo =
                    %msub
                      %mi SmthAlg
                      %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Ind(CartSp^{op})
                    \\hookrightarrow
                    SmthLoc^{op} = SmthAlg_{\mathbb{R}}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SmthAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} SmthAlg_{\mathbb{R}}
              is the category of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
            %p
              Now, there is the
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi CartSp
                    %mo ↪
                    %mi SmthLoc
                  %annotation{:encoding => "application/x-tex"}
                    i \;\colon\; CartSp \hookrightarrow SmthLoc
            %p
              (
              %a{:href => "smooth+locus#SmoothManifoldsFullSubcategoryOfSmoothLoci"}> prop.
              ) hence a fully faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mi op
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ↪
                    %msub
                      %mi SmthAlg
                      %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i^{op} \colon CartSp^{op} \hookrightarrow SmthAlg_{\mathbb{R}}
                    \\,.
            %p
              Moreover, the image of the latter is in
              %a.existingWikiWord{:href => "/nlab/show/compact+objects"} compact objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi op
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ↪
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi SmthAlg
                        %mi ℝ
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi cpt
                      %mo ↪
                      %mi SmthAlg
                    %annotation{:encoding => "application/x-tex"} i^{op} \colon CartSp^{op} \hookrightarrow (SmthAlg_{\mathbb{R}})_{cpt} \hookrightarrow SmthAlg
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi y
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi SmthAlg
                      %mi ℝ
                    %mo ≃
                    %msub
                      %mi Func
                      %mo ×
                    %mo{:stretchy => "false"} (
                    %mi CartSp
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty(\mathbb{R}^n) \simeq y(\mathbb{R}^n)
                    \\in
                    SmthAlg_{\mathbb{R}} \simeq Func_\times(CartSp,Set)
            %p
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} co-representable
              %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact
              (by the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              and since colimits are computed objectwise
              = succeed ")." do
                %a{:href => "limits+and+colimits+by+example#LimitsOfPresheaves"} prop.
            %p This implies that the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi CartSp
                      %mi op
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mrow
                        %mi Ind
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi i
                          %mi op
                        %mo{:stretchy => "false"} )
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi SmthAlg
                      %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi L
                    %msub
                      %mi SmthAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    Ind(CartSp^{op})
                    \\overset{Ind(i^{op})}{\hookrightarrow}
                    Ind(SmthAlg_{\mathbb{R}})
                    \\overset{L}{\longrightarrow}
                    SmthAlg_{\mathbb{R}}
            %p
              is also fully faithful (
              %a{:href => "ind-object#JFIsFullyFaithful"}> prop.
              ).
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ind
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ind(i^{op})
              takes formal filtered colimits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi CartSp
                      %mi op
                  %annotation{:encoding => "application/x-tex"} CartSp^{op}
              to the corresponding formal colimits in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi SmthAlg
                      %mi ℝ
                  %annotation{:encoding => "application/x-tex"} SmthAlg_{\mathbb{R}}
              (
              %a{:href => "ind-object#FunctorialityOfInd"}> prop.
              ), while
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              takes formal filtered colimits to actual
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
              (
              %a{:href => "ind-object#ReflectionToYonedaEmbedding"}> prop.
              ). Hence this is indeed the functor in question.
          %h3#SiteOfTowersOfCartesianSpaces The site of towers of Cartesian spaces and pro-morphisms
          %blockquote
            %p under construction
          #TowersOfCartesianSpaces.num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TowCartSp
                    %mo ↪
                    %mi ProCartSp
                  %annotation{:encoding => "application/x-tex"}
                    TowCartSp \hookrightarrow ProCartSp
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the category of
              %a.existingWikiWord{:href => "/nlab/show/pro-Cartesian+spaces"} pro-Cartesian spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#proCartSp"}
              %a.existingWikiWord{:href => "/nlab/show/pro-objects"} pro-objects
              in
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              which are presented as formal
              %a.existingWikiWord{:href => "/nlab/show/sequential+limits"} sequential limits
              of
              %a.existingWikiWord{:href => "/nlab/show/tower"} tower
              diagrams, i.e. where the indexing category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒦
                      %mo =
                      %msub
                        %mi ℕ
                        %mo ≥
                    %annotation{:encoding => "application/x-tex"} \mathcal{K} = \mathbb{N}_{\geq}
          #ProGoodOpenCoverOnACartesianSpace.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi TowCartSp
                  %annotation{:encoding => "application/x-tex"} U \in TowCartSp
              a
              %a.existingWikiWord{:href => "/nlab/show/tower+of+Cartesian+spaces"} tower of Cartesian spaces
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TowersOfCartesianSpaces"}
              %strong
                tower of
                %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is a sequence of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \overset{\phi_i}{\to} U\}
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TowCartSp
                  %annotation{:encoding => "application/x-tex"} TowCartSp
              such that these are the formal
              %a.existingWikiWord{:href => "/nlab/show/sequential+limit"} sequential limit
              of a cofiltered diagram of
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msubsup
                        %mi U
                        %mi i
                        %mi k
                      %mover
                        %mo →
                        %mrow
                          %msubsup
                            %mi ϕ
                            %mi i
                            %mi k
                      %msup
                        %mi U
                        %mi k
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i^k \overset{\phi_i^k}{\to} U^k\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi U
                              %mi i
                              %mi k
                          %mtd
                            %mover
                              %mo ↦
                              %mrow
                                %msup
                                  %munder
                                    %mi lim
                                    %mo ⟵
                                  %mi f
                          %mtd
                            %msub
                              %mi U
                              %mi i
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ϕ
                                    %mi i
                                    %mi k
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mi i
                        %mtr
                          %mtd
                            %msup
                              %mi U
                              %mi k
                          %mtd
                            %mover
                              %mo ↦
                              %mrow
                                %msup
                                  %munder
                                    %mi lim
                                    %mo ⟵
                                  %mi f
                          %mtd
                            %mi U
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_i^{k} &amp;\overset{\underset{\longleftarrow}{\lim}^f}{\mapsto}&amp; U_i
                    \\\
                    {}^{\mathllap{\phi_i^k}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi_i}}
                    \\\
                    U^k &amp;\overset{\underset{\longleftarrow}{\lim}^f}{\mapsto}&amp; U
                    }
          .num_defn
            %h6#definition_4 Definition
            %p
              The collection of towers of
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TowCartSp
                    %annotation{:encoding => "application/x-tex"} TowCartSp
              = succeed "," do
                %a.maruku-ref{:href => "#ProGoodOpenCoverOnACartesianSpace"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
          .proof
            %h6#proof_2 Proof
            %p
              By the definition of
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              (
              %a{:href => "coverage#ConditionsOnACoverage"}> def.
              ) we need to check that for every tower of
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi ϕ
                          %mi i
                    %mi U
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \overset{\phi_i}{\to} U\}
              and for every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mover
                      %mo ⟶
                      %mi g
                    %mi U
                  %annotation{:encoding => "application/x-tex"} V \overset{g}{\longrightarrow} U
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TowCartSp
                    %annotation{:encoding => "application/x-tex"} TowCartSp
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi V
                      %mi j
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi ψ
                          %mi j
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{V_j \overset{\psi_j}{\longrightarrow} V\}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              such that for each index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              we may find an index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi j
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} V_j \overset{}{\to} U_i
              such as to make a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi V
                              %mi j
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi U
                              %mi i
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mi i
                        %mtr
                          %mtd
                            %mi V
                          %mtd
                            %munder
                              %mo ⟶
                              %mi g
                          %mtd
                            %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V_j &amp;\overset{}{\longrightarrow}&amp; U_i
                    \\\
                    \\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\phi_i}}
                    \\\
                    V &amp;\underset{g}{\longrightarrow}&amp; U
                    }
                    \\,.
            %p
              Now by
              %a{:href => "tower#ProMorphismsBetweenTowerDiagrams"} this prop.
              the bottom morphism is represented by a sequence of component morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi V
                      %mrow
                        %mi n
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mi U
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    V^{n(k)} \overset{}{\longrightarrow} U^k
                    \\,.
            %p
              Since ordinary
              %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              do form a
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              on
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              (
              %a{:href => "good+open+cover#GoodOpenCoversFormACoverageOnParacompactSmooothManifolds"}> prop.
              ) each of these component diagrams may be completed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mover
                                %mi V
                                %mo{:stretchy => "false"} ˜
                              %mi j
                              %mrow
                                %mi n
                                %mo{:stretchy => "false"} (
                                %mi k
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msubsup
                              %mi U
                              %mi i
                              %mi k
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi ϕ
                                    %mi i
                                    %mi k
                        %mtr
