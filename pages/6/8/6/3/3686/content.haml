          %h2#idea Idea
          %p
            Symplectomorphisms are the
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+manifolds"} symplectic manifolds
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/mechanics"} mechanics
            where symplectic manifolds model
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/phase+spaces"} phase spaces
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/canonical+transformations"} canonical transformations
          %h2#definition Definition
          %h3#symplectomorphisms Symplectomorphisms
          %p
            A
            %strong symplectomorphism
            or
            %strong symplectic diffeomorphism
            from a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi ω
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_1,\omega_1)
            to a symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %msub
                    %mi ω
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_2,\omega_2)
            is a
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msub
                    %mi X
                    %mn 1
                  %mo →
                  %msub
                    %mi X
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \phi : X_1 \to X_2
            preserving the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ϕ
                    %mo *
                  %msub
                    %mi ω
                    %mn 2
                  %mo =
                  %msub
                    %mi ω
                    %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\phi^* \omega_2 = \omega_1
                  \\,.
          %h3#AutoSymplectomorphisms Auto-symplectomorphisms
          %p
            The symplectomorphisms from a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \omega)
            to itself form an infinite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            that is a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of the
            %a.existingWikiWord{:href => "/nlab/show/diffeomorphism+group"} diffeomorphism group
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ":" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/symplectomorphism+group"} symplectomorphism group
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sympl
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sympl(X, \omega)
                  \\hookrightarrow
                  Diff(X)
                  \\,.
          %p
            Its
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔖𝔶𝔪𝔭𝔩𝔙𝔢𝔠𝔱
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi 𝔙𝔢𝔠𝔱
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{SymplVect}(X, \omega) \hookrightarrow \mathfrak{Vect}(X)
          %p
            is that of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+fields"} symplectic vector fields
            %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %mi 𝔙𝔢𝔠𝔱
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} v \in  \mathfrak{Vect}(X)
            such that their
            %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
            annihilates the
            %a.existingWikiWord{:href => "/nlab/show/symplectic+form"} symplectic form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi v
                  %mi ω
                  %mo =
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_v \omega = 0
                  \\,.
          %p
            The further
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            corresponding to those symplectic vector fields which are
            %a.existingWikiWord{:href => "/nlab/show/flows"} flows
            of
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
            coming from a smooth family of
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonians"} Hamiltonians
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℌ𝔞𝔪𝔙𝔢𝔠𝔱
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi 𝔖𝔶𝔪𝔭𝔩𝔙𝔢𝔠𝔱
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi 𝔙𝔢𝔠𝔱
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{HamVect}(X, \omega) \hookrightarrow \mathfrak{SymplVect}(X, \omega) \hookrightarrow \mathfrak{Vect}(X)
          %p
            is the group of
            %strong Hamiltonian symplectomorphisms
            or
            = succeed "." do
              %strong Hamiltonian diffeomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HamSympl
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Sympl
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Diff
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  HamSympl(X,\omega) \hookrightarrow Sympl(X, \omega) \hookrightarrow Diff(X)
                  \\,.
          %h3#plectomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-Plectomorphisms
          %p
            In the generalization to
            %a.existingWikiWord{:href => "/nlab/show/n-plectic+geometry"} n-plectic geometry
            there are accordingly
            = succeed "." do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-plectomorphisms
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/higher+symplectic+geometry"} higher symplectic geometry
          %h2#properties Properties
          %h3#preservation_of_volume Preservation of volume
          %p
            Inasmuch as a symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M, \omega)
            carries a canonical
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ω
                      %mrow
                        %mo ∧
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \omega^{\wedge n}
          %h3#relation_to_poisson_brackets Relation to Poisson brackets
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            given by the
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            of a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \omega)
            is that of a
            %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
            of the group of Hamiltonian symplectomorphisms. (It
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} integrates
            to the
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+group"} quantomorphism group
          %p
            The central extension results form the fact that the Hamiltonian associated with every
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
            is well defined only up to the addition of a constant function.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \omega)
            is a
            %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
            then there is corresponding to it a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heisenberg+Lie+algebra"} Heisenberg Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/Heisenberg+group"} Heisenberg group
            is a subgroup of the group of (necessarily Hamiltonian) symplectomorphisms of the symplectic vector space, regarded as a symplectic manifold.
          %h3#relation_to_lagrangian_correspondences Relation to Lagrangian correspondences
          %p
            A symplectomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi ω
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %msub
                    %mi ω
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi \;\colon\; (X_1, \omega_1) \longrightarrow (X_2, \omega_2)
            canonically induces a
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+correspondence"} Lagrangian correspondence
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi ω
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_1, \omega_1)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi ω
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_2,\omega_2)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/graph"} graph
          %h3#extensions_under_geometric_quantization Extensions under geometric quantization
          %div
            %p
              %strong>
                higher and integrated
                %a.existingWikiWord{:href => "/nlab/show/Kostant-Souriau+extensions"} Kostant-Souriau extensions
              \:
            %p
              (
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+extension"} ∞-group extension
              of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group+of+bisections"} ∞-group of bisections
              of
              %a.existingWikiWord{:href => "/nlab/show/higher+Atiyah+groupoid"} higher Atiyah groupoid
              for
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔾
                    %annotation{:encoding => "application/x-tex"} \mathbb{G}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-connection"} principal ∞-connection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ω
                    %mi 𝔾
                    %mo{:stretchy => "false"} )
                    %mstyle{:mathvariant => "bold"}
                      %mi FlatConn
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi QuantMorph
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi HamSympl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\Omega \mathbb{G})\mathbf{FlatConn}(X) \to \mathbf{QuantMorph}(X,\nabla) \to \mathbf{HamSympl}(X,\nabla)
            %table
              %thead
                %tr
                  %th
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
