            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"} Loring Tu
                = succeed "," do
                  %em Differential forms in algebraic topology
                = succeed "," do
                  %strong 82
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hal+Schenck"}> Hal Schenck
                ,
                %em Chapter 9: Cohomology and spectral sequences
                (
                %a{:href => "http://www.math.uiuc.edu/~schenck/tapp.pdf"}> pdf
                ) .
            %li#Hatcher
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alan+Hatcher"}> Alan Hatcher
