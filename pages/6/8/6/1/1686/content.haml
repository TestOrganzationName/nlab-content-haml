                %a.existingWikiWord{:href => "/nlab/show/descent+spectral+sequence"} descent spectral sequence
            %li
              %p
                %span.newWikiWord
                  Bar spectral sequence
                  %a{:href => "/nlab/new/Bar+spectral+sequence"} ?
                for the
                %a.existingWikiWord{:href => "/nlab/show/homology"} homology
                of the
