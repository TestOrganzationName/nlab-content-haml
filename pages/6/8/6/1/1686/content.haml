          %h2#properties Properties
          %h3#basic_lemmas Basic lemmas
          .num_lemma
            %h6#lemma Lemma
            %p
              %strong (mapping lemma)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi F
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : (E_r^{p,q} \to (F_r^{p,q}))
              is a morphism of spectral sequences such that for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi r
                    %mo :
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %msubsup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} toF
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} f_r : E_r^{p,q} \toF_r^{p,q}
              is an isomorphism, then also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi s
                  %annotation{:encoding => "application/x-tex"} f_s
              is an isomorphism for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ≥
                      %mi r
                    %annotation{:encoding => "application/x-tex"} s \geq r
          .num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong (classical convergence theorem)
            %p (…)
          %p
            This is recalled in (
            %a{:href => "#Weibel"}> Weibel, theorem 5.51
            ).
          %h3#FirstQuadrant First quadrant spectral sequence
          .num_defn
            %h6#definition_6 Definition
            %p
              A
              %strong first quadrant spectral sequence
              is one for wich all pages are concentrated in the first quadrant of the
              = succeed "-plane," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p,q)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo &lt;
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mi or
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo &lt;
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ((p \lt 0) or (q \lt 0))
                    \\;\;
                    \\Rightarrow
                    E_r^{p,q} = 0
                    \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi st
                  %annotation{:encoding => "application/x-tex"} (r+1)st
              page. So if the first one is, then all are.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Every first quadrant spectral sequence converges at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,q)
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo &gt;
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r \gt max(p,q+1)
              on
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mrow
                        %mi max
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo ,
                        %mi q
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo =
                    %msubsup
                      %mi E
                      %mn ∞
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_{max(p,q+1)+1}^{p,q} = E_\infty^{p,q}
                    \\,.
          .num_prop
            %h6#proposition_4 Proposition
            %p If a first quadrant spectral sequence converges
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo ⇒
                    %msup
                      %mi H
                      %mrow
                        %mi p
                        %mo +
                        %mi q
                  %annotation{:encoding => "application/x-tex"}
                    E_r^{p,q} \Rightarrow H^{p+q}
            %p
              then each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi n
                  %annotation{:encoding => "application/x-tex"} H^n
              has a filtration of length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo =
                    %msup
                      %mi F
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msup
                      %mi H
                      %mi n
                    %mo ⊂
                    %msup
                      %mi F
                      %mi n
                    %msup
                      %mi H
                      %mi n
                    %mo ⊂
                    %mi ⋯
                    %mo ⊂
                    %msup
                      %mi F
                      %mn 1
                    %msup
                      %mi H
                      %mi n
                    %mo ⊂
                    %msup
                      %mi F
                      %mn 0
                    %msup
                      %mi H
                      %mi n
                    %mo =
                    %msup
                      %mi H
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    0 = F^{n+1}H^n \subset F^n H^n \subset \cdots \subset F^1 H^n \subset F^0 H^n = H^n
            %p and we have
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mi n
                        %msup
                          %mi H
                          %mi n
                        %mo ≃
                        %msubsup
                          %mi E
                          %mn ∞
                          %mrow
                            %mi n
                            %mo ,
                            %mn 0
                      %annotation{:encoding => "application/x-tex"} F^n H^n \simeq E_\infty^{n,0}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mi n
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi F
                          %mn 1
                        %msup
                          %mi H
                          %mi n
                        %mo ≃
                        %msubsup
                          %mi E
                          %mn ∞
                          %mrow
                            %mn 0
                            %mo ,
                            %mi n
                      %annotation{:encoding => "application/x-tex"} H^n/F^1 H^n \simeq E_\infty^{0,n}
                  \.
          %h3#PropertiesCupProductStructure Cup product structure
          %p
            Cohomological spectral sequences are compatible with
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            structure on the
            = succeed "-page." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
            = succeed ")" do
              %a{:href => "#Hutchings11"} Hutchings 11, sections 5 and 6
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/edge+morphism"} edge morphism
