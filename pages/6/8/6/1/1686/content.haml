                of a
                %a.existingWikiWord{:href => "/nlab/show/group"} group
            %li
              %p
                %span.newWikiWord
                  Barratt spectral sequence
                  %a{:href => "/nlab/new/Barratt+spectral+sequence"} ?
                converging to the
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                of the initial space of a
                %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
            %li
