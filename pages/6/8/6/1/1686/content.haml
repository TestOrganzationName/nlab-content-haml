                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleta
                    of
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+object+in+an+%28%E2%88%9E%2C1%29-category"} simplicial object
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+simplicial+stable+homotopy+type"} spectral sequence of a simplicial stable homotopy type
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} skeleta
                    of
                    %a.existingWikiWord{:href => "/nlab/show/Sweedler+coring"} Sweedler coring
                    of
                    %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+algebra"} E-∞ algebra
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/filtration+by+support"} filtration by support
                  %td{:style => "text-align: left;"} …
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/slice+filtration"} slice filtration
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/slice+spectral+sequence"} slice spectral sequence
          %p The following list of examples orders the various classes of spectral sequences by special cases: items further to the right are special cases of items further to the left.
          %ul
            %li
              %p
                %strong
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+complex"} spectral sequence of a filtered complex
                (approximate
                %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
                by higher-order
                %a.existingWikiWord{:href => "/nlab/show/relative+homology"} relative homology
                in the presence of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtering
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
                    (compute
                    %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
                    of a
                    %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                    in terms of that of the base with
                    %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                    in that of the
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
                      (compute
                      %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
                      of a
                      %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                      in terms of that of the base with
                      %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                      in that of the
                      = succeed ")" do
                        %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+spectral+sequence"} Eilenberg-Moore spectral sequence
                    (compute homology of
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+products"} homotopy fiber products
                %li
                  %p
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+double+complex"} spectral sequence of a double complex
                    (compute homology of
                    %a.existingWikiWord{:href => "/nlab/show/total+complex"} total complex
                    by filtering by row/column degree)
                  %ul
                    %li
                      %p
                        %strong
                          %a.existingWikiWord{:href => "/nlab/show/Grothendieck+spectral+sequence"} Grothendieck spectral sequence
                        (compute
                        %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                        of two
                        = succeed ")" do
                          %a.existingWikiWord{:href => "/nlab/show/derived+functors+in+homological+algebra"} derived functors
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/base+change+spectral+sequence"} base change spectral sequence
                            (compute
                            = succeed "/" do
                              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
                            %a.existingWikiWord{:href => "/nlab/show/extension+of+scalars"} extension of scalars
                            in two stages)
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Leray+spectral+sequence"} Leray spectral sequence
                            (compute
                            %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
                            in two stages)
                        %li
