                              %mi Σ
                            %msup
                              %mi γ
                              %mo *
                            %mi A
                          %mtd
                            %mo =
                            %mi δ
                            %msub
                              %mo ∫
                              %mi Σ
                            %msub
                              %mi A
                              %mi μ
                            %mo{:stretchy => "false"} (
                            %mi γ
                            %mo{:stretchy => "false"} )
                            %msup
                              %mover
                                %mi γ
                                %mo ˙
                              %mi μ
                            %mi d
                            %mi τ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mo ∫
                              %mi Σ
                            %mrow
                              %mo (
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi ν
                              %msub
                                %mi A
                                %mi μ
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi γ
                              %mo{:stretchy => "false"} )
                              %msup
                                %mover
                                  %mi γ
                                  %mo ˙
                                %mi μ
                              %mo −
                              %mfrac
                                %mi d
                                %mrow
                                  %mi d
                                  %mi τ
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mi ν
                              %mo{:stretchy => "false"} (
