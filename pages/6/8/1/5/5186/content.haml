                    \\int_\Sigma
                    \\left(
                    \\frac{1}{2}(\partial_\mu g_{\nu \lambda}) \dot \gamma^\nu \dot \gamma^\lambda
                    \-
                    \\frac{d}{d\tau}(g_{\mu \nu} \dot \gamma^\nu)
                    \\right)
                    \\delta \gamma^\mu
                    d \tau
                    \\\
                    \&amp; =
                    \\int_\Sigma
                    \\left(
                    \\frac{1}{2}(\partial_\mu g_{\nu \lambda}) \dot \gamma^\nu \dot \gamma^\lambda
                    \-
                    2 (g_{\mu\nu}\ddot \gamma^\nu +
                    (\partial_\lambda g_{\mu\nu}) \dot \gamma^\nu \dot \gamma^\lambda)
                    \\right)
                    \\delta \gamma^\mu
                    d \tau
                    \\\
                    \&amp; =
                    \- \int_\Sigma
                    g_{\mu \mu}(
                    \\ddot \gamma^\nu + \Gamma^\nu{}_{\alpha \beta} \dot \gamma^\alpha \dot \gamma^\beta
                    )
                    \\delta \gamma^\mu
                    \\\
                    \&amp; =
                    \- \int_\Sigma
                    g_{\mu \mu}(
                    \\nabla_{\dot \gamma} \dot \gamma^\nu
                    )
                    \\delta \gamma^\mu
                    \\\
                    \&amp; = -\int_\Sigma g(\nabla_{\dot \gamma} \dot \gamma, \delta \gamma)
                    \\end{aligned}
                    \\,.
            %p
              (Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Γ
                      %mo ⋅
                    %msub
                      %mrow
                      %mrow
                        %mo ⋅
                        %mo ⋅
                  %annotation{:encoding => "application/x-tex"} \Gamma^\cdot{}_{\cdot \cdot}
              are the
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Christoffel+symbols"} Christoffel symbols
            %p This gives the equations of motion as claimed.
          .num_remark
            %h6#remark Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              of the tangent vector along a physical trajectory is preserved:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi τ
                            %msqrt
                              %mrow
                                %mi g
                                %mo{:stretchy => "false"} (
                                %mover
                                  %mi γ
                                  %mo ˙
                                %mo ,
                                %mover
                                  %mi γ
                                  %mo ˙
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mo ∝
                            %mn 2
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi τ
                            %mi g
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∇
                              %mover
                                %mi γ
                                %mo ˙
                            %mover
                              %mi γ
                              %mo ˙
                            %mo ,
                            %mover
                              %mi γ
                              %mo ˙
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ∝
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi γ
                              %mo ˙
                            %mo ,
                            %mover
                              %mi γ
                              %mo ˙
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\frac{d}{d \tau} \sqrt{g(\dot \gamma, \dot \gamma)}
                    \&amp; \propto
                    2 \frac{d}{d \tau} g(\nabla_{\dot \gamma} \dot \gamma, \dot \gamma)
                    \\\
                    \&amp; \propto
                    F(\dot \gamma, \dot \gamma)
                    \\\
                    \&amp; 0
                    \\end{aligned}
                    \\,.
            %p
              Therefore if the assumption
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi γ
                      %mo ˙
                    %mo ,
                    %mover
                      %mi γ
                      %mo ˙
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g(\dot \gamma, \dot \gamma) \neq 0
              is satisfied at one instant, is is so everywhere along the curve.
          .num_remark
            %h6#remark_2 Remark
            %p
              For vanishing
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background gauge field
              strength,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} F = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mover
                        %mi γ
                        %mo ˙
                    %mover
                      %mi γ
                      %mo ˙
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla_{\dot \gamma} \dot \gamma = 0
            %p
              express the
              %a.existingWikiWord{:href => "/nlab/show/parallel+transport"} parallel transport
              of the tangent vector along a physical trajectory. This identifies these trajectories with the
              %a.existingWikiWord{:href => "/nlab/show/geodesics"} geodesics
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
