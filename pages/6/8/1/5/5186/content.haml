                    %msub
                      %mo ∇
                      %mover
                        %mi γ
                        %mo ˙
                    %mover
                      %mi γ
                      %mo ˙
                    %mo{:stretchy => "false"} /
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi γ
                        %mo ˙
                    %mo{:stretchy => "false"} |
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ι
