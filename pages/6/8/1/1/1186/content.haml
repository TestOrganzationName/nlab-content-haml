                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} C^{op} \to \infty Grpd
            preserves
