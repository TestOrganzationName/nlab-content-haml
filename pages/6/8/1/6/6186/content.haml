            is a
            %a.existingWikiWord{:href => "/nlab/show/semi-simple+algebra"} semi-simple algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
