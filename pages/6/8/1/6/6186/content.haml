                %annotation{:encoding => "application/x-tex"} Hol(\Delta, G_{\mathbb{C}})\backslash L G_{\mathbb{C}} / Hol(\Sigma \backslash \Delta, G_{\mathbb{C}})
          %p where the holomorphic maps have smooth boundary values
          %p The variety
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
