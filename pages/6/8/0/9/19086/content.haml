                            %mo{:stretchy => "false"} )
                            %mo −
                            %msup
                              %mi x
                              %mrow
                                %mn 1
                                %mo −
                                %mi ϵ
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\theta(x) &amp; \geq &amp; \sum_{x^{1-\epsilon} \lt p \leq x} \log(p) \\
                    \&amp; \geq &amp; \sum_{x^{1-\epsilon} \lt p \leq x} \log(x^{1-\epsilon}) \\
                    \&amp; = &amp; (1 - \epsilon)\log(x) \cdot (\pi(x) - \pi(x^{1 - \epsilon})) \\
                    \&amp; \geq &amp; (1 - \epsilon)\log(x) \cdot (\pi(x) - x^{1 - \epsilon})
                    }
            %p
              From the last line and
              %a.maruku-eqref{:href => "#eq:ineq1"} (1)
              (which implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %mi π
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mi log
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \frac{\pi(x)\log(x)}{x}
              is bounded below by a positive constant), we obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mfrac
                              %mrow
                                %mi θ
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mi x
                          %mtd
                            %mo ≥
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo −
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                            %mfrac
                              %mrow
                                %mi π
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mi log
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mi x
                            %mo −
                            %msup
                              %mi x
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi ϵ
                        %mtr
                          %mtd
                          %mtd
                            %mo ≥
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo −
                            %mn 2
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                            %mfrac
                              %mrow
                                %mi π
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mi log
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mi x
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\frac{\theta(x)}{x} &amp; \geq &amp; (1-\epsilon)\frac{\pi(x)\log(x)}{x} - x^{-\epsilon} \\
                    \&amp; \geq &amp; (1 - 2\epsilon)\frac{\pi(x)\log(x)}{x}
                    }
            %p
              for sufficiently large
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
              (say less than
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} 1/3
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∼
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \theta(x) \sim x
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo ≤
                    %mfrac
                      %mrow
                        %mi π
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mi log
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mn 2
                    %mi ϵ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mn 3
                    %mi ϵ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 - \epsilon \leq \frac{\pi(x)\log(x)}{x} \leq (1 - 2\epsilon)^{-1}\frac{\theta(x)}{x} \leq (1 - 3\epsilon)^{-1}
            %p or simply
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo ≤
                    %mfrac
                      %mrow
                        %mi π
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mi log
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi x
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %mn 3
                    %mi ϵ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} 1 - \epsilon \leq \frac{\pi(x)\log(x)}{x} \leq (1 - 3\epsilon)^{-1}
            %p
              for all sufficiently large
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
            Proving the asymptotic result
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mi x
                %annotation{:encoding => "application/x-tex"} \theta(x) \sim x
            will involve complex analysis applied to the Riemann zeta function. An easier preliminary result gives information on the
            %em order
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi π
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mi log
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi x
                %annotation{:encoding => "application/x-tex"} \frac{\pi(x)\log(x)}{x}
            has a limit, then that limit must be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          #cheb.num_lemma
            %h6#lemma_2 Lemma
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi{:mathvariant => "normal"} O
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta(x) = \mathrm{O}(x)
              \.
          .proof
            %h6#proof_2 Proof
            %p First let us observe that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 2
                      %mrow
                        %mn 2
                        %mi n
                    %mo ≥
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mn 2
                          %mi n
                        %mi n
                      %mo )
                    %mo ≥
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo &lt;
                        %mi p
                        %mo &lt;
                        %mn 2
                        %mi n
                    %mi p
                    %mo =
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2^{2n} \geq \binom{2n}{n} \geq \prod_{n \lt p \lt 2n} p = \exp(\theta(2n) - \theta(n))
            %p so that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} 2n\log(2) \geq \theta(2n) - \theta(n).
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≤
                      %mi x
                      %mo &lt;
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \leq x \lt n+1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta(x) = \theta(n)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi log
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \theta(2x) \leq \theta(2n) + \log(2x)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi x
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mn 2
                    %mi n
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 2x\log(2) \geq 2n\log(2) \geq \theta(2n) - \theta(n) \geq \theta(2x) - \log(2x)  - \theta(x)
            %p or simply
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi x
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \theta(x) - \theta(x/2) \leq x\log(2) + \log(x).
            %p Taking a telescopic sum, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 2
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 2
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 2
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mi log
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 2
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta(x) = \sum_{k = 0}^{n-1} \theta(x/2^k) - \theta(x/2^{k+1}) \leq \sum_{k=0}^{n-1} (x/2^k)\log(2) + \sum_{k=0}^{n-1} \log(x/2^k)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is chosen so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi x
                    %mo{:stretchy => "false"} /
                    %msup
                      %mn 2
                      %mi n
