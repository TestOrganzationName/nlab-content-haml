                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
            %p
              In the other direction, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi θ
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≥
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msup
                                  %mi x
                                  %mrow
                                    %mn 1
                                    %mo −
                                    %mi ϵ
                                %mo &lt;
                                %mi p
                                %mo ≤
                                %mi x
                            %mi log
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≥
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %msup
                                  %mi x
                                  %mrow
                                    %mn 1
                                    %mo −
                                    %mi ϵ
                                %mo &lt;
                                %mi p
                                %mo ≤
                                %mi x
                            %mi log
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
                              %mrow
                                %mn 1
                                %mo −
                                %mi ϵ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo −
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                            %mi log
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:stretchy => "false"} (
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mi π
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi x
