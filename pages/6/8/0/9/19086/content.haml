                          %mtd
                            %mo ≥
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo −
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                            %mi log
                            %mo{:stretchy => "false"} (
