                %annotation{:encoding => "application/x-tex"} \log \zeta(s) = -\sum_p \log(1 - p^{-s})
          %p which upon differentiating yields
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %msup
                                %mi ζ
                                %mo ′
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                            %mrow
                              %mi ζ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi p
                          %mfrac
                            %mrow
                              %mi log
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                              %msup
                                %mi p
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi s
                            %mrow
                              %mn 1
                              %mo −
                              %msup
                                %mi p
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi s
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi p
                          %mi log
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo{:stretchy => "false"} )
                          %msup
                            %mi p
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi s
                          %mo −
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi p
                          %mfrac
                            %mrow
                              %mi log
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                              %msup
                                %mi p
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi s
                              %msup
                                %mi p
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi s
                            %mrow
                              %mn 1
                              %mo −
                              %msup
                                %mi p
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi s
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi Φ
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mo −
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                            %mi p
                          %mfrac
                            %mrow
                              %mi log
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                            %mrow
                              %msup
                                %mi p
                                %mi s
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi p
                                %mi s
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\frac{\zeta^'(s)}{\zeta(s)} &amp; = &amp; -\sum_p \frac{\log(p) p^{-s}}{1 - p^{-s}} \\
                  \&amp; = &amp; -\sum_p \log(p) p^{-s} -\sum_p \frac{\log(p) p^{-s}p^{-s}}{1 - p^{-s}} \\
                  \&amp; = &amp; -\Phi(s) - \sum_p \frac{\log(p)}{p^s(p^s - 1)}
                  }
          %p
            with the last sum converging over the region
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mfrac
                      %mn 1
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Re(s) \gt \frac1{2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ζ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \zeta(s)
            (Proposition
            = succeed ")," do
              %a.maruku-ref{:href => "#cont"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(s)
            admits a meromorphic continuation over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mfrac
                      %mn 1
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} Re(s) \gt \frac1{2}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ζ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \zeta(s)
            has zeroes, or at the simple pole
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s = 1
          #nozero.num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mfrac
                      %mn 1
                      %mrow
                        %mi s
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Phi(s) - \frac1{s-1}
              is holomorphic over the region
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} Re(s) \geq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \zeta(s)
              has no zeroes over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} Re(s) \geq 1
          .proof
            %h6#proof_4 Proof
            %p
              The case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} Re(s) \gt 1
              is easily handled by the product formula
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:prod"} (2)
            %p
              For a fixed
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t \gt 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              be the order of the zero of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo +
                    %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \zeta(1 + i t)
              (if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ζ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo +
                    %mi i
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \zeta(1 + i t) \neq 0
              then of course
              = succeed ");" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \mu = 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo =
                      %mn 1
                      %mo −
                      %mi i
                      %mi t
                    %annotation{:encoding => "application/x-tex"} s = 1 - i t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              be the order of the zero at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ±
                      %mn 2
                      %mi i
                      %mi t
                    %annotation{:encoding => "application/x-tex"} 1 \pm 2i t
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %munder
                          %mi lim
                          %mrow
                            %mi ϵ
                            %mo ↘
                            %mn 0
                        %mi ϵ
                        %mo ⋅
                        %mi Φ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo +
                        %mi ϵ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \underset{\epsilon \searrow 0}{\lim} \epsilon \cdot \Phi(1 + \epsilon) = 1
                  (since
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ζ
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \zeta(s)
                  has a pole of order
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} 1
                  at
                  = succeed ")," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo =
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} s = 1
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %munder
                          %mi lim
                          %mrow
                            %mi ϵ
                            %mo ↘
                            %mn 0
                        %mi ϵ
                        %mo ⋅
                        %mi Φ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo +
                        %mi ϵ
                        %mo ±
                        %mi i
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi μ
                      %annotation{:encoding => "application/x-tex"} \underset{\epsilon \searrow 0}{\lim} \epsilon \cdot \Phi(1 + \epsilon \pm i t) = -\mu
                  ,
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %munder
                          %mi lim
                          %mrow
                            %mi ϵ
                            %mo ↘
                            %mn 0
                        %mi ϵ
                        %mo ⋅
                        %mi Φ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo +
                        %mi ϵ
                        %mo ±
                        %mn 2
                        %mi i
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ν
                      %annotation{:encoding => "application/x-tex"} \underset{\epsilon \searrow 0}{\lim} \epsilon \cdot \Phi(1 + \epsilon \pm 2i t) = -\nu
                  \.
            %p
              Observe that for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo ≤
                          %mtd
                            %mi ϵ
                            %mo ⋅
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi p
                            %mfrac
                              %mrow
                                %mi log
                                %mo{:stretchy => "false"} (
                                %mi p
                                %mo{:stretchy => "false"} )
                              %mrow
                                %msup
                                  %mi p
                                  %mrow
                                    %mn 1
                                    %mo +
                                    %mi ϵ
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi p
                              %mrow
                                %mi i
                                %mi t
                                %mo{:stretchy => "false"} /
                                %mn 2
                            %mo +
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %mi t
                                %mo{:stretchy => "false"} /
                                %mn 2
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 4
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi ϵ
                            %mo ⋅
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi p
                            %mfrac
                              %mrow
                                %mi log
                                %mo{:stretchy => "false"} (
                                %mi p
                                %mo{:stretchy => "false"} )
                              %mrow
                                %msup
                                  %mi p
                                  %mrow
                                    %mn 1
                                    %mo +
                                    %mi ϵ
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                              %mn 2
                            %mrow
                              %mo (
                              %mfrac{:linethickness => "0"}
                                %mn 4
                                %mrow
                                  %mi r
                                  %mo +
                                  %mn 2
                              %mo )
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %mi r
                                %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi ϵ
                            %mo ⋅
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi r
                                %mo =
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                              %mn 2
                            %mrow
                              %mo (
                              %mfrac{:linethickness => "0"}
                                %mn 4
                                %mrow
                                  %mi r
                                  %mo +
                                  %mn 2
                              %mo )
                            %mi Φ
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo +
                            %mi ϵ
                            %mo +
                            %mi i
                            %mi r
                            %mi t
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    0 &amp; \leq &amp; \epsilon \cdot \sum_p \frac{\log(p)}{p^{1 + \epsilon}} (p^{i t/2} + p^{-i t/2})^4 \\
                    \&amp; = &amp; \epsilon \cdot \sum_p \frac{\log(p)}{p^{1 + \epsilon}} \sum_{k = -2}^2 \binom{4}{r + 2} p^{-i r t} \\
                    \&amp; = &amp; \epsilon \cdot \sum_{r = -2}^2 \binom{4}{r+2} \Phi(1 + \epsilon + i r t)
                    }
            %p
              from which, in conjunction with 1., 2., 3. above, we deduce
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mn 6
                      %mo −
                      %mn 8
                      %mi μ
                      %mo −
                      %mn 2
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} 0 \leq 6 - 8\mu - 2\nu
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \mu = 0
          %p
            The function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta(x)
            is related to the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(s)
            by way of a Riemann-Stieltjes integral:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi p
                  %mfrac
                    %mrow
                      %mi log
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi p
                        %mi s
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 1
                    %mn ∞
                  %mfrac
                    %mrow
                      %mi d
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi x
                        %mi s
                %annotation{:encoding => "application/x-tex"} \Phi(s) = \sum_p \frac{\log(p)}{p^s} = \int_1^\infty \frac{d \theta(x)}{x^s}
          %p
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} Re(s) \gt 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mn 1
                    %mi M
                  %mfrac
                    %mrow
                      %mi d
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi x
                        %mi s
                  %mo =
                  %mrow
                    %mo [
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi M
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi M
                          %mi s
                    %mo −
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ]
                  %mo +
                  %msubsup
                    %mo ∫
                    %mn 1
                    %mi M
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mfrac
                    %mi s
                    %mrow
                      %msup
                        %mi x
                        %mrow
                          %mi s
                          %mo +
                          %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi x
                %annotation{:encoding => "application/x-tex"} \int_1^M \frac{d \theta(x)}{x^s} = \left[\frac{\theta(M)}{M^s} - \theta(1)\right] + \int_1^M \theta(x) \frac{s}{x^{s+1}}\; d x
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi M
                      %mo →
                      %mn ∞
                  %mfrac
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi M
                        %mi s
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \underset{M \to \infty}{\lim} \frac{\theta(M)}{M^s} = 0
            by Lemma
            = succeed "." do
              %a.maruku-ref{:href => "#cheb"}
          #eq:RS.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi s
                  %msubsup
                    %mo ∫
                    %mn 1
                    %mn ∞
                  %mfrac
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi x
                        %mrow
                          %mi s
                          %mo +
                          %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi x
                  %mo =
                  %mi s
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                      %mi t
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi e
                    %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi t
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Phi(s) = s \int_1^\infty \frac{\theta(x)}{x^{s+1}}\; d x = s \int_0^\infty e^{-s t} \theta(e^t)\; d t.
          %h2#reduction_to_a_tauberian_theorem Reduction to a Tauberian theorem
          %p
            The asymptotic result
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mi x
                %annotation{:encoding => "application/x-tex"} \theta(x) \sim x
            will be established by appeal to the following result:
          #conv.num_theorem
            %h6#theorem Theorem
            %p Suppose that the integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mn 1
                      %mn ∞
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi x
                      %mrow
                        %msup
                          %mi x
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \int_1^\infty \; \frac{\theta(x) - x}{x^2}\; d x
            %p
              converges. Then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∼
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \theta(x) \sim x
          .proof
            %h6#proof_5 Proof
            %p
              Suppose that for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \lambda \gt 1
              there exist arbitrarily large
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mi x
                      %mo ≤
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda x \leq \theta(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              implies the first inequality that follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mi x
                      %mrow
                        %mi λ
                        %mi x
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi t
                      %mi t
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi t
                      %mi t
                    %mo ≥
                    %msubsup
                      %mo ∫
                      %mi x
                      %mrow
                        %mi λ
                        %mi x
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi λ
                        %mi x
                        %mo −
                        %mi t
                      %mi t
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi t
                      %mi t
                    %mo =
                    %msubsup
                      %mo ∫
                      %mn 1
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi λ
                        %mi x
                        %mo −
                        %mi t
                        %mi x
                      %mrow
                        %mi t
                        %mi x
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi t
                      %mi t
                    %mo =
                    %msubsup
                      %mo ∫
                      %mn 1
                      %mi λ
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi λ
                        %mo −
                        %mi t
                      %mrow
                        %msup
                          %mi t
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo &gt;
                    %mn 0
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \int_x^{\lambda x} \; \frac{\theta(t) - t}{t}\; \frac{d t}{t} \geq \int_x^{\lambda x} \; \frac{\lambda x - t}{t}\; \frac{d t}{t} = \int_1^\lambda \; \frac{\lambda x - t x}{t x} \; \frac{d t}{t} = \int_1^\lambda \; \frac{\lambda - t}{t^2}\; d t \gt 0.
            %p
              This is a contradiction, because convergence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mn 1
                      %mn ∞
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi t
                      %mrow
                        %msup
                          %mi t
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} \int_1^\infty \; \frac{\theta(t) - t}{t^2}\; d t
              implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mi x
                      %mrow
                        %mi λ
                        %mi x
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi t
                      %mrow
                        %msup
                          %mi t
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} \int_x^{\lambda x} \; \frac{\theta(t) - t}{t^2}\; d t
              can be made arbitrarily small by taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              large.
            %p
              Similarly, if we suppose that for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo &lt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \lambda \lt 1
              there exist arbitrarily large
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi λ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \theta(x) \leq \lambda x
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mrow
                        %mi λ
                        %mi x
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi t
                      %mi t
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi t
                      %mi t
                    %mo ≤
                    %msubsup
                      %mo ∫
                      %mrow
                        %mi λ
                        %mi x
                      %mi x
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi λ
                        %mi x
                        %mo −
                        %mi t
                      %mi t
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi t
                      %mi t
                    %mo =
                    %msubsup
                      %mo ∫
                      %mi λ
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi λ
                        %mi x
                        %mo −
                        %mi t
                        %mi x
                      %mrow
                        %mi t
                        %mi x
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi t
                      %mi t
                    %mo =
                    %msubsup
                      %mo ∫
                      %mi λ
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi λ
                        %mo −
                        %mi t
                      %mrow
                        %msup
                          %mi t
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \int_{\lambda x}^x \; \frac{\theta(t) - t}{t}\; \frac{d t}{t} \leq \int_{\lambda x}^x \; \frac{\lambda x - t}{t}\; \frac{d t}{t} = \int_\lambda^1 \; \frac{\lambda x - t x}{t x} \; \frac{d t}{t} = \int_\lambda^1 \; \frac{\lambda - t}{t^2}\; d t \lt 0
            %p which again leads to a contradiction.
          %p Thus we focus on convergence of
          #eq:rewrite.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mn 1
                    %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi x
                    %mi x
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %mi d
                      %mi x
                    %mi x
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi e
                        %mi t
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msup
                        %mi e
                        %mi t
                    %mrow
                      %msup
                        %mi e
                        %mi t
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi t
                %annotation{:encoding => "application/x-tex"} \int_1^\infty \; \frac{\theta(x) - x}{x}\; \frac{d x}{x} = \int_0^\infty \; \frac{\theta(e^t) - e^t}{e^t}\; d t
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Re
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} Re(s) \gt 1
            we have, from
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:RS"} (3)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mfrac
                            %mrow
                              %mi Φ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                            %mi s
                          %mo −
                          %mfrac
                            %mn 1
                            %mrow
                              %mi s
                              %mo −
                              %mn 1
                        %mtd
                          %mo =
                        %mtd
                          %msubsup
                            %mo ∫
                            %mn 0
                            %mn ∞
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi e
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi s
                              %mi t
                          %mi θ
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi e
                            %mi t
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msup
                            %mi e
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo −
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mi t
                          %mspace{:width => "thickmathspace"}
                          %mi dt
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %msubsup
                            %mo ∫
                            %mn 0
                            %mn ∞
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi e
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi s
                              %mi t
                          %mo{:stretchy => "false"} (
                          %mi θ
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi e
                            %mi t
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msup
                            %mi e
                            %mi t
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mi d
                          %mi t
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\frac{\Phi(s)}{s} - \frac1{s-1} &amp; = &amp; \int_0^\infty \; e^{-s t}\theta(e^t) - e^{(1-s)t}\; dt \\
                  \&amp; = &amp; \int_0^\infty \; e^{-s t} (\theta(e^t) - e^t)\; d t
                  }
          %p
            or what is the same, for the region
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Re(s) \gt 0
          #eq:laplace.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi s
                      %mo +
                      %mn 1
                  %mo −
                  %mfrac
                    %mn 1
                    %mi s
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mi t
                  %mo{:stretchy => "false"} (
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi e
                    %mi t
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msup
                    %mi e
                    %mi t
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi t
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                      %mi t
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msup
                          %mi e
                          %mi t
                      %mrow
                        %msup
                          %mi e
                          %mi t
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi t
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\Phi(s+1)}{s+1} - \frac1{s} = \int_0^\infty \; e^{-(s+1) t} (\theta(e^t) - e^t)\; d t = \int_0^\infty \; e^{-s t}\left( \frac{\theta(e^t) - e^t}{e^t} \right)\; d t
          %p
            where the left side is in fact holomorphic over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Re(s) \geq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} s = 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
          %p The Tauberian theorem we will establish permits the conclusion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %munder
                    %mi lim
                    %mrow
                      %mi s
                      %mo ↘
                      %mn 0
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi s
                      %mi t
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msup
                          %mi e
                          %mi t
                      %mrow
                        %msup
                          %mi e
                          %mi t
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi t
                  %mo =
                  %msubsup
                    %mo ∫
                    %mn 0
                    %mn ∞
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %mi θ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi e
                        %mi t
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msup
                        %mi e
                        %mi t
                    %mrow
                      %msup
                        %mi e
                        %mi t
                  %mspace{:width => "thickmathspace"}
                  %mi d
                  %mi t
                %annotation{:encoding => "application/x-tex"} L = \underset{s \searrow 0}{\lim} \int_0^\infty \; e^{-s t}\left( \frac{\theta(e^t) - e^t}{e^t} \right)\; d t = \int_0^\infty \; \frac{\theta(e^t) - e^t}{e^t} \; d t
          %p which in turn will yield the Prime Number Theorem:
          #pnt.num_theorem
            %h6#theorem_2 Theorem
            %p
              The integral
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mn ∞
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msup
                          %mi e
                          %mi t
                      %mrow
                        %msup
                          %mi e
                          %mi t
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} \int_0^\infty \; \frac{\theta(e^t) - e^t}{e^t} \; d t
              converges.
          %p
            (The prime number theorem follows from this by
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:rewrite"} (4)
            = succeed "," do
              %a.maruku-ref{:href => "#conv"}
            = succeed ".)" do
              %a.maruku-ref{:href => "#asymp"}
          %h2#proof_of_the_tauberian_theorem Proof of the Tauberian theorem
          %p Here is the statement of the particular Tauberian theorem used (recalling that “Tauberian” signifies a family of theorems that roughly speaking give conditions for convergence of series or integral expressions occurring at natural boundaries of regions where series or integral representations are defined). This particular form was given by D.J. Newman, and allows a dramatic shortening of the proof of the prime number theorem, as shown convincingly by Zagier, who as we said compressed it down to under three pages.
          #taub.num_theorem
            %h6#theorem_3 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(t)
              be a function that is bounded and locally integrable over the domain
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t \geq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Re(s) \gt 0
              by the equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mn ∞
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi s
                        %mi t
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} g(s) = \int_0^\infty \; e^{-s t} f(t)\; d t,
            %p
              extends to a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              that is holomorphic over the region
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Re(s) \geq 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mn ∞
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                  %annotation{:encoding => "application/x-tex"} \int_0^\infty\; f(t)\; d t
              converges and equals
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(0)
          %p
            The proof below involves some fairly refined complex analysis. It may be well to recall that we say a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is
            %em holomorphic
            at a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi z
                    %mn 0
                %annotation{:encoding => "application/x-tex"} z_0
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is defined over a small neighborhood
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi z
                  %mo :
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi z
                    %mo −
                    %msub
                      %mi z
                      %mn 0
                    %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi δ
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{z: {|z-z_0|} \lt \delta\}
            of the point and in that neighborhood is expressible as a convergent Taylor series
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                  %mfrac
                    %mrow
                      %msub
                        %mi a
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo −
                      %msub
                        %mi z
                        %mn 0
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                    %mrow
                      %mi n
                      %mo !
                  %mo .
                %annotation{:encoding => "application/x-tex"} g(z) = \sum_{n=0} \frac{a_n (z - z_0)^n}{n!}.
          %p
            Then we say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is holomorphic over a (not necessarily open) region if it is holomorphic at every point in the region.
          %p
            In the case of interest
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi e
                          %mi t
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msup
                          %mi e
                          %mi t
                      %mrow
                        %msup
                          %mi e
                          %mi t
                  %annotation{:encoding => "application/x-tex"} f(t) = \frac{\theta(e^t) - e^t}{e^t}
            %a.maruku-ref{:href => "#cheb"}
            guarantees that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is bounded and locally integrable, and we have already observed that its Laplace transform, which is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi s
                      %mo +
                      %mn 1
                  %mo −
                  %mfrac
                    %mn 1
                    %mi s
                %annotation{:encoding => "application/x-tex"} g(s) = \frac{\Phi(s+1)}{s+1} - \frac1{s}
          %p
            by
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:laplace"} (5)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Re
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} Re(s) \geq 0
            by Proposition
            = succeed "." do
              %a.maruku-ref{:href => "#nozero"}
            = succeed "." do
              %a.maruku-ref{:href => "#pnt"}
            = succeed "." do
              %a.maruku-ref{:href => "#taub"}
          .proof
            %h6#proof_6 Proof
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} T \geq 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mi T
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi s
                        %mi t
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo .
                  %annotation{:encoding => "application/x-tex"} g_T(s) = \int_0^T \; e^{-s t} f(t)\; d t.
            %p
              Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                  %annotation{:encoding => "application/x-tex"} g_T
              is an entire (i.e., everywhere holomorphic) function. We are trying to show that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %mrow
                          %mi T
                          %mo →
                          %mn ∞
                      %msub
                        %mi g
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \underset{T \to \infty}{\lim} g_T(0) = g(0)
            %p A straightforward application of Cauchy’s theorem yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                    %msub
                      %mo ∫
                      %mi C
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msub
                        %mi g
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo )
                    %msup
                      %mi e
                      %mrow
                        %mi z
                        %mi T
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi z
                      %mi z
                  %annotation{:encoding => "application/x-tex"} g_T(0) - g(0) = \frac1{2\pi i} \int_C \; \left(g_T(z) - g(z)\right) e^{z T}\; \frac{d z}{z}
            %p
              for contours
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              having
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              as an interior point, such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                    %mo −
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g_T - g
              is holomorphic on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and its interior. We will choose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to be the boundary of the closed region
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi z
                    %mo :
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi z
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mi R
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ≥
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi δ
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} D = \{z: {|z|} \leq R\; and\; Re(z) \geq -\delta\}
              where for a given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              small enough that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                    %mo −
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g_T - g
              is holomorphic in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              (this uses compactness of the interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi i
                    %mi t
                    %mo :
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi R
                    %mo ≤
                    %mi t
                    %mo ≤
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I = \{i t: -R \leq t \leq R\}
              and holomorphicity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                    %mo −
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g_T - g
              along
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
            %p
              The idea would be to estimate the contribution of the integral over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mo +
                    %annotation{:encoding => "application/x-tex"} C_+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              where the real part is nonnegative, and over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo −
                  %annotation{:encoding => "application/x-tex"} C_-
              where it is nonpositive, hoping to show these contributions are small when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is large. This almost works, except that we don’t have good control over the size of the contributions near the area where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Re(z) = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo +
                    %mfrac
                      %mrow
                        %msup
                          %mi z
                          %mn 2
                      %mrow
                        %msup
                          %mi R
                          %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1 + \frac{z^2}{R^2})
              is introduced in the integrand (“Carleman’s formula”): this is close to zero near
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Re(z) = 0
              and has the desired mitigating effect.
            %p Thus we instead use
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                    %msub
                      %mo ∫
                      %mi C
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %msub
                        %mi g
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo )
                    %msup
                      %mi e
                      %mrow
                        %mi z
                        %mi T
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mn 1
                      %mo +
                      %mfrac
                        %mrow
                          %msup
                            %mi z
                            %mn 2
                        %mrow
                          %msup
                            %mi R
                            %mn 2
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi z
                      %mi z
                  %annotation{:encoding => "application/x-tex"} g_T(0) - g(0) = \frac1{2\pi i} \int_C \; \left(g_T(z) - g(z)\right) e^{z T}\; \left(1 + \frac{z^2}{R^2}\right)\; \frac{d z}{z}
            %p
              Suppose now that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {|f(t)|}
              is globally bounded by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Re(z) \gt 0
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi g
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %msubsup
                      %mo ∫
                      %mi T
                      %mn ∞
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %msup
                        %mi e
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi z
                          %mi t
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo ≤
                    %mi B
                    %msubsup
                      %mo ∫
                      %mi T
                      %mn ∞
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mi t
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo =
                    %mi B
                    %mfrac
                      %mrow
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi z
                            %mo{:stretchy => "false"} )
                            %mi T
                      %mrow
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {|g_T(z) - g(z)|} \leq \int_T^\infty\; {|f(t)e^{-z t}|}\; d t \leq B \int_T^\infty e^{-Re(z)t}\; d t = B \frac{e^{-Re(z)T}}{Re(z)}
            %p
              and we also have, over the circle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi z
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mi R
                    %annotation{:encoding => "application/x-tex"} {|z|} = R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %msup
                                %mi e
                                %mrow
                                  %mi z
                                  %mi T
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo +
                              %msup
                                %mi z
                                %mn 2
                              %mo{:stretchy => "false"} /
                              %msup
                                %mi R
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mi z
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} |
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi e
                              %mrow
                                %mi Re
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mi T
                            %mo ⋅
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi R
                                %mn 2
                              %msup
                                %mi z
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo +
                              %mi z
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %msup
                                %mi R
                                %mn 2
                              %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi e
                              %mrow
                                %mi Re
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mi T
                            %mo ⋅
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mo{:stretchy => "false"} (
                              %msup
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %mi z
                                  %mo{:stretchy => "false"} |
                                %mn 2
                              %msup
                                %mi z
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo +
                              %mi z
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %msup
                                %mi R
                                %mn 2
                              %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi e
                              %mrow
                                %mi Re
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mi T
                            %mo ⋅
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mo{:stretchy => "false"} (
                              %mover
                                %mi z
                                %mo{:stretchy => "false"} ¯
                              %mo +
                              %mi z
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %msup
                                %mi R
                                %mn 2
                              %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %msup
                              %mi e
                              %mrow
                                %mi Re
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mi T
                            %mo ⋅
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mn 2
                              %mi Re
                              %mo{:stretchy => "false"} (
                              %mi z
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} |
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi R
                              %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    {|e^{z T}(1 + z^2/R^2)(1/z)|} &amp; = &amp; e^{Re(z)T} \cdot {|(R^2 z^{-1} + z)/R^2|} \\
                    \&amp; = &amp; e^{Re(z)T} \cdot {|({|z|}^2 z^{-1} + z)/R^2|} \\
                    \&amp; = &amp; e^{Re(z)T} \cdot {|(\bar{z} + z)/R^2|} \\
                    \&amp; = &amp; e^{Re(z)T} \cdot {|2Re(z)|}/R^2
                    }
            %p
              so that putting the factors together, the integral over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo +
                  %annotation{:encoding => "application/x-tex"} C_+
              is bounded in absolute value by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi B
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi R
                      %mn 2
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi C
                          %mo +
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi d
                      %mi z
                      %mo{:stretchy => "false"} |
                    %mo =
                    %mn 2
                    %mi π
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi R
                  %annotation{:encoding => "application/x-tex"} 2B/R^2 \int_{C_+}\; {|d z|} = 2\pi B/R
            %p
              (and of course this hasn’t taken into account the factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                  %annotation{:encoding => "application/x-tex"} \frac1{2\pi i}
              outside the integral). In any case, with the Carleman factor, the contribution from the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo +
                  %annotation{:encoding => "application/x-tex"} C_+
              part is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} /
                      %mi R
                    %annotation{:encoding => "application/x-tex"} B/R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is large.
            %p
              Now we bound the contribution from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo −
                  %annotation{:encoding => "application/x-tex"} C_-
              by considering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                  %annotation{:encoding => "application/x-tex"} g_T
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              separately. First let us bound
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi C
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi g
                      %mi T
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mi z
                        %mi T
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mn 1
                      %mo +
                      %mfrac
                        %mrow
                          %msup
                            %mi z
                            %mn 2
                        %mrow
                          %msup
                            %mi R
                            %mn 2
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi d
                        %mi z
                      %mi z
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \frac1{2\pi i} \int_{C_-} \; g_T(z) e^{z T}\; \left(1 + \frac{z^2}{R^2}\right)\; \frac{d z}{z}.
            %p
              For this, we can take advantage of the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                  %annotation{:encoding => "application/x-tex"} g_T
              is entire, and (courtesy of Cauchy’s theorem) replace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo −
                  %annotation{:encoding => "application/x-tex"} C_-
              by the semicircle where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi z
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mi R
                      %mo ,
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} {|z|} = R, Re(z) \lt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi g
                        %mi T
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mi T
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msup
                        %mi e
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi z
                          %mi t
                      %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo ≤
                    %mi B
                    %msubsup
                      %mo ∫
                      %mn 0
                      %mi T
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mi t
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo ≤
                    %mi B
                    %msubsup
                      %mo ∫
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn ∞
                      %mi T
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mi t
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi t
                    %mo =
                    %mi B
                    %mfrac
                      %mrow
                        %msup
                          %mi e
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi Re
                            %mo{:stretchy => "false"} (
                            %mi z
                            %mo{:stretchy => "false"} )
                            %mi T
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} {|g_T(z)|} \leq \int_0^T {|f(t)|}\cdot {|e^{-z t}|}\; d t \leq B \int_0^T e^{-Re(z)t}\; d t \leq B \int_{-\infty}^T e^{-Re(z)t}\; d t = B \frac{e^{-Re(z)T}}{-Re(z)}.
            %p
              Bear in mind here that we are now considering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} Re(z) \lt 0
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi Re
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} -Re(z) = {|Re(z)|}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi e
                        %mrow
                          %mi Re
                          %mo{:stretchy => "false"} (
                          %mi z
                          %mo{:stretchy => "false"} )
                          %mi T
                      %mo ⋅
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mn 2
                        %mi Re
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi R
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} e^{Re(z)T} \cdot {|2Re(z)|}/R^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo −
                  %annotation{:encoding => "application/x-tex"} C_-
              the overall contribution from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi T
                  %annotation{:encoding => "application/x-tex"} g_T
              has upper bound
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} /
                      %mi R
                    %annotation{:encoding => "application/x-tex"} B/R
            %p Finally, we bound
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %mn 2
                        %mi π
                        %mi i
                    %msub
                      %mo ∫
                      %mrow
                        %msub
                          %mi C
                          %mo −
                    %mspace{:width => "thickmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi e
                      %mrow
                        %mi z
                        %mi T
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mn 1
                      %mo +
                      %mfrac
                        %mrow
                          %msup
                            %mi z
                            %mn 2
                        %mrow
                          %msup
                            %mi R
                            %mn 2
                      %mo )
