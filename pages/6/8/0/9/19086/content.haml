                  %mo .
                %annotation{:encoding => "application/x-tex"} \Phi(s) = \sum_p \frac{\log(p)}{p^s}.
          %p
            Over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Re
                    %mo{:stretchy => "false"} (
