                        %annotation{:encoding => "application/x-tex"} p
                = succeed ")" do
                  %a{:href => "http://qjmath.oxfordjournals.org/content/12/1/52.citation"} pdf
            %li#MP11concise
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kate+Ponto"} Kate Ponto
                = succeed "," do
                  %em
