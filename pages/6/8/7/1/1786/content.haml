          %h2#definition Definition
          %p
            An
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              \-space
            (“H” for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Heinz+Hopf"} Hopf
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Hopf+construction"} Hopf construction
            %a.existingWikiWord{:href => "/nlab/show/magma"} magma
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
            the
            %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            of
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} Ho(Top)_*
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            %a.existingWikiWord{:href => "/nlab/show/unit"} unit
            up to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
          %p Similarly:
          %ul
            %li
              %p
                An
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/H-monoid"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                    \-monoid
                is a
                %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
                in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
                = succeed "-space" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                = succeed "-monoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
                up to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
            %li
              %p
                An
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  \-group
                (or
                = succeed ")" do
                  %em grouplike space
                %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
                in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
                = succeed "-monoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                = succeed "-group" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
                up to homotopy (cf.
                = succeed ")." do
                  %a{:href => "#Arkowitz11"} Arkowitz 2011 Def. 2.2.1
            %li
              %p
                An
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  \-ring
                is a
                %a.existingWikiWord{:href => "/nlab/show/ring+object"} ring object
                in (pointed)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
          %p
            To continue in this pattern, one could say that an
            %strong
              %a.existingWikiWord{:href => "/nlab/show/H-category"} H-category
            is a category internal to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
          %p
            Notice that here the homotopies for units, associativity etc. are only required to
            %em exist
            for an H-space, not required to be equipped with higher
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
            homotopies. An
            = succeed "-monoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %em strongly homotopy associative
            space or
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
              \-
              %a.existingWikiWord{:href => "/nlab/show/A-infinity+space"} space
            for short. If it has only higher homotopies up to level
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                  %annotation{:encoding => "application/x-tex"} A_n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/A-n+space"} space
          %p
            A better name for an
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/unitoid"} unitoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            stands for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Heinz+Hopf"} Heinz Hopf
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} already occupied
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p
            There are dual notions of
            = succeed "-counitoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-space," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} H'
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/co-H-space"} co-H-space
            = succeed "-comonoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-monoid)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} H'
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/cogroup"} cogroup
            (or
            = succeed "-group)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} H'
          %h2#Examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              %strong (topological groups)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
              are the
              = succeed "-groups" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
              (
              %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
              ,
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              and
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
              %a.existingWikiWord{:href => "/nlab/show/equalities"} equalities
              and not just as
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
          %p
          .num_remark
            %h6 Example
            %p
              %strong (loop spaces)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              its based
              %a.existingWikiWord{:href => "/nlab/show/loop+space"} loop space
              is an
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
            %p
              Of course, loop groups have a much more structured grouplike structure: They are grouplike
              %a.existingWikiWord{:href => "/nlab/show/A-infinity+spaces"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
                \-spaces
              also called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infinity-groups"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                    \-groups
            %p
              Generally, if an
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} deloopable one
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category"} group object in the (∞,1)-category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/higher+homotopy"} higher homotopy
          %p
          .num_remark
            %h6 Example
            %p
              %strong (suspensions)
              %br/
              The main example of
              %a.existingWikiWord{:href => "/nlab/show/co-H-space"} H-cogroups
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Top_*
              are
              %a.existingWikiWord{:href => "/nlab/show/reduced+suspensions"} reduced suspensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S X= S^1\wedge X
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
          .num_remark
            %h6 Example
            %p
              %strong (sphere)
              %br/
              The only
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              which have
              = succeed "-space" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ,
                      %mn 3
                      %mo ,
                      %mn 7
                    %annotation{:encoding => "application/x-tex"} n = 0, 1, 3, 7
              %a.existingWikiWord{:href => "/nlab/show/unit+spheres"} unit spheres
              in one of the four
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
              (
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"}> real numbers
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                  %annotation{:encoding => "application/x-tex"} S^7
              is an example of an H-space that does not lift to an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/A-infinity+space"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} A_\infty
                  \-space
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              would have
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
              a
              %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
              on a generator in degree 8, and this is impossible by mod
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+operations"} Steenrod operations
              for any odd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              (cf.
              = succeed "." do
                %a{:href => "#Adams61"} Adams 1961 Lemma 2
              = succeed "-group." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
          %p
          .num_remark
            %h6 Example
            %p
              %strong (Mapping spaces into H-groups)
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is an
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [X,K]
              of
              %a.existingWikiWord{:href => "/nlab/show/maps"} maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} X \to K
              has a natural group structure in the strict sense. Analogously, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} K'
              is an
              = succeed "-cogroup" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi K
                    %mo ′
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [K',X]
              has a group structure.
            %p
              If there is more than one
              = succeed "-group" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
          %p
          .num_remark
            %h6 Example
            %p
              %strong (K-Theory classifying space)
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi U
                    %mo ×
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} B U \times \mathbb{Z}
              for (complex)
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              is an H-ring space (cf. p. 205 (213 of 251) in
              = succeed ".)" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/A+Concise+Course+in+Algebraic+Topology"} A Concise Course in Algebraic Topology
          %p
          .num_remark
            %h6 Example
            %p
              The
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Dwyer-Wilkerson+H-space"} Dwyer-Wilkerson H-space
          %h2#properties Properties
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be a
            %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            H-space. Then for every
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
            %a.existingWikiWord{:href => "/nlab/show/maps"} maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mu(a,-),\mu(-,a):A \to A
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
          %h3#nilpotency Nilpotency
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            H-space is
            %a.existingWikiWord{:href => "/nlab/show/nilpotent+topological+space"} nilpotent
            (see
            = succeed ")." do
              %a{:href => "nilpotent+topological+space#Properties"} there
          %h3#relation_to_spaces
            Relation to
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+space"} A-∞ space
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category of an (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
            in an
            = succeed "-space." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "-space" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a.existingWikiWord{:href => "/nlab/show/monoid+object+in+an+%28%E2%88%9E%2C1%29-category"} monoid object in an (∞,1)-category
            from the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+an+%28%E2%88%9E%2C1%29-category"} homotopy category
            %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
            to the genuine
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %p
            Further discussion of this is also at
            = succeed "." do
              %em
                %a{:href => "loop+space#AInfinityStructure"} loop space – Homotopy associative structure
          %h3#RingStructureOnHomology Ring structure on homology
          %p
            The operations on an
            %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equip its
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            with the
            %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} structure
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            this is known as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+ring"} Pontrjagin ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_*(X)
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#RationalHomotopy Rational homotopy
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            H-space of rational
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            (i.e., whose
            %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
            in each degree is a
            %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+vector+space"} finite-dimensional
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/rational+vector+space"} rational vector space
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+equivalence"} rationally homotopy equivalent
            to a
            %a.existingWikiWord{:href => "/nlab/show/product+space"} product
            of
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spaces"} Eilenberg-MacLane spaces
            (e.g.
            = succeed ")." do
              %a{:href => "#MP11concise"} May &amp; Ponto 2011, Thm. 9.1.1
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            has vanishing
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+models+of+based+loop+spaces"} Sullivan models of based loop spaces
          %p
            If such an H-space in addition admits the structure of a
            %a.existingWikiWord{:href => "/nlab/show/finite+CW-complex"} finite CW-complex
            then it has the
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+equivalence"} rational homotopy type
            of a finite
            %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product
            of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/odd+number"} odd
            %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+manifold"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/rational+n-sphere"} rational spheres
            (Cor. 9.1.2. of
            = succeed ")." do
              %a{:href => "#MP11concise"} May &amp; Ponto 2011
          %p
            For example, since
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            have CW-complex structure (see
            = succeed ")" do
              %a{:href => "CW+complex#SmoothManifoldsAdmitCWComplexStructure"} there
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            (e.g.
            = succeed ")." do
              %a{:href => "#Lin95"} Lin 1995
          %h2#hspaces_in_homotopy_type_theory H-Spaces in homotopy type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %em H-spaces
            may be axiomatized as consists of
          %ul
            %li
              A type
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %li
              A basepoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} e:A
            %li
              A binary operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mu : A \to A \to A
            %li
              A left unitor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo :
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \lambda:\prod_{(a:A)} \mu(e,a)=a
            %li
              A right unitor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo :
                          %mi A
                          %mo{:stretchy => "false"} )
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \rho:\prod_{(a:A)} \mu(a,e)=a
          %p
            A
            %strong homomorphism of H-spaces
            between two H-spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            consists of
          %ul
            %li
              %p
                A function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \phi:A \to B
                such that
              %ul
                %li
                  The basepoint is preserved
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi e
                            %mi A
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi e
                            %mi B
                        %annotation{:encoding => "application/x-tex"} \phi(e_A) = e_B
                %li
                  The binary operation is preserved
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi a
                              %mo :
                              %mi A
                              %mo{:stretchy => "false"} )
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi b
                              %mo :
                              %mi A
                              %mo{:stretchy => "false"} )
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi μ
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msub
                            %mi μ
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \prod_{(a:A)} \prod_{(b:A)} \phi(\mu_A(a, b)) = \mu_B(\phi(a),\phi(b))
            %li
              %p A function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi λ
                  %mo :
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo :
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi A
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                    %mo )
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} )
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mi B
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                    %mo )
                %annotation{:encoding => "application/x-tex"} \phi_\lambda:\left(\prod_{(a:A)} \mu(e_A,a)=a\right) \to \left(\prod_{(b:B)} \mu(e_B,b)=b\right)
          %p such that the left unitor is preserved:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi λ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi λ
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi λ
                    %mi B
                %annotation{:encoding => "application/x-tex"} \phi_\lambda(\lambda_A) = \lambda_B
          %ul
            %li A function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi ρ
                  %mo :
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo :
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi e
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                    %mo )
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo :
                        %mi B
                        %mo{:stretchy => "false"} )
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %msub
                      %mi e
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                    %mo )
                %annotation{:encoding => "application/x-tex"} \phi_\rho:\left(\prod_{(a:A)} \mu(a, e_A)=a\right) \to \left(\prod_{(b:B)} \mu(b, e_B)=b\right)
          %p such that the right unitor is preserved:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi ρ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ρ
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi ρ
                    %mi B
                %annotation{:encoding => "application/x-tex"} \phi_\rho(\rho_A) = \rho_B
          %p
          .num_remark
            %h6 Example
            %p
              The H-space structure on the
              %a.existingWikiWord{:href => "/nlab/show/circle"} circle
              is proven as Lemma 8.5.8 of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} HoTT book
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+monoid"} topological monoid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+ring"} Pontrjagin ring
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/group+completion"} group completion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/H-space+ring+spectrum"}> H-space ring spectrum
                ,
                %a.existingWikiWord{:href => "/nlab/show/H-group+ring+spectrum"} H-group ring spectrum
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/H-spaceoid"} H-spaceoid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/A3-space"} A3-space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/H-spatial+groupoid"} H-spatial groupoid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/k-tuply+associative+n-groupoid"} k-tuply associative n-groupoid
          %h2#references References
          %p Introduction and survey:
          %ul
            %li#Hatcher02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Allen+Hatcher"}> Allen Hatcher
                , §3.C in:
                = succeed "," do
                  %em Algebraic Topology
                = succeed "," do
                  %a{:href => "https://www.cambridge.org/gb/academic/subjects/mathematics/geometry-and-topology/algebraic-topology-1?format=PB&isbn=9780521795401"} ISBN:9780521795401
                = succeed "&rbrack;" do
                  %a{:href => "https://pi.math.cornell.edu/~hatcher/AT/ATpage.html"} webpage
            %li#Arkowitz11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Arkowitz"}> Martin Arkowitz
                ,
                = succeed "," do
                  %em H-Spaces and Co-H-Spaces
                = succeed "," do
                  %em Introduction to homotopy theory
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-1-4419-7329-0_2"} doi:10.1007/978-1-4419-7329-0_2
          %p
            The terminology “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            \-space” appear sin
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Pierre+Serre"}> Jean-Pierre Serre
              , Chapter IV, Section 1 of:
              = succeed "," do
                %em Homologie singulière des espaces fibrés. Applications.
              %strong 54
              (1951), 425–505.
          %p Early discussion:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+Browder"}> William Browder
              ,
              = succeed "," do
                %em Torsion in H-Spaces
              %strong 74
              1 (1961) 24-51 &amp;lbrack;
              %a{:href => "https://www.jstor.org/stable/1970305"}> jstor:1970305
              \&amp;rbrack;
          %p
            More general notion of
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            H-objects:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Beno+Eckmann"}> Beno Eckmann
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"} Peter Hilton
                = succeed "," do
                  %em Group-like structures in general categories I multiplications and comultiplications
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF01451367"} doi:10.1007/BF01451367
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Beno+Eckmann"}> Beno Eckmann
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"} Peter Hilton
                = succeed "," do
                  %em Group-like structures in general categories III primitive categories
                %strong 150
                165–187 (1963) (
                %a{:href => "https://doi.org/10.1007/BF01470843"}> doi:10.1007/BF01470843
                )
          %p Original articles:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edwin+Spanier"}> Edwin Spanier
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Henry+Whitehead"} Henry Whitehead
                = succeed "," do
                  %em On fibre spaces in which the fibre is contractible
                = succeed "," do
                  %strong 29
            %li
              %p
                Arthur H. Copeland,
                = succeed "," do
                  %em
                    On
                    = succeed "-spaces" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi H
                          %annotation{:encoding => "application/x-tex"} H
                = succeed "," do
                  %strong 8
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Masahiro+Sugawara"}> Masahiro Sugawara
                \:
              %ul
                %li
                  %em>
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
                    \-spaces and spaces of loops
                  , Math. J. Okayama Univ,
                  = succeed "," do
                    %strong 5
                %li
                  %em>
                    A condition that a space is an
                    = succeed "-space" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi H
                          %annotation{:encoding => "application/x-tex"} H
                  , Math. J. Okayama Univ.
                  = succeed "," do
                    %strong 6
                  = succeed ")" do
                    %a{:href => "https://ousar.lib.okayama-u.ac.jp/files/public/3/33737/20160528030627675220/fulltext.pdf"} pdf
                %li
                  %em> A condition that a space is group-like
                  , Math. J. Okayama Univ.
                  = succeed "," do
                    %strong 7
            %li
              %p
                F. I. Karpelevič, A. L. Oniščik,
                = succeed "," do
                  %em Algebra of homologies of space of paths
          %p
            The theory of
            = succeed "-spaces" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p The deloopable case has more coherent structure which has been discovered few years later in J. Stasheff’s thesis and published in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"}> Jim Stasheff
              ,
              = succeed "," do
                %em
                  Homotopy associative
                  = succeed "-spaces" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi H
                        %annotation{:encoding => "application/x-tex"} H
          %p For a historical account see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+McCleary"}> John McCleary
              ,
              %em An appreciation of the work of Jim Stasheff
              (
              %a{:href => "http://www.math.unc.edu/Faculty/jds/jds.pdf"}> pdf
              )
          %p
            The description in terms of
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
            is due to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p see last remark of section 6.1.2 .
          %p
            Wikipedia's definition (at time of this writing, and phrased in the language of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/unitoid"} unitoid
            object in the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %ul
            %li
              MathOverflow:
              %a{:href => "http://mathoverflow.net/questions/16711/homotopy-associative-h-space-and-coh-space"} homotopy-associative-h-space-and-coh-space
          %p
            For H-spaces in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Univalent+Foundations+Project"}> Univalent Foundations Project
                ,
                %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} Homotopy Type Theory – Univalent Foundations of Mathematics
                (2013)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrik+Buchholtz"}> Ulrik Buchholtz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/J.+Daniel+Christensen"} J. Daniel Christensen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jarl+G.+Taxer%C3%A5s+Flaten"} Jarl G. Taxerås Flaten
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"} Egbert Rijke
                %em Central H-spaces and banded types
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2301.02636"}> arXiv:2301.02636
                \&amp;rbrack;
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Adams"}> John Adams
                ,
                = succeed "," do
                  %em
                    Finite
                    = succeed "-Spaces" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
