                            %mi H
                          %annotation{:encoding => "application/x-tex"} H
                = succeed ")" do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/adamse8.pdf"} pdf
            %li#Adams61
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Adams"}> John Adams
                ,
                = succeed "," do
                  %em
                    The sphere, considered as an
                    = succeed "-space" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
