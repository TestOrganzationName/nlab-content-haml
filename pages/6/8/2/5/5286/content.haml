          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong Batalin-Vilkovisky algebra
              or
              %strong BV-algebra
              for short is
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Gerstenhaber+algebra"} Gerstenhaber algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mo ⋅
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (A, \cdot, [-,-])
              %li
                %p
                  equipped with a unary
                  %a.existingWikiWord{:href => "/nlab/show/linear+operator"} linear operator
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo :
                        %mi A
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} \Delta : A \to A
                  of the same degree as the bracket
              %li
                %p such that
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Δ
                          %annotation{:encoding => "application/x-tex"} \Delta
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
                      for
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} ]
                            %annotation{:encoding => "application/x-tex"} [-,-]
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                          %annotation{:encoding => "application/x-tex"} [-,-]
                      is the failure of
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Δ
                          %annotation{:encoding => "application/x-tex"} \Delta
                      being a derivation for
                      = succeed ":" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo ⋅
                            %annotation{:encoding => "application/x-tex"} \cdot
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                            %mo =
                            %mi Δ
                            %mo ∘
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ⋅
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ⋅
                            %mi Δ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                          %annotation{:encoding => "application/x-tex"}
                            [-,-] = \Delta \circ (-\cdot -) - (\Delta(-) \cdot - ) - (- \cdot \Delta(-))
                            \\,.
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
                \-BV algebra
              is a similar structure with a BV-operator being of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is odd, and of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n/2
              if it is even.
          %p
            For details cf.
            = succeed "." do
              %a{:href => "#CohenVoronov2006"} Cohen &amp; Voronov 2006, def. 5.3.1, theorem 2.1.3
          %h2#properties Properties
          .num_theorem
            %h6#theorem Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/operad"} operad
              for BV-algebras is the
              %a.existingWikiWord{:href => "/nlab/show/homology"} homology
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/framed+little+2-disk+operad"} framed little 2-disk operad
          %p
            This is due to (
            %a{:href => "#Getzler"}> Getzler
            )
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homology"} homology
              of an
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
              over the
              %a.existingWikiWord{:href => "/nlab/show/framed+little+n-disk+operad"} framed little n-disk operad
              has a natural structure of an
              = succeed "-BV-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
          %p
            This appears as
            = succeed "." do
              %a{:href => "#CohenVoronov2006"} Cohen &amp; Voronov 2006, theorem 5.3.3
            %a.existingWikiWord{:href => "/nlab/show/homology"} homology
            of the
            %a.existingWikiWord{:href => "/nlab/show/framed+little+n-disk+operad"} framed little n-disk operad
            is described by
            = succeed "." do
              %a{:href => "#SalvatoreWahl"} Salvatore &amp; Wahl, theorem 5.4
          %h2#examples Examples
          %ul
            %li
              On a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with a
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              the operation of contraction with the volume form gives an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              between
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/multivector+field"} multivector field
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/multivector+field"} multivector field
          %p
            Multivector fields may be identified with
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
            in good cases (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Hochschild-Kostant-Rosenberg+theorem"} Hochschild-Kostant-Rosenberg theorem
          %ul
            %li#ExampleHochschildCohomology
              under good conditions,
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
              (see there for details) carries a BV-algebra structure (eg.
              = succeed ";" do
                %a{:href => "#FelixThomasVigue-Poirrier04"} Felix, Thomas &amp; Vigué-Poirrier 2004
              = succeed ";" do
                %a{:href => "#Menichi09"} Menichi 2009
              = succeed ")" do
                %a{:href => "#Tradler08"} Tradler 2008
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Batalin-Vilkovisky+module"} Batalin-Vilkovisky module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Poisson+n-algebra"} Poisson n-algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/homotopy+BV-algebra"} homotopy BV-algebra
              %ul
                %li
                  %span.newWikiWord
                    dg-BV-algebra
                    %a{:href => "/nlab/new/dg-BV-algebra"} ?
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/BD-algebra"} BD-algebra
          %h2#references References
          %p The identification of BV-algebras as algebras over the homology of the framed little disk operad is due to
          %ul#Getzler
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ezra+Getzler"}> Ezra Getzler
              ,
              %em Batalin-Vilkovisky algebras and two-dimensional topological field theories
              , Comm. Math. Phys. 159 (1994), no. 2, 265–285. (
              %a{:href => "http://arxiv.org/abs/hep-th/9212043"}> arXiv
              )
          %p The generalization to higher dimensional framed little disks is discussed in
          %ul
            %li#CohenVoronov2006
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ralph+Cohen"}> Ralph Cohen
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Voronov"} Alexander Voronov
                = succeed "," do
                  %em Notes on String Topology
                = succeed "," do
                  %em String topology and cyclic homology
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/0503625"} math.GT/05036259
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/3-7643-7388-1"} doi:10.1007/3-7643-7388-1
                = succeed "&rbrack;" do
                  %a{:href => "http://gen.lib.rus.ec/get?md5=adde9464705ede0fea6b435edb58fbe7"} pdf
            %li#SalvatoreWahl
              %p
                %a.existingWikiWord{:href => "/nlab/show/Paolo+Salvatore"}> Paolo Salvatore
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Nathalie+Wahl"} Nathalie Wahl
                = succeed "," do
                  %em Framed discs operads and Batalin-Vilkovisky algebras
                %strong 54
                2 (2003) 213–231 &amp;lbrack;
                %a{:href => "http://www.math.ku.dk/~wahl/SalvatoreWahl.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1093/qmath/hag012"} doi:10.1093/qmath/hag012
          %p There are examples coming from Lagrangian intersection theory:
          %ul
            %li
              Vladimir Baranovsky, Victor Ginzburg,
              = succeed "," do
                %em Gerstenhaber-Batalin-Vilkoviski structures on coisotropic intersections
              %a{:href => "http://arxiv.org/abs/0907.0037"} arxiv/0907.0037
          %p
            The BV-algebra structure on
            %a.existingWikiWord{:href => "/nlab/show/multivector+fields"} multivector fields
            on an
            %a.existingWikiWord{:href => "/nlab/show/oriented"} oriented
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            is discussed for instance in:
          %ul
            %li#CattaneoFiorenzaLongoni
              %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"} Domenico Fiorenza
              = succeed "," do
                %em On the Hochschild-Kostant-Rosenberg map for graded manifolds
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/math/0503380"} arXiv:math/0503380
          %p and
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Claude+Roger"}> Claude Roger
              , p. 6 of:
              = succeed "," do
                %em Gerstenhaber and Batalin-Vilkovisky algebras
              = succeed ")" do
                %a{:href => "http://www.emis.de/journals/AM/09-4/roger.pdf"} pdf
          %p
            The BV-algebra structure on
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
          %ul
            %li#FelixThomasVigue-Poirrier04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yves+F%C3%A9lix"}> Yves Félix
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jean-Claude+Thomas"} Jean-Claude Thomas
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Micheline+Vigu%C3%A9-Poirrier"} Micheline Vigué-Poirrier
                %em The Hochschild cohomology of a closed manifold
                Publ. Math. IHÉS Sci.
                %strong 99
                (2004) 235-252 &amp;lbrack;
                %a{:href => "http://www.numdam.org/item/PMIHES_2004__99__235_0"}> numdam:PMIHES_2004__99__235_0/
                \&amp;rbrack;
            %li#Menichi09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Luc+Menichi"}> Luc Menichi
                ,
                = succeed "," do
                  %em Batalin-Vilkovisky algebra structures on Hochschild cohomology
                %strong 137
                2 (2009) 277-295
              %p
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/0711.1946"}> arXiv:0711.1946
                ,
                = succeed "," do
                  %a{:href => "http://www.numdam.org/item/BSMF_2009__137_2_277_0/"} numdam:BSMF_2009__137_2_277_0/
                = succeed "&rbrack;" do
                  %a{:href => "http://math.univ-angers.fr/perso/lmenichi/BV_Hochschild.pdf"} pdf
            %li#Tradler08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Tradler"}> Thomas Tradler
                ,
                = succeed "," do
                  %em The BV Algebra on Hochschild Cohomology Induced by Infinity Inner Products
                %strong 58
                7 (2008) 2351-2379 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0210150"}> arXiv:math/0210150
                \&amp;rbrack;
          %p
            There is a prominent class of examples coming from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie-Rinehart+algebras"} Lie-Rinehart algebras
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Johannes+Huebschmann"}> Johannes Huebschmann
              ,
              = succeed "," do
                %em Lie-Rinehart algebras, Gerstenhaber algebras and Batalin-Vilkovisky algebras
              = succeed ":2" do
                %strong 48
              %a{:href => "https://eudml.org/doc/75288"} eudml
