          %h2#idea Idea
          %p
            The
            %strong spin group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(n)
            is a
            %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
            of the
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(n)
            %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n \gt 2
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            like
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(n)
          %p
            For special cases in low dimensions see at:
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%282%29"} Spin(2)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%286%29"} Spin(6)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%287%29"} Spin(7)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Spin%289%29"} Spin(9)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Spin%2810%29"} Spin(10)
          %h2#definition Definition
          #QuadraticVectorSpace.num_defn
            %h6#definition_2 Definition
            %p
              A
              %em quadratic vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V, \langle -,-\rangle)
              is a
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              of finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              of
              %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
              0, and equipped with a symmetric
              %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ⟩
                      %mo{:lspace => "verythinmathspace"} :
                      %mi V
                      %mo ⊗
                      %mi V
                      %mo →
                      %mi k
                    %annotation{:encoding => "application/x-tex"} \langle -,-\rangle \colon V \otimes V \to k
          %p
            Conventions as in (
            %a{:href => "#Varadarajan04"}> Varadarajan 04, section 5.3
            ).
          %p
            We write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:lspace => "verythinmathspace"} :
                  %mi v
                  %mo ↦
                  %mo{:stretchy => "false"} ⟨
                  %mi v
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} q\colon v \mapsto \langle v ,v \rangle
            for the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
          .num_defn
            %h6#definition_3 Definition
            %p
              The
              %em
                %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V,q)
              of a quadratic vector space, def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuadraticVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              which is the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(V,q)
                    \\coloneqq
                    T(V)/I(V,q)
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              by the ideal generated by the elements
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ⊗
                      %mi v
                      %mo −
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v \otimes v - q(v)
          %p
            Since the
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T(V)
            is naturally
            = succeed "-graded," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cl
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl(V,q)
            is naturally
            = succeed "-graded." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ,
                  %mi q
                  %mo =
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{R}^n, q = {\vert -\vert})
            be the
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            with its canonical
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/scalar+product"} scalar product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Cl
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cl^\mathbb{C}(\mathbb{R}^n)
            for the
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
          .num_prop
            %h6#proposition Proposition
            %p
              There exists a unique
              %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cl
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi End
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl^{\mathbb{C}}(\mathbb{R}^n) \longrightarrow End(\Delta_n)
            %p
              of the algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Cl
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl^\mathbb{C}(\mathbb{R}^n)
              of smallest
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dim
                      %mi ℂ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mn 2
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} /
                        %mn 2
                        %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    dim_{\mathbb{C}}(\Delta_n) = 2^{[n/2]}
                    \\,.
          #SpinGroup.num_defn
            %h6#definition_4 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Pin+group"} Pin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ;
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pin(V;q)
              of a quadratic vector space, def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuadraticVectorSpace"}
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
              in the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(V,q)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Pin(V,q) \hookrightarrow GL_1(Cl(V,q))
            %p
              on those elements which are multiples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi v
                      %mi n
                  %annotation{:encoding => "application/x-tex"} v_1 \cdots v_{n}
              of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_i \in V
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} q(v_i) = 1
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Spin+group"} Spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(V,q)
              is the further
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pin
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ;
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Pin(V;q)
              on those elements which are even number multiples
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi v
                      %mrow
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"} v_1 \cdots v_{2k}
              of elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi i
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v_i \in V
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi v
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} q(v_i) = 1
            %p Specifically, “the” Spin group is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Spin(n) \coloneqq Spin(\mathbb{R}^n)
                    \\,.
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
            is a
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            of the spin group, def.
            = succeed "." do
              %a.maruku-ref{:href => "#SpinGroup"}
          %h2#properties Properties
          %h3#general General
          %p
            By definition the spin group sits in a
            %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            of groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo →
                  %mi Spin
                  %mo →
                  %mi SO
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}_2 \to Spin \to SO
                  \\,.
          %h3#relation_to_whitehead_tower_of_orthogonal_group Relation to Whitehead tower of orthogonal group
          %p
            The spin group is one element in the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
