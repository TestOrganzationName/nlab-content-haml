          %h3#ExceptionalIsomorphisms Exceptional isomorphisms
          %p
            In low
            %a.existingWikiWord{:href => "/nlab/show/dimensions"} dimensions
            the
            %a.existingWikiWord{:href => "/nlab/show/spin+groups"} spin groups
            happens to be
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            to various other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+Lie+groups"} classical Lie groups
            %em
              %a.existingWikiWord{:href => "/nlab/show/exceptional+isomorphisms"} exceptional isomorphisms
            or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/sporadic+isomorphisms"} sporadic isomorphisms
          %p
            See for instance (
            %a{:href => "#Garrett13"}> Garrett 13
            ). See also
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/division+algebra+and+supersymmetry"} division algebra and supersymmetry
          %p
            In the following
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sp(n)
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/quaternionic+unitary+group"} quaternionic unitary group
            in
            %a.existingWikiWord{:href => "/nlab/show/quaternion"} quaternionic
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p We have
          %ul
            %li
              %p
                in
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+geometry"} Euclidean
                signature
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi O
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(1) \simeq O(1)
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Spin%282%29"} Spin(2)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %msup
                            %mi S
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} \simeq U(1) \simeq SO(2) \simeq S^1
                    (
                    %a.existingWikiWord{:href => "/nlab/show/SO%282%29"}> SO(2)
                    , the
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
                    = succeed ")" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/real+Hopf+fibration"} real Hopf fibration
                  %p
                    the projection
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(2)\to SO(2)
                    corresponds to
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ⋅
                                %mn 2
                            %msup
                              %mi S
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} S^1\stackrel{\cdot 2}{\longrightarrow} S^1
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Theta+characteristic"} Theta characteristic
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Spin%283%29"} Spin(3)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %mi Sp
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %msup
                            %mi S
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} \simeq Sp(1) \simeq SU(2) \simeq S^3
                    (the
                    %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
                    %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
                  %p
                    the inclusion
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ↪
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(2) \hookrightarrow Spin(3)
                    corresponds to the canonical
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                          %mo ↪
                          %msup
                            %mi S
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} S^1 \hookrightarrow S^3
                    (see e.g.
                    = succeed ")" do
                      %a{:href => "#GorbounovRay92"} Gorbounov-Ray 92
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %mi Sp
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi Sp
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %msup
                            %mi S
                            %mn 3
                          %mo ×
                          %msup
                            %mi S
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} \simeq Sp(1)\times Sp(1) \simeq S^3 \times S^3
                  %p
                    this is given by identifying
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mn 4
                          %mo ≃
                          %mi ℍ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^4 \simeq \mathbb{H}
                    with the
                    %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %msup
                            %mi S
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} SU(2) \simeq S^3
                    with the group of unit quternions. Then left and right quaternion multiplication gives a
                    %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          SU(2) \times SU(2) \longrightarrow SO(4)
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ,
                          %mi h
                          %mo{:stretchy => "false"} )
                          %mo ↦
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ↦
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi g
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi x
                          %mi h
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          (g,h) \mapsto ( x \mapsto \; g^{-1}  x h )
                  %p
                    which is a
                    %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
                    and hence exhibits the isomorphism.
                  %p
                    In particular therefore the inclusion
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                          %mo ↪
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(3) \hookrightarrow Spin(4)
                    corresponds to the
                    %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi S
                              %mn 3
                            %mo ↪
                            %msup
                              %mi S
                              %mn 3
                            %mo ×
                            %msup
                              %mi S
                              %mn 3
                          %annotation{:encoding => "application/x-tex"} S^3 \hookrightarrow S^3 \times S^3
                  %p
                    At the level of
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔰𝔬
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %msup
                            %mo ∧
                            %mn 2
                          %msup
                            %mi ℝ
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} \mathfrak{so}(4) \simeq \wedge^2 \mathbb{R}^4
                    and the
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo ±
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} \pm 1
                    %a.existingWikiWord{:href => "/nlab/show/eigenspaces"} eigenspaces
                    of the
                    %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ⋆
                          %mo{:lspace => "verythinmathspace"} :
                          %msup
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋀
                            %mn 2
                          %msup
                            %mi ℝ
                            %mn 4
                          %mo →
                          %msup
                            %mi ℝ
                            %mn 4
                        %annotation{:encoding => "application/x-tex"} \star \colon \Wedge^2 \mathbb{R}^4 \to \mathbb{R}^4
                    gives the
                    %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                    decomposition
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔰𝔬
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi 𝔰𝔲
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ⊕
                          %mi 𝔰𝔲
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi 𝔰𝔬
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                          %mo ⊕
                          %mi 𝔰𝔬
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathfrak{so}(4) \simeq \mathfrak{su}(2) \oplus \mathfrak{su}(2) \simeq \mathfrak{so}(3) \oplus \mathfrak{so}(3)
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %mi Sp
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \simeq Sp(2)
                    (an indirect consequence of
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/triality"} triality
                    = succeed ")" do
                      %a{:href => "#CadekVanzura97"} Čadek-Vanžura 97
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Spin%286%29"} Spin(6)
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ≃
                          %mi SU
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \simeq SU(4)
                    (the
                    %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
                    = succeed ")" do
                      %a{:href => "special+unitary+group#SU4"} SU(4)
            %li
              %p
                in
                %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentzian
                signature
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(1,1) \simeq GL(1,\mathbb{R})
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi SL
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(2,1) \simeq SL(2, \mathbb{R})
                    – 2d
                    %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                    of
                    %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi SL
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mi ℂ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(3,1) \simeq SL(2,\mathbb{C})
                    – 2d
                    %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                    of
                    %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi Sp
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(4,1) \simeq Sp(1,1)
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mn 5
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi SL
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo ,
                          %mi ℍ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(5,1) \simeq SL(2,\mathbb{H})
                    – 2d
                    %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
                    of
                    %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
                %li
