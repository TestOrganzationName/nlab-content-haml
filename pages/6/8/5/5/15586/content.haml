            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations of mathematics
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/theory+of+categories"} theory of categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/formal+category+theory"} formal category theory
          %h2#references References
          %ul
            %li#Lawvere63
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Functorial+Semantics+of+Algebraic+Theories"} Functorial Semantics of Algebraic Theories
              = succeed "))" do
                %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/5/tr5.pdf"} pdf
          %p A revised version of the axioms appears as
          %ul
            %li#Lawvere66
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> William Lawvere
              ,
              = succeed "," do
                %em The Category of Categories as a Foundation for Mathematics
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Samuel+Eilenberg"} S. Eilenberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/D.+K.+Harrison"} D. K. Harrison
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/S.+MacLane"} S. MacLane
              %a.existingWikiWord{:href => "/nlab/show/H.+R%C3%B6hrl"} H. Röhrl
              (eds.):
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Proceedings+of+the+Conference+on+Categorical+Algebra+-+La+Jolla+1965"} Proceedings of the Conference on Categorical Algebra - La Jolla 1965
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-3-642-99902-4"} doi:10.1007/978-3-642-99902-4
          %p Important reviews of the paper pointing out technical problems appeared here:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Isbell"}> J. R. Isbell
                ,
                = succeed "," do
                  %em Review of Lawvere 1966
                %strong 34
                (1967) #7332.
            %li
              %p
                G. Blanc. A. Preller,
                = succeed "," do
                  %em Lawvere’s basic theory of the category of categories
                %strong 40
                (1975) pp.14-18.
          %p A more recent view of Lawvere, exposing in particular his ‘Münchhausen’ approach to set-theoretic ‘foundations’, is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"}> F. W. Lawvere
              ,
              = succeed "," do
                %em Foundations and Applications: Axiomatization and Education
              %strong 9
              no.2 (2003) pp.213-224. (
              %a{:href => "https://www.math.ucla.edu/~asl/bsl/0902/0902-006.ps"}> ps-preprint
              )
          %p Lawvere briefly comments on his 1965 system 50 years later in (p. 6)
          %ul
            %li#Law16
              F. W. Lawvere,
              = succeed "," do
                %em Alexander Grothendieck and the Concept of Space
              = succeed ")" do
                %a{:href => "http://www.acsu.buffalo.edu/~wlawvere/GrothendiekAveiro15.htm"} link
          %p An insightful and non-partisan view of the ETCC can be found in a section of:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andreas+Blass"}> Andreas Blass
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Gurevich"} Yuri Gurevich
              = succeed "," do
                %em Why Sets?
              %strong 84
              (2004) 139-156. &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/978-3-540-78127-1_11"}> doi:10.1007/978-3-540-78127-1_11
              ,
              = succeed "," do
                %a{:href => "https://web.eecs.umich.edu/~gurevich/Opera/172.pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "http://www.math.lsa.umich.edu/~ablass/set.pdf"} pdf
          %p Alternative or complementary approaches are
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/J.+B%C3%A9nabou"}> J. Bénabou
                ,
                = succeed "," do
                  %em Fibered Categories and the foundations of naive category theory
                %strong 50
                (1985) pp.10-37. (
                %a{:href => "http://www.cwru.edu/artsci/phil/Benabou%20Fibered.pdf"}> preprint
                )
            %li
              %p
                G. Blanc,
                = succeed "," do
                  %em Propriétés du Premier Ordre et Catégories
                %strong 16
                (1975) pp.222-224. (
                %a{:href => "http://archive.numdam.org/ARCHIVE/CTGDC/CTGDC_1975__16_3/CTGDC_1975__16_3_217_0/CTGDC_1975__16_3_217_0.pdf"}> Colloque Amiens 1975 proceedings
                ,6.81 MB)
            %li
              %p
                G. Blanc, M. R. Donnadieu,
                = succeed "," do
                  %em Axiomatisation de la catégorie des catégories
                %strong XVII
                no. 2 (1976) pp.1-35. (
                %a{:href => "http://archive.numdam.org/ARCHIVE/CTGDC/CTGDC_1976__17_2/CTGDC_1976__17_2_135_0/CTGDC_1976__17_2_135_0.pdf"}> pdf
                )
            %li
              %p
                M. W. Bunder,
                = succeed "," do
                  %em Category Theory Based on Combinatory Logic
                %strong 24
                (1984) pp.1-15. (
                %a{:href => "http://gdz.sub.uni-goettingen.de/dms/load/img/?PPN=GDZPPN002045680"}> gdz
                )
            %li
              %p
                N. C. A. da Costa, O. Bueno, A. Volkov,
                = succeed "," do
                  %em Outline of a Paraconsistent Category Theory
                = succeed "," do
                  %em Alternative Logics. Do Science Need Them?
                = succeed ")" do
                  %a{:href => "http://homepage.mac.com/otaviobueno/.Public/ParacCategTheory.pdf"} draft
            %li
              %p
                M. R. Donnadieu,
                = succeed "," do
                  %em Démonstration du théorème de construction de catégories d’après description de Lawvere sous certains axiomes
                %strong 280
                série A (1975) pp.307-308. (
                %a{:href => "http://gallica.bnf.fr/ark:/12148/bpt6k6228238v/f59.image"}> gallica
                )
            %li
              %p
                E. Engeler, H. Röhrl,
                = succeed "," do
                  %em On the problem of foundations of category theory
                %strong 23
                (1969) pp.58-66.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Colin+McLarty"}> C. McLarty
                ,
                = succeed "," do
                  %em Axiomatizing a category of categories
                %strong 56
                (1991) pp.1243-1260. (
                %a{:href => "http://www.cwru.edu/artsci/phil/AxiomatizingCategoryCategories.pdf"}> preprint
                )
            %li
              %p
                L. Oubiña,
                = succeed "," do
                  %em Teoría axiomatica de categorías
                %strong X
                no. 3 (1968) pp.375-394. (
                %a{:href => "http://www.numdam.org/numdam-bin/item?id=CTGDC_1968__10_3_375_0"}> numdam
                )
            %li
              %p
                J. Sonner,
                = succeed "," do
                  %em On the formal definition of categories
                %strong 80
                (1962) pp.163-176. (
                %a{:href => "http://gdz.sub.uni-goettingen.de/dms/load/img/?PID=GDZPPN002392232"}> gdz
                )
            %li
              %p
                H. Tsukuda,
                = succeed "," do
                  %em Category theory not based upon set theory
                %strong 31
                (1981) pp.1-24.
          %p
            A critical view of purely categorical foundations can be found in a series of
            %a{:href => "http://math.stanford.edu/~feferman/papers.html"} papers
            by S. Feferman:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Solomon+Feferman"}> S. Feferman
              ,
              = succeed "," do
                %em Categorical Foundations and Foundations of Category Theory
              = succeed "," do
                %em Logic, Foundations of Mathematics, and Computability Theory
              = succeed ")" do
                %a{:href => "http://math.stanford.edu/~feferman/papers/Cat_founds.pdf"} pdf
          %p The unattainability of all the formal desiderata proposed by Feferman is discussed in
          %ul
            %li
              M. Ernst,
              = succeed "," do
                %em The Prospects of Unlimited Category Theory: Doing What Remains to be Done
              %strong 8
              no.2 (2015) pp.306-327.
          %p
            In the following MO discussion,
            %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
            also offers additional perspectives on ETCC and ET2CC:
          %ul
            %li#MO-CC
              mathoverflow,
              = succeed "," do
                %em Category of categories as a foundation for mathematics
              = succeed ")" do
                %a{:href => "http://mathoverflow.net/questions/9269/category-of-categories-as-a-foundation-of-mathematics"} link
          %p The above worked-out ET2CSC (where the “S” stands for “small”) can be found in
          %ul
            %li#HM25
              %a.existingWikiWord{:href => "/nlab/show/Calum+Hughes"}> Calum Hughes
              , Adrian Miranda:
              = succeed "," do
                %em The elementary theory of the 2-category of small categories
              %em 43
              8 (2025) 196–242 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2403.03647"}> arXiv:2403.03647
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.70930/tac/c97jx7g2"} doi:10.70930/tac/c97jx7g2
          %p See also
          %ul
            %li#Blass84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andreas+Blass"}> Andreas Blass
                ,
                %em The interaction of category theory and set theory
                , Cont. Math.
                %strong 30
                (1984) pp.5-29. (
                %a{:href => "http://www.math.lsa.umich.edu/~ablass/interact.pdf"}> draft
                )
            %li#Weber07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Weber"}> Mark Weber
                ,
                = succeed "," do
                  %em Yoneda structures from 2-toposes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jim+Lambek"}> Jim Lambek
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Phil+Scott"} Phil Scott
                = succeed "," do
                  %em Reflections on Categorical Foundations of Mathematics
                = succeed "," do
                  %em Foundational Theories of Classical and Constructive Mathematics
                = succeed ")" do
                  %a{:href => "https://www.site.uottawa.ca/~phil/papers/LS11.final.pdf"} draft
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Colin+McLarty"}> C. McLarty
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrei+Rodin"} A. Rodin
                = succeed "," do
                  %em A Discussion between Colin McLarty and Andrei Rodin about Structuralism and Categorical Foundations of Mathematics
                = succeed ")" do
                  %a{:href => "http://canoe.ens.fr/~rodin/spip/IMG/pdf/colin.pdf"} pdf
            %li#Pryzbylek14
              %p
                M. R. Pryzbylek,
                = succeed "," do
                  %em Logical systems I: Lambda calculi through discreteness
                = succeed ")" do
                  %a{:href => "http://arxiv.org/pdf/1306.3703v3"} pdf
            %li#W71
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bob+Walters"}> Bob Walters
                ,
                %em Yoneda 2Categories
                , talk at the University of New South Wales December 1971. (
                %a{:href => "https://dl.dropboxusercontent.com/u/92056191/Archive/temporary_new_material/yoneda.pdf"}> manuscript
                )
