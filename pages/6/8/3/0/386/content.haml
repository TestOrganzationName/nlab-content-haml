                      %mn 1
                  %mi ⋯
                  %msub
                    %mi δ
                    %mn 2
                  %msub
                    %mi δ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \bot_n = \delta_{n-1}\cdots\delta_2\delta_1
            for the (morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{1} \to \mathbf{n}
            corresponding to the) least element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
