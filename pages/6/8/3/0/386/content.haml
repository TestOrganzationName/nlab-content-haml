            given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊤
                    %mi n
                %annotation{:encoding => "application/x-tex"} \top_n
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊥
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \bot_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
