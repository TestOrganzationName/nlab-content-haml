            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbf{n}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊤
                    %mi n
                  %mo =
                  %msub
                    %mi δ
                    %mn 0
                  %mi ⋯
                  %msub
                    %mi δ
                    %mn 0
                  %msub
                    %mi δ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \top_n = \delta_0\cdots\delta_0\delta_0
            for the greatest. Then there are
            %a.existingWikiWord{:href => "/nlab/show/cospans"} cospans
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
