                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; &amp; &amp; \mathbf{n} \oplus \mathbf{m} &amp; &amp; &amp; &amp; \\
                  \&amp; &amp; &amp; \nearrow &amp; &amp; \nwarrow &amp; &amp; &amp; \\
