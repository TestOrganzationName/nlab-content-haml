            with itself. The ordinal sum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi n
                  %mo ⊕
                  %mstyle{:mathvariant => "bold"}
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbf{n} \oplus \mathbf{m}
            is given by the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
