                  %mi M
                  %mo ,
                  %mi m
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (M,m,e)
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and strict
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functors"} monoidal functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \Delta_a \to B
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 1
                    %mo ↦
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{1} \mapsto M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 0
                  %mo ↦
                  %mi m
                %annotation{:encoding => "application/x-tex"} \sigma_0 \mapsto m
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                    %mo ↦
                    %mi e
                  %annotation{:encoding => "application/x-tex"} \delta_0 \mapsto e
          %p
            In particular, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            a 2-category,
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            correspond to 2-functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi Δ
                      %mi a
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}\Delta_a \to K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\Delta_a
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            considered as a one-object 2-category. Because monads in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            are also the same as
            %a.existingWikiWord{:href => "/nlab/show/lax+functors"} lax functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} 1 \to K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\Delta_a
            as the
            %a.existingWikiWord{:href => "/nlab/show/lax+morphism+classifier"} lax morphism classifier
            for the terminal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            is considered as a 2-category, a similar argument to the above shows that the one-object
            %a.existingWikiWord{:href => "/nlab/show/3-category"} 3-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\Delta_a
            classifies
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+monads"} lax-idempotent monads
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            and a lax-idempotent monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                %annotation{:encoding => "application/x-tex"} t
            therein, there is a unique 3-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi Δ
                    %mi a
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} \mathbf{B}\Delta_a \to M
            sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [1]
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi σ
                    %mn 0
                    %mn 1
                  %mo ⊣
                  %msubsup
                    %mi δ
                    %mn 0
                    %mn 1
                  %mo =
                  %msubsup
                    %mi δ
                    %mn 0
                    %mn 0
                  %mo ⊕
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \sigma^1_0 \dashv \delta^1_0 = \delta^0_0 \oplus \mathbf{1}
            with identity counit.
          %h3#DualityWithIntervals Duality with intervals
          %p
            Recall that an
            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
            is a
            %a.existingWikiWord{:href => "/nlab/show/linearly+ordered+set"} linearly ordered set
            with a top and bottom element; interval maps are
            %a.existingWikiWord{:href => "/nlab/show/monotone+functions"} monotone functions
            which preserve top and bottom.
          %p
            Parallel to the categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Delta_a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            denote the category of finite intervals where the top and bottom elements are
            = succeed "," do
              %em distinct
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mi a
                %annotation{:encoding => "application/x-tex"} \nabla_a
            denote the category of all finite intervals, including the terminal one where top and bottom coincide. Then we have
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/duality"} concrete dualities
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Δ
                    %mi a
                    %mi op
                  %mo ≃
                  %msub
                    %mo ∇
                    %mi a
                  %mo ;
                  %mspace{:width => "2em"}
                  %msup
                    %mi Δ
                    %mi op
                  %mo ≃
                  %mo ∇
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \Delta_a^{op} \simeq \nabla_a; \qquad \Delta^{op} \simeq \nabla,
          %p
            both induced by the
            %a.existingWikiWord{:href => "/nlab/show/duality"} ambimorphic object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{2}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Int
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ⊣
                  %mi Ord
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Int(-, \mathbf{2})^{op} \dashv Ord(-, \mathbf{2})
          %p
            inducing the first equivalence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ord
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mo →
                    %msub
                      %mo ∇
                      %mi a
                  %annotation{:encoding => "application/x-tex"} Ord(-, \mathbf{2}): \Delta_a^{op} \to \nabla_a
          %p
            This fact is mentioned in (
            %a{:href => "#Joyal"}> Joyal
            ), to help give some intuition for his
            %a.existingWikiWord{:href => "/nlab/show/Theta+category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Θ
                %annotation{:encoding => "application/x-tex"} \Theta
            as dual to a category of disks. See also
            = succeed "," do
              %em
                %a{:href => "interval#RelationToSimplices"} Interval – Relation to simplices
            = succeed ")." do
              %a{:href => "#Wraith"} Wraith
          %h3#combinatorics Combinatorics
          %p
            The homogenous symmetric function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi m
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h_m(x_1,x_2,{\dots},x_n)
            is the generating function for the set of all morphisms from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [m-1]
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n-1]
          %p
            As an order-preserving function between finite ordinals, any morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi m
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi n
                %annotation{:encoding => "application/x-tex"} f : \mathbf{m} \to \mathbf{n}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            is completely specified by fixing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{n}
            as the
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %a.existingWikiWord{:href => "/nlab/show/partition#of_numbers"} composition
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbf{m}
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            parts, each part denoting a non-empty, contiguous subset of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi m
                %annotation{:encoding => "application/x-tex"} \mathbf{m}
            sharing their value of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            interval parts
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi i
                      %mn 1
                    %mo +
                    %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi …
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi i
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo +
                    %mn 1
                    %mo ,
                    %mi m
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,i_1], [i_1 + 1, i_2], \ldots, [i_{k-1}+1, m-1]
            = succeed "-element" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi i
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi i
                    %mrow
                      %mi k
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{i_1, \ldots, i_{k-1}\}
            of an
            = succeed "-element" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (m-1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %mi m
                    %mo −
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0, \ldots, m-2\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mi n
                      %mi k
                    %mo )
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mi m
                        %mo −
                        %mn 1
                      %mrow
                        %mi k
                        %mo −
                        %mn 1
                    %mo )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mi n
                      %mi k
                    %mo )
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mi m
                        %mo −
                        %mn 1
                      %mrow
                        %mi m
                        %mo −
                        %mi k
                    %mo )
                  %mo =
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mi n
                        %mo +
                        %mi m
                        %mo −
                        %mn 1
                      %mi m
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\sum_k \binom{n}{k} \binom{m-1}{k-1} = \sum_k \binom{n}{k} \binom{m-1}{m-k} = \binom{n+m-1}{m}
          %p
            different morphisms of type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi m
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{m} \to \mathbf{n}
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Delta_a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Chu%E2%80%93Vandermonde+identity"} Chu–Vandermonde identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mn 2
                      %mn 1
                    %mo )
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mn 2
                      %mn 0
                    %mo )
                  %mo +
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mn 2
                      %mn 2
                    %mo )
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mn 2
                      %mn 1
                    %mo )
                  %mo =
                  %mn 2
                  %mo +
                  %mn 2
                  %mo =
                  %mn 4
                  %mo =
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mn 4
                      %mn 3
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\binom{2}{1}\binom{2}{0} + \binom{2}{2}\binom{2}{1} = 2+2 = 4 = \binom{4}{3}
          %p
            different morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mn 3
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbf{3} \to \mathbf{2}
          %ol
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f(0) = f(1) = 0, f(2) = 1
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f(0) = 0, f(1) = f(2) = 1
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(0) = f(1) = f(2) = 0
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f(0) = f(1) = f(2) = 1
          %p
            The
            %a{:href => "https://en.wikipedia.org/wiki/Stars_and_bars_%28combinatorics%29"} stars and bars argument
            gives a direct
            %a.existingWikiWord{:href => "/nlab/show/bijective+proof"} bijective proof
            of the identity
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi Δ
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi m
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo =
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mi n
                          %mo +
                          %mi m
                          %mo −
                          %mn 1
                        %mi m
                      %mo )
                  %annotation{:encoding => "application/x-tex"} |\Delta_a(\mathbf{m},\mathbf{n})| = \binom{n+m-1}{m}
            %a{:href => "http://nforum.ncatlab.org/discussion/3636/number-of-morphisms-in-the-simplex-category/?Focus=29835#Comment_29835"} this comment
            on the nForum.
          %p
            As some interesting special cases, taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo =
                  %mi n
                %annotation{:encoding => "application/x-tex"} m=n
            gives the number of monotone endofunctions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbf{n}
            (OEIS sequence
            = succeed "," do
              %a{:href => "https://oeis.org/A088218"} A088218
            %a{:href => "https://oeis.org/A001700"} A001700
            if we consider endomorphisms
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} [n] \to [n] \in \Delta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo =
                  %mn 2
                %annotation{:encoding => "application/x-tex"} m=2
            gives the triangular numbers (OEIS sequence
            = succeed ")." do
              %a{:href => "https://oeis.org/A000217"} A000217
          %h3#extra_degeneracies Extra Degeneracies
          %p
            In some applications, in addition to the usual maps in the simplex category, one has “extra degeneracies” whose key property can be described as constructing an
            %a.existingWikiWord{:href => "/nlab/show/absolute+limit"} absolute limit
            of shape
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo ⊥
                  %mo ⊆
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta_\bot \subseteq \Delta
            be the
            %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide subcategory
            spanned by the functors that preserve minima. Equivalently,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo ⊥
                  %mo ⊆
                  %msub
                    %mi Δ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Delta_\bot \subseteq \Delta_*
            is the full subcategory of pointed objects of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %msub
                    %mo ⊥
                    %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S, \bot_S)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊥
                    %mi S
                %annotation{:encoding => "application/x-tex"} \bot_S
            is the minimum of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊕
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %msub
                      %mi Δ
                      %mi a
                    %mo →
                    %msub
                      %mi Δ
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} 1 \oplus - : \Delta_a \to \Delta_\bot
              is an
              %a.existingWikiWord{:href => "/nlab/show/absolute+limit"} absolute limit
              cone in the sense of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              (and thus in the sense of ordinary categories).
          .proof
            %h6#proof Proof
            %p
              By the characterization of absolute limits by representable functors, we need to show every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ⊥
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ⊕
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %mo →
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Delta_\bot(1 \oplus -, m) : \Delta_a^{\op} \to \infty Grpd
              is a colimit cocone. Observe
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mo ⊥
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ⊕
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msub
                        %mi Δ
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi m
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Delta_\bot(1 \oplus -, m) \cong \Delta_a(-, m)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi a
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \Delta_a(0, m) = *
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta(-, m)
              is contractible. Since the colimit (in simplicial ∞-gropuoids) of a simplicial set is the precisely its homotopy type, the theorem follows from the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mrow
                        %mi m
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta^{m-1}
              is a contractible simplicial set.
          %p
            Since the retract of an absolute limit is again an absolute limit, we can generalize. Define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi x
                %annotation{:encoding => "application/x-tex"} \Delta_x
            by the pushout in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} (\infty,1)Cat
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msubsup
                            %mi Δ
                            %mi a
                            %mrow
                              %mo ≤
                              %mn 0
                          %mo ×
