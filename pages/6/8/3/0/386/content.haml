                              %mo −
                              %mi i
                      %mtr
                        %mtd
                          %msubsup
                            %mi σ
                            %mi i
                            %mi n
                        %mtd
                          %mo =
                          %mstyle{:mathvariant => "bold"}
                            %mi i
                          %mo ⊕
                          %msubsup
                            %mi σ
                            %mn 0
                            %mn 1
                          %mo ⊕
                          %mstyle{:mathvariant => "bold"}
                            %mrow
                              %mi n
                              %mo −
                              %mi i
                              %mo −
                              %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\delta^n_i &amp; = \mathbf{i} \oplus \delta^0_0 \oplus \mathbf{n-i} \\
                  \\sigma^n_i &amp; = \mathbf{i} \oplus \sigma^1_0 \oplus \mathbf{n-i-1}
                  \\end{aligned}
          %p
            so that the morphisms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            are generated under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊕
                %annotation{:encoding => "application/x-tex"} \oplus
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi δ
                    %mn 0
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \delta^0_0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi σ
                      %mn 0
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \sigma^1_0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            are the elements of the free monoid generated by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{1}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊕
                  %annotation{:encoding => "application/x-tex"} \oplus
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            thus becomes the universal category-equipped-with-a-monoid, in the sense that for any strict monoidal category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
