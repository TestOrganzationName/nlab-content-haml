                %annotation{:encoding => "application/x-tex"}
                  \\begin{matrix}
                  \\Delta_a^{\leq 0} \times \Delta_a &amp;\xrightarrow{\oplus}&amp; \Delta_a
                  \\\ \!\!\!\!\!\!\!\!\!\!\!\!(1 \oplus -) \times id \downarrow
                  \&amp; &amp; \downarrow \iota\!
                  \\\ \Delta_\bot^{\leq 1} \times \Delta_a &amp;\xrightarrow{\rho}&amp; \Delta_x
                  \\end{matrix}
          .num_prop
            %h6#proposition_3 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo :
                    %msub
                      %mi Δ
                      %mi a
                    %mo →
                    %msub
                      %mi Δ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} \iota : \Delta_a \to \Delta_x
              is an
              %a.existingWikiWord{:href => "/nlab/show/absolute+limit"} absolute limit
              cone in the sense of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              (and thus in the sense of ordinary categories).
          .proof
            %h6#proof_2 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              transposes to a retraction diagram in the category of augmented simplicial objects of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \Delta_x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              as a retract of the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi a
                      %mover
                        %mo →
                        %mrow
                          %mn 1
                          %mo ⊕
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mi Δ
                        %mo ⊥
                      %mo ⊆
                      %msub
                        %mi Δ
                        %mi a
                      %mover
                        %mo →
                        %mi ι
                      %msub
                        %mi Δ
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \Delta_a \xrightarrow{1 \oplus -} \Delta_\bot \subseteq \Delta_a \xrightarrow{\iota} \Delta_x
          %p
            The homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %msub
                    %mi Δ
                    %mi x
                %annotation{:encoding => "application/x-tex"} h \Delta_x
            has a similar property.
          %p
            To mesh with the usual description of extra degeneracies, the categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \Delta_\bot
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %msub
                    %mi Δ
                    %mi x
                %annotation{:encoding => "application/x-tex"} h \Delta_x
            can be given by
          .num_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              be the category constructed from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Delta_a
              by adjoining arrows
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mi m
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_{-1} : m \to (m+1)
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} m \geq 0
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi d
                        %mn 0
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} s_{-1} d_0 = 1
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi d
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo =
                      %msub
                        %mi d
                        %mi k
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} s_{-1} d_{k+1} = d_k s_{-1}
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \geq 0
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi s
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo =
                      %msub
                        %mi s
                        %mi k
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} s_{-1} s_{k+1} = s_k s_{-1}
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \geq 0
            %p
              Then the monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊕
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %msub
                      %mi Δ
                      %mi a
                    %mo →
                    %mi h
                    %msub
                      %mi Δ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} 1 \oplus - : \Delta_a \to h \Delta_x
              extends to an equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo →
                      %mi h
                      %msub
                        %mi Δ
                        %mi x
                    %annotation{:encoding => "application/x-tex"} \mathbf{C} \to h \Delta_x
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}'
              be constructed by imposing the remaining cosimplicial identity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi s
                        %mn 0
                      %mo =
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %msub
                        %mi s
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} s_{-1} s_0 = s_{-1} s_{-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊕
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %msub
                      %mi Δ
                      %mi a
                    %mo →
                    %msub
                      %mi Δ
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} 1 \oplus - : \Delta_a \to \Delta_\bot
              extends to an equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                      %mo ′
                      %mo →
                      %msub
                        %mi Δ
                        %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}' \to \Delta_\bot
          .proof
            %h6#proof_idea Proof idea
            %p
              The case of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}'
              follows by the same argument showing that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              is presented by the face and degeneracy maps modulo the cosimplicial identities by an algorithm reducing arrows to a normal form. The key observation is that a map of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              is contained in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mo ⊥
                  %annotation{:encoding => "application/x-tex"} \Delta_\bot
              iff its normal form does not contain any copies of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} d_0
            %p
              The case of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              can be determined by working through the construction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %msub
                      %mi Δ
                      %mi x
                  %annotation{:encoding => "application/x-tex"} h \Delta_x
              as a pushout of ordinary categories.
          %p
            The construction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %msub
                    %mi Δ
                    %mi x
                %annotation{:encoding => "application/x-tex"} h \Delta_x
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            consists of the usual definition of “extra degeneracies”. The construction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \Delta_\bot
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            can be described as having “strong extra degeneracies”.
          %h2#related_constructions Related constructions
          %h3#SimplicialSets Simplicial sets
          %p
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} Presheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta_a
            are
            %strong
              %a.existingWikiWord{:href => "/nlab/show/augmented+simplicial+sets"}> augmented simplicial sets
              \.
          %p
            Under the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mi Δ
                  %mo →
                %annotation{:encoding => "application/x-tex"} Y : \Delta \to
            %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            induces the standard simplicial
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo :
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Y([n]) =: \Delta^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Δ
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %msub
                    %mi Hom
                    %mi Δ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\Delta^n)[m] = Hom_{\Delta}([m],[n])
            and hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi n
                  %mo{:stretchy => "false"} [
                  %mi m
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta^n[m]
            is a finite set with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mi n
                        %mo +
                        %mi m
                        %mo +
                        %mn 1
                      %mi n
                    %mo )
                %annotation{:encoding => "application/x-tex"} \binom{n+m+1}{n}
            elements.
          %p
            The face and degeneracy maps and the relation they satisfy are geometrically best understood in terms of the
            %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful
            image under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
          %ul
            %li
              %p
                the face map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi δ
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi Δ
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo →
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Y(\delta_i) : \Delta^{n-1} \to \Delta^{n}
                injects the standard simplicial
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                = succeed "-simplex;" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                the degeneracy map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi σ
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi Δ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo →
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Y(\sigma_i) : \Delta^{n+1} \to \Delta^{n}
                projects the standard simplicial
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n+1)
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                onto the face opposite to it.
          %h4#extra_degeneracies_2 Extra degeneracies
          %p
            Presheaves on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mi x
                %annotation{:encoding => "application/x-tex"} \Delta_x
            are
            = succeed "," do
              %em (augmented) simplicial sets with extra degeneracies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
                    %mo ⊥
                %annotation{:encoding => "application/x-tex"} \Delta_\bot
            are
            = succeed "." do
              %em (augmented) simplicial sets with strong extra degeneracies
          .num_prop
            %h6#proposition_5 Proposition
            %p
              If an augmented simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %msubsup
                      %mi Δ
                      %mi a
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} P : \Delta_a^{op} \to C
              can be extended to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi x
                        %mi op
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \Delta_x^{op} \to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a colimit diagram.
          %h3#RealizationAndNerve Realization and nerve
          %p
            There are important standard functors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            to other categories which
            %em
              %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} realize
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            as a concrete model of the standard
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
          %ul
            %li
              %p
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi Δ
                      %mo →
                    %annotation{:encoding => "application/x-tex"} \Delta[-] : \Delta \to
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                (the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n]
                as a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %li
              %p
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo ⋅
                      %mo{:stretchy => "false"} |
                      %mo :
                      %mi Δ
                      %mo →
                    %annotation{:encoding => "application/x-tex"} |\cdot| : \Delta \to
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %p
                sends
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n]
                to the standard topological
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ↦
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 0
                        %mo ,
                        %mo .
                        %mo .
                        %mo .
                        %msub
                          %mi x
                          %mi n
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mn 0
                        %mo ≤
                        %msub
                          %mi x
                          %mn 0
                        %mo ≤
                        %msub
                          %mi x
                          %mn 1
                        %mo ≤
                        %mi ⋯
                        %mo ≤
                        %msub
                          %mi x
                          %mi n
                        %mo ≤
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} [n] \mapsto \{(x_0, ... x_n) : 0 \leq x_0 \leq x_1 \leq \cdots \leq x_n \leq 1\}\subset \mathbb{R}^{n}
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %li
              %p
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo :
                      %mi Δ
                      %mo →
                      %mi Str
                      %mi ω
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} O : \Delta \to Str\omega Cat
                sends
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n]
                to the
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/oriental"} oriental
                %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/omega-category"} omega-categories
              %p
                Under the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Str
                      %mi ω
                      %mi Cat
                      %mo →
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Str \omega Cat \to Cat
                which discards all higher morphisms and identifies all 1-morphisms that are connected by a 2-morphisms, this becomes again the identification of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                with the full subbcategory of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} Cat
                on linear
                %a.existingWikiWord{:href => "/nlab/show/quivers"} quivers
                that we started the above definition with
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mn 1
                      %mo →
                      %mi ⋯
                      %mo →
                      %mi n
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [n] \mapsto \{0 \to 1 \to \cdots \to n\}
                      \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+shapes+for+higher+structures"} geometric shapes for higher structures
              %ul
                %li
                  %p
                    %strong simplex category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/cube+category"} cube category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/globe+category"} globe category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/cell+category"} cell category
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Segal%27s+category"} Segal's category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/augmented+simplicial+set"} augmented simplicial set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join of simplicial sets
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fat+Delta+category"} fat Delta category
          %h2#references References
          %p An early description of the simplex category is in
          %ul
            %li#Grothendieck61
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"}> Alexander Grothendieck
              , p. 107 (10 of 21) in:
              %a.existingWikiWord{:href => "/nlab/show/FGA"} FGA
              = succeed "," do
                %em Techniques de construction et théorèmes d’existence en géométrie algébrique III : préschémas quotients
              = succeed "," do
                %a{:href => "http://www.numdam.org/item/?id=SB_1960-1961__6__99_0"} numdam:SB_1960-1961__6__99_0
              = succeed "," do
                %a{:href => "http://www.numdam.org/item/SB_1960-1961__6__99_0.pdf"} pdf
              = succeed ")." do
                %a{:href => "https://translations.thosgood.com/fga/fga3.iii.xml"} web version
          %p
            See also the references at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
          %p See also:
          %ul
            %li
              %p
                Section VII.5 of
                %a.existingWikiWord{:href => "/nlab/show/Categories+Work"} Categories for the Working Mathematician
            %li
              %p
                Section II.2 of P. Gabriel and M. Zisman,
                = succeed "." do
                  %em Calculus of Fractions and Homotopy Theory
            %li
              %p
                Section 2, Doctrines, of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
                = succeed "," do
                  %a{:href => "http://www.numdam.org/item?id=CTGDC_1980__21_2_111_0"}
                    %em Fibrations in Bicategories
          %p
            The relation to
            %a.existingWikiWord{:href => "/nlab/show/intervals"} intervals
            and the generalization to the
            %a.existingWikiWord{:href => "/nlab/show/cell+category"} cell category
            is due to
          %ul#Joyal
            %li
              %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
              ,
              = succeed "," do
                %em
                  Disks, duality and
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Θ
                        %annotation{:encoding => "application/x-tex"} \Theta
              = succeed ")" do
                %a{:href => "http://ncatlab.org/nlab/files/JoyalThetaCategories.pdf"} pdf
          %p
            A discussion of the opposite categories of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo ,
                  %msub
                    %mi Δ
                    %mi a
                %annotation{:encoding => "application/x-tex"} \Delta, \Delta_a
            and related categories can be found here:
          %ul#Wraith
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gavin+C.+Wraith"}> Gavin C. Wraith
              ,
              = succeed "," do
                %em Using the generic interval
              %strong XXXIV
              4 (1993) pp.259-266. (
              %a{:href => "http://archive.numdam.org/ARCHIVE/CTGDC/CTGDC_1993__34_4/CTGDC_1993__34_4_259_0/CTGDC_1993__34_4_259_0.pdf"}> pdf
              )
          .property
            category:
            %a.category_link{:href => "/nlab/all_pages/category"} category
