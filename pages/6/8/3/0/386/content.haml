              %semantics
                %mrow
                  %mo ⊕
                %annotation{:encoding => "application/x-tex"} \oplus
            as a 2-functor.
          %h3#universal_properties Universal properties
          %p
            The morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 0
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi δ
                        %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mover
                    %mo ←
                    %mrow
                      %msub
                        %mi σ
                        %mn 0
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{0} \overset{\delta_0}{\to} \mathbf{1} \overset{\sigma_0}{\leftarrow} \mathbf{2}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Δ
