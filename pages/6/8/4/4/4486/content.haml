                    \\begin{aligned}
                    g'(\xi) &amp;= d f_{x+\xi v+w}(v) -  d f_{x+\xi v}(v)\\
                    \&amp;= \Big(d f_{x+\xi v+w}(v) - d f_{x}(v)\Big) - \Big(d f_{x+\xi v}(v) - d f_x(v)\Big)\\
