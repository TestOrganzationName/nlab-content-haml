                      %mi x
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} x \mapsto x^3
            %a.existingWikiWord{:href => "/nlab/show/compact+set"} compact
            domain, any continuously differentiable function (and a fortiori any twice differentiable function) must be uniformly continuous (at least in
            %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical
            and
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/intuitionistic+mathematics"} intuitionistic mathematics
          %h3#symmetry_of_the_second_partial_derivatives Symmetry of the second partial derivatives
          %p
            The function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi ℝ
                    %mn 2
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f:\mathbb{R}^2 \to \mathbb{R}
            defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi x
                      %mi y
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi x
                        %mn 2
                      %mo −
                      %msup
                        %mi y
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %mrow
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %msup
                        %mi y
                        %mn 2
                %annotation{:encoding => "application/x-tex"} f(x,y) = \frac{x y (x^2-y^2)}{x^2+y^2}
          %p
            plus
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} f(0,0) = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mo ∂
                        %mn 2
                      %mi f
                    %mrow
                      %mo ∂
                      %mi x
                      %mo ∂
                      %mi y
                %annotation{:encoding => "application/x-tex"} \frac{\partial^2f}{\partial x \partial y}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mo ∂
                        %mn 2
                      %mi f
                    %mrow
                      %mo ∂
                      %mi y
                      %mo ∂
                      %mi x
                %annotation{:encoding => "application/x-tex"} \frac{\partial^2f}{\partial y \partial x}
            that both exist but are not equal at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0,0)
            (nor are they continuous at
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
