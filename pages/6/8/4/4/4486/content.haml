          #symmetrythm.num_theorem
            %h6#theorem Theorem
            %p
              %strong> (Symmetry of higher derivatives)
              \. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
