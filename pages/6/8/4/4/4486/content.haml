                              %mi x
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo ,
                            %mi w
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi E
                            %mo{:stretchy => "false"} |
                            %mi v
                            %mo{:stretchy => "false"} |
