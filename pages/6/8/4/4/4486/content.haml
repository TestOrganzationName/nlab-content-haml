                                %mi ξ
                                %mi v
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi d
                            %msub
                              %mi f
                              %mrow
                                %mi x
                                %mo +
                                %mi ξ
                                %mi v
                                %mo +
                                %mi w
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mi d
                            %msub
                              %mi f
                              %mi x
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                            %mo −
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi d
