            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} k = 0
            (since even
            = succeed "-times" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          %h3#the_second_derivative_as_a_quadratic_form The second derivative as a quadratic form
          %p
            In the definition of strong twice-differentiability, we cannot replace the symmetric
            %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∂
                    %mn 2
                  %msub
                    %mi f
                    %mi x
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi w
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \partial^2 f_x(v,w)
            by the corresponding
            %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Q
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mo ∂
                      %mn 2
                    %msub
                      %mi f
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q_x(v) = \partial^2f_x(v,v)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mn 2
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mn 2
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
