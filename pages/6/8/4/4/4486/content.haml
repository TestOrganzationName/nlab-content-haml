                              %mi x
                            %mo{:stretchy => "false"} (
                            %mi v
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mi d
