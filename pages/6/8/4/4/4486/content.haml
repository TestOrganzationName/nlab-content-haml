              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mfrac
