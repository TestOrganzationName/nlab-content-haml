                    %mi ϵ
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \epsilon \in D
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
