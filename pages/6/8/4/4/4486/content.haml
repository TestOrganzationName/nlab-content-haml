                %annotation{:encoding => "application/x-tex"} \frac{d f}{d x}:S \to \mathbb{R}
            such that for all Archimedean ordered Artinian local
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
