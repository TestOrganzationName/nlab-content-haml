                    %semantics
                      %mrow
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} Mod
                  ’, ‘
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi R
                        %mtext -
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} R\text{-}Mod
                  ’, ‘
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi R
                        %mi ‐
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} R&amp;#x2010;Mod
                  ’, ‘
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mo
                          %mi R
                        %mi Mod
                      %annotation{:encoding => "application/x-tex"} _R Mod
