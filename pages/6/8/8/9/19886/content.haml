                  %a{:href => "#InTermsOfGoodwillieTowers"} In terms of Goodwillie-Taylor towers
                %li
                  %a{:href => "#lax_closed_structure_on_"}
                    Lax closed structure on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Σ
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} \Sigma^\infty
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/stabilization"} stabilization
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectrum"} suspension spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Sigma^\infty  Maps(X,A)
            of
            %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Maps(X,A)
            between suitable
            %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi A
                %annotation{:encoding => "application/x-tex"} X, A
            happens to decompose as a
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            of
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie+derivatives"} Goodwillie derivatives
            of the functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Maps
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Maps(X,-)
            and often expressible in terms of the
            %a.existingWikiWord{:href => "/nlab/show/configuration+space+%28mathematics%29"} configuration spaces
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#Definition Definition
          %p
            The stable splitting of mapping spaces discussed
            %a{:href => "#StableSplittings"} below
            have summands given by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
          %p
            The following Def.
            %a.maruku-ref{:href => "#ConfigurationSpacesOfnPoints"}
            is not the most general definition of
            %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            that one may consider in this context, instead it is streamlined to certain applications. See Remark
            %a.maruku-ref{:href => "#ComparisonToNotationInLiterature"}
            below for comparison of notation used here to notation used elsewhere.
          #ConfigurationSpacesOfnPoints.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"}> configuration spaces of points
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                %strong
                  configuration space of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  distinguishable points
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                disappearing at the boundary
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            #eq:DistinguishableConfigurationSpaceJustForX.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                      %mi ord
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ∖
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi X
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Conf}^{ord}_{n}(X)
                    \\;\coloneqq\;
                    \\big(
                    X^n \setminus \mathbf{\Delta}_X^n
                    \\big)
                    \/ \partial(X^n)
            %p
              which is the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the
              %a.existingWikiWord{:href => "/nlab/show/fat+diagonal"} fat diagonal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi X
                      %mi n
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} |
                    %munder
                      %mo ∃
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mi i
                    %mo =
                    %msup
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}_X^n \coloneqq \{(x^i) \in X^n | \underset{i,j}{\exists} (x^i = x^j) \}
              inside the
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with itself, followed by
              %a.existingWikiWord{:href => "/nlab/show/quotient+space"} collapsing
              any configurations with elements on the
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to a common
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} base point
            %p
              Then the
              %em
                %strong
                  configuration space of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  in-distinguishable points
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is the further
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
            #eq:ConfigurationSpaceJustForX.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Conf
                      %mi n
                      %mi ord
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi Σ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ∖
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi X
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo{:stretchy => "false"} /
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Conf}_{n}(X)
                    \\;\coloneqq\;
                    Conf_n^{ord}(X)/\Sigma_n
                    \\;=\;
                    \\Big(
                    \\big(
                    X^n \setminus \mathbf{\Delta}_X^n
                    \\big)
                    \/ \partial(X^n)
                    \\Big)
                    \/\Sigma(n)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma(n)
              denotes the evident
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              by
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of factors of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              inside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X^n
            %p
              More generally, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be another
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %em
                %strong
                  configuration space of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  points
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
                vanishing at the boundary and distinct as points in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            #eq:ConfigurationSpaceWithXAndY.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ∖
                    %msubsup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msup
                      %mi Y
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi n
                    %mo ×
                    %msup
                      %mi Y
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mo{:stretchy => "false"} /
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Conf}_{n}(X,Y)
                    \\;\coloneqq\;
                    \\Big(
                    \\big(
                    (
                    X^n \setminus \mathbf{\Delta}_X^n
                    )
                    \\times
                    Y^n
                    \\big)
                    \/ \partial(X^n \times Y^n)
                    \\Big)
                    \/\Sigma(n)
            %p
              where now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Sigma(n)
              denotes the evident
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+group"} symmetric group
              by
              %a.existingWikiWord{:href => "/nlab/show/permutation"} permutation
              of factors of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \times Y
              inside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi n
                      %mo ×
                      %msup
                        %mi Y
                        %mi n
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X^n \times Y^n \simeq (X \times Y)^n
            %p
              This more general definition reduces to the previous case for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo =
                    %mo *
                    %mo ≔
                    %msup
                      %mi ℝ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} Y = \ast \coloneqq \mathbb{R}^0
              being the point:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi{:mathvariant => "normal"} Conf
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathrm{Conf}_n(X)
                    \\;=\;
                    \\mathrm{Conf}_n(X,\ast)
                    \\,.
            %p
              Finally the
              %em
                %strong configuration space of an arbitrary number of points
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
                vanishing at the boundary and distinct already as points of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              of the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conf
                    %mrow
                      %mo (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %munder
                        %mo ⊔
                        %mrow
                          %mi n
                          %mo ∈
                          %mi 𝕟
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mi n
                      %mo ∖
                      %msubsup
                        %mstyle{:mathvariant => "bold"}
                          %mi Δ
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msup
                        %mi Y
                        %mi k
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo{:stretchy => "false"} /
                      %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"}
                    Conf\left( X, Y\right)
                    \\;\coloneqq\;
                    \\left(
                    \\underset{n \in \mathbb{n}}{\sqcup}
                    \\big(
                    (
                    X^n \setminus \mathbf{\Delta}_X^n
                    )
                    \\times
                    Y^k
                    \\big)
                    \/\Sigma(n)
                    \\right)/\sim
            %p
              by the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi y
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msub
                      %mi y
                      %mi n
                    %mo{:stretchy => "false"} )
