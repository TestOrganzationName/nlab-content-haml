          #ScanningMapEquivalenceOverCartesianSpace.num_prop
            %h6#proposition Proposition
            %p For
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
                  ,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} d \geq 1
                  a
                  %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi d
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^d
                  denoting the
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
                  of that
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
                  %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} non-empty
                  %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} boundary
                  so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo{:stretchy => "false"} /
                        %mo ∂
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y / \partial Y
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/scanning+map"} scanning map
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
