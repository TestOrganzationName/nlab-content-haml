                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mo ⟶
                  %mi Maps
                  %mrow
                    %mo (
                    %msup
                      %mi Σ
                      %mn ∞
                    %msup
                      %mi S
                      %mi d
                    %mo ,
                    %msup
                      %mi Σ
                      %mn ∞
                    %msup
                      %mi Σ
                      %mi d
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  p_1
                  \\;\colon\;
                  \\Sigma^\infty Maps\left(  S^d , \Sigma^d (Y /\partial Y) \right)
                  \\longrightarrow
                  Maps
                  \\left(
                  \\Sigma^\infty S^d, \Sigma^\infty \Sigma^d (Y / \partial Y)
                  \\right)
                  \\,.
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Σ
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \Sigma^\infty
            is a
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
            (
            %a{:href => "suspension+spectrum#StrongMonoidalness"}> here
            ), there is a canonical comparison morphism of this form, exhibiting the induce
            = succeed "-structure" do
              %a.existingWikiWord{:href => "/nlab/show/closed+functor"} lax closed
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Σ
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \Sigma^\infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 1
                %annotation{:encoding => "application/x-tex"} p_1
            coincides with that canonical morphism, up to equivalence.
          %blockquote
            %p Does it?
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/mapping+spectrum"} mapping spectrum
          %h2#references References
          %p The theorem is originally due to
          %ul
            %li#Snaith74
              %a.existingWikiWord{:href => "/nlab/show/Victor+Snaith"}> Victor Snaith
              ,
              = succeed "," do
                %em
                  A stable decomposition of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ω
                          %mi n
                        %msup
                          %mi S
                          %mi n
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \Omega^n S^n X
              = succeed ")" do
                %a{:href => "https://www.maths.ed.ac.uk/~v1ranick/papers/snaiths.pdf"} pdf
          %p using the homotopy equivalence before stabilization due to
          %ul
            %li#May72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+May"}> Peter May
                ,
                = succeed "," do
                  %em The geometry of iterated loop spaces
                = succeed ")" do
                  %a{:href => "https://www.math.uchicago.edu/~may/BOOKS/geom_iter.pdf"} pdf
            %li#Segal73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                ,
                = succeed "," do
                  %em Configuration-spaces and iterated loop-spaces
                %strong 21
                (1973), 213–221. MR 0331377 (
                %a{:href => "http://dodo.pdmi.ras.ru/~topology/books/segal.pdf"}> pdf
                )
          %p An alternative proof is due to
          %ul
            %li#Cohen80
              %a.existingWikiWord{:href => "/nlab/show/Ralph+Cohen"}> Ralph Cohen
              ,
              = succeed "," do
                %em Stable proof of stable splittings
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/S030500410005742X"} doi:10.1017/S030500410005742X
              = succeed ")" do
                %a{:href => "https://www.cambridge.org/core/services/aop-cambridge-core/content/view/247D9F951F8AB99000E4FF6CB2DB9EA2/S030500410005742Xa.pdf/div-class-title-stable-proofs-of-stable-splittings-div.pdf"} pdf
          %p Review and generalization:
          %ul
            %li#Boedigheimer87
              %a.existingWikiWord{:href => "/nlab/show/Carl-Friedrich+B%C3%B6digheimer"}> Carl-Friedrich Bödigheimer
              ,
              = succeed "," do
                %em Stable splittings of mapping spaces
              = succeed "," do
                %em Algebraic topology
              = succeed "," do
                %strong 1286
              = succeed "," do
                %a{:href => "http://www.math.uni-bonn.de/~cfb/PUBLICATIONS/stable-splittings-of-mapping-spaces.pdf"} pdf
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/BoedigheimerStableSplittings87.pdf", :title => "pdf"} pdf
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/BFb0078741"} doi:10.1007/BFb0078741
          %p
            Interpretation in terms of the
            %a.existingWikiWord{:href => "/nlab/show/Goodwillie-Taylor+tower"} Goodwillie-Taylor tower
            of mapping spaces is due to
          %ul
            %li#Arone99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Greg+Arone"}> Greg Arone
                ,
                = succeed "," do
                  %em A generalization of Snaith-type filtration
                = succeed ")" do
                  %a{:href => "https://www.ams.org/journals/tran/1999-351-03/S0002-9947-99-02405-8/S0002-9947-99-02405-8.pdf"} pdf
            %li#Ching05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"}> Michael Ching
                ,
                = succeed "," do
                  %em Calculus of Functors and Configuration Spaces
                = succeed ")" do
                  %a{:href => "https://www3.amherst.edu/~mching/Work/skye.pdf"} pdf
            %li#Goodwillie03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Goodwillie"}> Thomas Goodwillie
                , p. 6 of
                = succeed "," do
                  %em Calculus. III. Taylor series
                = succeed "," do
                  %a{:href => "http://www.msp.warwick.ac.uk/gt/2003/07/p019.xhtml"} journal
                = succeed "))" do
                  %a{:href => "http://arxiv.org/abs/math/0310481"} arXiv:math/0310481
          %p
            A proof via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+Poincar%C3%A9+duality"} nonabelian Poincaré duality
          %ul
            %li
              Lauren Bandklayder,
              %em Stable splitting of mapping spaces via nonabelian Poincaré duality
              (
              %a{:href => "https://arxiv.org/abs/1705.03090"}> arxiv:1705.03090
              )
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Douglas+Ravenel"}> Douglas Ravenel
              ,
              = succeed "," do
                %em What we still don’t understand about loop spaces of spheres
              = succeed "," do
                %a{:href => "https://people.math.rochester.edu/faculty/doug/mypapers/loop.pdf"} pdf
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Ravenel_LoopSpacesOfSpheres.pdf", :title => "pdf"} pdf
