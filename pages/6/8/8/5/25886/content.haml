              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/large-N+limit"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi N
                      %annotation{:encoding => "application/x-tex"} 1/N
                  expansion
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/theta+angle"} θ-term
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CP
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CP(N-1)
              models and QCD contain many
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/nonperturbative+phenomena"} nonperturbative phenomena
              %a.existingWikiWord{:href => "/nlab/show/lattice+field+theory"} lattice
              techniques.”
