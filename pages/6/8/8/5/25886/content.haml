                %a.existingWikiWord{:href => "/nlab/files/Peterson-QuantumCohomology.pdf", :title => "pdf"} pdf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %p see also
            %ul
              %li
                Yasha Savelyev,
                = succeed "," do
                  %em Quantum characteristic classes and the Hofer metric
                %strong 12
                (2008) 2277-2326
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/0709.4510"} arXiv:0709.4510
                %a{:href => "https://doi.org/10.2140/gt.2008.12.2277"} doi:10.2140/gt.2008.12.2277
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %p and proven in
            %ul
              %li
                %p
