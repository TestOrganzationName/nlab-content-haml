                        %mi ℂ
                        %msup
                          %mi P
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1
                  \-sigma model
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+rings"} Pontrjagin rings
              (
              %a.existingWikiWord{:href => "/nlab/show/homology"}> homology
              \-
              %a.existingWikiWord{:href => "/nlab/show/Hopf+algebras"} Hopf algebras
              of
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/based+loop+spaces"} based loop spaces
            %p
              That the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Pontryagin+ring"} Pontryagin ring
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on the
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              of the
              %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
              of a
              %a.existingWikiWord{:href => "/nlab/show/simply-connected+topological+space"} simply-connected
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is essentially the
              %a.existingWikiWord{:href => "/nlab/show/quantum+cohomology+ring"} quantum cohomology ring
              of the
              %a.existingWikiWord{:href => "/nlab/show/flag+variety"} flag variety
              of its
              %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
              by its
              %a.existingWikiWord{:href => "/nlab/show/Borel+subgroup"} Borel subgroup
              is attributed (“Peterson isomorphism”) to
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/Dale+H.+Peterson"} Dale H. Peterson
                (notes by
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Arun+Ram"} Arun Ram
                = succeed "," do
                  %em
                    Quantum Cohomology of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                        %annotation{:encoding => "application/x-tex"} G/H
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "http://math.soimeme.org/~arunram/Resources/QuantumCohomologyOfGPL1-5.html"} web
                = succeed "," do
