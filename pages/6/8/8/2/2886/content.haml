          %h1#measuring_coalgebras Measuring coalgebras
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#enrichment_of_algebras_in_coalgebras"} Enrichment of algebras in coalgebras
              %li
                %a{:href => "#literature"} Literature
          %h2#idea Idea
          %p
            %em Measuring coalgebras
            are an
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
            of the category of
            %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
            (or commutative
            = succeed "-algebras)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/Cocomm+Coalg"} Cocomm Coalg
            of
            %a.existingWikiWord{:href => "/nlab/show/cocommutative+coalgebra"} cocommutative
            %a.existingWikiWord{:href => "/nlab/show/coalgebras"} coalgebras
            (which we will write simply as
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} Coalg
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            The starting point is the observation that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} Coalg
            acts on the category
            %a.existingWikiWord{:href => "/nlab/show/CommAlg"} Alg
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commutative+algebras"} commutative algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo :
                  %msup
                    %mi Coalg
                    %mi op
                  %mo ×
                  %mi Alg
                  %mo →
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} \{-, -\}: Coalg^{op} \times Alg \to Alg
          %p
            where, given a coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and an algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi C
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{C, A\}
            is the
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian-group
            %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom
            of additive homomorphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f: C \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ⋅
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \cdot g
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mover
                    %mo →
                    %mi d
                  %mi C
                  %mo ⊗
                  %mi C
                  %mover
                    %mo →
                    %mrow
                      %mi f
                      %mo ⊗
                      %mi g
                  %mi A
                  %mo ⊗
                  %mi A
                  %mover
                    %mo →
                    %mi m
                  %mi A
                %annotation{:encoding => "application/x-tex"} C \overset{d}{\to} C \otimes C \overset{f \otimes g}{\to} A \otimes A \overset{m}{\to} A
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            is the coalgebra comultiplication and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            is the algebra multiplication. That this is an “
            %a.existingWikiWord{:href => "/nlab/show/action"}> action
            ” here means that there is a
            %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi C
                  %mo ⊗
                  %mi D
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} }
                  %mo ≅
                  %mo{:stretchy => "false"} {
                  %mi C
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi D
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{C \otimes D, A\} \cong \{C, \{D, A\}\}
          %p
            of algebras; here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Alg
                %annotation{:encoding => "application/x-tex"} Alg
            is sometimes described as an
            %a.existingWikiWord{:href => "/nlab/show/actegory"} actegory
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} Coalg
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              Given two algebras
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ,
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A, B
              %strong measuring coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu(A, B)
              is by definition the
              %a.existingWikiWord{:href => "/nlab/show/representing+object"} representing object
              of the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Alg
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Coalg
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Alg(A, \{-, B\}): Coalg^{op} \to Set
            %p
              so that there is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural
              for coalgebras
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coalg
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Alg
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi C
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Coalg(C, \mu(A, B)) \cong Alg(A, \{C, B\})
          %p
            Assume the existence of
            %a.existingWikiWord{:href => "/nlab/show/equalizers"} equalizers
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} Coalg
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cof
                  %mo :
                  %mi Vect
                  %mo →
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} Cof: Vect \to Coalg
          %p
            to the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi Coalg
                  %mo →
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} U: Coalg \to Vect
            (the
            %a.existingWikiWord{:href => "/nlab/show/cofree+object"} cofree
            cocommutative coalgebra construction). We let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi U
                  %mo ∘
                  %mi Cof
                  %mo →
                  %msub
                    %mn 1
                    %mi Vect
                %annotation{:encoding => "application/x-tex"} \pi: U \circ Cof \to 1_{Vect}
          %p
            denote the
            %a.existingWikiWord{:href => "/nlab/show/counit+of+an+adjunction"} counit of the adjunction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊣
                    %mi Cof
                  %annotation{:encoding => "application/x-tex"} U \dashv Cof
          %p
            We construct
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu(A, B)
            explicitly as the
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} Coalg
            of a pair of maps of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo →
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cof(B^A) \overset{\to}{\to} Cof(B^{A \otimes A}) \times Cof(B^k)
          %p
            where we denote the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            by
            %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponentiation
            (and we recall here that the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} Coalg
            is given by
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            at the level of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} Vect
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mrow
                      %msub
                        %mi m
                        %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mrow
                      %msub
                        %mi u
                        %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ⟩
                  %mo :
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi A
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \langle Cof(B^{m_A}), Cof(B^{u_A}) \rangle: Cof(B^A) \to Cof(B^{A \otimes A}) \times Cof(B^k)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mi A
                  %mo :
                  %mi A
                  %mo ⊗
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} m_A: A \otimes A \to A
            is the multiplication on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi u
                    %mi A
                  %mo :
                  %mi k
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} u_A: k \to A
            is the unit. The second is given by a pair of maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi Φ
                  %mo ,
                  %mi Ψ
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle \Phi, \Psi \rangle
          %p which we now describe separately.
          %p
            The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo :
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi: Cof(B^A) \to Cof(B^{A \otimes A})
            is the unique coalgebra map such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} U \Phi
            lifts the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi δ
                  %mi U
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi U
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi π
                      %mo ⊗
                      %mi π
                  %msup
                    %mi B
                    %mi A
                  %mo ⊗
                  %msup
                    %mi B
                    %mi A
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mo ⊗
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ⊗
                  %mi B
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi A
                  %mover
                    %mo →
                    %mrow
                      %msubsup
                        %mi m
                        %mi B
                        %mrow
                          %mi A
                          %mo ⊗
                          %mi A
                  %msup
                    %mi B
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi A
                %annotation{:encoding => "application/x-tex"} U Cof(B^A) \overset{\delta}{\to} U Cof(B^A) \otimes U Cof(B^A) \overset{\pi \otimes \pi}{\to} B^A \otimes B^A \overset{\otimes_1}{\to} (B \otimes B)^{A \otimes A} \overset{m_{B}^{A \otimes A}}{\to} B^{A \otimes A}
          %p
            through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi U
                    %mi Cof
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi B
                      %mrow
                        %mi A
                        %mo ⊗
                        %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi B
                      %mrow
                        %mi A
                        %mo ⊗
                        %mi A
                  %annotation{:encoding => "application/x-tex"} \pi: U Cof(B^{A \otimes A}) \to B^{A \otimes A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            denotes the comultiplication (same as the diagonal map as seen in
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} Coalg
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \otimes_1
            indicates the structure of enriched functoriality for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
          %p
            The map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ψ
                  %mo :
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Psi: Cof(B^A) \to Cof(B^k)
            is the unique coalgebra map such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mi Ψ
                %annotation{:encoding => "application/x-tex"} U \Psi
            lifts the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mi Cof
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi B
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ε
                  %mi k
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi u
                        %mi B
                  %mi B
                  %mo ≅
                  %msup
                    %mi B
                    %mi k
                %annotation{:encoding => "application/x-tex"} U Cof(B^A) \overset{\varepsilon}{\to} k \overset{u_B}{\to} B \cong B^k
          %p
            through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi U
                    %mi Cof
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi B
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi B
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \pi: U Cof(B^A) \to B^A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            denotes the counit (same as the unique map to the terminal object as seen in
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Coalg
                  %annotation{:encoding => "application/x-tex"} Coalg
          %h2#enrichment_of_algebras_in_coalgebras Enrichment of algebras in coalgebras
          .num_prop
            %h6#proposition Proposition
            %p
              The measure coalgebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mu(A, B)
              indeed gives an
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enrichment
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Alg
                      %mi op
                    %mo ×
                    %mi Alg
                    %mo →
                    %mi Coalg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu(-, -): Alg^{op} \times Alg \to Coalg
                    \\,.
          %p
            Here the composition law in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} Coalg
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 0
                  %mo ,
                  %msub
                    %mi A
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 1
                  %mo ,
                  %msub
                    %mi A
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi μ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mn 0
                  %mo ,
                  %msub
                    %mi A
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu(A_0, A_1) \times \mu(A_1, A_2) \to \mu(A_0, A_2)
          %p
            (recalling that the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Coalg
                %annotation{:encoding => "application/x-tex"} Coalg
            is the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of the underlying additive groups) is derived by universality from a composition of maps:
          .maruku-equation
