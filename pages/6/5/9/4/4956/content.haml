                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %msup
                                %mo{:stretchy => "false"} )
                                %mn 2
                        %mtd
                          %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  D &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{0}}
                  \\\
                  \\mathbb{R} &amp;\stackrel{(-)^2}{\to}&amp; \mathbb{R}
                  }
          %p
            Dually, the categorial equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} C^\infty
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SmoothLoc
                %annotation{:encoding => "application/x-tex"} SmoothLoc
            to the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            square of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebras"} smooth algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ←
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi ℝ
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                                %mi f
                                %mo ↦
                                %mi f
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ←
                            %mrow
                              %mi x
                              %mo ↦
                              %msup
                                %mi x
                                %mn 2
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C^\infty(D) &amp;\leftarrow&amp; C^\infty(*) \simeq \mathbb{R}
                  \\\
                  \\uparrow &amp;&amp; \uparrow^{\mathrlap{f \mapsto f(0)}}
                  \\\
                  C^\infty(\mathbb{R})
                  \&amp;\stackrel{x \mapsto x^2}{\leftarrow}&amp;
                  C^\infty(\mathbb{R})
                  }
          %p
            Here along the bottom and on the right are the ordinary smooth algebras of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 1
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^1 = \mathbb{R}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 0
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^0 = *
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(D)
            is new notation, suggestive and justified, for whatever the algebra of functions on the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is, where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is
            %em defined
            by the fact that it has this algebra of functions. The bottom morphism sends a smooth function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f : \mathbb{R} \to \mathbb{R}
            to the function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f((-)^2) : \mathbb{R} \to \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi Id
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} x = Id : \mathbb{R} \to \mathbb{R}
            for the canonical
            %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            function, then this sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to the function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x^2
          %p
            Notice that the commutativity of this pushout square means that the image in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(D)
            of the squared coordinate function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 2
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x^2 \in C^\infty(\mathbb{R})
            is zero. This is because the former is the image under the bottom morphism of the coordinate function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and that maps under the right vertical morphism to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} 0 \in C^\infty(*) \simeq \mathbb{R}
          %p
            In fact one can show that the
            %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(D)
            is
            %em generated
            by the coordinate function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \in C^\infty(\mathbb{R}))
            subject to the relation
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 2
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x^2 = 0
            %a.existingWikiWord{:href => "/nlab/show/ring+of+dual+numbers"} ring of dual numbers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ≃
                          %msup
                            %mi C
                            %mn ∞
                          %mo{:stretchy => "false"} (
                          %mi ℝ
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi x
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo ≃
                          %mi ℝ
                          %mo{:stretchy => "false"} [
                          %mi x
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} /
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi x
                            %mn 2
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  C^\infty(D) &amp; \simeq C^\infty(\mathbb{R})/(x^2)
                  \\\
                  \&amp; \simeq \mathbb{R}[x]/(x^2)
                  \\end{aligned}
                  \\,.
          %p
            (Here in the second step we have used
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/Hadamard%27s+lemma"} Hadamard's lemma
          %p
            This computation of the smooth algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(D)
            of smooth functions on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            expresses the intuitive idea that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is such a small neighbourhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            that while the canonical coordinate function of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            restricted to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is non-vanishing (it would vanish only when restricted entirely to the point 0) it is “so small that its square is always 0”. Readers who like this intuitive statement should keep it in mind, as it is accurate and useful, whereas readers who do not like it could stick with the above precise definition, which unwinds this slogan in the
            %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
            of the ambient
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
            that we keep alluding to.
          %p
            In order to remind us about the infinitesimal nature of the generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(D)
            we shall usually call this “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi dx
                %annotation{:encoding => "application/x-tex"} dx
            ” and write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi dx
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi dx
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℝ
                  %mo ⊕
                  %mi dx
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(D) = \mathbb{R}[dx]/((dx)^2) \simeq \mathbb{R} \oplus dx \mathbb{R}
                  \\,.
          %h3#FunctionsAndForms Functions and differential 1-forms
          %p
            We discussion of
            %a.existingWikiWord{:href => "/nlab/show/differential+1-forms"} differential 1-forms
            are functions on the space of infinitesimal paths. For more comprehensive such discussion see (
            %a{:href => "#Stel13"}> Stel 13
            ).
          %p
            Define the
            %a.existingWikiWord{:href => "/nlab/show/smooth+locus"} smooth locus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{(\Delta^1_{inf})}
            as the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo ×
                  %mi D
                %annotation{:encoding => "application/x-tex"} \mathbb{R} \times D
            of the
            %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            with the first order
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal line segment
            %strong infinitesimal paths
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            (see
            = succeed ")." do
              %a{:href => "infinitesimal+object#SpacOfInfSimpl"} Spaces of infinitesimal k-simplicies
            %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^{(\Delta^1_{inf})}
            in the category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothLoc
                  %annotation{:encoding => "application/x-tex"} SmoothLoc
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℝ
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} (x, \epsilon) \in \mathbb{R} \times D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            stretching from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo +
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} x + \epsilon
            (both regarded as
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %p
            We say a
            %strong
              smooth
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential 1-form
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is a function (meaning: a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            in
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SmoothLoc
                  %annotation{:encoding => "application/x-tex"} SmoothLoc
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo :
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\omega :
                  X^{(\Delta^1_{inf})} \to \mathbb{R}
          %p
            with the property that its restriction to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            vanishes, hence so that the composite morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo :
                  %mi ℝ
                  %mo ↪
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi ω
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  0 : \mathbb{R} \hookrightarrow X^{(\Delta^1_{inf})} \stackrel{\omega}{\to} \mathbb{R}
          %p
            vanishes, where the first morphism is the inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            as the constant infinitesimal paths in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Id
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} (Id, 0) : \mathbb{R} \to \mathbb{R} \times D
          %p
            We call the
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            (classically it is the
            %em smoothly completed
            algebraic tensor product). For each smooth loci
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(X \times Y) \simeq C^\infty(X) \otimes C^\infty(Y)
                  \\,.
          %p
            Using this property, we can dualize the above definition of a diferential 1-form. Namely, in the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+algebra"} smooth algebra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi dx
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi dx
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi ω
                    %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(\mathbb{R}) \otimes \mathbb{R}[dx]/((dx)^2)
                  \\leftarrow
                  C^\infty(\mathbb{R})
                  \:
                  \\omega^*
                  \\,,
          %p
            hence an assignment
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi h
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi dx
                %annotation{:encoding => "application/x-tex"} x \mapsto g(x) +  h(x) dx
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g(x) = 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} R
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi dx
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi dx
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\mathrm{R}) \otimes \mathbb{R}[dx]/((dx)^2)
            that is proportional to the generator
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dx
                  %annotation{:encoding => "application/x-tex"} dx
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo =
                  %mi h
                  %mi dx
                %annotation{:encoding => "application/x-tex"} \omega = h dx
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} h \in C^\infty(\mathbb{R})
          %h3#derivatives_as_infinitesimal_differences Derivatives as infinitesimal differences
          %p
            We can now “
            %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"}> synthetically
            ” describe differentiation as the process of taking infinitesimal differences of functions.
          %p Consider the two morphisms of smooth loci
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo :
                  %msup
                    %mi ℝ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℝ
                  %mo ×
                  %mi D
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  + : \mathbb{R}^{(\Delta^1_{inf})} = \mathbb{R} \times D \to \mathbb{R}
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mn 1
                  %mo :
                  %msup
                    %mi ℝ
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℝ
                  %mo ×
                  %mi D
                  %mo →
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  p_1 : \mathbb{R}^{(\Delta^1_{inf})} = \mathbb{R} \times D \to \mathbb{R}
                  \\,,
          %p
            where the first is the restriction of the canonical addition operation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo :
                  %mi ℝ
                  %mo ×
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} + : \mathbb{R} \times \mathbb{R} \to \mathbb{R}
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            on the first factor out of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
          %p
            Given an element
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R})
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f : \mathbb{R} \to \mathbb{R}
          %p first we get
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                  %mi ℝ
                  %mover
                    %mo →
                    %mi f
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f : X^{(\Delta^1_{inf})} \stackrel{p_1}{\to} \mathbb{R}
                  \\stackrel{f}{\to} \mathbb{R}
                  \\,.
          %p
            This is the function on infinitesimal paths in the line that only depends on the starting point of a path, not on the length of the path, and which sends that starting point to the value of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            on that point. Therefore by slight abuse of notation we just keep writing “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            ” for this function.
          %p The second combination is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo :
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mi ℝ
                  %mover
                    %mo →
                    %mi f
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tilde f : X^{(\Delta^1_{inf})} \stackrel{+}{\to} \mathbb{R}
                  \\stackrel{f}{\to} \mathbb{R}
                  \\,.
          %p
            This is the function on infinitesimal paths that sends any path
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x) \to (x + \epsilon)
            to the value of the function on the
            %em endpoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x + \epsilon)
            of the paths: in terms of these
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde f
            is the assignment
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\tilde f : (x , \epsilon) \mapsto f(x + \epsilon)
                  \\,.
          %p
            For instance consider the function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo ↦
                    %msup
                      %mi x
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f : x \mapsto x^2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mover
                            %mi f
                            %mo{:stretchy => "false"} ˜
                          %mo :
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi ϵ
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo ↦
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo +
                          %mi ϵ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msup
                            %mi x
                            %mn 2
                          %mo +
                          %mn 2
                          %mi x
                          %mi ϵ
                          %mo +
                          %msup
                            %mi ϵ
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %msup
                            %mi x
                            %mn 2
                          %mo +
                          %mn 2
                          %mi x
                          %mi ϵ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \\tilde f : (x, \epsilon) &amp;\mapsto (x + \epsilon)^2
                  \\\
                  \&amp; = x^2  + 2 x \epsilon + \epsilon^2
                  \\\
                  \&amp; = x^2 + 2 x \epsilon
                  \\end{aligned}
                  \\,.
          %p
            This is evident, if maybe still somewhat mysterious, in the internal language of the ambient
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
            that we keep alluding to, but to make it entirely explicit and concrete notice that the functions here are dually morphisms of smooth algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ⊕
                  %mi dx
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(\mathbb{R}) \otimes (\mathbb{R} \oplus dx \mathbb{R})
                  \\leftarrow
                  C^\infty(\mathbb{R})
                  \:
                  (\tilde f)^*
          %p and the equation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi dx
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo =
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mn 2
                  %mi x
                  %mi dx
                %annotation{:encoding => "application/x-tex"}
                  (x + dx)^2 = x^2 + 2 x dx
          %p
            holds in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ⊕
                  %mi dx
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}) \otimes (\mathbb{R} \oplus dx \mathbb{R})
            by the
            = succeed "," do
              %a{:href => "FunctionsAndForms"} above discussion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x \in C^\infty(\mathbb{R})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dx
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℝ
                  %mo ⊕
                  %mi dx
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} dx \in C^\infty(D) = \mathbb{R} \oplus dx \mathbb{R}
            are the two canonical generators.
          %p
            But notice that the expression
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 2
                  %mo +
                  %mn 2
                  %mi x
                  %mi dx
                %annotation{:encoding => "application/x-tex"} x^2 + 2 x dx
            is not a dfifferential 1-form by the above definition, equivalently the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde f
            does not vanish when restricted to constant infinitesimal paths.
          %p
            To get such, we form the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            or
            = succeed "," do
              %strong infinitesimal difference
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo −
                  %mi f
                  %mo :
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Δ
                        %mi inf
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\tilde f - f : X^{(\Delta^1_{inf})} \to \mathbb{R}
          %p
            that acts on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (\tilde f - f) : (x, \epsilon) \mapsto
                  f(x + \epsilon) - f(x)
                  \\,.
          %p
            By construction on the right this now is something linear in the infinitesimal length
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} \epsilon
            of the path. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ′
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f' \in C^\infty(\mathbb{R})
            for the coefficient:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ϵ
                  %mi f
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  f(x + \epsilon) - f(x) = \epsilon f'(x)
                  \\,.
          %p
            This function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f'
            is the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            along a “unit infinitesimal path”.
          %p Dually, we have a morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ⊕
                  %mi dx
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi f
                    %mo{:stretchy => "false"} ˜
                  %mo −
                  %mi f
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  C^\infty(\mathbb{R})\otimes (\mathbb{R} \oplus dx \mathbb{R})
                  \\leftarrow
                  C^\infty(\mathbb{R})
                  \:
                  (\tilde f - f)^*
          %p that sends
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi dx
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi dx
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  x \mapsto f(x + dx) - f(x) = f'(x) dx
                  \\,.
          %p
            The 1-form on the right is the
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi dx
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo ×
                  %mi D
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (d f)(x) = f'(x) dx \in C^\infty(\mathbb{R} \times D)
                  \\,.
          %h3#InfinitesimalDifferentiationAsAMapOfTangentBundles As a map of tangent bundles
          %p
            Equivalently we may rephrase this differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi f
                %annotation{:encoding => "application/x-tex"} d f
            as a morphism of
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi T
                  %mi ℝ
                  %mo ⟶
                  %mi T
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} d f \colon T \mathbb{R} \longrightarrow T \mathbb{R}
            as follows.
          %p
            First, by the
            %a.existingWikiWord{:href => "/nlab/show/Kock-Lawvere+axiom"} Kock-Lawvere axiom
            of SDG we have the standard fact that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi ℝ
                    %mo :
                    %mo =
                    %msup
                      %mi ℝ
                      %mi D
                    %mo ≃
                    %mi ℝ
                    %mo ×
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} T \mathbb{R} := \mathbb{R}^D \simeq \mathbb{R} \times \mathbb{R}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo ×
                  %mi D
                  %mo ⟶
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R} \times D \longrightarrow \mathbb{R}
          %p
            this is by the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            equivalently a function of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo ⟶
                  %msup
                    %mi ℝ
                    %mi D
                  %mo =
                  %mi T
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R} \longrightarrow \mathbb{R}^D = T \mathbb{R}
                  \\,.
          %p
            The condition on the original function makes this
            %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
            be a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ↦
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \mapsto f'(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/microlinear+space"} microlinear space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mi ℝ
                  %mo =
                  %mi ℝ
                  %mo ×
                  %mi ℝ
                  %mo ⟶
                  %mi T
                  %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  T \mathbb{R} = \mathbb{R} \times \mathbb{R} \longrightarrow T \mathbb{R}
                  \\,.
          %p
            This is the differential of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            regarded as a map of tangent bundles.
