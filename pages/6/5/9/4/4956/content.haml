                  %a{:href => "#derivatives_as_infinitesimal_differences"} Derivatives as infinitesimal differences
                %li
                  %a{:href => "#InfinitesimalDifferentiationAsAMapOfTangentBundles"} As a map of tangent bundles
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#history"} History
          %h2#idea Idea
          %p
            %em Differentiation
            is the process that assigns to a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            its
            = succeed "," do
              %em derivative
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi f
                  %annotation{:encoding => "application/x-tex"} d f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x \in X
            the linear transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi f
                    %mi x
                %annotation{:encoding => "application/x-tex"} d f_x
            that maps
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+space"} infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/differences"} differences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo −
                  %mi x
                %annotation{:encoding => "application/x-tex"} y - x
            (for points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            infinitesimally close to
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(y) - f(x)
          %h2#definitions Definitions
          %h3#classical_analytic_definitions Classical (analytic) definitions
          %p
            Classically, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f: \mathbb{R}^n \to \mathbb{R}
            is a function, the derivative
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %msub
                    %mi f
                    %mi x
                %annotation{:encoding => "application/x-tex"} d f_x
            at a point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}^n
            is defined by a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/convergence"} limiting process
            %a.existingWikiWord{:href => "/nlab/show/linear+transformation"} linear transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} L: \mathbb{R}^n \to \mathbb{R}
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mrow
                      %mi h
                      %mo →
                      %mn 0
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi L
                      %mi h
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi h
                      %mo{:stretchy => "false"} |
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \lim_{h \to 0} \frac{f(x + h) - f(x) - L h}{{|h|}} = 0
          %p or in other words such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi L
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo −
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(y) = f(x) + L(y - x) + g(y)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g(y)
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi o
                  %mo{:stretchy => "false"} (
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi y
                    %mo −
                    %mi x
                    %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} o({|y - x|})
            (see
            = succeed ")." do
              %span.newWikiWord
                o-notation
                %a{:href => "/nlab/new/o-notation"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            %em differentiable
            at
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %em derivative
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                    %mo =
                    %mi L
                  %annotation{:encoding => "application/x-tex"} d f_x = L
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mi ℝ
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} L: \mathbb{R} \to \mathbb{R}
            is multiplication by a
            %a.existingWikiWord{:href => "/nlab/show/scalar"} scalar
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \lambda \in \mathbb{R}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f'(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo :
                    %mi ℝ
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} f': \mathbb{R} \to \mathbb{R}
          %p
            We say
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f: \mathbb{R}^n \to \mathbb{R}
            is
            %em differentiable
            if it is differentiable at every point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ×
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \times \mathbb{R}^n \to \mathbb{R}
            which takes a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi h
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x, h)
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi f
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d f_x(h)
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-th derivative
            is the result of differentiating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            times (the
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is just
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f: \mathbb{R}^n \to \mathbb{R}
            is
            %em infinitely differentiable
            (or more briefly, that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            = succeed ")" do
              %em smooth
            = succeed "-th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Notice that a differentiable function is necessarily
            %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous
            (indeed, it is locally a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Lipschitz+function"} Lipschitz function
            %em continuous
            %sup#fnref:1
              %a{:href => "#fn:1", :rel => "footnote"} 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi n
                    %mi th
                %annotation{:encoding => "application/x-tex"} n^{th}
            derivative by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^n(\mathbb{R}^n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f: \mathbb{R}^n \to \mathbb{R}
            form a filtration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mo ⊂
                  %msup
                    %mi C
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi …
                  %mo ⊂
                  %msup
                    %mi C
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %msup
                    %mi C
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \ldots \subset C^n(\mathbb{R}^k) \subset \ldots \subset C^1(\mathbb{R}^k) \subset C^0(\mathbb{R}^k)
          %p
            and the intersection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 0
                  %msup
                    %mi C
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C^\infty(\mathbb{R}^k) \coloneqq \bigcap_{n \geq 0} C^n(\mathbb{R}^k)
            coincides with the class of smooth functions.
          %p
            Evidently differentiation gives a function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo :
                    %msup
                      %mi C
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi C
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ×
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D: C^{n+1}(\mathbb{R}^k) \to C^n(\mathbb{R}^k \times \mathbb{R}^k)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo :
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi k
                  %mo ×
                  %msup
                    %mi ℝ
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D: C^\infty(\mathbb{R}^k) \to C^\infty(\mathbb{R}^k \times \mathbb{R}^k)
            without having to keep track of the degree of differentiability.
          %p
            This development carries over more generally to
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+spaces"} Euclidean spaces
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
          %h3#AsAFunctor Differentiation as a functor
          %p
            %em Differentiation
            in more conceptual terms is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo :
                  %mi Diff
                  %mo →
                  %mi Diff
                %annotation{:encoding => "application/x-tex"} d : Diff \to Diff
            on the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
          %ul
            %li
              %p
                a manifold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to its
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mi X
                      %annotation{:encoding => "application/x-tex"} T X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mi X
                    %annotation{:encoding => "application/x-tex"} T X
                are
                %a.existingWikiWord{:href => "/nlab/show/ordered+pairs"} ordered pairs
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x, v)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
                is a
                %a.existingWikiWord{:href => "/nlab/show/tangent+vector"} tangent vector
                at
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
