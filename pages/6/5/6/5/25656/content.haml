              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo →
                      %mi x
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x \to x'
          %p
          .num_defn
            %h6 Definition
            %p
              An
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-mesh bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              over a base stratification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (B,g)
              is a tower of 1-mesh bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mi n
                    %mo ,
                    %msub
                      %mi f
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi f
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo .
                    %mo .
                    %mo .
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mn 1
                    %mo ,
