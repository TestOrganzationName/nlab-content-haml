                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
          %p
          #rmk_mesh_bundles_concrete.num_remark
            %h6 Remark
            %p
              A concrete way to think about 1-mesh bundles is explained in
              = succeed ":" do
                %a{:href => "#DornDouglas21"} Dorn-Douglas 2021, Ch. 4
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a stratified bundle of 1-meshes that can be trivialized in the trivial framed line bundle, such that the image of the trivialization has continuous upper and lower fiberwise bounds, and such that entrance paths
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo →
                    %mi b
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} b \to b'
              in the base, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi b
                  %annotation{:encoding => "application/x-tex"} p(x) = b
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              a point in a
              = succeed "-stratum" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
