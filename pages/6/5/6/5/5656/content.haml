          %h2#idea Idea
          %p
            One says
            %em ordinary cohomology
            for the
            %a.existingWikiWord{:href => "/nlab/show/cohomology+theory"} cohomology theory
            %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} represented
            by the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi 𝔸
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(\mathbb{A})
            for some
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            This is to distinguish from more general notions of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
