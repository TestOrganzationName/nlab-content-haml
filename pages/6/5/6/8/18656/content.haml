            %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved
            %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether current
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
