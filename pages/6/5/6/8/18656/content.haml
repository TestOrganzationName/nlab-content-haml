                    %mrow
                      %mi d
                      %msup
                        %mi ϵ
                        %mi α
                    %mrow
                      %mi d
                      %msup
                        %mi x
                        %mi μ
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_{v_\epsilon} \phi^a
                  \\;\coloneqq\;
                  R^a_\alpha \epsilon^\alpha
                  +
                  R^{a \mu}_\alpha \frac{d \epsilon^\alpha}{d x^\mu}
          %p
            such that this is an
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
            in that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
