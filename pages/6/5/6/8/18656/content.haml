                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi R
                    %mi α
                    %mi a
                  %msup
                    %mi ϵ
                    %mi α
                  %mo +
                  %msubsup
                    %mi R
                    %mi α
                    %mrow
                      %mi a
                      %mi μ
