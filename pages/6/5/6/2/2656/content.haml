            %li
              %p
                finite-dimensional
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %mi ⋯
                      %mo ⊕
                      %msub
                        %mi M
                        %mrow
                          %msub
                            %mi n
                            %mi k
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} M_{n_1}(\mathbb{C}) \oplus \cdots \oplus M_{n_k}(\mathbb{C})
                for some unique list of natural numbers
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ≥
                        %msub
                          %mi n
                          %mn 2
                        %mo ≥
                        %mi ⋯
                        %mo ≥
                        %msub
                          %mi n
                          %mi k
                      %annotation{:encoding => "application/x-tex"} n_1 \ge n_2 \ge \cdots \ge n_k
            %li
              %p
                finite
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/p-groups"} p-groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ⊕
                      %mi ⋯
                      %mo ⊕
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mrow
                          %msub
                            %mi n
                            %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^{n_1} \oplus \cdots \oplus \mathbb{Z}/p^{n_k}
                for some unique list of natural numbers
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ≥
                        %msub
                          %mi n
                          %mn 2
                        %mo ≥
                        %mi ⋯
                        %mo ≥
                        %msub
                          %mi n
                          %mi k
                      %annotation{:encoding => "application/x-tex"} n_1 \ge n_2 \ge \cdots \ge n_k
            %li
              %p
                finite
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative
                %a.existingWikiWord{:href => "/nlab/show/semisimple+algebras"} semisimple algebras
                over a
                %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔽
                          %mi p
                      %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mrow
                          %msup
                            %mi p
                            %mrow
                              %msub
                                %mi n
                                %mn 1
                      %mo ⊕
                      %mi ⋯
                      %mo ⊕
                      %msub
                        %mi 𝔽
                        %mrow
                          %msup
                            %mi p
                            %mrow
                              %msub
                                %mi n
                                %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_{p^{n_1}} \oplus \cdots \oplus \mathbb{F}_{p^{n_k}}
                for some unique list of natural numbers
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo ≥
                        %msub
                          %mi n
                          %mn 2
                        %mo ≥
                        %mi ⋯
                        %mo ≥
                        %msub
                          %mi n
                          %mi k
                      %annotation{:encoding => "application/x-tex"} n_1 \ge n_2 \ge \cdots \ge n_k
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/trace+of+a+category"} trace of the category of finite sets
                has isomorphism classes of objects corresponding to Young diagrams.
          %h2#young_diagram Young diagram
          %p
            A
            %strong Young diagram
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} F^\lambda
            = succeed "," do
              %strong Ferrers diagram
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mn 1
                    %mo ≥
                    %msub
                      %mi λ
                      %mn 2
                    %mo ≥
                    %mi …
                    %mo ≥
                    %msub
                      %mi λ
                      %mi l
                  %annotation{:encoding => "application/x-tex"} \lambda = (\lambda_1\ge\lambda_2\ge\ldots\ge\lambda_l
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo ⊢
                  %mi n
                %annotation{:encoding => "application/x-tex"} \lambda\vdash n
            is a partition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            then the Young diagram has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            boxes. A partition can be addressed as a multiset over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
          %p
            There are two widely used such representations. The
            %em English
            one uses matrix-like indices, and the
            %em French
            one uses Cartesian coordinate-like indices for the boxes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                %annotation{:encoding => "application/x-tex"} x_{i,j}
            in the diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mi λ
                  %annotation{:encoding => "application/x-tex"} F^\lambda
          %p
            In the English representation the boxes are adjusted to the north-west in the 4th quadrant of a 2-dimensional Cartesian coordinate system, with the ‘y’-axis being downward oriented. For instance the diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 5
                      %mo ,
                      %mn 4
                      %mo ,
                      %mn 4
                      %mo ,
                      %mn 2
                      %mo ,
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F^{(5,4,4,2,1,1)}
            representing the partition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo ,
                  %mn 4
                  %mo ,
                  %mn 4
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (5,4,4,2,1,1)
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 17
                %annotation{:encoding => "application/x-tex"} 17
            is given in the English representation as:
          #Young{:style => "text-align:center"}
            %svg{:height => "140", "se:nonce" => "39384", :width => "120", :xmlns => "http://www.w3.org/2000/svg", "xmlns:se" => "http://svg-edit.googlecode.com", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              / Created with SVG-edit - http://svg-edit.googlecode.com/
              %desc Young diagram (5,4,4,2,1,1)
              %g
                %title Layer 1
                %rect#svg_39384_1{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "10", :y => "10"}
                %rect#svg_39384_2{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "30", :y => "10"}
                %rect#svg_39384_3{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "50", :y => "10"}
                %rect#svg_39384_4{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "70", :y => "10"}
                %rect#svg_39384_5{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "90", :y => "10"}
                %rect#svg_39384_6{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "10", :y => "30"}
                %rect#svg_39384_7{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "30", :y => "30"}
                %rect#svg_39384_8{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "50", :y => "30"}
                %rect#svg_39384_9{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "70", :y => "30"}
                %rect#svg_39384_10{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "10", :y => "50"}
                %rect#svg_39384_11{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "30", :y => "50"}
                %rect#svg_39384_12{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "50", :y => "50"}
                %rect#svg_39384_13{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "70", :y => "50"}
                %rect#svg_39384_14{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "10", :y => "70"}
                %rect#svg_39384_15{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "30", :y => "70"}
                %rect#svg_39384_16{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "10", :y => "90"}
                %rect#svg_39384_17{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "10", :y => "110"}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕐
                %annotation{:encoding => "application/x-tex"} \mathbb{Y}
            be the set of Young diagrams. Important functions on Young diagrams include:
          %ul
            %li#Conjugation
              %strong> conjugation
              \: denoted by a prime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:scriptlevel => "0"}
                      %mo ′
                    %mo :
                    %mi 𝕐
                    %mo →
                    %mi 𝕐
                  %annotation{:encoding => "application/x-tex"} \prime : \mathbb{Y} \rightarrow \mathbb{Y}
              reflects the Young diagram along its main diagonal (north-west to south-east). In the above example the conjugated partition would be
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi λ
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mn 6
                      %mo ,
                      %mn 4
                      %mo ,
                      %mn 3
                      %mo ,
                      %mn 3
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda^\prime=(6,4,3,3,1)
            %li
              %strong> weight
              \:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi wt
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝕐
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} wt \colon \mathbb{Y} \rightarrow \mathbb{N}
              provides the number of boxes.
            %li
              %strong> length
              \:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝕐
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \ell \colon \mathbb{Y} \rightarrow \mathbb{N}
              provides the number of rows or equivalently the number of positive parts of the partition
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
            %li
              %strong> plus
              \:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝕐
                    %mo ×
                    %mi 𝕐
                    %mo →
                    %mi 𝕐
                    %mo :
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi μ
                    %mo +
                    %mi ν
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi μ
                      %mn 1
                    %mo +
                    %msub
                      %mi ν
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi μ
                      %mi l
                    %mo +
                    %msub
                      %mi ν
                      %mi l
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    + \colon \mathbb{Y}\times \mathbb{Y} \rightarrow \mathbb{Y} ::
                    (\mu,\nu) \mapsto \mu + \nu = (\mu_1+\nu_1,\ldots,\mu_l+\nu_l)
            %li
              %strong> times
              \:
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ×
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝕐
                    %mo ×
                    %mi 𝕐
                    %mo →
                    %mi 𝕐
                    %mo :
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo ∪
                    %mi ν
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo ≥
                  %annotation{:encoding => "application/x-tex"}
                    \\times \colon \mathbb{Y}\times \mathbb{Y} \rightarrow \mathbb{Y} ::
                    (\mu,\nu) \mapsto (\mu \cup \nu)_{\ge}
              the unordered union of the multisets. It follows that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo ×
                      %mi ν
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi μ
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %msup
                        %mi ν
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                      %msup
                        %mo{:stretchy => "false"} )
                        %mstyle{:scriptlevel => "0"}
                          %mo ′
                    %annotation{:encoding => "application/x-tex"} \mu\times \nu =(\mu^\prime + \nu^\prime)^\prime
          %p
            A
            %strong filling
            of a Young diagram with elements from a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Young+tableau"} Young tableau
          %h2#skew_young_diagram Skew Young diagram
          %p
            A generalization of a Young diagram is a skew Young diagram. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo ,
                  %mi ν
                %annotation{:encoding => "application/x-tex"} \mu,\nu
            be two partitions, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo ≤
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \nu \le \mu
            be defined as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi i
                  %mo :
                  %msub
                    %mi ν
                    %mi i
                  %mo ≤
                  %msub
                    %mi μ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \forall i : \nu_i\le \mu_i
            (possibly adding trailing zeros). The
            %strong skew Young diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} /
                      %mi ν
                %annotation{:encoding => "application/x-tex"} F^{\mu/\nu}
            is given by the Young diagram
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi μ
                %annotation{:encoding => "application/x-tex"} F^\mu
            with all boxes belonging to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mi ν
                %annotation{:encoding => "application/x-tex"} F^\nu
            when superimposed removed. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 5
                  %mo ,
                  %mn 4
                  %mo ,
                  %mn 4
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mu=(5,4,4,2,1,1)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ν
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo ,
                  %mn 3
                  %mo ,
                  %mn 2
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \nu=(3,3,2,1)
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} /
                      %mi ν
                %annotation{:encoding => "application/x-tex"} F^{\mu/\nu}
            looks like:
          #SkewYoung{:style => "text-align:center"}
            %svg{:height => "140", "se:nonce" => "39424", :width => "120", :xmlns => "http://www.w3.org/2000/svg", "xmlns:se" => "http://svg-edit.googlecode.com", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              / Created with SVG-edit - http://svg-edit.googlecode.com/
              %desc Skew Young diagram (5,4,4,2,1,1)/(3,3,2,1)
              %g
                %title Layer 1
                %rect#svg_39424_1{:fill => "none", :height => "20", :stroke => "#cccccc", "stroke-width" => "2", :width => "20", :x => "0", :y => "10"}
                %rect#svg_39424_2{:fill => "none", :height => "20", :stroke => "#cccccc", "stroke-width" => "2", :width => "20", :x => "20", :y => "10"}
                %rect#svg_39424_3{:fill => "none", :height => "20", :stroke => "#cccccc", "stroke-width" => "2", :width => "20", :x => "40", :y => "10"}
                %rect#svg_39424_4{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "60", :y => "10"}
                %rect#svg_39424_5{:fill => "#ffdddd", :height => "20", :stroke => "#000000", "stroke-width" => "2", :width => "20", :x => "80", :y => "10"}
