                      %annotation{:encoding => "application/x-tex"} b_2 \in B
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s \in S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mn 1
                      %mo +
                      %msub
                        %mi b
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mi s
                      %mo =
                      %mi r
                      %msub
                        %mi b
                        %mn 1
                      %mi s
                      %mo +
                      %mi r
                      %msub
                        %mi b
                        %mn 2
                      %mi s
                    %annotation{:encoding => "application/x-tex"} r (b_1 + b_2) s = r b_1 s + r b_2 s
            %li
              %p
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} r \in R
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi B
                      %annotation{:encoding => "application/x-tex"} b \in B
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mn 1
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s_1 \in S
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi s
                          %mn 2
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} s_2 \in S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mi b
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mn 1
                      %mo +
                      %msub
                        %mi s
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi r
                      %mi b
                      %msub
                        %mi s
                        %mn 1
                      %mo +
                      %mi r
                      %mi b
                      %msub
                        %mi s
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} r b (s_1 + s_2) = r b s_1 + r b s_2
          %p
            representing simultaneous left multiplication by scalars
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} r \in R
            and right multiplication by scalars
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s \in S
          %h4#over_a_fixed_ring Over a fixed ring
          %p
            In the case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi S
                %annotation{:encoding => "application/x-tex"} R=S
            the category of
            = succeed "-bimodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R,R)
            %a.existingWikiWord{:href => "/nlab/show/abelian+group+object"} abelian group objects
            in the slice category of (not necessarily commutative) rings over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/Beck+module"} Beck module
            for a proof.
          %h3#over_a_monoid_in_a_monoidal_category Over a monoid in a monoidal category
          %p
            We can define in more generality what is a
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,B)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mo ⊗
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes,I)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msup
                    %mo ∇
                    %mi A
                  %mo ,
                  %msup
                    %mi η
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,\nabla^{A},\eta^{A})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %msup
                    %mo ∇
                    %mi B
                  %mo ,
                  %msup
                    %mi η
                    %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B,\nabla^{B},\eta^{B})
            are two monoids. It is given by:
          %ul
            %li
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
            %li
              A left-action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi l
                    %mo :
                    %mi A
                    %mo ⊗
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} l:A \otimes X \rightarrow X
            %li
              A right-action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi X
                    %mo ⊗
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} r:X \otimes B \rightarrow X
          %p such that:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi l
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,l)
              is a
              %a.existingWikiWord{:href => "/nlab/show/module+over+a+monoid"} left module
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,r)
              is a
              %a.existingWikiWord{:href => "/nlab/show/module+over+a+monoid"} right module
          %p
