                        %mi S
                        %mo →
                        %mi S
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} g \colon S \to S'
                  and an
                  %a.existingWikiWord{:href => "/nlab/show/intertwiner"} intertwiner
