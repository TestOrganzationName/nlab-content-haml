                          %mrow
                            %msub
                              %mo ∂
                              %mn 0
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mo ∂
                              %mn 1
                      %msub
                        %mi X
                        %mn 0
                      %mo )
                    %mo ∈
                    %msup
                      %mi Cat
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\cdots
                    \\stackrel{\to}{\stackrel{\to}{\to}}
                    X_1
                    \\stackrel{\overset{\partial_1}{\to}}{\underset{\partial_0}{\to}}
