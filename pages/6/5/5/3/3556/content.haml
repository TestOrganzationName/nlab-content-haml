                            %a.existingWikiWord{:href => "/nlab/show/interval"} interval
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/lattice"}> lattice
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/meet"}> meet
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} logical conjunction
                            %a.existingWikiWord{:href => "/nlab/show/and"} and
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/join"}> join
                            ,
                            = succeed "," do
                              %a.existingWikiWord{:href => "/nlab/show/logical+disjunction"} logical disjunction
                            %a.existingWikiWord{:href => "/nlab/show/or"} or
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/compact+element"} compact element
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/lattice+of+subobjects"} lattice of subobjects
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/complete+lattice"}> complete lattice
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/algebraic+lattice"} algebraic lattice
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"}> distributive lattice
                        ,
                        = succeed "," do
                          %a.existingWikiWord{:href => "/nlab/show/completely+distributive+lattice"} completely distributive lattice
                        %a.existingWikiWord{:href => "/nlab/show/canonical+extension"} canonical extension
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/hyperdoctrine"} hyperdoctrine
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/first-order+hyperdoctrine"}> first-order
                          ,
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/Boolean+hyperdoctrine"} Boolean
                          = succeed "," do
                            %a.existingWikiWord{:href => "/nlab/show/coherent+hyperdoctrine"} coherent
                          %a.existingWikiWord{:href => "/nlab/show/tripos"} tripos
                  %p
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-topos"} (0,1)-topos
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Heyting+algebra"} Heyting algebra
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/regular+element"} regular element
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Boolean+algebra"} Boolean algebra
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/frame"}> frame
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/locale"} locale
                  %h2#theorems Theorems
                  %ul
                    %li
                      %a.existingWikiWord{:href => "/nlab/show/Stone+duality"} Stone duality
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %ul
                %li
                  %a{:href => "#as_an_internal_heyting_algebra"} As an Internal Heyting Algebra
                %li
                  %a{:href => "#interpretation"} Interpretation
                %li
                  %a{:href => "#variants"} Variants
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#idea Idea
          %p
            A first-order hyperdoctrine is a
            %a.existingWikiWord{:href => "/nlab/show/hyperdoctrine"} hyperdoctrine
            with respect to
            %a.existingWikiWord{:href => "/nlab/show/lattices"} lattices
            that are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebras"} Heyting algebras
          %h2#definition Definition
          %p
            We denote by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi HeytAlg
                    %mi AdjCyl
                %annotation{:encoding => "application/x-tex"} HeytAlg_{AdjCyl}
            the category whose objects are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebras"} Heyting algebras
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
            and
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
          %p
            A
            %strong first-order hyperdoctrine
            consists of a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C_T
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:lspace => "verythinmathspace"} :
                  %msubsup
                    %mi C
                    %mi T
                    %mi op
                  %mo →
                  %msub
                    %mi HeytAlg
                    %mi AdjCyl
                %annotation{:encoding => "application/x-tex"}
                  P \colon C_T^{op} \to HeytAlg_{AdjCyl}
          %p
            such that the following
            %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley condition
            is satisfied: for every
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\pi)
            for the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                  %mo :
                  %mi A
                  %mo ×
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo →
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                %annotation{:encoding => "application/x-tex"} \pi : A \times - \to -
            comprise a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(A \times -)
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(-)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                          %mo ×
                          %mi B
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi π
                                %mi B
                        %mtd
                          %mi B
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mn 1
                                  %mi A
                                %mo ×
                                %mi f
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi f
                      %mtr
                        %mtd
                          %mi A
                          %mo ×
                          %mi C
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi π
                                %mi C
                        %mtd
                          %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A \times B &amp; \stackrel{\pi_B}{\to} &amp; B \\
                  ^\mathllap{1_A \times f} \downarrow &amp; &amp; \downarrow^\mathrlap{f} \\
                  A \times C &amp; \underset{\pi_C}{\to} &amp; C
                  }
          %p
            An element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(A)
            is often called a
            %em
              predicate over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            (with respect to the hyperdoctrine).
          %p
            For any first-order hyperdoctrine, an
            %em equality predicate
            can be defined for each type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in Ob(C_T)
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi δ
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ⊤
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exists(\delta_A)(\top_{P(A)}) \in P(A \times A)
          %p
            where for any morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} C_T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exists (f)
            to denote the left adjoint of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(f)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊤
                    %mi H
                %annotation{:encoding => "application/x-tex"} \top_H
            denotes the top element in a Heyting algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p
            However, to get good properties for equality, we need to assume a little more. A
            %strong
              first-order hyperdoctrine with
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
            is a first-order hyperdoctrine such that the Beck-Chevalley condition is satisfied for pullback diagrams of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                          %mo ×
                          %mi B
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi A
                              %mo ×
                              %mi f
                        %mtd
                          %mi A
                          %mo ×
                          %mi C
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi δ
                                  %mi A
                                %mo ×
                                %mi B
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi δ
                                  %mi A
                                %mo ×
                                %mi C
                      %mtr
                        %mtd
                          %mi A
                          %mo ×
                          %mi A
                          %mo ×
                          %mi B
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %mi A
                              %mo ×
                              %mi A
                              %mo ×
                              %mi f
                        %mtd
                          %mi A
                          %mo ×
                          %mi A
                          %mo ×
                          %mi C
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A\times B &amp; \stackrel{A\times f}{\to} &amp; A \times C \\
                  ^\mathllap{\delta_A\times B} \downarrow &amp; &amp; \downarrow^\mathrlap{\delta_A \times C} \\
                  A \times A \times B&amp; \underset{A\times A\times f}{\to} &amp; A \times A \times C
                  },
          %p
            i.e. that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi A
                    %mo ×
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mo ∃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi A
                    %mo ×
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ∃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi δ
                      %mi A
                    %mo ×
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ×
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(A\times A \times f) \circ \exists (\delta_A \times B) = \exists (\delta_A \times C) \circ P(A\times f)
          %p This assures that the equality predicate is well behaved in the sense that it allows a sound interpretation of first order logic with equality in the hyperdoctrine.
          %p Additionally one may require the condition for pullbacks of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi δ
                                %mi A
                        %mtd
                          %mi A
                          %mo ×
                          %mi A
                      %mtr
                        %mtd
                          %msup
                            %mo
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi δ
                                  %mi A
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mn 1
                                  %mi A
                                %mo ×
                                %msub
                                  %mi δ
                                  %mi A
                      %mtr
                        %mtd
                          %mi A
                          %mo ×
                          %mi A
                        %mtd
                          %munder
                            %mo →
                            %mrow
                              %msub
                                %mi δ
                                %mi A
                              %mo ×
                              %msub
                                %mn 1
                                %mi A
                        %mtd
                          %mi A
                          %mo ×
                          %mi A
                          %mo ×
                          %mi A
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp; \stackrel{\delta_A}{\to} &amp; A \times A \\
                  ^\mathllap{\delta_A} \downarrow &amp; &amp; \downarrow^\mathrlap{1_A \times \delta_A} \\
                  A \times A &amp; \underset{\delta_A \times 1_A}{\to} &amp; A \times A \times A
                  },
          %p
            which is a kind of
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/Frobenius+reciprocity#frobenius_laws_and_frobenius_reciprocity_11"} Frobenius law
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall (f)
            in place of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∃
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists (f)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⊣
                    %mo ∀
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(f) \dashv \forall (f)
          %h3#as_an_internal_heyting_algebra As an Internal Heyting Algebra
          %p
            Similar to the
            %a.existingWikiWord{:href => "/nlab/show/natural+models"} natural models
            formulation of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+with+families"} category with families
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of presheaf categories. That is, a first-order hyperdoctrine is equivalently defined as a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            with finite products and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            an internal Heyting algebra in the category of presheaves on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            that additionally has
          %ol
            %li
              For every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msub
                      %mi C
                      %mi T
                  %annotation{:encoding => "application/x-tex"} A \in C_T
              internal
              = succeed "-meets" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi YA
                    %annotation{:encoding => "application/x-tex"} YA
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi YA
                  %annotation{:encoding => "application/x-tex"} YA
              is the
              %a.existingWikiWord{:href => "/nlab/show/representable"} representable
              presheaf of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %li
              For every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %msub
                        %mi C
                        %mi T
                    %annotation{:encoding => "application/x-tex"} A \in C_T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              internally has an
              = succeed "-equality" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi YA
                    %annotation{:encoding => "application/x-tex"} YA
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi YA
                  %annotation{:encoding => "application/x-tex"} YA
              valued in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo =
                      %mi A
                    %mo ∈
                    %msup
                      %mi P
                      %mrow
                        %mi YA
                        %mo ×
                        %mi YA
                  %annotation{:encoding => "application/x-tex"} =_A \in P^{YA \times YA}
              such that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi P
                      %mrow
                        %mi YA
                        %mo ×
                        %mi YA
                  %annotation{:encoding => "application/x-tex"} f \in P^{YA\times YA}
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∀
                    %mi x
                    %mo ,
                    %mi y
                    %mo .
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                    %mo ≤
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \forall x,y. x =_A y \leq f(x,y)
              if and only if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∀
                      %mi x
                      %mo ∈
                      %mi A
                      %mo .
                      %mo ⊤
                      %mo ≤
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \forall x\in A. \top \leq f(x,x)
          %p
            Here the Beck-Chevalley conditions on the quantifiers and equality arises from the fact that the operations are internal and therefore natural in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#interpretation Interpretation
          %p
            With this, we have enough structure to interpret multi-sorted
            %a.existingWikiWord{:href => "/nlab/show/first+order+logic"} first-order
            %a.existingWikiWord{:href => "/nlab/show/intuitionistic+logic"} intuitionistic logic
            with equality, taking the objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            to be sorts and its morphisms to be terms,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to assign to each sort the
            %a.existingWikiWord{:href => "/nlab/show/Lindenbaum+algebra"} Lindenbaum algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/predicates"} predicates
            upon that sort and to each term the operation of substitution of that term into predicates, and the left and right adjoints to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            upon projections to provide existential and universal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantification"} quantification
            %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley condition
            ensuring that quantification commutes appropriately with substitution (just as the propositional connectives do).
          %h3#variants Variants
          %p
            There are, of course, many variants on this, corresponding straightforwardly to modifications of the kind of logic one wishes to represent. For instance, to represent specifically classical logic, one should use
            %a.existingWikiWord{:href => "/nlab/show/Boolean+algebras"} Boolean algebras
            instead of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebras"} Heyting algebras
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi T
                %annotation{:encoding => "application/x-tex"} C_T
            (e.g., adding cartesian closedness). Etc.
          %p
            One can even extend this into the realm not just of provability, but furthermore of proof theory, by taking the objects in the codomain of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to be categories rather than mere
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            %a.existingWikiWord{:href => "/nlab/show/bicartesian+closed+category"} bicartesian closed categories
            rather than
            = succeed "s);" do
              %a.existingWikiWord{:href => "/nlab/show/Heyting+algebra"} Heyting algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\sigma)
            would still represent predicates on the sort
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi σ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\sigma)
            would represent proofs (rather than mere provability) of entailments between these predicates, with the possibility that not all such proofs would be equal.
