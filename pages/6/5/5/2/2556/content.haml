                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_n :
                    (\epsilon_i v_i) \mapsto
                    ((t_0, \cdots, t_{n-1})
                    \\mapsto \sum_{i=0}^{n-1} v_i(t_i \epsilon_i))
                    \\,.
          .un_prop
            %h6#proposition_2 Proposition
            %p
              These morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
