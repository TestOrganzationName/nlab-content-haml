                  {*}
                  }
                  \\,.
          %p
            If the
            %a.existingWikiWord{:href => "/nlab/show/lined+topos"} lined topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒯
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{T}, R)
            is also a
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
            in that it satisfies the
            %a.existingWikiWord{:href => "/nlab/show/Kock-Lawvere+axiom"} Kock-Lawvere axiom
            it makes sense to consider the
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            defined as the
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mi lim
                  %mrow
                    %mo (
                    %mi R
                    %mover
                      %munder
                        %mo →
                        %mn 0
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                    %mi R
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  D = \lim\left( R \stackrel{\stackrel{(-)^2}{\to}}{\underset{0}{\to}} R \right)
          %p
            or equivalently expressed in
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/logic"} logic
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi R
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi x
                    %mn 2
                  %mo =
                  %mn 0
