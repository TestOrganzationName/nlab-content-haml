                    %mi X
                    %mrow
                      %msup
                        %mi R
                        %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Pi(X) : [n] \mapsto X^{R^n}
                  \\,.
          .un_defn
            %h6#definition_3 Definition
            %p
              %strong (inclusion of infinitesimal into finite paths)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              define a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msup
                          %mi R
                          %mi n
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi R
                          %mi n
                  %annotation{:encoding => "application/x-tex"}
                    X^{(D(n))} \otimes_{R^n} D(n)
                    \\to
                    X^{R^n}
            %p
              on
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi n
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ϵ
                      %mi i
                    %msub
                      %mi v
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
