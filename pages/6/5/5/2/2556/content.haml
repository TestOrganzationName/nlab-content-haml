                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  D = \{x \in R | x^2 = 0 \}
                  \\,.
          %p
            and think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            as the
            %strong infinitesimal interval object
            of the
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒯
                  %mo ,
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{T},R)
            inside its finite
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
            it is in particular an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} infinitesimal object
          %p
            Various constructions induced by a finite
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            have their infinitesimal analog for infinitesimal interval objects.
          %h2#infinitesimal_path_groupoid_induced_from_infinitesimal_interval
            Infinitesimal path
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
