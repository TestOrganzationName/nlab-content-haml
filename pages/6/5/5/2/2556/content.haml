                  \&amp;&amp; X^D \times D
                  \\\
                  \&amp; {}^{\mathllap{p_{T X}\circ p_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{ev}}
                  \\\
                  X &amp;&amp;&amp;&amp; X
                  }
                  \\,,
          %p where
          %ul
            %li
              %p
                the left leg is the projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi D
                      %mo ×
                      %mi D
                      %mo →
                      %msup
                        %mi X
                        %mi D
                    %annotation{:encoding => "application/x-tex"} X^D \times D \to X^D
                followed by the
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
                projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %mi T
                          %mi X
                      %mo =
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo →
                          %mi D
                          %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi X
                        %mi D
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p_{T X} = X^{(* \to D)} : X^D \to X
            %li
              %p
                the right leg is the evaluation map, i.e. the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/inner+hom"} inner hom
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Id
                        %mo :
                        %msup
                          %mi X
                          %mi D
                        %mo →
                        %msup
                          %mi X
                          %mi D
                      %annotation{:encoding => "application/x-tex"} Id : X^D \to X^D
          %p
            With this setup a pair of (
            %a.existingWikiWord{:href => "/nlab/show/generalized+element"}> generalized
            ) elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ,
                  %mi y
                  %mo ∈
                  %mi X
                %annotation{:encoding => "application/x-tex"} x,y \in X
            may be thought of as connected by an infinitesimal path if there is an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi X
                    %mi D
                  %mo ×
                  %mi D
                %annotation{:encoding => "application/x-tex"} (v,\epsilon) \in X^D \times D
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi v
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                %annotation{:encoding => "application/x-tex"}
                  \\delta_1(v,\epsilon) = v(0) = x
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi v
                  %mo{:stretchy => "false"} (
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi y
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta_0(v,\epsilon) = v(\epsilon) = y
                  \\,.
          %p
            But not all elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (v,\epsilon)
            define
            %em different
            pairs of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbour"} infinitesimal neighbour
            elements this way: specifically in the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/microlinear+space"} microlinear space
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi D
                %annotation{:encoding => "application/x-tex"} X^D
            is fiberwise
            = succeed "-linear," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} t \in R
            the elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi t
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (v,t \epsilon)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mi v
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (t v, \epsilon)
            define the same pair of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbour"} infinitesimal neighbour
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mi v
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x = v(0)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi v
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y = (t v)(\epsilon) = v(t \epsilon)
          %p
            We may identify such elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mi v
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (t v, \epsilon)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi t
                  %mi ϵ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (v, t \epsilon)
            by passing to the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi D
                    %msub
                      %mo ⊗
                      %mi R
                    %mi D
                  %annotation{:encoding => "application/x-tex"} X^D \otimes_R D
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi D
                  %mo ×
                  %mi R
                  %mo ×
                  %mi D
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %mi Id
                        %mo ×
                        %mo ⋅
                    %mover
                      %mo →
                      %mrow
                        %mo ⋅
                        %mo ×
                        %mi Id
                  %msup
                    %mi X
                    %mi D
                  %mo ×
                  %mi D
                %annotation{:encoding => "application/x-tex"}
                  X^D \times R \times D \stackrel{\stackrel{\cdot \times Id}{\to}}{\underset{Id \times \cdot}{\to}}
                  X^D \times D
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋅
                %annotation{:encoding => "application/x-tex"} \cdot
            here denotes the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (R,\cdot)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            (by the embedding
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ↪
                    %mi R
                  %annotation{:encoding => "application/x-tex"} D \hookrightarrow R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi D
                %annotation{:encoding => "application/x-tex"} X^D
            (by the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is assumed to be
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/microlinear+space"} microlinear
          %p
            In this same fashion we can then define infinitesimal analogs of the finite higher path object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %msubsup
                          %mi Δ
                          %mi R
                          %mi k
                    %mo =
                    %msup
                      %mi X
                      %mrow
                        %msup
                          %mi R
                          %mrow
                            %mo ×
                            %mi k
                  %annotation{:encoding => "application/x-tex"} X^{\Delta_R^k} = X^{R^{\times k}}
          %h3#the_definition The definition
          .un_defn
            %h6#definition_2 Definition
            %p
              %strong (infinitesimal path simplicial object)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{T}
              be a
              %a.existingWikiWord{:href => "/nlab/show/microlinear+space"} microlinear space
              in the
              %a.existingWikiWord{:href => "/nlab/show/smooth+topos"} smooth topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒯
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{T},R)
              with infinitesimal interval object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            %p
              Then define the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Π
                      %mi inf
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi^{inf}(X)
                    \: \Delta^{op} \to
                    \\mathcal{T}
            %p as follows:
            %ul
              %li
                %p
                  in degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                  it assigns the object
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ↦
                        %msup
                          %mi X
                          %mrow
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mrow
                            %msup
                              %mi R
                              %mi n
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mi D
                        %msub
                          %mo ⊗
                          %mi R
                        %mi D
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msubsup
                              %mo ×
                              %mi X
                              %mi n
                      %annotation{:encoding => "application/x-tex"}
                        [n] \mapsto
                        X^{D(n)} \otimes_{R^n} D(n)
                        \\hookrightarrow
                        (X^D \otimes_R D)^{\times_X^n}
                %p
                  whose
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ϵ
                          %mi i
                        %msub
                          %mi v
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi x
                      %annotation{:encoding => "application/x-tex"} (\epsilon_i v_i)_x
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ϵ
                          %mo{:stretchy => "false"} →
                        %mo ∈
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \vec \epsilon \in D(n)
                  or
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ν
                          %mi i
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi x
                      %annotation{:encoding => "application/x-tex"} (\nu_i)_x
                  for short; where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  indicates the fiber of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X^{D(n)} \to X
                  that the element lives in
              %li
                %p
                  the face maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi i
                        %mo :
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mi D
                        %msub
                          %mo ×
                          %mi R
                        %mi D
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msubsup
                              %mo ×
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                        %mo →
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi X
                          %mi D
                        %msub
                          %mo ×
                          %mi R
                        %mi D
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msubsup
                              %mo ×
                              %mi X
                              %mi n
                      %annotation{:encoding => "application/x-tex"} d_i : (X^D \times_R D)^{\times_X^{n+1}} \to (X^D \times_R D)^{\times_X^{n}}
                  are
                %ul
                  %li
                    %p
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 0
                            %mo &lt;
                            %mi i
                            %mo &lt;
                            %mi n
                            %mo +
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} 0 \lt i \lt n+1
                    %p
                      given on
                      = succeed "s" do
                        %a.existingWikiWord{:href => "/nlab/show/generalized+element"} generalized element
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi d
                              %mi i
                            %mo :
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ν
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi x
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ν
                              %mn 0
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi ν
                              %mrow
                                %mi i
                                %mo −
                                %mn 2
                            %mo ,
                            %msub
                              %mi ν
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo +
                            %msub
                              %mi ν
                              %mi i
                            %mo ,
                            %msub
                              %mi ν
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi ν
                              %mrow
                                %mi m
                                %mo +
                                %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi x
                          %annotation{:encoding => "application/x-tex"}
                            d_i : (\nu_i)_x
                            \\mapsto
                            (\nu_0 , \cdots, \nu_{i-2},
                            \\nu_{i-1} + \nu_i, \nu_{i+1}, \cdots, \nu_{m+1} )_x
                  %li
                    %p
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                            %mo =
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} i = 0
                    %p given by
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi d
                              %mn 0
                            %mo :
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ν
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo ↦
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 0
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ϵ
                              %mn 0
                            %mo{:stretchy => "false"} )
                            %mo +
                            %msub
                              %mi ν
                              %mi i
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"}
                            d_0 : (\nu_i) \mapsto (v_0(\epsilon_0) + \nu_i)
                    %p
                      where the element on the right denotes the evaluation of the map
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
