            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+path+%E2%88%9E-groupoid+in+a+smooth+topos"} infinitesimal path ∞-groupoid
          %h2#definition Definition
          %p
            In any
            %a.existingWikiWord{:href => "/nlab/show/lined+topos"} lined topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒯
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo ,
                  %mo ⋅
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{T},(R,+,\cdot))
            the line object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is naturally regarded as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interval+object"} cartesian interval object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi R
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %msub
                                %mn 0
                                %mo *
                          %mo ↗
                        %mtd
                        %mtd
                          %msup
                            %mo ↖
                            %mrow
                              %msub
