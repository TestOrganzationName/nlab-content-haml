                    %mn 0
                    %mo *
                  %mo ,
                  %msub
                    %mn 1
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo *
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mo *
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"}
                  (0_*,1_*) : * \coprod * \to R
          %p as discussed there. On object this assigns
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ↦
