          %h2#idea Idea
          %p
            The notion of
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-sheaf
            (or
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            or
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            theory of the notion of
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            (
            %span.newWikiWord>
              geometric type
              %a{:href => "/nlab/new/geometric+type"} ?
            ) in ordinary
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            for more.
          %h2#definition Definition
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-site"} (∞,1)-site
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be the class of
            %a.existingWikiWord{:href => "/nlab/show/monomorphism+in+an+%28%E2%88%9E%2C1%29-category"} monomorphisms
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh_{(\infty,1)}(C)
            that correspond to
            %a.existingWikiWord{:href => "/nlab/show/covering"} covering
            = succeed "s" do
              %span.newWikiWord
                (∞,1)-sieve
                %a{:href => "/nlab/new/%28%E2%88%9E%2C1%29-sieve"} ?
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi U
                  %mo ↪
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\eta : U \hookrightarrow j(c)
          %p
            on objects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+embedding"} (∞,1)-Yoneda embedding
          %p
            Then an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %msub
                    %mi PSh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \in PSh_{(\infty,1)}(C)
            is an
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-sheaf
            if it is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                %annotation{:encoding => "application/x-tex"} \eta
            the morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi PSh
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi PSh
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi η
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(c) \simeq PSh_C(j(c),A) \stackrel{PSh_C(\eta,A)}{\to}
                  PSh(U,A)
          %p
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+quasi-category"} equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %msup
                    %mi C
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} A : C^{\op} \to E
            with values in an arbitrary ∞-category, we say it is a sheaf iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E(e, A(-))
            is a sheaf for every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            This is the analog of the ordinary sheaf condition for covering sieves. The
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSh
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh_C(U,A)
            is also called the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            relative to the covering encoded by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p As in the 1-categorial case, the sheaf condition for a covering sieve can be translated into a condition on a covering family that generates it:
          .num_defn
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi u
                      %mi i
                    %mo →
                    %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{ u_i \to c \}
              be a family of morphisms of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              that generate the sieve corresponding to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo :
                      %mi U
                      %mo ↪
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta : U \hookrightarrow j(c)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mo •
                    %mo :
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %mo →
                    %msub
                      %mi PSh
                      %mi C
                  %annotation{:encoding => "application/x-tex"} r_\bullet : \mathbf{\Delta}^{\op} \to PSh_C
              be the
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28infinity%2C1%29-category#cech_nerves"} Čech nerve
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⨿
                        %mi i
                      %mi j
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi u
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \amalg_i j(u_i) \to j(c)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is local with respect to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              iff the induced map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi lim
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(c) \to \lim A(r_\bullet)
              is an equivalence.
          %p
            Thus, a presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a sheaf iff every covering sieve contains a generating family satisfying this condition. Spelling out the description of the Čech nerve, the condition is that we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi lim
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ×
                      %mrow
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi j
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mover
                        %mo →
                        %mo →
                      %mo →
                    %mi ⋯
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  A(c) \simeq \lim\left(
                  \\prod_i A(u_i)
                  \\stackrel{\to}{\to}
                  \\prod_{i,j} PSh_C(j(u_i) \times_{j(c)} j(u_j), A)
                  \\stackrel{\to}{\stackrel{\to}{\to}}
                  \\cdots
                  \\right)
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has pullbacks, this simplifies to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi lim
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi i
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                    %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi u
                      %mi i
                    %msub
                      %mo ×
                      %mi c
                    %msub
                      %mi u
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mover
                      %mover
                        %mo →
                        %mo →
                      %mo →
                    %mi ⋯
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  A(c) \simeq \lim\left(
                  \\prod_i A(u_i)
                  \\stackrel{\to}{\to}
                  \\prod_{i,j} A(u_i \times_c u_j)
                  \\stackrel{\to}{\stackrel{\to}{\to}}
                  \\cdots
                  \\right)
          %p and furthermore this formulation applies to presheaves with values in an arbitrary ∞-category.
          .proof
            %h6#proof Proof
            %p
              Taking colimits of Čech nerve computes
              = succeed "-truncations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi PSh
                        %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (PSh_C)/j(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \colim(r_\bullet)
              is the subobject of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(c)
              corresponding to the sieve
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} colim
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi lim
                    %msub
                      %mi PSh
                      %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi r
                      %mo •
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    PSh_C(\colim(r_\bullet), A) \simeq \lim PSh_C(r_\bullet, A)
            %p and so the theorem follows.
          %h2#terminology Terminology
          %p
            An
            %strong
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              ,1)-sheaf
            is also called an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            with values in
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
          %p
            The practice of writing “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-sheaf” instead of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            is a rather reasonable one, since a
            %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            is nothing but a
            = succeed "." do
              %em 2-sheaf
          %p
            Notice however that there is ambiguity in what precisely one may mean by an
            = succeed "-stack:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-sheaf" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/hypercomplete"} hypercomplete
            = succeed "-sheaf." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            theory, not in
            %a.existingWikiWord{:href => "/nlab/show/%28n%2C1%29-topos"} (n,1)-topos
            theory for finite
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
