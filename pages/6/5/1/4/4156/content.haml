          %ul
            %li
              Robert S. Thorne,
              %em The Standard Model Parity, Charge Conjugation and Time Reversal
              \&amp;lbrack;
              %a{:href => "https://www.hep.ucl.ac.uk/postgrad/teaching/sm/SMIIL4.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Thorne-StandardModelPCT.pdf", :title => "pdf"} pdf
          %p See also:
          %ul
            %li
              Wikipedia:
