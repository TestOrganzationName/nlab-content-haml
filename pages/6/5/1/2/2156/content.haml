          %h1#inner_product_spaces Inner product spaces
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %li
                %a{:href => "#definite"} Definiteness
