                    %msubsup
                      %mi U
                      %mi tot
                      %mo †
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    chan(\rho)
                    \\;\;=\;\;
                    Tr_{\mathscr{B}}
                    \\big(
                    U_{tot}
                    \\cdot
                    (\rho \otimes env)
                    \\cdot
                    U_{tot}^\dagger
                    \\big)
                    \\,.
            %p
              Conversely, every operation of the form
              %a.maruku-eqref{:href => "#eq:QuantumChannelVieDecoherence"} (2)
              is a quantum channel.
          %p
            This is originally due to
            %a{:href => "quantum+channel#Lindblad75"} Lindblad 1975
            (see top of p. 149 and inside the proof of Lem. 5). For exposition and review see:
            = succeed "." do
              %a{:href => "quantum+channel#NielsenChuang00"} Nielsen &amp; Chuang 2000 §8.2.2-8.2.3
            = succeed "." do
              %a{:href => "quantum+channel#AttalLectureNotes"} Attal, Thm. 6.5 &amp; 6.7
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/pure+state"} pure state
            %a.existingWikiWord{:href => "/nlab/show/mixed+state"} mixed
            environment states is discussed in
            = succeed "." do
              %a{:href => "quantum+channel#BengtssonŻyczkowski06"} Bengtsson &amp; Życzkowski 2006 pp. 258
          %p
          #ProofOfEnvironmentalRepresentationOfQuantumChannels.proof
            %h6 Proof
            %p
              We spell out the proof assuming
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite-dimensional+Hilbert+spaces"} finite-dimensional Hilbert spaces
              %a.existingWikiWord{:href => "/nlab/show/sums"} sums
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converge
            %p
              Now given a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/completely+positive+map"} completely positive map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi chan
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi.mathscript ℋ
                    %mo ⊗
                    %msup
                      %mi.mathscript ℋ
                      %mo *
                    %mo ⟶
                    %mi.mathscript ℋ
                    %mo ⊗
                    %msup
                      %mi.mathscript ℋ
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    chan
                    \\,\colon\,
                    \\mathscr{H} \otimes \mathscr{H}^\ast
                    \\longrightarrow
                    \\mathscr{H} \otimes \mathscr{H}^\ast
                    \\,,
            %p
              then by
              %a{:href => "quantum+channel#OperatorSumDecompositionOfQuantumChannels"} operator-sum decomposition
              there exists a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              (
              %a.existingWikiWord{:href => "/nlab/show/finite+set"}> finite
              , under our assumptions)
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
              by at least one element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi ini
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    s_{ini} \,\colon\, S
                    \\,,
            %p
              and an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
              of
              %a.existingWikiWord{:href => "/nlab/show/linear+operators"} linear operators
            #eq:KrausDecompositionInConstructionOfEnvRep.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi S
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi E
                      %mi s
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi.mathscript ℋ
                    %mo ⟶
                    %mi.mathscript ℋ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext with
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi s
                    %msubsup
                      %mi E
                      %mi s
                      %mo †
                    %mo ⋅
                    %msub
                      %mi E
                      %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi Id
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    s \,\colon\, S
                    \\;\;\;
                    \\vdash
                    \\;\;\;
                    E_s
                    \\;\colon\;
                    \\mathscr{H}
                    \\longrightarrow
                    \\mathscr{H}
                    \\,,\;\;\;\;
                    \\text{with}
                    \\;\;\;\;
                    \\underset{s}{\sum}
                    E_s^\dagger \cdot E_s \,=\, Id
                    \\mathrlap{\,,}
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi chan
                    %mo{:stretchy => "false"} (
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi s
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi E
                      %mi s
                    %mo ⋅
                    %mi ρ
                    %mo ⋅
                    %msubsup
                      %mi E
                      %mi s
                      %mo †
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    chan(\rho)
                    \\;=\;
                    \\underset{s}{\sum}
                    \\,
                    E_s \cdot \rho \cdot E_s^\dagger
                    \\,.
            %p Now take
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℬ
                    %mspace{:width => "thinmathspace"}
                    %mo ≡
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %mo ⊕
                      %mi S
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{B}
                    \\,\equiv\,
                    \\underset{S}{\oplus} \mathbb{C}
            %p
              with its canonical
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+form"} Hermitian
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
              %a.existingWikiWord{:href => "/nlab/show/orthonormal+linear+basis"} orthonormal linear basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mrow
                      %mo |
                      %mi s
                      %mo ⟩
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mi s
                        %mo{:lspace => "verythinmathspace"} :
                        %mi S
                  %annotation{:encoding => "application/x-tex"} \big(\left\vert s \right\rangle\big)_{s \colon S}
              and consider the linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi V
                                %mspace{:width => "thickmathspace"}
                                %mo{:lspace => "verythinmathspace"} :
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                            %mi.mathscript ℋ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi.mathscript ℋ
                            %mo ⊗
                            %mi.mathscript ℬ
                        %mtr
                          %mtd
                            %mrow
                              %mo |
                              %mi ψ
                              %mo ⟩
                          %mtd
                            %mo ↦
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mi s
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi E
                              %mi s
                            %mrow
                              %mo |
                              %mi ψ
                              %mo ⟩
                            %mo ⊗
                            %mrow
                              %mo |
                              %mi s
                              %mo ⟩
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathllap{
                    V
                    \\;\colon\;\;
                    }
                    \\mathscr{H}
                    \&amp;\longrightarrow&amp;
                    \\mathscr{H}
                    \\otimes
                    \\mathscr{B}
                    \\\
                    \\left\vert \psi \right\rangle
                    \&amp;\mapsto&amp;
                    \\underset{s}{\sum}
                    \\,
                    E_s
                    \\left\vert
                    \\psi
                    \\right\rangle
                    \\otimes
                    \\left\vert s \right\rangle
                    \\mathrlap{\,.}
                    }
            %p
              Observe that this is a
              %a.existingWikiWord{:href => "/nlab/show/linear+isometry"} linear isometry
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mrow
                            %mo ⟨
                            %mi ψ
                            %mo |
                          %msup
                            %mi V
                            %mo †
                          %mi V
                          %mrow
                            %mo |
                            %mi ψ
                            %mo ⟩
