                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\theta_+ &amp; = k\frac{\overline{z}_-^{-1}}{1 + {\vert z_-\vert^{-2}}} (-){z}_-^{-2} d {z}_-
                    \\\
                    \&amp; =
                    \-k \frac{{z}_-^{-1} d{z}_-}{1 + {\vert z_-\vert^2}}
                    \\\
                    \&amp; =
                    \-\frac{{z}_-^{-k} d {z}_-^k}{1  + {\vert z_-\vert}^2}
                    \\end{aligned}
                    \\,.
            %p
              With this it follows that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo +
                    %mo ∩
                    %msub
                      %mi U
                      %mo −
                  %annotation{:encoding => "application/x-tex"} U_+ \cap U_-
              indeed we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi z
                              %mo −
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
