                            %msub
                              %mi z
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ∧
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msubsup
                              %mover
                                %mi z
                                %mo ¯
                              %mo −
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                            %mi d
                            %msub
                              %mover
                                %mi z
                                %mo ¯
                              %mo −
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mfrac
                              %mi k
                              %mrow
                                %mrow
                                  %mo{:stretchy => "false"} |
