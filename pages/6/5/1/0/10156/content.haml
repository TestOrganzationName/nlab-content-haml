                            %mi z
                            %mo{:stretchy => "false"} |
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                    %mi d
                    %mi z
                    %mo ∧
                    %mi d
                    %mover
                      %mi z
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega_1
                    \=
                    \\frac{1}{(1 + {\vert z\vert}^2)^2}
                    d z \wedge d \overline{z}
                    \\,.
            %p
              More generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} S^2 \hookrightarrow \mathbb{R}^3
              embedded as the 2-sphere of
              %a.existingWikiWord{:href => "/nlab/show/radius"} radius
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k \in (0,\infty)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mi k
                    %mo =
                    %mfrac
                      %mi k
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo +
                        %msup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi z
                            %mo{:stretchy => "false"} |
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} )
                          %mn 2
                    %mi d
                    %mi z
                    %mo ∧
                    %mi d
                    %mover
                      %mi z
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega_k
                    \=
                    \\frac{k}{(1 + {\vert z\vert}^2)^2}
                    d z \wedge d \overline{z}
                    \\,.
          #KaehlerStructure.num_prop
            %h6#proposition_3 Proposition
            %p
              Equipped with this
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
