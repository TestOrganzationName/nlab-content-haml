                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 3
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mn 1
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  S^2 = \left\{ (x_1, x_2, x_3) \in \mathbb{R}^3 \;|\; (x_1)^2 + (x_2)^2 + (x_3)^2 = 1 \right\}
          %p
            the 2-
            %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
            inherits a
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            as the
            %a.existingWikiWord{:href => "/nlab/show/pullback+of+a+differential+form"} pullback
            of the canonical metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %mn 3
                  %mi d
                  %msub
                    %mi x
                    %mi i
                  %mo ⊗
                  %mi d
                  %msub
                    %mi x
                    %mi i
                %annotation{:encoding => "application/x-tex"} \sum_{i = 1} ^3  d x_i \otimes d x_i
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^3
          #TheThreeCanonicalFunctions.num_prop
            %h6#proposition Proposition
            %p
              In the
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#RiemannSphere"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo −
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn ∞
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mn 3
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi x
                          %mi i
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    x_i \colon (S^2 - \{x_\infty\}) \hookrightarrow \mathbb{R}^3 \stackrel{x_i}{\to} \mathbb{R}
            %p have the expressions
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                        %mo =
                        %mfrac
                          %mn 1
                          %mn 2
                        %mfrac
                          %mrow
                            %msub
                              %mi z
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msub
                              %mover
                                %mi z
                                %mo ¯
                              %mo +
                          %mrow
                            %mn 1
                            %mo −
                            %msup
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi z
                                  %mo +
                                %mo{:stretchy => "false"} |
