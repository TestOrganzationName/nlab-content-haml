                                      %mn 1
                                %mrow
                                  %mn 1
                                  %mo +
                                  %msup
                                    %mrow
                                      %mo{:stretchy => "false"} |
                                      %msub
                                        %mi z
                                        %mo −
                                      %mo{:stretchy => "false"} |
                                    %mn 2
                              %mo )
                            %mi d
                            %msub
                              %mi z
