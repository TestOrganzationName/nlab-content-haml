                  \.
          %h4#symplectic_and_khler_structure Symplectic and Kähler structure
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The canonical
              %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              induces the
              %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 1
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega_1 \in \Omega^2(S^2)
              given in the
              %a.existingWikiWord{:href => "/nlab/show/coordinate+charts"} coordinate charts
              of def.
              %a.maruku-ref{:href => "#RiemannSphere"}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ω
                      %mn 1
                    %mo =
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo +
                        %msup
