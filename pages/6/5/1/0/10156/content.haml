              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 2
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mfrac
                          %mi i
                          %mn 2
                        %mfrac
                          %mrow
                            %msub
                              %mi z
                              %mo +
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mover
                                %mi z
                                %mo ¯
                              %mo +
                          %mrow
                            %mn 1
                            %mo −
                            %msup
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi z
                                  %mo +
                                %mo{:stretchy => "false"} |
