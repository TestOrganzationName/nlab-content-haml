                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k \in (0,\infty)
              and with the
              %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
              structure of def.
              %a.maruku-ref{:href => "#RiemannSphere"}
              the 2-sphere is a
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
              with
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+potential"} Kähler potential
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi U
                          %mo ±
                      %annotation{:encoding => "application/x-tex"} U_\pm
                  given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi K
                          %mi k
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi z
                          %mo ±
                        %mo ,
                        %msub
                          %mover
                            %mi z
                            %mo ¯
                          %mo ±
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi k
                        %mi ln
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo +
                        %mrow
                          %mo{:stretchy => "false"} |
