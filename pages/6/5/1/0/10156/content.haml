              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+form"} Kähler form
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
