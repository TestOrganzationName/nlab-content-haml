                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        K_k(z_\pm,\overline{z}_\pm) = - k ln(1 + {\vert z_\pm^2\vert})
