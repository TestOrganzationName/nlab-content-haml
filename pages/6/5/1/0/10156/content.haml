                              %mi θ
                              %mo −
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    z_-^{-k} d z_-^k + \theta_+
                    \&amp; =
                    k
                    \\left(
                    z_-^{-1} -\frac{z_-^{-1}}{1 + {\vert z_-\vert}^2}
                    \\right) d z_-
                    \\\
                    \&amp; =
                    k \frac{\overline{z}_-}{1 + {\vert z_-\vert}^2}
                    d z_-
                    \\\
                    \&amp; = \theta_-
                    \\end{aligned}
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              Compare this invariance of the form of the connection to the invariance of the form of its
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              in remark
              %a.maruku-ref{:href => "#KaehlerFormIsInvariant"}
              above.
          .num_remark
            %h6#remark_5 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \epsilon \in (0,1)
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ϵ
                        %mo ,
                        %mn ∞
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D_{(\epsilon, \infty)}
              be the
              %a.existingWikiWord{:href => "/nlab/show/disk"} disk
              of
              %a.existingWikiWord{:href => "/nlab/show/radius"} radius
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              around
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn ∞
                      %mo ∈
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} x_\infty \in S^2
              %a.existingWikiWord{:href => "/nlab/show/Stokes+theorem"} Stokes theorem
              with def.
              %a.maruku-ref{:href => "#DeligneCocycle"}
              we have the
              %a.existingWikiWord{:href => "/nlab/show/integral"} integral
              equality
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mn 2
                        %mo −
                        %msub
                          %mi D
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                    %mi ω
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∫
                      %mrow
                        %mo ∂
                        %msub
                          %mi D
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                    %mi θ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mi k
                      %mrow
                        %mn 1
                        %mo +
                        %msup
                          %mi ϵ
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{S^2 - D_{(\epsilon,\infty)}}{\int} \omega
                    \\;=\;
                    \\underset{\partial D_{(\epsilon, \infty)}}{\int} \theta
                    \\;=\;
                    \\frac{k}{1 + \epsilon^2}
                    \\,.
            %p
              In the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \to 0
              this shows that for integral
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              as above,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              has integral
              %a.existingWikiWord{:href => "/nlab/show/periods"} periods
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mo ∫
                              %mrow
                                %msup
                                  %mi S
                                  %mn 2
                            %mi ω
                            %mo =
                            %munder
                              %mi lim
                              %mrow
                                %mi ϵ
                                %mo →
                                %mn 0
                            %munder
                              %mo ∫
                              %mrow
                                %msup
                                  %mi S
                                  %mn 2
                                %mo −
                                %msub
                                  %mi D
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi ϵ
                                    %mo ,
                                    %mn ∞
                                    %mo{:stretchy => "false"} )
                            %mi ω
                            %mo =
                            %munder
                              %mi lim
                              %mrow
                                %mi ϵ
                                %mo →
                                %mn 0
                            %mfrac
                              %mi k
                              %mrow
                                %mn 1
                                %mo +
                                %msup
                                  %mi ϵ
                                  %mn 2
                            %mo =
                            %mi k
                            %mo ∈
                            %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\int_{S^2} \omega
                    \=
                    \\underset{\epsilon \to 0}{\lim}
                    \\underset{S^2 - D_{(\epsilon,\infty)}}{\int} \omega
                    \=
                    \\underset{\epsilon \to 0}{\lim}
                    \\frac{k}{1 + \epsilon^2}
                    \=
                    k
                    \\in \mathbb{Z}
                    \\end{aligned}
                    \\,.
            %p
              This is essentially the relation that historically was first recognized by
              %a.existingWikiWord{:href => "/nlab/show/Paul+Dirac"} Paul Dirac
              in the context of what today is known as the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dirac+charge+quantization"} Dirac charge quantization
              argument. In more modern language this expresses the defining
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              property of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %h3#TheSpaceOfQuantumStates The space of quantum states
          %h4#khler_polarization Kähler polarization
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"} Kähler manifold
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S^2
            of prop.
            %a.maruku-ref{:href => "#KaehlerStructure"}
            which lifts its
            %a.existingWikiWord{:href => "/nlab/show/symplectic+structure"} symplectic structure
            given by the
            %a.existingWikiWord{:href => "/nlab/show/volume+form"} volume form
            canonically induces a
            %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
            of the symplectic structure: the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
          .num_defn
            %h6#definition_4 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,\nabla)
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (S^2, \omega)
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Psi \in \Gamma(L)
              is polarized if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi T
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %msup
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v \in \Gamma(T^{0,1}S^2)
              the
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivative"} covariant derivative
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              vanishes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi v
                    %mi Ψ
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla_v \Psi = 0
                    \\,.
          %p
            By prop.
            %a.maruku-ref{:href => "#DeligneCocycle"}
            the connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            is what is called “well adapted” in that in the complex coordinate patch
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mo ±
                  %mo ≃
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} U_\pm \simeq \mathbb{C}
            the covariant derivative along anti-holomorphic vector fields is given simply by the ordinary anti-holomorphic derivative:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∇
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} /
                      %mo ∂
                      %mover
                        %mi z
                        %mo ¯
                  %mi Ψ
                  %mo =
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mover
                        %mi z
                        %mo ¯
                  %mi Ψ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\nabla_{\partial/\partial \overline{z}} \Psi =
                  \\frac{\partial}{\partial \overline{z}} \Psi
                  \\,.
          %p This means that:
          #KaehlerPolarizedIsHolomorphic.num_prop
            %h6#proposition_6 Proposition
            %p The Kähler-polarized sections are precisely the holomorphic sections.
          %h4#wavefunctions Wavefunctions
          .num_defn
            %h6#definition_5 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,\omega)
              prequantizing
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (S^2, \omega)
              %em
                %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
              is the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              of
              %a.existingWikiWord{:href => "/nlab/show/polarization"} polarized
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ⊗
                      %msqrt
                        %mrow
                          %msup
                            %mi Ω
                            %mrow
                              %mn 1
                              %mo ,
                              %mn 0
                    %annotation{:encoding => "application/x-tex"} L \otimes \sqrt{\Omega^{1,0}}
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/wave+functions"} wave functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℋ
                    %mo ≔
                    %mrow
                      %mo {
                      %mi Ψ
                      %mo ∈
                      %mi Γ
                      %mrow
                        %mo (
                        %mi L
                        %mo ⊗
                        %msqrt
                          %mrow
                            %msup
                              %mi Ω
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 0
                        %mo )
                      %mo{:stretchy => "false"} |
                      %mover
                        %mo ∂
                        %mo ¯
                      %mi Ψ
                      %mo =
                      %mn 0
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{H} \coloneqq \left\{ \Psi \in \Gamma\left(L\otimes \sqrt{\Omega^{1,0}}\right) | \overline{\partial} \Psi = 0 \right\}
          #AppearanceOfTheMetaplecticCorrection.num_remark
            %h6#remark_6 Remark
            %p
              Here the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                  %annotation{:encoding => "application/x-tex"} \sqrt{\Omega^{1,0}}
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metaplectic+correction"} metaplectic correction
              = succeed "," do
                %a.maruku-ref{:href => "#SpinStructureByThetaCharacteristic"}
              %a.maruku-ref{:href => "#CanonicalBundleAndSquareRoot"}
              is the essentially unique line bundle of unit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            %p
              Since by prop.
              %a.maruku-ref{:href => "#CanonicalBundleAndSquareRoot"}
              this simply shifts the class of the prequantum bundle by one, and since in much of the traditional literature it is customary to ignore the metaplectic correction (which in the present case is indeed harmless), we will in the following regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊗
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                  %annotation{:encoding => "application/x-tex"} L \otimes \sqrt{\Omega^{1,0}}
              as the prequantum line bundle, by which we mean that we keep referring by “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              ” to the
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              of that line bundle on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
              of which we consider sections etc. Strictly speaking the prequantum line bundle hence has class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k-1
              from now on, but this shift collides with all established literature and is not worth bothering with.
            %p
              It is however maybe worth noticing that the shift of the class by +1 induced by the metaplectic correction can be regarded as lifting the possibly non-regular
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbits"} coadjoint orbits
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \geq 0
              to the regular ones, with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} k \geq 1
          #DimensionOfSpaceOfQuantumStates.num_prop
            %h6#proposition_7 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              of the
              %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
              on the 2-sphere is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi ℋ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi k
                              %mo +
                              %mn 1
                            %mtd
                              %mi if
                              %mspace{:width => "thinmathspace"}
                              %mi k
                              %mo ≥
                              %mn 0
                              %mo ;
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi otherwise
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    dim(\mathcal{H})
                    \=
                    \\left\{
                    \\array{
                    k+1 &amp; if \, k \geq 0;
                    \\\
                    0 &amp; otherwise
                    }
                    \\right.
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≔
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊗
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k \coloneqq c_1(L \otimes \sqrt{\Omega^{1,0}})
              is the
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              of the
              %a.existingWikiWord{:href => "/nlab/show/prequantum+line+bundle"} prequantum line bundle
              with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/metaplectic+correction"} metaplectic correction
          .proof
            %h6#proof_3 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#KaehlerPolarizedIsHolomorphic"}
              the polarized sections are precisely the holomorphic sections. By the construction in def.
              %a.maruku-ref{:href => "#StandardCechCocycle"}
              a holomorphic section of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊗
                    %msqrt
                      %mrow
                        %msup
                          %mi Ω
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 0
                  %annotation{:encoding => "application/x-tex"} L \otimes \sqrt{\Omega^{1,0}}
              is equivalently a pair of holomorphic functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mo ±
                  %annotation{:encoding => "application/x-tex"} \Psi_\pm
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              such that on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbb{C} - \{0\}
              they are related by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mo −
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Ψ
                      %mo +
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi z
                      %mo −
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %msubsup
                      %mi z
                      %mo −
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_-(z_-) = \Psi_+(z_-^{-1}) z_-^{k}
                    \\,.
            %p
              A linear
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              for the space of unconstrained holomorphbic functions on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is of course given by the monomials
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi z
                        %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{z^n\}
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              for the admissible pairs as above is given by pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mo ±
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi z
                      %mo −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi z
                      %mo −
                      %mrow
                        %msub
                          %mi n
                          %mo ±
                  %annotation{:encoding => "application/x-tex"} \Psi_\pm(z_-) = z_-^{n_\pm}
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi z
                      %mo −
                      %mrow
                        %msub
                          %mi n
                          %mo −
                    %mo =
                    %msubsup
                      %mi z
                      %mo −
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msub
                          %mi n
                          %mo +
                    %msubsup
                      %mi z
                      %mo −
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    z_-^{n_-} = z_-^{-n_+} z_-^{k}
            %p hence such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi n
                      %mo −
                    %mo =
                    %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    n_+ + n_- = k
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \geq 0
              then this equation has
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
              solutions. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \lt 0
              it has no solution.
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} k = 2
              (by prop.
              %a.maruku-ref{:href => "#CanonicalBundleAndSquareRoot"}
              the class of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/canonical+line+bundle"} canonical line bundle
              %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
              is 3-dimensional and canonically identified with the
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              underlying the
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+Lie+algebra"} special unitary Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              (by prop.
              %a.maruku-ref{:href => "#CanonicalBundleAndSquareRoot"}
              the class of the unique
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/theta+characteristic"} theta characteristic
              %a.existingWikiWord{:href => "/nlab/show/spinor"} spinor
              in 3-dimensional Euclidean space. This is the standard model for a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/qbit"} qbit
              %a.maruku-ref{:href => "#PauliMatrices"}
              we see how the canonical
              %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
              act on this space of states as the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
          %h3#the_quantum_observables The quantum observables
          %h4#the_hamiltonian_action
            The Hamiltonian
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
          %p
            We discuss the
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+action"} Hamiltonian action
            of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SU(2) \simeq Spin(3)
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S^2, \omega)
          %p
            First we state the abstract situation in terms of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orbit+method"} orbit method
          .num_prop
            %h6#proposition_8 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
              as a
              %a.existingWikiWord{:href => "/nlab/show/matrix+Lie+algebra"} matrix Lie algebra
              is the sub Lie algebra on those matrices of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi i
                              %mi z
                            %mtd
                              %mi x
                              %mo +
                              %mi i
                              %mi y
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi x
                              %mo +
                              %mi i
                              %mi y
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi i
                              %mi z
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi with
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                    %mo ∈
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    i z &amp; x + i y
                    \\\
                    \- x + i y &amp; - i z
                    }
                    \\right)
                    \\;\;\;
                    with
                    \\;\;
                    x,y,z \in \mathbb{R}
                    \\,.
          .num_defn
            %h6#definition_6 Definition
            %p
              The standard
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
              given by the above presentation are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 1
                    %mo ≔
                    %mfrac
                      %mn 1
                      %msqrt
                        %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mn 1
                          %mtr
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                            %mtd
                              %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_1
                    \\coloneqq
                    \\frac{1}{\sqrt{2}}
                    \\left(
                    \\array{
                    0 &amp; 1
                    \\\
                    \-1 &amp; 0
                    }
                    \\right)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 2
                    %mo ≔
                    %mfrac
                      %mn 1
                      %msqrt
                        %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mi i
                          %mtr
                            %mtd
                              %mi i
                            %mtd
                              %mn 0
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_2
                    \\coloneqq
                    \\frac{1}{\sqrt{2}}
                    \\left(
                    \\array{
                    0 &amp; i
                    \\\
                    i &amp; 0
                    }
                    \\right)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mn 3
                    %mo ≔
                    %mfrac
                      %mn 1
                      %msqrt
                        %mn 2
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi i
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi i
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_3
                    \\coloneqq
                    \\frac{1}{\sqrt{2}}
                    \\left(
                    \\array{
                    i &amp; 0
                    \\\
                    0 &amp; -i
                    }
                    \\right)
                    \\,.
            %p
              These are called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
          .num_prop
            %h6#proposition_9 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
              satisfy the
              %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi σ
                      %mn 1
                    %mo ,
                    %msub
                      %mi σ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mi σ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"}
                    [\sigma_1, \sigma_2] = \sigma_3
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi σ
                      %mn 2
                    %mo ,
                    %msub
                      %mi σ
                      %mn 3
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mi σ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    [\sigma_2, \sigma_3] = \sigma_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi σ
                      %mn 3
                    %mo ,
                    %msub
                      %mi σ
                      %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mi σ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [\sigma_3, \sigma_1] = \sigma_2
                    \\,.
          .num_prop
            %h6#proposition_10 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
              is the
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
              %a.existingWikiWord{:href => "/nlab/show/matrix+group"} matrix group
              presentation this is naturally identified with the subgroup of matrices of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi t
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %msup
                                %mi t
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi with
                    %mi t
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi ℂ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\array{
                    t &amp; 0
                    \\\
                    0 &amp; t^{-1}
                    }
                    \\right)
                    \\;\;
                    with
                    t \in U(1) \hookrightarrow \mathbb{C}
                    \\,.
          .num_prop
            %h6#proposition_11 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+orbits"} coadjoint orbits
              of the
              %a.existingWikiWord{:href => "/nlab/show/coadjoint+action"} coadjoint action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰𝔲
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
              are equivalent to the subset of the above matrices with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %msup
                      %mi y
                      %mn 2
                    %mo +
                    %msup
                      %mi z
                      %mn 2
                    %mo =
                    %msup
                      %mi k
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x^2 + y^2 + z^2 = k^2
              for some
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \geq 0
            %p
              These are
              %em regular
              coadjoint orbits for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \gt 0
          %p
            By the discussion at
            %em
              %a{:href => "orbit%20method#TheCoadjointOrbitAndTheCosetSpaceAndFlagManifold"} orbit method – The coadjoint orbit and the flag manifold
            it follows that
          .num_prop
            %h6#proposition_12 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} k \gt 0
              the corresponding coadjoint orbit and hence the symplectic 2-sphere is equivalent to the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi 𝒪
                      %mi λ
                    %mo ≃
                    %msup
                      %mi S
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    SU(2)/U(1) \stackrel{\simeq}{\to} \mathcal{O}_\lambda \simeq S^2
                    \\,,
            %p where the equivalence is induced by the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msubsup
                      %mi Ad
                      %mi g
                      %mo *
                    %mo{:stretchy => "false"} ⟨
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g U(1) \mapsto Ad_g^\ast\langle \lambda, - \rangle
                    \\,.
          %h4#the_quantum_operators The quantum operators
          %p
            Recall the canonical
            %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
            functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo ,
                  %msub
                    %mi x
                    %mn 2
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi S
                    %mn 2
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} x_1, x_2, x_2 \colon S^2 \to \mathbb{R}
            from prop.
            = succeed "." do
              %a.maruku-ref{:href => "#TheThreeCanonicalFunctions"}
          .num_prop
            %h6#proposition_13 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,\nabla)
              a
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S,\omega)
              equipped with the above
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+polarization"} Kähler polarization
              %a.existingWikiWord{:href => "/nlab/show/prequantum+operators"} prequantum operators
              associated to the canonical
              %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
              functions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
                      %mn 2
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    x_1, x_2, x_2 \colon S^2 \to \mathbb{R}
            %p
              from prop.
              %a.maruku-ref{:href => "#TheThreeCanonicalFunctions"}
              are
              %a.existingWikiWord{:href => "/nlab/show/quantum+operators"} quantum operators
              (respect the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/polarization"} polarization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo −
                  %annotation{:encoding => "application/x-tex"} U_-
              their action on sections is that of the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo +
                    %mi i
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi z
                      %mo −
                      %mn 2
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi z
                          %mo −
                    %mo −
                    %mi k
                    %msub
                      %mi z
                      %mo −
                  %annotation{:encoding => "application/x-tex"}
                    Q(x_1 + i x_2) = z_-^2 \frac{\partial}{\partial z_-} - k z_-
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo −
                    %mi i
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi z
                          %mo −
                  %annotation{:encoding => "application/x-tex"}
                    Q(x_1 - i x_2) = - \frac{\partial}{\partial z_-}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi z
                      %mo −
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %msub
                          %mi z
                          %mo −
                    %mo −
                    %mi k
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Q(x_3) = z_- \frac{\partial}{\partial z_-} - k/2
                    \\,.
          #PauliMatrices.num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              these act as the
              %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
              on the
              %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℋ
                      %mo ≃
                      %msup
                        %mi ℂ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{H} \simeq \mathbb{C}^2
            %p
              By the proof of prop.
              %a.maruku-ref{:href => "#DimensionOfSpaceOfQuantumStates"}
              the
              %a.existingWikiWord{:href => "/nlab/show/space+of+quantum+states"} space of quantum states
              is spanned by those
              %a.existingWikiWord{:href => "/nlab/show/wavefunctions"} wavefunctions
              which on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mo −
                  %annotation{:encoding => "application/x-tex"} U_-
              are of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mo ≔
                    %msubsup
                      %mi z
                      %mo −
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\vert -\rangle \coloneqq z_-^0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo +
                    %mo{:stretchy => "false"} ⟩
                    %mo ≔
                    %msubsup
                      %mi z
                      %mo −
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\vert +\rangle \coloneqq z_-^1
                    \\,.
            %p
              These are
              %a.existingWikiWord{:href => "/nlab/show/eigenvectors"} eigenvectors
              for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Q(x_3)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    Q(x_3) \vert - \rangle = -\frac{1}{2} \vert - \rangle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo +
                    %mo{:stretchy => "false"} ⟩
                    %mo =
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} |
                    %mo +
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Q(x_3) \vert + \rangle = \frac{1}{2} \vert + \rangle
                    \\,.
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo −
                    %mi i
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(x_1 - i x_2)
              acts as a lowering operator on these states. Notice that also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo +
                    %mi i
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Q(x_1 + i x_2)
              indeed acts as a raising operator in that for the special value of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              we have indeed
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Q
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo +
                            %mi i
                            %msub
                              %mi x
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                            %mo +
                            %mo{:stretchy => "false"} ⟩
                          %mtd
                            %mo =
                            %msubsup
                              %mi z
                              %mo −
                              %mn 2
                            %mfrac
                              %mrow
                                %mo ∂
                                %msub
                                  %mi z
                                  %mo −
                              %mrow
                                %mo ∂
                                %msub
                                  %mi z
                                  %mo −
                            %mo +
                            %msub
                              %mi z
                              %mo −
                            %msub
                              %mi z
                              %mo −
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Q(x_1 + i x_2) \vert + \rangle
                    \&amp; =
                    z_-^2 \frac{\partial z_-}{\partial z_-} + z_- z_-
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
