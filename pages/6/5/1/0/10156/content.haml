                            %msub
                              %mi θ
                              %mo +
                          %mtd
                            %mo =
                            %mi k
                            %mfrac
                              %mrow
                                %msubsup
                                  %mover
                                    %mi z
                                    %mo ¯
                                  %mo −
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                              %mrow
                                %mn 1
                                %mo +
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %msub
                                    %mi z
                                    %mo −
                                  %msup
                                    %mo{:stretchy => "false"} |
                                    %mrow
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mn 2
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %msubsup
                              %mi z
                              %mo −
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 2
                            %mi d
                            %msub
                              %mi z
                              %mo −
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi k
                            %mfrac
                              %mrow
                                %msubsup
                                  %mi z
                                  %mo −
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mi d
                                %msub
                                  %mi z
                                  %mo −
                              %mrow
                                %mn 1
                                %mo +
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %msub
                                    %mi z
                                    %mo −
                                  %msup
                                    %mo{:stretchy => "false"} |
                                    %mn 2
                        %mtr
