                                    %msup
                                      %mrow
                                        %mo{:stretchy => "false"} |
                                        %mi z
                                        %mo{:stretchy => "false"} |
                                      %mn 2
                                    %msup
                                      %mo{:stretchy => "false"} )
                                      %mn 2
                                %mi d
