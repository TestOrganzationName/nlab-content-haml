                      \\alpha^{sk}_{F,G}=1_{E^{\sim1}_\mathcal{D}\circ F}\star\epsilon^{sk}_\mathcal{C}\star1_{G\circ E_\mathcal{B}}:E^{\sim1}_\mathcal{D}\circ F\circ E_\mathcal{C}\circ E_\mathcal{C}^{\sim1}\circ G\circ E_\mathcal{B}\Rightarrow E^{\sim1}_\mathcal{D}\circ F\circ G\circ E_\mathcal{B}.
          %h3#skeleton_of_an_indexed_category Skeleton of an Indexed Category
          %p Using the above definition, we can canonically define the skeleton of an indexed category.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo :
                  %msup
                    %mi ℬ
                    %mi op
                  %mo →
                  %mi ℭ𝔞𝔱
                %annotation{:encoding => "application/x-tex"} \psi:\mathcal{B}^{op}\to\mathfrak{Cat}
            be an indexed category. We define the
            = succeed "," do
              %strong
                indexed skeleton of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sk
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi ℬ
                    %mi op
                  %mo →
                  %mi ℭ𝔞𝔱
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  sk(\psi):\mathcal{B}^{op}\to\mathfrak{Cat},
          %p
            to be the indexed category given by postcomposing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} \psi
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sk
                  %annotation{:encoding => "application/x-tex"} sk
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sk
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi sk
                  %mo ∘
                  %mi ψ
                  %mo .
                %annotation{:encoding => "application/x-tex"} sk(\psi)=sk\circ\psi.
            That is, for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ∈
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} I\in\mathcal{B}
            we take a skeleton
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sk
                  %mo{:stretchy => "false"} (
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sk(\psi(I))
            of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \psi(I)
            indexed by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            with equivalence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi I
                    %mo :
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi sk
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msubsup
                      %mi E
                      %mi I
                      %mrow
                        %mo ∼
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} E_I:\psi(I)\simeq sk(\psi(I)):E_I^{\sim1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℬ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathcal{B}^{op}
            has only identity
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          %h3#skeleton_of_a_fibered_category Skeleton of a Fibered Category
          %p
            Using the above definition and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi ℰ
                  %mo →
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} p:\mathcal{E}\to\mathcal{B}
            be a fibration. We define the
            = succeed "," do
              %strong
                fibered skeleton of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sk
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi sk
                    %mi ℰ
                    %mi p
                  %mo →
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"}
                  sk(p):sk^p_\mathcal{E}\to\mathcal{B}
          %p
            to be the Grothendieck completion of the indexed skeleton of the indexing by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sk
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} sk(p)
            is the fibration obtained by turning
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            into an indexed category using the Grothendieck construction, taking the indexed skeleton of this indexed category, then turning the resulting skeletal indexed category back into a fibration (via the Grothendieck construction again). We refer to the total category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi sk
                    %mi ℰ
                    %mi p
                %annotation{:encoding => "application/x-tex"} sk^p_\mathcal{E}
            in the resulting fibration as the
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              \-skeleton
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sk
                    %mi ℰ
                %annotation{:encoding => "application/x-tex"} sk_\mathcal{E}
            since we have only skeletalized the fiber categories of our original fibration and not the total category of the original fibration. In general, we will have that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sk
                    %mi ℰ
                  %mo ≇
                  %msubsup
                    %mi sk
                    %mi ℰ
                    %mi p
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  sk_\mathcal{E}\ncong sk^p_\mathcal{E},
          %p
            although they are trivially equivalent. As an example of this construction in action, we can pass from the monomorphism fibration on a category with pullbacks to the subobject fibration by taking the fibered skeleton. For details, see the subobject fibration section of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/codomain+fibration"} codomain fibration
          %h2#properties Properties
          %p
            In this section we collect some properties of skeleta in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set-level+foundations"} set-level foundations
          %h3#noninvariance Non-invariance
          %p
            Of course, two categories can be equivalent even if one is skeletal and the other is not. Thus, the notion of skeletal category violates the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principle+of+equivalence"} principle of equivalence
            %em particular
            category, skeletal or not, “violates the principle of equivalence”.)
          %h3#skeletons_without_choice Skeletons without Choice
          %p Without any choice, we have the following theorems.
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin category
              (i.e. any
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/preordered+set"} preordered set
          .proof
            %h6#proof_2 Proof
            %p
              In this case, we can take the objects of the skeleton of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to be the isomorphism classes of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is thin, then we can define a partial ordering on its set of isomorphism classes, making them into a skeleton of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .num_theorem
            %h6#theorem_3 Theorem
            %p Any two skeletons (in the strong sense) of a category are isomorphic.
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a category, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sk
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sk (\mathcal{C})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sk
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} sk (\mathcal{C})'
              two skeletons of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Y\in\mathcal{C}
              denote by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} X_Y
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} X_Y'
              respectively the unique objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sk
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} sk (\mathcal{C})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sk
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} sk (\mathcal{C})'
              which are isomorphic to Y, and denote their respective isomorphisms by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi Y
                    %mo :
                    %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} i_Y:Y\to X_Y
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi Y
                      %mo ′
                      %mo :
                      %mi Y
                      %mo →
                      %msub
                        %mi X
                        %mi Y
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} i_Y':Y\to X_Y'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi sk
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi sk
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F:sk (\mathcal{C})\to sk (\mathcal{C})'
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi X
                      %mi Y
                    %mo ′
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    F(X_Y)=X_Y',
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo :
                    %msub
                      %mi X
                      %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mi Z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi i
                      %mi Z
                    %mo ′
                    %mo ∘
                    %msubsup
                      %mi i
                      %mi Z
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo ∘
                    %mi f
                    %mo ∘
                    %msub
                      %mi i
                      %mi Y
                    %mo ∘
                    %msub
                      %mi i
                      %mi Y
                    %msup
                      %mo ′
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %msub
                      %mi X
                      %mi Y
                    %mo ′
                    %mo →
                    %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mi Z
                    %mo →
                    %mi Z
                    %mo →
                    %msub
                      %mi X
                      %mi Z
                    %mo ′
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F(f:X_Y\to X_Z)=i_Z'\circ i_Z^{-1}\circ f\circ i_Y\circ i_Y'^{-1}:X_Y'\to Y\to X_Y\to X_Z\to Z\to X_Z'.
            %p We then have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mrow
                        %msub
                          %mi X
                          %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi i
                      %mi Y
                    %mo ′
                    %mo ∘
                    %msubsup
                      %mi i
