                    %annotation{:encoding => "application/x-tex"} \prod^{inf}(X)_{(n+1)}\to cone(\mathfrak{a})
              = succeed "." do
                %math#mathml_470db1e2bd243a7b103b684bcde179db6c95d92f_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cone
                      %mo{:stretchy => "false"} (
                      %mi cone
                      %mo{:stretchy => "false"} (
                      %mi ⋯
                      %mo{:stretchy => "false"} (
                      %mi cone
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mi ⋯
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} cone(cone(\cdots(cone(\mathfrak{a}))\cdots)
            %p
              I have a vague feeling that starting with a 0-falt
              = succeed "-connection" do
                %math#mathml_470db1e2bd243a7b103b684bcde179db6c95d92f_64.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
