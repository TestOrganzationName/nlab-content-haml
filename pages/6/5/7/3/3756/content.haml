                    %annotation{:encoding => "application/x-tex"} \prod^{inf}(X)\to\mathfrak{a}
              %math#mathml_470db1e2bd243a7b103b684bcde179db6c95d92f_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔞
                  %annotation{:encoding => "application/x-tex"} \mathfrak{a}
              to
              = succeed ")." do
                %math#mathml_470db1e2bd243a7b103b684bcde179db6c95d92f_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cone
                      %mo{:stretchy => "false"} (
                      %mi 𝔞
                    %annotation{:encoding => "application/x-tex"} cone(\mathfrak{a}
              = succeed "-connections)." do
                %math#mathml_470db1e2bd243a7b103b684bcde179db6c95d92f_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %p
              let us see things the other way round: when we say flat, we mean flat in an
              = succeed "-categorical" do
                %math#mathml_470db1e2bd243a7b103b684bcde179db6c95d92f_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
