                  exists,
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived
                  image
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕃
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi S
