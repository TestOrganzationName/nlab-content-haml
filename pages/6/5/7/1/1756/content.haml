          %h2#idea Idea
          %p
            Quillen adjunctions are one convenient notion of
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            between
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            between the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-categories
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presented
            by the model categories.
          %h2#Definition Definition
          #QuillenAdjunction.num_defn
            %h6#definition_2 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L,R)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mover
                      %munder
                        %mo →
                        %mi L
                      %mover
                        %mo ←
                        %mi R
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv R) : C \stackrel{\overset{R}{\leftarrow}}{\underset{L}{\to}}
                    D
            %p
              of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              (with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %strong Quillen adjunction
              if the following equivalent conditions are satisfied:
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                  and
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                  and
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
          .num_prop
            %h6#proposition Proposition
            %p
              The conditions in def.
              %a.maruku-ref{:href => "#QuillenAdjunction"}
              are indeed all equivalent.
          .proof
            %h6#proof Proof
            %p Observe that
            %ul
              %li
                %p
                  (i)
                  %em
                    A
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                    between
                    %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                    preserves acyclic cofibrations precisely if its
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                    preserves fibrations.
              %li
                %p
                  (ii)
                  %em
                    A
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                    between
                    %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                    preserves cofibrations precisely if its
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                    preserves acyclic fibrations.
            %p
              We discuss statement (i), statement (ii) is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f\colon A \to B
              be an acyclic cofibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} g \colon X \to Y
              a fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              as on the left of the following, its
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L\dashv R)
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              is a commuting diagram as on the right here:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi g
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi X
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\longrightarrow&amp; R(X)
                    \\\
                    {}^{\mathllap{f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{R(g)}}
                    \\\
                    B &amp;\longrightarrow&amp; R(Y)
                    }
                    \\;\;\;\;\;\;
                    \\,,
                    \\;\;\;\;\;\;
                    \\array{
                    L(A) &amp;\longrightarrow&amp; X
                    \\\
                    {}^{\mathllap{L(f)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{g}}
                    \\\
                    L(B) &amp;\longrightarrow&amp; Y
                    }
                    \\,.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves acyclic cofibrations, then the diagram on the right has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L\dashv R)
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              of that lift is a lift of the left diagram. This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(g)
              has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against all acylic cofibrations and hence is a fibration. Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              preserves fibrations, the same argument run from right to left gives that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves acyclic fibrations.
            %p Now by repeatedly applying (i) and (ii), all four conditions in question are seen to be equivalent.
          .num_remark
            %h6#remark Remark
            %p
              Quillen adjunctions that are analogous to an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              are called
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
            %p
              In an
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              one speaks of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/enriched+Quillen+adjunction"} enriched Quillen adjunction
          %h2#properties Properties
          %h3#derived_adjunction Derived adjunction
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"}> Ken Brown's lemma
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L \dashv R)
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#QuillenAdjunction"}
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves weak equivalences between cofibrant objects;
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves weak equivalences between fibrant objects.
          .proof
            %h6#proof_2 Proof
            %p
              To show this for instance for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              and apply the
              %em
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              which shows that every weak equivalence between fibrant objects may be factored, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %a.existingWikiWord{:href => "/nlab/show/span"} span
              of acyclic fibrations.
            %p
              These weak equivalences are preserved by the right Quillen property of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              and hence the claim follows by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              we apply the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              argument.
          #QuillenAdjunctionInducesAdjunctionOnHomotopyCategories.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction"}> derived adjunction
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %munderover
                      %mrow
                        %msub
                          %mrow
                          %mphantom
                            %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mi L
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \underoverset{\underset{R}{\longrightarrow}}{\overset{L}{\longleftarrow}}{{}_{\phantom{Qu}}\bot_{Qu}}\mathcal{D}
              a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              form a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi ℝ
                      %mover
                        %mo ⟵
                        %mi 𝕃
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho(\mathcal{C})
                    \\underoverset
                    {\underset{\mathbb{R}}{\longrightarrow}}
                    {\overset{\mathbb{L}}{\longleftarrow}}
                    {\bot}
                    Ho(\mathcal{D})
            %p
              between the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy categories
            %p
              Moreover, the
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              and
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              of this derived adjunction are the images of the
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
              and
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
              of the original
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
          %p
            (
            %a{:href => "model+category#Quillen67"}> Quillen 67, I.4 theorem 3
            )
          %h3#BehaviourUnderLocalization Behaviour under Bousfield localization
          #DescendToLeftBousfieldLocalization.num_prop
            %h6#proposition_4 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
