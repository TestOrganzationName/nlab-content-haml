                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv R)
                    \\;\;\;\colon\;\;\;
                    \\mathcal{C}
                    \\underoverset
                    {\underset{\;\;\;\;\;\; R \;\;\;\;\;\;}{\longrightarrow}}
                    {\overset{\;\;\;\;\;\; L \;\;\;\;\;\;}{\longleftarrow}}
                    {\bot_{\mathrlap{{}_{Qu}}}}
                    \\mathcal{D}
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
