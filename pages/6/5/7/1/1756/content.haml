                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
          %p
            Of particular interest are
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched
            adjunctions between
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunctions"} simplicial Quillen adjunctions
          %p
            These present
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              be
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mover
                      %munder
                        %mo →
                        %mi L
                      %mover
                        %mo ←
                        %mi R
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv R) : C \stackrel{\overset{R}{\leftarrow}}{\underset{L}{\to}} D
            %p
              be an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              whose underlying ordinary adjunction is a Quillen adjunction. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} C^\circ
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} D^\circ
              be the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              presented by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              (the
              = succeed "-enriched" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "-subcategories" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functors"} adjoint (∞,1)-functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝕃
                    %mo ⊣
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi C
                      %mo ∘
                    %mover
                      %mo →
                      %mo ←
                    %msup
                      %mi D
                      %mo ∘
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbb{L} \dashv \mathbb{R}) : C^\circ \stackrel{\leftarrow}{\to} D^{\circ}
                    \\,.
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorified
              level of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy categories
              these are the total left and right
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          .proof
            %h6#proof_3 Proof
            %p
              This is proposition 5.2.4.6 in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
          %p The following proposition states conditions under which a Quillen adjunction may be detected already from knowing of the right adjoint only that it preserves fibrant objects (instead of all fibrations).
          #RecognitionOfSimplicialQuillenAdjunctions.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (recognition of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunctions"} simplicial Quillen adjunctions
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              are
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a left
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
              = succeed "-enriched" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mover
                      %mo →
                      %mo ←
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    (L \dashv R) : C \stackrel{\leftarrow}{\to} D
            %p
              is a Quillen adjunction already if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              preserves cofibrations and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              just fibrant objects.
          %p
            This appears as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, cor. A.3.7.2
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
            for more details.
          %h3#AssociatedInfinityAdjunction Associated (infinity,1)-adjunction
          .un_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo ⇄
                    %mi D
                    %mo :
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F : C \rightleftarrows D : G
              be a Quillen adjunction between
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              (which are not assumed to admit functorial factorizations or infinite (co)limits). Then there is an induced
              %a.existingWikiWord{:href => "/nlab/show/adjunction+of+%28infinity%2C1%29-categories"} adjunction of (infinity,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi W
                      %mi C
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⇄
                    %mi D
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi W
                      %mi D
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F : C[W_C^{-1}] \rightleftarrows D[W_D^{-1}] : G
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi W
                      %mi C
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C[W_C^{-1}]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi W
                      %mi D
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} D[W_D^{-1}]
              denote the respective
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localizations"} simplicial localizations
              at the respective classes of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
          %p
            See (
            %a{:href => "#MazelGee16"}> Mazel-Gee 16
            , Theorem 2.1). (This is also asserted as (
            %a{:href => "#Hinich14"}> Hinich 14
            , Proposition 1.5.1), but it is not completely proved there – see (
            %a{:href => "#MazelGee16"}> Mazel-Gee 16
            , Remark 2.3).)
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
            with
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched
            %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
            between them, this is also in (
            %a{:href => "#Lurie"}> Lurie, prop. 5.2.4.6
            ).
          %p
            See also at
            %em
              %a{:href => "derived%20functor#OnInftyCats"} derived functor – As functors on infinity-categories
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Quillen+reflection"} Quillen reflection
            %li
              %p
