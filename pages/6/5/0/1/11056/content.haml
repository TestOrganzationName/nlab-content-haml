          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#RelationToDaggerCompactStructure"}
                    Relation to
                    = succeed "-compact" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo †
                          %annotation{:encoding => "application/x-tex"} \dagger
              %li
                %a{:href => "#GraphicalLanguage"} Graphical language
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            In a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            a
            %em self-duality
            on a
            %a.existingWikiWord{:href => "/nlab/show/dualizable+object"} dualizable object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a choice of
            %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≃
                  %msup
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} X \simeq X^\ast
            with its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
          %h2#properties Properties
          %h3#RelationToDaggerCompactStructure
            Relation to
            = succeed "-compact" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
          %p
            If each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            of a
            %a.existingWikiWord{:href => "/nlab/show/compact+closed+category"} compact closed category
            is equipped with a self-duality structure
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi X
                    %mo :
                    %mi X
                    %mo ≃
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} h_X : X \simeq X^\ast
            %a.existingWikiWord{:href => "/nlab/show/dual+morphisms"} dual morphisms
            but with these identifications pre- and postcomposed
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo †
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mover
                    %mo ⟶
                    %mi f
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi h
                        %mi Y
                  %msup
                    %mi Y
                    %mo *
                  %mover
                    %mo ⟶
                    %mrow
                      %msup
                        %mi f
                        %mo *
                  %msup
                    %mi X
                    %mo *
                  %mover
                    %mo →
                    %mrow
                      %msubsup
                        %mi h
                        %mi X
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (-)^\dagger \;\colon\;
                  (X \stackrel{f}{\longrightarrow} Y)
                  \\mapsto
                  (Y \stackrel{h_Y}{\to} Y^\ast \stackrel{f^\ast}{\longrightarrow} X^\ast \stackrel{h_X^{-1}}{\to} X)
          %p
            constitutes a
            %a.existingWikiWord{:href => "/nlab/show/dagger-compact+category"} dagger-compact category
            structure.
          %p
            See for instance (
            %a{:href => "#Selinger"}> Selinger, remark 4.5
            ).
          %p
            Applied for instance to the category of finite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/inner+product+spaces"} inner product spaces
            this dagger-operation sends
            %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            to their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/transposed+matrix"} transposed matrix
          %h2#GraphicalLanguage Graphical language
          %p
            In terms of
            %a.existingWikiWord{:href => "/nlab/show/string+diagrams"} string diagrams
            (following Joyal and Street’s conventions for
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
            %a{:href => "#Selinger"} Selinger
            argues that the isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi X
                  %mo :
                  %mi X
                  %mo ≃
                  %msup
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} h_X : X \simeq X^\ast
            should be depicted as a half-twist. In particular, for a
            %a.existingWikiWord{:href => "/nlab/show/tortile+category"} tortile category
            equipped with a self-duality structure, the
            %a.existingWikiWord{:href => "/nlab/show/coherence"} coherence
            condition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mo *
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi h
                        %mrow
                          %msup
                            %mi X
                            %mo *
                  %msup
                    %mi X
                    %mrow
                      %mo *
                      %mo *
                  %mover
                    %mo →
                    %mrow
                      %msubsup
                        %mi h
                        %mi X
                        %mo *
                  %msup
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mo *
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi θ
                        %mrow
                          %msup
                            %mi X
                            %mo *
                  %msup
                    %mi X
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (X^\ast \stackrel{h_{X^\ast}}{\to} X^{\ast\ast} \stackrel{h_X^\ast}{\to} X^\ast) \; =\;
                  (X^\ast \stackrel{\theta_{X^\ast}}{\longrightarrow} X^\ast)
          %p
            decomposes a full
            %a.existingWikiWord{:href => "/nlab/show/twist"} twist
            into a pair of half-twists.
          %p
            This is a special case of half-twists as described by
            = succeed "." do
              %a{:href => "#Egger11"} Egger 2011
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/inner+product"} inner product
          %h2#references References
          %ul
            %li#Selinger
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Selinger"}> Peter Selinger
                ,
                = succeed "," do
                  %em
                    Autonomous categories in which
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ≃
                          %msup
                            %mi A
                            %mo *
                        %annotation{:encoding => "application/x-tex"} A \simeq A^\ast
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/SelingerSelfDual.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+B.+Young"}> Matthew B. Young
                , §3.1 in
                = succeed "," do
                  %em Self-Dual Hall modules
                = succeed "," do
                  %a{:href => "https://www.math.stonybrook.edu/alumni/2013-Matthew-Young.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Young-HallModules.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (in a context relating to
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/orientifold"} orientifold
                  = succeed "-algebras)" do
                    %a.existingWikiWord{:href => "/nlab/show/BPS+state"} BPS
            %li
              %p
                Chenjing Bu, Def. 3.2 in:
                %em Enumerative invariants in self-dual categories. I. Motivic invariants
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2302.00038"}> arXiv:2302.00038
                \&amp;rbrack;
          %p
            On half-twists as
            %a{:href => "#GraphicalLanguage"} above
          %ul
            %li#Egger11
              %a.existingWikiWord{:href => "/nlab/show/Jeff+Egger"}> Jeff Egger
              ,
              = succeed "," do
                %em On involutive monoidal categories
              %strong 25
              14 (2011) 368-393 &amp;lbrack;
              %a{:href => "http://www.tac.mta.ca/tac/volumes/25/14/25-14abs.html"}> tac:25-14
              \&amp;rbrack;
          %p#InTQFT
            Under the
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            (which is a theorem certainly for the relevant case
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-categories"}
              symmetric monoidal
              = succeed "-categories" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            correspond equivalently to
            = succeed "-oriented" do
              %em un
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/TQFTs"} TQFTs
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                \: Ex. 2.4.28 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/On+the+Classification+of+Topological+Field+Theories"} On the Classification of Topological Field Theories
                %strong 2008
                (2009) 129-280 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/0905.0465"}> arXiv:0905.0465
                ,
                = succeed "," do
                  %a{:href => "https://dx.doi.org/10.4310/CDM.2008.v2008.n1.a3"} doi:10.4310/CDM.2008.v2008.n1.a3
                = succeed "&rbrack;" do
                  %a{:href => "https://projecteuclid.org/euclid.cdm/1254748657"} euclid:cdm/1254748657
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Khovanov"} Mikhail Khovanov
                (notes by
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/You+Qi"} You Qi
                %a{:href => "https://www.math.columbia.edu/~khovanov/cat2020/notes/2_TQFT.pdf#page=7"} p. 7
                in §2 of:
                = succeed "," do
                  %em Introduction to categorification
                = succeed "," do
                  %a{:href => "https://www.math.columbia.edu/~khovanov/cat2020/"} web
                = succeed "," do
                  %a{:href => "https://you-qi2121.github.io/mypage/categorificationnotes.html"} web
                = succeed "&rbrack;" do
                  %a{:href => "https://www.dropbox.com/scl/fi/wdesax1c8il6tgwbi20t4/KhovanovYouQi-Categorification.pdf?rlkey=l5cm3khnzu604ijdnl06o89od&dl=0"} pdf
            %li#Teleman16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Constantin+Teleman"}> Constantin Teleman
                , Rem. 1.7 in:
                = succeed "," do
                  %em Five lectures on topological field theory
                = succeed "," do
                  %em Geometry and Quantization of Moduli Spaces
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/978-3-319-33578-0_3"} doi:10.1007/978-3-319-33578-0_3
                = succeed "," do
                  %a{:href => "http://math.berkeley.edu/~teleman/math/barclect.pdf"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Teleman-LecturesOnTFT.pdf", :title => "pdf"} pdf
          %p
            same non-topological
            %a.existingWikiWord{:href => "/nlab/show/functorial+field+theory"} functorial field theory
          %ul
            %li#GradyPavlov21
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Grady"}> Daniel Grady
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Pavlov"} Dmitri Pavlov
              %em The geometric cobordism hypothesis
