                        %annotation{:encoding => "application/x-tex"} \array{d s^2_{A_N Sing} \coloneqq \frac{\vert\vec r\vert }{(N+1)R/2}(d x^4 + \vec \omega \cdot d \vec r)^2 + \frac{ (N+1)R/2}{\vert \vec r\vert} (d \vec r)^2 \,, \\ \vec r \in \mathbb{R}^3,\, x^4 \in \mathbb{R}/(2 \pi R\mathbb{Z}) }
