                    M &amp; \to &amp; N \\
                    ^\mathllap{f} \downarrow &amp; &amp; \downarrow^\mathrlap{g} \\
                    \\oplus_j B_j &amp; \underset{\oplus_j i_j}{\to} &amp; \oplus_j E_j
                    }
            %p
              commutes. Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Mod
                      %mi R
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Mod}_R(N, -)
              preserves coproducts, we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi j
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g_j = 0
              for all but finitely many
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
