                              %mo
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi g
                        %mtr
                          %mtd
                            %msub
                              %mo ⊕
                              %mi j
                            %msub
                              %mi B
                              %mi j
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msub
                                  %mo ⊕
                                  %mi j
                                %msub
                                  %mi i
                                  %mi j
                          %mtd
                            %msub
                              %mo ⊕
                              %mi j
                            %msub
                              %mi E
                              %mi j
                  %annotation{:encoding => "application/x-tex"}
