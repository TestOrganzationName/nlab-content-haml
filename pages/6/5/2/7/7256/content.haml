              of modules, and a map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi M
                      %mo →
                      %msub
                        %mo ⊕
                        %mi i
                      %msub
                        %mi B
                        %mi i
                    %annotation{:encoding => "application/x-tex"} f \colon M \to \oplus_i B_i
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/injective+object#AbHasEnoughInjectives"} enough injectives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi j
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi B
                      %mi j
                    %mo →
                    %msub
                      %mi E
                      %mi j
                  %annotation{:encoding => "application/x-tex"} i_j \colon B_j \to E_j
              in an injective module, for each
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/injective+object#DirectSumInjectives"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊕
                      %mi i
                    %msub
                      %mi E
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \oplus_i E_i
              is injective. Thus, there exists
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              such that the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi M
                          %mtd
                            %mo →
                          %mtd
                            %mi N
                        %mtr
