                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_{n}(A) \cong S_{n}(A)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/positive+characteristic"} positive characteristic
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/crystalline+cohomology"} crystalline cohomology
          %h2#references References
          %p Divided power algebras were originally introduced in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Henri+Cartan"}> Henri Cartan
              ,
              = succeed "," do
                %em Puissances divisées
              = succeed "." do
                %a{:href => "http://www.numdam.org/item/SHC_1954-1955__7_1_A7_0/"} Numdam:SHC_1954–1955__7_1_A7_0
          %p
            Their theory was further developed in
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Berthelot"} Pierre Berthelot
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/crystalline+cohomology"} crystalline cohomology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Berthelot"}> Pierre Berthelot
              ,
              = succeed "," do
                %em
                  Cohomologie cristalline des schémas de caractéristique
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} p \gt 0
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/BFb0068636"} doi:10.1007/BFb0068636
          %p Review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Berthelot"}> Pierre Berthelot
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Arthur+Ogus"} Arthur Ogus
                = succeed "," do
                  %em Notes on crystalline cohomology
                = succeed ")" do
                  %a{:href => "https://press.princeton.edu/books/hardcover/9780691648323/notes-on-crystalline-cohomology-mn-21"} ISBN:0-691-08218-9
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aise+Johan+de+Jong"} Aise Johan de Jong
                et al.,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/The+Stacks+Project"} The Stacks Project
                = succeed "." do
                  %a{:href => "https://stacks.math.columbia.edu/tag/09PD"} Chapter 09PD
          %p Recent works on divided power algebras include:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sacha+Ikonicoff"}> Sacha Ikonicoff
                ,
                = succeed "," do
                  %em Divided power algebras over an operad
                %strong 62
                (2020) 477-517,
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/S0017089519000223"} doi:10.1017/S0017089519000223
                %a{:href => "https://arxiv.org/pdf/1712.03694.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sacha+Ikonicoff"}> Sacha Ikonicoff
                ,
                = succeed "," do
