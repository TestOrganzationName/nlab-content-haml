          %h2#idea Idea
          %p
            A
            %em divided power algebra
            is a
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            together with an
            %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and a collection of operations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi γ
                    %mi n
                  %mo{:lspace => "verythinmathspace"} :
                  %mi I
                  %mo →
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                %annotation{:encoding => "application/x-tex"} \{\gamma_{n}\colon I\to A\}_{n\in\mathbb{N}}
            which behave like operations of taking divided powers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %msup
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mo !
                %annotation{:encoding => "application/x-tex"} x\mapsto x^{n}/n!
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
          %h2#definition Definition
          %p
            A
            %strong divided power algebra
            is a triple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
