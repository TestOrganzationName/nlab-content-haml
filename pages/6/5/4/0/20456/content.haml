          %h2#idea Idea
          %p
            Prismatic cohomology is a cohomology theory for p-adic
            %a.existingWikiWord{:href => "/nlab/show/formal+schemes"} formal schemes
            which can specialize into various
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+cohomology"} étale cohomology
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/crystalline+cohomology"} crystalline cohomology
            = succeed "-de" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"} Peter Scholze
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+Hodge+theory"} p-adic Hodge theory
          %p
            Prismatic cohomology relies heavily on the idea of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Joyal+delta-ring"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi δ
                    %annotation{:encoding => "application/x-tex"} \delta
                \-ring
            %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
            to formalize how a ring equipped with a
            %a.existingWikiWord{:href => "/nlab/show/Frobenius+lift"} Frobenius lift
            is analogous to ring equipped with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
          %h2#prisms Prisms
          %p
            A prism is a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,I)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is an ideal defining a Cartier divisor on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spec
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spec}(A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is derived
            = succeed "-complete," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,I)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi I
                    %mo +
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mi A
                  %annotation{:encoding => "application/x-tex"} p \in I + \phi(I)A
          %h2#examples_of_prisms Examples of Prisms
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi ℤ
                      %mi p
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi u
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A=\mathbb{Z}_{p}[[u]]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo −
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I=(u-p)
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi A
                      %mi{:mathvariant => "normal"} inf
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A=A_{\mathrm{inf}}(R)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mi{:mathvariant => "normal"} ker
                      %mo{:stretchy => "false"} (
                      %mi θ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I=\mathrm{ker}(\theta)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo :
                    %msub
                      %mi A
                      %mi{:mathvariant => "normal"} inf
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \theta:A_{\mathrm{inf}}(R)\to R
              is the canonical surjection
          %h2#relation_to_perfectoid_rings Relation to Perfectoid Rings
          %p
            A prism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,I)
            is
            %em perfect
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is perfect. The category of perfect prisms is equivalent to the category of
            %em integral perfectoid rings
            which are related to, but not the same as, the perfectoid rings in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/perfectoid+spaces"} perfectoid spaces
            %a{:href => "#BhattScholze19"} BhattScholze19
            and the relation between the two notions of perfectoid can be found in Lemma 3.20 of the same paper.
          %h2#definition_of_prismatic_cohomology Definition of Prismatic Cohomology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,I)
            be a prism as defined above. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a formally smooth
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} A/I
            %em prismatic site
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mi A
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} (R/A)_{\Delta}
            has objects which are prisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi I
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B,I B)
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,I)
            together with a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mi B
                %annotation{:encoding => "application/x-tex"} R\to B/I B
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi I
                  %annotation{:encoding => "application/x-tex"} A/I
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi I
                    %mi B
                    %mo ←
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R\to B/I B\leftarrow B)
          %p
            We have functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\Delta}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi 𝒪
                      %mo ¯
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} \overline{\mathcal{O}}_{\Delta}
            which sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mi B
                  %mo ←
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (R\to B/I B\leftarrow B)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi I
                  %mi B
                %annotation{:encoding => "application/x-tex"} B/I B
            respectively. The
            %em prismatic cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is defined to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mo :
                    %mo =
                    %mi R
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi Δ
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mi Δ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta_{R/A}:=R\Gamma((R/A)_{\Delta},\mathcal{O}_{\Delta})
          %h2#comparison_theorems Comparison theorems
          %p We have the following comparison theorems relating prismatic cohomology to the crystalline and étale cohomology:
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A,(p)
              be a bounded prism and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a smooth
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi p
                    %annotation{:encoding => "application/x-tex"} A/p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϕ
                      %mi A
                      %mo *
                    %msubsup
                      %mi Δ
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mi A
                      %mo ∧
                    %mo ≅
                    %mi R
                    %msub
                      %mi Γ
                      %mi crys
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} /
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \phi_{A}^{*}\Delta_{R/A}^{\wedge}\cong R\Gamma_{crys}(R/A)
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D(A)
          %p
          .num_theorem
            %h6 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,I)
              be a perfect prism and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "-complete" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              = succeed "-algebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi I
                    %annotation{:encoding => "application/x-tex"} A/I
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n\geq 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %msub
                      %mi Γ
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} et
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} /
                        %mi A
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi d
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi n
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi ϕ
                        %mo =
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} R\Gamma_{\et}(\mathrm{Spec}(R[1/p]),\mathbb{Z}/p^{n})\cong (\Delta_{R/A}[1/d]/p^{n})^{\phi=1}
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is a generator of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
          %h2#absolute_prismatic_cohomology Absolute Prismatic Cohomology
          %p
            By forgetting the choice of base prism, one obtains the absolute prismatic cohomology. Given a p-adic formal scheme
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} {X}_{\Delta}
            is the category of all bounded prisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (B,J)
            equipped with a map
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Spf
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi J
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathrm{Spf}(B/J)\to X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\Delta}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"} I_{\Delta}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi 𝒪
                      %mo ¯
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} \overline{\mathcal{O}}_{\Delta}
            obtained by remembering
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} /
                  %mi J
                %annotation{:encoding => "application/x-tex"} B/J
            respectively.
          %p
            The absolute prismatic cohomology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi Δ
                  %mo ,
                  %msub
                    %mi 𝒪
                    %mi Δ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R\Gamma(X_{\Delta},\mathcal{O}_{\Delta})
            is equipped with a filtration called the
            = succeed "," do
              %em Nygaard filtration
            %a.existingWikiWord{:href => "/nlab/show/Hodge+filtration"} Hodge filtration
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
          %h2#prismatic_crystals Prismatic Crystals
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a p-adic formal scheme and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} X_{\Delta}
            be its absolute prismatic site as above. A
            %em prismatic crystal
            is an assignment
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo ,
                  %mi J
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi X
                    %mi Δ
                  %mo ↦
                  %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi{:mathvariant => "normal"} Vect
                    %mi B
                %annotation{:encoding => "application/x-tex"} (B,J)\in X_{\Delta}\mapsto \mathcal{E}(B)\in\mathrm{Vect}_{B}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Vect
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathrm{Vect}_{B}
            is the set of finite projective
            = succeed "-modules." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            A stacky approach to the study of prismatic crystals has been developed independently by Drinfeld (
            %a{:href => "#Drinfeld20"}> Drinfeld20
            ) and Bhatt-Lurie (
            %a{:href => "#BhattLurie22"}> BhattLurie22
            ).
          %p
            Given p-adic formal scheme
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em Cartier-Witt stack
            and denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} WCart
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathrm{WCart}_{X}
            by Bhatt-Lurie, and called the
            %em
              %a.existingWikiWord{:href => "/nlab/show/prismatization"} prismatization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi Δ
                %annotation{:encoding => "application/x-tex"} X^{\Delta}
            by Drinfeld. When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is quasi-syntomic, one can identify the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-complete" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %msub
                      %mi I
                      %mi Δ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p,I_{\Delta})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi Δ
                  %mo ,
                  %msub
                    %mi 𝒪
                    %mi Δ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_{\Delta},\mathcal{O}_{\Delta})
            with the derived
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} WCart
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathrm{WCart}_{X}
            (
            %a{:href => "#Bhatt21"}> Bhatt21
            , Remark 2.6).
          %h2#applications Applications
          %p
            Prismatic cohomology can be used to obtain the following inequality for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a proper smooth
            %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal scheme
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℂ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{C}_{p}
            (here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is the residue field of
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mrow
                        %msub
                          %mi ℂ
                          %mi p
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathbb{C}_{p}}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi dim
                    %mrow
                      %msub
                        %mi 𝔽
                        %mi p
                  %msubsup
                    %mi H
                    %mi et
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi ℂ
                        %mi p
                  %mo ,
                  %msub
                    %mi 𝔽
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %msub
                    %mi dim
                    %mi k
                  %msubsup
                    %mi H
                    %mi dR
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} dim_{\mathbb{F}_{p}}H_{et}^{i}(X_{\mathbb{C}_{p}},\mathbb{F}_{p})\leq dim_{k}H_{dR}^{i}(X_{k})
          %p
            Prismatic cohomology has also been used in
            %a{:href => "#Bhatt20"} Bhatt20
            to prove that modulo a prime power the absolute integral closure of an excellent Noetherian domain is Cohen-Macaulay. The proof also uses a p-adic version of the
            %a.existingWikiWord{:href => "/nlab/show/Riemann-Hilbert+correspondence"} Riemann-Hilbert correspondence
            being developed in yet-unpublished work of
            %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"} Bhargav Bhatt
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
          %p
            Prismatic cohomology has also been used to construct a version of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/syntomic+cohomology"} syntomic cohomology
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            whose graded pieces are described by the shifted singular cohomology complex, and is also analogous to the filtration on
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/motivic+cohomology"} motivic cohomology
            %a{:href => "#AKN22"} AKN22
            to determine the K-groups of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^{n}
          %h2#historical_precursors Historical Precursors
          %p
            Prismatic cohomology was developed by
            %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"} Bhargav Bhatt
            and
            %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"} Peter Scholze
            following earlier work on developing an integral version of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+Hodge+theory"} p-adic Hodge theory
            = succeed "-cohomology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi inf
                  %annotation{:encoding => "application/x-tex"} A_inf
            %a{:href => "#BhattMorrowScholze16"} BhattMorrowScholze16
            and integral p-adic Hodge theory via
            %a.existingWikiWord{:href => "/nlab/show/topological+Hochschild+homology"} topological Hochschild homology
            in
            = succeed "," do
              %a{:href => "#BhattMorrowScholze16"} BhattMorrowScholze16
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Matthew+Morrow"} Matthew Morrow
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/p-adic+Hodge+theory"} p-adic Hodge theory
            %li
              %a.existingWikiWord{:href => "/nlab/show/perfectoid+spaces"} perfectoid spaces
            %li
              %a.existingWikiWord{:href => "/nlab/show/topological+Hochschild+homology"} topological Hochschild homology
            %li
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+differential+geometry"} arithmetic differential geometry
            %li
              %a.existingWikiWord{:href => "/nlab/show/Borger%27s+absolute+geometry"} Borger's absolute geometry
          %h2#references References
          %p Prismatic cohomology was introduced in
          %ul
            %li#BhattScholze19
              %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"} Peter Scholze
              = succeed "," do
                %em Prisms and Prismatic Cohomology
              %a{:href => "https://arxiv.org/abs/1905.08229"} 1905.08229
          %p A survey of recent developments is given in
          %ul
            %li#Bhatt21
              %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
              ,
              = succeed "," do
                %em Algebraic Geometry in Mixed Characteristic
              %a{:href => "https://arxiv.org/abs/2112.12010"} 2112.12010
          %p Lecture notes include
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
              ,
              = succeed "," do
                %em Prismatic cohomology
              %a{:href => "http://www-personal.umich.edu/~bhattb/teaching/prismatic-columbia/"} lecture notes
          %p Lecture notes taken by Chao Li, from the same lectures (contains some material not included in the above)
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
              ,
              = succeed "," do
                %em Prismatic cohomology
              %a{:href => "http://www.math.columbia.edu/~chaoli/doc/BhattEilenberg.html"} lecture notes
          %p Some other lectures on prismatic cohomology:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kiran+Kedlaya"}> Kiran Kedlaya
                ,
                = succeed "," do
                  %em Notes on prismatic cohomology
                %a{:href => "https://kskedlaya.org/prismatic/prismatic.html"} lecture notes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Emerton"}> Matthew Emerton
                ,
                = succeed "," do
                  %em Prismatic cohomology
                = succeed "&rbrack;" do
                  %a{:href => "http://www.math.uchicago.edu/~emerton/prismatic/prismatic.html"} webpage
          %p For some introductory comments see
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Terence+Tao"}> Terence Tao
                ,
                = succeed "," do
                  %em Prismatic cohomology
                = succeed ")" do
                  %a{:href => "https://terrytao.wordpress.com/2019/03/19/prismatic-cohomology/"} blog post
            %li
              %p
                Riccardo Pengo (
                %a{:href => "https://mathoverflow.net/a/333062/447"}> MO answer
                )
          %p Recent developments include
          %ul
            %li#Drinfeld20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vladimir+Drinfeld"}> Vladimir Drinfeld
                ,
                %em Prismatization
                (2020) arXiv:
                %a{:href => "https://arxiv.org/abs/2005.04746"} 2005.04746
            %li#BhattLurie22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
                = succeed "," do
                  %em Absolute Prismatic Cohomology
                %a{:href => "https://arxiv.org/abs/2201.06120"} 2022.06120
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Jacob Lurie
                = succeed "," do
                  %em
                    The Prismatization of
                    = succeed "-adic" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                %a{:href => "https://arxiv.org/abs/2201.06124"} 2022.06124
            %li#Bhatt20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
                ,
                = succeed "," do
                  %em Cohen-Macaulayness of Absolute Integral Closures
                %a{:href => "https://arxiv.org/abs/2008.08070"} 2008.08070
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jeremy+Hahn"}> Jeremy Hahn
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Arpon+Raksit"} Arpon Raksit
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dylan+Wilson"} Dylan Wilson
                = succeed "," do
                  %em A motivic filtration on the topological cyclic homology of commutative ring spectra
                %a{:href => "https://arxiv.org/abs/2206.11208"} 2206.11208
          %p
            An application to
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            is
          %ul
            %li#AKN22
              %a.existingWikiWord{:href => "/nlab/show/Benjamin+Antieau"}> Benjamin Antieau
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Achim+Krause"} Achim Krause
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
              %em
                On the K-theory of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^{n}
                – Announcement
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2204.03420"}> arXiv:2204.03420
              \&amp;rbrack;
          %p Historical precursors of prismatic cohomology are
          %ul
            %li#BhattMorrowScholze16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthew+Morrow"} Matthew Morrow
                %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"} Peter Scholze
                %em
                  Integral
                  = succeed "-adic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1602.03148"}> arXiv:1602.03148
                \&amp;rbrack;
            %li#BhattMorrowScholze18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bhargav+Bhatt"}> Bhargav Bhatt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthew+Morrow"} Matthew Morrow
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Scholze"} Peter Scholze
                %em
                  Topological Hochschild Homology and Integral
                  = succeed "-adic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1802.03261"}> arXiv:1802.03261
                \&amp;rbrack;
        .revisedby
