          %h2#idea Idea
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            induces (in particular) two
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mo :
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_* : Sh(X) \to Sh(Y)
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^* : Sh(Y) \to Sh(X)
          %p
            between the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topoi
            of
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                is
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} left adjoint
                to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f_*
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                preserves all small
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_*
                preserves all small
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            %li
              %p
                furthermore,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                is
                %a.existingWikiWord{:href => "/nlab/show/exact+functor"} left exact
                in that it preserves finite
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
          %p
            Morever, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are
            %a.existingWikiWord{:href => "/nlab/show/sober+space"} sober
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            every pair of functors with these properties comes uniquely from a continuous map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            (see the theorem below).
          %p
            A
            %em geometric morphism
            between arbitrary
            %a.existingWikiWord{:href => "/nlab/show/topos"} topoi
            is the direct generalization of this situation.
          %p
            Another motivation of the concept comes from the fact that a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            such as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            that preserves finite
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            and arbitrary
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            (since it is a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} left adjoint
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric logic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} toposes
              %strong geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi E
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f:E\to F
              consists of a pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ,
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^*,f_*)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi E
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"}
                    f_* : E \to F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ←
                    %mi F
                    %mo :
                    %msup
                      %mi f
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E \leftarrow F : f^*
                    \\,,
            %p
              such that the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi F
                    %mo →
                    %mi E
                  %annotation{:encoding => "application/x-tex"} f^*:F \to E
              preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            %p We say that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f_*
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^*
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            %p of the geometric morphism.
          %p
            If moreover the
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            has also a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo :
                    %mi E
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f_! : E \to F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
          .num_remark
            %h6#remark Remark
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck toposes
              satisfy the (dual) hypotheses of Freyd’s special
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              between Grothendieck toposes which preserves all small
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi E
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f : E \to F
              between Grothendieck toposes could equivalently be defined as a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ←
                    %mi F
                    %mo :
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} E \leftarrow F : f^*
              preserving
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and all
              %a.existingWikiWord{:href => "/nlab/show/small+set"} small
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          .num_remark
            %h6#remark_2 Remark
            %p
              In view of its definition in terms of a pair of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              = succeed "." do
                %strong algebraic morphism
            %p
              See
              %a.existingWikiWord{:href => "/nlab/show/Isbell+duality"} Isbell duality
              for more on this
              %a.existingWikiWord{:href => "/nlab/show/duality"} duality
              between
              %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
          %p
            See also (
            %a{:href => "#Johnstone"}> Johnstone, p. 162/163
            ).
          %h2#properties Properties
          %p We discuss some general properties of geometric morphisms. The
          %ul
            %li
              %a{:href => "#RelationToHomomorphismOfLocales"} Relation to homomorphisms of locales
          %p also serves as a motivation or justification of the notion of geometric morphism. The
          %ul
            %li
              %a{:href => "#RelationToMorphismsOfSites"} Relation to homomorphisms of sites
          %p
            is a fairly straightforward generalization of that situation, reflecting the passage from (sheaf-)
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-topos"} (0,1)-topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topos"} (1,1)-toposes
          %p
            A somewhat subtle point about geometric morphisms of toposes is that there is also another sensible notion of topos
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
          %ul
            %li
              %a{:href => "#RelationToLogicalMorphisms"} Relation to logical morphism
          %p aspects of the relation between the two concepts are discussed.
          %p
            The reader wishing to learn about geometric morphisms systematically might want to first read the section on
            %em
              %a{:href => "#BetweenPresheafToposes"} Geometric morphisms between presheaf toposes
            below, as much of the following discussion makes use of a few basic facts discussed there.
          %h3#RelationToHomomorphismOfLocales Relation to homomorphisms of locales
          %p
            The definition of geometric morphisms may be motivated as being a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of the definition of morphisms of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
          %p Recall that
          #LocaleHomomorphisms.num_defn
            %h6#definition_3 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    f : X \to Y
            %p
              is dually a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/frame+of+opens"} frames of open subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi f
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}(X) \leftarrow \mathcal{O}(Y) : f^*
                    \\,.
            %p
              This, in turn, is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/posets"} posets
            %ol
              %li
                %p
                  preserves finite
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/meet"} meet
              %li
                %p
                  preserves arbitrary (small)
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/join"} join
          %p
            Such a preservation of finite limits and arbitrary colimits is precisely what characterizes the
            %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            part of a geometric morphism, and hence by the
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            already characterizes the full notion of geometric morphisms. Since a
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            may equivalently be thought of as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-topos"} (0,1)-topos
          %p The following says this in more precise fashion.
          #DirectImageInducedByLocaleMorphism.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              a homomorphism of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_* : Sh(X) \to Sh(Y)
            %p
              be the functor between their
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F : \mathcal{O}(X)^{op} \to Set
              to the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mi F
                    %mo :
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mover
                      %mo ⟶
                      %mrow
                        %msup
                          %mi f
                          %mo *
                    %mi 𝒪
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mover
                      %mo ⟶
                      %mi F
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    f_* F : \mathcal{O}(Y)^{op} \stackrel{f^*}{\longrightarrow}
                    \\mathcal{O}(X)^{op} \stackrel{F}{\longrightarrow}
                    Set
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is the corresponding frame morphism as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#LocaleHomomorphisms"}
          .num_prop
            %h6#proposition Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f_*
              in def.
              %a.maruku-ref{:href => "#DirectImageInducedByLocaleMorphism"}
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              part of a geometric morphism of sheaf toposes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mo *
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi f
                            %mo *
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f^* \dashv f_*) : Sh(X) \stackrel{\overset{f^*}{\longleftarrow}}{\underset{f_*}{\longrightarrow}}
                    Sh(Y)
                    \\,.
            %p
              Moreover, the corresponding
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              does restrict on
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
          %p
            In (
            %a{:href => "#Johnstone"}> Johnstone
            ) this appears as lemma C1.4.1 and theorem C1.4.3.
          .proof
            %h6#proof Proof
            %p
              Since a morphism of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed "." do
                %a{:href => "site#MorphismsOfSitesAndGeometricMorphisms"} Morphisms of sites and geometric morphisms
          .num_prop
            %h6#proposition_2 Proposition
            %p
              The construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \mapsto Sh(X)
              extends to a
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo :
                    %mi Locale
                    %mo ↪
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"}
                    Sh : Locale \hookrightarrow Topos
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %a.existingWikiWord{:href => "/nlab/show/Locale"} Locale
              of
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
              to the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
              of
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          %p
            See also at
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            the section
            = succeed "." do
              %a{:href => "locale#RelationToToposes"} relation to toposes
          %h3#RelationToMorphismsOfSites Relation to morphisms of sites
          %p
            See at
            %a.existingWikiWord{:href => "/nlab/show/morphism+of+sites"} morphism of sites
            the section
            = succeed "." do
              %em
                %a{:href => "morphism+of+sites#RelationToGeometricMorphisms"} Relation to geometric morphisms
          %h3#RelationToLogicalMorphisms Relation to logical morphisms
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Every geometric morphism whose
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              is a
              %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
          %p
            This is a restatement of
            %a{:href => "logical+functor#LogicalMorphismsRightAdjointToCartesianFunctors"} this proposition
            at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
          %p
            But
            %a.existingWikiWord{:href => "/nlab/show/inverse+images"} inverse images
            can be nontrivial logical morphisms:
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of an
              %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
          %p
            Generally, a geometric morphism with logical inverse image is called an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/atomic+geometric+morphism"} atomic geometric morphism
          %h3#StructurePreserved Structure preserved by geometric morphisms
          %p
            The
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            %em
              categories with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
              %a{:href => "indexed+category#WellPoweredness"} well-powered
              %a.existingWikiWord{:href => "/nlab/show/indexed+categories"} indexed categories
              with respect to the canonical indexing over themselves.
          %p
            This appears in (
            %a{:href => "#Johnstone"}> Johnstone
            ) as remark B2.2.7 based on example B1.3.17 and prop. B1.3.14. See at
            %a.existingWikiWord{:href => "/nlab/show/indexed+category"} indexed category
            the section
            = succeed "," do
              %a{:href => "indexed+category#WellPoweredness"} Well-poweredness
          %h3#surjectionembedding_factorization Surjection/embedding factorization
          %p
            Every geometric morphism factors, essentially uniquely, as a
            %a.existingWikiWord{:href => "/nlab/show/geometric+surjection"} geometric surjection
            followed by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            %em
              %a.existingWikiWord{:href => "/nlab/show/geometric+surjection%2Fembedding+factorization"} geometric surjection/embedding factorization
            for more on this.
          %h2#special_classes_of_geometric_morphisms Special classes of geometric morphisms
          %p There are various special cases and types of classes of geometric morphisms. For instance
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/global+section"} global sections
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/locally+connected+geometric+morphism"} locally connected geometric morphism
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/connected+geometric+morphism"} connected geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/open+geometric+morphism"}> open geometric morphism
                ,
                %a.existingWikiWord{:href => "/nlab/show/closed+geometric+morphism"} closed geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/proper+geometric+morphism"} proper geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+geometric+morphism"} local geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/bounded+geometric+morphism"} bounded geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/localic+geometric+morphism"} localic geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hyperconnected+geometric+morphism"} hyperconnected geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/atomic+geometric+morphism"} atomic geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dominant+geometric+morphism"} dominant geometric morphism
          %p The following subsections describe some of these in more detail.
          %h3#BetweenPresheafToposes Between presheaf toposes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be any two
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi op
                %annotation{:encoding => "application/x-tex"} D^{op}
            for their
            %a.existingWikiWord{:href => "/nlab/show/opposite+categories"} opposite categories
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C, Set]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [D, Set]
            for the corresponding
            %a.existingWikiWord{:href => "/nlab/show/presheaf+toposes"} presheaf toposes
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi op
                  %annotation{:encoding => "application/x-tex"} D^{op}
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f : C \to D
              induces an (
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"}> essential
              , even) geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mo *
                        %mover
                          %mo ⟵
                          %mrow
                            %msup
                              %mi f
                              %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mo !
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    f := (f^* \dashv f_*)
                    \:
                    [C,Set]
                    \\stackrel{\overset{f_!}{\longrightarrow}}{\stackrel{\overset{f^*}{\longleftarrow}}{\underset{f_*}{\longrightarrow}}}
                    [D, Set]
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f^* = (-) \circ f
              is the functor given by precomposition presheaves with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi f
                    %mo ⇒
                    %mi g
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} \eta : f \Rightarrow g : C \to D
              a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between two such functors there is an induced
              %a.existingWikiWord{:href => "/nlab/show/geometric+transformation"} geometric transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi f
                        %mo *
                      %mo ⊣
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ⇒
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi g
                        %mo *
                      %mo ⊣
                      %msub
                        %mi g
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f^* \dashv f_*) \Rightarrow (g^* \dashv g_*)
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
              %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Cat
                    %mo →
                    %mi Topos
                  %annotation{:encoding => "application/x-tex"}
                    [-,Set] : Cat \to Topos
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              to the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, example A4.1.4
            ).
          .proof
            %h6#proof_2 Proof
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/categories+of+presheaves"} categories of presheaves
              have all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Lan
                      %mi f
                  %annotation{:encoding => "application/x-tex"} Lan_f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ran
                      %mi f
                  %annotation{:encoding => "application/x-tex"} Ran_f
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              exists, and form with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi Ran
                              %mi f
                        %mover
                          %mo ⟵
                          %mrow
                            %msup
                              %mi f
                              %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Lan
                            %mi f
                    %mo{:stretchy => "false"} [
                    %mi D
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [C,Set]
                    \\stackrel{\overset{Lan_f}{\longrightarrow}}{\stackrel{\overset{f^*}{\longleftarrow}}{\underset{Ran_f}{\longrightarrow}}}
                    [D, Set]
                    \\,.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mo ≃
                    %msub
                      %mi Lan
                      %mi f
                  %annotation{:encoding => "application/x-tex"} f_! \simeq Lan_f
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mo ≃
                      %msub
                        %mi Ran
                        %mi f
                    %annotation{:encoding => "application/x-tex"} f_* \simeq Ran_f
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            Next we consider extra
            %a.existingWikiWord{:href => "/nlab/show/property"} property
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            induces also a second geometric morphism, going the other way round. This plays a role for the discussion of
            = succeed "." do
              %a{:href => "#RelationToMorphismsOfSites"} morphisms of sites
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            to their
            %a.existingWikiWord{:href => "/nlab/show/opposite+categories"} opposite categories
            hence consider genuine
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              be categories with
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/finite+limit"} finite limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f : C \to D
              be a finite-limit
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserving
              functor.
            %p
              Then in the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi f
                              %mo *
                        %mover
                          %mo ⟵
                          %mrow
                            %msup
                              %mi f
                              %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mo !
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (f_! \dashv f^* \dashv f_*)
                    \:
                    [C^{op},Set]
                    \\stackrel{\overset{f_!}{\longrightarrow}}{\stackrel{\overset{f^*}{\longleftarrow}}{\underset{f_*}{\longrightarrow}}}
                    [D^{op}, Set]
            %p
              the left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              also preserves finite limits and hence in this case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              is also the
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              of a geometric morphism going the other way round:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi D
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_! \dashv f^* ) : [D^{op},Set] \to [C^{op}, Set]
                    \\,.
          %p
            This appears as (
            %a{:href => "#Johnstone"}> Johnstone, example A4.1.10
            ).
          .proof
            %h6#proof_3 Proof
            %p
              Recall that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F : C^{op} \to Set
              a functor, the left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                    %mi F
                    %mo :
                    %msup
                      %mi D
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} f_! F : D^{op} \to Set
              is computed over each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} d \in D
              by the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mi lim
                      %mo →
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} /
                      %mi f
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mover
                        %mo →
                        %mi U
                      %msup
                        %mi C
                        %mi op
                      %mover
                        %mo →
                        %mi F
                      %mi Set
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (f_! F)(d) =
                    \\lim_\to
                    \\left(
                    (d/f)^{op} \stackrel{U}{\to} C^{op} \stackrel{F}{\to} Set
                    \\right)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} /
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d/f)
              is the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} /
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    U : (d/f) \to C
            %p
              is the evident forgetful functor. This is natural in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_! -)(d)
              is the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msup
                          %mi U
                          %mo *
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} /
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (f_! -)(d) : [C^{op}, Set] \stackrel{U^*}{\to}
                    [(d/f)^{op}, Set]
                    \\stackrel{\lim_\to}{\to}
                    Set
                    \\,.
            %p
              By the above argument
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi U
                      %mo *
                  %annotation{:encoding => "application/x-tex"} U^*
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              (the left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              along
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %p
              It then suffices to observe (see below) that by the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              preserves finite limits we have that the categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} /
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (d/f)^{op}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/filtered+categories"} filtered categories
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mo →
                  %annotation{:encoding => "application/x-tex"} \lim_\to
              preserves finite limits, and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f_! -)(d)
              does. Since colimits of presheaves are computed objectwise, this shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              preserves finite limits. This completes the proof.
            %p
              Here is an explicit desciption of the filteredness of the
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} /
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (d/f)^{op}
              for any object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              We check the axioms on a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered category
            %ul
              %li
                %p
                  %em non-emptiness
                  \: There is an object in
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} /
                          %mi f
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi op
                        %annotation{:encoding => "application/x-tex"} (d/f)^{op}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  by assumption preserves the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo →
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo *
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (d \to f(*) = *)
              %li
                %p
                  %em connectedness
                  \: for any two objects
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi h
                              %mn 1
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (d \stackrel{h_1}{\to} f(c_1))
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi h
                              %mn 2
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (d \stackrel{h_2}{\to} f(c_2))
                  form the
                  %a.existingWikiWord{:href => "/nlab/show/product"} product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 1
                        %mo ×
                        %msub
                          %mi c
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} c_1 \times c_2
                  and use that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  preserves this to produce the object
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mover
                            %mo →
                            %mrow
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi h
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi f
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi h
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi c
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi c
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi c
                            %mn 1
                          %mo ×
                          %msub
                            %mi c
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (d \stackrel{f(h_1), f(h_2)}{\to} f(c_1) \times f(c_2) \simeq f(c_1 \times c_2))
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  of the two projections provides the required
                  %a.existingWikiWord{:href => "/nlab/show/span"} span
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi d
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mi f
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi h
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                                %mo ↙
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi h
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                                    %mo ,
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi h
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi f
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi h
                                        %mn 2
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 1
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo ←
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi p
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 1
                                %mo ×
                                %msub
                                  %mi c
                                  %mn 2
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi p
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                              %mtd
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 2
                                %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; d
                        \\\
                        \&amp; {}^{\mathllap{f(h_1)}}\swarrow &amp; \downarrow^{(f(h_1),f(h_2))} &amp; \searrow^{\mathrlap{f(h_2)}}
                        \\\
                        f(c_1) &amp;\stackrel{f(p_1)}{\leftarrow}&amp;
                        f(c_1 \times c_2)
                        \&amp;
                        \\stackrel{f(p_2)}{\to}
                        \&amp; f(c_2)
                        }
                        \\,.
              %li
                %p finally, for
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi d
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 1
                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mover
                                  %munder
                                    %mo →
                                    %mrow
                                      %msub
                                        %mi h
                                        %mn 2
                                  %mover
                                    %mo →
                                    %mrow
                                      %msub
                                        %mi h
                                        %mn 1
                              %mtd
                              %mtd
                                %mi f
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi c
                                  %mn 2
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; d
                        \\\
                        \&amp; \swarrow &amp;&amp; \searrow
                        \\\
                        f(c_1) &amp;&amp; \stackrel{\overset{h_1}{\to}}{\underset{h_2}{\to}}&amp; &amp; f(c_2)
                        }
                %p
                  two
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/parallel+morphism"} parallel morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi eq
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi h
                          %mn 1
                        %mo ,
                        %msub
                          %mi h
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} eq(h_1,h_2)
                  be the
                  %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
                  of the underlying morphism in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  preserves equalizers we have an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo →
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi eq
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi h
                          %mn 1
                        %mo ,
                        %msub
                          %mi h
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (d \to f(eq(h_1,h_2)))
                  and a morphism to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo →
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (d \to f(c_1))
                  that equalizes the above two morphisms.
          %h3#surjections_and_embeddings Surjections and embeddings
          %p
            A geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi E
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} f : E \to F
            is a
            %strong surjection
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
            %strong
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} embedding
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f_*
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful
          .un_prop
            %h6#proposition_7 Proposition
            %p
              Up to equivalence, every
              %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} embedding
              of toposes is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Sh_j(E) \to E
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_j(E)
              is the topos of
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
              with respect to a
              %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi Ω
                    %mo →
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} j : \Omega \to \Omega
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          %p
            This means in particular that fully faithful geometric morphisms into
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topoi
            are an equivalent way of encoding a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
          .un_prop
            %h6#proposition_8 Proposition
            %p Up to equivalence, every surjection of topoi is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %msub
                      %mi E
                      %mi G
                  %annotation{:encoding => "application/x-tex"} E \to E_G
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi G
                  %annotation{:encoding => "application/x-tex"} E_G
              is the category of coalgebras for a finite-limit-preserving
              %a.existingWikiWord{:href => "/nlab/show/comonad"} comonad
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          %p
            Every geometric morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi E
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} f:E\to F
            factors, uniquely up to equivalence, as a surjection followed by an embedding. There are two ways to produce this factorization: either construct
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi G
                %annotation{:encoding => "application/x-tex"} E_G
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %msup
                    %mi f
                    %mo *
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} G= f^*f_*
            is the comonad induced by the adjunction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*\dashv f_*
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mi j
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_j(F)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            is the smallest Lawvere-Tierney topology on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            factors through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_j(F)
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
            on the 2-category of topoi.
          %h3#global_sections_and_constant_sheaves Global sections and constant sheaves
          %p
            For every
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi E
                  %mover
                    %mo →
                    %mo ←
                  %mi Set
                  %mo :
                  %mi const
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma \;\colon\; E  \stackrel{\leftarrow}{\to} Set : const
          %p
            called the
            %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
            functor or
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/terminal+geometric+morphism"} terminal geometric morphism
            %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
            out of the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma(-) = Hom_E({*}, -)
          %p
            and hence assigns to each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ∈
                  %mi E
                %annotation{:encoding => "application/x-tex"} A\in E
            its set of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(A) = Hom_E(*,A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(A)
            is the set of
            = succeed "." do
              %strong global sections
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi const
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Set
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} const \;\colon\; Set \to E
            of the global section functor is the canonical
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
            functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Set
                  %mo ×
                  %mi E
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  \\otimes \;\colon\; Set \times E \to E
          %p
            applied to the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi const
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo *
                  %mo :
                  %mi Set
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  const = (-)\otimes {*} : Set \to E
          %p
            which sends a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to the
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi S
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |S|
            copies of the terminal object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊗
                  %mo *
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi s
                      %mo ∈
                      %mi S
                  %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S \otimes {*} = \coprod_{s \in S} {*}
                  \\,.
          %p
            This is called the
            %strong constant object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            on the set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} sheaf topos
            this is the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/constant+sheaf"} constant sheaf
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            The
            = succeed "ness" do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi const
                  %mi S
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ⊗
                  %mo *
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mi Set
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %msub
                    %mi Hom
                    %mi E
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_E(const S, A) \simeq Hom_E(S \otimes {*},A)
                  \\simeq
                  Hom_{Set}(S, Hom_E(*,A))
                  \\,.
          %p
            This left adjoint preserves
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/commutativity+of+limits+and+colimits"} commutativity of limits and colimits
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi s
                          %mn 1
                        %mo ∈
                        %msub
                          %mi S
                          %mn 1
                    %mo *
                    %mo )
                  %mo ×
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi s
                          %mn 2
                        %mo ∈
                        %msub
                          %mi S
                          %mn 2
                    %mo *
                    %mo )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %msub
                        %mi s
                        %mn 1
                      %mo ∈
                      %msub
                        %mi S
                        %mn 1
                  %mrow
                    %mo (
                    %mo *
                    %mo ×
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi s
                            %mn 2
                          %mo ∈
                          %msub
                            %mi S
                            %mn 2
                      %mo *
                      %mo )
                    %mo )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %msub
                        %mi s
                        %mn 1
                      %mo ∈
                      %msub
                        %mi S
                        %mn 1
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msub
                          %mi s
                          %mn 2
                        %mo ∈
                        %msub
                          %mi S
                          %mn 2
                    %mo *
                    %mo )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %msub
                        %mi s
                        %mn 1
                      %mo ∈
                      %msub
                        %mi S
                        %mn 1
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %msub
                        %mi s
                        %mn 2
                      %mo ∈
                      %msub
                        %mi S
                        %mn 2
                  %mo *
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi s
                      %mo ∈
                      %msub
                        %mi S
                        %mn 1
                      %mo ×
                      %msub
                        %mi S
                        %mn 2
                  %mo *
                %annotation{:encoding => "application/x-tex"}
                  \\left( \coprod_{s_1 \in S_1} *\right)
                  \\times
                  \\left( \coprod_{s_2 \in S_2} *\right)
                  \=
                  \\coprod_{s_1 \in S_1}  \left(* \times \left( \coprod_{s_2 \in S_2} *\right)\right)
                  \=
                  \\coprod_{s_1 \in S_1}  \left( \coprod_{s_2 \in S_2} *\right)
                  \=
                  \\coprod_{s_1 \in S_1} \coprod_{s_2 \in S_2} *
                  \=
                  \\coprod_{s \in S_1 \times S_2} *
          %p
            and it preserves
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
          %h3#point_of_a_topos Point of a topos
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            a topos, a geometric morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi Set
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"}
                  x : Set \to E
          %p
            is called a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} point of a topos
          %h3#changeofbase Change-of-base
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            any
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo :
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} k : B \to A
            any morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            there is the
            %a.existingWikiWord{:href => "/nlab/show/base+change"} change-of-base
            functor of
            %a.existingWikiWord{:href => "/nlab/show/over+category"} over categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mo *
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  k^* : (E/A) \to (E/B)
          %p
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            this functor has both a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi k
                  %mo :
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi B
                  %mo →
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi A
                %annotation{:encoding => "application/x-tex"} \coprod_k : E/B \to E/A
            as well as a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi k
                    %mo :
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi B
                    %mo →
                    %mi E
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \prod_k : E/B \to E/A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Π
                    %mi k
                  %mo ,
                  %msup
                    %mi k
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi B
                  %mo ↔
                  %mi E
                  %mo{:stretchy => "false"} /
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  (\Pi_k, k^*) : E/B \leftrightarrow E/B
          %p
            is a geometric morphism. Hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mi k
                  %mo ⊣
                  %msup
                    %mi k
                    %mo *
                  %mo ⊣
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\coprod_k \dashv k^* \dashv \prod_k)
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
          %h3#sheafification Sheafification
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            is a
            %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
            into a presheaf topos
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sh(C) \hookrightarrow PSh(C)
                  \\,.
          %h3#sheaftopoi Geometric morphisms of sheaf topoi
          %p
            Geometric morphisms between
            %a.existingWikiWord{:href => "/nlab/show/localic+topoi"} localic topoi
            are equivalent to
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            if you restrict to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sober+spaces"} sober spaces
          %p
            Unrolling this: For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(X) := Sh(Op(X))
            as usual for the
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            given by the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            on the
            %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Op
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Op(X)
            with the standard
            %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
          .un_lemma
            %h6#lemma Lemma
            %p
              For every continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              of
              %a.existingWikiWord{:href => "/nlab/show/sober+space"} sober
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              with the induced
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^{-1} : Op(Y) \to Op(X)
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo *
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f_* : Sh(X) \to Sh(Y)
            %p
              and the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f^* : Sh(Y) \to Sh(X)
            %p constitute a geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    f : Sh(X) \to Sh(Y)
            %p (denoted by the same symbol, by convenient abuse of notation).
            %p
              This map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi GeomMor
                    %mo{:stretchy => "false"} (
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{Top}(X,Y) \to GeomMor(Sh(X),Sh(Y))
              is an bijection of sets.
          .proof
            %h6#proof_4 Proof
            %p
              That the induced pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mo ,
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^*, f_*)
              forms a geometric morphism is (or should eventually be) discussed at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
            %p
              We now show that every geometric morphism of sheaf toposes arises this way from a continuous function, at least up to isomorphism. (In fact, more is true: the category of geometric morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(X)\to Sh(Y)
              is equivalent to the poset of continuous functons
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              with the
              %a.existingWikiWord{:href => "/nlab/show/specialization+ordering"} specialization ordering
              (
              %a.existingWikiWord{:href => "/nlab/show/Elephant"}> Elephant
              , Proposition C.1.4.5.). We follow
              = succeed "." do
                %a{:href => "#MacLaneMoerdijk"} MacLane-Moerdijk, page 348
            %p
              One reconstructs the continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              from a geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f : Sh(X) \to Sh(Y)
              as follows.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo =
                    %mi Y
                    %mo ∈
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} {*} = Y \in Sh(Y)
              for the sheaf on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Op(Y)
              constant on the singleton set, the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(Y)
            %p
              Notice that since the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              preserves finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi Y
                    %mo ↪
                    %mo *
                  %annotation{:encoding => "application/x-tex"} U_Y \hookrightarrow {*}
              is taken by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              to a subobject
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi X
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U_X \hookrightarrow X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              to the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                            %mo =
                            %mi Y
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                            %mo =
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi Ω
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_Y &amp;\to&amp; {*} = Y
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    {*} = Y &amp;\to&amp; \Omega
                    }
            %p
              that characterizes the subobject
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} U_Y
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %p
              But, as the notation already suggests, the subobjects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X,Y
              are just the open sets, i.e. the representable sheaves.
            %p
              This yields a
              %em function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi Op
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^* : Obj(Op(Y)) \to Obj(Op(X))
              from open subsets to open subsets. By assumption, this preserves finite limits and arbitrary colimits, i.e. finite intersections and arbitrary unions of open sets. In other words, it is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\to Y
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/locales"} locales
            %p
              We can now use this to define a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \bar f : X \to Y
              of the sets underlying the topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              by setting
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo ⇔
                    %mo ∀
                    %mi V
                    %mo ∋
                    %mi y
                    %mo :
                    %mi x
                    %mo ∈
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\bar f(x) = y)
                    \\Leftrightarrow
                    \\forall V \ni y: x \in f^*(V)
                    \\,.
            %p
              This yields a well defined function for the following reasons (which for the moment we spell out in the case where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
              = succeed "\u2014" do
                %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructively
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is sober):
            %ul
              %li
                %p
                  there is at most one
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                  satisfying this equation: if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi y
                          %mn 1
                        %mo ≠
                        %msub
                          %mi y
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} y_1 \neq y_2
                  both satisfy it, there are, by assumption of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                  being
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 1
                        %mo ∋
                        %msub
                          %mi y
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} V_1 \ni y_1
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mn 2
                        %mo ∋
                        %msub
                          %mi y
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} V_2 \ni y_2
                  such that (using that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f^*
                  preserves limits hence intersections)
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi V
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %msup
                            %mi f
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi V
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %msup
                            %mi f
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi V
                            %mn 1
                          %mo ∩
                          %msub
                            %mi V
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} f^*(V_1) \cap f^*(V_2) = f^*(V_1 \cap V_2) = \emptyset
              %li
                %p
                  there is at least one
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                  satisfying this equation: again by contradiction: if there were none then every
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} y \in Y
                  has a neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi y
                      %annotation{:encoding => "application/x-tex"} V_y
                  with
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ¬
                          %mo ∈
                          %msup
                            %mi f
                            %mo *
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi V
                            %mi y
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} x \not\in f^*(V_y)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ¬
                        %mo ∈
                        %msub
                          %mo ∪
                          %mrow
                            %mi y
                            %mo ∈
                            %mi Y
                        %msup
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi V
                          %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo ∪
                          %mi y
                        %msub
                          %mi V
                          %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \not\in \cup_{y \in Y} f^*(V_y) = f^*(\cup_y V_y) = f^*(Y) = X
                  again a contradiction.
            .query
              %p
                Am I right that what we are really need of our space here is not necessarily that it be Hausdorff but simply that it be
                = succeed "?" do
                  %a.existingWikiWord{:href => "/nlab/show/sober+space"} sober
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike Shulman
                \: Yes, that’s exactly right. All the complication defining
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ¯
                    %annotation{:encoding => "application/x-tex"} \bar f
                above is just an unrolled way of saying that geometric morphisms between
                %a.existingWikiWord{:href => "/nlab/show/locale"} localic
                topoi are equivalent to continuous maps of locales, which are equivalent to continuous functions if you have sober spaces. I think that should be clarified.
              %p
                %em> Toby
                \: OK, I added a paragraph at the beginning of the example to clarify this. I still need to rewrite the argument immediately above to apply to sober spaces. (Everything else seems to go through exactly the same.)
            %p
              So our function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \bar f : X \to Y
              is well defined and satisfies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ¯
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \bar f^{-1}(U_Y) = f^*(U_Y)
              for every open set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi Y
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U_Y \in Obj(Op(Y))
            %p
              It remains to check that this map reproduces the geometric morphism that we started with. For that we compute its
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              on any sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Sh(X)
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ¯
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo :
                            %msub
                              %mi U
                              %mi Y
                          %mtd
                            %mo ↦
                            %mi A
                            %mo{:stretchy => "false"} (
                            %msup
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ¯
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mrow
                                %mi Sh
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msup
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ¯
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi Y
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi Hom
                              %mrow
                                %mi Sh
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi f
                              %mo *
                            %mi V
                            %mo ,
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mrow
                                %mi Sh
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ,
                            %msub
                              %mi f
                              %mo *
                            %mi E
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi f
                              %mo *
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi U
                              %mi Y
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\bar f_*(A) : U_Y &amp;\mapsto A(\bar f^{-1}(U_Y))
                    \\\
                    \&amp; \simeq Hom_{Sh(X)}(\bar f^{-1}(U_Y),A)
                    \\\
                    \&amp; = Hom_{Sh(X)}(f^* V, E)
                    \\\
                    \&amp; \simeq Hom_{Sh(X)}(V, f_* E)
                    \\\
                    \&amp; \simeq (f_* A)(U_Y)
                    \\end{aligned}
          .num_cor
            %h6#corollary Corollary
            %p
              The points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              of the topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              are in canonical bijection with the points of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(X)
              in the sense of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} point of a topos
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%C3%A9tale+map"} étale map
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/logical+morphism"} logical morphism
            %li
              %p
                %strong geometric morphism
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/geometric+logic"}> geometric logic
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/geometric+theory"} geometric theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/natural+homotopy"} natural homotopy
          %h2#references References
          %p Geometric morphisms are the topic of section VII of
          %ul#MacLaneMoerdijk
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"} Saunders MacLane
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
              \.
          %p Embeddings and surjections are discussed in section VII.4.
          %p Geometric morphisms are defined in section A4 of
          %ul#Johnstone
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sketches+of+an+Elephant"} Sketches of an Elephant
          %p The special classes of geometric morphisms are discussed in section C3.
        .revisedby
