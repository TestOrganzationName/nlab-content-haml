                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(n)
            on the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/decidable+proposition"} decidable
            %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(n)
            on the
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(n)
            holds, then one can construct a
            %a.existingWikiWord{:href => "/nlab/show/minimum"} minimal
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi min
                    %mi P
                %annotation{:encoding => "application/x-tex"} \min_P
            such that the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi min
                    %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\min_P)
            holds. See
            %a{:href => "#Rijke22"} Rijke 2022
            for a proof of this in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo{:stretchy => "false"} |
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{n \in \mathbb{N} \vert P(n)\}
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo :
                      %mi ℕ
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{n:\mathbb{N}} P(n)
            and the existential quantifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi n
                  %mo :
                  %mi ℕ
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \exists n:\mathbb{N}.P(n)
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of the dependent sum type.
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/pointed+set"} pointed set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \mathrm{pt})
            has a choice operator, since its
            %a.existingWikiWord{:href => "/nlab/show/support+of+a+set"} support
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X]
            is a
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            and thus in bijection with the canonical singleton
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %mi ∅
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}(\emptyset)
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are thus in bijection with functions from its support to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            itself:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi X
                  %mo ≅
                  %msup
                    %mi X
                    %mrow
                      %mi 𝒫
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} i:X \cong X^{\mathcal{P}(\emptyset)} \cong X^{[X]}
          %p
            Thus the choice operator can simply be defined as the evaluation of the
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            at the given point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} pt
                %annotation{:encoding => "application/x-tex"} \mathrm{pt}
            of the set,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϵ
                    %mi X
                  %mo ≔
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \epsilon_X \coloneqq i(\mathrm{pt})
          %p
            This makes sense, since if the pointed set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is already a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of another set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi X
                %annotation{:encoding => "application/x-tex"} P_X
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            representing the subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            holds - the given point of the pointed set; i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mi X
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} pt
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P_X(\mathrm{pt})
            always holds.
          %p
            Constructively, the empty set is always not pointed because the function set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ∅
                    %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset^\emptyset
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo +
                    %msup
                      %mi X
                      %mi ∅
                  %annotation{:encoding => "application/x-tex"} X + X^\emptyset
          %h2#foundational_status Foundational status
          %p
            It should be noted that Hilbert and Bourbaki take the
            = succeed "-operator," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                  %annotation{:encoding => "application/x-tex"} \varepsilon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            in “Theory of Sets” to be a primitive symbol in a mathematical theory. This has the advantage of also allowing the existential and universal
            %a.existingWikiWord{:href => "/nlab/show/quantifiers"} quantifiers
            to be constructed explicitly, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi x
                %annotation{:encoding => "application/x-tex"} \exists x
            translates to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ε
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(\varepsilon_x(P(x)))
            = succeed "-extensionality," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                  %annotation{:encoding => "application/x-tex"} \varepsilon
            %strong axiom scheme of existence
            is a statement of Hilbert’s axiom that avoids mention of the existential quantifier.
          %p
            A wonderful usage of the global choice operator in Bourbaki is that we can easily show that paradoxical sets do not exist, since the definition of a set is given in terms of whether or not the relation defining the set is collectivizing. The example of
            %a.existingWikiWord{:href => "/nlab/show/Russell%27s+paradox"} Russell's paradox
            is computed in (Theory of Sets, Chapter II, §1, no.4). A consequence of this formulation is that the epsilon calculus is quantifier-free, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            subsumes their roles from the predicate calculus. If we adjoin
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                %annotation{:encoding => "application/x-tex"} \varepsilon
            to intuitionistic logic with the axiom scheme of existence, we obtain a non-conservative extension of intuitionistic logic in which the law of excluded middle still does not hold. However, the assumption of the axiom scheme of
            = succeed "-extensionality" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                  %annotation{:encoding => "application/x-tex"} \varepsilon
          %p
            One use of the choice operator is to eliminate undesirable details of implementation. For example, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(x)
            is “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is a Dedekind-complete totally ordered field,” then we can define “the real numbers” to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mi x
                    %mo .
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varepsilon x.P(x)
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            can then be used to show that there exists an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mo =
                    %mi ε
                    %mi x
                    %mo .
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}=\varepsilon x.P(x)
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %em are
            Dedekind cuts, or equivalence classes of Cauchy sequences, or anything in particular, since the axioms provide no rules about how
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mi x
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varepsilon x.P(x)
            must be chosen other than that it must satisfy
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %em might
            consist of Cauchy sequences, or Dedekind cuts, or any other way to construct the reals, but we have no way of knowing, and thus we cannot make use of any such definition in a proof about
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            = succeed ")." do
              %a{:href => "generalized+the#formalization"} generalized the
          %p
            In many cases, the assumption of a global choice operator implies the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi A
                    %mi u
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A_u)
            of inhabited sets, a choice function is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi ε
                    %mi x
                    %mo .
                    %mi x
                    %mo ∈
                    %msub
                      %mi A
                      %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u\mapsto (\varepsilon x.x\in A_u)
            %em global
            axiom of choice, which applies to proper classes as well as sets.
          %blockquote
            %p
              “Here, moreover, we come upon a very remarkable circumstance, namely, that all of these transfinite axioms are derivable from a single axiom, one that also contains the core of one of the most attacked axioms in the literature of mathematics, namely, the axiom of choice:
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi ε
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(a) \rightarrow A(\varepsilon(A))
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                  %annotation{:encoding => "application/x-tex"} \varepsilon
              is the transfinite logical choice function.”
            %p
              —Hilbert (1925), “On the Infinite”, excerpted in Jean van Heijenoort,
              = succeed "," do
                %em From Frege to Gödel
          %p
            However, in some
            %a.existingWikiWord{:href => "/nlab/show/foundations"} foundations
            it seems to be possible to avoid this conclusion (if it is unwanted) by not requiring the choice operator to be extensional, i.e. it may not be the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mi B
                %annotation{:encoding => "application/x-tex"} A = B
            implies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mi x
                    %mo .
                    %mi A
                    %mo =
                    %mi ε
                    %mi x
                    %mo .
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \varepsilon x.A = \varepsilon x.B
          %p
            Like the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            %a.existingWikiWord{:href => "/nlab/show/constructible+universe"} constructible universe
            (which models
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ZF
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo =
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ZF + (V=L)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+constructibility"} axiom of constructibility
            %a.existingWikiWord{:href => "/nlab/show/well-ordering"} well-ordering
            of the entire universe, giving rise to a naturally defined global choice operator (namely,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mi x
                  %mo .
                  %mi P
                %annotation{:encoding => "application/x-tex"} \varepsilon x.P
            \= the smallest
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            in the global well-ordering).
          %p
            On the other hand, in
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            a global choice operator over the entire type theory is inconsistent with a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/univalent+universe"} univalent universe
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            must be natural with respect to equivalences, which no global choice operator can be. If one only has a global choice operator over only the types in a given type universe, one can still prove the
            %a.existingWikiWord{:href => "/nlab/show/limited+principle+of+omniscience"} limited principle of omniscience
            for
            %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} LPO
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathrm{LPO}_\mathbb{N}
            for the entire type theory: a global choice operator for a universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            implies that the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
            and
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            holds in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            is the homotopy-
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sigma-frame"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \sigma
                \-frame
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} LPO
                      %mi ℕ
