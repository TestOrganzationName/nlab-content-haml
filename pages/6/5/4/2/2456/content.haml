                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi ε
                    %mi X
                  %mi x
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \exists x \in \mathrm{Hom}_\mathcal{E}(1, X).P(x) \;\Rightarrow\; P\big(\varepsilon_X x.P(x)\big).
          %p
            This is sometimes used in
            %a.existingWikiWord{:href => "/nlab/show/categorical+set+theories"} categorical set theories
            like
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ETCS+plus+epsilon"} ETCS plus epsilon
          %h4#internal_choice_operator Internal choice operator
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \in C
            %a.existingWikiWord{:href => "/nlab/show/support+object"} support object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} [X] \in C
            %a.existingWikiWord{:href => "/nlab/show/image"} image
            of the
            %a.existingWikiWord{:href => "/nlab/show/unique"} unique
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} X \to 1
            into the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} 1 \in C
          %p
            An
            %strong internal (global) choice operator
            consists of, for every object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi X
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \varepsilon_X:[X] \to X
            from the support object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the original object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Hilbert’s original formulation of the choice operator translates over to the
            %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            into the statement that for every object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and subobject
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \hookrightarrow X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi P
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi P
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} \varepsilon_P:[P] \to P
            from the
            %a.existingWikiWord{:href => "/nlab/show/support+object"} support object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            itself. This implies the formulation above since the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is always a
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            of itself; conversely, if there is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi X
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \varepsilon_X:[X] \to X
            for every object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \in C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi P
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi P
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} \varepsilon_P:[P] \to P
            for subobjects
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P \hookrightarrow X
          %h3#in_allegory_theory In allegory theory
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/bicategory+of+relations"} bicategory of relations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unitary+tabular+allegory"} unitary tabular allegory
            %a.existingWikiWord{:href => "/nlab/show/category+of+maps"} category of maps
            of a unitary tabular allegory is a regular category. Similarly, given a
            %a.existingWikiWord{:href => "/nlab/show/Heyting+category"} Heyting category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/bicategory+of+relations"} bicategory of relations
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/division+allegory"} division allegory
            %a.existingWikiWord{:href => "/nlab/show/category+of+maps"} category of maps
            of a division allegory is a Heyting category. This implies that internal global choice operators can be defined in any unitary tabular allegory and external global choice operators can be defined in any (well-pointed)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/division+allegory"} division allegory
          %p
            This is sometimes used in
            %a.existingWikiWord{:href => "/nlab/show/allegorical+set+theories"} allegorical set theories
            like
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/SEAR+plus+epsilon"} SEAR plus epsilon
          %h4#external_choice_operator_2 External choice operator
          %p
            Recall that a
            %a.existingWikiWord{:href => "/nlab/show/map"} map
            in an
            %a.existingWikiWord{:href => "/nlab/show/allegory"} allegory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is a morphism with a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %a.existingWikiWord{:href => "/nlab/show/injective+morphism+in+a+dagger+2-poset"} injective map
            between objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} Y \in \mathcal{E}
            is a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msub
                    %mi{:mathvariant => "normal"} Map
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in \mathrm{Map}_\mathcal{E}(X, Y)
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo †
                    %mo ∘
                    %mi f
                    %mo ≤
                    %msub
                      %mi{:mathvariant => "normal"} id
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f^\dagger \circ f \leq \mathrm{id}_X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} Y \in \mathcal{E}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Map
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Map}_\mathcal{E}(X, Y) \subseteq \mathrm{Hom}_\mathcal{E}(X, Y)
          %p
            denote the hom-subset of maps between objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/division+allegory"} division allegory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            is
            %em
              %a.existingWikiWord{:href => "/nlab/show/well-pointed"} well-pointed
            if
          %ul
            %li
              %p
                The allegorical unit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                is not a
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
            %li
              %p
                for any objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ∈
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} Y \in \mathcal{E}
                and injective maps
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %msub
                          %mi{:mathvariant => "normal"} Map
                          %mi ℰ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in \mathrm{Map}_\mathcal{E}(X, Y)
                %a.existingWikiWord{:href => "/nlab/show/maps"} maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %msub
                        %mi{:mathvariant => "normal"} Map
                        %mi ℰ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y \in \mathrm{Map}_\mathcal{E}(1, Y)
                from the allegorical unit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} 1 \in \mathcal{E}
                to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi{:mathvariant => "normal"} Map
                        %mi ℰ
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in \mathrm{Map}_\mathcal{E}(1, X)
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∘
                        %mi x
                        %mo =
                        %mi y
                      %annotation{:encoding => "application/x-tex"} f \circ x = y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/unitary+isomorphism"} unitary isomorphism
          %p
            Then Hilbert’s formulation of the
            %strong external (global) choice operator
            is rendered as the following: for any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
            and any property
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(x)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Map
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Map}_\mathcal{E}(1, X)
            we can form a
            %a.existingWikiWord{:href => "/nlab/show/map"} map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi X
                  %mi x
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi{:mathvariant => "normal"} Map
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varepsilon_X x.P(x) \in \mathrm{Map}_\mathcal{E}(1, X)
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi x
                  %mo ∈
                  %msub
                    %mi{:mathvariant => "normal"} Map
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %mi P
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi ε
                    %mi X
                  %mi x
                  %mo .
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \exists x \in \mathrm{Map}_\mathcal{E}(1, X).P(x) \;\Rightarrow\; P\big(\varepsilon_X x.P(x)\big).
          %h4#internal_choice_operator_2 Internal choice operator
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/support+object"} support object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X]
            of an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in a
            %a.existingWikiWord{:href => "/nlab/show/unitary+tabular+allegory"} unitary tabular allegory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the
            %span.newWikiWord
              tabulation
              %a{:href => "/nlab/new/tabulation"} ?
            of the
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+quantifier"} unique
            %a.existingWikiWord{:href => "/nlab/show/map"} map
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into the
            %span.newWikiWord
              allegorical unit
              %a{:href => "/nlab/new/allegorical+unit"} ?
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p
            An
            %strong internal (global) choice operator
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            consists of, for every object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/map"} map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi X
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Map
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \varepsilon_X:\mathrm{Map}_C([X], X)
            from the support object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the original object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In dependent type theory with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/propositional+truncations"} propositional truncations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} ]
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, x:[A] \vdash \varepsilon_A(x):A}
          %p
            The above rule could be simplified to the following rule using
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \varepsilon_A:[A] \to A}
          %p This corresponds to the internal global choice operator in category theory, since the logic is only internal logic in dependent type theory; there is no separate external logic.
          %p
            One can also use a Hilbert-style global choice operator which says that choice operators exist for
            %a.existingWikiWord{:href => "/nlab/show/dependent+sum+types"} dependent sum types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mi x
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ∃
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi x
                          %mo :
                          %mi A
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A \vdash B(x) \; \mathrm{type}}{\Gamma \vdash \varepsilon_A x.B(x):\exists x:A.B(x) \to \sum_{x:A} B(x)}
          %p
            where the
            %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantifier
            is defined as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∃
                  %mi x
                  %mo :
                  %mi A
                  %mo .
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mrow
                    %mo [
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ]
                %annotation{:encoding => "application/x-tex"} \exists x:A.B(x) \coloneqq \left[\sum_{x:A} B(x)\right]
          %p
            The Hilbert-style global choice operator implies the other version of the global choice operator, because given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} \sum_{x:A} \sum_{y:A} x =_A y
            is
            %a.existingWikiWord{:href => "/nlab/show/definitionally+isomorphic"} definitionally isomorphic
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#properties Properties
          %h3#relation_to_set_truncation_axioms Relation to set truncation axioms
          %p
            This rule is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+set+truncation"} axiom of set truncation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} y:A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mrow
                        %mi x
                        %msub
                          %mo =
                          %mi A
                        %mi y
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                  %annotation{:encoding => "application/x-tex"} \varepsilon_{x =_A y}:[x =_A y] \to x =_A y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [x =_A y]
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [x =_A y]
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo =
                    %mi A
                  %mi y
                %annotation{:encoding => "application/x-tex"} x =_A y
            implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
          %p
            One could try to set-truncate the target, or restrict the global choice operator to inhabited
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} ]
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi p
                      %mo :
                      %mi{:mathvariant => "normal"} isSet
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi x
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi A
                      %mo{:stretchy => "false"} ]
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, x:[A] \vdash \varepsilon_A(x):[A]_0} \qquad \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, p:\mathrm{isSet}(A), x:[A] \vdash \varepsilon_A(p, x):A}
          %p
            However, this inference rule implies the untruncated
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ⊢
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mi A
                      %mo ,
                      %mi y
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ⊢
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} ac
                        %mrow
                          %mi A
                          %mo ,
                          %mi B
                          %mo ,
                          %mi P
                      %mo :
                      %mi Π
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mo ∃
                      %mi y
                      %mo :
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mo{:stretchy => "false"} [
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo ∃
                      %mi g
                      %mo :
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo .
                      %mi Π
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mo{:stretchy => "false"} [
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type} \quad \Gamma, x:A \vdash B(x) \; \mathrm{type} \quad \Gamma, x:A, y:B(x) \vdash P(x, y) \; \mathrm{type}}{\Gamma \vdash \mathrm{ac}_{A, B, P}:\Pi x:A.\exists y:B(x).[P(x, y)] \to \exists g:(\Pi x:A.B(x)).\Pi x:A.[P(x, g(x))]}
          %p
            which is inconsistent with a univalent Tarski universe with
            %a.existingWikiWord{:href => "/nlab/show/h-proposition"} non-propositional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-sets"} h-sets
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} HoTT book
          %h3#relation_to_double_negation Relation to double negation
          %p
            The existence of a choice operator implies
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            and the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/double+negation+law"} double negation law
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            the
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of a type is given by the
            %a.existingWikiWord{:href => "/nlab/show/double+negation"} double negation
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/modality"} modality
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %mo ¬
                  %mo ¬
                  %mi A
                %annotation{:encoding => "application/x-tex"} [A] \coloneqq \neg \neg A
          %p This means that the rules for choice operators can be rewritten using double negation rather than propositional truncations:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ,
                      %mi x
                      %mo :
                      %mo ¬
                      %mo ¬
                      %mi A
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma, x:\neg \neg A \vdash \varepsilon_A(x):A}
          %p equivalently, that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo :
                      %mo ¬
                      %mo ¬
                      %mi A
                      %mo →
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \varepsilon_A:\neg \neg A \to A}
          %p
            It then becomes clear that the
            %a.existingWikiWord{:href => "/nlab/show/law+of+double+negation"} law of double negation
            is simply the choice operator only for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/h-propositions"} h-propositions
            %strong type-theoretic law of double negation
            under the
            %a.existingWikiWord{:href => "/nlab/show/propositions+as+types"} propositions as types
            interpretation of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
          %p One could equivalently define the set-theoretic choice operator using double negations, by one of these inference rules:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo :
                      %mo ¬
                      %mo ¬
                      %mi A
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi A
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mn 0
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} isSet
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo ¬
                      %mo ¬
                      %mi A
                      %mo →
                      %mi A
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \varepsilon_A:\neg \neg A \to [A]_0} \qquad \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \varepsilon_A:\mathrm{isSet}(A) \times \neg \neg A \to A}
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/currying"} currying
            the conclusion of the second rule, one gets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi A
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi ε
                        %mi A
                      %mo :
                      %mi{:mathvariant => "normal"} isSet
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mo ¬
                      %mo ¬
                      %mi A
                      %mo →
                      %mi A
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash A \; \mathrm{type}}{\Gamma \vdash \varepsilon_A:\mathrm{isSet}(A) \to (\neg \neg A \to A)}
          %p
            which is a version of the
