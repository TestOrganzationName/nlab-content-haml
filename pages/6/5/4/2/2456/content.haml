                  %mi x
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mi ℰ
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:\mathrm{Hom}_\mathcal{E}(1, X)
            from the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
            %a.existingWikiWord{:href => "/nlab/show/generator"} generator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} 1 \in \mathcal{E}
            to any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
            to behave as
            %a.existingWikiWord{:href => "/nlab/show/elements"} elements
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
