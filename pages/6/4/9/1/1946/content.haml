                    \\searrow\mathrlap{{}^{f_r}}
                    \\\
                    L_r Y
                    \&amp; \longrightarrow &amp;
                    L_r Y \overset{L_r X}{\sqcup} X_r
                    \&amp; \underset{\in Cof}{\longrightarrow} &amp;
                    Y_r
                    \\\
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\\
                    \\ast
                    \&amp;\longrightarrow&amp;
                    X_r / L_r X
                    \&amp;\underset{f_r / L_r f}{\longrightarrow}&amp;
                    Y_r/L_r Y
                    }
            %p
              Here the top square, the left rectangle and the bottom rectagle are
              %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              by definition of the latching object (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LatchingAndMatchingObjects"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi r
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi L
                        %mi r
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mi cofib
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi L
                        %mi r
                      %mi X
                      %mo →
                      %msub
                        %mi X
                        %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X_r/L_r X \,\coloneqq\, cofib(L_r X \to X_r)
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              implies first that the left bottom square and then that the right bottom square is a pushout. This exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi r
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi L
                      %mi r
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f_r/L_r f
              as the pushout of a cofibration, and hence as a cofibration itself.
          %p
            %br/
          %h4#with_values_in_an_arbitrary_model_category With values in an arbitrary model category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
          .num_prop
            %h6#corollary_2 Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \in [\Delta^{op}, C]
              a Reedy cofibrant object, the
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Kan+map"} Bousfield-Kan map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{[n]} \mathbf{\Delta}[n] \cdot X_n
                    \\to
                    \\int^{[n]} \Delta[n] \cdot X_n
            %p
              is a weak equivalence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .proof
            %h6#proof_4 Proof
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              over the
              %a.existingWikiWord{:href => "/nlab/show/copower"} tensor
              is a left
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"}
                    \\int (-)\cdot (-) : [\Delta,sSet_{Quillen}]_{Reedy} \times
                    [\Delta^{op}, C]_{Reedy}
            %p
              (as discussed there). Therefore with its second argument fixed and cofibrant it is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} left Quillen functor
              in the remaining argument. As such, it preserves weak equivalences between cofibrant objects (by the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              = succeed "," do
                %a{:href => "#OverDeltaWithValuesInSimplicialSets"} above discussion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}[n]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[-]
              are indeed cofibrant in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Quillen
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi Reedy
                    %annotation{:encoding => "application/x-tex"} [\Delta,sSet_{Quillen}]_{Reedy}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Delta}[-] \to \Delta[-]
              is objectwise a weak equivalence in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
          %h4#EnrichmentOverTheSimplexCategory Enrichment
          %p
            The following proposition should be read as a
            %strong warning
            that an obvious idea about simplicial enrichment of Reedy model structures over the simplex category does
            %em not
            work.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+objects"} category of simplicial objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, C]
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is canonically an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %p
              However, this does
              %strong not
              in general harmonize with the Reedy model structure to make
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, C]_{Reedy}
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            %p
              More precisely the following parts of the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              for the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
              hold. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              be a cofibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, C]_{Reedy}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo :
                    %mi S
                    %mo →
                    %mi T
                  %annotation{:encoding => "application/x-tex"} s : S \to T
              be a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/pushout-product"} pushout-product
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mover
                          %mo ⊗
                          %mo{:stretchy => "false"} ¯
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \bar \otimes g
                  is a cofibration in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi Δ
                          %mi op
                        %mo ,
                        %mi C
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi Reedy
                      %annotation{:encoding => "application/x-tex"} [\Delta^{op}, C]_{Reedy}
                  ;
              %li
                %p
                  and it is an acyclic cofibration if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  is;
              %li
                %p
                  it is
                  %strong not necessarily
                  acyclic if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
                  is.
          %p
            That the first two items do hold is discussed for instance as
            = succeed "." do
              %a{:href => "#Dugger01"} Dugger 2001, prop. 4.4
            = succeed "." do
              %a{:href => "#Dugger01"} Dugger 2001, remark 4.6
          .num_remark
            %h6#remark_2 Remark
            %p
              However, there are
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} left Bousfield localizations
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet]_{Reedy}
              for which
            %ol
              %li
                %p
                  the above
                  = succeed "-enrichment" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sSet
                        %annotation{:encoding => "application/x-tex"} sSet
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sSet
                        %annotation{:encoding => "application/x-tex"} sSet
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              %li
                %p
                  the result model structure is Quillen equivalent to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  itself.
            %p
              This is in fact a useful technique for replacing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              by a Quillen equivalent and
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %em
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              in the section
              = succeed "." do
                %em
                  %a{:href => "simplicial+model+category#SimpEquivMods"} Simplicial Quillen equivalent models
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+model+structure"} generalized Reedy model structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
          %h2#references References
          %p The original text is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Chris+Reedy"}> Chris Reedy
              ,
              %em Homotopy Theory of Model Categories
              (
              %a{:href => "http://www-math.mit.edu/~psh/reedy.pdf"}> retyped pdf
              )
          %p Textbook accounts:
          %ul
            %li#Hovey99
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mark+Hovey"}> Mark Hovey
                , Section 5.2 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Model+Categories"} Model Categories
                %strong 63
                AMS (1999) &amp;lbrack;
                %a{:href => "https://bookstore.ams.org/surv-63-s"}> ISBN:978-0-8218-4361-1
                ,
                = succeed "," do
                  %a{:href => "https://doi.org/http://dx.doi.org/10.1090/surv/063"} doi:10.1090/surv/063
                = succeed "," do
                  %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/hovey-model-cats.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "http://books.google.co.uk/books?id=Kfs4uuiTXN0C&printsec=frontcover"} Google books
            %li#Hirschhorn02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Philip+Hirschhorn"}> Philip Hirschhorn
                , Chapter 15 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Model+Categories+and+Their+Localizations"} Model Categories and Their Localizations
                = succeed "," do
                  %a{:href => "https://bookstore.ams.org/surv-99-s/"} ISBN:978-0-8218-4917-0
                = succeed "," do
                  %a{:href => "http://www.gbv.de/dms/goettingen/360115845.pdf"} pdf toc
                = succeed "&rbrack;" do
