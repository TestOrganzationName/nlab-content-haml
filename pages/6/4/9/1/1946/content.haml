                    %msub
                      %mo{:stretchy => "false"} )
                      %mi r
                    %mo ⊕
                    %mi id
                  %annotation{:encoding => "application/x-tex"} (N f)_r \oplus id
              is clearly a cofibration iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi f
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi r
                  %annotation{:encoding => "application/x-tex"} (N f)_r
              is.
          .num_remark
            %h6 Remark
            %p
              One direction of the implication in Cor.
              %a.maruku-ref{:href => "#SimplicialReedyCofibsInAbelianCatsUnderDoldKan"}
              holds generally without any assumptions on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              or
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℛ
                    %annotation{:encoding => "application/x-tex"} \mathcal{R}
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
