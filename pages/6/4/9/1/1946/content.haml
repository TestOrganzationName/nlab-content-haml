              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            #eq:LatchingObject.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi r
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi colim
                      %mrow
                        %mi s
                        %munder
                          %mo →
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi r
                    %msub
                      %mi X
                      %mi s
                  %annotation{:encoding => "application/x-tex"}
                    L_r X
                    \\;\coloneqq\;
                    \\underset{
                    s \underset{+}{\to} r
                    }{colim}
                    X_s
            %p
              over the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi r
                  %annotation{:encoding => "application/x-tex"} R_+/r
              containing all objects except the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi r
                    %annotation{:encoding => "application/x-tex"} id_r
            %p
              %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> Dually
              \:
            %p
              The
              %strong matching object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              at stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            #eq:MatchingObject.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi r
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mrow
                        %mi r
                        %munder
                          %mo →
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi s
                    %msub
                      %mi X
                      %mi s
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    M_r X
                    \\;\coloneqq\;
                    \\underset{
                    r \underset{-}{\to} s }
                    {\lim}
                    X_s
                    \\,,
            %p
              over the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi R
                      %mo −
                  %annotation{:encoding => "application/x-tex"} r/R_-
              containing all objects except
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi r
                    %annotation{:encoding => "application/x-tex"} id_r
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of (
              %a.existingWikiWord{:href => "/nlab/show/colimit"}> co
              )
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              there are evident
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            #eq:ComparisonMapsFromLatchingToMatchingObject.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi r
                    %mi X
                    %mo ⟶
                    %msub
                      %mi X
                      %mi r
                    %mo ⟶
                    %msub
                      %mi M
                      %mi r
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_r X
                    \\longrightarrow
                    X_r
                    \\longrightarrow
                    M_r X
                    \\,.
            %p
          (e.g.
          = succeed ";" do
            %a{:href => "#Hovey99"} Hovey (1999), Def. 5.2.2
          = succeed ")" do
            %a{:href => "#Hirschhorn02"} Hirschhorn (2002), Def. 15.2.5
          %p
          #LatchingAndMatchingOfSimplicialObjects.num_remark
            %h6 Example
            %p
              %strong (latching and matching of simplicial objects)
              %br/
              Consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                    %mo =
                    %msup
                      %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{R} = \Delta^{op}
              is the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              with its canonical Reedy structure (
              %a{:href => "Reedy+category#ReedyStructureOnSimplexCategory"}> here
              ), where
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi op
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo +
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mo −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} (\Delta^{op})_+ \,=\, (\Delta_-)^{op}
                is the opposite of the
                %a.existingWikiWord{:href => "/nlab/show/surjections"} surjections
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo −
                        %mi k
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [r] \to [r-k]
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi op
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo −
                      %mspace{:width => "thinmathspace"}
                      %mo =
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mo +
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} (\Delta^{op})_- \,=\, (\Delta_+)^{op}
                is the opposite of the
                %a.existingWikiWord{:href => "/nlab/show/injections"} injections
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo −
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [r-k] \to [r]
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \colon \Delta^{op} \to \mathcal{C}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/degeneracy+map"} degeneracy map
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/face+map"} face map
            %p
              This means that the
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi r
                    %mi X
                    %mo →
                    %msub
                      %mi X
                      %mi r
                  %annotation{:encoding => "application/x-tex"} L_r X \to X_r
              %a.maruku-eqref{:href => "#eq:ComparisonMapsFromLatchingToMatchingObject"} (3)
              out of the the latching object
              %a.maruku-eqref{:href => "#eq:LatchingObject"} (1)
              has as components in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              all
              %a{:href => "simplicial+identities#DegeneracyMapsAreSplitMono"} inclusions of degenerate simplices
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi r
                        %mo −
                        %mi k
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                    %msub
                      %mi X
                      %mi r
                  %annotation{:encoding => "application/x-tex"}
                    X_{r-k} \overset{\phantom{--}}{\hookrightarrow} X_r
            %p
              which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                  %annotation{:encoding => "application/x-tex"} X_r
              receives. Hence one may often think of the latching object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi r
                    %mi X
                  %annotation{:encoding => "application/x-tex"} L_r X
              as the object of
              %em degenerate
              %a.existingWikiWord{:href => "/nlab/show/n-simplex"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                \-simplices
              sitting inside the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                  %annotation{:encoding => "application/x-tex"} X_r
              of all
              = succeed "-simplices." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              %a.maruku-ref{:href => "#EveryBisimplicialSetIsReedyCofibrant"}
              and Prop.
              %a.maruku-ref{:href => "#LatchingInAbelianCategoryIsDegeneracySubobject"}
              below.
            %p
              Dually, the
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                    %mo →
                    %msub
                      %mi M
                      %mi r
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_r \to M_r X
              %a.maruku-eqref{:href => "#eq:ComparisonMapsFromLatchingToMatchingObject"} (3)
              to the matching object has as components in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              all face maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi r
                        %mo −
                        %mi k
                  %annotation{:encoding => "application/x-tex"} X_r \to X_{r-k}
            %p
              out of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi r
                    %annotation{:encoding => "application/x-tex"} X_r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi r
                    %mi X
                  %annotation{:encoding => "application/x-tex"} M_r X
              as the object of hollow shells of
              = succeed "-simplices" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi r
                    %annotation{:encoding => "application/x-tex"} X_r
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                    %mo →
                    %msub
                      %mi M
                      %mi r
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X_r \to M_r X
              assigning to each
              = succeed "-simplex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            %p
              This intuition carries over to presheaves over other Reedy categories, such as cubical and globular sets, with the caveat that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mo +
                  %annotation{:encoding => "application/x-tex"} R_+
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mo −
                  %annotation{:encoding => "application/x-tex"} R_-
              consider
              %em all
              morphisms raising/lowering degree, including e.g. diagonals of cubes.
          %p
          .num_remark
            %h6 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℛ
                      %mrow
                        %mo &lt;
                        %mrow
                        %mi i
                  %annotation{:encoding => "application/x-tex"} \mathcal{R}_{\lt{}i}
              be the full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{R}
              on objects of degree strictly less than
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi I
                      %mi i
                      %mi j
                    %mo :
                    %msub
                      %mi ℛ
                      %mrow
                        %mo &lt;
                        %mrow
                        %mi i
                    %mo →
                    %msub
                      %mi ℛ
                      %mrow
                        %mo &lt;
                        %mrow
                        %mi j
                  %annotation{:encoding => "application/x-tex"} I_i^j : \mathcal{R}_{\lt{}i} \to \mathcal{R}_{\lt{}j}
              for the inclusion functor.
            %p
              Then the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi i
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ℛ
                      %mrow
                        %mo &lt;
                        %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ℛ
                      %mrow
                        %mo &lt;
                        %mrow
                        %mi i
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (I_i^{i+1})^* : [\mathcal{R}_{\lt{}i+1}, \mathcal{C}] \to [\mathcal{R}_{\lt{}i}, \mathcal{C}]
              forgets the presheaf cells of degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi I
                      %mi i
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} (I_i^{i+1})^*
              is part of an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functoriality+of+categories+of+presheaves"} adjoint triple
            %ul
              %li
                %p
                  a left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi I
                          %mi i
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo !
                      %annotation{:encoding => "application/x-tex"} (I_i^{i+1})_!
                  such that
                %ul
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi I
                            %mi i
                            %mrow
                              %mi i
                              %mo +
                              %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo !
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi r
                          %mo =
                          %msub
                            %mi X
                            %mi r
                        %annotation{:encoding => "application/x-tex"} ((I_i^{i+1})_! X)_r = X_r
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo{:stretchy => "false"} (
                          %mi r
                          %mo{:stretchy => "false"} )
                          %mo &lt;
                          %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} d(r) \lt{} i
                    and
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi I
                            %mi i
                            %mrow
                              %mi i
                              %mo +
                              %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo !
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi r
                          %mo =
                          %msub
                            %mi L
                            %mi r
                          %mi X
                        %annotation{:encoding => "application/x-tex"} ((I_i^{i+1})_! X)_r = L_r X
                    for
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi i
                          %annotation{:encoding => "application/x-tex"} d(r) = i
                %p
                  In other words,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi I
                          %mi i
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo !
                      %annotation{:encoding => "application/x-tex"} (I_i^{i+1})_!
                  endows a presheaf with cells of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  freely, by taking only the degenerate cells.
              %li
                %p
                  a right adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi I
                          %mi i
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} (I_i^{i+1})_{*}
                  such that
                %ul
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi I
                            %mi i
                            %mrow
                              %mi i
                              %mo +
                              %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi r
                          %mo =
                          %msub
                            %mi X
                            %mi r
                        %annotation{:encoding => "application/x-tex"} ((I_i^{i+1})_* X)_r = X_r
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo{:stretchy => "false"} (
                          %mi r
                          %mo{:stretchy => "false"} )
                          %mo &lt;
                          %mi i
                        %annotation{:encoding => "application/x-tex"} d(r) \lt i
                    and
                  %li
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %msubsup
                            %mi I
                            %mi i
                            %mrow
                              %mi i
                              %mo +
                              %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo *
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi r
                          %mo =
                          %msub
                            %mi M
                            %mi r
                          %mi X
                        %annotation{:encoding => "application/x-tex"} ((I_i^{i+1})_* X)_r = M_r X
                    for
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi d
                            %mo{:stretchy => "false"} (
                            %mi r
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi i
                          %annotation{:encoding => "application/x-tex"} d(r) = i
                %p
                  In other words,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi I
                          %mi i
                          %mrow
                            %mi i
                            %mo +
                            %mn 1
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} (I_i^{i+1})_*
                  endows a presheaf with cells of degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
                  cofreely, by assigning every candidate boundary a unique filler.
            %p
              Notice in particular that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn 0
                    %mi X
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} L_0 X = 0
              is the
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mn 0
                    %mi X
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} M_0 X = 1
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo &lt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \lt 0
          %p
          .num_remark
            %h6 Example
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                    %mo =
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \mathcal{R} = \alpha
              is an
              %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              (regarded as a
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              and thus as a
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi X
                    %mo =
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} L_{n+1} X = X_n
              and
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi M
                        %mi n
                      %mi X
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} M_n X = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℛ
                      %mo =
                      %msup
                        %mi α
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{R}=\alpha^{op}
          %p
          #ReedyModelStructure.num_defn
            %h6 Definition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              in the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\mathcal{R}}
              (hence a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
            %ul
              %li
                %p
                  a
                  %em Reedy equivalence
                  if each component morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi r
                      %annotation{:encoding => "application/x-tex"} f_r
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  a
                  %em Reedy-cofibration
                  or
                  %em acyclic Reedy-cofibration
                  if for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi r
                          %mo ∈
                          %mi ℛ
                        %annotation{:encoding => "application/x-tex"} r \in \mathcal{R}
                #eq:CharacterizingReedyCofibrations.maruku-equation
                  %span.maruku-eq-number (4)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi r
                        %mi Y
                        %mover
                          %mo ⨿
                          %mrow
                            %msub
                              %mi L
                              %mi r
                            %mi X
                        %msub
                          %mi X
                          %mi r
                        %mo ⟶
                        %msub
                          %mi Y
                          %mi r
                      %annotation{:encoding => "application/x-tex"}
                        L_r Y
                        \\overset
                        {L_r X}
                        {\amalg}
                        X_r
                        \\longrightarrow
                        Y_r
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
                  or
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibration"} acyclic cofibration
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %li
                %p
                  a
                  %em Reedy-fibration
                  or
                  %em acyclic Reedy-fibration
                  if for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi r
                          %mo ∈
                          %mi ℛ
                        %annotation{:encoding => "application/x-tex"} r \in \mathcal{R}
                #eq:CharacterizingReedyFibrations.maruku-equation
                  %span.maruku-eq-number (5)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi r
                        %mo ⟶
                        %msub
                          %mi M
                          %mi r
                        %mi X
                        %munder
                          %mo ×
                          %mrow
                            %msub
                              %mi M
                              %mi r
                            %mi Y
                        %msub
                          %mi Y
                          %mi r
                      %annotation{:encoding => "application/x-tex"}
                        X_r
                        \\longrightarrow
                        M_r X
                        \\underset
                        {M_r Y}
                        {\times}
                        Y_r
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
                  or
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+fibration"} acyclic fibration
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
          (e.g.
          = succeed ")" do
            %a{:href => "#Hirschhorn02"} Hirschhorn (2002), Def. 15.3.3
          %p
          #ReedyCofibrantObjects.num_remark
            %h6 Remark
            %p In particular this means that:
            %ol
              %li
                %p
                  An object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is Reedy-cofibrant iff the comparison maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi r
                        %mi X
                        %mo →
                        %msub
                          %mi X
                          %mi r
                      %annotation{:encoding => "application/x-tex"} L_r X \to X_r
                  %a.maruku-eqref{:href => "#eq:ComparisonMapsFromLatchingToMatchingObject"} (3)
                  from its latching object are cofibrations.
              %li
                %p
                  An object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is Reedy-fibrant iff the comparison maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi r
                        %mo →
                        %msub
                          %mi M
                          %mi r
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X_r \to M_r X
                  %a.maruku-eqref{:href => "#eq:ComparisonMapsFromLatchingToMatchingObject"} (3)
                  to its matching object are fibrations.
            %p
          %p
          #model.num_prop
            %h6 Proposition
            %p
              %strong (Reedy model structure)
              %br/
              The classes of morphisms in Def.
              %a.maruku-ref{:href => "#ReedyModelStructure"}
              constitute a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              on the
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi ℛ
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\mathcal{R}}
              = succeed "." do
                %em Reedy model structure
          (e.g.
          = succeed ";" do
            %a{:href => "#Hovey99"} Hovey (1999), Thm. 5.2.5
          = succeed ")" do
            %a{:href => "#Hirschhorn02"} Hirschhorn (2002), Thm 15.3.4
          %p
          .num_remark
            %h6 Remark
            %p
              To see the factorization of a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X\to Y
              in either of the two necessary ways, construct the factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi r
                    %mo =
                    %msub
                      %mi g
                      %mi r
                    %msub
                      %mi h
                      %mi r
                  %annotation{:encoding => "application/x-tex"} f_r = g_r h_r
              inductively on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi r
                    %mi Z
                    %msub
                      %mo ⨿
                      %mrow
                        %msub
                          %mi L
                          %mi r
                        %mi X
                    %msub
                      %mi X
                      %mi r
                    %mo →
                    %msub
                      %mi M
                      %mi r
                    %mi Z
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi M
                          %mi r
                        %mi Y
                    %msub
                      %mi Y
                      %mi r
                  %annotation{:encoding => "application/x-tex"} L_r Z \amalg_{L_r X} X_r \to M_r Z \times_{M_r Y} Y_r
            %p
              in the appropriate way in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
          %h3#enriched_version Enriched version
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} suitable enriching category
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              \-
              %a.existingWikiWord{:href => "/nlab/show/enriched+Reedy+category"} enriched Reedy category
            such that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            – in particular when it is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                %annotation{:encoding => "application/x-tex"} V =
            %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
            – the
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi R
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [R,C]
            is itself a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            (see
            = succeed ")." do
              %a{:href => "#Angeltveit"} Angeltveit
          %p In the case that we do have extra assumptions on the codomain in that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
            %li
              %p
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} C^\circ
                the
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
                %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
                by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                and with the
                %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                an ordinary category regarded as a
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
          %p
            the Reedy model structure, having the same weak equivalences as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+functors"} global model structure on functors
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Func
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %msup
                      %mi C
                      %mo ∘
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func_\infty(R,C^\circ)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            into the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h2#remarks Remarks
          %ul
            %li
              %p Any Reedy cofibration or fibration is, in particular, an objectwise one, but the converse does not generally hold.
            %li
              %p
                An object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is Reedy cofibrant if and only if each map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mi r
                      %mi X
                      %mo →
                      %msub
                        %mi X
                        %mi r
                    %annotation{:encoding => "application/x-tex"} L_r X \to X_r
                is a cofibration in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi r
                    %annotation{:encoding => "application/x-tex"} X_r
                is cofibrant in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
            %li
              %p
                For some
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mi R
                    %annotation{:encoding => "application/x-tex"} M^R
                also admits a
                %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"} projective
                or
                %a.existingWikiWord{:href => "/nlab/show/injective+model+structure"} injective
                model structures. For instance for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo =
                    %annotation{:encoding => "application/x-tex"} M =
                %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
                this is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+simplicial+presheaves"} global model structure on simplicial presheaves
              %p
                In general the Reedy structure will not be the same as either, but will be a kind of mixture of both. If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %msub
                        %mi R
                        %mo +
                    %annotation{:encoding => "application/x-tex"} R = R_+
                then the Reedy model structure coincides with the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/projective+model+structure"} projective model structure
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %msub
                        %mi R
                        %mo −
                    %annotation{:encoding => "application/x-tex"} R = R_-
                it coincides with the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/injective+model+structure"} injective model structure
              %p
                For a detailed comparison of Reedy and global projective/injective model structures see around example A.2.9.22 in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
            %li
              %p
                In addition to its existing for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                admits more than one structure of Reedy category, then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi R
                    %annotation{:encoding => "application/x-tex"} C^R
                will have more than one Reedy model structure. For instance, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo ⋅
                      %mo →
                      %mo ⋅
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} R = (\cdot\to\cdot)
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/walking+arrow"} walking arrow
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                or its opposite
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mn 2
                          %mi op
                      %annotation{:encoding => "application/x-tex"} 2^{op}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} C^2
            %li
              %p
                For a general Reedy category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo :
                      %mi C
                      %mo →
                      %msup
                        %mi C
                        %mi R
                    %annotation{:encoding => "application/x-tex"} \Delta : C\to C^R
                need not be either a right or a left
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen functor
                (although, of course, it has left and right adjoints given by colimits and limits over
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                is a left Quillen functor if and only if for all objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %mi r
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi R
                        %mo −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial(r / R_-)
                is either connected or empty. Dually,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                is a right Quillen functor if and only if for all objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                      %annotation{:encoding => "application/x-tex"} r
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi R
                        %mo +
                      %mo{:stretchy => "false"} /
                      %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \partial(R_+ / r)
                is empty or connected. (See Hirschhorn 15.10.2 and 15.10.8, where this property is called
                = succeed ".)" do
                  %em having fibrant (resp. cofibrant) constants
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limits
                and colimits using the derived functors of the Quillen adjunctions
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} colim
                        %mo ⊣
                        %mi Δ
                        %mo ⊣
                        %mi{:mathvariant => "normal"} lim
                      %annotation{:encoding => "application/x-tex"} \mathrm{colim} \dashv \Delta \dashv \mathrm{lim}
          %h2#Properties Properties
          %h3#properness Properness
          %p
          #ReedyStructureInheritsProperness.num_prop
            %h6 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{R}
              a
              %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              which is left or right
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi ℛ
                    %mo ,
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(\mathcal{R}, \mathcal{C})
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#model"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper
          This appears as
          = succeed "," do
            %a{:href => "#Hirschorn02"} Hirschorn (2002), Thm. 15.3.4 (2)
          = succeed "." do
            %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
          %h3#CombinatorialStructure Combinatorial structure
          %p
          #ReedyStructureCofibrantlyGenerated.num_prop
            %h6 Proposition
            %p
              %strong (cofibrant generation)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              (and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{R}
              is a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
              = succeed ")" do
                %a.maruku-ref{:href => "#ReedyModelStructure"}
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\mathcal{R}}
              is cofibrantly generated.
          This is due to
          = succeed "," do
            %a{:href => "#Hirschhorn02"} Hirschhorn (2002), Theorem 15.6.27
          %a.existingWikiWord{:href => "/nlab/show/domains"} domains
          of generating (acyclic) cofibrations are relatively
          = succeed "." do
            %a.existingWikiWord{:href => "/nlab/show/small+objects"} small objects
          %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+categories"} generalized Reedy categories
          cf.
          %a{:href => "generalized+Reedy+category#BergerMoerdijk11"} Berger &amp; Moerdijk (2011), Thm. 7.5
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"} dual
            statement concerning
            %em fibrant
            generation is in
            = succeed "." do
              %a{:href => "#BHKKRS15"} BHKKRS15, Thm. 5.9
          %p
          #ReedyStructureCombinatorial.num_cor
            %h6 Corollary
            %p
              %strong (combinatoriality)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              (and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{R}
              is a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
              = succeed ")" do
                %a.maruku-ref{:href => "#ReedyModelStructure"}
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\mathcal{R}}
              is combinatorial.
          .proof
            %h6 Proof
            %p
              Recall that “combinatorial” means “locally presentable and cofibrantly generated”. Prop.
              %a.maruku-ref{:href => "#ReedyStructureCofibrantlyGenerated"}
              gives the cofibrant generation, and local presentability follows from general results on locally presentable functor categories (see
              = succeed ")." do
                %a{:href => "locally+presentable+category#PresheavesWithValuesInLocPresAreLocPres"} there
          %p
          #LeftProperness.num_prop
            %h6 Proposition
            %p
              %strong (left properness)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial
                and
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
            %p or
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/cellular+model+category"} cellular
                and
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
            %p
              then also the Reedy model structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi ℛ
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\mathcal{R}}
              is (combinatorial, by Cor.
              = succeed "," do
                %a.maruku-ref{:href => "#ReedyStructureCombinatorial"}
          This is mentioned in
          = succeed "." do
            %a{:href => "#Dugger01"} Dugger 2001, item 3. on p. 5008 (6 of 25)
          %h3#EnrichedModelStructure Enriched model structure
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [C,A]_{Reedy}
              is naturally an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            %p
              If in addition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              for some symmetric monoidal model category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [C,A]_{Reedy}
          %p
            This appears as (
            %a{:href => "#Barwick"}> Barwick, lemma 4.2, corollary 4.3
            ).
          %p (…check assumptions…)
          %h3#relation_to_other_model_structures Relation to other model structures
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Reedy+category"} Reedy category
            %p
              The identity functors provide left
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi R
                    %mo ,
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi Quillen
                    %mo{:stretchy => "false"} [
                    %mi R
                    %mo ,
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mo ≃
                          %mi Quillen
                    %mo{:stretchy => "false"} [
                    %mi R
                    %mo ,
                    %mi C
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"}
                    [R,C]_{proj} \stackrel{\simeq_{Quillen}}{\to}
                    [R,C]_{Reedy}
                    \\stackrel{\simeq_{Quillen}}{\to}
                    [R,C]_{inj}
            %p
              from the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              to the injective one.
          %p
            See also
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, remark A.2.9.23
          %h2#examples Examples
          %h3#over_the_arrow_category Over the arrow category
          %p The simplest nontrivial example is obtained for
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi I
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo →
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  R = I = \{1 \to 0\}
          %p
            the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interval+category"} interval category
          %p
            In this case the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,C]
            is the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            We take the degree on the objects to be as indicated. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mo −
                  %mo =
                  %mi R
                %annotation{:encoding => "application/x-tex"} R_- = R
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mo +
                %annotation{:encoding => "application/x-tex"} R_+
            contains only the identity morphisms.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi I
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : I \to C
            a functor, i.e. a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(1) \to F(0)
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %ul
            %li
              %p
                the latching object
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi latch
                          %mn 0
                        %mi F
                        %mo =
                        %msub
                          %mi colim
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mover
                              %mo →
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} latch_0 F = colim_{(s \stackrel{+}{\to} 0)} F(s) = \emptyset
            %li
              %p
                the latching object
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi latch
                          %mn 1
                        %mi F
                        %mo =
                        %msub
                          %mi colim
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mover
                              %mo →
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} latch_1 F = colim_{(s\stackrel{+}{\to}1)} F(s) = \emptyset
            %li
              %p
                the matching object
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi match
                          %mn 0
                        %mi F
                        %mo =
                        %msub
                          %mi lim
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mover
                              %mo →
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi s
                            %mo{:stretchy => "false"} )
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} match_0 F = lim_{(0 \stackrel{-}{\to}s)} F(s) = {*}
            %li
              %p
                the matching object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi match
                        %mn 1
                      %mi F
                      %mo =
                      %msub
                        %mi lim
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mover
                            %mo →
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi s
                          %mo{:stretchy => "false"} )
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} match_1 F = lim_{(1 \stackrel{-}{\to}s)} F(s) = F(0)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} \emptyset
            denotes the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} {*}
            the
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            (being the
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            and
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            over the empty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          %p
            From this we find that for a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \eta : F \to G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi η
                                %mn 1
                        %mtd
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi η
                                %mn 0
                        %mtd
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  F(1) &amp;\stackrel{\eta_1}{\to}&amp; G(1)
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  F(0) &amp;\stackrel{\eta_0}{\to}&amp; G(0)
                  }
          %p that
          %ul
            %li
              %p
                it is a Reedy cofibration in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [I,C]
                if
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mn 0
                        %mo :
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi ∅
                        %mi ∅
                        %mo =
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta_0 : F(0) \coprod_{\emptyset} \emptyset = F(0) \to G(0)
                  is a cofibration
              %p and
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mn 1
                        %mo :
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi ∅
                        %mi ∅
                        %mo =
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi G
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta_1 : F(1) \coprod_{\emptyset} \emptyset = F(1) \to G(1)
                  is a cofibration
            %li
              %p
                it is a Reedy fibration in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [I,C]
                if
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi η
                            %mn 0
                          %mo :
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ×
                            %mo *
                          %mo *
                          %mo =
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \eta_0 : F(0) \to G(0) \times_{*} {*} = G(0)
                    is a fibration
                %li
                  %p
                    the universal morphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ×
                            %mrow
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mn 0
                              %mo{:stretchy => "false"} )
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F(1) \to G(1) \times_{G(0)} F(0)
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↘
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                                  %msub
                                    %mo ×
                                    %mrow
                                      %mi G
                                      %mo{:stretchy => "false"} (
                                      %mn 0
                                      %mo{:stretchy => "false"} )
                                  %mi G
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mo →
                                %mtd
                                  %mi G
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mover
                                    %mo →
                                    %mrow
                                      %msub
                                        %mi η
                                        %mn 0
                                %mtd
                                  %mi G
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          F(1)
                          \\\
                          \&amp; \searrow
                          \\\
                          \&amp;&amp; F(0) \times_{G(0)} G(1)
                          \&amp;\to&amp; G(1)
                          \\\
                          \&amp;&amp; \downarrow &amp;&amp; \downarrow
                          \\\
                          \&amp;&amp; F(0) &amp;\stackrel{\eta_0}{\to}&amp; G(0)
                          }
                  %p is a fibration.
              %p
                Notice that since fibrations are preserved by pullbacks and under composition with themselves, it follows that also
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mn 1
                      %mo :
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_1 : F(1) \to G(1)
                is a fibration.
            %li
              %p
                The cofibrant objects in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [I,C]
                are those arrows
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(1) \to F(0)
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                for which
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(1)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(0)
                are cofibrant;
            %li
              %p
                The fibrant objects in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi C
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [I,C]
                are those arrows
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(1) \to F(0)
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                that are fibrations between fibrant objects in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
          %p
            So in accord with the proposition above one finds that this Reedy model structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi I
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [I,C]
            coincides with the
            %em injective
            %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+functors"} global model structure on functors
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %h3#OverTheTowerCategory Over the tower category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %msup
                    %mi ℕ
                    %mi op
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi ⋯
                  %mo →
                  %mn 2
                  %mo →
                  %mn 1
                  %mo →
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} R = \mathbb{N}^{op} = \{\cdots \to 2 \to 1 \to 0\}
            be the natural numbers regarded as a
            %a.existingWikiWord{:href => "/nlab/show/poset"} poset
            using the greater-than relation.
          %p
            With the degree as indicated, this is a Reedy category with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mo −
                  %mo =
                  %mi R
                %annotation{:encoding => "application/x-tex"} R_- = R
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mo +
                %annotation{:encoding => "application/x-tex"} R_+
            containing only identity morphisms.
          %p
            Now the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi R
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [R,C]
            is the category of
            %em towers
            of morphisms in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p The analysis of the Reedy model structure on this involves just a repetition of the steps involved in the analysis of the arrow category in the above example. One finds:
          %ul
            %li
              %p
                a natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo :
                      %mi F
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \eta : F \to G
                is a fibration precisely if
              %ul
                %li
                  %p
                    the component
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi η
                            %mn 0
                          %mo :
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \eta_0 : F(0) \to G(0)
                    is a fibration
                %li
                  %p
                    all universal morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ×
                            %mrow
                              %mi G
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo −
                              %mn 1
                              %mo{:stretchy => "false"} )
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F(n) \to F(n-1) \times_{G(n-1)} G(n)
                    are fibrations.
            %li
              %p
                the fibrant objects are the towers of fibrations on fibrant objects in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
          %p
            A detailed discussion of the model structure on towers is for instance in (
            %a{:href => "#GoerssJardine"}> GoerssJardine, chapter 6
            )
          %p By duality it follows that analogously there is a model structure on co-towers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %msub
                    %mi X
                    %mn 1
                  %mo →
                  %msub
                    %mi X
                    %mn 2
                  %mo →
                  %mi ⋯
                %annotation{:encoding => "application/x-tex"}
                  X_0 \to X_1 \to X_2 \to \cdots
          %p
            in a model category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#SimplexCategory Over the simplex category
          %p
            The motivating and central example of
            %a.existingWikiWord{:href => "/nlab/show/Reedy+categories"} Reedy categories
            is the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
          %p Recall that
          %ul
            %li
              %p
                a map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [k] \to [n]
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \Delta_+
                precisely if it is an injection;
            %li
              %p
                a map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n] \to [k]
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mo −
                    %annotation{:encoding => "application/x-tex"} \Delta_-
                precisely if it is a surjection.
          %p
            Dually, for the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi op
                %annotation{:encoding => "application/x-tex"} \Delta^{op}
          %ul
            %li
              %p
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ←
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n] \leftarrow [k]
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi op
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo −
                    %annotation{:encoding => "application/x-tex"} (\Delta^{op})_-
                precisely if the map underlying it is an injection;
            %li
              %p
                a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ←
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [k] \leftarrow [n]
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi op
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo +
                    %annotation{:encoding => "application/x-tex"} (\Delta^{op})_+
                precisely if the map underlying it is a surjection.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %msub
                    %mi sSet
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} C = sSet_{Quillen}
            be the category
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            equipped with the standard
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            and consider the Reedy model structures on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %msub
                    %mi sSet
                    %mi Quillen
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet_{Quillen}]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Delta,sSet_{Quillen}]
          %h4#OverDeltaWithValuesInSimplicialSets With values in simplicial sets
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X  \in [\Delta^{op},Set]
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/latching+object"} latching object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi n
                        %mi X
                      %annotation{:encoding => "application/x-tex"} L_n X
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/union"} union
                  of all degenerate
                  = succeed "-cells;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/matching+object"} matching object
                  is
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi M
                            %mi n
                          %mi X
                          %mo ≃
                          %msup
                            %mi X
                            %mrow
                              %mo ∂
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} M_n X \simeq X^{\partial \Delta[n]}
                  %a.existingWikiWord{:href => "/nlab/show/powering"} powering
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/boundary+of+a+simplex"} boundary of the n-simplex
                  into
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed "-cells" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (n-1)
                  %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
          %p
            More details on this are currently at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/generalized+Reedy+model+structure"} generalized Reedy model structure
          %p
          #EveryBisimplicialSetIsReedyCofibrant.num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = sSet
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, \mathcal{C}]_{Reedy}
              (i.e. every
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/bisimplicial+sets"} bisimplicial sets
          %p
            (
            %a{:href => "#Hirschhorn02"}> Hirschhorn (2002), corollary 15.8.8
            )
          %p
            The idea is to observe that the latching objects are the
            %a.existingWikiWord{:href => "/nlab/show/sub-objects"} sub-objects
            of degeenrate cells, so that the comparison morphism
            %a.maruku-eqref{:href => "#eq:ComparisonMapsFromLatchingToMatchingObject"} (3)
            is a
            %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            and hence a
            %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
          %p Similarly:
          .num_prop
            %h6#proposition_4 Proposition
            %p The canonical cosimplicial simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi Δ
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[-] : \Delta \to sSet
            %p
              is Reedy cofibrant in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Quillen
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Delta,sSet_{Quillen}]
          .proof
            %h6#proof Proof
            %p
              The latching object at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mi lim
                      %mo →
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mi inj
                      %mo .
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi Δ
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_n(\Delta[-]) =
                    \\lim_\to
                    \\left(
                    ([k] \to [n]\; inj.\in\;\Delta) \mapsto
                    \\Delta[k]
                    \\right)
                    \\,.
            %p
              This is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \partial \Delta[n]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \partial \Delta[n] \to \Delta[n]
              is a monomorphism, hence a cofibration in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              (in fact these are the generating cofibrations).
          .num_cor
            %h6#corollary Corollary
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              over its diagram of simplices (with values in the constant simplicial set on the sets of simplicies
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X_n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mi hocolim
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %mi const
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq hocolim ( [n] \mapsto const X_n)
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              Because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} X_{(-)} : \Delta^{op} \to sSet
              is Reedy cofibrant by the above, by the discussion at
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              we can compute the hocolim by the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mo *
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ⋅
                    %msub
                      %mi X
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{[n]} Q(*)_n \cdot X_n
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Δ
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} Q(*) : \Delta \to sSet
              is a cofibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of the point in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Quillen
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi Reedy
                    %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]_{Reedy}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[-]
              since this is cofibrant by the above observation and clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \Delta[-] \to *
              is objectwise a weak equivalence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %p Therefore the hocolim is (up to equivalence) represented by the simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %msub
                      %mi X
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int^{[n]} \Delta[n] \cdot X_n
                    \\,.
            %p
              But by the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              this is in fact
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_remark
            %h6#remark Remark
            %p
              This kind of argument has many immediate generalizations. For instance for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi K
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} C = [K^{op}, sSet_{Quillen}]_{inj}
              the injective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              over any small category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localizations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the hocolim over its simplicial diagram of component presheaves.
          %p
            For the following write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Δ
                  %mo :
                  %mi Δ
                  %mo →
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} \mathbf{\Delta} : \Delta \to sSet
            for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fat+simplex"} fat simplex
          .num_prop
            %h6#proposition_5 Proposition
            %p The fat simplex is Reedy cofibrant.
          .proof
            %h6#proof_3 Proof
            %p
              By the discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Quillen
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]_{proj}
              %a{:href => "#Properties"} general properties
              of Reedy model structures, the identity functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta, sSet_{Quillen}]_{proj} \to [\Delta, sSet_{Quillen}]_{Reedy}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} left Quillen functor
          %h4#WithValuesInAnAbelianCategory With values in an additive model category
          %p
            In this section, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            be an
            %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            in which all
            %a.existingWikiWord{:href => "/nlab/show/retractions"} retractions
            exhibit
            %a.existingWikiWord{:href => "/nlab/show/direct+sums"} direct sums
            (such as in an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
          %p
            In this situaiton the
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
            applies (see
            = succeed ")" do
              %a{:href => "Dold-Kan+correspondence#StatementAdditiveACase"} there
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mi 𝒜
                  %mo ≔
                  %msup
                    %mi 𝒜
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi op
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s\mathcal{A} \coloneqq \mathcal{A}^{(\Delta^{op})}
            of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          %p
          #LatchingInAbelianCategoryIsDegeneracySubobject.num_prop
            %h6 Proposition
            %p
              Under the above assumptions, for any
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ∈
                    %mi s
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} X_\bullet \in s\mathcal{A}
              and all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.maruku-eqref{:href => "#eq:ComparisonMapsFromLatchingToMatchingObject"} (3)
              from the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed ")" do
                %a.maruku-ref{:href => "#LatchingAndMatchingObjects"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is a (
              %a.existingWikiWord{:href => "/nlab/show/split+monomorphism"}> split
              )
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi n
                    %mi X
                    %mover
                      %mo ↪
                      %mphantom
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo −
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mi X
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_n X \xhookrightarrow{\phantom{---}} X_n
                    \\,.
            %p
          This statement and the following proof spells out a suggestion by
          %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
          in
          = succeed "." do
            %a{:href => "https://mathoverflow.net/a/300657/381"} MO:a/300657
          .proof
            %h6 Proof
            %p
              Under the given assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              applies (see
              = succeed ")" do
                %a{:href => "Dold-Kan+correspondence#StatementAdditiveACase"} there
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              and says that, up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo ≃
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mo •
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X_\bullet \simeq \Gamma(V_\bullet)
              for some
              %a.existingWikiWord{:href => "/nlab/show/connective+chain+complex"} connective chain complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo •
                  %annotation{:encoding => "application/x-tex"} V_\bullet
              (in fact
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo •
                    %mo ≃
                    %mi N
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} V_\bullet \simeq N X_\bullet
              is the
              %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                  %annotation{:encoding => "application/x-tex"} X_r
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of one copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi s
                  %annotation{:encoding => "application/x-tex"} V_s
              for each
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi r
                    %mo{:stretchy => "false"} ]
                    %mo ↠
                    %mo{:stretchy => "false"} [
                    %mi s
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [r] \twoheadrightarrow [s]
              in
              %a.existingWikiWord{:href => "/nlab/show/simplex+category"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
              (by
              = succeed "):" do
                %a{:href => "Dold-Kan+correspondence#ExplicitFormOfGamma"} this Prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo{:stretchy => "false"} ]
                        %mo ↠
                        %mo{:stretchy => "false"} [
                        %mi s
                        %mo{:stretchy => "false"} ]
                    %msub
                      %mi V
                      %mi s
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mo (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %mi r
                                  %mo{:stretchy => "false"} ]
                                  %mover
                                    %mo ↠
                                    %mi p
                                  %mo{:stretchy => "false"} [
                                  %mi s
                                  %mo{:stretchy => "false"} ]
                              %mrow
                                %mi p
                                %mo ≠
                                %msub
                                  %mi id
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %mi r
                                    %mo{:stretchy => "false"} ]
                          %msub
                            %mi V
                            %mi s
                          %mo )
                        %mo ⏟
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo ⊕
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi V
                            %mi r
                        %mo ⏟
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi r
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X_r
                    \\;\simeq\;
                    \\underset
                    {[r] \twoheadrightarrow [s]}
                    {\bigoplus}
                    V_s
                    \\;\simeq\;
                    \\underset{
                    (D X)_r
                    }{
                    \\underbrace{
                    \\left(
                    \\underset
                    {
                    {[r] \overset{p}{\twoheadrightarrow} [s]}
                    \\atop
                    p \neq id_{[r]}
                    }
                    {\bigoplus}
                    V_s
                    \\right)
                    }
                    }
                    \\,\oplus\,
                    \\underset{
                    (N X)_r
                    }{
                    \\underbrace{
                    V_r
                    }
                    }
                    \\,.
            %p
              (On the right we have split off the summand corresponding to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            %p
              Moreover (still by
              = succeed ")," do
                %a{:href => "Dold-Kan+correspondence#ExplicitFormOfGamma"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/degeneracy+maps"} degeneracy maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo ′
                        %mo{:stretchy => "false"} ]
                        %mover
                          %mo ↠
                          %mi p
                        %mo{:stretchy => "false"} [
                        %mi r
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X_{[r'] \overset{p}{\twoheadrightarrow} [r]}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              are simply given on these
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct summands
              by precomposition of their labels with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi r
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi X
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %mi r
                                    %mo ′
                                    %mo{:stretchy => "false"} ]
                                    %mover
                                      %mo ↠
                                      %mi p
                                    %mo{:stretchy => "false"} [
                                    %mi r
                                    %mo{:stretchy => "false"} ]
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi r
                                %mo ′
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} [
                            %mi r
                            %mo{:stretchy => "false"} ]
                            %mover
                              %mo ↠
                              %mi q
                            %mo{:stretchy => "false"} [
                            %mi s
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi v
                            %mo ∈
                            %msub
                              %mi V
                              %mi s
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} [
                            %mi r
                            %mo ′
                            %mo{:stretchy => "false"} ]
                            %mover
                              %mo ↠
                              %mrow
                                %mi q
                                %mo ∘
                                %mi p
                            %mo{:stretchy => "false"} [
                            %mi s
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi v
                            %mo ∈
                            %msub
                              %mi V
                              %mi s
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_{r}
                    \&amp;
                    \\overset{X_{[r'] \overset{p}{\twoheadrightarrow} [r]} }{\longrightarrow}
                    \&amp;
                    X_{r'}
                    \\\
                    \\big(
                    [r] \overset{q}{\twoheadrightarrow} [s]
                    ,\,
                    v \in V_s
                    \\big)
                    \&amp;\mapsto&amp;
                    \\big(
                    [r'] \overset{q \circ p}{\twoheadrightarrow} [s]
                    ,\,
                    v \in V_s
                    \\big)
                    }
            %p
              We claim (argument below) that this implies that the colimit defining
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi r
                    %mi X
                  %annotation{:encoding => "application/x-tex"} L_r X
              consists of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of triples of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:stretchy => "false"} [
                    %mi r
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ↠
                      %mi p
                    %mo{:stretchy => "false"} [
                    %mi r
                    %mo ′
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ↠
                      %mi q
                    %mo{:stretchy => "false"} [
                    %mi s
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi v
                    %mo ∈
                    %msub
                      %mi V
                      %mi s
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Big(
                    [r]
                    \\overset{p}{\twoheadrightarrow}
                    [r']
                    \\overset{q}{\twoheadrightarrow}
                    [s]
                    ,\,
                    v \in V_s
                    \\Big)
              for non-identity
              = succeed "," do
