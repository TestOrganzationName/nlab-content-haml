                            %mi N
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi r
                            %mo ⊕
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi r
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    L_r Y \overset{L_r X}{\amalg} X_r
                    \&amp;\longrightarrow&amp;
                    Y_r
                    \\\
                    (N X)_r \oplus (D Y)_r
                    \&amp;\overset{(N f)_r \oplus id}{\longrightarrow}&amp;
                    (N Y)_r \oplus (D Y)_r
                    }
            %p
              But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi N
