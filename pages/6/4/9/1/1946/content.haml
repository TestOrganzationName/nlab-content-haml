                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon X_\bullet \to Y_\bullet
              of functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
                    %mo →
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{R} \to \mathcal{C}
              is Reedy cofibrant (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReedyModelStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ∈
                    %mi ℛ
                  %annotation{:encoding => "application/x-tex"} r \in \mathcal{R}
              the induced morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi r
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi L
                      %mi r
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi f
                          %mi r
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi L
                          %mi r
                        %mi f
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Y
                      %mi r
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi L
                      %mi r
                    %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    X_r/L_r X
                    \\overset
                    {\;\; f_r/L_r f \;\;}
                    {\longrightarrow}
                    Y_r/L_r Y
            %p
              is a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
