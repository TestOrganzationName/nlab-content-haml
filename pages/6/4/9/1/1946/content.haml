          %p
          #SimplicialReedyCofibsInAbelianCatsUnderDoldKan.num_cor
            %h6 Corollary
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
              be a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              whose
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              category is as above, then a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \,\colon\, X_\bullet \to Y_\bullet
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} s\mathcal{A}
              is a Reedy cofibration (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReedyModelStructure"}
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan-corresponding
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %msub
                      %mi f
                      %mo •
                  %annotation{:encoding => "application/x-tex"} N f_\bullet
              of
              %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complexes"} normalized chain complexes
              is degreewise a cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒜
                    %annotation{:encoding => "application/x-tex"} \mathcal{A}
          .proof
            %h6 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#LatchingInAbelianCategoryIsDegeneracySubobject"}
              the maps
              %a.maruku-eqref{:href => "#eq:CharacterizingReedyCofibrations"} (4)
              are of this form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi L
                              %mi r
                            %mi Y
                            %mover
                              %mo ⨿
                              %mrow
                                %msub
                                  %mi L
                                  %mi r
                                %mi X
                            %msub
                              %mi X
                              %mi r
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi Y
                              %mi r
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mi X
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi r
                            %mo ⊕
                            %mo{:stretchy => "false"} (
                            %mi D
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi r
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi N
                                %mi f
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi r
                                %mo ⊕
                                %mi id
                          %mtd
