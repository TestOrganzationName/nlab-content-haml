                  %div
                    %p
                      %a{:href => "/nlab/edit/monoid+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#properties_and_constructions"} Properties and constructions
              %ul
                %li
                  %a{:href => "#ideals_forming_a_quantale"} Ideals forming a quantale
              %li
                %a{:href => "#related_concepts"} Related concepts
          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            (or
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/semigroup"} semigroup
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong left ideal
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mi A
                %annotation{:encoding => "application/x-tex"} S A
            is contained in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %strong right ideal
            is a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi S
                    %mo ⊆
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A S \subseteq A
            = succeed "," do
              %strong two-sided ideal
            = succeed "," do
              %strong ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            that is both a left ideal and a right ideal.
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mo ⊗
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C, \otimes, I)
            and a
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            (or semigroup object)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/internalisation"} internalise
            the above. For instance, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi S
                  %mo ⊗
                  %mi S
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} m: S \otimes S \to S
            is the binary multiplication and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo =
                  %mi m
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi m
                  %mo ⊗
                  %msub
                    %mn 1
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi m
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %msub
                    %mn 1
                    %mi S
                  %mo ⊗
                  %mi m
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi S
                  %mo ⊗
                  %mi S
                  %mo ⊗
                  %mi S
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mu = m \circ (m \otimes 1_S) = m \circ (1_S \otimes m): S \otimes S \otimes S \to S
            the ternary multiplication, a two-sided ideal is a
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi A
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} i: A \to S
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊗
                  %mi A
                  %mo ⊗
                  %mi S
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mn 1
                        %mi S
                      %mo ⊗
                      %mi i
                      %mo ⊗
                      %msub
                        %mn 1
                        %mi S
                  %mi S
                  %mo ⊗
                  %mi S
                  %mo ⊗
                  %mi S
                  %mover
                    %mo ⟶
                    %mi μ
                  %mi S
                %annotation{:encoding => "application/x-tex"} S \otimes A \otimes S \stackrel{1_S \otimes i \otimes 1_S}{\to} S \otimes S \otimes S \stackrel{\mu}{\longrightarrow} S
          %p
            factors through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} i: A \to S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi A
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} i: A \to S
            is not necessarily a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/submonoid"} submonoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %mi I
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} e: I \to S
            need not factor through
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} i: A \to S
          %p
            In particular for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            and the corresponding notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/ideal+in+a+ring"} ideal in a ring
            is the most common notion of ideal.
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/ideal"} ideal
            for ideals in more well known contexts: commutative idempotent monoids (
            %a.existingWikiWord{:href => "/nlab/show/semilattices"}> semilattices
            ) and monoids in
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            (
            %a.existingWikiWord{:href => "/nlab/show/rings"}> rings
            ).
          %h2#properties_and_constructions Properties and constructions
          %p
            An ideal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (on either side) must be a
            %span.newWikiWord
              subsemigroup
              %a{:href => "/nlab/new/subsemigroup"} ?
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/submonoid"} submonoid
            iff
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} 1 \in A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi S
                  %annotation{:encoding => "application/x-tex"} A = S
          %h3#ideals_forming_a_quantale Ideals forming a quantale
          %p
            (Two-sided) ideals of a monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are frequently the elements of a
            %a.existingWikiWord{:href => "/nlab/show/quantale"} quantale
            whose multiplication is called taking the
            = succeed "." do
              %em product of ideals
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mi J
                %annotation{:encoding => "application/x-tex"} I J
            of ideals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ,
                  %mi J
                  %mo ⊆
                  %mi R
                %annotation{:encoding => "application/x-tex"} I, J \subseteq R
            is the smallest ideal containing all products
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mi j
                    %mo :
                    %mi i
                    %mo ∈
                    %mi I
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} i j: i \in I, j \in J
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/residuated+lattice"} residuated lattice
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} /
                  %mi J
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi r
                  %mo ∈
                  %mi R
                  %mo :
                  %mi r
                  %mi J
                  %mo ⊆
                  %mi K
                  %mo{:stretchy => "false"} }
                  %mo ;
                  %mspace{:width => "2em"}
                  %mi I
                  %mo \
                  %mi K
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi r
                  %mo ∈
                  %mi R
                  %mo :
                  %mi I
                  %mi r
                  %mo ⊆
                  %mi K
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} K/J \coloneqq \{r \in R: r J \subseteq K\}; \qquad I\backslash K = \{r \in R: I r \subseteq K\}
          %p
            satisfying the expected
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjointness
            relations:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊆
                  %mi K
                  %mo{:stretchy => "false"} /
                  %mi J
                %annotation{:encoding => "application/x-tex"} I \subseteq K/J
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mi J
                  %mo ⊆
                  %mi K
                %annotation{:encoding => "application/x-tex"} I J \subseteq K
            iff
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊆
                    %mi I
                    %mo \
                    %mi K
                  %annotation{:encoding => "application/x-tex"} J \subseteq I\backslash K
          %p A reasonably general context might be as follows.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            be a
            %a.existingWikiWord{:href => "/nlab/show/well-powered+category"} well-powered
            %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular
            %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
            (‘cosmos’ in the sense of complete cocomplete symmetric monoidal closed category). Just using the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            is a cosmos, we may construct a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+bicategory"} monoidal bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(\mathbf{C})
            whose objects are monoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi T
                %annotation{:encoding => "application/x-tex"} S \to T
            are left-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            right-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/modules"} modules
          %p
            For each monoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod(\mathbf{C})
            whose only object is
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/biclosed+monoidal+category"} biclosed monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi S
                %annotation{:encoding => "application/x-tex"} Mod_S
            whose objects are bimodules, i.e., 1-morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} S \to S
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Mod(\mathbf{C})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            with its standard
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
