                        %a.existingWikiWord{:href => "/nlab/show/ideal+in+a+monoid"} ideal in a monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/principal+ideal+in+a+monoid"} principal ideal in a monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/commutative+monoid"} commutative monoid
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+commutative+monoids"} tensor product of commutative monoids
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/cancellative+monoid"} cancellative monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/GCD+monoid"} GCD monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/unique+factorization+monoid"} unique factorization monoid
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/B%C3%A9zout+monoid"} Bézout monoid
                    %li
                      %p
