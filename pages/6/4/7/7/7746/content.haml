                    %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism representation
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi A
                        %annotation{:encoding => "application/x-tex"} \phantom{A}
          %h2#References References
          %h3#general General
          %p The definition appears in section 3 of
          %ul
            %li#Francis
              %a.existingWikiWord{:href => "/nlab/show/John+Francis"}> John Francis
              ,
              %em
                The tangent complex and Hochschild cohomology of
                = succeed "-rings" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℰ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathcal{E}_n
              (
              %a{:href => "http://arxiv.org/abs/1104.0181"}> arXiv:1104.0181
              )
          %p A detailed account is in
          %ul
            %li#Francisb
              %a.existingWikiWord{:href => "/nlab/show/David+Ayala"}> David Ayala
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
              = succeed "," do
                %em Factorization homology of topological manifolds
              %strong 8
              4 (2015) 1045-1084 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1206.5522"}> arXiv:1206.5522
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1112/jtopol/jtv028"} doi:10.1112/jtopol/jtv028
          %p
            A survey that also covers
            %a.existingWikiWord{:href => "/nlab/show/factorization+algebras"} factorization algebras
            is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gr%C3%A9gory+Ginot"}> Grégory Ginot
              ,
              = succeed "," do
                %em Notes on factorization algebras, factorization homology and applications
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1307.5213"} arXiv:1307.5213
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hiro+Lee+Tanaka"}> Hiro Lee Tanaka
                ,
                = succeed "," do
                  %em Manifold calculus is dual to factorization homology
                %a{:href => "http://math.mit.edu/conferences/talbot/2012/_2012.php"} Talbot 2012:_ Calculus of functors
                (
                %a{:href => "http://math.mit.edu/conferences/talbot/2012/notes/14_Tanaka_FactorizationHomology%28hiro%29.pdf"}> pdf
                )
          %p
            Generalization to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tim+Weelinck"}> Tim Weelinck
              ,
              %em Equivariant factorization homology of global quotient orbifolds
              (
              %a{:href => "https://arxiv.org/abs/1810.12021"}> arXiv:1810.12021
              ,
              = succeed ")" do
                %a{:href => "https://www.maths.ed.ac.uk/~tweelinck/efhqsp.pdf"} talk pdf
          %p Some applications are
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ben+Knudsen"}> Ben Knudsen
                ,
                = succeed "," do
                  %em Betti numbers and stability for configuration spaces via factorization homology
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/1405.6696"} arXiv:1405.6696
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Quoc+Ho"}> Quoc Ho
                ,
                = succeed "," do
                  %em Densities and stability via factorization homology
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1802.07948"} arXiv:1802.07948
          %p
            Application to higher
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
            is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gr%C3%A9gory+Ginot"}> Grégory Ginot
                , Thomas Tradler,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mahmoud+Zeinalian"} Mahmoud Zeinalian
                = succeed "," do
                  %em
                    Higher Hochschild cohomology, Brane topology and centralizers of
                    = succeed "-algebra" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi E
                              %mi n
                          %annotation{:encoding => "application/x-tex"} E_n
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1205.7056"} arXiv:1205.7056
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Geoffroy+Horel"}> Geoffroy Horel
                ,
                = succeed "," do
                  %em Higher Hochschild homology of the Lubin-Tate ring spectrum
                %strong 15
                (2015) 3215-3252 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1311.2805"}> arXiv:1311.2805
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2015.15.3215"} doi:10.2140/agt.2015.15.3215
          %p Application to stratified spaces with tangential structures is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ayala"}> David Ayala
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hiro+Lee+Tanaka"} Hiro Lee Tanaka
              = succeed "," do
                %em Factorization homology of stratified spaces
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/1409.0848"} arXiv:1409.0848
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/duality"} duality
            theorem for factorization homology, generalizing
            %a.existingWikiWord{:href => "/nlab/show/Poincare+duality"} Poincare duality
            for
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            and
            %a.existingWikiWord{:href => "/nlab/show/Koszul+duality"} Koszul duality
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/E-n+algebras"} E-n algebras
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/David+Ayala"}> David Ayala
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
              = succeed "," do
                %em Poincaré/Koszul duality
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1409.2478"} arXiv:1409.2478
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            appears in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Claudia+Scheimbauer"}> Claudia Scheimbauer
                ,
                %em Factorization homology as a fully extended topological field theory
                (
                %a{:href => "https://people.maths.ox.ac.uk/scheimbauer/ScheimbauerThesis.pdf"}> pdf
                )
            %li
              %p
                %a{:href => "http://www.birs.ca/events/2015/5-day-workshops/15w5125/videos"} Videos from from the BIRS Workshop 15w5125
                on
                = succeed "." do
                  %em Factorizable Structures in Topology and Algebraic Geometry
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/surfaces"} surfaces
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/flat+connections"} flat connections
            for a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
          %ul
            %li{:id => "KellerMüller23"}
              %a.existingWikiWord{:href => "/nlab/show/Corina+Keller"}> Corina Keller
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lukas+M%C3%BCller"} Lukas Müller
              = succeed "," do
                %em Finite symmetries of quantum character stacks
              %strong 39
              3 (2023) 51-97 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2107.12348"}> arXiv:2107.12348
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/39/3/39-03abs.html"} tac:39-03
          %p Survey:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Corina+Keller"}> Corina Keller
                ,
                = succeed "," do
                  %em Twisted Character Varieties and Quantization via Factorization Homology
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.48660/21100028"} doi:10.48660/21100028
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lukas+M%C3%BCller"}> Lukas Müller
                ,
                = succeed "," do
                  %em Deformation quantization and categorical factorization homology
                %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
                (Mar 2023) &amp;lbrack;
                %a{:href => "Center+for+Quantum+and+Topological+Systems#MuellerMar2023"}> web
                , video:
                %a{:href => "https://www.youtube.com/watch?v=kC488wISPX4"}> YT
                \&amp;rbrack;
          %h3#relation_to_cohomology_of_configuration_spaces Relation to cohomology of configuration spaces
          %p
            Expressing the
            %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
            of
            %a.existingWikiWord{:href => "/nlab/show/ordered+configuration+spaces+of+points"} ordered configuration spaces of points
            via
            %a.existingWikiWord{:href => "/nlab/show/factorization+homology"} factorization homology
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ran+spaces"} Ran spaces
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/representation+stability"} representation stability
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Quoc+P.+Ho"}> Quoc P. Ho
              ,
              %em Higher representation stability for ordered configuration spaces and twisted commutative factorization algebras
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2004.00252"}> arXiv:2004.00252
              \&amp;rbrack;
        .revisedby
