          %h2#idea Idea
          %p
            %em Factorization homology
            is a notion of
            %a.existingWikiWord{:href => "/nlab/show/homology+theory"} homology theory
            for
            %a.existingWikiWord{:href => "/nlab/show/framed+manifold"} framed
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            with coefficients in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/En-algebras"} En-algebras
            = succeed "." do
              %a{:href => "#Francis"} Francis 2011
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/factorization+algebras"} factorization algebras
            %em
              %a.existingWikiWord{:href => "/nlab/show/blob+homology"} blob homology
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/topological+chiral+homology"} topological chiral homology
            %a.existingWikiWord{:href => "/nlab/show/topological+chiral+homology"} topological chiral homology
            (
            %a{:href => "#Francisb"}> Francis b
            ).
          %h2#definition Definition
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Mfd
                    %mi n
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                %annotation{:encoding => "application/x-tex"} Mfd_n^{\coprod}
            for the category of
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            with
            %a.existingWikiWord{:href => "/nlab/show/embeddings"} embeddings
            as morphisms. This is naturally a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+category"} topological category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (infinity,1)-category
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
            with
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            given by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi k
                %annotation{:encoding => "application/x-tex"} Mod_k
            for the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} symmetric monoidal (∞,1)-category
            of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi Mfd
                    %mi n
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mo ,
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H(Mfd_n^{\coprod}, Mod_k)
            be the
            %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
            of those
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-functors"} monoidal (∞,1)-functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msubsup
                    %mi Mfd
                    %mi n
                    %mi op
                  %mo →
                  %msub
                    %mi Mod
                    %mi k
                %annotation{:encoding => "application/x-tex"} F : Mfd_n^{op} \to Mod_k
            which are “
            %a.existingWikiWord{:href => "/nlab/show/cosheaves"}> cosheaves
            ” in that for any decomposition of a manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into submanifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ′
                %annotation{:encoding => "application/x-tex"} X'
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ″
                %annotation{:encoding => "application/x-tex"} X''
            with overlap
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                  %annotation{:encoding => "application/x-tex"} O
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi O
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ″
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F(X) \simeq F(X') \otimes_{F(O)}F(X'')
                  \\,.
          %p
            Next, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Disk
                    %mi n
                  %mo ⊂
                  %msub
                    %mi Mfd
                    %mi n
                %annotation{:encoding => "application/x-tex"} Disk_n \subset Mfd_n
            be the full
            %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
            on those
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            which are finite
            %a.existingWikiWord{:href => "/nlab/show/disjoint+unions"} disjoint unions
            of the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
          %p
            Restriction along this inclusion gives an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Mfd
                    %mi n
                  %mo ,
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Disk
                    %mi n
                  %mo −
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H(Mfd_n, Mod_k)
                  \\to
                  Disk_n-Alg (Mod_k)
          %p
            This turns out to be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            %em factorization homology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FactorizationHomology
                  %mo :
                  %msub
                    %mi Disk
                    %mi n
                  %mo −
                  %mi Alg
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Mfd
                    %mi n
                  %mo ,
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  FactorizationHomology
                  \:
                  Disk_n-Alg (Mod_k)
                  \\to
                  H(Mfd_n, Mod_k)
                  \\,.
          %p
            which sends an
            = succeed "-disk" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo :
                  %msub
                    %mi Disk
                    %mi n
                  %mo →
                  %msub
                    %mi Mod
                    %mi k
                %annotation{:encoding => "application/x-tex"} A : Disk_n \to Mod_k
            to the functor that sends a manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∫
                    %mi X
                  %mi A
                  %mo =
                  %msub
                    %mi 𝔼
                    %mi X
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi Disk
                        %mi n
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  \\int^X A = \mathbb{E}_X \otimes_{Disk_n} A
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝔼
                    %mi X
                  %mo :
                  %msub
                    %mi Disk
                    %mi n
                  %mover
                    %mo →
                    %mrow
                      %mi Emb
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mi Top
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi Mod
                    %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{E}_X
                  \:
                  Disk_n \stackrel{Emb(-,X)}{\to} Top \stackrel{C_\bullet(-)}{\to} Mod_k
                  \\,.
          %p
            This is equivalent to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+chiral+homology"} topological chiral homology
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chiral+algebras"} chiral algebras
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            instead of chain complexes was given by Salvatore and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"} Graeme Segal
          %h2#properties Properties
          %h3#relation_to_cobordism_hypothsis Relation to cobordism hypothsis
          %p
            From a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ∈
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Mfd
                    %mi n
                  %mo ,
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F \in H(Mfd_n, Mod_k)
            we get an
            %a.existingWikiWord{:href => "/nlab/show/extended+TQFT"} extended TQFT
            with values in
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,n)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Z
                    %mi F
                  %mo :
                  %msub
                    %mi Bord
                    %mi n
                  %mo →
                  %msub
                    %mi Cat
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z_F : Bord_n \to Cat_n(k)
            which sends a
            = succeed "-manifold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X \times \mathbb{R}^{n-k})
            %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
            between the analogous boundary restriction, and hence as a
            %a.existingWikiWord{:href => "/nlab/show/n-morphism"} k-morphism
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat_n(k)
          %p
            From a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Disk
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Disk_n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            we obtain the corresponding
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi A
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Cat
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi k
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi dualizable
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}A \in (Cat_n(k)_{dualizable})^{O(n)}
            which is a
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-category"} (infinity,n)-category
            that is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fully+dualizable+object"} fully dualizable object
            %a.existingWikiWord{:href => "/nlab/show/cobordism+hypothesis"} cobordism hypothesis
            identifies this with cobordism representations, and the claim is that this identification is compatible factorization homology.
          %h2#examples Examples
          %h3#dimension_1 Dimension 1
          %p
            A
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Disk
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Disk_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Mod
                    %mi k
                %annotation{:encoding => "application/x-tex"} Mod_k
            is equivalently a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
          %p
            The value of the corresponding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mi A
                  %mo ∈
                  %mi H
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Mfd
                    %mn 1
                  %mo ,
                  %msub
                    %mi Mod
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_A \in H(Mfd_1, Mod_k)
            on the circle is the
            %a.existingWikiWord{:href => "/nlab/show/Hochschild+homology"} Hochschild homology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi A
                  %mo ≃
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 1
                  %mi A
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi S
                            %mn 0
                          %mo ×
                          %mi ℝ
                      %mi A
                  %msub
                    %mo ∫
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 1
                  %mi A
                  %mo ≃
                  %msub
                    %mi HH
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_{S^1} A \simeq \int_{\mathbb{R}^1} A \otimes_{\int_{S^0 \times \mathbb{R}}A} \int_{\mathbb{R}^1} A \simeq HH_\bullet(A)
                  \\,.
          %h3#from_fold_loop_spaces
            From
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            we get a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Disk
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Disk_n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Disk
                    %mi n
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi Maps
                        %mi compact
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi Z
                      %mo{:stretchy => "false"} )
                  %mi Top
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi C
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi Mod
                    %mi k
                %annotation{:encoding => "application/x-tex"}
                  Disk_n^\coprod
                  \\stackrel{Maps_{compact}(-,Z)}{\to}
                  Top
                  \\stackrel{C_\ast(-)}{\to} Mod_k
          %p
            Where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Maps
                    %mi compact
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi Ω
                    %mi n
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Maps_{compact}(\mathbb{R}^n, Z) \simeq \Omega^n Z
            is the
            %a.existingWikiWord{:href => "/nlab/show/n-fold+loop+space"} n-fold loop space
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
          %p
            %strong Theorem
            (Salvatore and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"} Lurie
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                %annotation{:encoding => "application/x-tex"} Z
            is
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %a.existingWikiWord{:href => "/nlab/show/n-connected+object+of+an+%28infinity%2C1%29-category"} n-connected object of an (infinity,1)-category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %msub
                    %mi C
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Ω
                    %mi n
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi C
                    %mo *
                  %msub
                    %mi Maps
                    %mi compact
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi Z
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_X C_\ast(\Omega^n Z) \simeq C_\ast Maps_{compact}(X,Z)
                  \\,.
