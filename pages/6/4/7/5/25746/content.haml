                    \\array{
                    G \cdot \mathscr{V}
                    \&amp;\xrightarrow{\;\; \mathscr{q} \;\;}&amp;
                    \\mathscr{V}
                    \\\
                    (g,v) &amp;\mapsto&amp; \rho(g)(v)
                    }
            %p
          %p
            It follows that:
          #LocalSystemsAreFreeHomotopyQuasiCoproductCompletion.num_theorem
            %h6 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              has all
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Loc
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Loc_{\mathcal{C}}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfLocalSystems"}
              = succeed ")." do
                %a.maruku-ref{:href => "#FreeHomotopyQuasiCoproductCompletion"}
          .proof
            %h6 Proof
            %p
              First,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Loc
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Loc_{\mathcal{C}}
              is canonically tensored over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Grpd
              (by Rem.
              = succeed ")" do
                %a.maruku-ref{:href => "#TensoringOfLocalSystemsOverGroupoids"}
              = succeed ")" do
                %a.maruku-ref{:href => "#BifibrantCategoryOfLocalSystems"}
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryWithHomotopicalQuasiCoproducts"}
            %p
              Moreover, by Lemma
              %a.maruku-ref{:href => "#AllLocalSystemsAreGrpdTensoringsOfCoproductsOfSkeletalLocalSystems"}
              and Lemma
              %a.maruku-ref{:href => "#GroupRepresentationsAreQuasiCoproductsOfConstantLocalSystems"}
              every object of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Loc
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Loc_{\mathcal{C}}
              is a coproduct of
              = succeed "-tensorings" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} Grpd
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ConstantLocalSystem"} (6)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Loc
                      %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Loc_{\mathcal{C}}
              which preserves the
              = succeed "-tensoring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} Grpd
          %h2#references References
          %p
