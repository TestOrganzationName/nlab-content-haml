                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a category, its
              %em free homotopy quasi-coproduct completion
              is
            %ul
              %li
                a category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} QC(\mathcal{C})
                with homotopy quasi-products (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryWithHomotopicalQuasiCoproducts"}
            %p equipped with
            %ul
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                inclusion
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo ↪
                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
