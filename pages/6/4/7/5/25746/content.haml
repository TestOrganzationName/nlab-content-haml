              is isomorphic to one pulled back from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G_i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CoDisc
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒳
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} CoDisc\big(Obj(\mathcal{X}_i)\big)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
