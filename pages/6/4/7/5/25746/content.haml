          %p
          #GroupRepresentationsAreQuasiCoproductsOfConstantLocalSystems.num_lemma
            %h6 Lemma
            %p
              %strong (group representations are quasi-coproducts of constant local systems)
              %br/
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
