          %h2#idea Idea
          %p Noticing hat
          %ol
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                is the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                over its
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                elements,
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoid"} skeletal groupoid
                is the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                over its
                %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoids"} delooping groupoids
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/automorphism+groups"} automorphism groups
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                is a
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                over a
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                of the shape of a
                %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
                (a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ↪
                    %annotation{:encoding => "application/x-tex"} \hookrightarrow
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %p
            it makes sense, in
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theoretic
            generalization of coproducts, to consider
            %em quasi-coproducts
            \&amp;lbrack;
            %a{:href => "#HuTholen96"}> Hu &amp; Tholen (1996)
            \&amp;rbrack; to be colimits over diagrams of the shape of
            %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoids"} skeletal groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Grpd
                    %mi skl
                  %mo ↪
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Grpd_{skl} \hookrightarrow Cat
            which are degreewise
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/free+actions"} free actions
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
          %h2#definition Definition
          %h3#quasicoproducts Quasi-coproducts
          %p
          #QuasiCoproduct.num_defn
            %h6 Definition
            %p
              A
              %em quasi-coproduct
              in a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over a
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi.mathscript 𝒱
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒢
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathscr{V}_{(-)}
                    \\,\colon\,
                    \\mathcal{G} \longrightarrow \mathcal{C}
            %p
              of the shape of a
              %a.existingWikiWord{:href => "/nlab/show/skeletal+groupoid"} skeletal groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Grpd
                      %mi skl
                    %mo ↪
                  %annotation{:encoding => "application/x-tex"} \mathcal{G} \,\in\, Grpd_{skl} \hookrightarrow
              such that the following condition is satisfied
            %ul
              %li
                for all
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mi i
                      %mo ↪
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G_i \hookrightarrow \mathcal{G}
                and all non-
                %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript 𝒲
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathscr{W} \,\in\, \mathcal{C}
                the
                %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
                in
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                given by the composite with the
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi.mathscript 𝒲
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}(\mathscr{W},-)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mi i
                        %mo ↪
                        %mi 𝒢
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi.mathscript 𝒱
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                        %mi 𝒞
                        %mover
                          %mo ⟶
                          %mrow
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi.mathscript 𝒲
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mi Set
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{B}G_i
                        \\hookrightarrow
                        \\mathcal{G}
                        \\overset{
                        \\mathscr{V}_{(-)}
                        }{\longrightarrow}
                        \\mathcal{C}
                        \\overset{\mathcal{C}(\mathscr{W},-)}{\longrightarrow}
                        Set
                %p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/free+action"} free action
            %p
          \&amp;lbrack;
          %a{:href => "#HuTholen96"}> Hu &amp; Tholen (1996), §1.3
          \&amp;rbrack;
          %h3#homotopy_quasicoproducts Homotopy quasi-coproducts
          %p
            The following Def.
            %a.maruku-ref{:href => "#CategoryWithHomotopicalQuasiCoproducts"}
            is a slight variant/specialization of Def.
            = succeed "," do
              %a.maruku-ref{:href => "#QuasiCoproduct"}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
            (One may consider other variants, for instance with respect to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopical+categories"} homotopical categories
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            generalized to
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/enriched+groupoids"} enriched groupoids
            aka “
            %a.existingWikiWord{:href => "/nlab/show/simplicial+groupoids"}> simplicial groupoids
            ” regarded as models for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoids
          %p
            Here, in the vein of speaking obout
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theoretic
            models for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            %em
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            we mean
            %em
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict
            groupoids (as usual), and we regard the collection
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            as a
            %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            (with
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            as the morphisms).
          %p
          #DeloopingGroupoids.num_defn
            %h6 Definition
            %p
              %strong (conventions for delooping groupoids)
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi{:mathvariant => "normal"} e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G, \mu, \mathrm{e})
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mspace{:width => "thinmathspace"}
                        %mo ≡
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ⇉
                        %mi pt
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}G \,\equiv\, (G \rightrightarrows pt)
                %p
                  for its
                  %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
                  with
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  given by reverse multiplication in
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
