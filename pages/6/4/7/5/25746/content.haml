          %p it ought to be the case that
          %ul
            %li
              %p
                the free homotopy quasi-coproduct completion of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is the
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Loc
                        %mi 𝒞
