              = succeed "," do
                %a.maruku-eqref{:href => "#eq:GroupRepresentationsAsFunctors"} (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
