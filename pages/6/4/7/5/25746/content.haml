                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} QC(\mathcal{C}) \longrightarrow \mathcal{D}
                  to another category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
                  with homotopy quasi-coproducts which
                  %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserve
                %ol
                  %li
                    %p
                      the
                      = succeed "-tensoring" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
