          %h2#idea Idea
          %p
            Given a small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            of “primitive objects”, we can think of a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mspace{:width => "mediummathspace"}
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F:\: C^{op} \to Set
            as being a more complex object built out of primitive objects:
          %ul
            %li
              %p
                Given a primitive object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(X)
                as a set representing the ways
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                occurs inside
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %li
              %p
                Given a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f:\: X \to Y
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(f):\: F(Y) \to F(X)
                as the function mapping each occurrence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                to the corresponding suboccurrence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                (included in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                through
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
          %p Such functors are called presheaves.
          %h2#definition Definition
          %p
            A
            %strong presheaf
            on a
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mspace{:width => "mediummathspace"}
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"}
                  F:\: C^{op} \to Set
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to the category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %a.existingWikiWord{:href => "/nlab/show/contravariant+functor"} contravariant functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mspace{:width => "mediummathspace"}
                    %mi C
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F:\: C \to Set
          %p
            More generally, given any category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              \-valued presheaf
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mspace{:width => "mediummathspace"}
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi S
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F:\: C^{op} \to S.
          %p
            While, hence, presheaves are just
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            (on
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
            %em
              %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
            of the functor/presheaf, or at least interest in the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            as a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/concept+with+an+attitude"} concept with an attitude
          %p
            Historically, the initial applications of presheaves and sheaves involved cases like
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                %annotation{:encoding => "application/x-tex"} S =
            %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            (the category of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative rings
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                %annotation{:encoding => "application/x-tex"} S =
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            (
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"}> abelian groups
            ),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                %annotation{:encoding => "application/x-tex"} S =
            %a.existingWikiWord{:href => "/nlab/show/Mod"} RMod
            (
            %a.existingWikiWord{:href => "/nlab/show/modules"}> modules
            ), etc. Later, especially with the development of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} category of set-valued (pre)sheaves
            as a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            was recognized; these other cases could be considered algebraic objects which live in the topos. This article and the one on
            %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            recognize these later developments by making the set-valued case the default (in other words, presheaf or sheaf without further qualification is understood to refer to the set-valued case).
          %p
            The
            %strong
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                %annotation{:encoding => "application/x-tex"} Set^{C^{op}}
            or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C^{op},Set]
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi C
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{C}
          %ul
            %li
              %p
                functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} F:\: C^{op} \to Set
                as objects;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformations
                between such functors as morphisms.
          %p
            As such, it is an example of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
          %h2#remarks Remarks
          %ul
            %li
              %p Speaking of functors as presheaves indicates operations that one wants to do apply to these functors, or certain properties that one wants to check.
              %ul
                %li
                  %p
                    when
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi S
                            %mo =
                            %mi Set
                          %annotation{:encoding => "application/x-tex"} S = Set
                    %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                    of a category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                        %annotation{:encoding => "application/x-tex"} C
                    into its presheaf category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi C
                            %mi op
                          %mo ,
                          %mi Set
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [C^{op}, Set]
                    for purposes of studying, for instance,
                    = succeed "s," do
                      %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                    = succeed "s," do
                      %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                    = succeed "s," do
                      %a.existingWikiWord{:href => "/nlab/show/ind-object"} ind-object
                    = succeed "s" do
                      %a.existingWikiWord{:href => "/nlab/show/pro-object"} pro-object
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                          %annotation{:encoding => "application/x-tex"} C
                %li
                  %p
                    or when there is the structure of a
                    %a.existingWikiWord{:href => "/nlab/show/site"} site
                    on
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                          %annotation{:encoding => "application/x-tex"} C
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %li
              %p
                One generally useful way to think of presheaves is in the sense of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/space+and+quantity"} space and quantity
            %li
              %p
                In the case where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo =
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} S = Set
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op},Set]
                is the
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+extension"} Yoneda extension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and ‘freely throwing in small colimits’. The category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is contained in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op},Set]
                via the
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi C
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Y:\: C \to [C^{op},Set]
              %p
                The Yoneda embedding sends each object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
                to the presheaf
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(-) = hom(-, c)
              %p
                Presheaves of this form, or isomorphic to those of this form, are called
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/representable+functors"} representable
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} C^{op}
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                turns colimits in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                (i.e., limits in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mi op
                      %annotation{:encoding => "application/x-tex"} C^{op}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                (i.e., colimits in
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Set
                          %mi op
                      %annotation{:encoding => "application/x-tex"} Set^{op}
                %em is
                sufficient when
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                itself is a presheaf category. To see this, suppose
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                is such a presheaf on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo =
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi D
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} C = [D^{op}, Set]
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo =
                        %mi K
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} G = K Y
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi D
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [D^{op}, Set](Y(-), G)
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mi Y
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K Y(-)
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [C^{op}, Set](-, G)
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} K(-)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
          %h2#properties Properties
          %h3#limits_and_colimits Limits and colimits
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            is
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            %a.existingWikiWord{:href => "/nlab/show/limit"} limits
            and
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimits
            being computed
            = succeed "." do
              %em pointwise
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mspace{:width => "mediummathspace"}
                    %mi D
                    %mo →
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                  %annotation{:encoding => "application/x-tex"} F:\: D \to Set^{C^op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mspace{:width => "mediummathspace"}
                  %mi D
                  %mo ×
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F:\: D \times C^{op} \to Set
            and take the limit or colimit in the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            variable.
          %h3#PresheavesAreColimitsOfRepresentables Presheaves are colimits of representables
          %p
          #EveryPresheafIsColimitOfRepresentables.num_prop
            %h6 Proposition
            %p
              Every presheaf is a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable presheaves
          %p
            An elegant way to express this colimit for a presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mspace{:width => "mediummathspace"}
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F:\: C^{op} \to Set
            is in terms of the
            %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            identity
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mo ∫
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msub
                    %mi hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  F(-) = \int^{c \in C} F(c) \times hom_C(-,c)
                  \\,,
          %p
            which follows by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+reduction"} Yoneda reduction
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
          %p
            More concretely: let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mspace{:width => "mediummathspace"}
                  %mi C
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi C
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} Y:\: C \to [C^{op}, Set]
            denote the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi F
                  %mo ≔
                  %mi Y
                  %mo{:stretchy => "false"} /
                  %mi F
                %annotation{:encoding => "application/x-tex"} C_F \coloneqq Y/F
            be the corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
            %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi F
                  %mo ≔
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi Y
                                %mo{:stretchy => "false"} (
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mi f
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mrow
                                %mi f
                                %mo ′
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi F
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  C_F \coloneqq
                  \\left\lbrace
                  \\array{
                  Y(V) &amp;&amp;\stackrel{Y(g)}{\to}&amp;&amp; Y(V')
                  \\\
                  \&amp; {}_f\searrow &amp;&amp; \swarrow_{f'}
                  \\\
                  \&amp;&amp; F
                  }
                  \\right\rbrace
          %p
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mspace{:width => "mediummathspace"}
                  %msub
                    %mi C
                    %mi F
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} p:\: C_F \to C
            the canonical forgetful functor. Then the colimit over representables expression
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ≃
                  %msub
                    %mi colim
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi C
                        %mi F
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ∘
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F \simeq colim_{(Y(V) \to F) \in C_F} (Y\circ p)
                  \\,.
          %p This is often written with some convenient abuse of notation as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ≃
                  %msub
                    %mi colim
                    %mrow
                      %mi V
                      %mo →
                      %mi F
                  %mi V
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F \simeq colim_{V \to F} V
                  \\,.
          %p
            Notice that these formulas can also be understood as those for the left
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            (see there) of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            along the identity functor.
          .proof
            %h6#proof Proof
            %p
              Notice that for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} B \in [C^{op}, Set]
              and using the property of the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi C
                                  %mi op
                                %mo ,
                                %mi Set
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi colim
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                                %mo →
                                %mi F
                                %mo{:stretchy => "false"} )
                                %mo ∈
                                %msub
                                  %mi C
                                  %mi F
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ∘
                            %mi p
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi lim
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                                %mo →
                                %mi F
                                %mo{:stretchy => "false"} )
                                %mo ∈
                                %msub
                                  %mi C
                                  %mi F
                            %msub
                              %mi Hom
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msup
                                  %mi C
                                  %mi op
                                %mo ,
                                %mi Set
                                %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi lim
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                                %mo →
                                %mi F
                                %mo{:stretchy => "false"} )
                                %mo ∈
                                %msub
                                  %mi C
                                  %mi F
                            %mi B
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Hom_{[C^{op}, Set]}(colim_{(Y(V) \to F) \in C_F} (Y\circ p),B)
                    \&amp;\simeq
                    lim_{(Y(V) \to F) \in C_F} Hom_{[C^{op}, Set]}(Y(V),B)
                    \\\
                    \&amp; \simeq
                    lim_{(Y(V) \to F) \in C_F} B(V)
                    \\end{aligned}
            %p
              by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
            %p
              By the definition of
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo =
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msubsup
                          %mi C
                          %mi F
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi pt
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \cdots=Hom_{[C_F^{op}, Set]}(pt,B),
            %p
              so for each natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msubsup
                          %mi C
                          %mi F
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi pt
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in Hom_{[C_F^{op}, Set]}(pt,B)
              and each object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mo ∈
                      %msub
                        %mi C
                        %mi F
                    %annotation{:encoding => "application/x-tex"} h:\: Y(V)\to F\in C_F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi h
                  %annotation{:encoding => "application/x-tex"} \alpha_h
              is a map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mo *
                      %mo{:stretchy => "false"} }
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \{*\}\to B(V)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mspace{:width => "mediummathspace"}
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi F
                    %mo ∈
                    %msub
                      %mi C
                      %mi F
                  %annotation{:encoding => "application/x-tex"} h:\: Y(V)\to F\in C_F
              specifies a unique element
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} h\in F(V)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              specifies a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(V)\to B(V)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              induces a natural transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mi α
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi F
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} k^\alpha:\: F\to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              defines an isomorphism:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msubsup
                          %mi C
                          %mi F
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi pt
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi C
                          %mi op
                        %mo ,
                        %mi Set
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{[C_F^{op}, Set]}(pt,B) \simeq Hom_{[C^{op}, Set]}(F,B)
                    \\,.
            %p
              Since this holds for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          %h2#special_cases Special cases
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable presheaf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/concrete+presheaf"} concrete presheaf
          %h2#examples Examples
          %p Examples for presheaves are abundant. Here is a non-representative selection of some examples.
          %ul
            %li
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                a
                %a.existingWikiWord{:href => "/nlab/show/locally+small"} locally small
                category, every object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c \in C
                gives rise to the
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable presheaf
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mspace{:width => "mediummathspace"}
                        %msup
                          %mi C
                          %mi op
                        %mo →
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Hom_C(-, c):\: C^{op} \to Set
            %li
              %p
                More generally, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi C
                      %mo ↪
                      %mi D
                    %annotation{:encoding => "application/x-tex"} i:\: C \hookrightarrow D
                a
                %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                of a locally small category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi D
                    %annotation{:encoding => "application/x-tex"} d \in D
                gives rise to the presheaf
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi D
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Set
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom_D(i(-), d):\: C^{op} \to Set
                      \\,.
              %p
                Let’s spell this out in more detail: given a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi V
                      %mo →
                      %mi U
                    %annotation{:encoding => "application/x-tex"} \phi:\: V \to U
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f:\: i(U) \to X
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi D
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{D}(U,X)
                and turn it into a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mover
                        %mo →
                        %mi ϕ
                      %mi U
                      %mover
                        %mo →
                        %mi f
                      %mi X
                    %annotation{:encoding => "application/x-tex"} V \stackrel{\phi}{\to} U \stackrel{f}{\to} X
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi D
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Hom_{D}(i(V),X)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %mspace{:width => "mediummathspace"}
                      %msub
                        %mi Hom
                        %mi D
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Hom
                        %mi D
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f^*:\: Hom_{D}(i(U),X) \to Hom_{D}(i(V),X)
                      \\,.
              %p So we have a functorial assignment of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi W
                            %mtd
                            %mtd
                              %mo ↦
                            %mtd
                            %mtd
                              %msub
                                %mi Hom
                                %mi Diff
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo{:stretchy => "false"} (
                              %mi W
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mi g
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mrow
                                  %msup
                                    %mi g
                                    %mo *
                          %mtr
                            %mtd
                              %mi V
                            %mtd
                            %mtd
                              %mo ↦
                            %mtd
                            %mtd
                              %msub
                                %mi Hom
                                %mi Diff
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo{:stretchy => "false"} (
                              %mi V
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mi f
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mrow
                                  %msup
                                    %mi f
                                    %mo *
                          %mtr
                            %mtd
                              %mi U
                            %mtd
                            %mtd
                              %mo ↦
                            %mtd
                            %mtd
                              %msub
                                %mi Hom
                                %mi Diff
                              %mo{:stretchy => "false"} (
                              %mi i
                              %mo{:stretchy => "false"} (
                              %mi U
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi X
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      W &amp;&amp; \mapsto &amp;&amp; Hom_{Diff}(i(W),X)
                      \\\
                      \\downarrow^g &amp;&amp;&amp;&amp; \uparrow^{g^*}
                      \\\
                      V &amp;&amp; \mapsto &amp;&amp; Hom_{Diff}(i(V),X)
                      \\\
                      \\downarrow^f &amp;&amp;&amp;&amp; \uparrow^{f^*}
                      \\\
                      U &amp;&amp; \mapsto &amp;&amp; Hom_{Diff}(i(U),X)
                      }
                      \\,.
              %p
                Of course
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                here could be any functor whatsoever. Asking if such a presheaf is
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
                is asking for a right
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                      %annotation{:encoding => "application/x-tex"} i
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                is a presheaf on the
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/globular+set"} globular set
                is a presheaf on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/globe+category"} globe category
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/cubical+set"} cubical set
                is a presheaf on the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cube+category"} cube category
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
                is a
                %a.existingWikiWord{:href => "/nlab/show/concrete+presheaf"} concrete presheaf
                on
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            %li
              %p
                An important class of presheaves is those on a
                %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Op(X)
                of a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                or
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                Traditional standard examples include: the presheaf of
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \subset X
                the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo ,
                      %mi ℝ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^\infty(U,\mathbb{R})
                of smooth functions and to each inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊂
                      %mi U
                    %annotation{:encoding => "application/x-tex"} V \subset U
                the corresponding restriction operation of functions. This is further a sheaf.
            %li
              %p
                Traditional standard example which is a presheaf but not a sheaf: the presheaf of exact forms on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \subset X
                the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi exact
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{exact}(U)
                of exact forms on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                and to each inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⊂
                      %mi U
                    %annotation{:encoding => "application/x-tex"} V \subset U
                the corresponding restriction operation of functions. Here, and like above, the site is made up by open sets in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with inclusions as morphisms.
          %p … etc. pp.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%280%2C1%29-presheaf"} (0,1)-presheaf
            %li
              %p
                %strong presheaf
              %p
                %a.existingWikiWord{:href => "/nlab/show/constant+presheaf"} constant presheaf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-presheaf"} (2,1)-presheaf
              %p
                %a.existingWikiWord{:href => "/nlab/show/presheaf+of+groupoids"} presheaf of groupoids
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-presheaf"} (∞,1)-presheaf
              %p
                %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-presheaf"} (∞,n)-presheaf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"}> Yoneda lemma
                ,
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+extension"} Yoneda extension
