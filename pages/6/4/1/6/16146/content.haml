                        %mo :
                        %mi N
                        %mo ⊗
                        %mi A
                        %mo →
                        %mi N
                      %annotation{:encoding => "application/x-tex"}
                        \\rho : N \otimes A \to N
                %p
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %p
              such that this satisfies the axioms of a (right)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action"} action
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                            %mo ⊗
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi ρ
                                %mo ⊗
                                %msub
                                  %mi id
                                  %mi A
                          %mtd
                            %mi N
                            %mo ⊗
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ⋅
                                  %mo ⊗
                                  %msub
                                    %mi id
                                    %mi N
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                            %mi N
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo →
                              %mi ρ
                          %mtd
                            %mi N
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N \otimes A \otimes A &amp;\stackrel{\rho \otimes id_A}{\to}&amp; N \otimes A
                    \\\
                    \\downarrow^{\mathrlap{\cdot \otimes id_N}} &amp;&amp; \downarrow^{\mathrlap{\rho}}
                    \\\
                    N \otimes A &amp;\stackrel{\rho}{\to}&amp; N
                    }
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                            %mo ⊗
                            %mi I
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msub
                                  %mi id
                                  %mi N
                                %mo ⊗
                                %mi e
                          %mtd
                          %mtd
                            %mi N
                            %mo ⊗
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi ρ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi N
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N \otimes I &amp;&amp;\stackrel{id_N \otimes e}{\to}&amp;&amp; N \otimes A
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\rho}}
                    \\\
                    \&amp;&amp; N
                    }
                    \\,.
            %p
          %h2#examples Examples
          %h3#modules_over_monoids_in_abelian_groups Modules over monoids in abelian groups
          %p
            Recall that a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            in the category
            %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            with
            %a.existingWikiWord{:href => "/nlab/show/monoidal+structure"} monoidal structure
            given by the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            %em
              module over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            is a module in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ab
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Ab,\otimes)
            according to def.
            = succeed "." do
              %a.maruku-ref{:href => "#ModuleInMonoidalCategory"}
          %p
            We unwind what this means in terms of
            %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            regarded as
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            with extra
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
          #ModuleOverARing.num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              over a ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo ∈
                      %annotation{:encoding => "application/x-tex"} N \in
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %li
                %p
                  equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo :
                        %mi R
                        %mo ⊗
                        %mi N
                        %mo →
                        %mi N
                      %annotation{:encoding => "application/x-tex"}
                        \\alpha : R \otimes N \to N
                %p
                  in
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                  %a.existingWikiWord{:href => "/nlab/show/function"} function
                  of the underlying
                  %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                  that sends elements
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mi r
                        %mi n
                        %mo ≔
                        %mi α
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        (r,n) \mapsto  r n  \coloneqq \alpha(r,n)
                %p
                  and which is a
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+function"} bilinear function
                  in that it satisfies
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi r
                        %mo ,
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mi r
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %mi r
                        %msub
                          %mi n
                          %mn 2
                      %annotation{:encoding => "application/x-tex"}
                        (r, n_1 + n_2) \mapsto r n_1 + r n_2
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi r
                          %mn 1
                        %mo +
                        %msub
                          %mi r
                          %mn 2
                        %mo ,
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %msub
                          %mi r
                          %mn 1
                        %mi n
                        %mo +
                        %msub
                          %mi r
                          %mn 2
                        %mi n
                      %annotation{:encoding => "application/x-tex"}
                        (r_1 + r_2, n) \mapsto r_1 n + r_2 n
                %p
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi r
                        %mo ,
                        %msub
                          %mi r
                          %mn 1
                        %mo ,
                        %msub
                          %mi r
                          %mn 2
                        %mo ∈
                        %mi R
                      %annotation{:encoding => "application/x-tex"} r, r_1, r_2 \in R
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ,
                          %msub
                            %mi n
                            %mn 1
                          %mo ,
                          %msub
                            %mi n
                            %mn 2
                          %mo ∈
                          %mi N
                        %annotation{:encoding => "application/x-tex"} n,n_1, n_2 \in N
              %li
                %p
                  such that the
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi R
                                %mo ⊗
                                %mi R
                                %mo ⊗
                                %mi N
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mo ⋅
                                      %mi R
                                    %mo ⊗
                                    %msub
                                      %mi Id
                                      %mi N
                              %mtd
                                %mi R
                                %mo ⊗
                                %mi N
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi Id
                                        %mi R
                                      %mo ⊗
                                      %mi α
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mi α
                            %mtr
                              %mtd
                                %mi R
                                %mo ⊗
                                %mi N
                              %mtd
                                %mo →
                              %mtd
                                %mi N
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        R \otimes R \otimes N
                        \&amp;\stackrel{\cdot_R \otimes Id_N}{\to}&amp; R \otimes N
                        \\\
                        {}^{\mathllap{Id_R \otimes \alpha}}\downarrow
                        \&amp;&amp;
                        \\downarrow^{\mathrlap{\alpha}}
                        \\\
                        R \otimes N &amp;\to&amp; N
                        }
                %p
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutes
                  in
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi r
                          %mn 1
                        %mo ⋅
                        %msub
                          %mi r
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mi n
                        %mo =
                        %msub
                          %mi r
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi r
                          %mn 2
                        %mi n
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (r_1 \cdot r_2) n = r_1 (r_2 n)
                        \\,.
              %li
                %p such that the diagram
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mn 1
                                %mo ⊗
                                %mi N
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %mn 1
                                    %mo ⊗
                                    %msub
                                      %mi id
                                      %mi N
                              %mtd
                              %mtd
                                %mi R
                                %mo ⊗
                                %mi N
                            %mtr
                              %mtd
                              %mtd
                                %mo ↘
                              %mtd
                              %mtd
                                %msub
                                  %mo ↙
                                  %mpadded{:width => "0"}
                                    %mi α
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi N
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        1 \otimes N &amp;&amp;\stackrel{1 \otimes id_N}{\to}&amp;&amp; R \otimes N
                        \\\
                        \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{\alpha}}
                        \\\
                        \&amp;&amp; N
                        }
                %p commutes, which means that on elements as above
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo ⋅
                        %mi n
                        %mo =
                        %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        1 \cdot n = n
                        \\,.
          .num_remark
            %h6#remark Remark
            %p
              The category of all modules over all commutative rings is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              %a.existingWikiWord{:href => "/nlab/show/bifibration"} bifibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mod
                    %mo →
                    %mi CRing
                  %annotation{:encoding => "application/x-tex"}
                    Mod \to CRing
            %p
              over
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            %p
              This fibration may be characterized intrinsically, which gives yet another way of defining
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "." do
                %a{:href => "#ModulesOverARingInTermsOfStabilizedSlices"} below
          %h3#GSets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-sets
          %p
            Simpler than the traditionally default notion of a module in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ab
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Ab,\otimes)
            %a{:href => "#Rings"} above
            is that of a module in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal structure
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/F1"} F1
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Set,\times)
            is just a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Set,\times)
            is simpy an
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/action"} action
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
          #ActionOfDiscreteGroupOnSet.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} S \in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                \-
                %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mo ×
                    %mi S
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\lambda \colon G \times S \to S
            %p such that
            %ol
              %li
                %p the neutral element acts trivially
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mo *
                                %mo ×
                                %mi S
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mo ≃
                              %mtd
                              %mtd
                                %mi S
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi e
                                    %mo ,
                                    %msub
                                      %mi id
                                      %mi S
                                    %mo{:stretchy => "false"} )
                                %mo ↘
                              %mtd
                              %mtd
                                %msub
                                  %mo ↗
                                  %mpadded{:width => "0"}
                                    %mi λ
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi G
                                %mo ×
                                %mi S
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        * \times S &amp;&amp;\stackrel{\simeq}{\to}&amp;&amp; S
                        \\\
                        \&amp; {}_{(e,id_S)}\searrow &amp;&amp; \nearrow_{\mathrlap{\lambda}}
                        \\\
                        \&amp;&amp; G \times S
                        }
              %li
                %p
                  the action property holds: for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mn 1
                        %mo ,
                        %msub
                          %mi g
                          %mn 2
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} g_1, g_2 \in G
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
