          %p
            such that all
            %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} squares commute
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi X
                      %mi h
                    %mo ∘
                    %msubsup
                      %mi d
                      %mi X
                      %mi v
                    %mo =
                    %msubsup
                      %mi d
                      %mi X
                      %mi v
                    %mo ∘
                    %msubsup
                      %mi d
                      %mi X
                      %mi h
                  %annotation{:encoding => "application/x-tex"} d_X^h \circ d_X^v = d_X^v \circ d_X^h
              \.
          %p
            (To state the obvious, this means
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi X
                      %mi h
                    %msubsup
                      %mi d
                      %mi X
                      %mi v
                    %mo −
                    %msubsup
                      %mi d
                      %mi X
                      %mi v
                    %msubsup
                      %mi d
                      %mi X
                      %mi h
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d_X^h d_X^v - d_X^v d_X^h=0
            = succeed ".)" do
              %a{:href => "#AntiCommutingDifferentials"} below
          %p This gives a commutative diagram:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
