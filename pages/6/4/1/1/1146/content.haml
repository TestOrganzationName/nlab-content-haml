                  \\\
                  \\cdots &amp;\to &amp;
                  X_{n-1,m} &amp;\stackrel{d_X^h}{\to}&amp; X_{n-1,m-1}
                  \&amp; \to &amp; \cdots
                  \\\
                  \&amp; &amp; \downarrow^{d_X^v} &amp;&amp; \downarrow^{d_X^v}
                  \\\
                  \&amp;&amp; \vdots &amp;&amp; \vdots
                  }
          %h3#AntiCommutingDifferentials With anti-commuting differentials
          %p
            A double complex,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi X
                    %mrow
                      %mi p
                      %mo ,
                      %mi q
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi p
                  %mo ,
                  %mi q
                  %mo ∈
                  %mi ℤ
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ X_{p,q} \mid p,q\in \mathbb{Z} \}
          %p and with two classes of ‘differentials’ or ‘boundary morphisms’:
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi d
                      %mi X
                      %mi v
                    %mo :
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} d_X^v: X_{p,q}\to X_{p,q-1}
              called the ‘vertical boundary morphisms’ or ‘vertical differentials’, with
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi d
                        %mi X
                        %mi v
                      %msubsup
                        %mi d
                        %mi X
                        %mi v
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} d_X^v d_X^v = 0
          %p and
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mover
                        %mi d
                        %mo{:stretchy => "false"} ¯
                      %mi X
                      %mi h
                    %mo :
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo ,
                        %mi q
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi p
                        %mo −
                        %mn 1
                        %mo ,
                        %mi q
                  %annotation{:encoding => "application/x-tex"} \bar{d}_X^h: X_{p,q}\to X_{p-1,q}
              called the ‘horizontal boundary morphisms’ or ‘horizontal differentials’, with
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mover
                          %mi d
                          %mo{:stretchy => "false"} ¯
                        %mi X
                        %mi h
                      %msubsup
                        %mover
                          %mi d
                          %mo{:stretchy => "false"} ¯
                        %mi X
                        %mi h
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \bar{d}_X^h \bar{d}_X^h = 0
          %p
            in addition
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mover
                        %mi d
                        %mo{:stretchy => "false"} ¯
                      %mi X
                      %mi h
                    %msubsup
                      %mi d
                      %mi X
                      %mi v
                    %mo +
                    %msubsup
                      %mi d
                      %mi X
                      %mi v
                    %msubsup
                      %mover
                        %mi d
                        %mo{:stretchy => "false"} ¯
                      %mi X
                      %mi h
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \bar{d}_X^h d_X^v + d_X^v \bar{d}_X^h = 0
          %p This gives an anticommutative diagram:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi ⋮
                        %mtd
                        %mtd
                          %mi ⋮
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msubsup
                                %mi d
                                %mi X
                                %mi v
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msubsup
                                %mi d
                                %mi X
                                %mi v
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo ,
                              %mi m
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msubsup
                                %mover
                                  %mi d
                                  %mo{:stretchy => "false"} ¯
                                %mi X
                                %mi h
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo ,
                              %mi m
                              %mo −
                              %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msubsup
                                %mi d
                                %mi X
                                %mi v
                        %mtd
                          %msub
                            %mo ⇙
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msubsup
                                %mi d
                                %mi X
                                %mi v
                      %mtr
                        %mtd
                          %mi ⋯
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                              %mo ,
                              %mi m
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msubsup
                                %mover
                                  %mi d
                                  %mo{:stretchy => "false"} ¯
                                %mi X
                                %mi h
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                              %mo ,
                              %mi m
                              %mo −
                              %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %mi ⋯
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mrow
                              %msubsup
                                %mi d
                                %mi X
                                %mi v
                        %mtd
                        %mtd
