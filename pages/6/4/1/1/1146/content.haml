                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \vdots &amp;&amp; \vdots
                  \\\
                  \&amp; &amp; \downarrow^{\mathrlap{\partial^v}} &amp;&amp; \downarrow^{\mathrlap{\partial^v}}
                  \\\
                  \\cdots &amp;\to &amp;
                  X_{n,m} &amp;\stackrel{\partial^h}{\to}&amp; X_{n-1,m}
                  \&amp; \to &amp; \cdots
                  \\\
