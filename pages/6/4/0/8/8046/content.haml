          %p
            In this exposition we will follow the book listed below in writing crossed modules with operations on the right. Thus a
            %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            is in the first instance a morphism
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo :
                  %mi M
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} \mu: M \to  P
            of groups together with an operation of the group
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            on the right of the group
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            written
            = succeed "," do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msup
                      %mi m
                      %mi p
                  %annotation{:encoding => "application/x-tex"}
                    (m,p) \mapsto
                    m^p
          %p
            CM1)
            = succeed ";" do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi m
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mi m
                    %mo{:stretchy => "false"} )
                    %msup
                      %mi p
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mu (m^p)= p(\mu m)p^{-1}
          %p
            CM2)
            = succeed ";" do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi mnm
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo =
                    %msup
                      %mi n
                      %mrow
                        %mi μ
                        %mi m
                  %annotation{:encoding => "application/x-tex"} mnm^{-1} = n^{\mu m}
          %p
            for all
            = succeed "." do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ,
                    %mi n
                    %mo ∈
                    %mi M
                    %mo ,
                    %mi p
                    %mo ∈
                    %mi P
                  %annotation{:encoding => "application/x-tex"} m,n \in M, p \in P
          %p
            The notion of
            %em free crossed module
            was developed by J.H.C. Whitehead in the period 1941-1949 to model algebraically the structure of the second relative homotopy group of an adjunction space
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %msubsup
                    %mi e
                    %mi λ
                    %mn 2
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi λ
                      %mo ∈
                      %mi Λ
                  %mo ,
                  %mi A
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_2(A \cup \{e^2_\lambda\}_{\lambda \in \Lambda},A,x)
            considered as a crossed module over
            = succeed "." do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(A,x)
          %p
            It can also be considered as arising from the notion of a resolution for a group, by analogy with resolutions for modules, but in a nonabelian framework. So in combinatorial group theory we consider a presentation
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi X
                  %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                  %mi R
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \langle X \mid R \rangle
            of a group
            = succeed "." do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a set of generators of the group
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a set of relators, that is,
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a subset of
            = succeed "," do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X)
            = succeed "." do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \phi: F(X) \to G
            with kernel
            = succeed "," do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            = succeed "," do
              %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(X)
            %math#mathml_0a4269c963737a8888fe6f81f4a9dfa2ca715b2f_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
