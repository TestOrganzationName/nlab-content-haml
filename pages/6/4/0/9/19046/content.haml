            has finite limits and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi J
                    %mi c
                %annotation{:encoding => "application/x-tex"} J_c
            is generated by finite covering families, the following theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} \mathbb{S}
            called
            %strong the theory of sheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi c
                  %mo{:stretchy => "false"} )
