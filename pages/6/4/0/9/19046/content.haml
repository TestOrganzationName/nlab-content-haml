                    %mrow
                      %msub
                        %mi J
                        %mi c
                    %mo *
                %annotation{:encoding => "application/x-tex"} \mathbb{F}_{J_{c}}^\ast
            (in an equally uneconomic way):
          %p
            The signature of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
