                  %mo{:stretchy => "false"} (
                  %mi ℱ
                  %mo ×
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi 𝒮
                  %mo{:stretchy => "false"} [
                  %mi 𝕆
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi ℱ
                  %mo ,
                  %mi 𝒮
                  %mo{:stretchy => "false"} [
                  %mi 𝕆
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi J
                        %mi c
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mod_\mathbb{S}(\mathcal{F})=\mathcal{F}\times Sh(\mathcal{C},J_{c})=Hom(\mathcal{F}\times Sh(\mathcal{C},J_{c}), \mathcal{S}[\mathbb{O}])=Hom(\mathcal{F},\mathcal{S}[\mathbb{O}]^{Sh(\mathcal{C},J_{c})})
          %p
            i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo{:stretchy => "false"} [
                  %mi 𝕆
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi J
                        %mi c
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{S}[\mathbb{O}]^{Sh(\mathcal{C},J_{c})}
            is the classifying topos for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
            = succeed "," do
              %a{:href => "#J77"} 1977
          %p
            In particular, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"} \mathbb{S}
            is a
            %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent theory
            this implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo{:stretchy => "false"} [
                  %mi 𝕆
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi J
                        %mi c
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{S}[\mathbb{O}]^{Sh(\mathcal{C},J_{c})}
            is also a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coherent+topos"} coherent topos
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi 𝒮
                  %mo ,
                  %mi 𝒮
                  %mo{:stretchy => "false"} [
                  %mi 𝕆
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi J
                        %mi c
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Mod
                    %mi 𝕊
                  %mo{:stretchy => "false"} (
                  %mi 𝒮
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi 𝒮
                  %mo ×
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %msub
                      %mi J
                      %mi c
                    %mo{:stretchy => "false"} )
                  %mo =
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom(\mathcal{S},\mathcal{S}[\mathbb{O}]^{Sh(\mathcal{C},J_{c})})=Mod_\mathbb{S}(\mathcal{S})=\mathcal{S}\times {Sh(\mathcal{C},J_{c})}=Sh(\mathcal{C},J_c)
          %p
            it follows then that every coherent topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %msub
                    %mi J
                    %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},J_c)
            is the
            %em category of points
            of a coherent topos.
          %h2#ramifications Ramifications
          %p
            The notion of a
            %a.existingWikiWord{:href => "/nlab/show/tiny+object"} tiny object
            in a cartesian closed category suggests the following
          .num_defn
            %h6#definition_3 Definition
            %p
              An exponentiable Grothendieck topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is called
              %em tiny
              (or
              = succeed ")" do
                %em infinitesimal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi ℰ
                  %annotation{:encoding => "application/x-tex"} (_{-})^\mathcal{E}
              has a right 2-adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi ℰ
                    %annotation{:encoding => "application/x-tex"} (_{-})_\mathcal{E}
