          .un_defn
            %h6#definition_2 Definition
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is
              %strong continuous
              if for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi P
                    %annotation{:encoding => "application/x-tex"} a\in P
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⇓
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} |
                    %mi b
                    %mo ≪
                    %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \Downarrow (a) \coloneqq \{ b \in P | b \ll a \}
            %p
              is directed and has join
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            also has finite joins, hence is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/suplattice"} suplattice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇓
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Downarrow(a)
            is automatically directed, so the condition reduces to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mo{:stretchy => "false"} (
                    %mo ⇓
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \bigvee (\Downarrow(a)) = a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is called a
            = succeed "." do
              %strong continuous lattice
          %h3#adjoint_characterization Adjoint characterization
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Idl
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Idl(P)
            denote the poset of
            %a.existingWikiWord{:href => "/nlab/show/ideals"} ideals
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          .un_prop
            %h6#proposition Proposition
            %p
              A poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              has directed joins if and only if the
              %a.existingWikiWord{:href => "/nlab/show/principal-ideal"} principal-ideal
              map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ↓
                      %mo :
                      %mi P
                      %mo →
                      %mi Idl
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \downarrow : P \to Idl(P)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ↓
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} {
                    %mi b
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} |
                    %mi b
                    %mo ≤
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \downarrow(a) \coloneqq \{ b \in P | b \leq a \} ,
            %p
              has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %annotation{:encoding => "application/x-tex"} \bigvee
          .un_theorem
            %h6#theorem Theorem
            %p
              A poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              with directed joins is continuous if and only if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mo :
                    %mi Idl
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} \bigvee: Idl(P) \to P
              has its own left adjoint, which must be
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⇓
                    %annotation{:encoding => "application/x-tex"} \Downarrow
          %p
            This characterization generalizes directly to the notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/continuous+category"} continuous category
          %h2#morphisms Morphisms
          %p
            Since a continuous poset must have directed joins, the obvious
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are continuous posets would be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Scott-continuous+functions"} Scott-continuous functions
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/monotone+functions"} monotone functions
          %p
            Between continuous lattices, we may use the same morphisms; or we may more generally use those Scott-continuous functions that preserve the
            %a.existingWikiWord{:href => "/nlab/show/semilattice"} semilattice
            structure of finitary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/joins"} joins
            %a.existingWikiWord{:href => "/nlab/show/suplattice"} suplattice
            morphisms that preserve all joins. However, because a suplattice is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complete+lattice"} complete lattice
            %a.existingWikiWord{:href => "/nlab/show/inflattice"} inflattice
            morphisms, that is those that also preserve all
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/meets"} meets
          %h2#properties Properties
          %ul
            %li
              %p
                Continuous lattices are those
                %a.existingWikiWord{:href => "/nlab/show/complete+lattices"} complete lattices
                for which taking
                %a.existingWikiWord{:href => "/nlab/show/suprema"} suprema
                of directed subsets commutes with taking
                %a.existingWikiWord{:href => "/nlab/show/infima"} infima
                of arbitrary subsets.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                from the category of continuous lattices to the
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                is
                %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
                if we use Scott-continuous inflattice morphisms. Here the left adjoint of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                takes a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the lattice of
                %a.existingWikiWord{:href => "/nlab/show/filters"} filters
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (that is filters in the
                %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
                Boolean algebra
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mi X
                      %annotation{:encoding => "application/x-tex"} P X
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/filter+monad"} filter monad
            %li
              %p
                The category of continuous lattices is
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
                if we use all Scott-continuous functions. This category was used by
                %a.existingWikiWord{:href => "/nlab/show/Dana+Scott"} Dana Scott
                to construct models of the untyped
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/lambda+calculus"} lambda calculus
            %li
              %p
                Every continuous lattice is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Baire+lattice"} Baire lattice
          %h2#examples Examples
          %ul
            %li
              %p
                In
                %a{:href => "#Freyd08"} Freyd08
                in
                %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
                an
                %a.existingWikiWord{:href => "/nlab/show/interval+coalgebra"} interval coalgebra
                is a
                %a.existingWikiWord{:href => "/nlab/show/continuous+poset"} continuous poset
                and the
                %a.existingWikiWord{:href => "/nlab/show/unit+interval"} unit interval
                is the terminal interval coalgebra.
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
                is called
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+locale"} locally compact
                just when the corresponding
                %a.existingWikiWord{:href => "/nlab/show/frame"} frame
                is a continuous lattice. This is equivalently to being an
                %a.existingWikiWord{:href => "/nlab/show/exponentiable+object"} exponentiable
                in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+locales"} category of locales
                %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
                between such locales is
                %a.existingWikiWord{:href => "/nlab/show/proper+map"} proper
                iff its
                %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
                function (which is always an
                %a.existingWikiWord{:href => "/nlab/show/inflattice"} inflattice
                morphism) is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Scott+topology"} Scott-continuous
            %li
              %p
                As a consequence the
                %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} lattice of open subsets
                of a topological space is a continuous lattice if and only if the
                %a.existingWikiWord{:href => "/nlab/show/sobrification"} sobrification
                of the topological space is
                %a.existingWikiWord{:href => "/nlab/show/locally+compact"} locally compact
                (i.e. every point of the sobrification has a
                %a.existingWikiWord{:href => "/nlab/show/neighborhood+base"} neighborhood base
                made of compact subsets).
          %h2#related_pages Related pages
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/continuous+category"} continuous category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+locale"} locally compact locale
            %li
              %p
                Continuous posets can be generalized to
                %a.existingWikiWord{:href => "/nlab/show/continuous+algebras"} continuous algebras
                for any
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+2-monad"} lax-idempotent 2-monad
          %h2#references References
          %ul
            %li
              %p
                Rudolf-E. Hoffmann,
                = succeed "," do
                  %em Continuous posets and adjoint sequences
                %strong 18
                (1979) pp. 173-188. (
                %a{:href => "http://gdz.sub.uni-goettingen.de/dms/load/img/?PID=GDZPPN001253433"}> gdz
                )
            %li
              %p
                Karl H. Hofmann,
                %em A note on Baire spaces and continuous lattices
                1980. Bulletin of the Australian Mathematical Society, 21(2), pp. 265-279.
          %p See section 30 of
          %ul
            %li#Freyd08
              %a.existingWikiWord{:href => "/nlab/show/Peter+Freyd"}> Peter Freyd
              ,
              = succeed "," do
                %em Algebraic real analysis
              = succeed ")" do
                %a{:href => "http://www.tac.mta.ca/tac/volumes/20/10/20-10abs.html"} tac:20-10
