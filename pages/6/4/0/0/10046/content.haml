          %h3#elementary_definition Elementary definition
          .un_defn
            %h6#definition Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ∈
                      %mi P
                    %annotation{:encoding => "application/x-tex"} a, b \in P
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is
              %strong way below
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≪
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \ll b
              if whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊆
                    %mi P
                  %annotation{:encoding => "application/x-tex"} S \subseteq P
              is a
              %a.existingWikiWord{:href => "/nlab/show/directed+subset"} directed subset
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ≤
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mi S
                  %annotation{:encoding => "application/x-tex"} b \leq \bigvee S
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \bigvee S
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/join"} join
              of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
