          #KappaCellSpectrumWitnessingELocalization.num_lemma
            %h6#lemma_14 Lemma
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              there exists a spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              such that any spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed ")" do
                %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
              = succeed "-null," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mi is
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mtext -local
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi A
                    %mo ,
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X \;is\; E\text{-local}
                    \\;\;\;\;
                    \\Leftrightarrow
                    \\;\;\;\;
                    [A,X]_\ast = 0
            %p and such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is
                  = succeed "-acyclic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed ");" do
                    %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
              %li
                %p
                  there exists an infinite
                  %a.existingWikiWord{:href => "/nlab/show/cardinal+number"} cardinal number
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/CW+spectrum"} CW spectrum
                  (hence a
                  %a.existingWikiWord{:href => "/nlab/show/CW+spectrum"} CW spectrum
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#CWSpectrum"}> def.
                  ) with at most
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  many cells);
              %li
                %p
                  the class of
                  = succeed "-acyclic" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  under
                %ol
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  %li
                    %p
                      the relation that if in a
                      %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mn 1
                            %mo →
                            %msub
                              %mi X
                              %mn 2
                            %mo →
