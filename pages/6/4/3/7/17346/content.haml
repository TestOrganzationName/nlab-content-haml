                    \\to
                    \\mathbb{Z}_p
                    \\overset{p \cdot (-)}{\longrightarrow}
                    \\mathbb{Z}_p
                    \\longrightarrow
                    \\mathbb{Z}/p\mathbb{Z}
                    \\to
                    0
                    \\,.
