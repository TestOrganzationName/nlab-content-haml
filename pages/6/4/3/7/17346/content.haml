                    0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mn 1
                    %mrow
                      %mo (
                      %mi ⋯
                      %mover
                        %mo ⟶
                        %mi p
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mi n
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mi p
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mi n
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mi p
                      %mi ℤ
                      %mo{:stretchy => "false"} /
