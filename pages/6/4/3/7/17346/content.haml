                        \\;\simeq\;
                        Hom_\Gamma(A,N_2)
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, lemma A1.1.6
          .num_remark
            %h6#remark_10 Remark
            %p
              In computing the second page of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
              %a.maruku-ref{:href => "#ComoduleHomInTermsOfCotensorProduct"}
              is the key translation that makes the comodule
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              = succeed "-groups." do
                %a.existingWikiWord{:href => "/nlab/show/Cotor"} Cotor
              %a.existingWikiWord{:href => "/nlab/show/Lambda-algebra"} Lambda-algebra
              or via the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/May+spectral+sequence"} May spectral sequence
          %h3#universal_coefficient_theorem Universal coefficient theorem
          %p
            The key use of the Hopf coalgebroid structure of prop.
            %a.maruku-ref{:href => "#HopfAlgebroidStructureOnDualEOperations"}
            for the present purpose is that it is extra structure inherited by morphisms in
            = succeed "-homology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-homology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_\ast \colon E_\bullet(X) \to E_\bullet(Y)
            of a morphism of a spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f \colon X \to Y
            does not just produce a morphism of
            = succeed "-homology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mo ⟶
                  %msub
                    %mi Hom
                    %mrow
                      %msup
                        %mi Ab
                        %mi ℤ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [X,Y]_\bullet
                  \\longrightarrow
                  Hom_{Ab^{\mathbb{Z}}}(E_\bullet(X), E_\bullet(Y))
          %p
            but in fact produces homomorphisms of comodules over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_\bullet(E)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                  %mo ⟶
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\alpha
                  \\;\colon\;
                  [X,Y]_\bullet
                  \\longrightarrow
                  Hom_{E_\bullet(E)}(E_\bullet(X), E_\bullet(Y))
                  \\,.
          %p
            This is the statement of lemma
            %a.maruku-ref{:href => "#SmashingMapsWithEFactorsThroughSteenrodComoduleHomomorphisms"}
            below. The point is that
            = succeed "-comodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet(E)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
          %p
            In good cases such an approximation of
            %em homotopy
            by
            %em homology
            is in fact accurate, in that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            = succeed ")" do
              %a{:href => "#Adams74"} Adams 74, part III, section 13
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            here being
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            One such case is exhibited by prop.
            %a.maruku-ref{:href => "#ComoduleHomForENCohomology"}
            below. This allows to equivalently re-write the first page of the
            = succeed "-Adams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-homology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.maruku-ref{:href => "#ComoduleHomsInE1PageOfEAdamsSpectralSequence"}
            below.
          #SmashingMapsWithEFactorsThroughSteenrodComoduleHomomorphisms.num_lemma
            %h6#lemma_5 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X,Y \in Ho(Spectra)
              any two
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized
              %a.existingWikiWord{:href => "/nlab/show/homology+groups"} homology groups
              given by
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#EMHomology"}> rmk.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo ∧
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo{:lspace => "verythinmathspace"} :
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %mo ⟶
                          %mtd
                            %msubsup
                              %mi Hom
                              %mrow
                                %msup
                                  %mi Ab
                                  %mi ℤ
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mover
                              %mo ⟶
                              %mi f
                            %mi Y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mrow
                              %mo (
                              %msub
                                %mi E
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi f
                                    %mo *
                              %msub
                                %mi E
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo{:stretchy => "false"} )
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\pi_\bullet(E \wedge -)
                    \&amp;\colon&amp;
                    [X,Y]_\bullet
                    \&amp;\longrightarrow&amp;
                    Hom^\bullet_{Ab^{\mathbb{Z}}}(E_\bullet(X), E_\bullet(Y))
                    \\\
                    \&amp;&amp;
                    (X \overset{f}{\longrightarrow} Y)
                    \&amp;\mapsto&amp;
                    \\left(
                    E_\bullet(X)
                    \\overset{f_\ast}{\longrightarrow}
                    E_\bullet(Y)
                    \\right)
                    }
            %p
              factors through the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              from
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E_\bullet(E)
              %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#HopfAlgebroidStructureOnDualEOperations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Hom
                              %mrow
                                %msub
                                  %mi E
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ∃
                            %mo ↗
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi forget
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi N
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo ∧
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msubsup
                              %mi Hom
                              %mrow
                                %msup
                                  %mi Ab
                                  %mi ℤ
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp;  Hom^\bullet_{E_\bullet(E)}(E_\bullet(X), E_\bullet(Y))
                    \\\
                    \&amp; {}^{\mathllap{\exists}}\nearrow
                    \&amp; \downarrow^{\mathrlap{forget}}
                    \\\
                    [X,N]_\bullet
                    \&amp;\underset{\pi_\bullet(E \wedge -)}{\longrightarrow}&amp;
