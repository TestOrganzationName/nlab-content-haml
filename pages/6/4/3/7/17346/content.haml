          .proof
            %h6#proof_8 Proof
            %p
              By def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              we need to show that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \overset{f}{\longrightarrow} Y
              a morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              then the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mo *
                          %mtd
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Ψ
                                    %mrow
                                      %msub
                                        %mi E
                                        %mo •
                                      %mo{:stretchy => "false"} (
                                      %mi X
                                      %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Ψ
                                    %mrow
                                      %msub
                                        %mi E
                                        %mo •
                                      %mo{:stretchy => "false"} (
                                      %mi Y
                                      %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi id
                                %msub
                                  %mo ⊗
                                  %mrow
                                    %msub
                                      %mi π
                                      %mo •
                                    %mo{:stretchy => "false"} (
                                    %mi E
                                    %mo{:stretchy => "false"} )
                                %msub
                                  %mi f
                                  %mo *
                          %mtd
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E_\bullet(X)
                    \&amp;\overset{f_\ast}{\longrightarrow}&amp;
                    E_\bullet(Y)
                    \\\
                    {}^{\mathllap{\Psi_{E_\bullet(X)}}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\Psi_{E_\bullet(Y)}}}
                    \\\
                    E_\bullet(E) \otimes_{\pi_\bullet(E)} E_\bullet(X)
                    \&amp;\underset{id \otimes_{\pi_\bullet(E)} f_\ast }{\longrightarrow}&amp;
                    E_\bullet(E) \otimes_{\pi_\bullet(E)} E_\bullet(Y)
                    }
                    \\,.
            %p
              By def.
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              and prop.
              %a.maruku-ref{:href => "#IndeedComoduleStructureOnEX"}
              this is the image under foming
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(-)
              of the following diagram in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Spectra)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                            %mo ∧
                            %mi X
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo ∧
                                %mi f
                          %mtd
                            %mi E
                            %mo ∧
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %mi E
                            %mo ∧
                            %mi 𝕊
                            %mo ∧
                            %mi X
                          %mtd
                          %mtd
                            %mi E
                            %mo ∧
                            %mi 𝕊
                            %mo ∧
                            %mi Y
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi id
                                  %mo ∧
                                  %mi e
                                  %mo ∧
                                  %mi id
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi id
                                  %mo ∧
                                  %mi e
                                  %mo ∧
                                  %mi id
                        %mtr
                          %mtd
                            %mi E
                            %mo ∧
                            %mi E
                            %mo ∧
                            %mi X
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo ∧
                                %mi id
                                %mo ∧
                                %mi f
                          %mtd
                            %mi E
                            %mo ∧
                            %mi E
                            %mo ∧
                            %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    E \wedge X
                    \&amp;\overset{id \wedge f}{\longrightarrow}&amp;
                    E \wedge Y
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    E \wedge \mathbb{S} \wedge X
                    \&amp;&amp;
                    E \wedge \mathbb{S} \wedge Y
                    \\\
                    {}^{\mathllap{id \wedge e \wedge id}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{id \wedge e \wedge id}}
                    \\\
                    E \wedge E \wedge X
                    \&amp;\underset{id \wedge id \wedge f}{\longrightarrow}&amp;
                    E \wedge E \wedge Y
                    }
                    \\,.
            %p
              But that this diagram commutes is simply the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
              of the derived
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              as a functor on the
              %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Spectra
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Spectra) \times Ho(Spectra)
          #AdamsUCT.num_prop
            %h6#proposition_10 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu, e)
              be a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ), and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, Y \in Ho(Spectra)
              be two
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet(X)
              is a
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              (via
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"} this prop.
            %p
              Then the homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mi UC
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo ∧
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mover
                      %mo ⟶
                      %mrow
                    %msubsup
                      %mi Hom
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_{UC}
                    \\;\colon\;
                    [X, E \wedge Y]_\bullet
                    \\stackrel{}{\longrightarrow}
                    Hom_{\pi_\bullet(E)}^\bullet(E_\bullet(X), E_\bullet(Y))_\bullet
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi E
                    %mo ∧
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ↦
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ∧
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %mi id
                        %mo ∧
                        %mi f
                    %mi E
                    %mo ∧
                    %mi E
                    %mo ∧
                    %mi Y
                    %mover
                      %mo ⟶
                      %mrow
                        %mi μ
                        %mo ∧
                        %mi id
                    %mi E
                    %mo ∧
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X \overset{f}{\longrightarrow} E \wedge Y)
                    \\;\mapsto\;
                    \\pi_\bullet
                    ( E \wedge X
                    \\overset{id \wedge f}{\longrightarrow}
                    E \wedge E \wedge Y
                    \\overset{\mu \wedge id}{\longrightarrow}
                    E \wedge Y
                    )
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            (
            %a{:href => "#Schwede12"}> Schwede 12, chapter II, prop. 6.20
            )
          .proof
            %h6#proof_9 Proof
            %p First of all we claim that the morphism in question factors as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo ∧
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msubsup
                      %mi Hom
                      %mrow
                        %mi E
                        %mi Mod
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ∧
                    %mi X
                    %mo ,
                    %mi E
                    %mo ∧
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi π
                          %mo •
                    %msubsup
                      %mi Hom
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\beta
                    \\;\colon\;
                    [X, E \wedge Y]_\bullet
                    \\overset{\simeq}{\longrightarrow}
                    Hom^\bullet_{E Mod}( E \wedge X , E \wedge Y)
                    \\overset{\pi_\bullet}{\longrightarrow}
                    Hom^\bullet_{\pi_\bullet(E)}( E_\bullet(X), E_\bullet(Y) )
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mi Mod
                        %mo =
                        %mi E
                        %mi Mod
                        %mo{:stretchy => "false"} (
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi Spectra
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo ∧
                        %mo ,
                        %mi 𝕊
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E Mod = E Mod(Ho(Spectra), \wedge, \mathbb{S})
                  denotes the category of
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+module+spectra"} homotopy module spectra
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
                  )
              %li
                %p
                  the first morphisms is the
                  %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
                  isomorphism for forming
                  %a.existingWikiWord{:href => "/nlab/show/free+modules"} free
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidModuleOverItself"}> prop.
                  )
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+module+spectra"} homotopy module spectra
              %li
                %p
                  the second morphism is the respective component of the composite of the
                  %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                  from
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+module+spectra"} homotopy module spectra
                  back to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi Spectra
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(Spectra)
                  with the functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \pi_\bullet
                  that forms
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
            %p
              This is because (by
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidModuleOverItself"} this prop.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and then postcomposing with the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ∧
                      %mi X
                    %annotation{:encoding => "application/x-tex"} E \wedge X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %mi E
                    %mover
                      %mo →
                      %mi μ
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E \wedge E \overset{\mu}{\to} E
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidModuleOverItself"}> prop.
              ).
            %p Hence it is sufficient to show that the morphism on the right is an isomorphism.
            %p
              We show more generally that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_1, N_2
              any two
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/homotopy+module+spectra"} homotopy module spectra
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ) such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(N_1)
              is a
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Hom
                      %mrow
                        %mi E
                        %mi Mod
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi π
                          %mo •
                    %msubsup
                      %mi Hom
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom^\bullet_{E Mod}( N_1 , N_2)
                    \\overset{\pi_\bullet}{\longrightarrow}
                    Hom^\bullet_{\pi_\bullet(E)}( \pi_\bullet(N_1), \pi_\bullet(N_2) )
            %p is an isomorphism.
            %p
              To see this, first consider the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(N_1)
              is in fact a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
            %p
              This implies that there is a basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \mathcal{B} = \{x_i\}_{i \in I}
              and a homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo ⟶
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\vee}
                    \\Sigma^{\vert x_i\vert}
                    E \longrightarrow
                    N_1
            %p
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+module+spectra"} homotopy module spectra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
            %p
              Observe that this sits in a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi Hom
                              %mrow
                                %mi E
                                %mi Mod
                              %mo •
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo ∨
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi Σ
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi x
                                  %mi i
                                %mo{:stretchy => "false"} |
                            %mi E
                            %mo ,
                            %msub
                              %mi N
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                          %mtd
                            %msubsup
                              %mi Hom
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo ∨
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi Σ
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi x
                                  %mi i
                                %mo{:stretchy => "false"} |
                            %mi E
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi N
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mo ≃
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi Σ
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi x
                                  %mi i
                                %mo{:stretchy => "false"} |
                            %mi 𝕊
                            %mo ,
                            %msub
                              %mi N
                              %mn 2
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                            %munder
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msub
                              %mi π
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi x
                                  %mi i
                                %mo{:stretchy => "false"} |
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi N
                              %mn 2
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Hom^\bullet_{E Mod}( \underset{i \in I}{\vee} \Sigma^{\vert x_i\vert} E, N_2 )
                    \&amp;\overset{\pi_\bullet}{\longrightarrow}&amp;
                    Hom^\bullet_{\pi_\bullet(E)}(\pi_\bullet(\underset{i \in I}{\vee}\Sigma^{\vert x_i\vert} E) , \pi_\bullet(N_2) )
                    \\\
                    {}^{\mathllap{\simeq}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\simeq}}
                    \\\
                    \\underset{i \in I}{\prod} [ \Sigma^{\vert x_i\vert}\mathbb{S}, N_2 ]_\bullet
                    \&amp;\underset{\simeq}{\longrightarrow}&amp;
                    \\underset{i \in I}{\prod}
                    \\pi_{\bullet + \vert x_i \vert}(N_2)
                    }
            %p where
            %ol
              %li
                %p
                  the left vertical isomorphism exhibits
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  of spectra as the
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  in the
                  %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryHasCoproducts"}> lemma
                  );
              %li
                %p
                  the bottom isomorphism is from
                  = succeed ";" do
                    %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGrouspAsHomsOutOfSphereSpectrum"} this prop.
              %li
                %p
                  the right vertical isomorphism is that of the
                  %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
                  for modules over
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            %p Hence the top horizontal morphism is an isomorphism, which was to be shown.
            %p
              Now consider the general case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(N_1)
              is a
              %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
              of (graded)
              %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
              (
              %a{:href => "projective+module#NProjectiveIFFHomNExact"}> prop.
              ), there exists a diagram of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    id
                    \\;\colon\;
                    \\pi_\bullet(N_1)
                    \\longrightarrow
                    \\pi_\bullet( \underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E )
                    \\longrightarrow
                    \\pi_\bullet(N_1)
            %p
              which induces the corresponding
              %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} split idempotent
              of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet( \underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E )
                    \\longrightarrow
                    \\pi_\bullet(N_1)
                    \\longrightarrow
                    \\pi_\bullet( \underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E )
                    \\,.
            %p
              As before, by freeness this is actually the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet
              of an idempotent of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+ring+spectra"} homotopy ring spectra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo ⟶
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    e_\bullet
                    \\;\colon\;
                    \\underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E
                    \\longrightarrow
                    \\underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E
            %p
              and so in particular of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            %p
              Now in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              all
              %a.existingWikiWord{:href => "/nlab/show/split+idempotent"} idempotents split
              (
              %a{:href => "split+idempotent#InTrinagulatedCategoryWithDirectSumsOfTrianglesAllIdempotentsSplit"}> prop.
              ), hence there exists a diagram of spectra of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo ⟶
                    %mi X
                    %mo ⟶
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    e
                    \\;\colon\;
                    \\underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E
                    \\longrightarrow
                    X
                    \\longrightarrow
                    \\underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E
            %p
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi e
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(e) = e_\bullet
            %p Consider the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo ⟶
                    %msub
                      %mi N
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X
                    \\longrightarrow
                    \\underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E
                    \\longrightarrow
                    N_1
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi e
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(e) = e_\bullet
              it follows that under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet
              this is an isomorphism, then that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X \simeq N_1
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            %p
              In conclusion this exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              as a
              %a.existingWikiWord{:href => "/nlab/show/retract"} retract
              of an free
              = succeed "-homotopy" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mn 1
                    %mo ⟶
                    %munder
                      %mo ∨
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msub
                          %mi x
                          %mi i
                        %mo{:stretchy => "false"} |
                    %mi E
                    %mo ⟶
                    %msub
                      %mi N
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    id
                    \\;\colon\;
                    N_1
                    \\longrightarrow
                    \\underset{i \in I}{\vee} \Sigma^{\vert x_i \vert} E
                    \\longrightarrow
                    N_1
                    \\,,
            %p
              hence of a spectrum for which the morphism in question is an isomorphism. Since the morphism in question is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              is a retract in the
              %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
              of an isomorphism, hence itself an isomorphism (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#RetractPreservesIsomorphism"}> lemma
              ).
          .num_remark
            %h6#remark_11 Remark
            %p
              A stronger version of the statement of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#AdamsUCT"}
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} E \wedge Y
              replaced by any homotopy
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed ")" do
                %a{:href => "#Adams74"} Adams 74, chapter III, prop. 13.5
              = succeed "\u201D)." do
                %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi F
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ⟶
                    %msubsup
                      %mi Hom
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F^\bullet(X) = [X,F]_\bullet
                    \\longrightarrow
                    Hom^\bullet_{\pi_\bullet(E)}(E_\bullet(X), \pi_\bullet(F))
            %p
              is an isomormphism (expressing the
              = succeed "-cohomology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as the
              = succeed "-linear" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
              = succeed "-homology" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              For the following we need only the weaker but much more general statement of prop.
              = succeed "," do
                %a.maruku-ref{:href => "#AdamsUCT"}
              = succeed ")" do
                %a{:href => "#Adams74"} Adams 74, p. 323
          %p
            With this we finally get the following statement, which serves to identify maps of certain spectra with their induced maps on
            = succeed "-homology:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          #ComoduleHomForENCohomology.num_prop
            %h6#proposition_11 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu, e)
              be a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ), and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, Y \in Ho(Spectra)
              be two
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is flat according to def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#FlatE"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_\bullet(X)
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
                  over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_\bullet(E)
                  (via
                  = succeed ")." do
                    %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"} this prop.
            %p
              Then the morphism from lemma
              %a.maruku-ref{:href => "#SmashingMapsWithEFactorsThroughSteenrodComoduleHomomorphisms"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo ∧
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ∧
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msubsup
                      %mi Hom
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ∧
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %mi Hom
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [X, E \wedge Y]_\bullet
                    \\stackrel{\pi_\bullet(E \wedge -)}{\longrightarrow}
                    Hom_{E_\bullet(E)}^\bullet(E_\bullet(X), E_\bullet( E \wedge Y)))
                    \\simeq
                    Hom_{E_\bullet(E)}^\bullet(E_\bullet(X),  E_\bullet(E) \otimes_{\pi_\bullet(E)} E_\bullet(Y) ))
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              (where the isomophism on the right is that of prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#EnHomology"}
          %p
            (
            %a{:href => "#Adams74"}> Adams 74, part III, page 323
            )
          .proof
            %h6#proof_10 Proof
            %p
              Observe that the following
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi X
                            %mo ,
                            %mi E
                            %mo ∧
                            %mi Y
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mo •
                          %mtd
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo ∧
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %msubsup
                              %mi Hom
                              %mrow
                                %msub
                                  %mi E
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo ⊗
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi ϕ
                                    %mi UC
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi ϵ
                                  %mo ⊗
                                  %mi id
                                  %mo ∘
                                  %mo{:stretchy => "false"} (
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msubsup
                              %mi Hom
                              %mrow
                                %msub
                                  %mi π
                                  %mo •
                                %mo{:stretchy => "false"} (
                                %mi E
                                %mo{:stretchy => "false"} )
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [X, E \wedge Y]_\bullet
                    \&amp;&amp; \overset{\pi_\bullet(E \wedge -)}{\longrightarrow} &amp;&amp;
                    Hom_{E_\bullet(E)}^\bullet(E_\bullet(X),  E_\bullet(E) \otimes_{\pi_\bullet(E)} E_\bullet(Y) ))
                    \\\
                    \&amp; {}_{\mathllap{\phi_{UC}}}\searrow
                    \&amp;&amp;
                    \\swarrow_{\mathrlap{\epsilon \otimes id \circ (-) }}
                    \\\
                    \&amp;&amp;
                    Hom^\bullet_{\pi_\bullet(E)}(E_\bullet(X), E_\bullet(Y))
                    }
                    \\,,
            %p where
            %ol
              %li
                %p
                  the top morphism is the one from lemma
                  = succeed ";" do
                    %a.maruku-ref{:href => "#SmashingMapsWithEFactorsThroughSteenrodComoduleHomomorphisms"}
              %li
                %p
                  the right vertical morphism is the adjunction isomorphism from prop.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#CoFreeComodules"}
              %li
                %p
                  the left diagonal morphism is the one from prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#AdamsUCT"}
            %p To see that this indeed commutes, notice that
            %ol
              %li
                %p
                  the top morphism sends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mover
                          %mo →
                          %mi f
                        %mi E
                        %mo ∧
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X \overset{f}{\to} E \wedge Y)
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi E
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ∧
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ∧
                        %mi E
                        %mo ∧
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_\bullet(X) \overset{E_\bullet(f)}{\to} E_\bullet(E \wedge Y) \simeq \pi_\bullet(E \wedge E \wedge Y)
                  by definition;
              %li
                %p
                  the right vertical morphism sends this further to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi E
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %msub
                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ∧
                          %mi E
                          %mo ∧
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi π
                                %mo •
                              %mo{:stretchy => "false"} (
                              %mi μ
                              %mo ∧
                              %mi id
                              %mo{:stretchy => "false"} )
                          %msub
                            %mi π
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo ∧
                          %mi Y
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} E_\bullet(X) \overset{E_\bullet(f)}{\to} \pi_\bullet(E \wedge E \wedge Y) \overset{\pi_\bullet(\mu \wedge id)}{\to} \pi_\bullet(E \wedge Y)
                  %a.maruku-ref{:href => "#CoFreeComodules"}
                  (which says that the map is given by postcomposition with the counit of
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mi E
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} E_\bullet(E)
                  %a.maruku-ref{:href => "#HopfAlgebroidStructureOnDualEOperations"}
                  (which says that this counit is represented by
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi μ
                        %annotation{:encoding => "application/x-tex"} \mu
              %li
                %p
                  by prop.
                  %a.maruku-ref{:href => "#AdamsUCT"}
                  this is the same as the action of the left diagonal morphism.
            %p But now
            %ol
              %li
                %p
                  the right vertical morphism is an isomorphism by prop.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#EnHomology"}
              %li
                %p
                  the left diagonal morphism is an isomorphism by prop.
                  %a.maruku-ref{:href => "#AdamsUCT"}
            %p and so it follows that the top horizontal morphism is an isomorphism, too.
          %p In conclusion:
          #ComoduleHomsInE1PageOfEAdamsSpectralSequence.num_theorem
            %h6#theorem Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu, e)
              be a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ), and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X, Y \in Ho(Spectra)
              be two
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  is flat according to def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#FlatE"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
