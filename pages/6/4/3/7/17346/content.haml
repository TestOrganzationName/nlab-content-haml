                            %mi i
                            %mo ≥
                            %mn 1
                            %mo ,
                        %mrow
                          %mrow
                            %mi n
                            %mo ≥
                            %mn 0
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ext
                      %mrow
                        %msubsup
                          %mi 𝒜
                          %mn 2
                          %mo *
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    E_1^{s,t,p}
                    \=
                    \\mathbb{F}_2[ \{ h_{i,n} \}_{{i \geq 1,} \atop {n \geq 0}}]
                    \\;\Rightarrow\;
                    Ext^{s,t}_{\mathcal{A}_2^\ast}(\mathbb{F}_2, \mathbb{F}_2)
                    \\,,
            %p
              called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/May+spectral+sequence"} May spectral sequence
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              are from the bigrading of the spectral sequence itself, while the index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is that of the graded
              = succeed "-vector" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mrow
                            %mi i
                            %mo ,
                            %mi n
                        %mo ∈
                        %msubsup
                          %mi E
                          %mn 1
                          %mrow
                            %mn 1
                            %mo ,
                            %msup
                              %mn 2
                              %mrow
                                %msup
                                  %mn 2
                                  %mrow
                                    %mi i
                                    %mo +
                                    %mi n
                                %mo −
                                %msup
                                  %mn 2
                                  %mi n
                                %mo −
                                %mn 1
                                %mo ,
                                %mn 2
                                %mi i
                                %mo −
                                %mn 1
                      %annotation{:encoding => "application/x-tex"} h_{i,n} \in E_1^{1, 2^{2^{i+n} - 2^n - 1, 2i - 1 }}
              %li
                %p first differential given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi h
                          %mrow
                            %mi i
                            %mo ,
                            %mi n
                        %mo{:stretchy => "false"} )
                        %mo =
                        %munderover
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %mi k
                            %mo =
                            %mn 0
                          %mi i
                        %msub
                          %mi h
                          %mrow
                            %mi i
                            %mo −
                            %mi k
                            %mo ,
                            %mi n
                            %mo +
                            %mi k
                        %mo ⊗
                        %msub
                          %mi h
                          %mrow
                            %mi k
                            %mo ,
                            %mi n
                        %mspace{:width => "thinmathspace"}
                        %mo ;
                      %annotation{:encoding => "application/x-tex"}
                        d_1 (h_{i,n})
                        \=
                        \\underoverset{k = 0}{i}{\sum} h_{i-k,n+k}\otimes h_{k,n}
                        \\,;
              %li
                %p higher differentials of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi r
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msubsup
                          %mi E
                          %mi r
                          %mrow
                            %mi s
                            %mo ,
                            %mi t
                            %mo ,
                            %mi p
                        %mo ⟶
                        %msubsup
                          %mi E
                          %mi r
                          %mrow
                            %mi s
                            %mo +
                            %mn 1
                            %mo ,
                            %mi t
                            %mo −
                            %mn 1
                            %mo ,
                            %mi p
                            %mo −
                            %mn 2
                            %mi r
                            %mo +
                            %mn 1
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        d_r
                        \\;\colon\;
                        E_r^{s,t, p}
                        \\longrightarrow
                        E_r^{s+1, t-1, p-2r+1}
                        \\,,
                %p where the filtration is by maximal degree.
            %p
              Notice that since everything is
              = succeed "-linear," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ExtensionProblemForSpectralSequences"} extension problem
              of this spectral sequence is trivial.
          %p
            (
            %a{:href => "#Kochman96"}> Kochman 96, prop. 5.3.1
            )
          .proof
            %h6#proof_34 Proof
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/graded+algebra"} grading
              on the dual
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^\bullet_{2}
              (theorem
              = succeed ")" do
                %a.maruku-ref{:href => "#MilnorTheoremOnDualSteenrodAlgebra"}
              %a.maruku-ref{:href => "#hGeneratorsinClassicalAdamsSpectralSequence"}
              to be (this idea is due to (
              %a{:href => "#Ravenel86"}> Ravenel 86, p.69
              ))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi h
                        %mrow
                          %mi i
                          %mo ,
                          %mi n
                      %mo{:stretchy => "false"} |
                    %mo ≔
                    %mn 2
                    %mi i
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    {\vert h_{i,n} \vert}
                    \\coloneqq
                    2i-1
            %p
              and extending this additively to monomials, via the unique decomposition of remark
              = succeed "." do
                %a.maruku-ref{:href => "#hGeneratorsForSteenrodAlgebraGiveUniqueDecompositionOfMonomials"}
            %p For example
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} |
                            %msubsup
                              %mi ξ
                              %mi i
                              %mn 5
                            %msubsup
                              %mi ξ
                              %mi j
                              %mn 7
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mo =
                            %mrow
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi h
                                %mrow
                                  %mi i
                                  %mo ,
                                  %mn 0
                              %msub
                                %mi h
                                %mrow
                                  %mi i
                                  %mo ,
                                  %mn 1
                              %msub
                                %mi h
                                %mrow
                                  %mi j
                                  %mo ,
                                  %mn 0
                              %msub
                                %mi h
                                %mrow
                                  %mi j
                                  %mo ,
                                  %mn 1
                              %msub
                                %mi h
                                %mrow
                                  %mi j
                                  %mo ,
                                  %mn 2
                              %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 2
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi i
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mn 3
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi j
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\vert \xi_i^5 \xi_j^7\vert
                    \&amp; =
                    {\vert h_{i,0} h_{i,1} h_{j,0} h_{j,1} h_{j,2} \vert}
                    \\\
                    \&amp; =
                    2(2i-1) + 3(2j-1)
                    \\end{aligned}
                    \\,.
            %p
              Consider the corresponding increasing
              %a.existingWikiWord{:href => "/nlab/show/filtration"} filtration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ⊂
                    %msub
                      %mi F
                      %mi p
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                    %mo ⊂
                    %msub
                      %mi F
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                    %mo ⊂
                    %mi ⋯
                    %mo ⊂
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\subset
                    F_p \mathcal{A}^\ast_{2}
                    \\subset
                    F_{p+1} \mathcal{A}^\ast_{2}
                    \\subset
                    \\cdots
                    \\subset
                    \\mathcal{A}^\ast_{2}
            %p
              with filtering stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              containing all elements of total degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \leq p
            %p
              Observe via prop.
              %a.maruku-ref{:href => "#CoproductOnDualSteenrodInTermsOfAdaptedGenerators"}
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo ,
                                %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi h
                                    %mrow
                                      %mi i
                                      %mo ,
                                      %mi n
                                  %mo ⊗
                                  %mn 1
                                %mo ⏟
                              %mrow
                                %mi deg
                                %mo =
                                %mn 2
                                %mi i
                                %mo −
                                %mn 1
                            %mo +
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mn 0
                                %mo &lt;
                                %mi k
                                %mo &lt;
                                %mi i
                              %mrow
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi h
                                    %mrow
                                      %mi i
                                      %mo −
                                      %mi k
                                      %mo ,
                                      %mi n
                                      %mo +
                                      %mi k
                                  %mo ⊗
                                  %msub
                                    %mi h
                                    %mrow
                                      %mi k
                                      %mo ,
                                      %mi n
                                %mo ⏟
                              %mrow
                                %mi deg
                                %mo =
                                %mn 2
                                %mi i
                                %mo −
                                %mn 2
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %mn 1
                                  %mo ⊗
                                  %msub
                                    %mi h
                                    %mrow
                                      %mi i
                                      %mo ,
                                      %mi n
                                %mo ⏟
                              %mrow
                                %mi deg
                                %mo =
                                %mn 2
                                %mi i
                                %mo −
                                %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Psi(h_{i,n})
                    \&amp;
                    \=
                    \\underset{deg = 2i-1}{\underbrace{h_{i,n} \otimes 1}}
                    +
                    \\underoverset{0 \lt k \lt i}{}{\sum}
                    \\underset{deg = 2i-2}{\underbrace{h_{i-k,n+k} \otimes h_{k,n}}}
                    +
                    \\underset{deg = 2i-1}{\underbrace{1 \otimes h_{i,n} }}
                    \\end{aligned}
                    \\,.
            %p
              This means that after projection to the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              Hopf algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo •
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                    %mo ⟶
                    %msub
                      %mi gr
                      %mo •
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                    %mo ≔
                    %msub
                      %mi F
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi F
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F_\bullet \mathcal{A}^\ast_{2}
                    \\longrightarrow
                    gr_\bullet \mathcal{A}^\ast_{2}
                    \\coloneqq
                    F_\bullet( \mathcal{A}^\ast_2)/F_{\bullet-1}( \mathcal{A}^\ast_2 )
            %p
              all the generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                  %annotation{:encoding => "application/x-tex"} h_{i,n}
              become
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/primitive+elements"} primitive elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo ,
                                %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo ,
                                %mi n
                            %mo ⊗
                            %mn 1
                            %mo +
                            %mn 1
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mi i
                                %mo ,
                                %mi n
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                            %mo ∈
                            %msub
                              %mi gr
                              %mo •
                            %msubsup
                              %mi 𝒜
                              %mn 2
                              %mo *
                            %mo ⊗
                            %msub
                              %mi gr
                              %mo •
                            %msubsup
                              %mi 𝒜
                              %mn 2
                              %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Psi(h_{i,n})
                    \&amp;
                    \=
                    h_{i,n}\otimes 1
                    +
                    1 \otimes h_{i,n}
                    \\;\;\;\;\;
                    \\in
                    gr_\bullet \mathcal{A}^\ast_{2}
                    \\otimes
                    gr_\bullet \mathcal{A}^\ast_{2}
                    \\end{aligned}
                    \\,.
            %p
              Hence lemma
              %a.maruku-ref{:href => "#CoModuleExtFromAToAForPrimitivelyGeneratedExteriorAlgebra"}
              applies and says that the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                  %annotation{:encoding => "application/x-tex"} Ext
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
              to itself over the
              %a.existingWikiWord{:href => "/nlab/show/associated+graded"} associated graded
              Hopf algebra is the polynomial algebra in these generators:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ext
                      %mrow
                        %msub
                          %mi gr
                          %mo •
                        %msubsup
                          %mi 𝒜
                          %mn 2
                          %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi i
                            %mo ≥
                            %mn 1
                            %mo ,
                        %mrow
                          %mrow
                            %mi n
                            %mo ≥
                            %mn 0
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext_{gr_\bullet \mathcal{A}^\ast_{2}}(\mathbb{F}_2,\mathbb{F}_2)
                    \\simeq
                    \\mathbb{F}_2[\{h_{i,n}\}_{{i \geq 1,} \atop {n \geq 0}}]
                    \\,.
            %p
              Moreover, lemma
              %a.maruku-ref{:href => "#SpectralSequenceConvergingToExtForFilteredHopfAlgebra"}
              says that this is the first page of a spectral sequence that converges to the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                  %annotation{:encoding => "application/x-tex"} Ext
              over the original Hopf algebra:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 1
                    %mo =
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi h
                      %mrow
                        %mi i
                        %mo ,
                        %mi n
                    %msub
                      %mo{:stretchy => "false"} }
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi i
                            %mo ≥
                            %mn 1
                        %mrow
                          %mrow
                            %mi n
                            %mo ≥
                            %mn 0
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Ext
                      %mrow
                        %msubsup
                          %mi 𝒜
                          %mn 2
                          %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}_1
                    \=
                    \\mathbb{F}_2[\{h_{i,n}\}_{{i \geq 1} \atop {n \geq 0}}]
                    \\;\Rightarrow\;
                    Ext_{\mathcal{A}^\ast_{2}}(\mathbb{F}_2,\mathbb{F}_2)
                    \\,.
            %p
              Moreover, again by lemma
              = succeed "," do
                %a.maruku-ref{:href => "#SpectralSequenceConvergingToExtForFilteredHopfAlgebra"}
              = succeed "-page" do
