                    \\,.
            %p Pasting this square onto the bottom of the previous one yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
