          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, cor. A1.2.12
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, prop. 5.2.1
          .proof
            %h6#proof_idea Proof idea
            %p
              One first shows that there is a resolution of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              by co-free comodules given by the complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi D
                      %mi Γ
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %msup
                      %mover
                        %mi Γ
                        %mo ¯
