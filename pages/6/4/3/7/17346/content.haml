                    \\coloneqq
                    \\Gamma \otimes_A \overline{\Gamma}^{\otimes_A^{\bullet}} \otimes_A N
            %p
              with differentials given by the alternating sum of the coproducts. This is called the
              %em cobar resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            %p To see that this is indeed a resolution, one observes that a contracting homotopy is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} |
                    %mi ⋯
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi γ
                      %mi s
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} |
                    %mi ⋯
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi γ
                      %mi s
                    %mi n
                  %annotation{:encoding => "application/x-tex"}
                    s (\gamma \gamma_1\vert \cdots \vert \gamma_s n)
                    \\coloneqq
                    \\epsilon(\gamma) \gamma_1\vert \cdots \vert \gamma_s n
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} s \gt 0
