            Proceeding in this fashion, one keeps going until the 4-page of the May spectral sequence (
            %a{:href => "#Kochman96"}> Kochman 96, lemma 5.3.5
            ). Inspection of degrees shows that this is sufficient, and one obtains:
          #TheStablePageOfTheClassicalAdamsSpectralSequenceInLowDegree.num_theorem
            %h6#theorem_8 Theorem
            %p
              %strong (stable page of classical Adams spectral sequence)
            %p
              In internal degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo −
                    %mi s
                    %mo ≤
                    %mn 12
                  %annotation{:encoding => "application/x-tex"} t-s \leq 12
              the infinity page (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InfinityPageEAdams"}
              %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
              (cor.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClassicalAdamsSpectralSequenceEstablished"}
            %p
              %img{:src => "http://ncatlab.org/nlab/files/ClassicalAdamsSpectralSequence.jpg", :width => "600"}/
            %p
              Here every dot is a generator for a copy of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} h_0
              and diagonal edges denotes multiplication with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} h_1
          %p
            e.g. (
            %a{:href => "#Ravenel86"}> Ravenel 86, theorem 3.2.11
            ,
            = succeed ")," do
              %a{:href => "#Kochman96"} Kochman 96, prop. 5.3.6
            = succeed "))" do
              %a.existingWikiWord{:href => "/nlab/show/Symmetric+spectra"} Schwede 12
