                    \\array{
                    \\mathcal{D}^{\bullet,\bullet}
                    \&amp;\stackrel{i}{\longrightarrow}&amp;
                    \\mathcal{D}^{\bullet,\bullet}
                    \\\
                    \&amp; {}_{\mathllap{k}}\nwarrow &amp; \downarrow^{\mathrlap{j}}
                    \\\
                    \&amp;&amp; \mathcal{E}^{\bullet,\bullet}
                    }
            %p observe that the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ≔
                    %mi j
                    %mo ∘
                    %mi k
                  %annotation{:encoding => "application/x-tex"}
                    d \coloneqq j \circ k
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              in that it squares to 0, due to the exactness of the exact couple:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %mo ∘
                            %mi d
                          %mtd
                            %mo =
                            %mi j
                            %mo ∘
                            %munder
                              %munder
                                %mrow
                                  %mi k
                                  %mo ∘
                                  %mi j
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo ∘
                            %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d \circ d &amp; = j \circ \underset{= 0}{\underbrace{k \circ j}} \circ k
                    \\\
                    \&amp; = 0
                    \\end{aligned}
                    \\,.
            %p
              One says that the
              %strong page
              of the exact couple is the
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℰ
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo ,
                    %mi d
                    %mo ≔
                    %mi j
                    %mo ∘
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{E}^{\bullet,\bullet}, d \coloneqq j \circ  k)
                    \\,.
            %p
              Given a cochain complex like this, we are to pass to its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
          #DerivedExactCouple.num_defn
            %h6#definition_6 Definition
            %p
              Given an exact couple, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ExactCouple"}
              %em derived exact couple
              is the diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi 𝒟
                              %mo ˜
                          %mtd
                            %mover
                              %mo ⟶
                              %mover
                                %mi i
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %mover
                              %mi 𝒟
                              %mo ˜
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi k
                                  %mo{:stretchy => "false"} ˜
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mi j
                                  %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mover
                              %mi ℰ
                              %mo ˜
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi k
                            %mo ↖
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %mi j
                                %mo ∘
                                %msup
                                  %mi i
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi H
                            %mo{:stretchy => "false"} (
                            %mi ℰ
                            %mo ,
                            %mi j
                            %mo ∘
                            %mi k
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\widetilde {\mathcal{D}}
                    \&amp;\stackrel{\tilde i}{\longrightarrow}&amp;
                    \\widetilde {\mathcal{D}}
                    \\\
                    \&amp; {}_{\mathllap{\tilde k}}\nwarrow &amp; \downarrow^{\mathrlap{\tilde j}}
                    \\\
                    \&amp;&amp; \widetilde{\mathcal{E}}
                    }
                    \\;\;\;\;
                    \\coloneqq
                    \\;\;\;\;
                    \\array{
                    im(i)
                    \&amp;\stackrel{i}{\longrightarrow}&amp;
                    im(i)
                    \\\
                    \&amp; {}_{\mathllap{k}}\nwarrow &amp; \downarrow {\mathrlap{j \circ i^{-1}}}
                    \\\
                    \&amp;&amp; H(\mathcal{E}, j \circ k)
                    }
            %p with
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ℰ
                          %mo{:stretchy => "false"} ˜
                        %mo ≔
                        %mi ker
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde{\mathcal{E}} \coloneqq ker(d)/im(d)
                  (with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ≔
                        %mi j
                        %mo ∘
                        %mi k
                      %annotation{:encoding => "application/x-tex"} d \coloneqq j \circ k
                  from def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#PageOfAnExactCouple"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi 𝒟
                          %mo{:stretchy => "false"} ˜
                        %mo ≔
                        %mi im
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde {\mathcal{D}} \coloneqq im(i)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi i
                          %mo{:stretchy => "false"} ˜
                        %mo ≔
                        %mi i
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi im
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde i \coloneqq i|_{im(i)}
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ˜
                        %mo ≔
                        %mi j
                        %mo ∘
                        %msup
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \tilde j \coloneqq j \circ i^{-1}
                  (where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi i
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} i^{-1}
                  is the operation of choosing any preimage under
                  = succeed ");" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mover
                          %mi k
                          %mo{:stretchy => "false"} ˜
                        %mo ≔
                        %mi k
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde k \coloneqq k|_{ker(d)}
                  \.
          #DerivedExactCoupleIsExactCouple.num_lemma
            %h6#lemma Lemma
            %p
              The derived exact couple in def.
              %a.maruku-ref{:href => "#DerivedExactCouple"}
              is well defined and is itself an exact couple, def.
              = succeed "." do
                %a.maruku-ref{:href => "#ExactCouple"}
          .proof
            %h6#proof Proof
            %p This is straightforward to check. For completeness we spell it out:
            %p First consider that the morphisms are well defined in the first place.
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde i
              is well-defined.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde j
              lands in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(d)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              which is in the kernel of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              by definition.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde j
              is independent of the choice of preimage: For any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mover
                        %mi 𝒟
                        %mo{:stretchy => "false"} ˜
                      %mo =
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \in \tilde {\mathcal{D}} = im(i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ,
                    %mi y
                    %mo ′
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} y, y' \in \mathcal{D}
              be two preimages under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} i(y) = i(y') = x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} i(y'-y) = 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi y
                      %mo ∈
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y'-y \in ker(i)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi y
                      %mo ∈
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y'-y \in im(k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} z \in \mathcal{E}
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                      %mo =
                      %mi y
                      %mo +
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y' = y + k(z)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi j
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j(y') = j(y) +  j(k(z)) = j(y) + d(z)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d(z) = 0
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ℰ
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde{\mathcal{E}}
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde k
              vanishes on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(d)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} im(d) \subset im(j)
              and hence by exactness.
            %p
              That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi k
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde k
              lands in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(i)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo ∘
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(d) = ker(j \circ k)
              it lands in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ker(j)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi im
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} im(i)
            %p That the sequence of maps is again exact:
            %p
              The kernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde j
              is those
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in \im(i)
              such that their preimage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^{-1}(x)
              is still in
