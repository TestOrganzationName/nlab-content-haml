            %p
              is the derived
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidalStableHomotopyCategory"}> corollary
              ) of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              with the stage
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Y_n
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidalStableHomotopyCategory"}> cor.
              ), and where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Y
                      %mi n
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msubsup
                          %mi ℓ
                          %mrow
                            %msub
                              %mi Y
                              %mi n
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                    %mi 𝕊
                    %mo ∧
                    %msub
                      %mi Y
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %mi e
                        %mo ∧
                        %mi id
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    g_n
                    \\;\colon\;
                    Y_n
                    \\underoverset{\simeq}{\ell^{-1}_{Y_n}}{\longrightarrow}
                    \\mathbb{S} \wedge Y_n
                    \\overset{e \wedge id}{\longrightarrow}
                    E \wedge Y_{n}
            %p
              is the composition of the inverse derived
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Y_n
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidalStableHomotopyCategory"}> cor.
              ) with the derived
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
              of the unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and the identity on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Y
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Y_n
            %p
              Hence, by def
              = succeed "," do
                %a.maruku-ref{:href => "#AdamsTypeSpectralSequenceOfATower"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 1
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi A
                      %mi s
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi t
                        %mo −
                        %mi s
                  %annotation{:encoding => "application/x-tex"}
                    E_1^{s,t}(X,Y)
                    \\;\coloneqq\;
                    [X, A_s ]_{t-s}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi g
                    %mo ∘
                    %mi h
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    d_1 = [X, g \circ h]
            %p and the differentials are of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi s
                        %mo +
                        %mi r
                        %mo ,
                        %mi t
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_r
                    \\;\colon\;
                    E_r^{s,t}(X,Y)
                    \\longrightarrow
                    E_r^{s+r, t+r-1}(X,Y)
                    \\,.
            %p
              A priori
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mo •
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_r^{\bullet,\bullet}(X,Y)
              is
              = succeed "-graded," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                      %mo ×
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}\times \mathbb{Z}
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mi r
                      %mrow
                        %mi s
                        %mo &lt;
                        %mn 0
                        %mo ,
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    E_r^{s \lt 0,\bullet}(X,Y) \coloneqq 0
            %p and trivially extending the definition of the differentials to these zero-groups.
          %p
            (
            %a{:href => "#Adams74"}> Adams 74, theorem 15.1 page 318
            )
          .num_remark
            %h6#remark_5 Remark
            %p The morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi g
                      %mi k
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi Y
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mover
                      %mo ⟶
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi e
                        %mo ∧
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi Y
                              %mi k
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    [X,g_k]
                    \\;\colon\;
                    [X,Y_k]_\bullet
                    \\overset{[X,e \wedge id_{Y_k}]  }{\longrightarrow}
                    [X, E \wedge Y_k]_\bullet
            %p
              in def.
              %a.maruku-ref{:href => "#AdamsEAdamsSpectralSequence"}
              is sometimes called the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Boardman+homomorphism"} Boardman homomorphism
              (
              %a{:href => "#Adams74"}> Adams 74, p. 58
              ).
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{S}
              the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              it reduces to a canonical morphism from stable homotopy to
              %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#EMHomology"}> rmk.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(g_k)
                    \\;\colon\;
                    \\pi_\bullet(Y_k)
                    \\longrightarrow
                    E_\bullet(Y_k)
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                  %annotation{:encoding => "application/x-tex"} E =
              %a.existingWikiWord{:href => "/nlab/show/HA"} HA
              an
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#ReducedALinearizationOfnSphere"}> def.
              ) this in turn reduces to the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+homomorphism"} Hurewicz homomorphism
              for spectra.
            %p
              This way one may think of the
              = succeed "-Adams" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              in def.
              %a.maruku-ref{:href => "#AdamsEAdamsSpectralSequence"}
              as the result of filtering any spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              by iteratively projecting out all its
              = succeed "-homology." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
              by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Frank+Adams"} John Frank Adams
              = succeed ")" do
                %a{:href => "#Adams+spectral+sequence#Bruner09"} Bruner 09
          %p
            It is convenient to adopt the following notation for
            = succeed "-Adams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "):" do
              %a.maruku-ref{:href => "#AdamsEAdamsSpectralSequence"}
          #HomotopyFiberOfUnitOfCommutativeRingSpectrum.num_defn
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∧
                    %mo ,
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mu,e) \in CMon(Ho(Spectra),\wedge, \mathbb{S})
              a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ), write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{E}
              for the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of its unit
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝕊
                      %mo →
                      %mi E
                    %annotation{:encoding => "application/x-tex"} e \colon \mathbb{S}\to E
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              (equivalently a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
              = succeed ")" do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#HomotopyCofiberSequencesAreHomotopyFiberSequencesInSpectra"} prop.
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo ¯
                    %mo ⟶
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mi e
                    %mi E
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{E}
                    \\longrightarrow
                    \\mathbb{S}
                    \\overset{e}{\longrightarrow}
                    E
                    \\,,
            %p
              equivalently an
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} exact triangle
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> prop.
              ) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi E
                      %mo ¯
                    %mo ⟶
                    %mi 𝕊
                    %mover
                      %mo ⟶
                      %mi e
                    %mi E
                    %mo ⟶
                    %mi Σ
                    %mover
                      %mi E
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{E}
                    \\longrightarrow
                    \\mathbb{S}
                    \\overset{e}{\longrightarrow}
                    E
                    \\longrightarrow
                    \\Sigma \overline{E}
                    \\,.
          %p
            (
            %a{:href => "#Adams74"}> Adams 74, theorem 15.1 page 319
            ) Beware that for instance (
