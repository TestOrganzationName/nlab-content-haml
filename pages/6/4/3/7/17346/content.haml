            %p
              and with
              %a.existingWikiWord{:href => "/nlab/show/differentials"} differentials
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi s
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi C
                      %mi Γ
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msubsup
                      %mi C
                      %mi Γ
                      %mrow
                        %mi s
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d_s \colon C^s_\Gamma(N) \longrightarrow C^{s+1}_\Gamma(N)
              given by the alternating sum of the coproducts via lemma
              = succeed "." do
                %a.maruku-ref{:href => "#PropertiesOfUnitCoideal"}
          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, def. A1.2.11
            )
          #CobarComplexGivesExtGroupsOutOfA.num_prop
            %h6#proposition_18 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
