          #ExactCoupleSpectralSequence.num_defn
            %h6#definition_7 Definition
            %p
              Given an exact couple, def.
              = succeed "," do
                %a.maruku-ref{:href => "#ExactCouple"}
              %strong
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
                of the exact couple
              is the sequence of pages, def.
              = succeed "," do
                %a.maruku-ref{:href => "#PageOfAnExactCouple"}
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedExactCouple"}
              = succeed "." do
                %a.maruku-ref{:href => "#DerivedExactCoupleIsExactCouple"}
            %p
              The
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                th page
              of the spectral sequence is the page (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PageOfAnExactCouple"}
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ℰ
                      %mi r
                    %mo ,
                    %msub
                      %mi d
                      %mi r
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{\mathcal{E}_r, d_r\}
                    \\,.
          #TermsOfNextPageOnSpectralSequence.num_remark
            %h6#remark_4 Remark
            %p
              So the spectral sequence of an exact couple (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExactCoupleSpectralSequence"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℰ
                        %mi r
                      %mo ,
                      %msub
                        %mi d
                        %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{E}_r, d_r)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo ≃
                    %mi H
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℰ
                      %mi r
                    %mo ,
                    %msub
                      %mi d
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}_{r+1} \simeq H(\mathcal{E}_r,d_r)
                    \\,.
            %p
              In practice this is used as a successive stagewise approximation to the computation of a limiting term
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℰ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}_\infty
              %em convergence
              of the spectral sequence, we come to this
              = succeed "." do
                %a{:href => "#Convergence"} below
          %p
            Def.
            %a.maruku-ref{:href => "#ExactCoupleSpectralSequence"}
            makes sense without a (bi-)grading on the terms of the exact couple, but much of the power of spectral sequences comes from the cases where such a bigrading is given, since together with the sequence of pages of the spectral sequence, this tends to organize computation of the successive cohomology groups in an efficient way. Therefore consider:
