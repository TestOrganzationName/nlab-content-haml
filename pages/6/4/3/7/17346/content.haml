          #pInvertedInZ.num_defn
            %h6#definition_25 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %munder
                      %mi lim
                      %mo ⟶
                    %mrow
                      %mo (
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mrow
                          %mi p
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mrow
                          %mi p
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mrow
                      %mi ⋯
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}[1/p]
                    \\coloneqq
                    \\underset{\longrightarrow}{\lim}
                    \\left(
                    \\mathbb{Z}
                    \\overset{p \cdot (-)}{\longrightarrow}
                    \\mathbb{Z}
                    \\overset{p \cdot (-)}{\longrightarrow}
                    \\mathbb{Z}
                    \\overset{}{\longrightarrow}
                    \\cdots
                    \\right)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              (in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              generated by formal expressions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi p
                          %mi k
                  %annotation{:encoding => "application/x-tex"} \frac{1}{p^k}
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ⋅
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi p
                          %mrow
                            %mi k
                            %mo +
                            %mn 1
                    %mo =
                    %mi n
                    %mfrac
                      %mn 1
                      %mrow
                        %msup
                          %mi p
                          %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (p \cdot n) \frac{1}{p^{k+1}}
                    \=
                    n \frac{1}{p^k}
                    \\,.
            %p
              Equivalently it is the abelian group underlying the
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} ring localization
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/p]
          #AbelianGrouppComplete.num_defn
            %h6#definition_26 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              = succeed ")" do
                %a.maruku-ref{:href => "#AbelianGroupLocal"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/p]
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#pInvertedInZ"}
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  \-completion of abelian groups
          #CharacterizingpCompleteAbelianGroupsBypSequence.num_lemma
            %h6#lemma_12 Lemma
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              = succeed "-complete" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.maruku-ref{:href => "#AbelianGrouppComplete"}
              precisely if both the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              as well as the
              %a.existingWikiWord{:href => "/nlab/show/lim%5E1"} lim^1
              of the sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mover
                      %mo ⟶
                      %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mi p
                    %mi A
                    %mover
                      %mo ⟶
                      %mi p
                    %mi A
                    %mover
