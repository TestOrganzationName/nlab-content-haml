                  %annotation{:encoding => "application/x-tex"}
                    id
                    \\;\colon\;
                    E \wedge Y_p
                    \\overset{E \wedge g_p}{\longrightarrow}
                    E \wedge E \wedge Y_p
                    \\overset{\mu \wedge id}{\longrightarrow}
                    E \wedge Y_p
                    \\,.
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
