                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi ϕ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi δ
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
