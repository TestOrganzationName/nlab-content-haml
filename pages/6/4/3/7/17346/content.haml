            %p
              This is not
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} 2-primary
              %a.existingWikiWord{:href => "/nlab/show/p-adic+completion"} 2-adic completion
              of abelian groups (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdicCompletionOfAbelingGroups"}
              = succeed "." do
                %a.maruku-ref{:href => "#FundamentalTheoremOfFinitelyGeneratedAbelianGroups"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
