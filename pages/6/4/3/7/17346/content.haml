                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %msup
                              %mi p
                              %mi n
                            %mi ℤ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
