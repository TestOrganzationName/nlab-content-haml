                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi E
                        %mo ∧
                        %mi X
                        %mo →
                        %mi E
                        %mo ∧
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} E \wedge f \;\colon\; E \wedge X \to E \wedge Y
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  in
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi Spectra
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Ho(Spectra)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_\bullet(f)
                  is an isomorphism in
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
              %li
                %p
                  a spectrum
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  is
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
