            %h6#proof_22 Proof
            %p
              By theorem
              %a.maruku-ref{:href => "#pCompletionOfAbelianGroupsByHomsOutOfZpinfinity"}
              the
              = succeed "-completion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
