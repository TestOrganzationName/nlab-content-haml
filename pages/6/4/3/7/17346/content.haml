              ).
          #ZpInfinity.num_defn
            %h6#definition_27 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}(p^\infty)
                    \\coloneqq
                    \\mathbb{Z}[1/p]/\mathbb{Z}
            %p
              (the
              %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} p-primary
              part of
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                      %mo{:stretchy => "false"} /
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}/\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %munder
                      %mi lim
                      %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mover
                      %mo →
                      %mi p
                    %mi ℤ
                    %mover
                      %mo →
                      %mi p
                    %mi ℤ
                    %mo →
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/p] = \underset{\longrightarrow}{\lim}(\mathbb{Z}\overset{p}{\to} \mathbb{Z} \overset{p}{\to} \mathbb{Z} \to \cdots )
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#pInvertedInZ"}
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              commute over each other, this is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
                      %mn ∞
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ↪
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo ↪
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mo ↪
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}(p^\infty)
                    \\simeq
                    \\underset{\longrightarrow}{\lim}
                    ( 0 \hookrightarrow \mathbb{Z}/p\mathbb{Z} \hookrightarrow \mathbb{Z}/p^2 \mathbb{Z} \hookrightarrow \cdots )
                    \\,.
          #pCompletionOfAbelianGroupsByHomsOutOfZpinfinity.num_theorem
            %h6#theorem_4 Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/p]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⟶
                    %msub
                      %mi L
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} /
                        %mi p
                        %mo{:stretchy => "false"} ]
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A \longrightarrow L_{\mathbb{Z}[1/p]} A
            %p
              of an abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#pInvertedInZ"}
              = succeed ")," do
                %a.maruku-ref{:href => "#AbelianGroupLocal"}
              = succeed "-completion" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              according to def.
