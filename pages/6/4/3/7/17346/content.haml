                    D^{s,t}(X,Y) &amp; \coloneqq [X,Y_s]_{t-s}
                    \\\
                    E^{s,t}(X,Y) &amp; \coloneqq [X,A_s]_{t-s}
                    \\end{aligned}
                    \\,.
            %p Then the bidegree of the morphisms is
            %table
              %thead
                %tr
                  %th morphism
                  %th bidegree
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
