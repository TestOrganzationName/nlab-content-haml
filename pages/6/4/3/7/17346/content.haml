          %title Contents
          %hr/
          %p
            This page gives a detailed introduction to the
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            in its general
            %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectral
            form (
            %a.existingWikiWord{:href => "/nlab/show/Adams-Novikov+spectral+sequence"}> Adams-Novikov spectral sequence
            ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            For background on
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            see
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Spectral+Sequences"} Introduction to Spectral Sequences
          %p
            For background on
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            see
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory"} Introduction to Stable homotopy theory
          %p
            For background on
            %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology"} complex oriented cohomology
            see
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Cobordism+and+Complex+Oriented+Cohomology"} Introduction to Cobordism and Complex Oriented Cohomology
          %hr/
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
