              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mn 2
                        %msub
                          %mi b
                          %mrow
                            %mn 2
                            %mo ,
                            %mn 0
                        %mo =
                        %msub
                          %mi h
                          %mn 0
                        %msub
                          %mi x
                          %mn 7
                      %annotation{:encoding => "application/x-tex"} h_2 b_{2,0} = h_0 x_7
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mn 2
                        %msub
                          %mi x
                          %mn 7
                        %mo =
                        %msub
                          %mi h
                          %mn 0
                        %msub
                          %mi b
                          %mrow
                            %mn 2
                            %mo ,
