              %li
                %a{:href => "#References"} References
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            The main result of
            %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-1"} Part 1.1
            was the construction of the
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho(Spectra)
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableModelStructureOnSequentialSpectraIsModelCategory"}> thm.
            ,
            = succeed ")" do
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TheStableHomotopyCategory"} def.
            %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated category
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> prop.
            ) with graded abelian hom groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
            ).
          %p
            These are the basic invariants of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups+of+spheres"} stable homotopy groups of spheres
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(\mathbb{S})
            = succeed ".)" do
              %a{:href => "#StableStems"} below
          %p
            In order to get more control over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(Spectra)
            %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-2"} Part 1.2
            was the construction of
            %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated category
            structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ho(Spectra)
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#TensorTriangulatedStructureOnStableHomotopyCategory"}> prop.
            ), induced form a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∧
                %annotation{:encoding => "application/x-tex"} \wedge
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#StableModelStructureWithSymmetricMonoidalSmashProductSatisfiesPushoutProductAxiom"}> thm.
            )
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Ho
                  %mo{:stretchy => "false"} (
                  %mi Spectra
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ∧
                  %mo ,
                  %mi 𝕊
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (Ho(Spectra), \wedge, \mathbb{S})
                  \\,.
          %p
            As discussed in
            %em
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+I"} Part I
            (and briefly reviewed
            = succeed ")," do
              %a{:href => "#SpectralSequenceOfAFilteredSpectrum"} below
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
            in
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            into tractable computations in
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            are
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            %a.existingWikiWord{:href => "/nlab/show/filtered+objects"} filtrations
            on spectra. Using the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated structure
            %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
            ) induces a well-adapted filtration on spectra that allows to compute the “
            %a.existingWikiWord{:href => "/nlab/show/formal+neighbourhood"} formal neighbourhood
            around
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed ")" do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                \-
                %a.existingWikiWord{:href => "/nlab/show/nilpotent+completion"} nilpotent completion
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              \-
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            which we discuss here.
          %p
            Where the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
            (see
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} part S
            = succeed ")" do
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#AHSSExistence"} this prop.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
            via the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(X,\pi_\bullet(Y))
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            is to make use of an auxiliary
            %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            and approximate maps of spectra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \to Y
            via their image
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_\bullet(X) \to E_\bullet(Y)
            in
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#EMHomology"}> rmk
            ).
          %p
            But in order for maps of homology groups to have a chance to retain enough information, they should be forced to be equivariant with respect to extra structure inherited by forming
            = succeed "-homology." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            For instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                %annotation{:encoding => "application/x-tex"} E =
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %msub
                    %mi 𝔽
                    %mn 2
                %annotation{:encoding => "application/x-tex"} H \mathbb{F}_2
            then the
            %a.existingWikiWord{:href => "/nlab/show/dual+Steenrod+algebra"} dual Steenrod algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            (co-)acts on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msub
                    %mi 𝔽
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_\bullet(X) = H_\bullet(X,\mathbb{F}_2)
            and a necessary condition for a morphism of homology groups to come from a morphism of spectra is that it is a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            with respect to this co-action. The
            %a.existingWikiWord{:href => "/nlab/show/classical+Adams+spectral+sequence"} classical Adams spectral sequence
            (discussed
            = succeed ")," do
              %a{:href => "#ClassicalAdamsSpectralSequence"} below
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi 𝔽
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{A}}(H_\bullet(X,\mathbb{F}_2), H_\bullet(Y,\mathbb{F}_2))
          %p
            More generally, since spectra are equivalently
            %a.existingWikiWord{:href => "/nlab/show/module+spectra"} module spectra
            over the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}
            = succeed "-homology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ↦
                  %mi E
                  %mo ∧
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \mapsto E \wedge X
            is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/extension+of+scalars"} extension of scalars
            along the ring unit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕊
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \mathbb{S}\longrightarrow E
            = succeed "-homology" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
            diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                  %mo ⟶
                  %mi E
                  %mover
                    %mo ⟶
                    %mo ⟶
                  %mi E
                  %mo ∧
                  %mi E
                  %mover
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mo ⟶
                  %mi E
                  %mo ∧
                  %mi E
                  %mo ∧
                  %mi E
                  %mover
                    %mover
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mo ⟶
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{S} \longrightarrow E \stackrel{\longrightarrow}{\longrightarrow} E \wedge E \stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                  E \wedge E \wedge E
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}
                  \\cdots
                  \\,.
          %p
            In good cases this gives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_\bullet(X)
            the structure of a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            over the
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebroid"} Hopf algebroid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ∧
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟵
                    %mo ⟵
                  %msub
                    %mi E
                    %mo •
                %annotation{:encoding => "application/x-tex"} \pi_\bullet(E \wedge E) = E_\bullet(E) \stackrel{\longleftarrow}{\longleftarrow} E_\bullet
            of “dual
            = succeed "-Steenrod" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
            approximates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi Y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo •
                %annotation{:encoding => "application/x-tex"} [X,Y]_\bullet
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Hom_{E_\bullet(E)}(E_\bullet(X),E_\bullet(Y))
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo =
                %annotation{:encoding => "application/x-tex"} E =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/MU"} MU
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/BP"} BP
            %em
              %a.existingWikiWord{:href => "/nlab/show/Adams-Novikov+spectral+sequence"}> Adams-Novikov spectral sequence
              , considered
              = succeed "." do
                %a{:href => "#AdamsNovikovSpectralSequence"} below
          %p We discuss first the
          %ul
            %li
              %a{:href => "#TheoryforAdamsSpectralSequences"} General theory of E-Adams spectral sequences
          %p and then consider the classical
          %ul
            %li
              %a{:href => "#ExamplesOfAdamsSpectralSequences"} Examples and applications
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            First we set up the general theory of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
            = succeed ".)" do
              %a{:href => "#ExamplesOfAdamsSpectralSequences"} below
          %p
            %strong Literature
            (
            %a{:href => "#Adams74"}> Adams 74, part III.15
            ,
            = succeed "," do
              %a{:href => "#Bousfield79"} Bousfield 79, sections 5 and 6
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, appendix A
          %h2#the_spectral_sequence The spectral sequence
          %h3#SpectralSequenceOfAFilteredSpectrum Filtered spectra
          %p
            We introduce the types of
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequences"} spectral sequences
            of which the
            = succeed "-Adams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.maruku-ref{:href => "#AdamsEAdamsSpectralSequence"}
            below) are an example.
          #FilteredSpectrum.num_defn
            %h6#definition Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/filtered+spectrum"} filtered spectrum
              is a
              %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y \in Ho(Spectra)
              equipped with a sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %mi ℕ
                    %mo ,
                    %mo &gt;
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y_\bullet \colon (\mathbb{N}, \gt) \longrightarrow Ho(Spectra)
              in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
              ) of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ⟶
                    %msub
                      %mi Y
                      %mn 3
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 2
                    %msub
                      %mi Y
                      %mn 2
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 1
                    %msub
                      %mi Y
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mn 0
                    %msub
                      %mi Y
                      %mn 0
                    %mo ≔
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\longrightarrow
                    Y_3
                    \\overset{f_2}{\longrightarrow}
                    Y_2
                    \\overset{f_1}{\longrightarrow}
                    Y_1
                    \\overset{f_0}{\longrightarrow}
                    Y_0
                    \\coloneqq
                    Y
                    \\,.
          .num_remark
            %h6#remark Remark
            %p
              More generally a
              %a.existingWikiWord{:href => "/nlab/show/filtered+object+in+an+%28infinity%2C1%29-category"} filtering
              on an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in (stable or not)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              is a
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
