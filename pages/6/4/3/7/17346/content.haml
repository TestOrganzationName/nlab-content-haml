                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1 \neq p_2
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              of order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_1 p_2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/p_1 \mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p_2 \mathbb{Z}
                    \\,.
            %p
              This is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %msub
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mo ≃
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 1
                    %mi ℤ
                    %mo ⊕
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi p
                      %mn 2
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/p_1 p_2 \mathbb{Z}
                    \\simeq
                    \\mathbb{Z}/p_1 \mathbb{Z}
                    \\oplus
                    \\mathbb{Z}/p_2 \mathbb{Z}
                    \\,.
            %p
              The isomorphism is given by sending
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mn 2
                      %mo ,
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p_2,p_1)
          .num_example
            %h6#example_7 Example
            %p
              Moving up, for two distinct prime numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
