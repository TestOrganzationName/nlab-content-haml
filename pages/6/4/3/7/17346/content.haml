              the unit coideal of def.
              = succeed "," do
                %a.maruku-ref{:href => "#UnitCoidealInCommutativeHopfAlgebra"}
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
