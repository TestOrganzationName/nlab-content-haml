          .proof
            %h6#proof_20 Proof
            %p
              By def.
              %a.maruku-ref{:href => "#AbelianGroupLocal"}
              the group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/p]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathbb{Z}[1/p], A) \simeq 0
                    \\;\;\;\;\;\;\;
                    and
                    \\;\;\;\;\;\;\;
                    Ext^1(\mathbb{Z}[1/p], A) \simeq 0
                    \\,.
            %p
              Now use the colimit definition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/p] = \underset{\longrightarrow}{\lim}_n \mathbb{Z}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#pInvertedInZ"}
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              sends colimits in the first argument to limits to deduce that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} /
                            %mi p
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi n
                            %mi ℤ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi n
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi n
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Hom(\mathbb{Z}[1/p], A)
                    \&amp; =
                    Hom( \underset{\longrightarrow}{\lim}_n \mathbb{Z}, A  )
                    \\\
                    \&amp; \simeq
                    \\underset{\longleftarrow}{\lim}_n Hom(\mathbb{Z},A)
                    \\\
                    \&amp; \simeq
                    \\underset{\longleftarrow}{\lim}_n A
                    \\end{aligned}
                    \\,.
            %p
              This yields the first statement. For the second, use that for every
              %a.existingWikiWord{:href => "/nlab/show/cotower"} cotower
              over abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mo •
                  %annotation{:encoding => "application/x-tex"} B_\bullet
              there is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                      %mn 1
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %msub
                      %mi B
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mi n
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
