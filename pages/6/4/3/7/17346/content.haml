            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo{:stretchy => "false"} (
                    %mi γ
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    s(\gamma n) \coloneqq 0
                    \\,.
            %p
              Now from lemma
              = succeed "," do
                %a.maruku-ref{:href => "#CoFreeHopfComodulesAreHomNAcyclicForProjectiveN"}
              = succeed "," do
                %a.maruku-ref{:href => "#DirectSumDecompositionUnitCoideal"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
