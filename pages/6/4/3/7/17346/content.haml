                    %mi Γ
                    %mo ≃
                    %mi A
                    %mo ⊕
                    %mover
                      %mi Γ
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \simeq A \oplus \overline{\Gamma}
                    \\,.
          #PropertiesOfUnitCoideal.num_lemma
            %h6#lemma_17 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebra"} commutative Hopf algebra
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              for which the left and right units coincide
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi A
                      %mo ⟶
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"}
                      \\eta \;\colon\;
                      A \longrightarrow \Gamma
            %p
              Then the unit coideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\Gamma}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#UnitCoidealInCommutativeHopfAlgebra"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/bimodule"} bimodule
              such that the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ⟶
                    %mover
                      %mi Γ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \longrightarrow \overline{\Gamma}
            %p
              is an
              = succeed "-bimodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Γ
                    %mo ⟶
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Psi \;\colon\; \Gamma \longrightarrow \Gamma \otimes_A \Gamma
              descends to a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo ¯
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi Γ
                      %mo ¯
                    %mo ⟶
                    %mover
                      %mi Γ
                      %mo ¯
                    %msub
                      %mo ⊗
                      %mi A
                    %mover
                      %mi Γ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\Gamma} \;\colon\; \overline{\Gamma} \longrightarrow \overline{\Gamma} \otimes_A \overline{\Gamma}
              such that the projection intertwines the two coproducts.
          .proof
            %h6#proof_30 Proof
            %p
              For the first statement, consider the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi A
                                %mo ⊗
                                %mi η
                          %mtd
                            %mi A
                            %mo ⊗
                            %mi Γ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi A
                            %mo ⊗
                            %mover
                              %mi Γ
                              %mo ¯
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∃
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Γ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi Γ
                              %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A \otimes A
                    \&amp;\overset{A \otimes \eta}{\longrightarrow}&amp;
                    A \otimes \Gamma
                    \&amp;\longrightarrow&amp;
                    A \otimes \overline{\Gamma}
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{\exists}}
                    \\\
                    A
                    \&amp;\underset{\eta}{\longrightarrow}&amp;
                    \\Gamma
                    \&amp;\longrightarrow&amp;
                    \\overline{\Gamma}
                    }
                    \\,,
            %p
              where the left
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              exhibits the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is a homomorphism of left
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              is a
              %a.existingWikiWord{:href => "/nlab/show/right+exact+functor"} right exact functor
              it preserves cokernels, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mover
                      %mi Γ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} A \otimes \overline{\Gamma}
              is the cokernel of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi A
                    %mo →
                    %mi A
                    %mo ⊗
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} A \otimes A \to A\otimes \Gamma
              and hence the right vertical morphisms exists by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of cokernels. This is the compatible left module structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi Γ
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} \overline{\Gamma}
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %p
              For the second statement, consider the
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ⟶
                              %mi η
                          %mtd
                            %mi Γ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi Γ
                              %mo ¯
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi η
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi Ψ
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mo ∃
                        %mtr
                          %mtd
                            %mi Γ
                            %mo ≃
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi A
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi id
                                %msub
                                  %mo ⊗
                                  %mi A
                                %mi η
                          %mtd
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi Γ
                          %mtd
                            %mo ⟶
                          %mtd
                            %mover
                              %mi Γ
                              %mo ¯
                            %msub
                              %mo ⊗
                              %mi A
                            %mover
                              %mi Γ
                              %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A
                    \&amp;\overset{\eta}{\longrightarrow}&amp;
                    \\Gamma
                    \&amp;\longrightarrow&amp;
                    \\overline{\Gamma}
                    \\\
                    {}^{\mathllap{\eta}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\Psi}}
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\exists}}
                    \\\
                    \\Gamma \simeq \Gamma \otimes_A A
                    \&amp;\underset{id \otimes_A \eta}{\longrightarrow}&amp;
                    \\Gamma \otimes_A \Gamma
                    \&amp;\longrightarrow&amp;
                    \\overline{\Gamma} \otimes_A \overline{\Gamma}
