              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E_\bullet(Y)
          %p
            (
            %a{:href => "#Adams74"}> Adams 74, theorem 15.1, page 322
            )
          .proof
            %h6#proof_13 Proof
            %p
              Consider the image of the defining
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi p
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi g
                          %mi p
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mi p
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi h
                          %mi p
                    %mi Σ
                    %msub
                      %mi Y
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    Y_p
                    \\overset{g_p}{\longrightarrow}
                    E \wedge Y_p
                    \\overset{h_p}{\longrightarrow}
                    \\Sigma Y_{p+1}
            %p
              under the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E \wedge (-)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mi p
                    %mover
                      %mo ⟶
                      %mrow
                        %mi E
                        %mo ∧
                        %msub
                          %mi g
                          %mi p
                    %mi E
                    %mo ∧
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mi p
                    %mover
                      %mo ⟶
                      %mrow
                        %mi E
                        %mo ∧
                        %msub
                          %mi h
                          %mi p
                    %mi Σ
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    E \wedge Y_p
                    \\overset{E \wedge g_p}{\longrightarrow}
                    E \wedge E \wedge Y_p
                    \\overset{E \wedge h_p}{\longrightarrow}
                    \\Sigma E \wedge Y_{p + 1}
            %p
              (due to the
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated
              structure of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#TensorTriangulatedStructureOnStableHomotopyCategory"} prop.
            %p
              Applying the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %mi 𝕊
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \pi_\bullet(-) \simeq [\mathbb{S},-]_\bullet
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyGrouspAsHomsOutOfSphereSpectrum"}> lemma
              ) to this yields a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#LongExactSequenceOfStableHomotopyGroups"}> prop.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ⟶
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi p
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi g
                          %mi p
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi h
                          %mi p
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi E
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi p
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Y
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi E
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi g
                          %mi p
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi E
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\longrightarrow
                    E_{\bullet}(Y_{p+1})
                    \\overset{ E_\bullet(f_p) }{\longrightarrow}
                    E_\bullet(Y_p)
                    \\overset{ E_\bullet(g_p) }{\longrightarrow}
                    E_\bullet(A_p)
                    \\overset{ E_\bullet(h_p) }{\longrightarrow}
                    E_{\bullet-1}(Y_{p+1})
                    \\overset{ E_{\bullet-1}(f_p) }{\longrightarrow}
                    E_{\bullet-1}(Y_{p})
                    \\overset{ E_{\bullet-1}(g_p) }{\longrightarrow}
                    E_{\bullet-1}(A_p)
                    \\longrightarrow
                    \\cdots
                    \\,.
            %p
              But in fact this
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} splits
              %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi μ
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (E,\mu,e)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              on the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+inverse"} left inverse
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi p
                  %annotation{:encoding => "application/x-tex"} g_p
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mi p
