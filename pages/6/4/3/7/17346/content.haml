                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} 0 \to A
            %p
              Given a morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f \colon A \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ⟶
                    %mi B
                    %mo{:stretchy => "false"} /
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B \longrightarrow B/A
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber"} homotopy cofiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
