                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p_i^{k_i}\mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⋅
