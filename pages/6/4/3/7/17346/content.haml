              = succeed ")." do
                %a.maruku-ref{:href => "#AbelianGrouppComplete"}
          .proof
            %h6#proof_21 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#CharacterizingpCompleteAbelianGroupsBypSequence"}
              we need to check that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ⟵
                    %mrow
                      %mo (
                      %mi ⋯
                      %mover
                        %mo ⟶
                        %mi p
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mi n
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mi p
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mi n
                      %mi ℤ
                      %mover
                        %mo ⟶
                        %mi p
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mi n
                      %mi ℤ
