                    \&amp;&amp; \underset{s,t}{\oplus} E^{s,t}(X,Y)
                    }
                    \\;\;\;\;
                    \\coloneqq
                    \\;\;\;\;
                    \\array{
                    \\underset{s,t}{\oplus} [X,Y_s]_{t-s}
                    \&amp;\overset{[X,f]}{\longrightarrow}&amp;
                    \\underset{s,t}{\oplus} [X,Y_s]_{t-s}
                    \\\
                    \&amp; {}_{\mathllap{ [X,h] }}\nwarrow &amp; \downarrow^{\mathrlap{[X,g]}}
                    \\\
                    \&amp;&amp; [X,A_s]_{t-s}
                    }
            %p with the following bidegree of the differentials:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒟
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi 𝒟
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                            %mo ↖
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi ℰ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg = \;\;\;\;
                    \\array{
                    \\mathcal{D} &amp;\stackrel{(-1,-1)}{\longrightarrow}&amp; \mathcal{D}
                    \\\
                    \&amp;{}_{\mathllap{(1,0)}}\nwarrow&amp; \downarrow^{\mathrlap{(0,0)}}
                    \\\
                    \&amp;&amp; \mathcal{E}
                    }
                    \\,.
            %p In particular the first page is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℰ
                      %mn 1
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msub
                      %mi A
                      %mi s
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi t
                        %mo −
                        %mi s
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{E}^{s,t}_1
                    \=
                    [X,A_s]_{t-s}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi g
                    %mo ∘
                    %mi h
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_1
                    \=
                    [X, g \circ h]
                    \\,.
            %p
              As we pass to derived exact couples, by def.
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedExactCouple"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is preserved, but that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              increases by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,1)
              with each page, since (by def.
              = succeed ")" do
                %a.maruku-ref{:href => "#PageOfAnExactCouple"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mover
                              %mi j
                              %mo{:stretchy => "false"} ˜
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo ∘
                            %msup
                              %mi i
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    deg(\tilde j)
                    \&amp;
                    \= deg( j \circ i^{-1})
                    \\\
                    \&amp;= deg(j) - deg(i)
                    \\\
                    \&amp; = deg(j) + (1,1)
                    \\end{aligned}
                    \\,.
            %p Similarly the first differential has degree
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo ∘
                            %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi k
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mn 0
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    deg(j \circ k )
                    \&amp; =
                    deg(j) + deg(k)
                    \\\
                    \&amp;= (1,0) + (0,0)
                    \\\
                    \&amp; = (1,0)
                    \\end{aligned}
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "http://ncatlab.org/nlab/files/adamstypedifferentials.jpg", :width => "360"}/
            %p
              and so the differentials on the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi r
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi ℰ
                      %mi r
                      %mrow
                        %mi s
                        %mo ,
                        %mi t
                    %mo ⟶
                    %msubsup
                      %mi ℰ
                      %mi r
                      %mrow
                        %mi s
                        %mo +
                        %mi r
                        %mo ,
                        %mi t
                        %mo +
                        %mi r
                        %mo −
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_r
                    \\;\colon\;
                    \\mathcal{E}_r^{s,t}
                    \\longrightarrow
                    \\mathcal{E}_r^{s+r, t+r-1}
                    \\,.
            %p
              It is conventional to depict this in tables where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              increases vertically and upwards and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo −
                    %mi s
                  %annotation{:encoding => "application/x-tex"} t-s
              increases horizontally and to the right, so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi r
                  %annotation{:encoding => "application/x-tex"} d_r
              goes up
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              steps and always one step to the left. This is the “Adams type” grading convention for spectral sequences (different from the
              %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre-
              %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
              convention (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#AHSSExistence"}> prop.
              )). One also says that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                      %annotation{:encoding => "application/x-tex"} s
                  is the
                  = succeed ";" do
                    %em filtration degree
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo −
                        %mi s
                      %annotation{:encoding => "application/x-tex"} t-s
                  is the
                  = succeed ";" do
                    %em total degree
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                      %annotation{:encoding => "application/x-tex"} t
                  is the
                  = succeed "." do
                    %em internal degree
            %p
              A priori all this is
              = succeed "-graded," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                      %mo ×
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}\times \mathbb{Z}
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒟
                      %mrow
                        %mi s
                        %mo &lt;
                        %mn 0
                        %mo ,
                        %mo •
                    %mo ≔
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℰ
                      %mrow
                        %mi s
                        %mo &lt;
                        %mn 0
                        %mo ,
                        %mo •
                    %mo ≔
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}^{s \lt 0,\bullet} \coloneqq 0
                    \\;\;\;\;\,,
                    \\;\;\;\;
                    \\mathcal{E}^{s \lt 0, \bullet} \coloneqq 0
            %p and trivially extending the definition of the differentials to these zero-groups.
          %h3#AdamsFiltration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            \-Adams filtrations
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mu,e)
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              \-Adams spectral sequence
            is a
            %a.existingWikiWord{:href => "/nlab/show/spectral+sequence"} spectral sequence
            as in def.
            = succeed "," do
              %a.maruku-ref{:href => "#AdamsTypeSpectralSequenceOfATower"}
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕊
                    %mo ⟶
                    %mi E
                  %annotation{:encoding => "application/x-tex"} e \;\colon\; \mathbb{S} \longrightarrow E
          #AdamsEAdamsSpectralSequence.num_defn
            %h6#definition_9 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X,Y \in Ho(Spectra)
              be two
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#TheStableHomotopyCategory"}> def.
              ), and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi CMon
                    %mo{:stretchy => "false"} (
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∧
                    %mo ,
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mu,e) \in CMon(Ho(Spectra),\wedge, \mathbb{S})
              be a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ) in the
              %a.existingWikiWord{:href => "/nlab/show/tensor+triangulated+category"} tensor triangulated
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∧
                    %mo ,
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Ho(Spectra), \wedge, \mathbb{S})
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#TensorTriangulatedStructureOnStableHomotopyCategory"}> prop.
              ).
            %p
              Then the
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                \-
                %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequence"} Adams spectral sequence
              for the computation of the
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+group"} graded abelian group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %msup
                      %mi Σ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo •
                    %mi Y
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [X,Y]_\bullet
                    \\coloneqq
                    [X, \Sigma^{-\bullet} Y]
            %p
              of morphisms in the
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+category"} stable homotopy category
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#GradedAbelianGroupStructureOnHomsInTheHomotopyCategory"}> def.
              ) is the
              %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+spectrum"} spectral sequence of a filtered spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdamsTypeSpectralSequenceOfATower"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo •
                  %annotation{:encoding => "application/x-tex"} [X,-]_\bullet
              of the tower
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mi ⋮
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Y
                              %mn 3
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mn 3
                          %mtd
                            %mi E
                            %mo ∧
                            %msub
                              %mi Y
                              %mn 3
                            %mo =
                            %msub
                              %mi A
                              %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Y
                              %mn 2
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mn 2
                          %mtd
                            %mi E
                            %mo ∧
                            %msub
                              %mi Y
                              %mn 2
                            %mo =
                            %msub
                              %mi A
                              %mn 2
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mi Y
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mn 1
                          %mtd
                            %mi E
                            %mo ∧
                            %msub
                              %mi Y
                              %mn 1
                            %mo =
                            %msub
                              %mi A
                              %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 0
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                            %mo =
                          %mtd
                            %msub
                              %mi Y
                              %mn 0
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mn 0
                          %mtd
                            %mi E
                            %mo ∧
                            %msub
                              %mi Y
                              %mn 0
                            %mo =
                            %msub
                              %mi A
                              %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; \vdots
                    \\\
                    \&amp; {}^{\mathllap{f_0}}\downarrow
                    \\\
                    \&amp; Y_3 &amp;\overset{g_3}{\longrightarrow}&amp; E \wedge Y_3 = A_3
                    \\\
                    \&amp; {}^{\mathllap{f_0}}\downarrow
                    \\\
                    \&amp; Y_2 &amp;\overset{g_2}{\longrightarrow}&amp; E \wedge Y_2 = A_2
                    \\\
                    \&amp; {}^{\mathllap{f_0}}\downarrow
                    \\\
                    \&amp; Y_1 &amp;\overset{g_1}{\longrightarrow}&amp; E \wedge Y_1 = A_1
                    \\\
                    \&amp; {}^{\mathllap{f_0}}\downarrow
                    \\\
                    Y = &amp; Y_0 &amp;\overset{g_0}{\longrightarrow}&amp; E \wedge Y_0  = A_0
                    }
                    \\,,
            %p
              where each hook is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              (equivalently a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
              = succeed ")," do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#HomotopyCofiberSequencesAreHomotopyFiberSequencesInSpectra"} prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi f
                          %mi n
                    %msub
                      %mi Y
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi g
                          %mi n
                    %msub
                      %mi A
                      %mi n
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi h
                          %mi n
                    %mi Σ
                    %msub
                      %mi Y
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    Y_{n+1}
                    \\overset{f_n}{\longrightarrow}
                    Y_n
                    \\overset{g_n}{\longrightarrow}
                    A_n
                    \\overset{h_n}{\longrightarrow}
                    \\Sigma Y_{n+1}
            %p
              is an exact triangle (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> prop.
              ), where inductively
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi n
                    %mo ≔
                    %mi E
                    %mo ∧
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
