                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    \\underset{\longleftarrow}{\lim}^1_n Hom(B_n, A)
                    \\longrightarrow
                    Ext^1( \underset{\longrightarrow}{\lim}_n B_n, A )
                    \\longrightarrow
                    \\underset{\longleftarrow}{\lim}_n Ext^1( B_n, A)
                    \\to
                    0
            %p
              (by
              = succeed ")." do
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#lim1AndExt1"} this lemma
            %p
              In the present case all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi n
                      %mo ≃
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} B_n \simeq \mathbb{Z}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+object"} projective object
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi n
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                      %mn 1
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msubsup
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                      %mn 1
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1( \underset{\longrightarrow}{\lim}_n \mathbb{Z}, A )
                    \\simeq
                    \\underset{\longleftarrow}{\lim}^1_n Hom(\mathbb{Z}, A)
                    \\simeq
                    \\underset{\longleftarrow}{\lim}^1_n A
                    \\,.
            %p This gives the second statement.
          #pPrimaryGroupsArePComplete.num_example
            %h6#example_11 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} p-primary
              %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^n \mathbb{Z}
              are
