            %p
              The symbol
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{(2)}
              refers to the
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} 2-adic integers
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#pAdicIntegers"}
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              of abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
