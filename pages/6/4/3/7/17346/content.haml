                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext_\Gamma(A,A) \simeq A[\{x_i\}_{i \in I}]
                    \\,.
          %p
            (
            %a{:href => "#Ravenel86"}> Ravenel 86, lemma 3.1.9
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, prop. 3.7.5
          .proof
            %h6#proof_31 Proof
            %p
              Consider the co-free left
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed ")" do
                %a{:href => "commutative+Hopf+algebroid#CoFreeComodules"} prop.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \otimes_A A[\{y_i\}_{i \in I}]
            %p
              and regard it as a
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of left comodules by defining a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi x
                      %mi i
                    %mo ↦
                    %msub
                      %mi y
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    d \colon x_i \mapsto y_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi y
                      %mi i
                    %mo ↦
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    d \colon y_i \mapsto 0
            %p
              and extending as a graded
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %p
              We claim that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is a homomorphism of left comodules: Due to the assumption that all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              are primitive we have on generators that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mi i
                            %mo ⊗
                            %mn 1
                            %mo +
                            %mn 1
                            %mo ⊗
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mrow
                                %msub
                                  %mi x
                                  %mi i
                                %mo ⊗
                                %munder
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi d
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                                  %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo +
                            %munder
                              %mrow
                                %mn 1
                                %mo ⊗
                                %munder
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi d
                                    %msub
                                      %mi x
                                      %mi i
                                    %mo{:stretchy => "false"} )
                                  %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi y
                                  %mi i
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msub
                              %mi x
                              %mi i
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (id,d) ( \Psi(x_i)  )
                    \&amp; =
                    (id,d) ( x_i \otimes 1 + 1 \otimes x_i )
                    \\\
                    \&amp; =
                    \\underset{= 0}{x_i  \otimes \underbrace{(d 1)} }
                    +
                    \\underset{= y_i}{ 1 \otimes \underbrace{(d x_i)} }
                    \\\
                    \&amp; =
                    \\Psi( d x_i )
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo ,
                            %mi d
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Ψ
                            %mo{:stretchy => "false"} (
                            %mi d
                            %msub
                              %mi y
                              %mi i
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (id,d)( \Psi(y_i) )
                    \&amp; =
                    (id,d) ( 1, y_i )
                    \\\
                    \&amp; =
                    (1, d y_i)
                    \\\
                    \&amp; =
                    0
                    \\\
                    \&amp; =
                    \\Psi( 0 )
                    \\\
                    \&amp; =
                    \\Psi(d y_i)
                    \\end{aligned}
                    \\,.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is a graded derivation on a free graded commutative algbra, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                  %annotation{:encoding => "application/x-tex"} \Psi
              is an algebra homomorphism, this implies the statement for all other elements.
            %p
              Now observe that the canonical
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ≃
                          %mi qi
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    (\Gamma \otimes_A A[\{y_i\}_{i \in I}]  ,\; d)
                    \\overset{\simeq_{qi}}{\longrightarrow}
                    A
            %p
              (which projects out the generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mi i
                  %annotation{:encoding => "application/x-tex"} y_i
              and is the identity on
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in left
              = succeed "-comodules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            %p
              Since the counit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is assumed to be flat, and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi y
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A[\{y_i\}_{i \in I}]
              is degreewise a
              %a.existingWikiWord{:href => "/nlab/show/free+module"} free module
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
              %a.maruku-ref{:href => "#CoFreeHopfComodulesAreHomNAcyclicForProjectiveN"}
              says that the above is an
              %a.existingWikiWord{:href => "/nlab/show/acyclic+resolution"} acyclic resolution
              with respect to the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Γ
                      %mi CoMod
                      %mo ⟶
                      %mi A
                      %mi Mod
                    %annotation{:encoding => "application/x-tex"} Hom_{\Gamma}(A,-) \colon \Gamma CoMod \longrightarrow A Mod
              = succeed "-functor." do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              to forgetting
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#CoFreeComodules"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi Ext
                              %mi Γ
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi A
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi y
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} }
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mi A
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi y
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} }
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi d
                            %mo =
                            %mn 0
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi A
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi y
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} }
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi A
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi x
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} }
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Ext^\bullet_\Gamma(A,A)
                    \&amp; \simeq
                    H_\bullet(Hom_\Gamma(A,  \Gamma \otimes_A A[\{y_i\}_{i \in I}] ), d)
                    \\\
                    \&amp; \simeq
                    H_\bullet(Hom_A(A,  A[\{y_i\}_{i \in I}] ), d= 0 )
