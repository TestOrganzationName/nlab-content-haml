                    %mi ℤ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1( \mathbb{Z}(p^\infty), A )
                    \\simeq
                    \\underset{i}{\prod}
                    Ext^1( \mathbb{Z}(p^\infty), \mathbb{Z}/p_i^{k_1}\mathbb{Z} )
                    \\,.
            %p
              By theorem
              %a.maruku-ref{:href => "#pCompletionOfAbelianGroupsByHomsOutOfZpinfinity"}
              the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
