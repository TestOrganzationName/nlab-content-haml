          .proof
            %h6#proof_23 Proof
            %p
              By theorem
              %a.maruku-ref{:href => "#pCompletionOfAbelianGroupsByHomsOutOfZpinfinity"}
              the localization morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              sits in a
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence"} long exact sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi p
