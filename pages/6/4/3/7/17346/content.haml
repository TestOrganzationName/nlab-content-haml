                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              need not all be distinct.
            %p
              %strong> fundamental theorem of finite abelian groups
              \:
            %p
              In particular every
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              is of this form for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} n = 0
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
            %p
              %strong> fundamental theorem of cyclic groups
              \:
            %p
              In particular every
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
              is a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of cyclic groups of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                    %mo ≃
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                      %mi i
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msubsup
                      %mi p
                      %mi i
                      %mrow
                        %msub
                          %mi k
                          %mi i
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}/n\mathbb{Z}
                    \\simeq
                    \\underset{i}{\bigoplus} \mathbb{Z}/ p_i^{k_i} \mathbb{Z}
            %p
              where all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              are distinct and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi i
                  %annotation{:encoding => "application/x-tex"} k_i
              is the maximal power of the
              %a.existingWikiWord{:href => "/nlab/show/prime+factor"} prime factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i
              in the prime decomposition of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              Specifically, for each natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              dividing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              it contains
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi d
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/d\mathbb{Z}
              as the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              generated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo{:stretchy => "false"} /
                      %mi d
                      %mo ∈
                      %mi ℤ
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi n
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n/d \in \mathbb{Z}\to \mathbb{Z}/n\mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/lattice+of+subgroups"} lattice of subgroups
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
              is the
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of the lattice of natural numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} \leq n
              ordered by inclusion.
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Roman12"} Roman 12, theorem 13.4
            = succeed ")" do
              %a{:href => "#Navarro03"} Navarro 03
            = succeed ")" do
              %a{:href => "#Aluffi09"} Aluffi 09, pages 83-84
          %p
            This is a special case of the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/structure+theorem+for+finitely+generated+modules+over+a+principal+ideal+domain"} structure theorem for finitely generated modules over a principal ideal domain
          #TwoFiniteGroupsOfOrderp2.num_example
            %h6#example_5 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi p
