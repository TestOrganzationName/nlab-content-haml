          %h3#LocalizationOfAbelianGroups Localization and adic completion of abelian groups
          #ExtAb.num_remark
            %h6#remark_13 Remark
            %p
              Recall that
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Ext
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Ext^\bullet(A,B)
              between
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A, B \in
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
              are concentrated in degrees 0 and 1 (
              %a{:href => "free+resolution#AbelianGroupHasFreeResolutionOfLength2"}> prop.
              ). Since
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ext^0(A,B) \simeq Hom(A,B)
            %p
              is the plain
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} Ext^1
              = succeed "\u201D:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ext
                    %annotation{:encoding => "application/x-tex"} Ext
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ext
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext(A,B)
                    \\coloneqq
                    Ext^1(A,B)
                    \\,.
          #AbelianGroupLocal.num_defn
            %h6#definition_21 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %p
              Then an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                \-local
              if all the
              = succeed "-groups" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              vanish:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Ext^\bullet(K,A) \simeq 0
            %p
              hence equivalently (remark
              = succeed ")" do
                %a.maruku-ref{:href => "#ExtAb"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi Ext
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(K,A) \simeq 0
                    \\;\;\;\;\;
                    and
                    \\;\;\;\;\;
                    Ext(K,A) \simeq 0
                    \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of abelian groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo ⟶
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f \colon B \longrightarrow C
              is called
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                \-local
              if for all
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              the function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(f,A) \;\colon\; Hom(C,A) \longrightarrow Hom(B,A)
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            %blockquote
              %p
                (
                %strong Beware
                that here it would seem more natural to use
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ext
                        %mo •
                    %annotation{:encoding => "application/x-tex"} Ext^\bullet
                instead of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Hom
                      %annotation{:encoding => "application/x-tex"} Hom
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Hom
                      %annotation{:encoding => "application/x-tex"} Hom
                = succeed ")." do
                  %a{:href => "localization+of+abelian+groups#Neisendorfer08"} Neisendorfer 08, remark 3.2
            %p A homomorphism of abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %msub
                      %mi L
                      %mi K
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\eta \;\colon\; A \longrightarrow L_K A
            %p
              is called a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                \-localization
              if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi K
                        %mi A
                      %annotation{:encoding => "application/x-tex"} L_K A
                  is
                  = succeed "-local;" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  is a
                  = succeed "-local" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
          %p We now discuss two classes of examples of localization of abelian groups
          %ol
            %li
              %p
                %em>
                  %a{:href => "#ClassicalLocalizationOfAbelianGroups"} Classical localization at/away from primes
                ;
            %li
              %p
                %em>
                  %a{:href => "#FormalCompletionOfAbelianGroups"} Formal completion at primes
                \.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#ClassicalLocalizationOfAbelianGroups
            %strong Classical localization at/away from primes
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
            for the
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            of
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          #OutOfCyclicGroupExt1.num_lemma
            %h6#lemma_10 Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} A \in Ab
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-group
                  out of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
                  into
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is the
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                  %a.existingWikiWord{:href => "/nlab/show/torsion+subgroup"} torsion subgroup
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo{:stretchy => "false"} {
                        %mi a
                        %mo ∈
                        %mi A
                        %mspace{:width => "thickmathspace"}
                        %mo{:stretchy => "false"} |
                        %mspace{:width => "thickmathspace"}
                        %mi p
                        %mo ⋅
                        %mi a
                        %mo =
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"}
                        Hom(\mathbb{Z}/n\mathbb{Z}, A)
                        \\simeq
                        \\{
                        a \in A \;\vert\; p \cdot a = 0
                        \\}
              %li
                %p
                  the first
                  = succeed "-group" do
                    %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
                  into
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Ext
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi ℤ
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi A
                        %mo{:stretchy => "false"} /
                        %mi n
                        %mi A
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Ext^1(\mathbb{Z}/n\mathbb{Z},A)
                        \\simeq
                        A/n A
                        \\,.
          .proof
            %h6#proof_17 Proof
            %p
              Regarding the first item: Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
              is generated by its element 1 a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z} \to A
              is fixed by the image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              of this element, and the only relation on 1 in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
              is that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ⋅
                      %mn 1
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} p \cdot 1 = 0
            %p Regarding the second item:
            %p
              Consider the canonical
              %a.existingWikiWord{:href => "/nlab/show/free+resolution"} free resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi ℤ
                    %mover
                      %mo ⟶
                      %mrow
                        %mi p
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mi ℤ
                    %mo ⟶
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    0 \to \mathbb{Z} \overset{p \cdot (-)}{\longrightarrow} \mathbb{Z} \longrightarrow \mathbb{Z}/p\mathbb{Z} \to 0
                    \\,.
            %p
              By the general discusson of
              %a.existingWikiWord{:href => "/nlab/show/derived+functors+in+homological+algebra"} derived functors in homological algebra
              this exhibits the
              = succeed "-group" do
                %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi n
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    0
                    \\to
                    Hom(\mathbb{Z},A)
                    \\overset{Hom(n\cdot(-),A)}{\longrightarrow}
                    Hom(\mathbb{Z}, A)
                    \\longrightarrow
                    Ext^1(\mathbb{Z}/n\mathbb{Z},A)
                    \\to 0
                    \\,,
            %p
              where the morphism on the left is equivalently
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mrow
                          %mi n
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A \overset{n \cdot (-)}{\to} A
          .num_example
            %h6#example_9 Example
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    p \cdot (-)
                    \\;\colon\;
                    A \longrightarrow A
            %p
              of multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is invertible in
              = succeed "\u201D." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .proof
            %h6#proof_18 Proof
            %p
              By the first item of lemma
              %a.maruku-ref{:href => "#OutOfCyclicGroupExt1"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ∈
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %mo ⋅
                    %mi a
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathbb{Z}/p\mathbb{Z}, A)
                    \\simeq
                    \\{
                    a \in A \;\vert\; p \cdot a = 0
                    \\}
            %p
              By the second item of lemma
              %a.maruku-ref{:href => "#OutOfCyclicGroupExt1"}
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ext^1(\mathbb{Z}/p\mathbb{Z},A)
                    \\simeq
                    A/p A
                    \\,.
            %p
              Hence by def.
              %a.maruku-ref{:href => "#AbelianGroupLocal"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ∈
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mi p
                    %mo ⋅
                    %mi a
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo ≃
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\{
                    a \in A \;\vert\; p \cdot a = 0
                    \\}
                    \\simeq
                    0
            %p and if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi A
                    %mo ≃
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A / p A \simeq 0
                    \\,.
            %p
              Both these conditions are equivalent to multiplication by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              being invertible.
          #InvertingPrimes.num_defn
            %h6#definition_22 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} J \subset \mathbb{N}
              a set of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mi p
                        %mo ∈
                        %mi J
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \underset{p \in J}{\oplus} \mathbb{Z}/p\mathbb{Z}
              of
              %a.existingWikiWord{:href => "/nlab/show/cyclic+groups"} cyclic groups
              of
              %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              The operation of
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ⊕
                        %mrow
                          %mi p
                          %mo ∈
                          %mi J
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \underset{p \in J}{\oplus} \mathbb{Z}/p\mathbb{Z}
              %a.maruku-ref{:href => "#AbelianGroupLocal"}
              is called
              %strong inverting the primes
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
            %p Specifically
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi p
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} J = \{p\}
                  a single prime then
                  = succeed "-localization" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi p
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
                  = succeed ";" do
                    %strong
                      localization away from
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  the set of all primes except
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  then
                  = succeed "-localization" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ⊕
                            %mrow
                              %mi p
                              %mo ∈
                              %mi J
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi p
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \underset{p \in J}{\oplus} \mathbb{Z}/p\mathbb{Z}
                  %strong
                    localization at
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi J
                      %annotation{:encoding => "application/x-tex"} J
                  the set of all primes, then
                  = succeed "-localizaton" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo ⊕
                            %mrow
                              %mi p
                              %mo ∈
                              %mi J
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mi p
                          %mi ℤ
                        %annotation{:encoding => "application/x-tex"} \underset{p \in J}{\oplus} \mathbb{Z}/p\mathbb{Z}
                  = succeed ".." do
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/rationalization"} rationalization
          #LocalizationOfIntegersAtSetOfPrimes.num_defn
            %h6#definition_23 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi Primes
                    %mo ⊂
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} J \subset Primes \subset \mathbb{N}
              a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}[J^{-1}]
                    \\hookrightarrow
                    \\mathbb{Q}
            %p
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of the
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
              on those elements which have an expression as a fraction of natural numbers with denominator a product of elements in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
            %p
              This is the abelian group underlying the
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+commutative+ring"} localization of a commutative ring
              of the ring of integers at the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              of primes.
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo =
                    %mi Primes
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} J = Primes - \{p\}
              is the set of all primes
              %em except
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              one also writes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi Primes
                    %mo −
                    %mo{:stretchy => "false"} {
                    %mi p
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}_{(p)}
                    \\coloneqq
                    \\mathbb{Z}[Primes - \{p\}]
                    \\,.
            %p
              Notice the parenthesis, to distinguish from the notation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{p}
              for the
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
              (def.
              %a.maruku-ref{:href => "#pAdicIntegers"}
              below).
          #ClassicalLocalizationSeenFromSpecZ.num_remark
            %h6#remark_14 Remark
            %p
              The terminology in def.
              %a.maruku-ref{:href => "#InvertingPrimes"}
              is motivated by the following perspective of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            %p
              Generally for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/module"} module
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasicoherent sheaf
              on the
              %a.existingWikiWord{:href => "/nlab/show/spectrum+of+a+commutative+ring"} spectrum of the ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Spec(R)
            %p
              In the present case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}
              is the
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              and
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
              are identified with
              = succeed "-modules." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              equivalently as a
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasicoherent sheaf
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
            %p
              The “
              %a.existingWikiWord{:href => "/nlab/show/ring+of+functions"}> ring of functions
              ” on
              %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
              is the integers, and a point in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(\mathbb{Z})
              is labeled by a
              %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
              which vanish at that point. The
              %a.existingWikiWord{:href => "/nlab/show/residue+field"} residue field
              at that point is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mi p
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_p = \mathbb{Z}/p\mathbb{Z}
            %p
              Inverting a prime means
              %a.existingWikiWord{:href => "/nlab/show/forcing"} forcing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              to become invertible, which, by this characterization, it is precisely
              %em away
              from that point which it labels. The localization of an abelian group at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p\mathbb{Z}
              hence corresponds to the restriction of the corresponding quasicoherent sheaf over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(\mathbb{Z})
              to the complement of the point labeled by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              Similarly localization
              %em at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is localization away from all points except
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
              See also at
              %em
                %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
              for more on this.
          .num_prop
            %h6#proposition_12 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo ⊂
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} J \subset \mathbb{N}
              a set of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \;\colon\; A \longrightarrow B
              is local (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AbelianGroupLocal"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ⊕
                      %mrow
                        %mi p
                        %mo ∈
                        %mi J
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \underset{p \in J}{\oplus} \mathbb{Z}/p\mathbb{Z}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InvertingPrimes"}
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[J^{-1}]
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalizationOfIntegersAtSetOfPrimes"}
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⊗
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⊗
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mo ≃
                    %mi B
                    %mo ⊗
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f \otimes \mathbb{Z}[J^{-1}]
                    \\;\colon\;
                    A \otimes \mathbb{Z}[J^{-1}]
                    \\overset{\simeq}{\longrightarrow}
                    B \otimes \mathbb{Z}[J^{-1}]
                    \\,.
            %p
              Moreover, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              any abelian group then its
              = succeed "-localization" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ⊕
                        %mrow
                          %mi p
                          %mo ∈
                          %mi J
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \underset{p \in J}{\oplus} \mathbb{Z}/p\mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⟶
                    %mi A
                    %mo ⊗
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \\longrightarrow
                    A \otimes \mathbb{Z}[J^{-1}]
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "localization+of+abelian+groups#Neisendorfer08"} Neisendorfer 08, theorem 4.2
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#FormalCompletionOfAbelianGroups
            %strong Formal completion at primes
          %p
            We have seen above in remark
            %a.maruku-ref{:href => "#ClassicalLocalizationSeenFromSpecZ"}
            that classical localization of abelian groups at a prime number is geometrically interpreted as restricting a
            %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasicoherent sheaf
            over
            %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
            to a single point, the point that is labeled by that prime number.
          %p
            Alternatively one may restrict to the “infinitesimal neighbourhood” of such a point. Technically this is called the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/formal+neighbourhood"} formal neighbourhood
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            (regarded as an
            %a.existingWikiWord{:href => "/nlab/show/adic+ring"} adic ring
            or
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/pro-ring"} pro-ring
            %em
              %a.existingWikiWord{:href => "/nlab/show/formal+completion"} formal completion
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
            or just
            = succeed "," do
              %em completion
          %p
            It turns out that if the abelian group is
            %a.existingWikiWord{:href => "/nlab/show/finitely+generated+object"} finitely generated
            then the operation of
            %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
            coincides with an operation of
            %em localization
            in the sense of def.
            = succeed "," do
              %a.maruku-ref{:href => "#AbelianGroupLocal"}
            %a.existingWikiWord{:href => "/nlab/show/p-primary+group"} p-primary component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi p
                    %mn ∞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}(p^\infty)
            of the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo{:stretchy => "false"} /
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}/\mathbb{Z}
            (def.
            %a.maruku-ref{:href => "#ZpInfinity"}
            below). On the one hand this equivalence is useful for deducing some key properties of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/p-completion"} p-completion
            %a.existingWikiWord{:href => "/nlab/show/localization+of+spectra"} localization of spectra
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/nilpotent+completion+of+spectra"} nilpotent completion of spectra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Adams+spectral+sequences"} Adams spectral sequences
          #AdicCompletionOfAbelingGroups.num_defn
            %h6#definition_24 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
              %strong
                %a.existingWikiWord{:href => "/nlab/show/p-adic+completion"} p-adic completion
              of an
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the abelian group given by the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi A
                      %mi p
                      %mo ∧
                    %mo ≔
                    %munder
                      %mi lim
                      %mo ⟵
                    %mrow
                      %mo (
                      %mi ⋯
                      %mo ⟶
                      %mi A
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mn 3
                      %mi A
                      %mo ⟶
                      %mi A
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi p
                        %mn 2
                      %mi A
                      %mo ⟶
                      %mi A
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi A
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    A^\wedge_p
                    \\coloneqq
                    \\underset{\longleftarrow}{\lim}
                    \\left(
                    \\cdots
                    \\longrightarrow
                    A / p^3 A
                    \\longrightarrow
                    A / p^2 A
                    \\longrightarrow
                    A/p A
                    \\right)
                    \\,,
            %p
              where the morphisms are the evident
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              morphisms. With these understood we often write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi A
                      %mi p
                      %mo ∧
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %mi A
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi n
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    A^\wedge_p \coloneqq \underset{\longleftarrow}{\lim}_n A/p^n A
            %p
              for short. Notice that here the indexing starts at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n = 1
          #pAdicIntegers.num_example
            %h6#example_10 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/p-adic+completion"} p-adic completion
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdicCompletionOfAbelingGroups"}
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              is called the
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi p
                    %mo ≔
                    %msubsup
                      %mi ℤ
                      %mi p
                      %mo ∧
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi n
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi n
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{Z}_p
                    \\coloneqq
                    \\mathbb{Z}^\wedge_p
                    \\coloneqq
                    \\underset{\longleftarrow}{\lim}_n \mathbb{Z}/p^n \mathbb{Z}
                    \\,,
            %p which is the original example that gives the general concept its name.
            %p
              With respect to the canonical
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} p \mathbb{Z}
              is a prime ideal.
            %p
              Compare this to the ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathbb{C}}
              of
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+functions"} holomorphic functions
              on the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{C}
              any point, it contains the prime ideal generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo −
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (z-x)
              (for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              the canonical
              %a.existingWikiWord{:href => "/nlab/show/coordinate"} coordinate
              function on
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕫
                    %annotation{:encoding => "application/x-tex"} \mathbb{z}
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series+ring"} formal power series ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo −
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}[ [(z-x)] ]
              is the
              %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_{\mathbb{C}}
              at this ideal. It has the interpretation of functions defined on a
              %a.existingWikiWord{:href => "/nlab/show/formal+neighbourhood"} formal neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %p
              Analogously, the
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_p
              may be thought of as the functions defined on a
              %a.existingWikiWord{:href => "/nlab/show/formal+neighbourhood"} formal neighbourhood
              of the point labeled by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Spec%28Z%29"} Spec(Z)
          #pAdicIntegersAspExtensionofFpByThemselves.num_lemma
            %h6#lemma_11 Lemma
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo →
                    %msub
                      %mi ℤ
                      %mi p
                    %mover
                      %mo ⟶
                      %mrow
                        %mi p
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
