                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^\ast_{p}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DualSteenrodAlgebraForHPf"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              %a.existingWikiWord{:href => "/nlab/show/graded+commutative+algebra"} graded commutative algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mi p
                      %mo *
                    %mo ≃
                    %msub
                      %mi Sym
                      %mrow
                        %msub
                          %mi 𝔽
                          %mi p
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ξ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ξ
                      %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mn 0
                    %mo ,
                    %msub
                      %mi τ
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{A}^\ast_{p}
                    \\simeq
                    Sym_{\mathbb{F}_p}(\xi_1, \xi_2, \cdots, \;\tau_0, \tau_1, \cdots)
            %p on generators:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi ξ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \xi_n
                  ,
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} n \geq 1
                  being the linear dual to
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 2
                          %mi ⋯
                          %msup
                            %mi P
                            %mi p
                          %msup
                            %mi P
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} P^{p^{n-1}} P^{p^{n-2}} \cdots P^p P^1
                %p
                  of degree
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 2
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi p
                            %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} 2(p^n-1)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \tau_n
                  being linear dual to
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                          %msup
                            %mi P
                            %mrow
                              %msup
                                %mi p
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 2
                          %mi ⋯
                          %msup
                            %mi P
                            %mi p
                          %msup
                            %mi P
                            %mn 1
                          %mi β
                        %annotation{:encoding => "application/x-tex"} P^{p^{n-1}} P^{p^{n-2}} \cdots P^p P^1\beta
            %p
              Moreover, the coproduct on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒜
                      %mi p
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}^\ast_{p}
              is given on generators by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ξ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi n
                    %msubsup
                      %mi ξ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %mrow
                        %msup
                          %mi p
                          %mi k
                    %mo ⊗
                    %msub
                      %mi ξ
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi(\xi_n)
                    \=
                    \\underoverset{k = 0}{n}{\sum} \xi_{n-k}^{p^k} \otimes \xi_k
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ψ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi τ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi τ
                      %mi n
                    %mo ⊗
                    %mn 1
                    %mo +
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %mn 0
                      %mi n
                    %msubsup
                      %mi ξ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %mrow
                        %msup
                          %mi p
                          %mi k
                    %msubsup
                      %mi ξ
                      %mrow
                        %mi n
                        %mo −
                        %mi k
                      %mrow
                        %msup
                          %mi p
                          %mi k
                    %mo ⊗
                    %msub
                      %mi τ
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi(\tau_n)
                    \=
                    \\tau_n \otimes 1
                    +
                    \\underoverset{k=0}{n}{\sum}
                    \\xi_{n-k}^{p^k} \xi_{n-k}^{p^k}\otimes \tau_k
                    \\,,
            %p
              where we set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ξ
                        %mn 0
                      %mo ≔
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \xi_0 \coloneqq 1
            %p (This defines the coproduct on the full algbra by it being an algebra homomorphism.)
          %p
            This is due to (
            %a{:href => "Steenrod+algebra#Milnor58"}> Milnor 58
            ). See for instance (
            %a{:href => "#Kochmann96"}> Kochmann 96, theorem 2.5.1
            ,
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, chapter III, theorem 3.1.1
          %h3#the_cobar_complex The cobar complex
          %p
            In order to compute the second page of the classical
            = succeed "-Adams" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi 𝔽
                      %mi p
                  %annotation{:encoding => "application/x-tex"} H \mathbb{F}_p
            = succeed ")" do
              %a.maruku-ref{:href => "#ClassicalAdamsSpectralSequenceEstablished"}
            %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
            whose
            %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            gives the relevant
            = succeed "-groups." do
              %a.existingWikiWord{:href => "/nlab/show/Ext"} Ext
          #UnitCoidealInCommutativeHopfAlgebra.num_defn
            %h6#definition_36 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma,A)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graded+commutative+Hopf+algebra"} graded commutative Hopf algebra
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              for which the left and right units coincide
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mo ⟶
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \eta \;\colon\; A \longrightarrow \Gamma
              (remark
              = succeed ")." do
                %a.maruku-ref{:href => "#HopfAlgebrasAsHopfAlgebroids"}
            %p
              Then the
              %strong unit coideal
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is the
              %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo ¯
                    %mo ≔
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mover
                      %mo ⟶
                      %mi η
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{\Gamma}
                    \\coloneqq
                    coker( A \overset{\eta}{\longrightarrow} \Gamma)
                    \\,.
          #DirectSumDecompositionUnitCoideal.num_remak
            %h6#remark_17 Remark
            %p
              By co-unitality of graded commutative Hopf algebras (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∘
                    %mi η
                    %mo =
                    %msub
                      %mi id
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \epsilon \circ \eta = id_A
              the defining projection of the unit coideal (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#UnitCoidealInCommutativeHopfAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mover
                      %mo ⟶
                      %mi η
                    %mi Γ
                    %mover
                      %mo ⟶
                      %mrow
                    %mover
                      %mi Γ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"}
                    A
                    \\overset{\eta}{\longrightarrow}
                    \\Gamma
                    \\overset{}{\longrightarrow}
                    \\overline{\Gamma}
            %p
              forms a
              %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split exact sequence
              which exhibits a
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              decomposition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
