                  = succeed "-comodules:" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi A
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi N
                          %mn 1
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo □
                          %mi Γ
                        %msub
                          %mi N
                          %mn 2
                        %mo ≃
                        %msub
                          %mi Hom
                          %mi Γ
