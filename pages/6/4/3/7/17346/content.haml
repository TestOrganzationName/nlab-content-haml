          #TwoConditionsOnELocalSpectrumAreEquivalent.num_lemma
            %h6#lemma_13 Lemma
            %p
              The two conditions in the last item of def.
              %a.maruku-ref{:href => "#EAcyclicAndLocalSpectra"}
              are indeed equivalent.
          .proof
            %h6#proof_25 Proof
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Ho(Spectra)
              being
              = succeed "-acyclic" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
