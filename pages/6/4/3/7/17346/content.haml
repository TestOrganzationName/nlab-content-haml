                      %msub
                        %mi f
                        %mi p
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} E_\bullet(f_p) = 0
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequences"} short exact sequences
          %h3#homological_coalgebra Homological co-algebra
          %p
            We discuss basic aspects of
            %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
            in
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            of
            %a.existingWikiWord{:href => "/nlab/show/comodules"} comodules
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
            %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroids"} commutative Hopf algebroids
            (def.
            = succeed ")," do
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
            = succeed "." do
              %a.maruku-ref{:href => "#SecondPageOfEAdamsSpectralSequence"}
          #CategoryOfHopfComodulesIsAbelianIfHopfAlgebroidIsFlat.num_lemma
            %h6#lemma_7 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma, A)
              be a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroid"}
              = succeed ")," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              induced by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \eta_R
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/flat+module"} flat module
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi CoMod
                  %annotation{:encoding => "application/x-tex"} \Gamma CoMod
              of
              %a.existingWikiWord{:href => "/nlab/show/comodules"} comodules
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, theorem A1.1.3
          .proof
            %h6#proof_14 Proof
            %p
              It is clear that, without any condition on the Hopf algebroid,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi CoMod
                  %annotation{:encoding => "application/x-tex"} \Gamma CoMod
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/additive+category"} additive category
            %p
              Next we need to show if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is flat over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pre-abelian+category"} pre-abelian category
              %a.existingWikiWord{:href => "/nlab/show/kernels"} kernels
              and
              %a.existingWikiWord{:href => "/nlab/show/cokernels"} cokernels
              exist.
            %p
              To that end, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi Ψ
                      %mrow
                        %msub
                          %mi N
                          %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 2
                    %mo ,
                    %msub
                      %mi Ψ
                      %mrow
                        %msub
                          %mi N
                          %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \colon (N_1,\Psi_{N_1}) \longrightarrow (N_2,\Psi_{N_2})
              be a morphism of comodules, hence a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %msub
                              %mi N
                              %mn 2
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Ψ
                                    %mrow
                                      %msub
                                        %mi N
                                        %mn 1
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi Ψ
                                    %mrow
                                      %msub
                                        %mi N
                                        %mn 2
                        %mtr
                          %mtd
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi id
                                  %mi Γ
                                %msub
                                  %mo ⊗
                                  %mi A
                                %mi f
                          %mtd
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %msub
                              %mi N
                              %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N_1 &amp;\stackrel{f}{\longrightarrow}&amp; N_2
                    \\\
                    \\downarrow^{\mathrlap{\Psi_{N_1}}} &amp;&amp; \downarrow^{\mathrlap{\Psi_{N_2}}}
                    \\\
                    \\Gamma \otimes_A N_1
                    \&amp;\stackrel{id_\Gamma \otimes_A f}{\longrightarrow}&amp;
                    \\Gamma \otimes_A N_2
                    }
                    \\,.
            %p
              Consider the kernel
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ker(f)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
              and its image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma \otimes_A (-)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ker
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi N
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %msub
                              %mi N
                              %mn 2
                        %mtr
                          %mtd
