                              %mn 3
                          %annotation{:encoding => "application/x-tex"} X_1 \to X_2 \to X_3
                      two of the spectra are in the class, then so is the third.
          %p
            (
            %a{:href => "#Bousfield79"}> Bousfield 79, lemma 1.13 with lemma 1.14
            ) review includes (
            %a{:href => "Bauer11"}> Bauer 11, p.2,3
            ,
            = succeed ")" do
              %a{:href => "#VanKoughnett13"} VanKoughnett 13, p. 8
          #ELocalizationCofiber.num_prop
            %h6#proposition_15 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in Ho(Spectra)
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              sits in a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+cofiber+sequence"} homotopy cofiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi X
                    %msub
                      %mi L
                      %mi E
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    G_E(X)
                    \\longrightarrow
                    X
                    \\overset{\eta_X}{\longrightarrow}
                    L_E(X)
                    \\,,
            %p
              and
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mi E
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} G_E(X)
                  is
                  = succeed "-acyclic," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                        %annotation{:encoding => "application/x-tex"} E
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
