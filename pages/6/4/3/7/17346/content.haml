          .num_remark
            %h6#remark_20 Remark
            %p
              With lemma
              %a.maruku-ref{:href => "#DifferentialsOnSecondPageOfMaySpectralSequence"}
              the picture from remark
              %a.maruku-ref{:href => "#PictureFromTermsOnSecondPageOfMaySpectralSequence"}
              is further refined:
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
