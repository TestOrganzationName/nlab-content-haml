              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
          %p
            Then consider the image of this structure under forming the
            %a.existingWikiWord{:href => "/nlab/show/free+abelian+groups"} free abelian groups
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
            %a.existingWikiWord{:href => "/nlab/show/commutative+rings"} commutative rings
            under pointwise multiplication.
          %p Since
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ⊗
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{Z}[X \times X]
                  \\simeq
                  \\mathbb{Z}[X] \otimes \mathbb{Z}[X]
          %p this yields a diagram of homomorphisms of commutative rings of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo ⊗
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ⊗
                            %mrow
                              %mi ℤ
                              %mo{:stretchy => "false"} [
                              %mi X
                              %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo ⊗
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mpadded{:width => "0"}
                              %mrow
                      %mtr
                        %mtd
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                          %mo ⊗
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                          %mo{:stretchy => "false"} ↓
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (\mathbb{Z}[X] \otimes \mathbb{Z}[X] )
                  \\otimes_{\mathbb{Z}[X]}
                  (\mathbb{Z}[X] \otimes \mathbb{Z}[X])
                  \\\
                  \\uparrow^{\mathrlap{} }
                  \\\
                  \\mathbb{Z}[X] \otimes \mathbb{Z}[X]
                  \\\
                  \\uparrow
                  \\downarrow
                  \\uparrow
                  \\\
                  \\mathbb{Z}[X]
                  }
          %p satisfying some obvious conditions. Observe that here
          %ol
            %li
              %p
                the two morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⇉
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X] \rightrightarrows \mathbb{Z}[X] \otimes \mathbb{Z}[X]
                are
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ↦
                      %mi f
                      %mo ⊗
                      %mi e
                    %annotation{:encoding => "application/x-tex"} f \mapsto f \otimes e
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ↦
                        %mi e
                        %mo ⊗
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f \mapsto e \otimes f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
                denotes the unit element in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
            %li
              %p
                the morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X] \otimes \mathbb{Z}[X] \to \mathbb{Z}[X]
                is the multiplication in the ring
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
            %li
              %p the morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} [
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⊗
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}[X] \otimes \mathbb{Z}[X]
                      \\longrightarrow
                      \\mathbb{Z}[X] \otimes \mathbb{Z}[C] \otimes \mathbb{Z}[C]
                      \\overset{\simeq}{\longrightarrow}
                      (\mathbb{Z}[X] \otimes \mathbb{Z}[X] ) \otimes_{\mathbb{Z}[X]} (\mathbb{Z}[X] \otimes \mathbb{Z}[X])
              %p
                is given by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ⊗
                        %mi g
                        %mo ↦
                        %mi f
                        %mo ⊗
                        %mi e
                        %mo ⊗
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f \otimes g \mapsto f \otimes e \otimes g
          %p All of the following rich structure is directly modeled on this simplistic example. We simply
          %ol
            %li
              %p
                replace the commutative ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[X]
                with any flat
                %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                replace
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+abelian+groups"} tensor product of abelian groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                with derived
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            %li
              %p
                and form the
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(-)
                of all resulting expressions.
          #HopfAlgebroidStructureOnDualEOperations.num_defn
            %h6#definition_12 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu, e)
              be a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ) which is flat according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#FlatE"}
            %p
              Then the
              %strong
                dual
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
              is the pair of
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (E_\bullet(E), \pi_\bullet(E))
            %p
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#EMHomology"}> rmk.
              ) equipped with the following structure:
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
                  structure
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\pi_\bullet(E) \otimes \pi_\bullet(E)
                        \\longrightarrow
                        \\pi_\bullet(E)
                %p
                  induced from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  being a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}> prop.
                  );
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/graded+commutative+ring"} graded commutative ring
                  structure
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        E_\bullet(E) \otimes E_\bullet(E) \longrightarrow E_\bullet(E)
                %p
                  induced from the fact that with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  also
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ∧
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E \wedge E
                  is canonically a
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
                  (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#TensorProductOfTwoCommutativeMonoids"}> exmpl.
                  ), so that also
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ∧
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E_\bullet(E) = \pi_\bullet(E \wedge E)
                  is a graded commutative ring (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyGroupsOfHomotopyCommutativeRingSpectrum"}> prop.
                  );
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                  of
                  %a.existingWikiWord{:href => "/nlab/show/graded+commutative+rings"} graded commutative rings
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ψ
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ⊗
                          %mrow
                            %msub
                              %mi π
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\Psi
                        \\;\colon\;
                        E_\bullet(E)
                        \\longrightarrow
                        E_\bullet(E) \otimes_{\pi_\bullet(E)} E_\bullet(E)
                %p
                  induced under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_\bullet(-)
                  from
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ∧
                        %mi E
                        %mover
                          %mo ⟶
                          %mrow
                            %mi id
                            %mo ∧
                            %mi e
                            %mo ∧
                            %mi id
                        %mi E
                        %mo ∧
                        %mi E
                        %mo ∧
                        %mi E
                      %annotation{:encoding => "application/x-tex"}
                        E \wedge E
                        \\overset{id \wedge e \wedge id}{\longrightarrow}
                        E \wedge E \wedge E
                %p
                  via prop.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#EnHomology"}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
                  of graded commutative rings
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi L
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\eta_L
                        \\;\colon\;
                        \\pi_\bullet(E)
                        \\longrightarrow
                        E_\bullet(E)
                %p and
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi R
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\eta_R
                        \\;\colon\;
                        \\pi_\bullet(E)
                        \\longrightarrow
                        E_\bullet(E)
                %p
                  induced under
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_\bullet(-)
                  from the homomorphisms of commutative ring spectra
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
