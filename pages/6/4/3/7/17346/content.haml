                        %mo ⟵
                      %mi n
                    %msup
                      %mi Ext
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi p
                      %mi n
                    %mi ℤ
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
