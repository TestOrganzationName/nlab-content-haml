              ) which is flat according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#FlatE"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi Spectra
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Ho(Spectra)
              any spectrum, then the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mrow
                        %msub
                          %mi E
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Psi_{E_\bullet(X)}
              from def.
              %a.maruku-ref{:href => "#SteenrodComoduleStructureOnSpectrum"}
              makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet(X)
              into a
              %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/Steenrod+algebra"} Steenrod algebra
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HopfAlgebroidStructureOnDualEOperations"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mi CoMod
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E_\bullet(X)
                    \\;\in\;
                    E_\bullet(E) CoMod
                    \\,.
          %p
            (
            %a{:href => "#Adams69"}> Adams 69, lecture 3, pages 67-71
            ,
            = succeed ")" do
              %a{:href => "#Ravenel86"} Ravenel 86, chapter II, prop. 2.2.8
          #GroundRingIsCanonicalComoduleOverHopfAlgebroid.num_example
            %h6#example_3 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidDefinitionInExplicitComponents"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              itself becomes a left
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              %a.existingWikiWord{:href => "/nlab/show/coaction"} coaction
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi L
                    %mi Γ
                    %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_A
                    \\;\colon\;
                    A
                    \\overset{\eta_L}{\longrightarrow}
                    \\Gamma
                    \\simeq
                    \\Gamma \otimes_A A
            %p
              and a right
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ψ
                      %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi A
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi η
                          %mi R
                    %mi Γ
                    %mo ≃
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Psi_A
                    \\;\colon\;
                    A
                    \\overset{\eta_R}{\longrightarrow}
                    \\Gamma
                    \\simeq
                    \\Gamma \otimes_A A
                    \\,.
          %p More generally:
          #CoFreeComodules.num_prop
            %h6#proposition_7 Proposition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+Hopf+algebroid"} commutative Hopf algebroid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mi Mod
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mi co
                          %mo −
                          %mi free
                      %mover
                        %mo ⟵
                        %mi forget
                    %mi Γ
                    %mi CoMod
                  %annotation{:encoding => "application/x-tex"}
                    A Mod
                    \\underoverset
                    {\underset{co-free}{\longrightarrow}}
                    {\overset{forget}{\longleftarrow}}
                    {\bot}
                    \\Gamma CoMod
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/comodules"} comodules
              %a.maruku-ref{:href => "#CommutativeHopfAlgebroidComodule"}
              and the
              %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/cofree+functor"} cofree functor
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %p Moreover:
            %ol
              %li
                %p
                  The co-free
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
                  %a.existingWikiWord{:href => "/nlab/show/comodule"} comodule
                  on an
                  = succeed "-module" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \Gamma \otimes_A C
                  equipped with the
                  %a.existingWikiWord{:href => "/nlab/show/coaction"} coaction
                  induced by the
                  %a.existingWikiWord{:href => "/nlab/show/comultiplication"} comultiplication
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ψ
                      %annotation{:encoding => "application/x-tex"} \Psi
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} \Gamma
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                      %annotation{:encoding => "application/x-tex"} \tilde f
                  of a comodule homomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mover
                          %mo ⟶
                          %mi f
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi C
                      %annotation{:encoding => "application/x-tex"}
                        N \overset{f}{\longrightarrow} \Gamma \otimes_A C
                %p
                  is its composite with the counit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} \epsilon
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi N
                        %mover
                          %mo ⟶
                          %mi f
                        %mi Γ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi C
                        %mover
                          %mo ⟶
                          %mrow
                            %mi ϵ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi id
                        %mi A
                        %msub
                          %mo ⊗
                          %mi A
                        %mi C
                        %mo ≃
                        %mi C
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde f
                        \\;\colon\;
                        N
                        \\overset{f}{\longrightarrow}
                        \\Gamma \otimes_A C
                        \\overset{\epsilon \otimes_A id}{\longrightarrow}
                        A \otimes_A C
                        \\simeq
                        C
                        \\,.
          %p
            The
            %strong proof
            is
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            to the proof that shows that constructing
            %a.existingWikiWord{:href => "/nlab/show/free+modules"} free modules
            is
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
            from a
            %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
            to the underlying
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#MonoidModuleOverItself"}> prop.
            ). But since the details of the adjunction isomorphism are important for the following discussion, we spell it out:
          .proof
            %h6#proof_7 Proof
            %p
              A homomorphism into a co-free
              = succeed "-comodule" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo ⟶
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; N \longrightarrow \Gamma \otimes_A C
            %p
              making the following
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi N
                          %mtd
                            %mover
                              %mo ⟶
                              %mi f
                          %mtd
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi C
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi Ψ
                                    %mi N
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Ψ
                                  %msub
                                    %mo ⊗
                                    %mi A
                                  %mi id
                        %mtr
                          %mtd
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi N
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mi id
                                %msub
                                  %mo ⊗
                                  %mi A
                                %mi f
                          %mtd
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    N &amp;\overset{f}{\longrightarrow}&amp; \Gamma \otimes_A C
                    \\\
                    {}^{\mathllap{\Psi_N}}\downarrow
                    \&amp;&amp;
                    \\downarrow^{\mathrlap{\Psi \otimes_A id}}
                    \\\
                    \\Gamma \otimes_A N
                    \&amp;\underset{id \otimes_A f}{\longrightarrow}&amp;
                    \\Gamma \otimes_A \Gamma \otimes_A C
                    }
                    \\,.
            %p Consider the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Γ
                    %msub
                      %mo ⊗
                      %mi A
                    %mi C
                    %mover
                      %mo ⟶
                      %mrow
                        %mi ϵ
                        %msub
                          %mo ⊗
                          %mi A
                        %mi id
                    %mi A
                    %msub
                      %mo ⊗
                      %mi A
                    %mi C
                    %mo ≃
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde f
                    \\;\colon\;
                    N
                    \\overset{f}{\longrightarrow}
                    \\Gamma \otimes_A C
