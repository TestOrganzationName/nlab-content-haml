          %p
            e.g. (
            %a{:href => "#Ravenel86"}> Ravenel 86, lemma 3.2.8 and lemma 3.2.10
            ,
            = succeed ")" do
              %a{:href => "#Kochman96"} Kochman 96, lemma 5.3.2
          .proof
            %h6#proof_35 Proof
            %p
              Remember that the differential in the cobar complex (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CobarComplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo =
                    %msubsup
                      %mi 𝒜
                      %mn 2
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \Gamma = \mathcal{A}^\ast_2
              itself, but in the unit coideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi Γ
                      %mo ¯
                    %mo ≔
                    %mi coker
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{\Gamma} \coloneqq coker(\eta)
              where the generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mrow
                        %mn 0
                        %mo ,
                        %mi n
                    %mo =
                    %msub
                      %mi ξ
                      %mn 0
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} h_{0,n} = \xi_0 = 1
              disappears.
            %p
              Using this we find for the differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d_1
              of the generators in low degree on the first page of the
              %a.existingWikiWord{:href => "/nlab/show/May+spectral+sequence"} May spectral sequence
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#MaySpectralSequenceForClassicalAdamsSpectralSequence"}
              = succeed "," do
                %a.maruku-ref{:href => "#CoproductOnDualSteenrodInTermsOfAdaptedGenerators"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mover
                              %mi Ψ
                              %mo ¯
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mi n
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mi n
                            %mo ⊗
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi h
                                    %mrow
                                      %mn 0
                                      %mo ,
                                      %mi n
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo +
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi h
                                    %mrow
                                      %mn 0
                                      %mo ,
                                      %mi n
                                      %mo +
                                      %mn 1
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mi n
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_1(h_n)
                    \&amp; \coloneqq
                    d_1(h_{1,n})
                    \\\
                    \&amp; =
                    \\overline{\Psi}(h_{1,n})
                    \\\
                    \&amp; =
                    h_{1,n} \otimes \underset{= 0}{\underbrace{ h_{0,n} }}
                    +
                    \\underset{= 0}{\underbrace{ h_{0,n+1} }} \otimes h_{1,n}
                    \\\
                    \&amp; =
                    0
                    \\end{aligned}
            %p
              and hence all the elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mi n
                  %annotation{:encoding => "application/x-tex"} h_n
              are cocycles on the first page of the May spectral sequence.
            %p
              Also, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d_1
              is a
              %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
              (by definition of the cobar complex, def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CobarComplex"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ,
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n,k
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mi n
                                %mo ,
                                %mi k
                            %msup
                              %mo{:stretchy => "false"} )
                              %mn 2
                          %mtd
                            %mo =
                            %mn 2
                            %msub
                              %mi h
                              %mrow
                                %mi n
                                %mo ,
                                %mi k
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mi n
                                %mo ,
                                %mi k
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_1 (h_{n,k})^2
                    \&amp; =
                    2 h_{n,k} (d_1 (h_{n,k}))
                    \\\
                    \&amp; = 0
                    \\end{aligned}
            %p
              (since
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mi mod
                      %mspace{:width => "thickmathspace"}
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2 = 0 \; mod \; 2
            %p
              Similarly we compute
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} d_1
              on the other generators. These terms do not vanish, but so they impose relations on products in the cobar complex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 1
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 0
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 2
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 1
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 3
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 3
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 4
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 3
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi h
                              %mrow
                                %mn 3
                                %mo ,
                                %mn 0
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi h
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 1
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 0
                            %mo +
                            %msub
                              %mi h
                              %mrow
                                %mn 1
                                %mo ,
                                %mn 2
                            %mo ⊗
                            %msub
                              %mi h
                              %mrow
                                %mn 2
                                %mo ,
                                %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_1(h_{2,0})
                    \&amp; =
                    h_{1,1} \otimes h_{1,0}
                    \\\
                    d_1( h_{2,1} )
                    \&amp; =
                    h_{1,2} \otimes h_{1,1}
                    \\\
                    d_1( h_{2,2} )
                    \&amp; =
                    h_{1,3} \otimes h_{1,2}
                    \\\
                    d_1( h_{2,3} )
                    \&amp; =
