                              %mi Hom
                              %mi A
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %msup
                              %mover
                                %mi Γ
                                %mo ¯
                              %mrow
                                %msubsup
                                  %mo ⊗
                                  %mi A
                                  %mo •
                            %msub
                              %mo ⊗
                              %mi A
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mover
                                %mi Γ
                                %mo ¯
                              %mrow
                                %msubsup
                                  %mo ⊗
                                  %mi A
                                  %mo •
                            %msub
                              %mo ⊗
                              %mi A
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
