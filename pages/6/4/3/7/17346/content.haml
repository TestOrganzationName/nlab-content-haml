                              %mi Γ
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi N
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %msubsup
                              %mi D
                              %mi Γ
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi Γ
                            %msub
                              %mo ⊗
                              %mi A
                            %msup
                              %mover
                                %mi Γ
                                %mo ¯
                              %mrow
                                %msubsup
                                  %mo ⊗
                                  %mi A
                                  %mo •
                            %msub
                              %mo ⊗
                              %mi A
                            %mi N
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
