              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#HopfAlgebroidStructureOnDualEOperations"}
          %p These two actions need not strictly coincide, but they are isomorphic:
          #EETwoLeftModuleStructures.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi μ
                    %mo ,
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \mu, e)
              a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+commutative+ring+spectrum"} homotopy commutative ring spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-2#HomotopyCommutativeRingSpectrum"}> def.
              ), consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_\bullet(E)
              with its canonical left and right
              = succeed "-module" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
